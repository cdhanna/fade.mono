        "hook_y": 196,
        "caption_size": 58,
        "caption_y": 1452,
        "picture_mid": 840,
        "feather": 56,
        "blur": 7,
        "wash_middle": 0.35,
        "wash_edge": 0.92,
        "crf": 20
    },
    "cta": {
        "first": {"text": "Wishlist on Steam", "size": 76, "y": 300},
        "title": {"text": "Fish Fish Pop", "size": 118, "y": 450},
        "date": {"text": "December 2nd, 2026", "size": 58, "y": 590}
    },
    "end_card": {
        "clip": "trailer_fish_live_here",
        "in": 388,
        "out": 442,
        "crop": [1222, 0, 608, 1080],
        "seconds": 4.5,
        "slow": 3,
        "transition": "fade",
        "cta_at": 0.1
    },
    "transitions": {
        "bubbles": {
            "matte": "trailer_transition_bubbles_matte",
            "fx": "trailer_transition_bubbles_fx",
