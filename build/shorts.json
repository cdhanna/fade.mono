        "music": {
            "melody": "clair de lune",
            "start": 0.3,
            "repeat": 3,
            "volume": 0.35,
            "pads": true,
            "pad_volume": 0.3,
            "ambience_volume": 0.4,
            "layers": [
                {"asset": "Fish/Audio/Music/loop-ambience", "volume": 1},
                {"asset": "Fish/Audio/Music/loop-deep", "volume": 0.7},
                {"asset": "Fish/Audio/Music/loop-ambience-low", "volume": 0.3},
                {"asset": "Fish/Audio/Music/loop-surf-above", "volume": 0.35},
                {"asset": "Fish/Audio/Music/loop-crackle", "volume": 0.08}
            ]
        }
    },
    "shorts": [
        {
            "name": "01_relax",
            "hook": "Relax,\nyou cannot lose.",
            "music": {"melody": "clair de lune", "beat_ms": 560},
            "shots": [
                {"clip": "trailer_where_do_fish_live", "in": 60, "out": 310, "crop": [390, 140, 1180, 800]},
                {"clip": "trailer_first_pop", "in": 40, "crop": [620, 240, 680, 680], "transition": "bubbles"},
                {"clip": "trailer_swap_pop", "in": 60},
                {"clip": "trailer_diver_photo", "in": 30}
            ],
            "captions": [
                {"shot": 1, "mark": "swap", "offset": -0.4, "dur": 1.2, "text": "Swap."},
                {"shot": 1, "mark": "swap", "offset": 0.9, "dur": 1.2, "text": "Pop."},
                {"shot": 2, "frame": 70, "dur": 2.6, "text": "Take your time."},
                {"shot": 3, "frame": 40, "dur": 3.4, "text": "No timer.\nJust the sea."}
            ]
        },
        {
            "name": "02_how_few_moves",
            "hook": "How few moves\nwill you need?",
            "music": {"melody": "gymnopedie"},
            "shots": [
                {"clip": "trailer_late_game_combo", "in": 30},
                {"clip": "trailer_stingray_chain", "in": 0, "transition": "bubbles"},
                {"clip": "trailer_to_highscores", "in": {"mark": "table", "before": 15}, "out": 273, "crop": [430, 0, 1060, 960], "transition": "fade"}
            ],
            "captions": [
                {"shot": 0, "mark": "swap", "offset": -0.3, "dur": 2.2, "text": "One swap."},
                {"shot": 0, "mark": "swap", "offset": 1.9, "dur": 2.6, "text": "The right fish,\nin the right place."},
                {"shot": 1, "mark": "swap", "offset": -0.3, "dur": 3.2, "text": "One more."},
                {"shot": 2, "frame": 150, "dur": 2.4, "text": "Thirty rounds.\nCount your moves."}
            ]
        },
        {
            "name": "03_night",
            "hook": "When night falls,\nnothing pops.",
            "music": {"melody": "moonlight", "repeat": 3},
            "skip_sounds": ["Fish/Audio/Music/"],
            "shots": [
                {"clip": "trailer_night_ink", "in": 150},
                {"clip": "trailer_night_held", "in": 60, "out": 584}
            ],
            "captions": [
                {"shot": 0, "mark": "swap", "offset": -0.2, "dur": 2.4, "text": "Fish still match."},
                {"shot": 1, "mark": "swap", "offset": 0.2, "dur": 2.6, "text": "But they only glow,\nand wait."},
                {"shot": 1, "mark": "dawn", "offset": -0.6, "dur": 2.4, "text": "Until morning."},
                {"shot": 1, "frame": 464, "offset": 0.1, "dur": 2.0, "text": "Then they all go."}
            ]
        },
        {
            "name": "04_coral",
            "hook": "Walk a song,\nand coral grows.",
            "music": {"melody": "reverie", "repeat": 3},
            "shots": [
                {"clip": "trailer_coral_sings"},
                {"clip": "trailer_horror_ghosts", "in": 30, "transition": "fade"},
                {"clip": "trailer_info_horror", "crop": [620, 130, 1070, 820]}
            ],
            "captions": [
                {"shot": 0, "frame": 60, "dur": 2.0, "text": "Take a walk\nacross the board."},
                {"shot": 0, "mark": "grow", "dur": 2.4, "text": "It grows wherever\nyou walked."},
                {"shot": 0, "mark": "swap", "offset": 0.1, "dur": 2.8, "text": "Fish on coral do not pop.\nThey sing."},
                {"shot": 1, "frame": 70, "dur": 4.0, "text": "Sing over the dead,\nand it sings back."}
            ]
        },
        {
            "name": "05_deep",
            "hook": "Not everything\ndown here is friendly.",
            "music": {"melody": "c sharp minor", "repeat": 3, "volume": 0.4},
            "shots": [
                {"clip": "trailer_quest_01", "in": 30, "out": 230, "crop": [460, 40, 1040, 1000]},
                {"clip": "trailer_shark", "in": 80, "crop": [460, 40, 1040, 1000]},
                {"clip": "trailer_horror_ghosts", "transition": "bubbles"},
                {"clip": "trailer_info_horror", "crop": [620, 130, 1070, 820]},
                {"clip": "trailer_angler_horror", "crop": [100, 0, 1790, 800]}
            ],
            "captions": [
                {"shot": 0, "frame": 40, "dur": 3.0, "text": "Pop near Finn,\nand he eats it."},
                {"shot": 2, "mark": "swap", "offset": -0.2, "dur": 2.8, "text": "On horror coral,\nskeletons pop as ghosts."},
                {"shot": 4, "frame": 0, "dur": 3.0, "text": "A song sung over the dead.\nSpooky, spooky."}
            ]
        },
        {
            "name": "06_locals",
            "hook": "Meet the locals.\nThey have favors to ask.",
            "hook_size": 62,
            "music": {"melody": "arabesque", "repeat": 4},
            "crop": [460, 40, 1040, 1000],
            "shots": [
                {"clip": "trailer_quest_06", "in": 30, "out": 225},
                {"clip": "trailer_quest_12", "in": 30, "out": 225},
                {"clip": "trailer_quest_09", "in": 30, "out": 225},
                {"clip": "trailer_quest_10", "in": 30, "out": 225},
                {"clip": "trailer_quest_grid", "in": 230, "out": 570, "crop": [0, 0, 1920, 1080], "transition": "fade"}
            ],
            "captions": [
                {"shot": 0, "frame": 40, "dur": 3.0, "text": "Grandpa Shell walks\nafter every swap."},
                {"shot": 1, "frame": 40, "dur": 3.0, "text": "Crystal must reach\nthe bottom gently."},
                {"shot": 2, "frame": 40, "dur": 3.0, "text": "Echo copies your swaps,\nfour moves later."},
                {"shot": 3, "frame": 40, "dur": 3.0, "text": "Thump pulses\nevery fourth move."},
                {"shot": 4, "frame": 300, "dur": 3.8, "text": "Everyone wants\nsomething."}
            ]
        },
        {
            "name": "07_cards",
            "hook": "A new card\nevery round.",
            "music": {"melody": "la fille", "repeat": 5},
            "shots": [
                {"clip": "trailer_upgrade_rays", "in": 40, "out": 510, "crop": [100, 30, 1720, 880]},
                {"clip": "trailer_where_do_fish_live", "in": 470, "out": 790, "transition": "bubbles"}
            ],
            "captions": [
                {"shot": 0, "mark": "wave", "offset": 0.8, "dur": 3.0, "text": "Pick one.\nThe rules change."},
                {"shot": 0, "mark": "pick", "dur": 1.4, "text": "Rays."},
                {"shot": 1, "mark": "swap", "offset": -0.2, "dur": 3.0, "text": "Now a stingray\nshoots up its column."}
            ]
        },
        {
            "name": "08_tail",
            "hook": "Do not cross\nyour own tail.",
            "music": {"melody": "swan lake", "repeat": 4},
            "crop": [460, 40, 1040, 1000],
            "shots": [
                {"clip": "trailer_quest_02", "in": 30, "out": 215},
                {"clip": "trailer_tail", "in": 10, "crop": [540, 140, 880, 880]},
                {"clip": "trailer_quest_02", "in": 650, "out": 860, "crop": [540, 140, 880, 880], "transition": "bubbles"}
            ],
            "captions": [
                {"shot": 0, "frame": 40, "dur": 2.8, "text": "Slinky follows you\neverywhere."},
                {"shot": 1, "frame": 40, "dur": 2.4, "text": "Ten swaps,\nand he is happy."},
                {"shot": 1, "frame": 195, "dur": 2.6, "text": "Cross it, and he is tangled."},
                {"shot": 2, "frame": 720, "dur": 2.6, "text": "So you start over.\nNo harm done."}
            ]
        }
    ]
}
