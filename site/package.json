{
  "name": "fish-fish-pop-site",
  "private": true,
  "type": "module",
  "scripts": {
    "media": "node scripts/media.mjs",
    "dev": "node scripts/media.mjs && vite",
    "build": "node scripts/media.mjs && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/media.mjs && vite build && npx --yes wrangler@4.126.0 pages deploy dist --project-name fish-fish-pop --branch main",
    "steam": "node scripts/steam.mjs",
    "steam:check": "node scripts/steam-check.mjs",
    "render:capsules": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/render-capsules.ps1",
    "render:screenshots": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/render-screenshots.ps1",
    "render:clips": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/render-clips.ps1",
    "render:shorts": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/render-shorts.ps1",
    "render:trailer": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build/render-trailer.ps1",
    "cut:trailer": "py -3 ../build/trailer_cut.py"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "fflate": "^0.8.3",
    "svelte": "^5.57.2",
    "vite": "^8.3.5",
    "wawoff2": "^2.0.1"
  }
}
