            screenshot tCdwOut$ + "/raw/" + tCdwName$
            print "[capsule] take " + tCdwName$
        next
    next
endtest

` THE TITLE COMING IN, as a video, for the start of the trailer and wherever the title is shown. the
` center scene, on an empty board. the three seahorses fall in with the first "Fish", and the crab, with
` the cursor, with the second. the cursor carries the crab down, the seahorse comes up, and the row of
` three seahorses pops, in puffs and bubbles, with a ring. "Pop" punches in, bigger than it is, and
` springs to its size, in its splash, with a ring through the water that rocks every piece. then the rest
` of the board falls in around it, from the middle out, and new fish fall into the row that popped.
` everything moves on an ease or a spring. it goes to FISH_CAPSULE_OUT/anim/title_in.mp4.
test capsule_anim_title from capDraftShot
    if val(env$("FISH_CAPSULE")) = 0 then end
    capDraftSea(TEX_GOLDFISH, TEX_CATFISH, TEX_ANGELFISH, TEX_PUFFER, TEX_SMOKE_1, TEX_SMOKE_2)
    tCaD = capDraftDiver(470, 40, 30, 1)
    tCaA = capDraftAva(112, 165, .55, 0)
    capDraftGrid(285, 182, 48, .8, .45, TEX_BASS, TEX_CRAB, TEX_PUFFER, TEX_CATFISH, TEX_GOLDFISH, TEX_ANGELFISH, TEX_WORM)
    tCaBoard = CAPD_C_N
    capDraftTitle(285, 72, .78, -.05)
    capDraftSplash()
    capDraftSplashAt(2)
    for tCaW = 0 to 2
        capDraftWordPose(tCaW, 1, 0, 0)
    next
    tCaCrab = CAPD_T_CELL(1)
    tCaLow = CAPD_T_CELL(0)
    tCaCrabX# = CAPD_C_X#(tCaCrab)
    tCaCrabY# = CAPD_C_Y#(tCaCrab)
    tCaLowX# = CAPD_C_X#(tCaLow)
    tCaLowY# = CAPD_C_Y#(tCaLow)

    ` the new pieces that fall into the row that popped, once the rest of the board is coming in
    dim tCaNew(3)
    dim tCaRow(3)
    tCaRow(0) = CAPD_T_CELL(2)
    tCaRow(1) = tCaLow
    tCaRow(2) = CAPD_T_CELL(3)
    for tCaI = 0 to 2
        tCaKind = TEX_ANGELFISH
        if tCaI = 1 then tCaKind = TEX_GOLDFISH
        if tCaI = 2 then tCaKind = TEX_PUFFER
        tCaAt = CAPD_T_CELL(2)
        if tCaI = 1 then tCaAt = tCaCrab
        if tCaI = 2 then tCaAt = CAPD_T_CELL(3)
        tCaNew(tCaI) = capDraftPiece(tCaKind, CAPD_C_X#(tCaAt), CAPD_C_Y#(tCaAt), CAPD_C_S#(tCaAt), CAPD_C_TS#(tCaAt), 255, 255, 255, 255, 12, 24, 52, 200, .08, 1, 0)
    next
    for tCaI = 0 to CAPD_C_N - 1
        CAPD_C_SHOW#(tCaI) = 0
    next

    ` the puffs of the three seahorses, each a different smoke of a pop
    dim tCaPuff(3)
    dim tCaPuffSmoke(3)
    for tCaI = 0 to 2
        tCaPuffSmoke(tCaI) = (tCaI * 2 + 1) mod 5
        tCaS = 0
        reserve sprite id(tCaS)
        sprite tCaS, 0, 0, CAPD_SMOKE_TEX(tCaPuffSmoke(tCaI))
        set sprite offset tCaS, .5, .5
        rotate sprite tCaS, tCaI * 1.7
        set sprite flip tCaS, tCaI mod 2, 0
        color sprite tCaS, rgb(170, 215, 255, 220)
        order sprite tCaS, 34
        hide sprite tCaS
        tCaPuff(tCaI) = tCaS
    next

    ` the sea settles first
    for tCaF = 0 to 120
        capDraftFrame(tCaF)
        runto update_frame
    next

    tCaOut$ = env$("FISH_CAPSULE_OUT")
    if tCaOut$ = "" then tCaOut$ = "capsules"
    set record size 1920, 1080
    record start tCaOut$ + "/anim/title_in.mp4"
    tCaFish1At = 24
    tCaFish2At = 52
    tCaSwapAt = 88
    tCaSwapLen = 14
    tCaPopAt = tCaSwapAt + tCaSwapLen + 6
    tCaTitleAt = tCaPopAt + 12
    tCaFillAt = tCaTitleAt + 28
    for tCaF = 0 to 380
        ` the two "Fish": each one springs in past its size and settles
        for tCaW = 0 to 1
            tCaAge = tCaF - tCaFish1At
            if tCaW = 1 then tCaAge = tCaF - tCaFish2At
            if tCaAge >= 0
                tCaT# = tCaAge
                tCaT# = tCaT# / 16.0
                if tCaT# > 1 then tCaT# = 1
                capDraftWordPose(tCaW, capEaseBack(tCaT#), 0, 255 * capEaseOut(tCaT#))
                if tCaAge = 0
                    spawnBubblesOnLayer(CAPD_W_X#(tCaW), CAPD_W_Y#(tCaW), 26, 10, 0, rgb(210, 230, 255), 299, 0, 200, 1)
                endif
            endif
        next

        ` the three seahorses fall in with the first word, one after another, and the crab with the second.
        ` each one lands with a little ring.
        if tCaF < tCaSwapAt
            for tCaI = 0 to 3
                tCaCell = CAPD_T_CELL(tCaI)
                tCaAge = tCaF - tCaFish1At
                if tCaI = 0 then tCaAge = tCaAge - 5
                if tCaI = 3 then tCaAge = tCaAge - 10
                if tCaI = 1 then tCaAge = tCaF - tCaFish2At
                capDraftFallAt(tCaCell, tCaAge)
                if tCaAge = 16
                    spawnShockwave((CAPD_C_X#(tCaCell) - GRID_POS.x) / CELL_SIZE, (CAPD_C_Y#(tCaCell) - GRID_POS.y) / CELL_SIZE, .2, 0)
                endif
            next
        endif

        ` the swap, on an ease in and out: the crab, and the cursor with it, goes down, lifted over the
        ` seahorse and tipping the way that it goes, and the seahorse comes up. both rock as they stop.
        tCaAge = tCaF - tCaSwapAt
        if tCaAge >= 0 and tCaAge <= tCaSwapLen
            tCaT# = tCaAge
            tCaT# = capEaseInOut(tCaT# / tCaSwapLen)
            tCaArc# = sin(tCaT# * 3.14159)
            CAPD_C_X#(tCaCrab) = tCaCrabX# + (tCaLowX# - tCaCrabX#) * tCaT#
            CAPD_C_Y#(tCaCrab) = tCaCrabY# + (tCaLowY# - tCaCrabY#) * tCaT#
            CAPD_C_X#(tCaLow) = tCaLowX# + (tCaCrabX# - tCaLowX#) * tCaT#
            CAPD_C_Y#(tCaLow) = tCaLowY# + (tCaCrabY# - tCaLowY#) * tCaT#
            CAPD_C_DY#(tCaCrab) = 0
            CAPD_C_DY#(tCaLow) = 0
            CAPD_C_DLIFT#(tCaCrab) = .25 * tCaArc#
            CAPD_C_DP#(tCaCrab) = -.25 * tCaArc#
            CAPD_C_DP#(tCaLow) = .15 * tCaArc#
            CAPD_C_SQ#(tCaCrab) = 1
            CAPD_C_SQ#(tCaLow) = 1
            if tCaAge = 0
                spawnShockwave((tCaCrabX# - GRID_POS.x) / CELL_SIZE, (tCaCrabY# - GRID_POS.y) / CELL_SIZE, .25, 0)
            endif
        endif
        if tCaAge > tCaSwapLen
            tCaA# = tCaAge - tCaSwapLen
            CAPD_C_DLIFT#(tCaCrab) = 0
            CAPD_C_DP#(tCaCrab) = .12 * sin(tCaA# * .5) * pow(.85, tCaA#)
            CAPD_C_SQ#(tCaCrab) = 1 - .1 * capSpring(tCaA#, .55)
        endif

        ` the row of seahorses pops: each one swells toward the eye, turns, and fades, with the square of its
        ` cell, in a puff of its own smoke
        tCaAge = tCaF - tCaPopAt
        if tCaAge >= 0 and tCaAge < 40
            tCaT# = tCaAge
            tCaT# = tCaT# / 18.0
            for tCaI = 0 to 2
                tCaCell = tCaRow(tCaI)
                tCaX# = CAPD_C_X#(tCaCell)
                tCaY# = CAPD_C_Y#(tCaCell)
                tCaS# = CAPD_C_TS#(tCaCell)
                tCaP = tCaPuff(tCaI)
                tCaSm = tCaPuffSmoke(tCaI)
                if tCaT# < 1
                    CAPD_C_DLIFT#(tCaCell) = .8 * capEaseOut(tCaT#)
                    CAPD_C_DYAW#(tCaCell) = (tCaI - 1) * .4 * capEaseOut(tCaT#)
                    CAPD_C_SHOW#(tCaCell) = 1 - tCaT# * tCaT#
                    show sprite tCaP
                    position sprite tCaP, tCaX#, tCaY#
                    tCaPS# = tCaS# * (1.4 + .9 * capEaseOut(tCaT#))
                    size sprite tCaP, tCaPS#, tCaPS#
                    tCaFrame = tCaT# * CAPD_SMOKE_FN(tCaSm)
                    set sprite frame tCaP, CAPD_SMOKE_F0(tCaSm) + tCaFrame
                else
                    CAPD_C_SHOW#(tCaCell) = 0
                    hide sprite tCaP
                endif
                if tCaAge = 0
                    spawnBubblesOnLayer(tCaX#, tCaY#, 10, 10, 0, rgb(215, 235, 255), 299, 0, 220, 1)
                endif
            next
            if tCaAge = 0
                spawnShockwave((tCaCrabX# - GRID_POS.x) / CELL_SIZE, (tCaCrabY# - GRID_POS.y) / CELL_SIZE, .6, 0)
            endif
        endif

        ` "Pop" punches in: it falls from 1.7 times its size, faster and faster, to less than its size, and
        ` springs back to it. as it hits, a ring goes out through the water.
        tCaAge = tCaF - tCaTitleAt
        if tCaAge >= 0
            tCaHit = 7
            if tCaAge < tCaHit
                tCaT# = tCaAge
                tCaT# = tCaT# / tCaHit
                tCaScale# = 1.7 - .85 * tCaT# * tCaT#
                tCaAlpha = 255 * capEaseOut(tCaT#)
            else
                tCaA# = tCaAge - tCaHit
                tCaScale# = 1 - .15 * capSpring(tCaA#, .45)
                tCaAlpha = 255
            endif
            capDraftWordPose(2, tCaScale#, 0, tCaAlpha)
            if tCaAge = tCaHit
                capDraftBurst(2)
            endif
            if tCaAge >= tCaHit
                tCaSplash# = tCaAge - tCaHit
                tCaSplash# = tCaSplash# / 46.0
                capDraftSplashAt(tCaSplash#)
            endif
        endif

        ` the rest of the board falls in, from the middle out, and new fish into the row that popped
        tCaAge = tCaF - tCaFillAt
        if tCaAge >= 0
            for tCaI = 0 to tCaBoard - 1
                tCaIsT = 0
                for tCaJ = 0 to 3
                    if CAPD_T_CELL(tCaJ) = tCaI then tCaIsT = 1
                next
                if tCaIsT = 0
                    tCaDx# = CAPD_C_X#(tCaI) - tCaCrabX#
                    tCaDy# = CAPD_C_Y#(tCaI) - tCaCrabY#
                    tCaWait = sqrt(tCaDx# * tCaDx# + tCaDy# * tCaDy#) * .1
                    capDraftFallAt(tCaI, tCaAge - tCaWait)
                endif
            next
            for tCaI = 0 to 2
                capDraftFallAt(tCaNew(tCaI), tCaAge - tCaI * 4)
            next
        endif

        capDraftFrame(tCaF)
        runto update_frame
    next
    record stop
    print "[capsule] take title_in"
endtest


` THE TITLE AT THE SURFACE (2026-11-05). the same dressed title as the key art, but out on the sea of
` the main menu, in the evening: the words come up out of the water one at a time, "Fish", "Fish", and
` then "Pop" bursts up out of it, with spray thrown up behind it, drops that fall back in, and rings that
` go out across the water from every one of them. under the words is their reflection, in the water.
` the title is drawn to a render target of its own, and two sprites show that: the title, cut off at the
` waterline, so that a word under it is under the water, and the reflection, the same picture turned
` upside down under the waterline, squashed, and dimmed. the screen effect wobbles it with the rest of the
` water. the rings are SurfaceRingEffect. the sounds are the game's own: a splash for each word as it
` comes up, a bloop as it lands, and for "Pop" a bigger splash, a pop and a boom, and the drops plinking.
` it records itself as a trailer shot, trailer_surface_logo, with its sounds in the .json next to it.
abstract test capSurfShot from capDraftShot
    global CSF_WATER = 0 `how far down the screen the waterline under the title is
    global CSF_OUT = 0 `the render target that the title is drawn to
    global CSF_TEX = 0
    global CSF_LOGO = 0 `the sprite of the title, and of its reflection
    global CSF_MIRROR = 0
    global CSF_RING_FX = 0
    global CSF_RING_N = 24
    global dim CSF_RING(24)
    global dim CSF_RING_AGE(24) `frames since it started, less than 0 while it waits
    global dim CSF_RING_LIFE(24)
    global dim CSF_RING_X#(24)
    global dim CSF_RING_Y#(24)
    global dim CSF_RING_R#(24) `how wide it gets, in pixels
    global dim CSF_RING_A(24)
    global CSF_RING_NEXT = 0
    global CSF_DROP_N = 120
    global dim CSF_DROP(120)
    global dim CSF_DROP_ON(120)
    global dim CSF_DROP_X#(120)
    global dim CSF_DROP_Y#(120)
    global dim CSF_DROP_VX#(120)
    global dim CSF_DROP_VY#(120)
    global dim CSF_DROP_LAND#(120) `the line of the water that it falls back into: further down is nearer
    global CSF_DROP_NEXT = 0
    global CSF_GRAVITY# = .14 `pixels per frame, per frame
    global CSF_PLINK_WAIT = 0 `frames until a drop may make a sound again
    ` the sounds
    global CSF_SFX_SPLASH = 0
    global CSF_SFX_SPLASH_BIG = 0
    global CSF_SFX_LAND_A = 0
    global CSF_SFX_LAND_B = 0
    global CSF_SFX_POP = 0
    global CSF_SFX_BOOM = 0
    global CSF_SFX_PLINK = 0
    global CSF_SFX_CLOUD = 0
    ` THE CLOUDS that the words turn into: streaks, like the clouds of the sky, long and thin and leaning up
    ` to the right, dusky purple with an edge lit by the sun going down. a word breaks up into them, row by
    ` row, and they stretch out, thin away, and drift off on the wind.
    global CSF_CLOUD_N = 0
    global dim CSF_CLOUD(140) `the streak, and the lit line along the top of it
    global dim CSF_CLOUD_HI(140)
    global dim CSF_CLOUD_X#(140)
    global dim CSF_CLOUD_Y#(140)
    global dim CSF_CLOUD_LEN#(140)
    global dim CSF_CLOUD_WAIT(140)
    global CSF_CLOUD_LEAN# = -.13 `how the clouds of the evening sky lean

` the main menu, with nothing of it showing but the sea and the sky
function capSurfSea()
    GAME_ENDLESS = 1
    REQUEST_GAME_END = 1
    runto menu_transition
    for csF = 1 to 240
        capSurfQuiet()
        runto frame_menu_render
    next
endfunction

function capSurfQuiet()
    setMenuChromeAlpha(0)
    hide text MENU_HINT_TEXT_ID
endfunction

function capSurfSounds()
    CSF_SFX_SPLASH = tideLoadSound("Fish/Audio/diver-splash", SFX_GROUP_SFX, 0)
    CSF_SFX_SPLASH_BIG = tideLoadSound("Fish/Audio/diver-splash", SFX_GROUP_SFX, 0)
    CSF_SFX_LAND_A = tideLoadSound("Fish/Audio/cue-bloop-3", SFX_GROUP_SFX, 0)
    CSF_SFX_LAND_B = tideLoadSound("Fish/Audio/cue-bloop-5", SFX_GROUP_SFX, 0)
    CSF_SFX_POP = tideLoadSound("Fish/Audio/bubble-pop-2", SFX_GROUP_SFX, 0)
    CSF_SFX_BOOM = tideLoadSound("Fish/Audio/bar-charge-boom", SFX_GROUP_SFX, 0)
    CSF_SFX_PLINK = tideLoadSound("Fish/Audio/bubble-pop-4", SFX_GROUP_SFX, 0)
    CSF_SFX_CLOUD = tideLoadSound("Fish/Audio/swap-swell-soft", SFX_GROUP_SFX, 0)
endfunction

` the render target of the title, and the two sprites that show it. every text of the title, and the
` splash, is moved onto it.
function capSurfTarget(csWater)
    CSF_WATER = csWater
    reserve render target id(CSF_OUT)
    render target CSF_OUT
    set render target background color CSF_OUT, rgb(0, 0, 0, 0)
    CSF_TEX = render target texture(CSF_OUT)
    ` one frame of it: the part over the waterline
    set texture frame count CSF_TEX, 1
    set texture frame rect CSF_TEX, 0, 0, 0, WORLD_WIDTH * RENDER_SCALE, csWater * RENDER_SCALE
    reserve sprite id(CSF_LOGO)
    sprite CSF_LOGO, 0, 0, CSF_TEX
    set sprite offset CSF_LOGO, 0, 0
    set sprite frame CSF_LOGO, 0
    size sprite CSF_LOGO, WORLD_WIDTH, csWater
    order sprite CSF_LOGO, 296
    reserve sprite id(CSF_MIRROR)
    sprite CSF_MIRROR, 0, csWater, CSF_TEX
    set sprite offset CSF_MIRROR, 0, 0
    set sprite frame CSF_MIRROR, 0
    size sprite CSF_MIRROR, WORLD_WIDTH, csWater * .55
    set sprite flip CSF_MIRROR, 0, 1
    color sprite CSF_MIRROR, rgb(120, 165, 235, 80)
    order sprite CSF_MIRROR, 295
    for csI = 0 to CAPD_TXT_N - 1
        set text render target CAPD_TXT(csI), CSF_OUT
    next
    for csI = 0 to CAPD_PUFF_N - 1
        set sprite render target CAPD_PUFF(csI), CSF_OUT
        ` spray: whiter than the splash under the water
        color sprite CAPD_PUFF(csI), rgb(225, 240, 255, 255)
    next
endfunction

function capSurfPools()
    ` the logo of the main menu has the ring effect loaded already. loading it again under another id
    ` shares the one effect, which is then disposed of under the other when the game is reset between shots.
    CSF_RING_FX = LOGO_RING_FX
    for csI = 0 to CSF_RING_N - 1
        csS = 0
        reserve sprite id(csS)
        sprite csS, 0, 0, TEX_PIXEL
        set sprite offset csS, .5, .5
        set sprite effect csS, CSF_RING_FX
        order sprite csS, 294
        hide sprite csS
        CSF_RING(csI) = csS
        CSF_RING_AGE(csI) = 0
        CSF_RING_LIFE(csI) = 0
    next
    for csI = 0 to CSF_DROP_N - 1
        csS = 0
        reserve sprite id(csS)
        sprite csS, 0, 0, TEX_PIXEL
        set sprite offset csS, .5, .5
        order sprite csS, 297
        hide sprite csS
        CSF_DROP(csI) = csS
        CSF_DROP_ON(csI) = 0
    next
endfunction

` a ring on the water at x, y, that goes out to crR# pixels wide over crLife frames, after crWait frames
function capSurfRing(crX#, crY#, crR#, crLife, crWait, crAlpha)
    crI = CSF_RING_NEXT
    CSF_RING_NEXT = (CSF_RING_NEXT + 1) mod CSF_RING_N
    CSF_RING_X#(crI) = crX#
    CSF_RING_Y#(crI) = crY#
    CSF_RING_R#(crI) = crR#
    CSF_RING_LIFE(crI) = crLife
    CSF_RING_AGE(crI) = 0 - crWait
    CSF_RING_A(crI) = crAlpha
endfunction

` drops thrown up out of the water at x, on the waterline, spread out sdSpread pixels to each side, going
` up as fast as sdUp# pixels a frame at most
function capSurfSpray(sdX#, sdSpread, sdCount, sdUp#)
    for sdN = 1 to sdCount
        sdI = CSF_DROP_NEXT
        CSF_DROP_NEXT = (CSF_DROP_NEXT + 1) mod CSF_DROP_N
        sdS = CSF_DROP(sdI)
        CSF_DROP_ON(sdI) = 1
        CSF_DROP_X#(sdI) = sdX# + rnd(sdSpread * 2 + 1) - sdSpread
        CSF_DROP_Y#(sdI) = CSF_WATER
        CSF_DROP_VX#(sdI) = (rnd(201) - 100) * .012
        CSF_DROP_VY#(sdI) = 0 - sdUp# * (.45 + rnd(56) * .01)
        CSF_DROP_LAND#(sdI) = CSF_WATER + 1 + rnd(16)
        sdSize = 1 + rnd(2)
        size sprite sdS, sdSize, sdSize
        sdTint = rnd(3)
        if sdTint = 0
            color sprite sdS, rgb(170, 210, 255, 235)
        else
            color sprite sdS, rgb(235, 245, 255, 245)
        endif
        position sprite sdS, CSF_DROP_X#(sdI), CSF_DROP_Y#(sdI)
        show sprite sdS
    next
endfunction

` everything on the water, one frame on: the rings go out, and the drops fall back in
function capSurfStep()
    for ssI = 0 to CSF_RING_N - 1
        ssS = CSF_RING(ssI)
        ssLife = CSF_RING_LIFE(ssI)
        if ssLife > 0
            CSF_RING_AGE(ssI) = CSF_RING_AGE(ssI) + 1
            ssAge = CSF_RING_AGE(ssI)
            if ssAge < 0
                hide sprite ssS
            else
                if ssAge >= ssLife
                    hide sprite ssS
                    CSF_RING_LIFE(ssI) = 0
                else
                    ssT# = ssAge
                    ssT# = ssT# / ssLife
                    ssW# = 4 + CSF_RING_R#(ssI) * capEaseOut(ssT#)
                    ssH# = ssW# * .2 + 1
                    show sprite ssS
                    position sprite ssS, CSF_RING_X#(ssI), CSF_RING_Y#(ssI)
                    size sprite ssS, ssW#, ssH#
                    set sprite all texcoord1 ssS, ssW#, ssH#, 1, 0
                    ssA# = CSF_RING_A(ssI) * (1 - ssT#) * (1 - ssT#)
                    color sprite ssS, rgb(200, 228, 255, ssA#)
                endif
            endif
        endif
    next
    if CSF_PLINK_WAIT > 0
        CSF_PLINK_WAIT = CSF_PLINK_WAIT - 1
    endif
    for ssI = 0 to CSF_DROP_N - 1
        if CSF_DROP_ON(ssI)
            ssS = CSF_DROP(ssI)
            CSF_DROP_VY#(ssI) = CSF_DROP_VY#(ssI) + CSF_GRAVITY#
            CSF_DROP_X#(ssI) = CSF_DROP_X#(ssI) + CSF_DROP_VX#(ssI)
            CSF_DROP_Y#(ssI) = CSF_DROP_Y#(ssI) + CSF_DROP_VY#(ssI)
            ssDown = 0
            if CSF_DROP_VY#(ssI) > 0
                if CSF_DROP_Y#(ssI) >= CSF_DROP_LAND#(ssI) then ssDown = 1
            endif
            if ssDown
                ` it falls back in: a little ring, and now and then a plink
                CSF_DROP_ON(ssI) = 0
                hide sprite ssS
                ssRing = rnd(3)
                if ssRing = 0
                    capSurfRing(CSF_DROP_X#(ssI), CSF_DROP_LAND#(ssI), 8 + rnd(8), 26, 0, 150)
                endif
                if CSF_PLINK_WAIT = 0
                    CSF_PLINK_WAIT = 5 + rnd(6)
                    tidePlaySound(CSF_SFX_PLINK, .1 + rnd(8) * .01, (rnd(60) - 10) * .01)
                endif
            else
                position sprite ssS, CSF_DROP_X#(ssI), CSF_DROP_Y#(ssI)
            endif
        endif
    next
endfunction

` the streaks over every word: a row of them every few pixels down it, two or three to a row, with gaps,
` across the width of it. "Pop" goes first, and then the two "Fish", each from its middle row out. none
` are under the horizon, which would be on the water.
function capSurfCloudsMake()
    CSF_CLOUD_N = 0
    for ccW = 0 to 2
        ccSize# = 46 * .82
        ccWait = 10
        ccY# = CAPD_W_Y#(ccW)
        if ccW = 1 then ccWait = 18
        if ccW = 2
            ccSize# = CAPD_POP_SIZE#
            ccWait = 0
            ccY# = CAPD_POP_Y#
        endif
        ccWide# = ccSize# * 2.2
        ccTall# = ccSize# * .8
        ccRows = ccTall# / 3.5
        for ccR = 0 to ccRows - 1
            ccDown# = ccR
            ccDown# = ccDown# / (ccRows - 1) - .5
            ccRowY# = ccY# + ccDown# * ccTall#
            ccPer = 2 + rnd(2)
            ccLeft# = CAPD_W_X#(ccW) - ccWide# / 2
            for ccN = 0 to ccPer - 1
                if ccRowY# < SURFACE_HORIZON - 3 and CSF_CLOUD_N < 140
                    ccI = CSF_CLOUD_N
                    CSF_CLOUD_N = CSF_CLOUD_N + 1
                    ccSpan# = ccWide# / ccPer
                    CSF_CLOUD_LEN#(ccI) = ccSpan# * (.55 + rnd(40) * .01)
                    CSF_CLOUD_X#(ccI) = ccLeft# + ccSpan# * (ccN + .5) + (rnd(20) - 10) * .01 * ccSpan#
                    CSF_CLOUD_Y#(ccI) = ccRowY#
                    CSF_CLOUD_WAIT(ccI) = ccWait + abs(ccDown#) * 16 + rnd(8)
                    ccS = 0
                    reserve sprite id(ccS)
                    sprite ccS, 0, 0, TEX_PIXEL
                    set sprite offset ccS, .5, .5
                    rotate sprite ccS, CSF_CLOUD_LEAN#
                    order sprite ccS, 298
                    hide sprite ccS
                    CSF_CLOUD(ccI) = ccS
                    ccS = 0
                    reserve sprite id(ccS)
                    sprite ccS, 0, 0, TEX_PIXEL
                    set sprite offset ccS, .5, .5
                    rotate sprite ccS, CSF_CLOUD_LEAN#
                    order sprite ccS, 299
                    hide sprite ccS
                    CSF_CLOUD_HI(ccI) = ccS
                endif
            next
        next
    next
endfunction

` the streaks, caAge frames after they start: each one shows up where its piece of the word was, then
` stretches out long, thins, drifts off up and to the right, and fades away
function capSurfCloudsAt(caAge)
    for caI = 0 to CSF_CLOUD_N - 1
        caS = CSF_CLOUD(caI)
        caHi = CSF_CLOUD_HI(caI)
        caA = caAge - CSF_CLOUD_WAIT(caI)
        caGone# = caA - 100
        caGone# = caGone# / 70.0
        if caGone# < 0 then caGone# = 0
        if caA < 0 or caGone# >= 1
            hide sprite caS
            hide sprite caHi
        else
            caGrow# = caA
            caGrow# = caGrow# / 16.0
            if caGrow# > 1 then caGrow# = 1
            caGrow# = capEaseOut(caGrow#)
            caLong# = caA
            caLong# = caLong# / 150.0
            if caLong# > 1 then caLong# = 1
            caLong# = capEaseInOut(caLong#)
            caLen# = CSF_CLOUD_LEN#(caI) * (.6 + .4 * caGrow#) * (1 + 1.6 * caLong#)
            caThick# = 3.2 - 1.8 * caLong#
            caX# = CSF_CLOUD_X#(caI) + caA * .2 + caLong# * CSF_CLOUD_LEN#(caI) * .4
            caY# = CSF_CLOUD_Y#(caI) - caA * .05 + (caX# - CSF_CLOUD_X#(caI)) * CSF_CLOUD_LEAN#
            caAlpha = 225 * caGrow# * (1 - caGone#)
            show sprite caS
            show sprite caHi
            position sprite caS, caX#, caY#
            size sprite caS, caLen#, caThick#
            color sprite caS, rgb(96, 58, 116, caAlpha)
            position sprite caHi, caX# + 1, caY# - caThick# / 2
            size sprite caHi, caLen# * .8, 1
            color sprite caHi, rgb(255, 148, 116, caAlpha)
        endif
    next
endfunction

` a word of the title, coming up out of the water: from all of the way under it, up past where it sits,
` and back down to it, with a little swell as it lands. cwAge is frames since it started.
function capSurfWordAt(cwWord, cwAge)
    if cwAge < 0
        capDraftWordPose(cwWord, 1, 0, 0)
        exitfunction
    endif
    cwLen = 20
    cwUnder# = CSF_WATER - CAPD_W_Y#(cwWord)
    cwUnder# = cwUnder# + 40
    if cwAge < cwLen
        cwT# = cwAge
        cwT# = cwT# / cwLen
        cwRise# = capEaseBack(cwT#)
        capDraftWordPose(cwWord, 1, cwUnder# * (1 - cwRise#), 255)
    else
        cwA# = cwAge - cwLen
        capDraftWordPose(cwWord, 1 + .05 * capSpring(cwA#, .5), 0, 255)
    endif
endfunction
endtest

` THE TITLE AT THE SURFACE, as a trailer shot
test trailer_surface_logo from capSurfShot
    capDraftSmokes(TEX_SMOKE_1, TEX_SMOKE_2)
    capSurfSea()
    capSurfSounds()
    capSurfPools()
    capDraftTitle(250, 120, .82, -.05)
    capDraftSplash()
    capSurfTarget(176)
    tSfFishA = 40
    tSfFishB = 74
    tSfPop = 108
    capSurfCloudsMake()
    ` when the title turns to clouds
    tSfCloud = 230
    trailerRecord("trailer_surface_logo")
    for tSfF = 0 to 470
        capSurfQuiet()
        capSurfWordAt(0, tSfF - tSfFishA)
        capSurfWordAt(1, tSfF - tSfFishB)
        ` the words come up: a splash where each breaks the water, and a bloop as it lands
        if tSfF = tSfFishA
            capSurfSpray(CAPD_W_X#(0), 14, 14, 3.2)
            capSurfRing(CAPD_W_X#(0), CSF_WATER + 2, 70, 60, 0, 200)
            capSurfRing(CAPD_W_X#(0), CSF_WATER + 2, 44, 50, 8, 160)
            tidePlaySound(CSF_SFX_SPLASH, .4, .35)
            record mark "word"
        endif
        if tSfF = tSfFishA + 12
            tidePlaySound(CSF_SFX_LAND_A, .45, 0)
        endif
        if tSfF = tSfFishB
            capSurfSpray(CAPD_W_X#(1), 14, 14, 3.2)
            capSurfRing(CAPD_W_X#(1), CSF_WATER + 2, 70, 60, 0, 200)
            capSurfRing(CAPD_W_X#(1), CSF_WATER + 2, 44, 50, 8, 160)
            tidePlaySound(CSF_SFX_SPLASH, .4, .2)
            record mark "word"
        endif
        if tSfF = tSfFishB + 12
            tidePlaySound(CSF_SFX_LAND_B, .45, 0)
        endif
        ` "Pop" bursts up out of the water, bigger than it is, and springs back to its size, in its spray
        tSfPopAge = tSfF - tSfPop
        if tSfPopAge < 0
            capDraftWordPose(2, 1, 0, 0)
            capDraftSplashAt(-1)
        else
            tSfRise# = tSfPopAge
            tSfRise# = tSfRise# / 7.0
            if tSfRise# > 1 then tSfRise# = 1
            tSfUnder# = (CSF_WATER - CAPD_POP_Y# + CAPD_POP_SIZE# * .6) * (1 - capEaseOut(tSfRise#))
            tSfScale# = 1 + .35 * capSpring(tSfPopAge, .42)
            capDraftWordPose(2, tSfScale#, tSfUnder#, 255)
            ` the splash plays all of the way through, and is gone
            tSfSplash# = tSfPopAge
            tSfSplash# = tSfSplash# / 75.0
            capDraftSplashAt(tSfSplash#)
        endif
        if tSfF = tSfPop
            capSurfSpray(CAPD_POP_X#, 46, 70, 5.4)
            capSurfRing(CAPD_POP_X#, CSF_WATER + 3, 220, 90, 0, 230)
            capSurfRing(CAPD_POP_X#, CSF_WATER + 3, 150, 80, 7, 200)
            capSurfRing(CAPD_POP_X#, CSF_WATER + 3, 90, 70, 14, 170)
            tidePlaySound(CSF_SFX_SPLASH_BIG, .75, -.25)
            tidePlaySound(CSF_SFX_POP, .8, 0)
            tidePlaySound(CSF_SFX_BOOM, .45, 0)
            record mark "pop"
        endif
        if tSfF = 200
            screenshot env$("FISH_TRAILER_OUT") + "/trailer_surface_logo_still"
        endif
        ` THE TITLE TURNS TO CLOUDS: the clouds swell up over the words, and the words, and their reflection,
        ` fade away under them, going the dusky color of the clouds as they go
        tSfCloudAge = tSfF - tSfCloud
        capSurfCloudsAt(tSfCloudAge)
        if tSfCloudAge = 0
            tidePlaySound(CSF_SFX_CLOUD, .35, .1)
            record mark "clouds"
        endif
        if tSfCloudAge >= 0
            tSfFade# = tSfCloudAge - 8
            tSfFade# = tSfFade# / 34.0
            if tSfFade# < 0 then tSfFade# = 0
            if tSfFade# > 1 then tSfFade# = 1
            tSfFade# = capEaseInOut(tSfFade#)
            color sprite CSF_LOGO, rgb(255 - 120 * tSfFade#, 255 - 170 * tSfFade#, 255 - 120 * tSfFade#, 255 * (1 - tSfFade#))
            color sprite CSF_MIRROR, rgb(120, 165, 235, 80 * (1 - tSfFade#))
        endif
        if tSfF = 300
            screenshot env$("FISH_TRAILER_OUT") + "/trailer_surface_logo_clouds"
        endif
        capSurfStep()
        runto frame_menu_render
    next
    record stop
endtest

` THE LOGO ON THE MAIN MENU, as it comes in the first time the menu is there. not part of the trailer: a look
` at the logo of fish_headers_logo where the game puts it.
test trailer_menu_logo from trailerShot
    GAME_ENDLESS = 1
    REQUEST_GAME_END = 1
    runto menu_transition
    trailerRecord("trailer_menu_logo")
    for tMlF = 0 to 420
        if tMlF = 400
            screenshot env$("FISH_TRAILER_OUT") + "/trailer_menu_logo_still"
        endif
        runto frame_menu_render
    next
    record stop
endtest

` AVA'S BOTTLE on the water of the main menu, close up. not part of the trailer: a look at it where the game puts it.
