remstart
    THE STEAM PAGE'S ART
    The capsules, the library's hero and the logo are frames of the game, set up by the tests here and
    cut to Steam's sizes by build/capsule_cut.py. When the art changes, they are rendered again:
    .\build\render-capsules.ps1.

    The tests are trailer shots (trailerShot in fish_tests_trailer), so they only run when FISH_TRAILER
    is 1, and they do nothing unless FISH_CAPSULE is 1 too: render-capsules.ps1 sets both, and
    FISH_RENDER_SCALE=7, so the world (570 x 320) is drawn 3990 x 2240 and `screenshot` saves that.
    A screenshot is the frame before the screen effect (the wobble of the water), so it is sharp.

    Every frame goes to FISH_CAPSULE_OUT/raw/<name>.png, and the test prints a [capsule] line for it.
    The cutter reads those lines from raw/run.log:
        [capsule] take <name>
        [capsule] region <name> <x> <y> <w> <h>      a box in the world's own pixels (570 x 320)

    THE KEY ART is the first shot of the trailer: a seahorse, a crab and a seahorse in a row, and a fourth
    seahorse over the crab, that the crab swaps with, so the three seahorses pop. It is taken before the
    swap (keyart_ready) and every 3 frames through it (keyart_swap_NN). THE LOGO is the title, the way the
    trailer shows it, over black and over white, so the cutter can work out how see-through each pixel is.
remend


test capsule_keyart from trailerShot
    if val(env$("FISH_CAPSULE")) = 0 then end
    tCaOut$ = env$("FISH_CAPSULE_OUT")
    if tCaOut$ = "" then tCaOut$ = "capsules"
    trailerNoUi()
    trailerFishAway()
    for tCaF = 1 to 120
        trailerHideBut(-1, -1, -1, -1)
        runto update_frame
    next

    ` stripes of kinds that never match, and none of them is a seahorse or a crab, all hidden (as in
    ` trailer_first_pop)
    for tCaY = 0 to CELL_ROW_COUNT - 1
        for tCaX = 0 to CELL_COLUMN_COUNT - 1
            tCaK = tCaX + 2 * tCaY
            tCaK = tCaK mod 5
            tCaKind = TEX_PUFFER
            if tCaK = 1 then tCaKind = TEX_CATFISH
            if tCaK = 2 then tCaKind = TEX_GOLDFISH
            if tCaK = 3 then tCaKind = TEX_ANGELFISH
            if tCaK = 4 then tCaKind = TEX_WORM
            trailerPut(tCaX, tCaY, tCaKind)
        next
    next
    tCaMid = CELL_COLUMN_COUNT / 2
    tCaRow = CELL_ROW_COUNT / 2
    tCaL = trailerIndex(tCaMid - 1, tCaRow)
    tCaM = trailerIndex(tCaMid, tCaRow)
    tCaR = trailerIndex(tCaMid + 1, tCaRow)
    tCaA = trailerIndex(tCaMid, tCaRow - 1)
    trailerPut(tCaMid - 1, tCaRow, TEX_BASS)
    trailerPut(tCaMid, tCaRow, TEX_CRAB)
    trailerPut(tCaMid + 1, tCaRow, TEX_BASS)
    trailerPut(tCaMid, tCaRow - 1, TEX_BASS)
    SCHOOL_FACE(tCaL) = 1
    SCHOOL_FACE(tCaR) = -1
    SCHOOL_FACE(tCaA) = 1
    SCHOOL_SNAP = 1
    tCaY0 = getCellY(tCaRow)
    tCaYa = getCellY(tCaRow - 1)
    trailerCursor(tCaMid, tCaRow)
    hide sprite SCORE_TEXT_VIEW_SPRITE

    ` the four in their places, and the cursor on the crab, held until the sea has settled
    for tCaF = 0 to 60
        hintShow(0)
        trailerHideBut(tCaL, tCaM, tCaR, tCaA)
        for tCaC = 0 to 2
            position sprite CELLS(tCaL + tCaC).spriteId, getCellX((tCaMid - 1) + tCaC), tCaY0
            set sprite alpha CELLS(tCaL + tCaC).spriteId, 255
        next
        position sprite CELLS(tCaA).spriteId, getCellX(tCaMid), tCaYa
        set sprite alpha CELLS(tCaA).spriteId, 255
        set sprite alpha SELECTION_SPRITE, 90
        set sprite all texcoord1 SELECTION_SPRITE, 112 / 255.0, 140 / 255.0, 224 / 255.0, 1
        runto update_frame
    next

    ` where the four are: the cutter frames them
    tCaX0 = getCellX(tCaMid - 1) - CELL_SIZE / 2
    tCaY1 = tCaYa - CELL_SIZE / 2
    tCaW = CELL_SIZE * 3
    tCaH = CELL_SIZE * 2
    print "[capsule] region fish " + str$(tCaX0) + " " + str$(tCaY1) + " " + str$(tCaW) + " " + str$(tCaH)
    screenshot tCaOut$ + "/raw/keyart_ready"
    print "[capsule] take keyart_ready"

    ` the swap, from the middle. the crab goes up, and the row of three seahorses pops. once the fish
    ` start to fall, every fish is hidden, so the sea stays empty.
    trailerMove(0, -1, 1)
    tCaGone = 0
    for tCaF = 0 to 60
        hintShow(0)
        if COMBO_PHASE >= 2 then tCaGone = 1
        if tCaGone
            trailerHideBut(-1, -1, -1, -1)
            set sprite alpha SELECTION_SPRITE, 0
            set sprite all texcoord1 SELECTION_SPRITE, 0, 0, 0, 0
        else
            trailerHideBut(tCaL, tCaM, tCaR, tCaA)
        endif
        runto update_frame
        if tCaF mod 3 = 0
            tCaName$ = "keyart_swap_" + str$(tCaF)
            screenshot tCaOut$ + "/raw/" + tCaName$
            print "[capsule] take " + tCaName$
        endif
    next
endtest


` the open sea with nothing on it but schools far out, for the library's hero and the page's background
test capsule_sea from trailerShot
    if val(env$("FISH_CAPSULE")) = 0 then end
    tCaOut$ = env$("FISH_CAPSULE_OUT")
    if tCaOut$ = "" then tCaOut$ = "capsules"
    trailerNoUi()
    trailerFishAway()
    hide sprite SCORE_TEXT_VIEW_SPRITE
    FLOCK_PULL_GRID = 0
    trailerSchool(TEX_GOLDFISH, 7, 120, 90, 1)
    trailerSchool(TEX_CATFISH, 6, 400, 200, -1)
    trailerSchool(TEX_ANGELFISH, 6, 260, 60, 1)
    for tCaF = 1 to 180
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        set sprite alpha SELECTION_SPRITE, 0
        runto update_frame
    next
    screenshot tCaOut$ + "/raw/sea"
    print "[capsule] take sea"
endtest


` the title, as the trailer shows it, over black and then over white; on one line, and a word to a line
test capsule_logo from trailerShot
    if val(env$("FISH_CAPSULE")) = 0 then end
    tCaOut$ = env$("FISH_CAPSULE_OUT")
    if tCaOut$ = "" then tCaOut$ = "capsules"
    trailerNoUi()
    trailerFishAway()
    hide sprite SCORE_TEXT_VIEW_SPRITE
    ` the black (or white) under the words, over everything else
    tCaBack = 0
    reserve sprite id(tCaBack)
    sprite tCaBack, 0, 0, TEX_PIXEL
    set sprite offset tCaBack, 0, 0
    size sprite tCaBack, WORLD_WIDTH, WORLD_HEIGHT
    order sprite tCaBack, 290
    trailerWordOn("Fish", 0)
    trailerWordOn("Fish", 0)
    trailerWordOn("Pop", 0)
    hide sprite tCaBack
    trailerTitleLayout(WORLD_HEIGHT / 2)
    for tCaF = 0 to 20
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 14, 1)
        runto update_frame
    next
    print "[capsule] debug word0 " + str$(TR_WORD_X(0)) + " " + str$(TR_WORD_Y(0)) + " n " + str$(TR_WORD_COUNT)
    screenshot tCaOut$ + "/raw/logo_sea"
    print "[capsule] take logo_sea"
    show sprite tCaBack
    for tCaLay = 0 to 1
        if tCaLay = 1
            TR_WORD_LINE(1) = 1
            TR_WORD_LINE(2) = 2
        endif
        trailerTitleLayout(WORLD_HEIGHT / 2)
        for tCaBg = 0 to 1
            if tCaBg = 0 then color sprite tCaBack, rgb(0, 0, 0)
            if tCaBg = 1 then color sprite tCaBack, rgb(255, 255, 255)
            for tCaF = 0 to 20
                hintShow(0)
                trailerHideBut(-1, -1, -1, -1)
                set sprite alpha SELECTION_SPRITE, 0
                trailerRiseTitle(400, 14, 1)
                ` 290: over the sea's specks and bubbles, and under the words (at 299 it hid the words too)
                order sprite tCaBack, 290
                for tCaN = 0 to TR_WORD_COUNT - 1
                    order text TR_WORD(tCaN), 300
                next
                runto update_frame
            next
            tCaName$ = "logo"
            if tCaLay = 1 then tCaName$ = "logo_stack"
            if tCaBg = 0 then tCaName$ = tCaName$ + "_black"
            if tCaBg = 1 then tCaName$ = tCaName$ + "_white"
            screenshot tCaOut$ + "/raw/" + tCaName$
            print "[capsule] take " + tCaName$
        next
    next
endtest


` DRAFTS of new key art (2026-11-05). the trailer's first shot, turned over: a seahorse, the crab and a
` seahorse in a row, and the third seahorse under the crab, on a few cells of the board. the board is
` tilted in 3d: every fish, and the square of its cell, is a card of the fish effect, at the same pitch
` and yaw, placed by a camera, so the far cells are smaller. the T itself is laid out flat, every fish of
` it the same size and in a straight line, so it reads cleanly over the board. a fish and its square are
` one PIECE, which moves as one: it falls in, swaps, pops. the rings of the game lift, lean and push
` every piece as they pass, the way frame_fish_fx does it to the fish on the board.
` the reef is a base along the bottom of the picture, in front of everything but the title: the board is
` stretched across the whole screen for it, the coral grows on its bottom rows and up its corners, and
` the coral effect's Warp bends it a little off of the cells. schools swim out in the water, the diver
` and Ava are far off, bubbles come up off of the reef, and the tip of a tentacle only just shows.
` the title is built up out of copies of each word: a deep edge behind it, a dark outline, a pale rim,
` and the face. "Pop" has a splash behind it, puffs of the smokes of a pop, thickest behind the middle of
` the word. build/capsule_drafts.py cuts the stills, and composites them. capsule_anim_title records the
` title coming in, as a video.
abstract test capDraftShot from trailerShot
    global CAPD_ORDER_REEF = 40 `the coral, over the pieces (29 to 33), the schools, Ava and the diver
    global CAPD_ORDER_BUBBLES = 42
    global CAPD_ORDER_PUFF = 200 `the splash, well under the words of the title (293 to 297)
    ` every text of the title, and which word it is part of, and where it sits from the middle of that word
    global CAPD_TXT_N = 0
    global dim CAPD_TXT(128)
    global dim CAPD_TXT_W(128)
    global dim CAPD_TXT_DX#(128)
    global dim CAPD_TXT_DY#(128)
    global dim CAPD_TXT_SZ(128)
    global CAPD_W_N = 0
    global dim CAPD_W_X#(4)
    global dim CAPD_W_Y#(4)
    ` THE PIECES. the card of the fish, of the square under it, and of the cursor's lit edge (or 0); where
    ` it is, how big the fish and the square are, their colors, and how much the fish is lifted
    global CAPD_C_N = 0
    global dim CAPD_C_FISH(80)
    global dim CAPD_C_TILE(80)
    global dim CAPD_C_EDGE(80)
    global dim CAPD_C_X#(80)
    global dim CAPD_C_Y#(80)
    global dim CAPD_C_S#(80)
    global dim CAPD_C_TS#(80)
    global dim CAPD_C_R(80)
    global dim CAPD_C_G(80)
    global dim CAPD_C_B(80)
    global dim CAPD_C_A(80)
    global dim CAPD_C_TR(80)
    global dim CAPD_C_TG(80)
    global dim CAPD_C_TB(80)
    global dim CAPD_C_TA(80)
    global dim CAPD_C_LIFT#(80)
    ` and how it is moving: pushed up or down the screen, how much of it shows (0 to 1), more pitch, yaw
    ` and lift, and how much bigger it is
    global dim CAPD_C_DY#(80)
    global dim CAPD_C_SHOW#(80)
    global dim CAPD_C_DP#(80)
    global dim CAPD_C_DYAW#(80)
    global dim CAPD_C_DLIFT#(80)
    global dim CAPD_C_SQ#(80)
    ` the card of the game's own ink that goes over a piece's tile, on the cells of the board that are
    ` inked and the ones next to them, or 0. see capDraftInkCard.
    global dim CAPD_C_INK(80)
    ` and which cell of the key art's board that piece is on, for its ink's corners
    global dim CAPD_C_IR(80)
    global dim CAPD_C_IC(80)
    ` the board of the key art: its middle, the size of a cell, and how far off the eye is. capDraftProject
    ` puts a spot of it on the screen, in CAPD_PX#, CAPD_PY#.
    global CAPD_G_X# = 0
    global CAPD_G_Y# = 0
    global CAPD_G_CELL# = 0
    global CAPD_G_FOCAL# = 300
    global CAPD_PX# = 0
    global CAPD_PY# = 0
    ` CornerCardEffect: a picture on four corners, so that the cells of the ink meet with no seam
    global CAPD_CORNER_FX = 0
    ` how much of the ink shows
    global CAPD_INK_ALPHA = 165
    ` and what kind of fish it is drawn as: belly up (half a turn of pitch), and what the effect takes on top
    ` of its glow (2000 for a rainbow fish, 4000 for one in a bubble). see FishEffect.fx.
    global dim CAPD_C_BELLY#(80)
    global dim CAPD_C_FX#(80)
    global CAPD_RING_LEAN# = .6 `how much of the lean of the rings the pieces take: all of it was too much
    ` the four pieces of the T: 0 the seahorse under the crab, 1 the crab, 2 and 3 the seahorses beside it
    global dim CAPD_T_CELL(4)
    global CAPD_PITCH# = 0
    global CAPD_YAW# = 0
    ` what the rings do to a spot, from capDraftShock
    global CAPD_SH_LIFT# = 0
    global CAPD_SH_LX# = 0
    global CAPD_SH_LY# = 0
    ` the puffs of the splash behind "Pop": where each one is, how big, which smoke, and how late it starts
    global CAPD_PUFF_N = 0
    global dim CAPD_PUFF(16)
    global dim CAPD_PUFF_X#(16)
    global dim CAPD_PUFF_Y#(16)
    global dim CAPD_PUFF_S#(16)
    global dim CAPD_PUFF_F0(16)
    global dim CAPD_PUFF_FN(16)
    global dim CAPD_PUFF_LATE#(16)
    global CAPD_POP_X# = 0 `where the middle of "Pop" is
    global CAPD_POP_Y# = 0
    global CAPD_POP_SIZE# = 0
    ` THE SMOKES OF A POP, the same five that SMOKE_ANIMS has: which texture, its first frame, and how many
    global dim CAPD_SMOKE_TEX(5)
    global dim CAPD_SMOKE_F0(5)
    global dim CAPD_SMOKE_FN(5)

` the five smokes of a pop on the board. the textures are the game's own, which a function cannot see.
function capDraftSmokes(csmA, csmB)
    CAPD_SMOKE_TEX(0) = csmA
    CAPD_SMOKE_F0(0) = 16
    CAPD_SMOKE_FN(0) = 8
    CAPD_SMOKE_TEX(1) = csmA
    CAPD_SMOKE_F0(1) = 56
    CAPD_SMOKE_FN(1) = 8
    CAPD_SMOKE_TEX(2) = csmB
    CAPD_SMOKE_F0(2) = 24
    CAPD_SMOKE_FN(2) = 12
    CAPD_SMOKE_TEX(3) = csmB
    CAPD_SMOKE_F0(3) = 48
    CAPD_SMOKE_FN(3) = 12
    CAPD_SMOKE_TEX(4) = csmB
    CAPD_SMOKE_F0(4) = 72
    CAPD_SMOKE_FN(4) = 12
endfunction

` EASING. t from 0 to 1.
function capEaseInOut(eiT#)
    eiOut# = 0
    if eiT# < .5 then eiOut# = 4 * eiT# * eiT# * eiT#
    if eiT# >= .5
        eiU# = 2 - 2 * eiT#
        eiOut# = 1 - eiU# * eiU# * eiU# / 2
    endif
endfunction eiOut#

function capEaseOut(eoT#)
    eoU# = 1 - eoT#
endfunction 1 - eoU# * eoU# * eoU#

` past its end and back: the ease of a word of the trailer popping in
function capEaseBack(ebT#)
    ebU# = ebT# - 1
endfunction 1 + 2.7 * ebU# * ebU# * ebU# + 1.7 * ebU# * ebU#

` a spring that has been let go, this many frames ago: 1 at the start, swinging through 0, and dying away
function capSpring(spA#, spRate#)
endfunction cos(spA# * spRate#) * pow(.87, spA#)

` one card of the fish effect: a fish, or with TEX_PIXEL, a square
function capDraftCard(cdKind, cdSize#, cdOrder)
    cdS = 0
    reserve sprite id(cdS)
    sprite cdS, 0, 0, cdKind
    set sprite offset cdS, .5, .5
    size sprite cdS, cdSize#, cdSize#
    set sprite effect cdS, FISH_FX_ID
    order sprite cdS, cdOrder
endfunction cdS

` a new piece, at rest where it is, and its number
function capDraftPiece(cpKind, cpX#, cpY#, cpFish#, cpTile#, cpR, cpG, cpB, cpA, cpTR, cpTG, cpTB, cpTA, cpLift#, cpFront, cpCursor)
    cpI = CAPD_C_N
    CAPD_C_N = CAPD_C_N + 1
    CAPD_C_X#(cpI) = cpX#
    CAPD_C_Y#(cpI) = cpY#
    CAPD_C_S#(cpI) = cpFish#
    CAPD_C_TS#(cpI) = cpTile#
    CAPD_C_R(cpI) = cpR
    CAPD_C_G(cpI) = cpG
    CAPD_C_B(cpI) = cpB
    CAPD_C_A(cpI) = cpA
    CAPD_C_TR(cpI) = cpTR
    CAPD_C_TG(cpI) = cpTG
    CAPD_C_TB(cpI) = cpTB
    CAPD_C_TA(cpI) = cpTA
    CAPD_C_LIFT#(cpI) = cpLift#
    CAPD_C_DY#(cpI) = 0
    CAPD_C_SHOW#(cpI) = 1
    CAPD_C_DP#(cpI) = 0
    CAPD_C_DYAW#(cpI) = 0
    CAPD_C_DLIFT#(cpI) = 0
    CAPD_C_SQ#(cpI) = 1
    CAPD_C_BELLY#(cpI) = 0
    CAPD_C_FX#(cpI) = 0
    CAPD_C_INK(cpI) = 0
    ` the pieces of the T are over the rest of the board
    CAPD_C_EDGE(cpI) = 0
    if cpCursor
        CAPD_C_EDGE(cpI) = capDraftCard(TEX_PIXEL, cpTile#, 30)
    endif
    CAPD_C_TILE(cpI) = capDraftCard(TEX_PIXEL, cpTile#, 29 + 2 * cpFront)
    CAPD_C_FISH(cpI) = capDraftCard(cpKind, cpFish#, 32 + cpFront)
    capDraftPose(cpI)
endfunction cpI

` what the rings that are going do to a spot on the screen: how far up the bump it is, and how steep the
` bump is under it, each way. the same as frame_fish_fx works out for a fish on the board.
function capDraftShock(csX#, csY#)
    CAPD_SH_LIFT# = 0
    CAPD_SH_LX# = 0
    CAPD_SH_LY# = 0
    csCx# = (csX# - GRID_POS.x) / CELL_SIZE
    csCy# = (csY# - GRID_POS.y) / CELL_SIZE
    csTouched = 0
    for csS = 0 to SHOCK_LIVE_COUNT - 1
        csDx# = csCx# - SHOCK_LIVE_X#(csS)
        csDy# = csCy# - SHOCK_LIVE_Y#(csS)
        csDist# = sqrt(csDx# * csDx# + csDy# * csDy#)
        csAhead# = (csDist# - SHOCK_LIVE_R#(csS)) / SHOCK_WIDTH#
        if abs(csAhead#) < 1
            csTouched = 1
            csP# = SHOCK_LIVE_P#(csS)
            CAPD_SH_LIFT# = CAPD_SH_LIFT# + (.5 + .5 * cos(csAhead# * 3.14159)) * csP#
            if csDist# > .01
                csSlope# = sin(csAhead# * 3.14159) * csP#
                CAPD_SH_LX# = CAPD_SH_LX# + (csSlope# * csDx#) / csDist#
                CAPD_SH_LY# = CAPD_SH_LY# + (csSlope# * csDy#) / csDist#
            endif
        endif
    next
    if csTouched
        ` the sums bend over as they get big, so that rings on top of rings still show
        CAPD_SH_LIFT# = CAPD_SH_LIFT# / sqrt(1 + (CAPD_SH_LIFT# * CAPD_SH_LIFT#) / (SHOCK_LIFT_MAX# * SHOCK_LIFT_MAX#))
        csBend# = sqrt(1 + (CAPD_SH_LX# * CAPD_SH_LX# + CAPD_SH_LY# * CAPD_SH_LY#) / (SHOCK_LEAN_MAX# * SHOCK_LEAN_MAX#))
        CAPD_SH_LX# = CAPD_SH_LX# / csBend#
        CAPD_SH_LY# = CAPD_SH_LY# / csBend#
    endif
endfunction

` put the cards of a piece where it is now: its place, how it is moving, and what the rings do to it
function capDraftPose(cqI)
    cqFish = CAPD_C_FISH(cqI)
    cqTile = CAPD_C_TILE(cqI)
    cqEdge = CAPD_C_EDGE(cqI)
    cqShow# = CAPD_C_SHOW#(cqI)
    if cqShow# <= 0
        hide sprite cqFish
        hide sprite cqTile
        if cqEdge
            hide sprite cqEdge
        endif
        if CAPD_C_INK(cqI)
            hide sprite CAPD_C_INK(cqI)
        endif
        exitfunction
    endif
    if cqShow# > 1 then cqShow# = 1
    show sprite cqFish
    show sprite cqTile
    if cqEdge
        show sprite cqEdge
    endif
    if CAPD_C_INK(cqI)
        show sprite CAPD_C_INK(cqI)
    endif
    cqX# = CAPD_C_X#(cqI)
    cqY# = CAPD_C_Y#(cqI) + CAPD_C_DY#(cqI)
    capDraftShock(cqX#, cqY#)
    CAPD_SH_LX# = CAPD_SH_LX# * CAPD_RING_LEAN#
    CAPD_SH_LY# = CAPD_SH_LY# * CAPD_RING_LEAN#
    ` positive yaw faces it to the right, and positive pitch faces it up, which is the other way from y
    cqPitch# = CAPD_PITCH# + CAPD_C_DP#(cqI) - CAPD_SH_LY# * SHOCK_TILT#
    cqYaw# = CAPD_YAW# + CAPD_C_DYAW#(cqI) + CAPD_SH_LX# * SHOCK_TILT#
    cqSq# = CAPD_C_SQ#(cqI)
    cqFishS# = CAPD_C_S#(cqI) * cqSq#
    cqTileS# = CAPD_C_TS#(cqI) * cqSq#
    cqPushX# = CAPD_SH_LX# * SHOCK_PUSH# * cqFishS#
    cqPushY# = CAPD_SH_LY# * SHOCK_PUSH# * cqFishS#
    cqLift# = CAPD_C_LIFT#(cqI) + CAPD_C_DLIFT#(cqI) + CAPD_SH_LIFT# * SHOCK_LIFT#

    position sprite cqFish, cqX#, cqY#
    size sprite cqFish, cqFishS#, cqFishS#
    set sprite all texcoord1 cqFish, cqPitch# + CAPD_C_BELLY#(cqI), cqYaw#, 1, cqFishS#
    set sprite all texcoord2 cqFish, cqPushX#, cqPushY#, cqLift#, CAPD_C_FX#(cqI)
    color sprite cqFish, rgb(CAPD_C_R(cqI), CAPD_C_G(cqI), CAPD_C_B(cqI), CAPD_C_A(cqI) * cqShow#)

    position sprite cqTile, cqX#, cqY#
    size sprite cqTile, cqTileS# * .9, cqTileS# * .9
    set sprite all texcoord1 cqTile, cqPitch#, cqYaw#, 1, cqTileS# * .9
    set sprite all texcoord2 cqTile, cqPushX#, cqPushY#, cqLift# * .5, 0
    color sprite cqTile, rgb(CAPD_C_TR(cqI), CAPD_C_TG(cqI), CAPD_C_TB(cqI), CAPD_C_TA(cqI) * cqShow#)

    if cqEdge
        position sprite cqEdge, cqX#, cqY#
        size sprite cqEdge, cqTileS# * .98, cqTileS# * .98
        set sprite all texcoord1 cqEdge, cqPitch#, cqYaw#, 1, cqTileS# * .98
        set sprite all texcoord2 cqEdge, cqPushX#, cqPushY#, cqLift# * .5, 0
        color sprite cqEdge, rgb(112, 140, 224, 235 * cqShow#)
    endif
    cqInk = CAPD_C_INK(cqI)
    if cqInk
        ` the ink lies on the board itself, so its corners are the board's own, and a cell's corners are
        ` its neighbours' too. it only drops in with its piece, and does not rock with it.
        cqU# = CAPD_C_IC(cqI) - 4
        cqV# = 3.5 - CAPD_C_IR(cqI)
        cqDy# = CAPD_C_DY#(cqI)
        capDraftProject(cqU# - .5, cqV# + .5)
        cqAx# = CAPD_PX#
        cqAy# = CAPD_PY# + cqDy#
        capDraftProject(cqU# + .5, cqV# + .5)
        cqBx# = CAPD_PX#
        cqBy# = CAPD_PY# + cqDy#
        capDraftProject(cqU# - .5, cqV# - .5)
        cqCx# = CAPD_PX#
        cqCy# = CAPD_PY# + cqDy#
        capDraftProject(cqU# + .5, cqV# - .5)
        set sprite all texcoord1 cqInk, cqAx#, cqAy#, cqBx#, cqBy#
        set sprite all texcoord2 cqInk, cqCx#, cqCy#, CAPD_PX#, CAPD_PY# + cqDy#
        color sprite cqInk, rgb(255, 255, 255, CAPD_INK_ALPHA * cqShow#)
    endif
endfunction

function capDraftPoseAll()
    for cpaI = 0 to CAPD_C_N - 1
        capDraftPose(cpaI)
    next
endfunction

` a piece falling in, this many frames after it started: it drops faster and faster, as a fish that
` drops in on the board does, tipped back and turning a little as it comes, and it fades in at the start.
` it lands with a squash, and rocks and settles. before it starts it is not there.
function capDraftFallAt(cfI, cfAge)
    cfLen = 16
    cfH# = CAPD_C_TS#(cfI) * 3
    if cfAge < 0
        CAPD_C_SHOW#(cfI) = 0
        exitfunction
    endif
    if cfAge < cfLen
        cfT# = cfAge
        cfT# = cfT# / cfLen
        CAPD_C_DY#(cfI) = 0 - cfH# * (1 - cfT# * cfT#)
        CAPD_C_SHOW#(cfI) = cfT# * 4
        CAPD_C_DP#(cfI) = -.3 * (1 - cfT#)
        CAPD_C_DYAW#(cfI) = .22 * sin(cfT# * 4 + cfI) * (1 - cfT#)
        CAPD_C_SQ#(cfI) = 1
        CAPD_C_DLIFT#(cfI) = .15 * (1 - cfT#)
    else
        cfA# = cfAge - cfLen
        cfDecay# = pow(.87, cfA#)
        CAPD_C_SHOW#(cfI) = 1
        ` a hop off of the bottom, and less of one, and less
        CAPD_C_DY#(cfI) = 0 - abs(sin(cfA# * .32)) * cfH# * .07 * cfDecay#
        CAPD_C_SQ#(cfI) = 1 - .1 * capSpring(cfA#, .5)
        CAPD_C_DP#(cfI) = .18 * sin(cfA# * .42) * cfDecay#
        CAPD_C_DYAW#(cfI) = .08 * sin(cfA# * .33 + cfI) * cfDecay#
        CAPD_C_DLIFT#(cfI) = 0
    endif
endfunction

` which cells of the key art's board are inked: a patch on each side. the key art's board is 9 cells by 7,
` and the game's own board, that the ink is really on, is 13 by 9, so a cell of the one is 2 columns and
` 1 row in, on the other.
function capDraftInked(ciR, ciC)
    ciYes = 0
    if ciR = 1 and ciC = 2 then ciYes = 1
    if ciR = 1 and ciC = 3 then ciYes = 1
    if ciR = 2 and ciC = 2 then ciYes = 1
    if ciR = 3 and ciC = 7 then ciYes = 1
    if ciR = 4 and ciC = 7 then ciYes = 1
    if ciR = 3 and ciC = 8 then ciYes = 1
endfunction ciYes

` a card of the game's own ink, for one cell of the key art's board. the ink can only be drawn flat, so a
` copy of the board's ink sprite draws into a render target of its own, the size of a cell, with a camera
` on the game board's cell that this one is. the card shows that render target, tilted with its piece.
function capDraftInkCard(ckR, ckC, ckSize#)
    ckK = RENDER_SCALE
    ckCell = CELL_SIZE
    ckTex = 0
    reserve texture id(ckTex)
    create texture target ckTex, ckCell * ckK, ckCell * ckK
    ckOut = 0
    reserve render target id(ckOut)
    render target ckOut, ckTex
    set render target background color ckOut, rgb(0, 0, 0, 0)
    ckCam = 0
    reserve camera id(ckCam)
    position camera ckCam, getCellX(ckC + 2), getCellY(ckR + 1)
    set render target camera ckOut, ckCam
    ckInk = 0
    reserve sprite id(ckInk)
    sprite ckInk, getCellX(0) - ckCell / 2 - ckCell, getCellY(0) - ckCell / 2 - ckCell, TEX_PIXEL
    set sprite offset ckInk, 0, 0
    size sprite ckInk, (CELL_COLUMN_COUNT + 2) * ckCell, (CELL_ROW_COUNT + 2) * ckCell
    set sprite effect ckInk, INK_FX_ID
    set sprite render target ckInk, ckOut
    ckCard = 0
    reserve sprite id(ckCard)
    sprite ckCard, 0, 0, ckTex
    set sprite effect ckCard, CAPD_CORNER_FX
    order sprite ckCard, 31
endfunction ckCard

` where a spot of the key art's board is on the screen, cpU# cells to the right of its middle and cpV#
` cells up from it, the same way that capDraftGrid places its cells. it goes in CAPD_PX#, CAPD_PY#.
function capDraftProject(cpU#, cpV#)
    cpPx# = cpU# * CAPD_G_CELL#
    cpPy# = cpV# * CAPD_G_CELL#
    cpZ# = cpPy# * sin(CAPD_PITCH#) + cpPx# * sin(CAPD_YAW#)
    cpK# = CAPD_G_FOCAL# / (CAPD_G_FOCAL# + cpZ#)
    CAPD_PX# = CAPD_G_X# + cpPx# * cos(CAPD_YAW#) * cpK#
    CAPD_PY# = CAPD_G_Y# - cpPy# * cos(CAPD_PITCH#) * cpK#
endfunction

` the board of the key art, 9 cells by 7, around cgX#, cgY#, cgCell# pixels to a cell, tilted, so it goes a
` long way off into the distance. the T is at the middle, and the cursor is on the crab. the fish of the
` other cells are dimmer, and fade away toward the edges. a few of them are what the game has: two rainbow
` fish, one in a bubble, and two belly up. the cells that come too close to the camera are left out. the T is laid out flat around the crab's cell, all at the size that that cell is, so the T is
` straight while the rest of the board goes off into the distance.
function capDraftGrid(cgX#, cgY#, cgCell#, cgPitch#, cgYaw#, cgBass, cgCrab, cgK0, cgK1, cgK2, cgK3, cgK4)
    CAPD_PITCH# = cgPitch#
    CAPD_YAW# = cgYaw#
    cgFocal# = 300
    CAPD_G_X# = cgX#
    CAPD_G_Y# = cgY#
    CAPD_G_CELL# = cgCell#
    CAPD_G_FOCAL# = cgFocal#
    if CAPD_CORNER_FX = 0
        reserve effect id(CAPD_CORNER_FX)
        effect CAPD_CORNER_FX, "Fish/Shaders/CornerCardEffect"
    endif
    cgCosP# = cos(cgPitch#)
    cgSinP# = sin(cgPitch#)
    cgCosY# = cos(cgYaw#)
    cgSinY# = sin(cgYaw#)
    CAPD_C_N = 0
    ` where the crab's cell is (row 1, column 2), and how big, which the T is laid out from
    cgTPy# = .5 * cgCell#
    cgTK# = cgFocal# / (cgFocal# + cgTPy# * cgSinP#)
    cgTX# = cgX#
    cgTY# = cgY# - cgTPy# * cgCosP# * cgTK#
    cgTS# = cgCell# * cgTK#
    for cgR = 0 to 6
        for cgC = 0 to 8
            cgU# = cgC - 4
            cgV# = 3.5 - cgR
            cgPx# = cgU# * cgCell#
            cgPy# = cgV# * cgCell#
            cgUpY# = cgPy# * cgCosP#
            cgZ# = cgPy# * cgSinP#
            cgSx# = cgPx# * cgCosY#
            cgZ# = cgZ# + cgPx# * cgSinY#
            cgK# = cgFocal# / (cgFocal# + cgZ#)
            cgScrX# = cgX# + cgSx# * cgK#
            cgScrY# = cgY# - cgUpY# * cgK#
            cgSize# = cgCell# * cgK#
            cgNear = 0
            if cgZ# < -150 then cgNear = 1

            ` which of the T this is, or -1. the T's own cells are flat, from the crab's.
            cgSlot = -1
            if cgR = 4 and cgC = 4 then cgSlot = 0
            if cgR = 3 and cgC = 4 then cgSlot = 1
            if cgR = 3 and cgC = 3 then cgSlot = 2
            if cgR = 3 and cgC = 5 then cgSlot = 3
            if cgSlot >= 0
                cgScrX# = cgTX# + (cgC - 4) * cgTS#
                cgScrY# = cgTY# + (cgR - 3) * cgTS#
                cgSize# = cgTS#
            endif
            cgKind = cgBass
            if cgSlot = 1 then cgKind = cgCrab
            if cgSlot < 0
                cgM = (cgC + 2 * cgR) mod 5
                cgKind = cgK0
                if cgM = 1 then cgKind = cgK1
                if cgM = 2 then cgKind = cgK2
                if cgM = 3 then cgKind = cgK3
                if cgM = 4 then cgKind = cgK4
            endif

            ` how far the cell is from the T, which fades the far ones away
            cgDx# = abs(cgU#)
            cgDy# = abs(cgV# - .1)
            cgFar# = cgDx# * .24 + cgDy# * .26
            if cgFar# > 1 then cgFar# = 1
            cgTileA = 150 - 140 * cgFar#
            cgFishA = 225 - 215 * cgFar#

            if cgSlot >= 0
                cgCursor = 0
                cgTR = 12
                cgTG = 24
                cgTB = 52
                cgTA = 200
                if cgSlot = 1
                    cgCursor = 1
                    cgTR = 18
                    cgTG = 28
                    cgTB = 58
                    cgTA = 245
                endif
                CAPD_T_CELL(cgSlot) = capDraftPiece(cgKind, cgScrX#, cgScrY#, cgSize# * .62, cgSize#, 255, 255, 255, 255, cgTR, cgTG, cgTB, cgTA, .08, 1, cgCursor)
            else
                if cgNear = 0
                    ` the ones that the game would show: rainbow, in a bubble, belly up. they show a little more.
                    cgFx# = 0
                    cgBelly# = 0
                    if cgR = 2 and cgC = 1 then cgFx# = 2000
                    if cgR = 1 and cgC = 6 then cgFx# = 2000
                    if cgR = 4 and cgC = 6 then cgFx# = 4000
                    if cgR = 2 and cgC = 7 then cgBelly# = 3.14159
                    if cgR = 5 and cgC = 2 then cgBelly# = 3.14159
                    if cgFx# > 0 or cgBelly# > 0
                        if cgFishA < 170 then cgFishA = 170
                    endif
                    cgI = capDraftPiece(cgKind, cgScrX#, cgScrY#, cgSize# * .58, cgSize#, 150, 175, 215, cgFishA, 10, 22, 48, cgTileA, 0, 0, 0)
                    CAPD_C_FX#(cgI) = cgFx#
                    CAPD_C_BELLY#(cgI) = cgBelly#
                    ` the game's own ink, on the board's tilt: on the inked cells, and on the cells next to them,
                    ` where its glow spills over
                    cgInkNear = 0
                    for cgIr = cgR - 1 to cgR + 1
                        for cgIc = cgC - 1 to cgC + 1
                            if capDraftInked(cgIr, cgIc) then cgInkNear = 1
                        next
                    next
                    if cgInkNear
                        CAPD_C_INK(cgI) = capDraftInkCard(cgR, cgC, cgSize#)
                        CAPD_C_IR(cgI) = cgR
                        CAPD_C_IC(cgI) = cgC
                        capDraftPose(cgI)
                    endif
                endif
            endif
        next
    next
endfunction

function capDraftText(ctText$, ctX#, ctY#, ctSize, ctAngle#, ctColor, ctOrder)
    ctId = 0
    reserve text id(ctId)
    text ctId, ctX#, ctY#, SCORE_FONT, ctText$
    size text y ctId, ctSize
    set text offset ctId, .5, .5
    set text position ctId, ctX#, ctY#
    rotate text ctId, ctAngle#
    color text ctId, ctColor
    order text ctId, ctOrder
    set text alpha ctId, 255
    ` it is kept, as part of the word that is being built, so that the word can be moved as one
    CAPD_TXT(CAPD_TXT_N) = ctId
    CAPD_TXT_W(CAPD_TXT_N) = CAPD_W_N
    CAPD_TXT_DX#(CAPD_TXT_N) = ctX# - CAPD_W_X#(CAPD_W_N)
    CAPD_TXT_DY#(CAPD_TXT_N) = ctY# - CAPD_W_Y#(CAPD_W_N)
    CAPD_TXT_SZ(CAPD_TXT_N) = ctSize
    CAPD_TXT_N = CAPD_TXT_N + 1
endfunction ctId

` one word of the title, dressed: a deep edge going down and to the right, a dark outline all around, a
` pale rim up and to the left, and the face over all of it. it is the next word, CAPD_W_N.
function capDraftWord(cwText$, cwX#, cwY#, cwSize, cwAngle#, cwFace, cwRim, cwNearR, cwNearG, cwNearB, cwFarR, cwFarG, cwFarB)
    CAPD_W_X#(CAPD_W_N) = cwX#
    CAPD_W_Y#(CAPD_W_N) = cwY#
    cwDepth = 12
    cwStep# = cwSize * .006
    for cwN = cwDepth to 1 step -1
        cwT# = cwN
        cwT# = cwT# / cwDepth
        cwR = cwNearR + (cwFarR - cwNearR) * cwT#
        cwG = cwNearG + (cwFarG - cwNearG) * cwT#
        cwB = cwNearB + (cwFarB - cwNearB) * cwT#
        cwId = capDraftText(cwText$, cwX# + cwN * cwStep# * .6, cwY# + cwN * cwStep#, cwSize, cwAngle#, rgb(cwR, cwG, cwB), 294)
    next
    ` the outline, under the deep edge's front
    cwLine# = cwSize * .035
    for cwA = 0 to 15
        cwAng# = cwA * .3927
        cwId = capDraftText(cwText$, cwX# + cos(cwAng#) * cwLine#, cwY# + sin(cwAng#) * cwLine#, cwSize, cwAngle#, rgb(4, 10, 34), 293)
    next
    cwId = capDraftText(cwText$, cwX# - cwSize * .012, cwY# - cwSize * .016, cwSize, cwAngle#, cwRim, 296)
    cwId = capDraftText(cwText$, cwX#, cwY#, cwSize, cwAngle#, cwFace, 297)
    CAPD_W_N = CAPD_W_N + 1
endfunction

` a word of the title, cwpScale# times its size around its middle, pushed down by cwpDrop# pixels, and with
` this much of it showing, from 0 to 255
function capDraftWordPose(cwpWord, cwpScale#, cwpDrop#, cwpAlpha)
    for cwpI = 0 to CAPD_TXT_N - 1
        if CAPD_TXT_W(cwpI) = cwpWord
            cwpId = CAPD_TXT(cwpI)
            set text position cwpId, CAPD_W_X#(cwpWord) + CAPD_TXT_DX#(cwpI) * cwpScale#, CAPD_W_Y#(cwpWord) + cwpDrop# + CAPD_TXT_DY#(cwpI) * cwpScale#
            size text y cwpId, CAPD_TXT_SZ(cwpI) * cwpScale#
            set text alpha cwpId, cwpAlpha
        endif
    next
endfunction

` the title around ttX#, ttY#, tilted by ttAngle#: two "Fish" over a big "Pop", jumbled, the first a
` little up and leaning back, the second a little down and leaning forward. ttScale# of 1 is a pop 104
` pixels tall. the words are 0, 1 and 2.
function capDraftTitle(ttX#, ttY#, ttScale#, ttAngle#)
    ttSin# = sin(ttAngle#)
    ttCos# = cos(ttAngle#)
    ttFish = 46 * ttScale#
    ` each word's place before the tilt: across from the middle, and down from it
    ttAx# = -44 * ttScale#
    ttAy# = -60 * ttScale#
    ttBx# = 44 * ttScale#
    ttBy# = -46 * ttScale#
    ttPy# = 22 * ttScale#
    capDraftWord("Fish", ttX# + ttAx# * ttCos# - ttAy# * ttSin#, ttY# + ttAx# * ttSin# + ttAy# * ttCos#, ttFish, ttAngle# - .1, rgb(214, 236, 255), rgb(255, 255, 255), 46, 92, 170, 10, 24, 70)
    capDraftWord("Fish", ttX# + ttBx# * ttCos# - ttBy# * ttSin#, ttY# + ttBx# * ttSin# + ttBy# * ttCos#, ttFish, ttAngle# + .08, rgb(214, 236, 255), rgb(255, 255, 255), 46, 92, 170, 10, 24, 70)
    CAPD_POP_X# = ttX# - ttPy# * ttSin#
    CAPD_POP_Y# = ttY# + ttPy# * ttCos#
    CAPD_POP_SIZE# = 104 * ttScale#
    capDraftWord("Pop", CAPD_POP_X#, CAPD_POP_Y#, CAPD_POP_SIZE#, ttAngle#, rgb(255, 214, 92), rgb(255, 250, 210), 214, 104, 40, 70, 20, 30)
endfunction

` THE SPLASH behind "Pop": puffs of the smokes of a pop, every one a different smoke, turn, flip, size and
` blue from the one before it. six big ones are packed in behind the middle of the word, and six smaller
` ones go out past its ends and over its top. none go under it, where they would cover the board.
function capDraftSplash()
    CAPD_PUFF_N = 12
    for cspI = 0 to CAPD_PUFF_N - 1
        cspS = 0
        reserve sprite id(cspS)
        if cspI < 6
            ` behind the word, across it, from one end to the other, a little up and down
            cspAcross# = (cspI - 2.5) / 2.5
            CAPD_PUFF_X#(cspI) = CAPD_POP_X# + cspAcross# * CAPD_POP_SIZE# * .62 + (rnd(20) - 10) * .01 * CAPD_POP_SIZE#
            CAPD_PUFF_Y#(cspI) = CAPD_POP_Y# + (rnd(30) - 18) * .01 * CAPD_POP_SIZE#
            CAPD_PUFF_S#(cspI) = CAPD_POP_SIZE# * (1.0 + rnd(50) * .01)
        else
            ` out past the ends, and over the top
            cspAng# = 3.0 + (cspI - 6) * .68 + rnd(20) * .01
            CAPD_PUFF_X#(cspI) = CAPD_POP_X# + cos(cspAng#) * CAPD_POP_SIZE# * (1.0 + rnd(25) * .01)
            CAPD_PUFF_Y#(cspI) = CAPD_POP_Y# + sin(cspAng#) * CAPD_POP_SIZE# * (.45 + rnd(15) * .01)
            CAPD_PUFF_S#(cspI) = CAPD_POP_SIZE# * (.5 + rnd(35) * .01)
        endif
        cspSmoke = (cspI * 3 + cspI / 5) mod 5
        CAPD_PUFF_F0(cspI) = CAPD_SMOKE_F0(cspSmoke)
        CAPD_PUFF_FN(cspI) = CAPD_SMOKE_FN(cspSmoke)
        CAPD_PUFF_LATE#(cspI) = rnd(18) * .01
        sprite cspS, CAPD_PUFF_X#(cspI), CAPD_PUFF_Y#(cspI), CAPD_SMOKE_TEX(cspSmoke)
        set sprite offset cspS, .5, .5
        rotate sprite cspS, rnd(628) * .01
        set sprite flip cspS, cspI mod 2, (cspI / 2) mod 2
        cspOrder = cspI mod 3
        order sprite cspS, CAPD_ORDER_PUFF + cspOrder
        ` the blues of the smoke on the board, and white
        cspTint = cspI mod 5
        if cspTint = 0 then color sprite cspS, rgb(143, 199, 255, 220)
        if cspTint = 1 then color sprite cspS, rgb(120, 172, 224, 210)
        if cspTint = 2 then color sprite cspS, rgb(225, 240, 255, 225)
        if cspTint = 3 then color sprite cspS, rgb(165, 215, 240, 215)
        if cspTint = 4 then color sprite cspS, rgb(190, 225, 255, 225)
        CAPD_PUFF(cspI) = cspS
    next
    capDraftSplashAt(.35)
endfunction

` the splash, from 0 (it has only just burst) to 1 (it has gone): each puff, from its own moment, grows out
` from the word, and runs through the frames of its smoke. past its end it is hidden.
function capDraftSplashAt(csaT#)
    for csaI = 0 to CAPD_PUFF_N - 1
        csaS = CAPD_PUFF(csaI)
        csaMine# = (csaT# - CAPD_PUFF_LATE#(csaI)) / (1 - CAPD_PUFF_LATE#(csaI))
        if csaMine# >= 1 or csaMine# < 0
            hide sprite csaS
        else
            show sprite csaS
            csaOut# = .5 + .5 * capEaseOut(csaMine#)
            csaX# = CAPD_POP_X# + (CAPD_PUFF_X#(csaI) - CAPD_POP_X#) * csaOut#
            csaY# = CAPD_POP_Y# + (CAPD_PUFF_Y#(csaI) - CAPD_POP_Y#) * csaOut#
            position sprite csaS, csaX#, csaY#
            size sprite csaS, CAPD_PUFF_S#(csaI) * csaOut#, CAPD_PUFF_S#(csaI) * csaOut#
            csaFrame = csaMine# * CAPD_PUFF_FN(csaI)
            if csaFrame > CAPD_PUFF_FN(csaI) - 1 then csaFrame = CAPD_PUFF_FN(csaI) - 1
            set sprite frame csaS, CAPD_PUFF_F0(csaI) + csaFrame
        endif
    next
endfunction

` bubbles off of the whole of "Pop", and a ring out from it through the water, that the fish and the
` picture bulge in, and a second, weaker one a moment behind it
function capDraftBurst(cbPower#)
    cbX = CAPD_POP_X#
    cbY = CAPD_POP_Y#
    cbR = CAPD_POP_SIZE# * .9
    spawnBubblesOnLayer(cbX, cbY, cbR, 26, 0, rgb(215, 235, 255), 299, 0, 230, 1.2)
    cbCellX# = (CAPD_POP_X# - GRID_POS.x) / CELL_SIZE
    cbCellY# = (CAPD_POP_Y# - GRID_POS.y) / CELL_SIZE
    spawnShockwave(cbCellX#, cbCellY#, cbPower#, 0)
    spawnShockwave(cbCellX#, cbCellY#, cbPower# * .5, 220)
endfunction

` the reef along the bottom of the picture: the board is stretched across the whole screen, 13 cells by 9
` (the most cells there are room for is 121), and coral grows on its bottom row, and climbs its corners.
` the very bottom of it is horror coral, which the tentacle comes up out of. it is drawn in front of the
` fish, so it hides the bottom of the board. (the ink is on the cards of the board: see capDraftGrid.)
function capDraftReef()
    GRID_SPAN = WORLD_WIDTH
    GRID_CENTER.y = 140
    resizeGrid(13, 9)
    trailerFishAway()
    for crI = 0 to CELL_COUNT - 1
        CORAL_CELLS(crI) = 0
        CORAL_SICK(crI) = 0
    next
    for crC = 0 to 12
        ` how many rows up from the bottom it grows, on this column
        crUp = 2
        if crC = 0 then crUp = 4
        if crC = 1 then crUp = 3
        if crC = 5 then crUp = 3
        if crC = 12 then crUp = 3
        for crR = 9 - crUp to 8
            CORAL_CELLS(crC + crR * 13) = 1
        next
        ` the very bottom row is horror coral, and the coral over it is not, so the one goes into the
        ` other. it climbs a row higher by the tentacle, at the right.
        CORAL_SICK(crC + 8 * 13) = 1
        if crC >= 11 then CORAL_SICK(crC + 7 * 13) = 1
    next
    coralRecount()
    order sprite CORAL_VIEW_SPRITE, CAPD_ORDER_REEF
    ` the ink, on the game's own board. squidStep wipes the ink when the board has changed size, so it is
    ` told that it has not. the board's own ink sprite is not seen: the cards show it, on the tilt.
    INK_BOARD_COLS = CELL_COLUMN_COUNT
    for crR = 0 to 6
        for crC = 0 to 8
            if capDraftInked(crR, crC) then inkCell(crC + 2 + (crR + 1) * 13)
        next
    next
endfunction

` the diver far off: small, and hazed blue
function capDraftDiver(cdvX#, cdvY#, cdvSize#, cdvLeft)
    cdvS = 0
    reserve sprite id(cdvS)
    sprite cdvS, cdvX#, cdvY#, TEX_DIVER_SHEET
    set sprite offset cdvS, .5, .5
    size sprite cdvS, cdvSize#, cdvSize#
    order sprite cdvS, ORDER_FISH - 2
    set sprite flip cdvS, cdvLeft, 0
    color sprite cdvS, rgb(150, 185, 230, 150)
    set sprite frame cdvS, 3
endfunction cdvS

` Ava, the angler, far off and deep: small and hazed, with only the light that hangs in front of her bright
function capDraftAva(caX#, caY#, caScale#, caLeft)
    caW# = ANGLER_ART_W * caScale#
    caH# = ANGLER_ART_H * caScale#
    caS = 0
    reserve sprite id(caS)
    sprite caS, caX#, caY#, TEX_ANGLER
    set sprite offset caS, .5, .5
    size sprite caS, caW#, caH#
    order sprite caS, ORDER_FISH - 3
    set sprite flip caS, caLeft, 0
    color sprite caS, rgb(80, 105, 150, 150)
    ` her light: where it hangs from, in the picture, and a little under that
    caTipX# = (ANGLER_TIP_X * caScale#) - caW# / 2
    if caLeft then caTipX# = 0 - caTipX#
    caTipY# = (ANGLER_TIP_Y * caScale#) - caH# / 2
    caG = 0
    reserve sprite id(caG)
    sprite caG, caX# + caTipX#, caY# + caTipY# + ANGLER_GLOW_DROP * caScale# * .5, TEX_ANGLER_GLOW
    set sprite offset caG, .5, .5
    size sprite caG, 30 * caScale#, 30 * caScale#
    order sprite caG, ORDER_FISH - 2
    color sprite caG, rgb(ANGLER_GLOW_R, ANGLER_GLOW_G, ANGLER_GLOW_B, 230)
endfunction caS

` what has to be done on every frame of a draft: the board's own fish kept away, the tentacle only just
` up, the coral bent a little and in front, bubbles coming up off of the reef now and then, and the
` pieces put where they are, with what the rings do to them
function capDraftFrame(cfF)
    hintShow(0)
    trailerHideBut(-1, -1, -1, -1)
    set sprite alpha SELECTION_SPRITE, 0
    set sprite all texcoord1 SELECTION_SPRITE, 0, 0, 0, 0
    if cfF mod 9 = 0
        spawnBubblesOnLayer(20 + rnd(530), 300, 14, 2, 0, rgb(190, 220, 255), CAPD_ORDER_BUBBLES, 0, 170, 1)
    endif
    show sprite TENTACLE_SPRITE
    set effect param float TENTACLE_FX_ID, "Time", game ms() * .001
    set effect param float2 TENTACLE_FX_ID, "Size", WORLD_WIDTH, WORLD_HEIGHT
    set effect param float TENTACLE_FX_ID, "Rise", .26
    order sprite TENTACLE_SPRITE, CAPD_ORDER_REEF + 1
    set effect param float TENTACLE_FX_ID, "Lone", 1
    set effect param float CORAL_FX_ID, "Warp", .08
    order sprite CORAL_VIEW_SPRITE, CAPD_ORDER_REEF
    if INK_BOARD_SPRITE > 0
        set sprite alpha INK_BOARD_SPRITE, 0
    endif
    capDraftPoseAll()
endfunction

` hold the scene until the sea settles, and take it
function capDraftTake(ckName$)
    ckOut$ = env$("FISH_CAPSULE_OUT")
    if ckOut$ = "" then ckOut$ = "capsules"
    for ckF = 0 to 150
        capDraftFrame(ckF)
        if ckF = 95
            capDraftBurst(0)
        endif
        runto update_frame
    next
    screenshot ckOut$ + "/raw/" + ckName$
    print "[capsule] take " + ckName$

endfunction

` and the same scene again with no title, and no splash, for the art that must not have words on it (the
` library hero, the page background). it waits for the bubbles of the burst to go, which are over the words.
function capDraftTakeClear(ckcName$)
    ckcOut$ = env$("FISH_CAPSULE_OUT")
    if ckcOut$ = "" then ckcOut$ = "capsules"
    for ckcI = 0 to CAPD_TXT_N - 1
        hide text CAPD_TXT(ckcI)
    next
    for ckcI = 0 to CAPD_PUFF_N - 1
        hide sprite CAPD_PUFF(ckcI)
    next
    for ckcF = 0 to 150
        capDraftFrame(ckcF)
        runto update_frame
    next
    screenshot ckcOut$ + "/raw/" + ckcName$ + "_clear"
    print "[capsule] take " + ckcName$ + "_clear"
endfunction

function capDraftSea(csA, csB, csC, csD, csSmokeA, csSmokeB)
    capDraftSmokes(csSmokeA, csSmokeB)
    trailerNoUi()
    trailerFishAway()
    hide sprite SCORE_TEXT_VIEW_SPRITE
    FLOCK_PULL_GRID = 0
    trailerSchool(csA, 8, 40, 30, 1)
    trailerSchool(csB, 7, 470, 200, -1)
    trailerSchool(csC, 6, 250, 20, 1)
    trailerSchool(csD, 5, 520, 90, -1)
    capDraftReef()
endfunction
endtest

