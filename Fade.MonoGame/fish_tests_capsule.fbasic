    size sprite tCdwBack, WORLD_WIDTH, WORLD_HEIGHT
    order sprite tCdwBack, 150
    capDraftTitle(285, 175, 1.1, -.08)
    for tCdwW = 0 to 2
        for tCdwO = 0 to 2
            tCdwA = 0
            if tCdwO = tCdwW then tCdwA = 255
            capDraftWordPose(tCdwO, 1, 0, tCdwA)
