goto routines_input_exit


` bind the keys of the keyboard, and the buttons of a controller, to the things the player can do.
` the rest of the game only asks about the actions, so it works the same on both.
setup_input:

    ` directions come from the arrow keys, wasd, the d-pad, or the left stick. both sets of keys
    ` always work. see THE TWO HANDS OF THE KEYBOARD in fish_headers.
    reserve action id(ACT_LEFT)
    bind action key ACT_LEFT, scancode("Left")
    bind action key ACT_LEFT, scancode("A")
    bind action button ACT_LEFT, padCode("DPadLeft")
    bind action button ACT_LEFT, padCode("LeftThumbstickLeft")

    reserve action id(ACT_RIGHT)
    bind action key ACT_RIGHT, scancode("Right")
    bind action key ACT_RIGHT, scancode("D")
    bind action button ACT_RIGHT, padCode("DPadRight")
    bind action button ACT_RIGHT, padCode("LeftThumbstickRight")

    reserve action id(ACT_UP)
    bind action key ACT_UP, scancode("Up")
    bind action key ACT_UP, scancode("W")
    bind action button ACT_UP, padCode("DPadUp")
    bind action button ACT_UP, padCode("LeftThumbstickUp")

    reserve action id(ACT_DOWN)
    bind action key ACT_DOWN, scancode("Down")
    bind action key ACT_DOWN, scancode("S")
    bind action button ACT_DOWN, padCode("DPadDown")
    bind action button ACT_DOWN, padCode("LeftThumbstickDown")

    ` the swap is the main thing the player does, so it gets the main button
    reserve action id(ACT_SWAP)
    bind action key ACT_SWAP, scancode("Space")
    bind action button ACT_SWAP, padCode("A")

    reserve action id(ACT_CONFIRM)
    bind action key ACT_CONFIRM, scancode("Space")
    bind action key ACT_CONFIRM, scancode("Enter")
    bind action button ACT_CONFIRM, padCode("A")

    ` tab is the key that the game shows. while the debug inspector is enabled (see FISH_DEBUG, in
    ` fish.fbasic), imgui takes the keyboard when tab is pressed, and then the game does not see any
    ` keys at all. so f1 works too, for then. (it used to be i, but i is a move key now.)
    reserve action id(ACT_INFO)
    bind action key ACT_INFO, scancode("Tab")
    bind action key ACT_INFO, scancode("F1")
    bind action button ACT_INFO, padCode("Back")

    ` escape pauses, and backs out of menus. (p used to as well, but p is a move key now.)
    reserve action id(ACT_PAUSE)
    bind action key ACT_PAUSE, scancode("Escape")
    bind action button ACT_PAUSE, padCode("Start")

    ` the move abilities, in the order that they get handed out. each one has a key for the left
    ` hand, beside the arrow keys' hand, and a key for the right hand, beside wasd.
    dim abilityKeys$(MOVE_SLOT_COUNT)
    dim abilityRightKeys$(MOVE_SLOT_COUNT)
    dim abilityButtons$(MOVE_SLOT_COUNT)
    abilityKeys$(0) = "Z"
    abilityKeys$(1) = "X"
    abilityKeys$(2) = "C"
    abilityKeys$(3) = "V"
    abilityKeys$(4) = "B"
    abilityRightKeys$(0) = "Y"
    abilityRightKeys$(1) = "U"
    abilityRightKeys$(2) = "I"
    abilityRightKeys$(3) = "O"
    abilityRightKeys$(4) = "P"
    abilityButtons$(0) = "B"
    abilityButtons$(1) = "X"
    abilityButtons$(2) = "Y"
    abilityButtons$(3) = "LeftShoulder"
    abilityButtons$(4) = "RightShoulder"
    for i = 0 to MOVE_SLOT_COUNT - 1
        reserve action id(abilityActionId)
        bind action key abilityActionId, scancode(abilityKeys$(i))
        bind action key abilityActionId, scancode(abilityRightKeys$(i))
        bind action button abilityActionId, padCode(abilityButtons$(i))
        ACT_ABILITY(i) = abilityActionId
    next

    ` somewhere for steam's pictures of the buttons to go. see STEAM'S PICTURES OF THE BUTTONS in fish_headers.
    for i = 0 to STEAM_GLYPH_COUNT - 1
        reserve texture id(steamGlyphTex)
        TEX_STEAM_GLYPH(i) = steamGlyphTex
    next

return


` the input icons are named after the things the player can do, like {swap}, and not after keys.
` so the text that uses them never changes. this points the names at the pictures for whichever
` device the player touched last, the keyboard or a controller.
frame_input_icons:
    ` a controller may be swapped for one of another kind, and then its pictures change too.
    ` see STEAM'S PICTURES OF THE BUTTONS in fish_headers.
    iconDevice = input device()

    ` the debug panel can ask for the icons of another device. see DEBUG_ICON_FORCE in fish_headers.
    if DEBUG_ICON_FORCE = 0 then iconDevice = 0
    if DEBUG_ICON_FORCE > 0 then iconDevice = 1

    iconPadKind = 0
    if iconDevice = 1 then iconPadKind = steam input type()

    ` which hand the moves are under, for the keys that were pressed last.
    ` see THE TWO HANDS OF THE KEYBOARD in fish_headers.
    if iconDevice = 0
        if new key down(scancode("W")) then INPUT_KEY_HANDS_NEXT = 1
        if new key down(scancode("A")) then INPUT_KEY_HANDS_NEXT = 1
        if new key down(scancode("S")) then INPUT_KEY_HANDS_NEXT = 1
        if new key down(scancode("D")) then INPUT_KEY_HANDS_NEXT = 1
        if new key down(scancode("Left")) then INPUT_KEY_HANDS_NEXT = 0
        if new key down(scancode("Right")) then INPUT_KEY_HANDS_NEXT = 0
        if new key down(scancode("Up")) then INPUT_KEY_HANDS_NEXT = 0
        if new key down(scancode("Down")) then INPUT_KEY_HANDS_NEXT = 0
    endif

    if iconDevice = INPUT_ICON_DEVICE
        if iconPadKind = INPUT_ICON_PAD_KIND
            if iconDevice = 1 then return
            if INPUT_KEY_HANDS_NEXT = INPUT_KEY_HANDS then return
        endif
    endif
    INPUT_ICON_DEVICE = iconDevice
    INPUT_ICON_PAD_KIND = iconPadKind
    INPUT_KEY_HANDS = INPUT_KEY_HANDS_NEXT

    ` the last number is the frame of the picture in its sheet. the sheets are grids, and the
    ` frames count across each row, starting from the top left.
    if INPUT_ICON_DEVICE = 1
        font icon SCORE_FONT, 1, "move1", TEX_PAD, 84 `b
        font icon SCORE_FONT, 2, "move2", TEX_PAD, 86 `x
        font icon SCORE_FONT, 3, "move3", TEX_PAD, 88 `y
        font icon SCORE_FONT, 4, "move4", TEX_PAD, 37 `the left bumper
        font icon SCORE_FONT, 13, "move5", TEX_PAD, 23 `the right bumper
        font icon SCORE_FONT, 5, "info", TEX_PAD, 78 `the button with two squares, where back used to be
        font icon SCORE_FONT, 6, "swap", TEX_PAD, 82 `a
        font icon SCORE_FONT, 7, "dir", TEX_PAD, 64 `the d-pad
        font icon SCORE_FONT, 11, "pause", TEX_PAD, 70 `the button with three lines, where start used to be
        font icon SCORE_FONT, 12, "confirm", TEX_PAD, 82 `a

        ` the sheet is of an xbox controller, so it is the one to show for an xbox controller (2 and 3,
        ` as steam numbers them), and for a controller of no known make (4), which is read as one. for
        ` any other kind, steam's picture of each button takes the place of the one from the sheet,
        ` when steam has it.
        iconFromSteam = 0
        if iconPadKind > 0 then iconFromSteam = 1
        if iconPadKind >= 2
            if iconPadKind <= 4 then iconFromSteam = 0
        endif
        if iconFromSteam
            steamIcon(1, "move1", 0, "B")
            steamIcon(2, "move2", 1, "X")
            steamIcon(3, "move3", 2, "Y")
            steamIcon(4, "move4", 3, "LeftShoulder")
            steamIcon(13, "move5", 4, "RightShoulder")
            steamIcon(5, "info", 5, "Back")
            steamIcon(6, "swap", 6, "A")
            steamIcon(7, "dir", 7, "DPad")
            steamIcon(11, "pause", 8, "Start")
            steamIcon(12, "confirm", 6, "A")
        endif
    else
        if INPUT_KEY_HANDS = 1
            font icon SCORE_FONT, 1, "move1", TEX_KEYS, 42 `y
            font icon SCORE_FONT, 2, "move2", TEX_KEYS, 64 `u
            font icon SCORE_FONT, 3, "move3", TEX_KEYS, 119 `i
            font icon SCORE_FONT, 4, "move4", TEX_KEYS, 107 `o
            font icon SCORE_FONT, 13, "move5", TEX_KEYS, 112 `p
        else
            font icon SCORE_FONT, 1, "move1", TEX_KEYS, 44 `z
            font icon SCORE_FONT, 2, "move2", TEX_KEYS, 40 `x
            font icon SCORE_FONT, 3, "move3", TEX_KEYS, 189 `c
            font icon SCORE_FONT, 4, "move4", TEX_KEYS, 34 `v
            font icon SCORE_FONT, 13, "move5", TEX_KEYS, 207 `b
        endif
        ` the four keys in the shape of the arrows. it has no letters on it, so it stands for wasd too.
        font icon SCORE_FONT, 5, "info", TEX_KEY_TAB `tab. it is a picture of its own, wider than the keys on the sheet.
        font icon SCORE_FONT, 6, "swap", TEX_KEYS, 51 `space
        font icon SCORE_FONT, 7, "dir", TEX_KEYS, 224 `the arrow keys
        font icon SCORE_FONT, 11, "pause", TEX_KEY_ESC `escape. a picture of its own, like tab.
        font icon SCORE_FONT, 12, "confirm", TEX_KEYS, 51 `space
    endif
return


process_input:
    ` no moves while the fish are still falling in at the start of a game. see THE ENTRANCE in fish_headers_entrance.
    if ENTRANCE_ON then return

    collectInput()

    ` a swap, or the cursor moving, does not stop the game while it plays out. it gets moved along a
    ` little on every frame, and the next move in the queue waits for it. see LIVE MOVES in fish_headers.
    if LIVE_MOVE_ACTIVE
        liveResult = stepLiveMove()
        return
    endif

    ` the walk of a box is over when the button of the move is let go. see ROTATE in fish_headers_fast.
    if ROTATE_ON
        rotateOver = rotateWalkOver()
        if rotateOver
            gosub rotate_finish
            return
        endif
    endif

    if QUEUED_MOVE_NUM <= 0
        return
    endif


    move = QUEUED_MOVES(QUEUED_MOVE_TAIL)
    QUEUED_MOVE_TAIL += 1

    if QUEUED_MOVE_TAIL = QUEUED_MOVE_NUM
        QUEUED_MOVE_TAIL = 0
        QUEUED_MOVE_NUM = 0
    endif


    swapDir = move.dir
    isSwap = move.swap

    if swapDir.x <> 0 or swapDir.y <> 0

        ` the pickup of a quest is beside the board, and the cursor can step out onto it, and back.
        ` see THE CURSOR STEPS OFF OF THE BOARD in fish_headers_quests.
        questStepped = questCursorBumped(swapDir.x, swapDir.y, isSwap)
        if questStepped then return

        target as vec = addCoordinates(SELECTION_POS, swapDir)

        if target.x < 0 then return
        if target.x >= CELL_COLUMN_COUNT then return
        if target.y < 0 then return
        if target.y >= CELL_ROW_COUNT then return


        usedAbility = 0
        if move.moveBindingIndex >= 0
            moveAbility = MOVE_ABILITY_BINDINGS(move.moveBindingIndex)

            ` the "free move" is a swap, so it plays out over the next few frames, the way that a swap does
            if moveAbility.moveValue = [MOVE_FREE]
                if moveAbility.movesLeft <= 0
                    liveStarted = startFreeMove(move.moveBindingIndex, swapDir.x, swapDir.y)
                    return
                endif
            endif

            ` "easy song" opens a song where the cursor is, and the cursor takes the first step of it.
            ` it is a step like any other, so it plays out the same way. see THE OPENING SWAP in fish_headers.
            if moveAbility.moveValue = [MOVE_SONG]
                if moveAbility.movesLeft <= 0
                    MOVE_ABILITY_BINDINGS(move.moveBindingIndex).movesLeft = moveAbility.resetTimer
                    gosub update_ability_texts
                    create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
                    coralOpenSong()
                    liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                    return
                endif
            endif

            ` "flipper" and "high stakes" are swaps like any other, with something more after them. see THREE
            ` MORE CARDS in fish_headers_school.
            schoolSwapMove = 0
            if moveAbility.moveValue = [MOVE_FLIPPER] then schoolSwapMove = 1
            if moveAbility.moveValue = [MOVE_HIGH_STAKES] then schoolSwapMove = 1
            if schoolSwapMove
                if moveAbility.movesLeft <= 0
                    liveStarted = startLiveMove(swapDir.x, swapDir.y, 1)
                    if liveStarted
                        MOVE_ABILITY_BINDINGS(move.moveBindingIndex).movesLeft = moveAbility.resetTimer
                        gosub update_ability_texts
                        create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
                        if moveAbility.moveValue = [MOVE_FLIPPER]
                            schoolFlipped()
                        else
                            schoolStakes(2)
                        endif
                    endif
                    return
                endif
            endif

            ` the "waste bucket" has nothing to do when no fish are belly up. it is not used, and its
            ` row shakes to say so. the cursor still moves, the same as for a move that is not ready.
            if moveAbility.moveValue = [MOVE_WASTE_BUCKET]
                if countBellyUpFish() = 0
                    create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
                    liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                    return
                endif
            endif

            ` "line out" pops the kind of fish under the cursor, and the diver is not a kind that pops. on
            ` the diver, the move is not used, and its row shakes to say so. see LINE OUT in fish_headers.
            if moveAbility.moveValue = [MOVE_LINE_OUT]
                if moveAbility.movesLeft <= 0
                    if CELLS(getCellIndex(SELECTION_POS)).value = TEX_DIVER
                        create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
                        liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                        return
                    endif
                endif
            endif

            ` "known fill" does not work on a bottle. when either fish of the swap is one, the move is
            ` not used, and its row shakes to say so. the cursor still moves, the same as above.
            if moveAbility.moveValue = [MOVE_KNOWN_FILL]
                if moveAbility.movesLeft <= 0
                    fillBottle = 0
                    if CELLS(getCellIndex(SELECTION_POS)).value = TEX_BOTTLE then fillBottle = 1
                    if CELLS(getCellIndex(target)).value = TEX_BOTTLE then fillBottle = 1
                    if fillBottle
                        create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
                        liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                        return
                    endif
                endif
            endif

            ` "rotate" is walked: every step with its button held is a step of the walk, and the cursor
            ` takes it like any other. a second turn is the end of the walk, and so is letting go of the
            ` button, which is seen at the top of this routine. see ROTATE in fish_headers_fast.
            if moveAbility.moveValue = [MOVE_ROTATE]
                if moveAbility.movesLeft <= 0
                    rotateStep = rotateWants(swapDir.x, swapDir.y)
                    if rotateStep = 2
                        gosub rotate_finish
                        return
                    endif
                    liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                    if liveStarted
                        rotateTook(move.moveBindingIndex, swapDir.x, swapDir.y)
                    endif
                    return
                endif
            endif

            if moveAbility.movesLeft <= 0
                usedAbility = 1
                schoolStakes(1)
                MOVE_ABILITY_BINDINGS(move.moveBindingIndex).movesLeft = moveAbility.resetTimer
                gosub update_ability_texts

                select moveAbility.moveValue
                    case [MOVE_SHIFT]
                        doShift(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_CLONE]
                        doClone(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_BOMB3x3]
                        doBomb(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_LINE_OUT]
                        doLineOut(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_KNOWN_FILL]
                        doKnownFill(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_WASTE_BUCKET]
                        doWasteBucket(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_BUNCH_UP]
                        doBunchUp(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_ROBOT]
                        doRobot(SELECTION_POS, swapDir)

                        ` it took the cursor all the way to the edge of the board, the way that it was pointed.
                        ` with the "seamless" card, that is all the way around, and back to where it was.
                        robotWent = robotStrides(SELECTION_POS, swapDir)
                        target.x = robotLineX(SELECTION_POS.x, swapDir.x, robotWent)
                        target.y = robotLineY(SELECTION_POS.y, swapDir.y, robotWent)
                    endcase
                endselect

                ` shake the row of the move that just got used. this starts after the move has played out,
                ` because the moves animate without drawing the rest of the frame, so it would not be seen before.
                create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
            else
                ` the move is not ready yet, so shake its cooldown number, and the clock above the numbers
                create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).shakeTweenId, 1, 0, 500, 0
                create basic tween COOLDOWN_CLOCK_SHAKE_TWEEN_ID, 1, 0, 500, 0

                ` the cursor still moves. it plays out over the next few frames, and what comes after
                ` a move happens when it gets there, in stepLiveMove.
                liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                return
            endif
        else
            ` a swap, or the cursor moving on its own. the same goes for these.
            liveStarted = startLiveMove(swapDir.x, swapDir.y, isSwap)
            if liveStarted
                if (isSwap)
                    gosub update_ability_texts
                endif
            endif
            return
        endif

        ` only a special move gets to here. it stopped the game until it had played out.

        ` a special move is not a step of a hidden pattern, so the steps so far are forgotten. see CORAL in fish_headers.
        coralTrailClear()

        REQUEST_COMBO_CHECK = 1

        SELECTION_POS = target

        ` the quest of the round hears where the special move left the cursor
        questCursorStepped(-1, getCellIndex(target))

        ` with the "bottoms up" card, a fish that is belly up pops when the cursor comes to it. and a move
        ` may turn another fish over, once the board has settled.
        popBellyUpFish(getCellIndex(target))
        if usedAbility or isSwap
            BELLY_UP_ROLL_DUE = 1
        endif

        ` a swap or a special move sends out a shockwave from where it started, headed the way that it went.
        ` a special move sends a big one, and the cursor moving on its own does not send one at all. this comes
        ` after the move has played out, because the moves animate without drawing the rest of the frame.
        shockFromX = target.x - swapDir.x
        shockFromY = target.y - swapDir.y
        if usedAbility
            spawnShockwaveToward(shockFromX, shockFromY, swapDir.x, swapDir.y, SHOCK_ABILITY_STRENGTH#, 0, SHOCK_LIFE)
        else
            if isSwap
                spawnShockwaveToward(shockFromX, shockFromY, swapDir.x, swapDir.y, SHOCK_SWAP_STRENGTH#, 0, SHOCK_LIFE)
            endif
        endif

        gosub update_selection_position
    endif


return


` forget the moves that are waiting in the queue
clear_queued_moves:
    QUEUED_MOVE_NUM = 0
    QUEUED_MOVE_TAIL = 0
return


` the same as process_input, for while a combo is playing out. the combo calls this on every frame
` that it waits, so that the player does not have to wait along with it.
` a special move stays in the queue until the board has settled, because it stops the game while it plays.
` and nothing new starts while LIVE_MOVE_HOLD is set, which is when a part of the combo is done and is
` only waiting for the move that is playing to finish.
` the names in here all start with "live", because this runs in the middle of handle_combos, and it
` must not touch anything that handle_combos is in the middle of using.
frame_combo_input:
    collectInput()

    if LIVE_MOVE_ACTIVE
        liveResult = stepLiveMove()
        return
    endif

    if LIVE_MOVE_HOLD then return
    if QUEUED_MOVE_NUM <= 0 then return

    ` and moves wait while a big moment is being shown. see THE BIG MOMENTS in fish_headers_teach.
    liveTeachWait = teachHolding()
    if liveTeachWait then return

    liveMove = QUEUED_MOVES(QUEUED_MOVE_TAIL)
    liveSwap = liveMove.swap
    liveDirX = liveMove.dir.x
    liveDirY = liveMove.dir.y

    if liveMove.moveBindingIndex >= 0
        if MOVE_ABILITY_BINDINGS(liveMove.moveBindingIndex).movesLeft <= 0
            ` a special move that is ready waits for the board to settle
            if MOVE_ABILITY_BINDINGS(liveMove.moveBindingIndex).moveValue <> [MOVE_FREE] then return

            ` all but the "free move", which is a swap, and does not stop the game
            QUEUED_MOVE_TAIL += 1
            if QUEUED_MOVE_TAIL = QUEUED_MOVE_NUM
                QUEUED_MOVE_TAIL = 0
                QUEUED_MOVE_NUM = 0
            endif
            liveStarted = startFreeMove(liveMove.moveBindingIndex, liveDirX, liveDirY)
            return
        endif

        ` one that is not ready only moves the cursor, and shakes its cooldown number, and the clock above the numbers
        create basic tween MOVE_ABILITY_BINDINGS(liveMove.moveBindingIndex).shakeTweenId, 1, 0, 500, 0
        create basic tween COOLDOWN_CLOCK_SHAKE_TWEEN_ID, 1, 0, 500, 0
        liveSwap = 0
    endif

    ` take it off of the queue
    QUEUED_MOVE_TAIL += 1
    if QUEUED_MOVE_TAIL = QUEUED_MOVE_NUM
        QUEUED_MOVE_TAIL = 0
        QUEUED_MOVE_NUM = 0
    endif

    if liveDirX <> 0 or liveDirY <> 0
        liveStarted = startLiveMove(liveDirX, liveDirY, liveSwap)
        if liveStarted
            if liveSwap
                gosub update_ability_texts
            endif
        endif
    endif
return


end
routines_input_exit:


` point an input icon at steam's picture of a button, when steam has one. the icon is left as it was
` when it does not. see STEAM'S PICTURES OF THE BUTTONS in fish_headers.
function steamIcon(steamIconId, steamIconAlias$, steamIconSlot, steamIconButton$)
    ` 20 pixels with 2 clear on every side, the same as a button on the sheet, so that it is drawn
    ` pixel for pixel, and is the same size as the buttons that it stands in for
    steamIconGot = steam input glyph(TEX_STEAM_GLYPH(steamIconSlot), steamIconButton$, 20, 2, 0)
    if steamIconGot
        font icon SCORE_FONT, steamIconId, steamIconAlias$, TEX_STEAM_GLYPH(steamIconSlot)
    endif
endfunction

