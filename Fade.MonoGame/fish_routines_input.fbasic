goto routines_input_exit


` bind the keys of the keyboard, and the buttons of a controller, to the things the player can do.
` the rest of the game only asks about the actions, so it works the same on both.
setup_input:

    ` directions come from the arrow keys, the d-pad, or the left stick
    reserve action id(ACT_LEFT)
    bind action key ACT_LEFT, scancode("Left")
    bind action button ACT_LEFT, padCode("DPadLeft")
    bind action button ACT_LEFT, padCode("LeftThumbstickLeft")

    reserve action id(ACT_RIGHT)
    bind action key ACT_RIGHT, scancode("Right")
    bind action button ACT_RIGHT, padCode("DPadRight")
    bind action button ACT_RIGHT, padCode("LeftThumbstickRight")

    reserve action id(ACT_UP)
    bind action key ACT_UP, scancode("Up")
    bind action button ACT_UP, padCode("DPadUp")
    bind action button ACT_UP, padCode("LeftThumbstickUp")

    reserve action id(ACT_DOWN)
    bind action key ACT_DOWN, scancode("Down")
    bind action button ACT_DOWN, padCode("DPadDown")
    bind action button ACT_DOWN, padCode("LeftThumbstickDown")

    ` the swap is the main thing the player does, so it gets the main button
    reserve action id(ACT_SWAP)
    bind action key ACT_SWAP, scancode("Space")
    bind action button ACT_SWAP, padCode("A")

    reserve action id(ACT_CONFIRM)
    bind action key ACT_CONFIRM, scancode("Space")
    bind action key ACT_CONFIRM, scancode("Enter")
    bind action button ACT_CONFIRM, padCode("A")

    ` tab is the key that the game shows. while the debug inspector is enabled (see FISH_DEBUG, in
    ` fish.fbasic), imgui takes the keyboard when tab is pressed, and then the game does not see any
    ` keys at all. so i still works too, for then.
    reserve action id(ACT_INFO)
    bind action key ACT_INFO, scancode("Tab")
    bind action key ACT_INFO, scancode("I")
    bind action button ACT_INFO, padCode("Back")

    ` escape pauses, and backs out of menus. p still works too.
    reserve action id(ACT_PAUSE)
    bind action key ACT_PAUSE, scancode("Escape")
    bind action key ACT_PAUSE, scancode("P")
    bind action button ACT_PAUSE, padCode("Start")

    ` the move abilities, in the order that they get handed out
    dim abilityKeys$(MOVE_SLOT_COUNT)
    dim abilityButtons$(MOVE_SLOT_COUNT)
    abilityKeys$(0) = "Z"
    abilityKeys$(1) = "X"
    abilityKeys$(2) = "C"
    abilityKeys$(3) = "V"
    abilityButtons$(0) = "X"
    abilityButtons$(1) = "Y"
    abilityButtons$(2) = "B"
    abilityButtons$(3) = "RightShoulder"
    for i = 0 to MOVE_SLOT_COUNT - 1
        reserve action id(abilityActionId)
        bind action key abilityActionId, scancode(abilityKeys$(i))
        bind action button abilityActionId, padCode(abilityButtons$(i))
        ACT_ABILITY(i) = abilityActionId
    next

    ` the last move is on the bumpers, and either one will do
    bind action button ACT_ABILITY(MOVE_SLOT_COUNT - 1), padCode("LeftShoulder")

return


` the input icons are named after the things the player can do, like {swap}, and not after keys.
` so the text that uses them never changes. this points the names at the pictures for whichever
` device the player touched last, the keyboard or a controller.
frame_input_icons:
    if input device() = INPUT_ICON_DEVICE then return
    INPUT_ICON_DEVICE = input device()

    ` the last number is the frame of the picture in its sheet. the sheets are grids, and the
    ` frames count across each row, starting from the top left.
    if INPUT_ICON_DEVICE = 1
        font icon SCORE_FONT, 1, "move1", TEX_PAD, 86 `x
        font icon SCORE_FONT, 2, "move2", TEX_PAD, 88 `y
        font icon SCORE_FONT, 3, "move3", TEX_PAD, 84 `b
        font icon SCORE_FONT, 4, "move4", TEX_PAD, 23 `the right bumper. the left one works too.
        font icon SCORE_FONT, 5, "info", TEX_PAD, 78 `the button with two squares, where back used to be
        font icon SCORE_FONT, 6, "swap", TEX_PAD, 82 `a
        font icon SCORE_FONT, 7, "dir", TEX_PAD, 64 `the d-pad
        font icon SCORE_FONT, 11, "pause", TEX_PAD, 70 `the button with three lines, where start used to be
        font icon SCORE_FONT, 12, "confirm", TEX_PAD, 82 `a
    else
        font icon SCORE_FONT, 1, "move1", TEX_KEYS, 44 `z
        font icon SCORE_FONT, 2, "move2", TEX_KEYS, 40 `x
        font icon SCORE_FONT, 3, "move3", TEX_KEYS, 189 `c
        font icon SCORE_FONT, 4, "move4", TEX_KEYS, 34 `v
        font icon SCORE_FONT, 5, "info", TEX_KEY_TAB `tab. it is a picture of its own, wider than the keys on the sheet.
        font icon SCORE_FONT, 6, "swap", TEX_KEYS, 51 `space
        font icon SCORE_FONT, 7, "dir", TEX_KEYS, 224 `the arrow keys
        font icon SCORE_FONT, 11, "pause", TEX_KEYS, 183 `escape
        font icon SCORE_FONT, 12, "confirm", TEX_KEYS, 51 `space
    endif
return


process_input:
    collectInput()

    ` a swap, or the cursor moving, does not stop the game while it plays out. it gets moved along a
    ` little on every frame, and the next move in the queue waits for it. see LIVE MOVES in fish_headers.
    if LIVE_MOVE_ACTIVE
        liveResult = stepLiveMove()
        return
    endif

    if QUEUED_MOVE_NUM <= 0
        return
    endif


    move = QUEUED_MOVES(QUEUED_MOVE_TAIL)
    QUEUED_MOVE_TAIL += 1

    if QUEUED_MOVE_TAIL = QUEUED_MOVE_NUM
        QUEUED_MOVE_TAIL = 0
        QUEUED_MOVE_NUM = 0
    endif


    swapDir = move.dir
    isSwap = move.swap

    if swapDir.x <> 0 or swapDir.y <> 0

        target as vec = addCoordinates(SELECTION_POS, swapDir)

        if target.x < 0 then return 
        if target.x >= CELL_COLUMN_COUNT then return 
        if target.y < 0 then return 
        if target.y >= CELL_ROW_COUNT then return 


        usedAbility = 0
        if move.moveBindingIndex >= 0
            moveAbility = MOVE_ABILITY_BINDINGS(move.moveBindingIndex)

            ` the "free move" is a swap, so it plays out over the next few frames, the way that a swap does
            if moveAbility.moveValue = [MOVE_FREE]
                if moveAbility.movesLeft <= 0
                    liveStarted = startFreeMove(move.moveBindingIndex, swapDir.x, swapDir.y)
                    return
                endif
            endif

            ` the "waste bucket" has nothing to do when no fish are belly up. it is not used, and its
            ` row shakes to say so. the cursor still moves, the same as for a move that is not ready.
            if moveAbility.moveValue = [MOVE_WASTE_BUCKET]
                if countBellyUpFish() = 0
                    create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
                    liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                    return
                endif
            endif

            if moveAbility.movesLeft <= 0
                usedAbility = 1
                print "FOUND MOVE", moveAbility.moveValue
                MOVE_ABILITY_BINDINGS(move.moveBindingIndex).movesLeft = moveAbility.resetTimer
                gosub update_ability_texts
                print "BACK FROM ROUTINE" + str$(moveAbility.movesLeft) + " / " + str$(moveAbility.resetTimer)

                print "wtf", [MOVE_SHIFT], [MOVE_CLONE], moveAbility.moveValue
                select moveAbility.moveValue
                    case [MOVE_SHIFT]
                        print "DOING SHIFT"
                        doShift(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_CLONE]
                        print "DOING CLONE"
                        doClone(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_BOMB3x3]
                        print "DOING BOMB"
                        doBomb(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_LINE_OUT]
                        print "DOING LINE OUT"
                        doLineOut(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_KNOWN_FILL]
                        doKnownFill(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_WASTE_BUCKET]
                        doWasteBucket(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_BUNCH_UP]
                        doBunchUp(SELECTION_POS, swapDir)
                    endcase
                    case [MOVE_ROBOT]
                        doRobot(SELECTION_POS, swapDir)

                        ` it found nothing to swap, so it is not used up. its cooldown number shakes to say so.
                        if ROBOT_LAST_COUNT = 0
                            MOVE_ABILITY_BINDINGS(move.moveBindingIndex).movesLeft = 0
                            create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).shakeTweenId, 1, 0, 500, 0
                        endif
                    endcase
                    case default 
                        print "DOING NOTHING"

                        `doSwap(SELECTION_POS, swapDir, 0)
                    endcase 
                endselect

                ` shake the row of the move that just got used. this starts after the move has played out,
                ` because the moves animate without drawing the rest of the frame, so it would not be seen before.
                create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).useShakeTweenId, 1, 0, 500, 0
            else
                ` the move is not ready yet, so shake its cooldown number, and the clock above the numbers
                create basic tween MOVE_ABILITY_BINDINGS(move.moveBindingIndex).shakeTweenId, 1, 0, 500, 0
                create basic tween COOLDOWN_CLOCK_SHAKE_TWEEN_ID, 1, 0, 500, 0

                ` the cursor still moves. it plays out over the next few frames, and what comes after
                ` a move happens when it gets there, in stepLiveMove.
                liveStarted = startLiveMove(swapDir.x, swapDir.y, 0)
                return
            endif
        else
            ` a swap, or the cursor moving on its own. the same goes for these.
            liveStarted = startLiveMove(swapDir.x, swapDir.y, isSwap)
            if liveStarted
                if (isSwap)
                    gosub update_ability_texts
                endif
            endif
            return
        endif

        ` only a special move gets to here. it stopped the game until it had played out.

        REQUEST_COMBO_CHECK = 1

        SELECTION_POS = target

        ` with the "bottoms up" card, a fish that is belly up pops when the cursor comes to it. and a move
        ` may turn another fish over, once the board has settled.
        popBellyUpFish(getCellIndex(target))
        if usedAbility or isSwap
            BELLY_UP_ROLL_DUE = 1
        endif

        ` a swap or a special move sends out a shockwave from where it started, headed the way that it went.
        ` a special move sends a big one, and the cursor moving on its own does not send one at all. this comes
        ` after the move has played out, because the moves animate without drawing the rest of the frame.
        shockFromX = target.x - swapDir.x
        shockFromY = target.y - swapDir.y
        if usedAbility
            spawnShockwaveToward(shockFromX, shockFromY, swapDir.x, swapDir.y, SHOCK_ABILITY_STRENGTH#, 0, SHOCK_LIFE)
        else
            if isSwap
                spawnShockwaveToward(shockFromX, shockFromY, swapDir.x, swapDir.y, SHOCK_SWAP_STRENGTH#, 0, SHOCK_LIFE)
            endif
        endif

        gosub update_selection_position
    endif


return


` forget the moves that are waiting in the queue
clear_queued_moves:
    QUEUED_MOVE_NUM = 0
    QUEUED_MOVE_TAIL = 0
return


` the same as process_input, for while a combo is playing out. the combo calls this on every frame
` that it waits, so that the player does not have to wait along with it.
` a special move stays in the queue until the board has settled, because it stops the game while it plays.
` and nothing new starts while LIVE_MOVE_HOLD is set, which is when a part of the combo is done and is
` only waiting for the move that is playing to finish.
` the names in here all start with "live", because this runs in the middle of handle_combos, and it
` must not touch anything that handle_combos is in the middle of using.
frame_combo_input:
    collectInput()

    if LIVE_MOVE_ACTIVE
        liveResult = stepLiveMove()
        return
    endif

    if LIVE_MOVE_HOLD then return
    if QUEUED_MOVE_NUM <= 0 then return

    liveMove = QUEUED_MOVES(QUEUED_MOVE_TAIL)
    liveSwap = liveMove.swap
    liveDirX = liveMove.dir.x
    liveDirY = liveMove.dir.y

    if liveMove.moveBindingIndex >= 0
        if MOVE_ABILITY_BINDINGS(liveMove.moveBindingIndex).movesLeft <= 0
            ` a special move that is ready waits for the board to settle
            if MOVE_ABILITY_BINDINGS(liveMove.moveBindingIndex).moveValue <> [MOVE_FREE] then return

            ` all but the "free move", which is a swap, and does not stop the game
            QUEUED_MOVE_TAIL += 1
            if QUEUED_MOVE_TAIL = QUEUED_MOVE_NUM
                QUEUED_MOVE_TAIL = 0
                QUEUED_MOVE_NUM = 0
            endif
            liveStarted = startFreeMove(liveMove.moveBindingIndex, liveDirX, liveDirY)
            return
        endif

        ` one that is not ready only moves the cursor, and shakes its cooldown number, and the clock above the numbers
        create basic tween MOVE_ABILITY_BINDINGS(liveMove.moveBindingIndex).shakeTweenId, 1, 0, 500, 0
        create basic tween COOLDOWN_CLOCK_SHAKE_TWEEN_ID, 1, 0, 500, 0
        liveSwap = 0
    endif

    ` take it off of the queue
    QUEUED_MOVE_TAIL += 1
    if QUEUED_MOVE_TAIL = QUEUED_MOVE_NUM
        QUEUED_MOVE_TAIL = 0
        QUEUED_MOVE_NUM = 0
    endif

    if liveDirX <> 0 or liveDirY <> 0
        liveStarted = startLiveMove(liveDirX, liveDirY, liveSwap)
        if liveStarted
            if liveSwap
                gosub update_ability_texts
            endif
        endif
    endif
return


end
routines_input_exit:

