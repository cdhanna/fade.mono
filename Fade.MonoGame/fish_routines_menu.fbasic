goto routines_menu_exit

remstart
    THE MENU
    the main menu is what the game opens on, and the pause menu comes up over the game when the pause key is pressed (P, or start on a controller).
    they are the same list of lines, except that the pause menu starts with "Resume".

    the menu is not drawn onto the screen. it is drawn to its own render target, and then one sprite
    draws that render target over the top of the game. that sprite is the "composite" sprite.

    the composite sprite looks at a second render target, the bubble mask, to decide which parts of the
    menu to draw. a wave of bubbles floats up through the mask, and leaves the mask filled in behind it.
    so as the wave goes up the screen, the menu is wiped in over the game, or wiped away from it.
    the same bubbles are drawn on the screen too, so that the edge of the wipe is hidden behind them.

    the pause menu does not use the bubbles. it just fades in, on a dark backdrop that the game shows through.
remend

setup_menu:
    ` the globals are declared in the fish headers, so that functions can use them no matter where they are called from

    ` load effects
    reserve effect id(MENU_FX_ID)
    effect MENU_FX_ID, "Fish/Shaders/MenuCompositeEffect"

    reserve effect id(BUBBLE_FX_ID)
    effect BUBBLE_FX_ID, "Fish/Shaders/BubbleEffect"

    ` the menu's render target is see-through wherever nothing is drawn, so that the pause menu can sit over the game
    reserve render target id(TARGET_MENU)
    render target TARGET_MENU
    set render target background color TARGET_MENU, rgb(0, 0, 0, 0)
    ` its alpha builds up the way coverage does, so that something see-through drawn over the solid back of
    ` the menu leaves it solid, and the game does not show through. see MenuCompositeEffect.fx.
    set render target blend TARGET_MENU, 6

    ` the bubble mask is black, and the bubbles paint it white
    reserve render target id(TARGET_MASK)
    render target TARGET_MASK
    set render target background color TARGET_MASK, rgb(0, 0, 0)

    ` the composite sprite draws the menu over the game
    reserve sprite id(MENU_COMPOSITE_SPRITE)
    sprite MENU_COMPOSITE_SPRITE, 0, 0, render target texture(TARGET_MENU)
    set sprite offset MENU_COMPOSITE_SPRITE, 0, 0
    size sprite MENU_COMPOSITE_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    order sprite MENU_COMPOSITE_SPRITE, ORDER_MENU
    set sprite effect MENU_COMPOSITE_SPRITE, MENU_FX_ID
    hide sprite MENU_COMPOSITE_SPRITE

    ` the screen is drawn before the menu's render target is, so the very first frame has no menu to show yet.
    ` the cover hides the game for that one frame.
    reserve sprite id(MENU_COVER_SPRITE)
    sprite MENU_COVER_SPRITE, 0, 0, TEX_PIXEL
    set sprite offset MENU_COVER_SPRITE, 0, 0
    size sprite MENU_COVER_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    color sprite MENU_COVER_SPRITE, rgb(32, 40, 64)
    order sprite MENU_COVER_SPRITE, ORDER_MENU - 2
    hide sprite MENU_COVER_SPRITE

    ` everything from here on is drawn into the menu's render target, instead of onto the screen.

    ` the main menu has a solid background, which hides the game.
    reserve sprite id(MENU_BG_SPRITE)
    sprite MENU_BG_SPRITE, 0, 0, TEX_PIXEL
    set sprite offset MENU_BG_SPRITE, 0, 0
    size sprite MENU_BG_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    color sprite MENU_BG_SPRITE, rgb(32, 40, 64)
    order sprite MENU_BG_SPRITE, ORDER_MENU_BACKDROP
    set sprite render target MENU_BG_SPRITE, TARGET_MENU

    ` the pause menu has a dark backdrop instead, which the game shows through.
    reserve sprite id(MENU_DIM_SPRITE)
    sprite MENU_DIM_SPRITE, 0, 0, TEX_PIXEL
    set sprite offset MENU_DIM_SPRITE, 0, 0
    size sprite MENU_DIM_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    color sprite MENU_DIM_SPRITE, rgb(0, 0, 0, 165)
    order sprite MENU_DIM_SPRITE, ORDER_MENU_BACKDROP
    set sprite render target MENU_DIM_SPRITE, TARGET_MENU
    hide sprite MENU_DIM_SPRITE

    ` the main menu is the view from the surface of the water, which is drawn over the solid background
    gosub setup_surface

    ` the list sits on a panel that looks like the one in info mode
    reserve sprite id(MENU_PANEL_SPRITE)
    sprite MENU_PANEL_SPRITE, 0, 0, TEX_PIXEL
    set sprite offset MENU_PANEL_SPRITE, 0, 0
    color sprite MENU_PANEL_SPRITE, rgb(10, 14, 30, 235)
    order sprite MENU_PANEL_SPRITE, ORDER_MENU_PANEL
    set sprite render target MENU_PANEL_SPRITE, TARGET_MENU

    MENU_PANEL_BORDER = createMenuBorder(ORDER_MENU_PANEL + 1)
    colorInfoBorder(MENU_PANEL_BORDER, rgb(64, 128, 255, 200))

    ` the cursor is the bright outline around the highlighted line. it slides from line to line.
    MENU_CURSOR = createMenuBorder(ORDER_MENU_CURSOR)
    reserve tween id(MENU_CURSOR_TWEEN_Y)
    create basic tween MENU_CURSOR_TWEEN_Y, 0, 0, 1, 0

    ` the fade tween goes from 0 (no menu) to 1 (menu). only the pause menu fades. the main menu uses the bubbles.
    reserve tween id(MENU_FADE_TWEEN_ID)
    create basic tween MENU_FADE_TWEEN_ID, 1, 1, 1, 0

    ` shakes a line that cannot be picked yet
    reserve tween id(MENU_SHAKE_TWEEN_ID)
    create basic tween MENU_SHAKE_TWEEN_ID, 0, 0, 1, 0

    reserve tween id(MENU_CURTAIN_TWEEN_ID)
    reserve tween id(TRANSITION_TWEEN_ID)

    ` the sound of the wave of bubbles. it is faded in and out by hand as the wave goes by.
    load sfx clip reserve sfx clip id(SFX_CLIP_BUBBLES), "Fish/Audio/bubble-wave"
    sfx reserve sfx id(SFX_BUBBLES), SFX_CLIP_BUBBLES
    set sfx volume SFX_BUBBLES, 0
    set sfx loop SFX_BUBBLES, 1
    waveSfxStarted = 0 `menu_transition plays it the first time, and resumes it after that
    SFX_BUBBLES_VOLUME# = .2 `how loud the wave gets at its loudest

    reserve text id(MENU_TITLE_TEXT_ID)
    text MENU_TITLE_TEXT_ID, WORLD_WIDTH / 2, MENU_TITLE_Y, SCORE_FONT, "Fish Fish Pop"
    set text offset MENU_TITLE_TEXT_ID, .5, .5
    color text MENU_TITLE_TEXT_ID, rgb(255, 255, 255)
    enable text drop shadow MENU_TITLE_TEXT_ID, 2, -2, rgb(64, 128, 255)
    order text MENU_TITLE_TEXT_ID, ORDER_MENU_TEXT
    set text render target MENU_TITLE_TEXT_ID, TARGET_MENU

    ` the lines of the menu. the ones that are not ready cannot be picked yet.
    MENU_ITEMS(MENU_ITEM_RESUME) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_NEW_GAME) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_HIGHSCORES) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_CODEC) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_OPTIONS) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_CREDITS) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_QUIT) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_CONFIRM_NO) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_CONFIRM_YES) = {
        ready = 1
    }

    ` the lines of the options page. refreshOptionLines writes the setting onto the end of each name.
    MENU_ITEMS(MENU_ITEM_SET_SOUND) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_MUSIC) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_FULLSCREEN) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_BACK) = {
        ready = 1
    }

    ` these two are only on the page once the main menu has them to show. see setMenuPage.
    MENU_ITEMS(MENU_ITEM_SET_REEF) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_MONSTER) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_PHOTOS) = {
        ready = 1
    }

    ` the lines of the page that "New Game" opens. refreshOptionLines writes the choice onto the end of the
    ` first three, and gives them a description of whatever is chosen.
    MENU_ITEMS(MENU_ITEM_GAME_LENGTH) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_GAME_MODE) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_GAME_INTRO) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_GAME_SEED) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_GAME_START) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_GAME_BACK) = {
        ready = 1
    }

    ` the lines on the page that comes up when the last round has been won. see KEEP PLAYING in fish_headers.
    MENU_ITEMS(MENU_ITEM_OVER_DONE) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_OVER_CONTINUE) = {
        ready = 1
    }

    ` the pause menu's way in to the page that moves the moves between the buttons
    MENU_ITEMS(MENU_ITEM_MOVES) = {
        ready = 1
    }

    MENU_ITEMS(MENU_ITEM_SET_LANGUAGE) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_MOTION) = {
        ready = 1
    }
    MENU_ITEMS(MENU_ITEM_SET_POP_SPEED) = {
        ready = 1
    }

    ` the strings of the game, in the language the player picked, or else in Steam's or the computer's.
    ` the names and descriptions of the lines come from them. see loadMenuStrings.
    load strings "Fish/Lang"
    OPTION_LANGUAGE = get pref(PREF_LANGUAGE, 0)
    applyLanguage()
    loadMenuStrings()

    ` the options are remembered from the last time the game was run. the first time it is ever run,
    ` there is nothing to remember, and they are what they would be anyway.
    OPTION_SOUND = get pref(PREF_SOUND, 10)
    OPTION_MUSIC = get pref(PREF_MUSIC, 10)

    ` a new player gets the screen the game started in: fullscreen in a build from github, a window in any other
    ` (FadeWindowMode in the csproj). a player who has picked gets what they picked, either way.
    menuStartedFullscreen = is fullscreen()
    OPTION_FULLSCREEN = get pref(PREF_FULLSCREEN, menuStartedFullscreen)
    if OPTION_FULLSCREEN <> 0 then OPTION_FULLSCREEN = 1

    ` started fullscreen, but the player wants a window. it is made the size a window starts at, and then the
    ` remembered size below takes over, like any other run.
    if menuStartedFullscreen = 1
        if OPTION_FULLSCREEN = 0
            set fullscreen 0
            set screen size SCREEN_WIDTH, SCREEN_HEIGHT
        endif
    endif

    ` the size of the window is not an option. the player drags the edges of the window to make it any size they like.
    ` and the window opens at the size they left it the last time the game was run.
    set window resizable 1
    menuWindowRemembered = remember window size(1)
    OPTION_WINDOW_W = screen width()
    OPTION_WINDOW_H = screen height()
    ` still fullscreen, so those are the monitor's size. leaving fullscreen goes to the size a window starts at.
    if is fullscreen() = 1
        OPTION_WINDOW_W = SCREEN_WIDTH
        OPTION_WINDOW_H = SCREEN_HEIGHT
    endif

    ` the file they are kept in can be changed by hand, so do not trust it to be sensible
    if OPTION_SOUND > 10 then OPTION_SOUND = 10
    if OPTION_SOUND < 0 then OPTION_SOUND = 0
    if OPTION_MUSIC > 10 then OPTION_MUSIC = 10
    if OPTION_MUSIC < 0 then OPTION_MUSIC = 0

    OPTION_WATER_MOTION = get pref(PREF_WATER_MOTION, WATER_MOTION_REGULAR)
    if OPTION_WATER_MOTION > WATER_MOTION_NONE then OPTION_WATER_MOTION = WATER_MOTION_REGULAR
    if OPTION_WATER_MOTION < 0 then OPTION_WATER_MOTION = WATER_MOTION_REGULAR
    applyWaterMotion()

    ` see THE BIG MOMENTS in fish_headers_teach
    OPTION_POP_SPEED = get pref(PREF_POP_SPEED, POP_SPEED_REGULAR)
    if OPTION_POP_SPEED <> POP_SPEED_FAST then OPTION_POP_SPEED = POP_SPEED_REGULAR

    ` what the main menu remembers is shown, until the player says otherwise
    OPTION_MENU_REEF = get pref(PREF_MENU_REEF, 1)
    OPTION_MENU_MONSTER = get pref(PREF_MENU_MONSTER, 1)
    if OPTION_MENU_REEF <> 0 then OPTION_MENU_REEF = 1
    if OPTION_MENU_MONSTER <> 0 then OPTION_MENU_MONSTER = 1
    OPTION_MENU_PHOTOS = get pref(PREF_MENU_PHOTOS, 1)
    if OPTION_MENU_PHOTOS <> 0 then OPTION_MENU_PHOTOS = 1

    ` the kind of game that was picked the last time is what "New Game" starts out on
    OPTION_GAME_LENGTH = get pref(PREF_GAME_LENGTH, GAME_LENGTH_REGULAR)
    OPTION_GAME_ZEN = get pref(PREF_GAME_ZEN, 0)
    if OPTION_GAME_LENGTH > GAME_LENGTH_LONG then OPTION_GAME_LENGTH = GAME_LENGTH_REGULAR
    if OPTION_GAME_LENGTH < 0 then OPTION_GAME_LENGTH = GAME_LENGTH_REGULAR
    if OPTION_GAME_ZEN <> 0 then OPTION_GAME_ZEN = 1

    set sfx group volume SFX_GROUP_SFX, OPTION_SOUND * .1
    applyMusicVolume()
    ` a window, but the player picked fullscreen. (started fullscreen and they want it: nothing to do.)
    if OPTION_FULLSCREEN = 1
        if is fullscreen() = 0
            set fullscreen 1
        endif
    endif

    for menuI = 0 to MENU_ITEM_COUNT - 1
        reserve text id(MENU_ITEMS(menuI).textId)
        menuTextId = MENU_ITEMS(menuI).textId

        text menuTextId, WORLD_WIDTH / 2, 0, SCORE_FONT, MENU_ITEMS(menuI).name$
        size text y menuTextId, 20
        set text offset menuTextId, .5, 0
        enable text drop shadow menuTextId, 2, -2, rgb(0,0,0)
        order text menuTextId, ORDER_MENU_TEXT
        set text render target menuTextId, TARGET_MENU

        reserve text id(MENU_ITEMS(menuI).valueTextId)
        menuTextId = MENU_ITEMS(menuI).valueTextId
        text menuTextId, WORLD_WIDTH / 2, 0, SCORE_FONT, "value"
        size text y menuTextId, 20
        set text offset menuTextId, 1, 0
        enable text drop shadow menuTextId, 2, -2, rgb(0,0,0)
        order text menuTextId, ORDER_MENU_TEXT
        set text render target menuTextId, TARGET_MENU
        hide text menuTextId
    next

    ` the description says what the highlighted line does
    reserve text id(MENU_DESC_TEXT_ID)
    text MENU_DESC_TEXT_ID, WORLD_WIDTH / 2, 0, SCORE_FONT, "desc"
    set text offset MENU_DESC_TEXT_ID, .5, 0
    size text y MENU_DESC_TEXT_ID, 16
    set text wrap MENU_DESC_TEXT_ID, 420
    set text align MENU_DESC_TEXT_ID, .5
    enable rich text MENU_DESC_TEXT_ID
    color text MENU_DESC_TEXT_ID, rgb(150, 190, 255)
    enable text drop shadow MENU_DESC_TEXT_ID, 2, -2, rgb(0,0,0)
    order text MENU_DESC_TEXT_ID, ORDER_MENU_TEXT
    set text render target MENU_DESC_TEXT_ID, TARGET_MENU

    ` the hint tells the player which keys do what, the same way that the hint in the game does.
    reserve text id(MENU_HINT_TEXT_ID)
    text MENU_HINT_TEXT_ID, WORLD_WIDTH / 2, WORLD_HEIGHT - 2, SCORE_FONT, loc$("menu.hint.main")
    enable rich text MENU_HINT_TEXT_ID
    set text offset MENU_HINT_TEXT_ID, .5, 1
    size text y MENU_HINT_TEXT_ID, 16
    color text MENU_HINT_TEXT_ID, rgb(64, 128, 255)
    enable text drop shadow MENU_HINT_TEXT_ID, 2, -2, rgb(0,0,0)
    order text MENU_HINT_TEXT_ID, ORDER_MENU_TEXT
    set text render target MENU_HINT_TEXT_ID, TARGET_MENU

    ` which build this is, in the bottom left corner of the main menu: the last 8 characters of the
    ` commit that it was built from, or "local" for one that was built on the machine it runs on.
    ` Program.cs puts it in the FISH_VERSION environment variable. frame_menu_render shows it.
    menuVersion$ = "local"
    if is env set("FISH_VERSION")
        menuVersion$ = env$("FISH_VERSION")
    endif
    reserve text id(MENU_VERSION_TEXT_ID)
    text MENU_VERSION_TEXT_ID, 4, WORLD_HEIGHT - 2, SCORE_FONT, menuVersion$
    set text offset MENU_VERSION_TEXT_ID, 0, 1
    ` 16 is the size that the font is drawn at, pixel for pixel. any other size smears it.
    size text y MENU_VERSION_TEXT_ID, 16
    color text MENU_VERSION_TEXT_ID, rgb(255, 255, 255)
    enable text drop shadow MENU_VERSION_TEXT_ID, 1, -1, rgb(0,0,0)
    set text alpha MENU_VERSION_TEXT_ID, 0
    order text MENU_VERSION_TEXT_ID, ORDER_MENU_TEXT
    set text render target MENU_VERSION_TEXT_ID, TARGET_MENU

    ` everything from here on is the wave of bubbles.

    ` every bubble is two sprites. one is seen on the screen, and the other is a solid circle in the mask.
    for menuI = 0 to BUBBLE_COUNT - 1
        bub = BUBBLES(menuI)
        reserve sprite id(bub.spriteId)
        reserve sprite id(bub.maskSpriteId)

        ` the tide is the part of the mask that the wave has already gone past. every bubble in the front of
        ` the wave drags a tall strip of it up underneath itself. the strips are wider than the gaps between
        ` the bubbles, so together they fill the mask all the way across, even when the front is not level.
        ` when there is no wave, they are left covering the whole mask, which means "show all of the menu".
        if menuI < BUBBLE_FRONT_COUNT
            reserve sprite id(bub.tideSpriteId)
            sprite bub.tideSpriteId, menuI * WORLD_WIDTH / (BUBBLE_FRONT_COUNT - 1), -10, TEX_PIXEL
            set sprite offset bub.tideSpriteId, .5, 0
            size sprite bub.tideSpriteId, 70, WORLD_HEIGHT * 4
            color sprite bub.tideSpriteId, rgb(255, 255, 255)
            set sprite render target bub.tideSpriteId, TARGET_MASK
        endif

        sprite bub.spriteId, 0, 0, TEX_PIXEL
        color sprite bub.spriteId, rgb(200, 230, 255)
        order sprite bub.spriteId, ORDER_MENU_BUBBLES
        set sprite effect bub.spriteId, BUBBLE_FX_ID
        hide sprite bub.spriteId

        sprite bub.maskSpriteId, 0, WORLD_HEIGHT * 2, TEX_PIXEL
        color sprite bub.maskSpriteId, rgb(255, 255, 255)
        set sprite effect bub.maskSpriteId, BUBBLE_FX_ID
        set sprite render target bub.maskSpriteId, TARGET_MASK

        BUBBLES(menuI) = bub
    next

    ` the credits and the splash screen are drawn with the menu, so they are set up with it
    gosub setup_credits

    ` and so are the high scores
    gosub setup_highscores
    gosub setup_codec

    ` the game opens on the splash screen, and then the main menu
    gosub menu_startup

return


` everything that happens on a frame while a menu is up
frame_menu:
    menuStep = 0
    if new action down(ACT_DOWN) then menuStep = 1
    if new action down(ACT_RIGHT) then menuStep = 1
    if new action down(ACT_UP) then menuStep = -1
    if new action down(ACT_LEFT) then menuStep = -1

    ` on the options page, left and right change the highlighted setting instead of moving the highlight.
    ` the page that "New Game" opens works the same way.
    menuChange = 0
    menuSettingsPage = 0
    if MENU_PAGE = MENU_PAGE_OPTIONS or MENU_PAGE = MENU_PAGE_NEW_GAME then menuSettingsPage = 1
    if menuSettingsPage
        menuStep = 0
        if new action down(ACT_DOWN) then menuStep = 1
        if new action down(ACT_UP) then menuStep = -1
        if new action down(ACT_RIGHT) then menuChange = 1
        if new action down(ACT_LEFT) then menuChange = -1
    endif

    ` the highlight wraps around the ends of the list
    if menuStep <> 0
        menuNext = MENU_SELECTED + menuStep
        if menuNext < 0 then menuNext = MENU_PAGE_LENGTH - 1
        if menuNext >= MENU_PAGE_LENGTH then menuNext = 0
        selectMenuItem(menuNext, 120)
    endif

    ` the mouse. the highlight follows it, and a click is the same as the confirm key. a line with a
    ` setting on it goes down when its left half is clicked, and up when its right half is, the same as
    ` the left and right keys. see THE MOUSE in fish_headers_mouse.
    menuMsPick = -1
    menuMsMoved = 0
    menuMsX = (WORLD_WIDTH - MENU_WIDTH) / 2
    menuMsLast = MENU_PAGE_LENGTH - 1
    for menuMsRow = 0 to menuMsLast
        menuMsY = MENU_LIST_TOP + menuMsRow * MENU_ROW_HEIGHT
        menuMsOn = mouseHover(menuMsX, menuMsY, MENU_WIDTH, MENU_ROW_HEIGHT)
        if menuMsOn
            if menuMsRow <> MENU_SELECTED
                selectMenuItem(menuMsRow, 120)
                menuMsMoved = 1
            endif
        endif
        menuMsHit = mouseClick(menuMsX, menuMsY, MENU_WIDTH, MENU_ROW_HEIGHT)
        if menuMsHit
            if menuMsRow <> MENU_SELECTED
                selectMenuItem(menuMsRow, 0)
            endif
            menuMsItem = MENU_PAGE_ITEMS(menuMsRow)
            menuMsPick = menuMsItem
            if menuSettingsPage
                if MENU_ITEMS(menuMsItem).hasValue
                    if menuMsItem <> MENU_ITEM_GAME_SEED
                        menuMsPick = -1
                        menuChange = 1
                        if MOUSE_X < WORLD_WIDTH / 2 then menuChange = -1
                    endif
                endif
            endif
        endif
    next

    if menuChange <> 0
        changeMenuOption(MENU_PAGE_ITEMS(MENU_SELECTED), menuChange)
    endif

    ` the same swell of sound that the cursor in the game makes when it moves. a change to
    ` how loud the sound is makes it too, so that the new setting can be heard.
    if menuMsMoved then menuStep = 1
    if menuStep <> 0 or menuChange <> 0
        create basic tween SWAP_TWEEN_SFX, 0, 1, 150, 0
        set tween type SWAP_TWEEN_SFX, 1
    endif

    menuPicked = -1
    if new action down(ACT_CONFIRM) then menuPicked = MENU_PAGE_ITEMS(MENU_SELECTED)
    if menuMsPick >= 0 then menuPicked = menuMsPick

    ` the pause key backs out of the pause menu, the same as picking "Resume". it backs out of the question, too.
    if MENU_MODE = MENU_MODE_PAUSE
        if new action down(ACT_PAUSE)
            menuPicked = MENU_ITEM_RESUME
            if MENU_PAGE = MENU_PAGE_CONFIRM then menuPicked = MENU_ITEM_CONFIRM_NO

            ` there is no game to go back to once it is over
            if MENU_PAGE = MENU_PAGE_GAME_OVER then menuPicked = -1
        endif
    endif

    ` and it backs out of the options page, whichever menu the options were opened from
    if MENU_PAGE = MENU_PAGE_OPTIONS
        if new action down(ACT_PAUSE)
            menuPicked = MENU_ITEM_SET_BACK
        endif
    endif
    if MENU_PAGE = MENU_PAGE_NEW_GAME
        if new action down(ACT_PAUSE)
            menuPicked = MENU_ITEM_GAME_BACK
        endif
    endif

    if menuPicked >= 0
        gosub menu_pick
    endif

    gosub frame_menu_render
return


` do whatever the line in menuPicked is for
menu_pick:
    if MENU_ITEMS(menuPicked).ready = 0
        ` it is not built yet, so it shakes its head.
        create basic tween MENU_SHAKE_TWEEN_ID, 1, 0, 400, 0
        return
    endif

    select menuPicked
        case MENU_ITEM_RESUME
            ` on the pause menu this goes back to the game. on the main menu it carries on with the saved game.
            if MENU_MODE = MENU_MODE_PAUSE
                gosub menu_close_pause
            else
                gosub menu_resume_game
            endif
        endcase

        case MENU_ITEM_NEW_GAME
            ` the very first game is not asked what kind of game it should be. it is a regular one, and it
            ` starts straight away. it is the first one for as long as the lines of THE FIRST DIVE have not
            ` been shown, and they are shown when it starts. a player who saw an older tutorial gets the new
            ` one the same way. see INTRO_VERSION, and fish_routines_intro.
            menuFirstGame = 0
            if MENU_MODE = MENU_MODE_MAIN
                menuIntroSeen = get pref(PREF_INTRO_SEEN, 0)
                if menuIntroSeen < INTRO_VERSION then menuFirstGame = 1
            endif

            if menuFirstGame
                OPTION_GAME_LENGTH = GAME_LENGTH_REGULAR
                OPTION_GAME_ZEN = 0
                OPTION_GAME_SEED = 0
                gosub menu_start_game
            else
                ` the intro has to be asked for every time, and so does a seed
                OPTION_GAME_INTRO = 0
                OPTION_GAME_SEED = 0

                ` ask what kind of game it should be. "Start" is highlighted to start with, so that picking
                ` it straight away plays the same kind of game as the last time. the lines are given their
                ` values first, the same as the options page, because setMenuPage only shows the value of a
                ` line that has one already.
                refreshOptionLines()
                setMenuPage(MENU_PAGE_NEW_GAME)
                refreshOptionLines()
                selectMenuItem(getMenuRow(MENU_ITEM_GAME_START), 0)
            endif
        endcase

        ` picking a choice is the same as pressing right on it
        case MENU_ITEM_GAME_LENGTH
            changeMenuOption(MENU_ITEM_GAME_LENGTH, 1)
        endcase
        case MENU_ITEM_GAME_MODE
            changeMenuOption(MENU_ITEM_GAME_MODE, 1)
        endcase
        case MENU_ITEM_GAME_INTRO
            changeMenuOption(MENU_ITEM_GAME_INTRO, 1)
        endcase

        ` the seed is entered on a page of its own. see THE PAGE WHERE A SEED IS ENTERED in fish_headers_seed.
        case MENU_ITEM_GAME_SEED
            gosub menu_run_seed_entry
        endcase

        case MENU_ITEM_GAME_START
            if MENU_MODE = MENU_MODE_PAUSE
                ` there is a game going, so ask before throwing it away. "No" is highlighted to start with.
                setMenuPage(MENU_PAGE_CONFIRM)
                selectMenuItem(0, 0)
            else
                gosub menu_start_game
            endif
        endcase

        case MENU_ITEM_GAME_BACK
            ` back to whichever menu "New Game" was picked from, with "New Game" highlighted again
            if MENU_MODE = MENU_MODE_PAUSE
                setMenuPage(MENU_PAGE_PAUSE)
            else
                setMenuPage(MENU_PAGE_MAIN)
            endif
            selectMenuItem(getMenuRow(MENU_ITEM_NEW_GAME), 0)
        endcase

        case MENU_ITEM_OVER_DONE
            ` the game is over, so there is nothing to carry on with later
            gosub forget_saved_game
            gosub menu_quit_to_title
        endcase

        case MENU_ITEM_OVER_CONTINUE
            ` the game goes on, and no round is the last one any more. the round that was the last one
            ` is over the way that any round is: with an upgrade, or with the next round, in a zen game.
            ` see KEEP PLAYING in fish_headers.
            GAME_ENDLESS = 1
            showRoundsLeft()

            ` the fish went home when the game was won, and now they are wanted again. see THE FISH GO HOME in fish_headers.
            fishComeHome()
            gosub menu_close_pause
            if GAME_ZEN
                advanceScoreBar()
            else
                REQUEST_ABILITY_SELECTION = 1
                SCORE_BAR_HOLD = 2
            endif
        endcase

        case MENU_ITEM_QUIT
            if MENU_MODE = MENU_MODE_PAUSE
                gosub menu_quit_to_title
            else
                end
            endif
        endcase

        case MENU_ITEM_CONFIRM_NO
            ` back to the pause menu, with "New Game" highlighted again
            setMenuPage(MENU_PAGE_PAUSE)
            selectMenuItem(getMenuRow(MENU_ITEM_NEW_GAME), 0)
        endcase

        case MENU_ITEM_CONFIRM_YES
            gosub menu_abandon_game
        endcase

        case MENU_ITEM_CREDITS
            gosub menu_run_credits
        endcase

        case MENU_ITEM_HIGHSCORES
            gosub menu_run_highscores

            ` the page of one score can ask for a new game on the seed of that score. see PLAY THIS SEED in fish_headers_seed.
            if HISCORE_PLAY_SEED > 0
                gosub highscore_play_seed
            endif
        endcase

        case MENU_ITEM_CODEC
            gosub menu_run_codec
        endcase

        case MENU_ITEM_MOVES
            ` the pause menu goes away, and the page that moves the moves between the buttons comes up
            ` over the game. with no moves to move, the line shakes its head.
            if MOVE_ABILITY_COUNT > 0
                gosub menu_close_pause
                gosub handle_move_rearrange
            else
                create basic tween MENU_SHAKE_TWEEN_ID, 1, 0, 400, 0
            endif
        endcase

        case MENU_ITEM_OPTIONS
            refreshOptionLines()
            setMenuPage(MENU_PAGE_OPTIONS)
            refreshOptionLines()
            selectMenuItem(0, 0)
        endcase

        ` picking a setting is the same as pressing right on it
        case MENU_ITEM_SET_SOUND
            changeMenuOption(MENU_ITEM_SET_SOUND, 1)
        endcase
        case MENU_ITEM_SET_MUSIC
            changeMenuOption(MENU_ITEM_SET_MUSIC, 1)
        endcase
        case MENU_ITEM_SET_FULLSCREEN
            changeMenuOption(MENU_ITEM_SET_FULLSCREEN, 1)
        endcase
        case MENU_ITEM_SET_LANGUAGE
            changeMenuOption(MENU_ITEM_SET_LANGUAGE, 1)
        endcase
        case MENU_ITEM_SET_MOTION
            changeMenuOption(MENU_ITEM_SET_MOTION, 1)
        endcase
        case MENU_ITEM_SET_POP_SPEED
            changeMenuOption(MENU_ITEM_SET_POP_SPEED, 1)
        endcase
        case MENU_ITEM_SET_REEF
            changeMenuOption(MENU_ITEM_SET_REEF, 1)
        endcase
        case MENU_ITEM_SET_MONSTER
            changeMenuOption(MENU_ITEM_SET_MONSTER, 1)
        endcase
        case MENU_ITEM_SET_PHOTOS
            changeMenuOption(MENU_ITEM_SET_PHOTOS, 1)
        endcase

        case MENU_ITEM_SET_BACK
            ` back to whichever menu the options were opened from, with "Options" highlighted again.
            ` the main menu does not have the "Resume" line, so its lines are counted from "New Game".
            if MENU_MODE = MENU_MODE_PAUSE
                setMenuPage(MENU_PAGE_PAUSE)
                selectMenuItem(getMenuRow(MENU_ITEM_OPTIONS), 0)
            else
                setMenuPage(MENU_PAGE_MAIN)
                selectMenuItem(getMenuRow(MENU_ITEM_OPTIONS), 0)
            endif
        endcase
    endselect
return


` put the main menu into the menu's render target. this does not show it, the callers do that.
menu_open_main:
    MENU_MODE = MENU_MODE_MAIN

    show sprite MENU_BG_SPRITE
    hide sprite MENU_DIM_SPRITE
    showSurface(1)

    setMenuPage(MENU_PAGE_MAIN)
    selectMenuItem(0, 0)

    create basic tween MENU_FADE_TWEEN_ID, 1, 1, 1, 0
return


` the main menu's "New Game". the bubbles take the menu away, and the game is underneath.
menu_start_game:
    gosub reset_game
    gosub apply_game_options
    gosub forget_saved_game

    ` the very first game is a little tutorial, and so is one that asks to be. the board is put away
    ` before the bubbles uncover it, and then it comes in a piece at a time. see THE FIRST DIVE, in
    ` fish_routines_intro. for any other game, these two do nothing.
    gosub tutorial_prepare

    ` the coral is drawn and the fish put away, so that they can fall in once the water is clear. see THE ENTRANCE in fish_headers_entrance.
    gosub entrance_prepare

    TRANSITION_TO_MENU = 0
    gosub menu_transition

    MENU_MODE = MENU_MODE_CLOSED

    gosub run_first_dive_intro
return


` PLAY THIS SEED. the page of one high score asked for a new game on the seed of that score, and
` the pages of the high scores have closed. the game is the length and the mode of the table that
` the score was on. see fish_headers_seed.
highscore_play_seed:
    OPTION_GAME_LENGTH = HISCORE_PLAY_TABLE / 2
    OPTION_GAME_ZEN = HISCORE_PLAY_TABLE mod 2
    OPTION_GAME_INTRO = 0
    OPTION_GAME_SEED = HISCORE_PLAY_SEED
    HISCORE_PLAY_SEED = 0
    set pref PREF_GAME_LENGTH, OPTION_GAME_LENGTH
    set pref PREF_GAME_ZEN, OPTION_GAME_ZEN
    gosub menu_start_game
return


` a new game has just been reset. make it the kind of game that was picked on the menu.
` see THE KIND OF GAME in fish_headers.
apply_game_options:
    GAME_ROUND_CAP = getGameLengthRounds(OPTION_GAME_LENGTH)
    GAME_ZEN = OPTION_GAME_ZEN
    showRoundsLeft()

    ` a zen game has the one passive, and never gets another
    if GAME_ZEN
        grantPassive(ABILITY_INDEX_WRAP)
        logUpgrade(ABILITY_INDEX_WRAP)
    endif
return


` the main loop comes here on every frame of the game. when the last round has been won, this brings
` up the high scores, over the game, the same way that the pause menu comes up.
handle_game_end:
    if REQUEST_GAME_END = 0 then return

    ` a demo never ends a game. frame_demo stops it instead. see THE DEMO in fish_headers_demo.
    if DEMO_MODE then return

    ` let a swap that is playing out finish first
    if LIVE_MOVE_ACTIVE then return
    REQUEST_GAME_END = 0

    ` a game that was won the usual way ends with the fish going home. see THE FISH GO HOME in fish_headers.
    ` one of the two endings of the hidden game has had an ending of its own already.
    if CORAL_ENDING = 0
        if GAME_ENDLESS = 0
            gosub finale_goodbye
        endif
    endif

    MENU_MODE = MENU_MODE_PAUSE

    hide sprite MENU_BG_SPRITE
    show sprite MENU_DIM_SPRITE
    showSurface(0)

    MENU_ITEMS(MENU_ITEM_OVER_DONE).desc$ = loc$("menu.over.done.rounds", "rounds", GAME_ROUND_CAP, "moves", CURRENT_MOVE_COUNT)

    ` the game may have ended early, with one of the two endings of the hidden game. see THE TWO ENDINGS in fish_headers.
    if CORAL_ENDING = CORAL_ENDING_REEF
        MENU_ITEMS(MENU_ITEM_OVER_DONE).desc$ = loc$("menu.over.done.reef", "moves", CURRENT_MOVE_COUNT)
    endif
    if CORAL_ENDING = CORAL_ENDING_ANCIENT
        MENU_ITEMS(MENU_ITEM_OVER_DONE).desc$ = loc$("menu.over.done.ancient", "moves", CURRENT_MOVE_COUNT)
    endif
    if CORAL_ENDING = CORAL_ENDING_DIVER
        MENU_ITEMS(MENU_ITEM_OVER_DONE).desc$ = loc$("menu.over.done.album", "moves", CURRENT_MOVE_COUNT)
    endif
    setMenuPage(MENU_PAGE_GAME_OVER)
    selectMenuItem(0, 0)

    ` the end of a game is the best mark that the steam timeline gets. it says the same as the menu does.
    add steam timeline event loc$("steam.theend"), MENU_ITEMS(MENU_ITEM_OVER_DONE).desc$, "steam_crown", 900, 2

    hintShow(0)
    set screen shake amount 0

    ` a game that was won already, and was being carried on with, has been counted. the only way that
    ` it ends again is with one of the two endings of the hidden game, and then it is back to the title.
    ` see KEEP PLAYING in fish_headers.
    if GAME_ENDLESS
        gosub forget_saved_game
        gosub menu_quit_to_title
        return
    endif

    ` the player is asked for their initials, and shown the table of high scores. that takes the place
    ` of the list of the menu, and it fades the menu in. see fish_routines_highscores.
    gosub highscore_game_end

    ` a game that ended with one of the two endings of the hidden game is over for good. it is back to
    ` the title. the high scores fade out before they are put away.
    if CORAL_ENDING > 0
        ` the ending of the diver has a scene at the boat, once the main menu is back. see THE ENDING in fish_headers_diver.
        endAtBoat = 0
        if CORAL_ENDING = CORAL_ENDING_DIVER then endAtBoat = 1

        gosub menu_fade_out
        closeHighscores()
        gosub menu_quit_to_title
        if endAtBoat
            gosub diver_boat_scene
        endif
        return
    endif

    ` and so is a game that was won the usual way: the fish have gone home. there is nothing to carry
    ` on with, so the saved game is forgotten too. see THE FISH GO HOME in fish_headers.
    if FISH_AWAY
        gosub menu_fade_out
        closeHighscores()
        gosub forget_saved_game
        gosub menu_quit_to_title
        return
    endif

    ` any other game can be carried on with. the list of the menu comes back, in place of the high
    ` scores, and asks: "Keep Playing", or "Done". frame_menu takes it from here.
    closeHighscores()
    setMenuPage(MENU_PAGE_GAME_OVER)
    selectMenuItem(0, 0)
return


` the pause key was pressed in the game
menu_open_pause:
    questTalkStop() `the game stands still under the menu, and the box would too
    ` the game is saved as it is paused, in case the window gets closed from the pause menu
    gosub save_game

    MENU_MODE = MENU_MODE_PAUSE

    hide sprite MENU_BG_SPRITE
    show sprite MENU_DIM_SPRITE
    showSurface(0)

    setMenuPage(MENU_PAGE_PAUSE)
    selectMenuItem(0, 0)

    ` the menu has its own hint, in the same place
    hintShow(0)

    ` nothing runs while the game is paused, so nothing would ever stop a shake that was going
    set screen shake amount 0

    ` the screen is drawn before the menu's render target is, so the menu has to be drawn once before it is shown.
    ` otherwise the first frame would show whatever the menu looked like the last time it was up.
    create basic tween MENU_FADE_TWEEN_ID, 0, 0, 1, 0
    gosub frame_menu_render
    sync

    show sprite MENU_COMPOSITE_SPRITE
    create basic tween MENU_FADE_TWEEN_ID, 0, 1, 150, 0
return


` fade the pause menu out, and go back to the game
menu_close_pause:
    gosub menu_fade_out
    MENU_MODE = MENU_MODE_CLOSED
return


menu_fade_out:
    create basic tween MENU_FADE_TWEEN_ID, tweenVal(MENU_FADE_TWEEN_ID), 0, 150, 0
    while is tween done(MENU_FADE_TWEEN_ID) < 1
        gosub frame_menu_render
        sync
    endwhile

    hide sprite MENU_COMPOSITE_SPRITE
    hintShow(1)
return


` the pause menu's "Quit". the bubbles bring the main menu in over the game.
menu_quit_to_title:
    gosub menu_fade_out
    gosub menu_open_main

    ` after the ending of the diver, the main menu comes back see-through, and the scene at the boat
    ` fades it in when it is over. see diver_boat_scene, in fish_routines_diver.
    if CORAL_ENDING = CORAL_ENDING_DIVER
        setMenuChromeAlpha(0)
    endif

    TRANSITION_TO_MENU = 1
    gosub menu_transition

    ` the game is hidden now, so it can be put back to how it starts
    gosub reset_game
return


` the answer was "Yes", so throw the game away and start a new one.
menu_abandon_game:

    ` the old game has to be out of sight before it can be swapped for the new one. so the main menu's
    ` background is pulled over the top of the pause menu like a curtain.
    order sprite MENU_BG_SPRITE, ORDER_MENU_CURTAIN
    show sprite MENU_BG_SPRITE
    set sprite alpha MENU_BG_SPRITE, 0
    create basic tween MENU_CURTAIN_TWEEN_ID, 0, 255, 250, 0
    while is tween done(MENU_CURTAIN_TWEEN_ID) < 1
        set sprite alpha MENU_BG_SPRITE, tweenVal(MENU_CURTAIN_TWEEN_ID)
        gosub frame_menu_render
        sync
    endwhile

    ` the screen shows the menu a frame late, so give the solid curtain a frame to get there
    set sprite alpha MENU_BG_SPRITE, 255
    gosub frame_menu_render
    sync
    sync

    gosub reset_game
    gosub apply_game_options
    gosub forget_saved_game
    hintShow(1)

    ` the new game can ask for the tutorial, the same as one that starts from the main menu
    gosub tutorial_prepare

    ` and the fish fall in, the same as well. see THE ENTRANCE in fish_headers_entrance.
    gosub entrance_prepare

    ` and then the bubbles take the curtain away, the same as when the game starts from the main menu
    TRANSITION_TO_MENU = 0
    gosub menu_transition

    order sprite MENU_BG_SPRITE, ORDER_MENU_BACKDROP
    MENU_MODE = MENU_MODE_CLOSED

    gosub run_first_dive_intro
return


` wipe between the menu and the game with a wave of bubbles.
` set TRANSITION_TO_MENU before calling this. 1 brings the menu in over the game, and 0 takes it away.
menu_transition:

    ` the wave is a different shape every time. one side of it is ahead of the other, and the middle
    ` bows up or down. together they are never more than TRANSITION_SWEEP_MAX.
    sweepLean = 70 + rnd(60)
    if rnd(2) = 0 then sweepLean = 0 - sweepLean
    sweepBow = rnd(51) - 25

    ` the wave sounds different every time too. it is higher or lower, it slides up or down a little as it
    ` goes by, and it is a little louder or quieter. it also crosses from the side of the screen that is
    ` ahead to the side that is behind. frame_transition does the sliding.
    wavePitch# = (rnd(71) - 40) * .01
    waveGlide# = (rnd(51) - 25) * .01
    waveLoud# = .8 + rnd(31) * .01
    wavePan# = .35
    if sweepLean < 0 then wavePan# = -.35

    ` between the main menu and the game, the wave is the waterline. the mask is the water, and the
    ` main menu is the view from the surface, so it shows wherever the mask is empty. see THE SURFACE,
    ` in fish_routines_surface.
    transitionSurface = 0
    if TRANSITION_FOR_UPGRADE = 0
        if MENU_MODE = MENU_MODE_MAIN then transitionSurface = 1
    endif

    ` coming back up to the surface, the waterline goes down the screen. bubbles do not go down, so
    ` there are none to see on the way up. the effects draw a line of water with foam on it instead.
    ` see THE WATERLINE in fish_headers. the mask still gets emptied behind it, by a wave that runs
    ` backwards, so that the mask is right when the line has gone.
    transitionDown = 0
    if transitionSurface
        if TRANSITION_TO_MENU then transitionDown = 1
    endif

    ` going under, the camera starts to sink a moment before the bubbles show up. this is how much
    ` of the way down it gets in that moment, which is no way at all for any other wave.
    sinkLead# = 0
    if transitionSurface
        if transitionDown = 0
            sinkLead# = SURFACE_SINK_LEAD_SHARE#
        endif
    endif

    ` give every bubble a new spot in the wave
    frontX = 0
    frontSize = 0
    for menuI = 0 to BUBBLE_COUNT - 1
        bub = BUBBLES(menuI)

        if menuI < BUBBLE_FRONT_COUNT
            ` the front is a ragged row of big bubbles. they are different sizes, and a few are much bigger
            ` than the rest. each one is pushed off of its spot in the row, and up or down.
            bub.size = 64 + rnd(22)
            if rnd(3) = 0 then bub.size = 84 + rnd(26)
            bub.x = menuI * WORLD_WIDTH / (BUBBLE_FRONT_COUNT - 1) + rnd(25) - 12
            bub.offsetY = rnd(37) - 18

            ` the strip of tide under a bubble is narrower than the bubble is, so that its corners are hidden
            ` inside of the bubble. the strips have to overlap, or there would be a gap in the mask. so a
            ` bubble is never further from the one on its left than their two strips can reach.
            if menuI > 0
                frontGap = (frontSize + bub.size) / 2 - 14
                if bub.x > frontX + frontGap then bub.x = frontX + frontGap
            endif
            frontX = bub.x
            frontSize = bub.size
            size sprite bub.tideSpriteId, bub.size - 12, WORLD_HEIGHT * 4
        else
            ` the rest are scattered ahead of the front and behind it. most are small, and some are not.
            bub.x = rnd(WORLD_WIDTH)
            bub.offsetY = rnd(280) - 150
            bub.size = 5 + rnd(18)
            if menuI mod 5 = 0 then bub.size = 24 + rnd(26)
        endif
        bub.phase = rnd(628)

        ` move the bubble to where the wave is at its part of the screen
        sweepX = bub.x - WORLD_WIDTH / 2
        bub.offsetY = bub.offsetY + (sweepLean * sweepX) / WORLD_WIDTH + sweepBow * sin(bub.x * .0055)

        size sprite bub.spriteId, bub.size, bub.size
        ` coming back up from a game that ended with the ancient one, the wave is eyes, in place of
        ` the bubbles, and they come down the screen with the waterline. see THE TWO ENDINGS in fish_headers.
        bubEyes = 0
        if transitionDown
            if CORAL_ENDING = CORAL_ENDING_ANCIENT then bubEyes = 1
        endif

        set sprite all texcoord1 bub.spriteId, bub.size, 0, 0, bubEyes * 2
        if transitionDown = 0 or bubEyes = 1
            show sprite bub.spriteId
        endif

        size sprite bub.maskSpriteId, bub.size, bub.size
        set sprite all texcoord1 bub.maskSpriteId, bub.size, 1, 0, 0

        BUBBLES(menuI) = bub
    next

    ` coming back up from a game that ended with the album of the diver full, the wave is photo papers.
    ` see THE ENDING in fish_headers_diver.
    diverWaveStart(transitionDown)

    ` the wave starts below the screen, which leaves the mask empty. the screen is drawn before the mask is,
    ` so the screen is always looking at the mask from the frame before. the empty mask gets drawn once here,
    ` before the composite sprite is told to start using it.
    create basic tween TRANSITION_TWEEN_ID, 0, 0, 1, 0
    transitionPrev# = transitionDown
    gosub frame_transition
    if sinkLead# > 0 then SURFACE_SINK# = 0 `the camera has not had its head start yet
    gosub frame_transition_render
    sync

    if TRANSITION_FOR_UPGRADE
        UPGRADE_INVERT = 1 - TRANSITION_TO_MENU
        show sprite UPGRADE_COMPOSITE_SPRITE
    else
        MENU_INVERT = 1 - TRANSITION_TO_MENU
        if transitionDown then MENU_INVERT = 1
        show sprite MENU_COMPOSITE_SPRITE
    endif

    ` the watery wobble over the screen follows the waterline from here on
    TRANSITION_SURFACE = transitionSurface

    ` on the way up, the line of water takes over from the mask. it leans a different way every time.
    WATERLINE_USE = transitionDown
    WATERLINE_TILT# = (rnd(21) - 10) * .012

    ` the camera gets its head start. the wave is still waiting below the screen.
    if sinkLead# > 0
        create basic tween TRANSITION_TWEEN_ID, 0, 1, SURFACE_SINK_LEAD, 0
        set tween easing TRANSITION_TWEEN_ID, EASING_LINEAR
        while is tween done(TRANSITION_TWEEN_ID) < 1
            ` it is slow to get going, and it is still moving when the wave comes
            sinkLeadT# = tweenVal(TRANSITION_TWEEN_ID)
            SURFACE_SINK# = sinkLeadT# * sinkLeadT# * sinkLead#
            gosub frame_menu_render
            sync
        endwhile
    endif

    create basic tween TRANSITION_TWEEN_ID, 0, 1, TRANSITION_DURATION, 0
    set tween easing TRANSITION_TWEEN_ID, EASING_LINEAR

    ` the music goes with the wave. it dives down to the deep as the game comes in, and it comes back
    ` up to the surface with the menu. after that it goes back to drifting between the two on its own.
    ` the music stays where it is for the upgrade screen.
    if TRANSITION_FOR_UPGRADE = 0
        if TRANSITION_TO_MENU
            setMusicDepth(0, MUSIC_DIVE_FADE#)
        else
            setMusicDepth(1, MUSIC_DIVE_FADE#)
        endif
    endif

    ` the recording is a lot longer than the wave is, and it loops. it carries on from wherever it was
    ` stopped the last time, so every wave gets a different part of it. frame_transition fades it in and out.
    set sfx volume SFX_BUBBLES, 0
    set sfx pitch SFX_BUBBLES, wavePitch#
    if waveSfxStarted
        resume sfx SFX_BUBBLES
    else
        play sfx SFX_BUBBLES
        waveSfxStarted = 1
    endif

    while is tween done(TRANSITION_TWEEN_ID) < 1
        gosub frame_transition
        gosub frame_transition_render
        sync
    endwhile

    ` once more, so that the mask is drawn with the wave all the way off of the top of the screen
    gosub frame_transition
    gosub frame_transition_render
    sync

    for menuI = 0 to BUBBLE_COUNT - 1
        hide sprite BUBBLES(menuI).spriteId
    next
    diverWaveEnd()

    ` the sound has been faded out by now. it is paused and not stopped, so that the next wave carries on from here.
    pause sfx SFX_BUBBLES

    ` the mask is full now. if the menu was being taken away, then none of it is being drawn any more.
    if TRANSITION_TO_MENU = 0
        if TRANSITION_FOR_UPGRADE
            hide sprite UPGRADE_COMPOSITE_SPRITE
            UPGRADE_INVERT = 0
        else
            hide sprite MENU_COMPOSITE_SPRITE
            MENU_INVERT = 0
        endif
    endif

    ` the camera is all the way under now, or all the way up
    if transitionSurface
        TRANSITION_SURFACE = 0
        WATERLINE_USE = 0
        SURFACE_UP = TRANSITION_TO_MENU
        SURFACE_SINK# = 1 - TRANSITION_TO_MENU
    endif
return


` draw whatever it is that the wave is wiping: the menu, or the upgrade screen
frame_transition_render:
    if TRANSITION_FOR_UPGRADE
        gosub frame_ability_selection
    else
        gosub frame_menu_render
    endif
return


` move the wave of bubbles to wherever the transition tween says it should be
frame_transition:
    transitionNow# = tweenVal(TRANSITION_TWEEN_ID)

    ` how far up the screen the wave is. 0 is below the bottom, and 1 is above the top.
    ` a wave that is going down the screen starts at the top.
    waveNow# = transitionNow#
    if transitionDown then waveNow# = 1 - transitionNow#

    ` the higher the waterline is, the further under the camera is
    if transitionSurface
        if transitionDown
            ` coming up is slow to start and slow to stop
            SURFACE_SINK# = waveNow# * waveNow# * (3 - 2 * waveNow#)
        else
            ` going under, the camera has had a head start on the wave. it carries on from there, and slows to a stop.
            ` it does most of what is left early on, so that it does not lose its speed when the wave starts.
            sinkLeft# = (1 - waveNow#) * (1 - waveNow#)
            SURFACE_SINK# = sinkLead# + (1 - sinkLeft# * sinkLeft#) * (1 - sinkLead#)
        endif
    endif

    ` the line of water starts above the top of the screen and ends below the bottom. it is slow to
    ` start and slow to stop, the same as the camera is.
    WATERLINE_Y# = transitionNow# * transitionNow# * (3 - 2 * transitionNow#) * 1.5 - .25

    ` the bubbles in the mask go where the wave is now. the bubbles on the screen go where the wave
    ` was on the frame before, because that is the mask that the screen is looking at.
    for bubPass = 0 to 1
        bubT# = waveNow#
        if bubPass = 1 then bubT# = transitionPrev#

        bubLine = TRANSITION_LINE_START - TRANSITION_LINE_TRAVEL * bubT#

        for menuI = 0 to BUBBLE_COUNT - 1
            bub = BUBBLES(menuI)
            bubX = bub.x + sin(bubT# * 12 + bub.phase * .01) * 5
            bubY = bubLine + bub.offsetY

            if bubPass = 0
                position sprite bub.maskSpriteId, bubX, bubY

                ` the tide fills in the mask from the middle of each front bubble, all the way down
                if menuI < BUBBLE_FRONT_COUNT
                    position sprite bub.tideSpriteId, bub.x, bubY
                endif
            else
                position sprite bub.spriteId, bubX, bubY
            endif
        next
    next

    ` the photo papers of the diver's ending go where the bubbles on the screen do
    diverWaveStep(bubLine, transitionPrev#)

    ` the sound of the wave comes up quickly at the start, and dies away as the wave leaves the top of the screen
    bubVolume# = transitionNow# * 6
    if bubVolume# > 1 then bubVolume# = 1
    bubFadeOut# = (1 - transitionNow#) * 3
    if bubFadeOut# < bubVolume# then bubVolume# = bubFadeOut#

    ` the recording is much louder than the other sounds in the game. at full volume, the sound of
    ` the cursor moving is too quiet next to it to be heard.
    set sfx volume SFX_BUBBLES, bubVolume# * SFX_BUBBLES_VOLUME# * waveLoud#
    set sfx pitch SFX_BUBBLES, wavePitch# + waveGlide# * transitionNow#
    set sfx pan SFX_BUBBLES, wavePan# * (transitionNow# * 2 - 1)

    transitionPrev# = waveNow#
return


` everything in the menu that changes from frame to frame
frame_menu_render:

    ` TODO: stupid FX system loses parameters between reloads, so best to set them in a loop.
    set effect param texture MENU_FX_ID, "MaskTexture", render target texture(TARGET_MASK)
    set effect param float MENU_FX_ID, "Fade", tweenVal(MENU_FADE_TWEEN_ID)
    set effect param float MENU_FX_ID, "Invert", MENU_INVERT
    set effect param float4 MENU_FX_ID, "WaterLine", WATERLINE_Y#, WATERLINE_TILT#, game ms() * .001, WATERLINE_USE
    set effect param float2 MENU_FX_ID, "Grid", WORLD_WIDTH, WORLD_HEIGHT

    menuMs = game ms()

    ` the main loop does not run update_frame while a menu is up, so this keeps the bubbles and the music going
    updateBubbles()
    updateMusic()

    ` the sound of the highlight moving
    set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

    ` the outline slides to the highlighted line, and pulses the same way that the info mode cursor does
    layoutInfoBorder(MENU_CURSOR, (WORLD_WIDTH - MENU_WIDTH) / 2 + 6, tweenVal(MENU_CURSOR_TWEEN_Y), MENU_WIDTH - 12, MENU_ROW_HEIGHT)
    menuPulse# = .8 + .2 * sin(menuMs * .006)
    colorInfoBorder(MENU_CURSOR, rgb(255, 255, 255, 255 * menuPulse# * MENU_CHROME_ALPHA#))

    ` text sits on whole pixels, and the position gets cut down to one, not rounded. the extra half
    ` pixel makes that the same as rounding, so that a tiny shake does not flicker the text by a pixel.

    ` the highlighted line shakes from side to side when it cannot be picked
    menuShake# = sin(menuMs * .045) * 4 * tweenVal(MENU_SHAKE_TWEEN_ID)
    positionMenuItemText(MENU_PAGE_ITEMS(MENU_SELECTED), .5 + menuShake#, MENU_LIST_TOP + MENU_SELECTED * MENU_ROW_HEIGHT)

    ` the title bobs up and down
    set text position MENU_TITLE_TEXT_ID, WORLD_WIDTH / 2, MENU_TITLE_Y + .5 + sin(menuMs * .002) * 3

    ` the version is only on the main menu, and it is half see-through. it fades in with the rest.
    menuVersionAlpha# = 0
    if MENU_PAGE = MENU_PAGE_MAIN
        if MENU_MODE <> MENU_MODE_PAUSE then menuVersionAlpha# = 128 * MENU_CHROME_ALPHA#
    endif
    set text alpha MENU_VERSION_TEXT_ID, menuVersionAlpha#

    ` the sea rolls, and the boat rocks on it
    gosub frame_surface

return


` put the game back to how it is at the very start, so that a new one can be played.
reset_game:

    ` the seed of the new game comes first, because everything that is picked from here on is
    ` picked from it. see THE SEED OF A GAME in fish_headers_seed.
    seedNewGame()
    entranceCancel() `a game that ends while its fish are still falling in. see THE ENTRANCE in fish_headers_entrance.
    teachResetGame() `every big moment is new again in a new game. see THE BIG MOMENTS in fish_headers_teach.

    ` if the game that is being thrown away was still in its tutorial, the pieces that it had not got to are put back
    gosub tutorial_end

    ` the upgrades go first, because some of them change which fish can show up
    for resetI = 0 to CARD_LENGTH - 1
        CARDS(resetI).obtained = 0
        CARDS(resetI).uses = 0
    next

    for resetI = 0 to PASSIVE_BINDINGS_LENGTH - 1
        PASSIVE_BINDINGS(resetI).assigned = 0
        PASSIVE_INFO(resetI) = 0 `the info blobs of the upgrades are forgotten, further down
        set text alpha PASSIVE_BINDINGS(resetI).titleTextId, 0
    next
    PASSIVE_COUNT = 0

    for resetI = 0 to MOVE_ABILITY_BINDINGS_LENGTH - 1
        MOVE_ABILITY_BINDINGS(resetI).assigned = 0
        MOVE_ABILITY_BINDINGS(resetI).movesLeft = 0
        MOVE_ABILITY_BINDINGS(resetI).hasInfo = 0 `the info blobs of the upgrades are forgotten, further down
        set text alpha MOVE_ABILITY_BINDINGS(resetI).titleTextId, 0
        set text alpha MOVE_ABILITY_BINDINGS(resetI).keyTextId, 0
        set text alpha MOVE_ABILITY_BINDINGS(resetI).timerTextId, 0
    next
    MOVE_ABILITY_COUNT = 0
    MOVE_SLOTS_OPEN = MOVE_SLOT_START_COUNT

    ` the upgrades explained themselves in info mode. forget those. the empty spaces that they leave are not explained.
    if INFO_LENGTH > INFO_BASE_LENGTH
        for resetI = INFO_BASE_LENGTH to INFO_LENGTH - 1
            INFOS(resetI).assigned = 0
            INFOS(resetI).enabled = 0
            showInfoBorder(INFOS(resetI).border, 0)
        next
    endif
    INFO_LENGTH = INFO_BASE_LENGTH
    INFO_SELECTED = 0
    setInfoBlobEnabled(INFO_INDEX_PASSIVES, 0)
    setInfoBlobEnabled(INFO_INDEX_MOVES, 0)

    ` the board goes back to the size that it starts at, and the cells that it grew are put away
    PENDING_BOARD_EXPANSIONS = 0
    resizeGrid(GRID_START_COUNT, GRID_START_COUNT)
    scale sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE

    ` a new board of fish. see seedDealBoard in fish_routines_seed. the game before may have ended on a
    ` round that was won, and the new fish of that are dealt by other rules. this one has won nothing.
    NEW_FISH_ROUND_WON = 0
    seedDealBoard()
    for resetI = 0 to CELL_COUNT - 1
        CELLS(resetI).comboForce = 0
        CELLS(resetI).comboBlownUp = 0
        clearCellStack(resetI)
        updateCell(CELLS(resetI))
        set sprite alpha CELLS(resetI).spriteId, 255
        hide sprite CELLS(resetI).fxSpriteId
    next

    ` the cursor goes back to the middle
    SELECTION_POS.x = CELL_COLUMN_COUNT / 2
    SELECTION_POS.y = CELL_ROW_COUNT / 2
    gosub update_selection_position
    QUEUED_MOVE_NUM = 0
    QUEUED_MOVE_TAIL = 0
    REQUEST_COMBO_CHECK = 0
    REQUEST_ABILITY_SELECTION = 0
    REQUEST_GAME_END = 0
    GAME_ENDLESS = 0
    GAME_DEBUG_USED = 0
    fastReset() `the fast, and the modifiers of the game. see fish_headers_fast.
    ANGLER_CALL_PENDING = 0 `a call of the old angler fish that has not been answered yet. see THE CALL in fish_headers_angler.
    BELLY_UP_ROLL_DUE = 0

    ` the score
    CURRENT_SCORE = 0
    syncScoreShown()
    CURRENT_ROUND = 0
    CURRENT_MOVE_COUNT = 0
    GAME_LOG_COUNT = 0 `no upgrades have been picked yet
    PENDING_FREE_MOVES = 0
    set text MOVE_COUNT_TEXT_ID, "0"
    showRoundsLeft()

    SCORE_BAR.startVal = 0
    SCORE_BAR.endVal = getRoundSpan(0)
    PROGRESS_BARS(0) = SCORE_BAR
    create basic tween SCORE_BAR.progressTweenId, 0, 0, 1, 0

    resetMultiplier()
    resetCoral()
    resetQuests()
    diverReset()
    tideReset()
    glowReset() `the glow. see fish_headers_glow.
    schoolReset() `which way the fish face. see fish_headers_school.
    rainbowFishReset() `the rainbow fish. see fish_headers_rainbow.

    ` any score that was still floating up off of the fish
    for resetI = 0 to SCORE_TEXT_COUNT - 1
        create basic tween SCORE_TEXTS(resetI).fadeInTweenId, 0, 0, 1, 0
        create basic tween SCORE_TEXTS(resetI).fadeTweenId, 0, 0, 1, 0
        set text alpha SCORE_TEXTS(resetI).textId, 0
    next

    set screen shake amount 0
    FREE_MOVES_SHAKING = 0

    clearBubbles()

return


routines_menu_exit:


` jump straight into the game, without going through the main menu. the tests use this.
function skipMainMenu()
    MENU_MODE = MENU_MODE_CLOSED
    hide sprite MENU_COMPOSITE_SPRITE
    setMusicDepth(1, MUSIC_DIVE_FADE#) `the music dives, the same as when the wave takes the menu away
endfunction


` change which lines the menu is showing, and lay them out.
function setMenuPage(page)
    MENU_PAGE = page

    ` the main menu
    ` the name of the game is bigger than the title of any other page, and its shadow is thicker.
    ` 48 is three times the size that the font is drawn at, so it is sharp.
    title$ = "Fish Fish Pop"
    titleSize = 48
    titleShadow = 4
    hint$ = loc$("menu.hint.main")
    first = MENU_ITEM_NEW_GAME
    last = MENU_ITEM_QUIT
    MENU_WIDTH = 180
    MENU_ITEMS(MENU_ITEM_QUIT).desc$ = loc$("menu.quit.desc")

    ` when there is a saved game to go back to, the main menu starts with "Resume", the same as the pause menu does
    if page = MENU_PAGE_MAIN
        savedGame = hasSavedGame()
        if savedGame
            first = MENU_ITEM_RESUME
            MENU_ITEMS(MENU_ITEM_RESUME).desc$ = loc$("menu.resume.desc.saved")
        endif
    endif

    ` the options page can be opened from the main menu or from the pause menu, and looks the same from both.
    ` its lines are longer, because they have their settings on the end, so the panel is wider.
    if page = MENU_PAGE_OPTIONS
        title$ = loc$("menu.title.options")
        titleSize = 36
        hint$ = loc$("menu.hint.options")
        first = MENU_ITEM_SET_SOUND
        last = MENU_ITEM_SET_BACK
        MENU_WIDTH = 260
    endif

    ` the page that "New Game" opens, to ask what kind of game it should be. it works like the options page.
    if page = MENU_PAGE_NEW_GAME
        title$ = loc$("menu.title.newgame")
        titleSize = 36
        hint$ = loc$("menu.hint.newgame")
        first = MENU_ITEM_GAME_LENGTH
        last = MENU_ITEM_GAME_BACK
        MENU_WIDTH = 220
    endif

    ` the page that comes up over the game when the last round has been won
    if page = MENU_PAGE_GAME_OVER
        title$ = loc$("menu.title.won")
        titleSize = 36
        hint$ = loc$("menu.hint.main")
        first = MENU_ITEM_OVER_DONE
        last = MENU_ITEM_OVER_DONE
    endif

    if page = MENU_PAGE_PAUSE
        title$ = loc$("menu.title.paused")
        titleSize = 36
        hint$ = loc$("menu.hint.paused")
        first = MENU_ITEM_RESUME
        MENU_ITEMS(MENU_ITEM_RESUME).desc$ = loc$("menu.resume.desc")

        ` quitting from a game goes back to the main menu, which has the quit that closes the window.
        ` the run is saved, and the main menu has a "Resume" that carries on with it.
        MENU_ITEMS(MENU_ITEM_QUIT).desc$ = loc$("menu.quit.desc.pause")
    endif

    if page = MENU_PAGE_CONFIRM
        title$ = loc$("menu.title.abandon")
        titleSize = 28
        hint$ = loc$("menu.hint.confirm")
        first = MENU_ITEM_CONFIRM_NO
        last = MENU_ITEM_CONFIRM_YES
    endif

    ` the page is the run of items from the first to the last. the pause menu leaves out the high scores
    ` and the credits, which are things to look at from the title, and not in the middle of a game.
    ` it keeps the codec, so that what is on the board can be looked up.
    MENU_PAGE_FIRST = first
    MENU_PAGE_LENGTH = 0
    for i = 0 to MENU_ITEM_COUNT - 1
        onPage = 1
        if i < first or i > last then onPage = 0
        if page = MENU_PAGE_PAUSE
            if i = MENU_ITEM_HIGHSCORES or i = MENU_ITEM_CREDITS then onPage = 0
        endif

        ` the pause menu has "Inventory" right under "Resume"
        if i = MENU_ITEM_MOVES
            if page = MENU_PAGE_PAUSE then skip
        endif

        ` and the page for a game that was won has "Keep Playing" right above "Done"
        if i = MENU_ITEM_OVER_DONE
            if page = MENU_PAGE_GAME_OVER
                MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_OVER_CONTINUE
                MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                showMenuItemText(MENU_ITEM_OVER_CONTINUE)
            endif
        endif
        if i = MENU_ITEM_OVER_CONTINUE
            if page = MENU_PAGE_GAME_OVER then skip
        endif

        ` and the options page has the reef and the monster of the main menu right under "Fullscreen",
        ` each of them only once it is there to be turned off
        if i = MENU_ITEM_SET_REEF
            if page = MENU_PAGE_OPTIONS
                if SURFACE_REEF = 0
                    hideMenuItemText(i)
                endif
                skip
            endif
        endif
        if i = MENU_ITEM_SET_MONSTER
            if page = MENU_PAGE_OPTIONS
                if SURFACE_ANCIENT = 0
                    hideMenuItemText(i)
                endif
                skip
            endif
        endif
        if i = MENU_ITEM_SET_PHOTOS
            if page = MENU_PAGE_OPTIONS
                if DIVER_SURFACE = 0
                    hideMenuItemText(i)
                endif
                skip
            endif
        endif

        ` and the options page has the language right under "Fullscreen", always, and the water motion under that
        if i = MENU_ITEM_SET_LANGUAGE
            if page = MENU_PAGE_OPTIONS then skip
        endif
        if i = MENU_ITEM_SET_MOTION
            if page = MENU_PAGE_OPTIONS then skip
        endif
        if i = MENU_ITEM_SET_POP_SPEED
            if page = MENU_PAGE_OPTIONS then skip
        endif

        ` and the page that "New Game" opens has the seed right under "Include intro"
        if i = MENU_ITEM_GAME_SEED
            if page = MENU_PAGE_NEW_GAME then skip
        endif

        if onPage
            MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = i
            MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
            showMenuItemText(i)

            if page = MENU_PAGE_NEW_GAME
                if i = MENU_ITEM_GAME_INTRO
                    MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_GAME_SEED
                    MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                    showMenuItemText(MENU_ITEM_GAME_SEED)
                endif
            endif

            if page = MENU_PAGE_PAUSE
                if i = MENU_ITEM_RESUME
                    MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_MOVES
                    MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                    showMenuItemText(MENU_ITEM_MOVES)
                endif
            endif

            if page = MENU_PAGE_OPTIONS
                if i = MENU_ITEM_SET_FULLSCREEN
                    MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_SET_LANGUAGE
                    MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                    showMenuItemText(MENU_ITEM_SET_LANGUAGE)
                    MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_SET_MOTION
                    MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                    showMenuItemText(MENU_ITEM_SET_MOTION)
                    MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_SET_POP_SPEED
                    MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                    showMenuItemText(MENU_ITEM_SET_POP_SPEED)
                    if SURFACE_REEF
                        MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_SET_REEF
                        MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                        showMenuItemText(MENU_ITEM_SET_REEF)
                    endif
                    if SURFACE_ANCIENT
                        MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_SET_MONSTER
                        MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                        showMenuItemText(MENU_ITEM_SET_MONSTER)
                    endif
                    if DIVER_SURFACE
                        MENU_PAGE_ITEMS(MENU_PAGE_LENGTH) = MENU_ITEM_SET_PHOTOS
                        MENU_PAGE_LENGTH = MENU_PAGE_LENGTH + 1
                        showMenuItemText(MENU_ITEM_SET_PHOTOS)
                    endif
                endif
            endif
        else
            hideMenuItemText(i)
        endif
    next

    ` the list is centered on the same spot no matter how long it is
    MENU_LIST_TOP = 184 - MENU_PAGE_LENGTH * MENU_ROW_HEIGHT / 2

    panelX = (WORLD_WIDTH - MENU_WIDTH) / 2
    panelY = MENU_LIST_TOP - 8
    panelH = MENU_PAGE_LENGTH * MENU_ROW_HEIGHT + 16
    position sprite MENU_PANEL_SPRITE, panelX, panelY
    size sprite MENU_PANEL_SPRITE, MENU_WIDTH, panelH
    layoutInfoBorder(MENU_PANEL_BORDER, panelX, panelY, MENU_WIDTH, panelH)

    set text MENU_TITLE_TEXT_ID, title$
    size text y MENU_TITLE_TEXT_ID, titleSize
    if page <> MENU_PAGE_MAIN then titleShadow = 2
    enable text drop shadow MENU_TITLE_TEXT_ID, titleShadow, 0 - titleShadow, rgb(64, 128, 255)

    set text position MENU_DESC_TEXT_ID, WORLD_WIDTH / 2, panelY + panelH + 6

    set text MENU_HINT_TEXT_ID, hint$
    size text y MENU_HINT_TEXT_ID, 16
endfunction


` move the highlight to a line of the page. the cursor takes `duration` milliseconds to slide there.
` a duration of 0 puts the cursor there right away.
function selectMenuItem(index, duration)
    MENU_SELECTED = index

    rowY = MENU_LIST_TOP + index * MENU_ROW_HEIGHT - 1
    startY = tweenVal(MENU_CURSOR_TWEEN_Y)
    if duration <= 0
        ` a tween that starts where it ends is already there
        duration = 1
        startY = rowY
    else
        ` the cursor leaves some bubbles behind on the line that it was on. the main menu is above
        ` the water, where there are no bubbles, so there it leaves some sparkles.
        if MENU_MODE = MENU_MODE_MAIN
            spawnWakeSparkles((WORLD_WIDTH - MENU_WIDTH) / 2 + 6, startY + 2, MENU_WIDTH - 12, MENU_ROW_HEIGHT - 4, 6, ORDER_MENU_FLOAT_BUBBLES)
        else
            spawnWakeBubbles((WORLD_WIDTH - MENU_WIDTH) / 2 + 6, startY + 4, MENU_WIDTH - 12, MENU_ROW_HEIGHT - 8, 7, rgb(255, 255, 255), ORDER_MENU_FLOAT_BUBBLES)
        endif
    endif
    create basic tween MENU_CURSOR_TWEEN_Y, startY, rowY, duration, 0

    ` the highlighted line is white, and the lines that are not built yet are dim.
    ` the lines are put back in their places too, in case one of them was in the middle of a shake.
    for i = 0 to MENU_PAGE_LENGTH - 1
        item = MENU_ITEMS(MENU_PAGE_ITEMS(i))

        itemColor = rgb(64, 128, 255, 150)
        if item.ready then itemColor = rgb(150, 190, 255)
        if i = index then itemColor = rgb(255, 255, 255)

        ` the value of a setting is a paler shade than its name, so the two read apart
        valueColor = rgb(64, 128, 255, 150)
        if item.ready then valueColor = rgb(205, 225, 255)
        if i = index then valueColor = rgb(170, 205, 255)

        color text item.textId, itemColor
        color text item.valueTextId, valueColor

        positionMenuItemText(MENU_PAGE_ITEMS(i), 0, MENU_LIST_TOP + i * MENU_ROW_HEIGHT)
    next
    create basic tween MENU_SHAKE_TWEEN_ID, 0, 0, 1, 0

    set text MENU_DESC_TEXT_ID, MENU_ITEMS(MENU_PAGE_ITEMS(index)).desc$
endfunction


` which line of the page an item is on, counted from the top. it is 0 if the item is not on the page.
function getMenuRow(item)
    row = 0
    for i = 0 to MENU_PAGE_LENGTH - 1
        if MENU_PAGE_ITEMS(i) = item then row = i
    next
endfunction row


` a line that holds a setting is split in two: the name of the setting on the left edge of the panel,
` and what it is set to on the right edge. that keeps the names in one column and the settings in another.
function setMenuItemValue(item, label$, value$)
    set text MENU_ITEMS(item).textId, label$
    set text MENU_ITEMS(item).valueTextId, value$
    set text offset MENU_ITEMS(item).textId, 0, 0
    MENU_ITEMS(item).hasValue = 1
endfunction


` put a line of the menu at a height. shift moves it from side to side, for the shake.
function positionMenuItemText(item, shift#, y)
    if MENU_ITEMS(item).hasValue
        menuPad = 18
        set text position MENU_ITEMS(item).textId, (WORLD_WIDTH - MENU_WIDTH) / 2 + menuPad + shift#, y
        set text position MENU_ITEMS(item).valueTextId, (WORLD_WIDTH + MENU_WIDTH) / 2 - menuPad + shift#, y
    else
        set text position MENU_ITEMS(item).textId, WORLD_WIDTH / 2 + shift#, y
    endif
endfunction


function showMenuItemText(item)
    show text MENU_ITEMS(item).textId
    if MENU_ITEMS(item).hasValue
        show text MENU_ITEMS(item).valueTextId
    endif
endfunction


function hideMenuItemText(item)
    hide text MENU_ITEMS(item).textId
    hide text MENU_ITEMS(item).valueTextId
endfunction


` write the settings onto the lines of the options page.
function refreshOptionLines()
    setMenuItemValue(MENU_ITEM_SET_SOUND, loc$("menu.sound"), str$(OPTION_SOUND * 10) + "%")
    setMenuItemValue(MENU_ITEM_SET_MUSIC, loc$("menu.music"), str$(OPTION_MUSIC * 10) + "%")

    on$ = loc$("menu.value.on")
    off$ = loc$("menu.value.off")
    if OPTION_FULLSCREEN
        setMenuItemValue(MENU_ITEM_SET_FULLSCREEN, loc$("menu.fullscreen"), on$)
    else
        setMenuItemValue(MENU_ITEM_SET_FULLSCREEN, loc$("menu.fullscreen"), off$)
    endif

    ` the language is shown in itself, so a player who cannot read the one the game is in can find their own
    setMenuItemValue(MENU_ITEM_SET_LANGUAGE, loc$("menu.language"), language name$(currentLanguageIndex()))

    motionName$ = loc$("menu.motion.regular")
    if OPTION_WATER_MOTION = WATER_MOTION_LOW
        motionName$ = loc$("menu.motion.low")
    endif
    if OPTION_WATER_MOTION = WATER_MOTION_NONE
        motionName$ = loc$("menu.motion.none")
    endif
    setMenuItemValue(MENU_ITEM_SET_MOTION, loc$("menu.motion"), motionName$)

    popSpeedName$ = loc$("menu.popspeed.regular")
    if OPTION_POP_SPEED = POP_SPEED_FAST
        popSpeedName$ = loc$("menu.popspeed.fast")
    endif
    setMenuItemValue(MENU_ITEM_SET_POP_SPEED, loc$("menu.popspeed"), popSpeedName$)

    if OPTION_MENU_REEF
        setMenuItemValue(MENU_ITEM_SET_REEF, loc$("menu.reef"), on$)
    else
        setMenuItemValue(MENU_ITEM_SET_REEF, loc$("menu.reef"), off$)
    endif
    if OPTION_MENU_MONSTER
        setMenuItemValue(MENU_ITEM_SET_MONSTER, loc$("menu.monster"), on$)
    else
        setMenuItemValue(MENU_ITEM_SET_MONSTER, loc$("menu.monster"), off$)
    endif
    if OPTION_MENU_PHOTOS
        setMenuItemValue(MENU_ITEM_SET_PHOTOS, loc$("menu.photos"), on$)
    else
        setMenuItemValue(MENU_ITEM_SET_PHOTOS, loc$("menu.photos"), off$)
    endif

    ` and the kind of game onto the lines of the page that "New Game" opens
    lengthName$ = loc$("menu.length.regular")
    if OPTION_GAME_LENGTH = GAME_LENGTH_SHORT
        lengthName$ = loc$("menu.length.short")
    endif
    if OPTION_GAME_LENGTH = GAME_LENGTH_LONG
        lengthName$ = loc$("menu.length.long")
    endif
    setMenuItemValue(MENU_ITEM_GAME_LENGTH, loc$("menu.length"), lengthName$)
    MENU_ITEMS(MENU_ITEM_GAME_LENGTH).desc$ = loc$("menu.length.desc.rounds", "rounds", getGameLengthRounds(OPTION_GAME_LENGTH))

    if OPTION_GAME_ZEN
        setMenuItemValue(MENU_ITEM_GAME_MODE, loc$("menu.mode"), loc$("menu.mode.zen"))
        MENU_ITEMS(MENU_ITEM_GAME_MODE).desc$ = loc$("menu.mode.zen.desc")
    else
        setMenuItemValue(MENU_ITEM_GAME_MODE, loc$("menu.mode"), loc$("menu.mode.normal"))
        MENU_ITEMS(MENU_ITEM_GAME_MODE).desc$ = loc$("menu.mode.normal.desc")
    endif

    if OPTION_GAME_INTRO
        setMenuItemValue(MENU_ITEM_GAME_INTRO, loc$("menu.intro"), loc$("menu.value.yes"))
        MENU_ITEMS(MENU_ITEM_GAME_INTRO).desc$ = loc$("menu.intro.yes.desc")
    else
        setMenuItemValue(MENU_ITEM_GAME_INTRO, loc$("menu.intro"), loc$("menu.value.no"))
        MENU_ITEMS(MENU_ITEM_GAME_INTRO).desc$ = loc$("menu.intro.no.desc")
    endif

    ` and the seed. see THE SEED OF A GAME in fish_headers_seed.
    if OPTION_GAME_SEED > 0
        setMenuItemValue(MENU_ITEM_GAME_SEED, loc$("menu.seed"), str$(OPTION_GAME_SEED))
        MENU_ITEMS(MENU_ITEM_GAME_SEED).desc$ = loc$("menu.seed.set.desc")
    else
        setMenuItemValue(MENU_ITEM_GAME_SEED, loc$("menu.seed"), loc$("menu.seed.random"))
        MENU_ITEMS(MENU_ITEM_GAME_SEED).desc$ = loc$("menu.seed.random.desc")
    endif
endfunction


` THE LANGUAGE. see OPTION_LANGUAGE in fish_headers.

` set the language of the game: the one the player picked, or else the one Steam has for the game,
` or else the computer's. best language$ picks from the languages the string tables have.
function applyLanguage()
    langPicked$ = ""
    if OPTION_LANGUAGE > 0
        langPicked$ = language code$(OPTION_LANGUAGE - 1)
    endif
    if langPicked$ = ""
        langPicked$ = best language$(steam language$())
    endif
    set language langPicked$
endfunction


` which of the languages of the tables the game is in now, counted from 0
function currentLanguageIndex()
    langIndex = 0
    for langI = 0 to language count() - 1
        if language code$(langI) = language$()
            langIndex = langI
        endif
    next
endfunction langIndex


` the names and descriptions of the lines of the menu, in the language of the game. the ones that
` depend on a setting or on the page are written over by refreshOptionLines and setMenuPage.
