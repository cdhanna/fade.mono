` after the language changed: every line, title and hint of the menu again, in the new language
function reloadMenuStrings()
    loadMenuStrings()
    ` the cards keep their text resolved (see loadCardStrings), and the quest badge its name
    loadCardStrings()
    questLanguageChanged()
    for langI = 0 to MENU_ITEM_COUNT - 1
        set text MENU_ITEMS(langI).textId, MENU_ITEMS(langI).name$
    next
    ` the lines with a setting get their values first, because setMenuPage only shows the value of a
    ` line that has one already (the same as opening the options page does)
    refreshOptionLines()
    setMenuPage(MENU_PAGE)
    refreshOptionLines()
    ` and selecting the highlighted line again writes its description
    selectMenuItem(MENU_SELECTED, 0)
endfunction


` change one of the settings on the options page, and do whatever the setting is for.
` change is 1 for the next choice, and -1 for the one before.
function changeMenuOption(item, change)
    select item
        case MENU_ITEM_SET_SOUND
            OPTION_SOUND = OPTION_SOUND + change
            if OPTION_SOUND > 10 then OPTION_SOUND = 10
            if OPTION_SOUND < 0 then OPTION_SOUND = 0

            ` every sound that is not music is in this group, so this turns all of them up or down
            set sfx group volume SFX_GROUP_SFX, OPTION_SOUND * .1
        endcase

        case MENU_ITEM_SET_MUSIC
            OPTION_MUSIC = OPTION_MUSIC + change
            if OPTION_MUSIC > 10 then OPTION_MUSIC = 10
            if OPTION_MUSIC < 0 then OPTION_MUSIC = 0
            applyMusicVolume()
        endcase

        case MENU_ITEM_SET_FULLSCREEN
            OPTION_FULLSCREEN = 1 - OPTION_FULLSCREEN

            ` the player may have dragged the window to some size of their own, so remember it on the way in
            if OPTION_FULLSCREEN
                OPTION_WINDOW_W = screen width()
                OPTION_WINDOW_H = screen height()
            endif

            set fullscreen OPTION_FULLSCREEN

            ` leaving fullscreen leaves the window as big as the monitor, so it is put back to the size it was
            if OPTION_FULLSCREEN = 0
                set screen size OPTION_WINDOW_W, OPTION_WINDOW_H
            endif
        endcase

        ` the languages go around, in the order of the columns of the string tables. every line of the
        ` menu is written again in the new one, straight away.
        case MENU_ITEM_SET_LANGUAGE
            langNext = currentLanguageIndex()
            langNext = langNext + change
            if langNext >= language count() then langNext = 0
            if langNext < 0 then langNext = language count() - 1
            OPTION_LANGUAGE = langNext + 1
            set language language code$(langNext)
            reloadMenuStrings()
        endcase

        ` regular, low, none, and back to regular. the water changes straight away, behind the menu.
        case MENU_ITEM_SET_MOTION
            OPTION_WATER_MOTION = OPTION_WATER_MOTION + change
            if OPTION_WATER_MOTION > WATER_MOTION_NONE then OPTION_WATER_MOTION = WATER_MOTION_REGULAR
            if OPTION_WATER_MOTION < WATER_MOTION_REGULAR then OPTION_WATER_MOTION = WATER_MOTION_NONE
            applyWaterMotion()
        endcase

        ` regular or fast. see THE BIG MOMENTS in fish_headers_teach.
        case MENU_ITEM_SET_POP_SPEED
            OPTION_POP_SPEED = 1 - OPTION_POP_SPEED
        endcase

        ` the main menu looks at these on every frame, so there is nothing else to do
        case MENU_ITEM_SET_REEF
            OPTION_MENU_REEF = 1 - OPTION_MENU_REEF
        endcase
        case MENU_ITEM_SET_MONSTER
            OPTION_MENU_MONSTER = 1 - OPTION_MENU_MONSTER
        endcase
        case MENU_ITEM_SET_PHOTOS
            OPTION_MENU_PHOTOS = 1 - OPTION_MENU_PHOTOS
        endcase

        ` the lengths go around: short, regular, long, and back to short
        case MENU_ITEM_GAME_LENGTH
            OPTION_GAME_LENGTH = OPTION_GAME_LENGTH + change
            if OPTION_GAME_LENGTH > GAME_LENGTH_LONG then OPTION_GAME_LENGTH = GAME_LENGTH_SHORT
            if OPTION_GAME_LENGTH < GAME_LENGTH_SHORT then OPTION_GAME_LENGTH = GAME_LENGTH_LONG
        endcase

        case MENU_ITEM_GAME_MODE
            OPTION_GAME_ZEN = 1 - OPTION_GAME_ZEN
        endcase

        ` this one is not remembered. see OPTION_GAME_INTRO in fish_headers.
        case MENU_ITEM_GAME_INTRO
            OPTION_GAME_INTRO = 1 - OPTION_GAME_INTRO
        endcase

        ` left takes the seed away again. it is entered on a page of its own, which the confirm button opens.
        case MENU_ITEM_GAME_SEED
            if change < 0 then OPTION_GAME_SEED = 0
        endcase
    endselect

    ` remember the options for the next time the game is run. only the one that changed gets written.
    set pref PREF_GAME_LENGTH, OPTION_GAME_LENGTH
    set pref PREF_GAME_ZEN, OPTION_GAME_ZEN
    set pref PREF_SOUND, OPTION_SOUND
    set pref PREF_MUSIC, OPTION_MUSIC
    set pref PREF_FULLSCREEN, OPTION_FULLSCREEN
    set pref PREF_MENU_REEF, OPTION_MENU_REEF
    set pref PREF_MENU_MONSTER, OPTION_MENU_MONSTER
    set pref PREF_MENU_PHOTOS, OPTION_MENU_PHOTOS
    set pref PREF_LANGUAGE, OPTION_LANGUAGE
    set pref PREF_WATER_MOTION, OPTION_WATER_MOTION
    set pref PREF_POP_SPEED, OPTION_POP_SPEED

    ` the lines have changed, so write them again. selecting the line again colors it and fills in its description.
    refreshOptionLines()
    selectMenuItem(MENU_SELECTED, 0)
endfunction


` tell the screen effect how much the water moves. see THE WATER MOTION in fish_headers.
function applyWaterMotion()
    motionWobble# = 1
    motionRings# = 1
    motionDim# = WATER_HINT_DIM#
    if OPTION_WATER_MOTION = WATER_MOTION_LOW
        motionWobble# = WATER_WOBBLE_LOW#
        motionRings# = WATER_RINGS_LOW#
        motionDim# = WATER_HINT_DIM_CALMER#
    endif
    if OPTION_WATER_MOTION = WATER_MOTION_NONE
        motionWobble# = 0
        motionRings# = WATER_RINGS_NONE#
        motionDim# = WATER_HINT_DIM_CALMER#
    endif
    set effect param float4 1, "Motion", motionWobble#, motionRings#, motionDim#, 0
endfunction


` an info border that is drawn into the menu, instead of onto the screen
function createMenuBorder(drawOrder)
    b as infoBorder = createInfoBorder(drawOrder)
    set sprite render target b.topId, TARGET_MENU
    set sprite render target b.bottomId, TARGET_MENU
    set sprite render target b.leftId, TARGET_MENU
    set sprite render target b.rightId, TARGET_MENU
    showInfoBorder(b, 1)
endfunction b
