goto routines_codec_exit

remstart
    THE CODEC
    the codec is a page of the main menu, and of the pause menu, that shows every upgrade there is to come across in the game.
    each one is a tile in a grid, and the tile that is highlighted is explained underneath the grid.

    an upgrade is locked until it has been seen in a game. a locked tile is a lock, and it does not
    say what it is. an upgrade is seen when it is one of the cards that the upgrade screen offers,
    whether or not it gets picked. what has been seen is kept in the preferences, so it stays
    unlocked for good.

    the entries are the cards, in the order of CARDS. entry n is card n. after the cards come the
    entries that are not cards: coral, and horror coral. those are not on the upgrade screen. they are
    seen when some of it grows on the board. see CODEC_ENTRY_CORAL in fish_headers. then the two
    endings, and then the special fish (jellyfish, stingray, bottle) and what can happen to a fish
    (belly up, skeletal, stacked, heart home), which are seen when one is on the board. and last, the
    QR code that the fish make when SOS is typed, or tapped out in Morse code, which is seen when they make one. see TUNA in fish_headers.
    and after that, the crooked bar, which is seen when a line of fish pays out. see DIAGONALS in fish_headers.
    and the diver, and its ending. and the radio, which is seen when it first comes on, and the
    signals SING and SONG, which share an entry, and CTHULHU, each of which is seen when it is sent. see MORSE in fish_headers.
    and the night, and then the words that bring somebody swimming through, each of which is seen
    when it is sent, too. see CAMEOS in fish_headers_cameo.
    and after that, every quest, which is seen when it is the quest of a round, and has a check mark
    once it has been finished in any game. see THE QUESTS IN THE CODEC in fish_headers_quests.

    the entries are sorted into categories: upgrades, fish, secrets, signals, endings and quests. the
    categories are listed down the left of the panel, and the grid only has the entries of the one
    that the highlighted entry is in. the number of an entry is still what is written above, because
    that is how it is remembered. see THE CATEGORIES OF THE CODEC in fish_headers.

    there can be more entries in a category than fit in the grid, so the grid has pages. a page is
    CODEC_PAGE_SIZE tiles, and there are only that many tile sprites: they are given the pictures of
    whichever page is showing. the page that is showing is the one that the highlighted entry is on.
    the pages are one under the other: going off of the bottom of the grid turns to the next page,
    and off of the last page goes to the next category, and the arrows at the right of the grid say
    whether there is a page above, or below. going left, off of the grid, goes onto the list of the
    categories, where up and down go from one to the next. see codecGo.

    the rest of the game only has to call codecSeeCard() when a card is seen.

    all of this is drawn into the menu's render target, in place of the list of the menu, the same
    way that the high scores are.
remend


` setup_menu comes here, because all of this is drawn with the menu.
setup_codec:
    CODEC_ENTRY_CORAL = CARD_LENGTH
    CODEC_ENTRY_HORROR = CARD_LENGTH + 1
    CODEC_ENTRY_REEF = CARD_LENGTH + 2
    CODEC_ENTRY_ANCIENT = CARD_LENGTH + 3
    CODEC_ENTRY_JELLY = CARD_LENGTH + 4
    CODEC_ENTRY_RAY = CARD_LENGTH + 5
    CODEC_ENTRY_BOTTLE = CARD_LENGTH + 6
    CODEC_ENTRY_BELLY = CARD_LENGTH + 7
    CODEC_ENTRY_SKELETON = CARD_LENGTH + 8
    CODEC_ENTRY_STACK = CARD_LENGTH + 9
    CODEC_ENTRY_HOME = CARD_LENGTH + 10
    CODEC_ENTRY_TUNA = CARD_LENGTH + 11
    CODEC_ENTRY_CROOKED = CARD_LENGTH + 12
    CODEC_ENTRY_DIVER = CARD_LENGTH + 13
    CODEC_ENTRY_ALBUM = CARD_LENGTH + 14
    CODEC_ENTRY_RADIO = CARD_LENGTH + 15
    CODEC_ENTRY_SING = CARD_LENGTH + 16
    CODEC_ENTRY_CTHULHU = CARD_LENGTH + 17
    CODEC_ENTRY_NIGHT = CARD_LENGTH + 18
    CODEC_ENTRY_RAINBOW = CARD_LENGTH + CODEC_EXTRA_FISH
    CODEC_ENTRY_SCHOOL = CARD_LENGTH + CODEC_EXTRA_FISH + 1
    CODEC_ENTRY_SQUID = CARD_LENGTH + CODEC_EXTRA_FISH + 2 `see THE SQUID in fish_headers_squid
    CODEC_ENTRY_STARS = CARD_LENGTH + CODEC_EXTRA_FISH + 3 `THE CONSTELLATIONS, there too
    CODEC_ENTRY_FAVOR = CARD_LENGTH + CODEC_EXTRA_FISH + 4 `and the ending that they bring. see fish_headers_neptune.
    CODEC_ENTRY_CLEAN = CARD_LENGTH + CODEC_EXTRA_FISH + 5 `the ink of the day. see CLEAN in fish_headers_squid.
    CODEC_ENTRY_CAMEO = CARD_LENGTH + CODEC_EXTRA_PLAIN

    ` and the usual ending is the last of the entries that are not cards, after the last of the words
    CODEC_ENTRY_GOODBYE = CARD_LENGTH + CODEC_EXTRA_COUNT
    CODEC_ENTRY_GOODBYE = CODEC_ENTRY_GOODBYE - 1

    ` the call of the angler is right before it. see THE CALL in fish_headers_angler.
    CODEC_ENTRY_CALL = CODEC_ENTRY_GOODBYE - 1

    ` and then every quest. see THE QUESTS IN THE CODEC in fish_headers_quests.
    CODEC_ENTRY_QUEST = CARD_LENGTH + CODEC_EXTRA_COUNT
    CODEC_COUNT = CARD_LENGTH + CODEC_EXTRA_COUNT + QUEST_COUNT
    for codecI = 1 to QUEST_COUNT
        QUEST_EVER_DONE(codecI) = get pref(QUEST_PREF_DONE + codecI, 0)
    next

    ` the categories, in the order of the list, and what is in each. every entry is in one of them.
    CODEC_CAT_COUNT = 0
    CODEC_ORDER_COUNT = 0
    codecStartCategory(lockey$("codec.cat.upgrades"))
    codecFile(0, CARD_LENGTH)
    codecStartCategory(lockey$("codec.cat.fish"))
    codecFile(CODEC_ENTRY_JELLY, 7)
    codecFile(CODEC_ENTRY_RAINBOW, 3) `rainbow fish, schooling fish and the squid
    codecStartCategory(lockey$("codec.cat.secrets"))
    codecFile(CODEC_ENTRY_CORAL, 2)
    codecFile(CODEC_ENTRY_TUNA, 3)
    codecFile(CODEC_ENTRY_RADIO, 1)
    codecFile(CODEC_ENTRY_NIGHT, 1)
    codecFile(CODEC_ENTRY_STARS, 1)
    codecFile(CODEC_ENTRY_CLEAN, 1)
    codecStartCategory(lockey$("codec.cat.signals"))
    codecFile(CODEC_ENTRY_SING, 2)
    codecFile(CODEC_ENTRY_CAMEO, CODEC_ENTRY_GOODBYE - CODEC_ENTRY_CAMEO)
    codecStartCategory(lockey$("codec.cat.endings"))
    codecFile(CODEC_ENTRY_GOODBYE, 1)
    codecFile(CODEC_ENTRY_REEF, 2)
    codecFile(CODEC_ENTRY_ALBUM, 1)
    codecFile(CODEC_ENTRY_FAVOR, 1)
    codecStartCategory(lockey$("codec.cat.quests"))
    codecFile(CODEC_ENTRY_QUEST, QUEST_COUNT)

    ` what has been seen, in every game that has ever been played
    for codecI = 0 to CODEC_COUNT - 1
        CODEC_SEEN(codecI) = get pref(getCodecPref(codecI), 0)
    next

    ` these are whole ifs, not one-line ones: a one-line `if ... then codecSeeCard(...)` took the statement
    ` after it as part of itself, so each of them only ran when the one before it was true, and the house
    ` of the ending where the fish go home was only loaded once the diver's ending had been reached.

    ` SONG had an entry of its own once, which SING has now. whoever found that one has found this one.
    if get pref(CODEC_PREF_MORE + 7, 0)
        codecSeeCard(CODEC_ENTRY_SING)
    endif

    ` an ending that was reached before the codec had an entry for it counts, too
    if get pref(PREF_ENDING_REEF, 0)
        codecSeeCard(CODEC_ENTRY_REEF)
    endif
    if get pref(PREF_ENDING_ANCIENT, 0)
        codecSeeCard(CODEC_ENTRY_ANCIENT)
    endif
    if get pref(PREF_ENDING_DIVER, 0)
        codecSeeCard(CODEC_ENTRY_ALBUM)
    endif
    if get pref(PREF_ENDING_NEPTUNE, 0)
        codecSeeCard(CODEC_ENTRY_FAVOR)
    endif

    texture reserve texture id(TEX_ENDING_GOODBYE), "Fish/Textures/ending_home"

    texture reserve texture id(TEX_ENDING_REEF), "Fish/Textures/ending_reef"
    texture reserve texture id(TEX_ENDING_ANCIENT), "Fish/Textures/ending_ancient"
    texture reserve texture id(TEX_ENDING_ALBUM), "Fish/Textures/ending_album"
    texture reserve texture id(TEX_CODEC_DIVER), "Fish/Textures/codec_diver"
    texture reserve texture id(TEX_CROOKED), "Fish/Textures/Cards/crooked_bar"
    texture reserve texture id(TEX_CODEC_RADIO), "Fish/Textures/Cards/radio"
    texture reserve texture id(TEX_CODEC_NIGHT), "Fish/Textures/Cards/night_dive"
    texture reserve texture id(TEX_CODEC_SCHOOL), "Fish/Textures/Anchovy"

    ` what a locked entry has for a picture is a question mark, and not a lock, whatever the names say
    texture reserve texture id(TEX_LOCK), "Fish/Textures/Cards/question"

    ` the tiles of one page. each one is the art of a card, with a lock to go on top of it while it is
    ` locked. refreshCodec gives them the pictures of the page that is showing.
    ` the art is 48 pixels across, and is drawn at half of that.
    for codecI = 0 to CODEC_PAGE_SIZE - 1
        codecX = getCodecTileX(codecI)
        codecY = getCodecTileY(codecI)

        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, codecX, codecY, TEX_LOCK
        set sprite offset codecSprite, .5, .5
        size sprite codecSprite, 24, 24
        order sprite codecSprite, ORDER_MENU_TEXT
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_ICON_SPRITES(codecI) = codecSprite

        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, codecX, codecY, TEX_LOCK
        set sprite offset codecSprite, .5, .5
        size sprite codecSprite, 16, 16
        color sprite codecSprite, rgb(120, 140, 185)
        order sprite codecSprite, ORDER_MENU_TEXT + 1
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_LOCK_SPRITES(codecI) = codecSprite
    next

    ` the check mark of a quest that has been finished, on the corner of its tile, and one more by the
    ` big picture. refreshCodec shows the ones that are wanted.
    for codecI = 0 to CODEC_PAGE_SIZE
        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, getCodecTileX(codecI) + 11, getCodecTileY(codecI) + 11, TEX_Q_CHECK
        set sprite offset codecSprite, .5, .5
        size sprite codecSprite, 14, 14
        color sprite codecSprite, rgb(140, 235, 150)
        order sprite codecSprite, ORDER_MENU_TEXT + 2
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_CHECK_SPRITES(codecI) = codecSprite
    next
    position sprite CODEC_CHECK_SPRITES(CODEC_PAGE_SIZE), CODEC_X + 66, CODEC_DETAIL_TOP + 60
    size sprite CODEC_CHECK_SPRITES(CODEC_PAGE_SIZE), 21, 21

    ` the fish behind the fish in the picture of "stacked". refreshCodec puts them where they go.
    for codecI = 0 to 1
        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, 0, 0, TEX_LOCK
        set sprite offset codecSprite, .5, .5
        order sprite codecSprite, ORDER_MENU_TEXT - 1
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_STACK_SPRITES(codecI) = codecSprite
    next

    ` the heart over the fish in the picture of "heart home". refreshCodec puts them where they go.
    for codecI = 0 to 1
        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, 0, 0, TEX_ENDING_REEF
        set sprite offset codecSprite, .5, .5
        color sprite codecSprite, rgb(255, 125, 155)
        order sprite codecSprite, ORDER_MENU_TEXT + 1
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_HEART_SPRITES(codecI) = codecSprite
    next

    ` the arrows at the right of the grid, one that points up and one that points down, which say
    ` that there is a page above, or one below. they are "<" and ">", turned a quarter of the way
    ` around. and the page number on the corner of the panel.
    CODEC_ARROW_TEXTS(0) = createHighscoreText(CODEC_X + CODEC_WIDTH - 16, getCodecTileY(0), 40, "<")
    CODEC_ARROW_TEXTS(1) = createHighscoreText(CODEC_X + CODEC_WIDTH - 16, getCodecTileY(CODEC_PAGE_SIZE - 1), 40, ">")
    for codecI = 0 to 1
        set text offset CODEC_ARROW_TEXTS(codecI), .5, .5
        rotate text CODEC_ARROW_TEXTS(codecI), 1.5708
    next
    CODEC_PAGE_TEXT_ID = createHighscoreText(CODEC_X + CODEC_WIDTH - 8, CODEC_TOP - 20, 16, "page 1 of 1")
    set text offset CODEC_PAGE_TEXT_ID, 1, 0
    color text CODEC_PAGE_TEXT_ID, rgb(64, 128, 255)

    ` the page number is above the panel, where there is only the main menu behind it, so it has a
    ` piece of the panel of its own to be written on. refreshCodec makes it as wide as the words are.
    reserve sprite id(CODEC_PAGE_BACK_SPRITE)
    sprite CODEC_PAGE_BACK_SPRITE, 0, 0, TEX_PIXEL
    set sprite offset CODEC_PAGE_BACK_SPRITE, 0, 0
    color sprite CODEC_PAGE_BACK_SPRITE, rgb(10, 14, 30, 235)
    order sprite CODEC_PAGE_BACK_SPRITE, ORDER_MENU_PANEL
    set sprite render target CODEC_PAGE_BACK_SPRITE, TARGET_MENU
    hide sprite CODEC_PAGE_BACK_SPRITE

    ` the list of the categories, down the left of the panel, with a bar behind the one that the
    ` highlighted entry is in, and a line between the list and the grid
    for codecI = 0 to CODEC_CAT_COUNT - 1
        CODEC_CAT_TEXTS(codecI) = createHighscoreText(CODEC_X + 12, CODEC_TOP + 5 + codecI * 14, 16, loc$(CODEC_CAT_NAME$(codecI)))
        set text offset CODEC_CAT_TEXTS(codecI), 0, 0
    next

    reserve sprite id(CODEC_CAT_BAR_SPRITE)
    sprite CODEC_CAT_BAR_SPRITE, CODEC_X + 5, CODEC_TOP + 6, TEX_PIXEL
    set sprite offset CODEC_CAT_BAR_SPRITE, 0, 0
    size sprite CODEC_CAT_BAR_SPRITE, CODEC_SIDE - 10, 14
    color sprite CODEC_CAT_BAR_SPRITE, rgb(64, 128, 255, 90)
    order sprite CODEC_CAT_BAR_SPRITE, ORDER_MENU_PANEL + 1
    set sprite render target CODEC_CAT_BAR_SPRITE, TARGET_MENU
    hide sprite CODEC_CAT_BAR_SPRITE

    codecSideHigh = CODEC_DETAIL_TOP - CODEC_TOP
    codecSideHigh = codecSideHigh - 20
    reserve sprite id(CODEC_SIDE_SPRITE)
    sprite CODEC_SIDE_SPRITE, CODEC_X + CODEC_SIDE, CODEC_TOP + 8, TEX_PIXEL
    set sprite offset CODEC_SIDE_SPRITE, 0, 0
    size sprite CODEC_SIDE_SPRITE, 1, codecSideHigh
    color sprite CODEC_SIDE_SPRITE, rgb(64, 128, 255, 120)
    order sprite CODEC_SIDE_SPRITE, ORDER_MENU_PANEL + 1
    set sprite render target CODEC_SIDE_SPRITE, TARGET_MENU
    hide sprite CODEC_SIDE_SPRITE

    ` how many upgrades have been found, under the title
    CODEC_COUNT_TEXT_ID = createHighscoreText(WORLD_WIDTH / 2, CODEC_TOP - 20, 16, "0 of 0 found")
    color text CODEC_COUNT_TEXT_ID, rgb(150, 190, 255)

    ` a line across the panel, between the grid and what explains the highlighted tile
    reserve sprite id(CODEC_DIVIDER_SPRITE)
    sprite CODEC_DIVIDER_SPRITE, CODEC_X + 8, CODEC_DETAIL_TOP - 6, TEX_PIXEL
    set sprite offset CODEC_DIVIDER_SPRITE, 0, 0
    size sprite CODEC_DIVIDER_SPRITE, CODEC_WIDTH - 16, 1
    color sprite CODEC_DIVIDER_SPRITE, rgb(64, 128, 255, 120)
    order sprite CODEC_DIVIDER_SPRITE, ORDER_MENU_PANEL + 1
    set sprite render target CODEC_DIVIDER_SPRITE, TARGET_MENU
    hide sprite CODEC_DIVIDER_SPRITE

    ` the highlighted tile, explained: a big picture of it, its name, what kind of upgrade it is, and what it does
    reserve sprite id(CODEC_BIG_SPRITE)
    sprite CODEC_BIG_SPRITE, CODEC_X + 44, CODEC_DETAIL_TOP + 40, TEX_LOCK
    set sprite offset CODEC_BIG_SPRITE, .5, .5
    size sprite CODEC_BIG_SPRITE, 48, 48
    order sprite CODEC_BIG_SPRITE, ORDER_MENU_TEXT
    set sprite render target CODEC_BIG_SPRITE, TARGET_MENU
    hide sprite CODEC_BIG_SPRITE

    CODEC_NAME_TEXT_ID = createHighscoreText(CODEC_X + 86, CODEC_DETAIL_TOP, 24, "name")
    set text offset CODEC_NAME_TEXT_ID, 0, 0

    CODEC_KIND_TEXT_ID = createHighscoreText(CODEC_X + 86, CODEC_DETAIL_TOP + 25, 16, "kind")
    set text offset CODEC_KIND_TEXT_ID, 0, 0
    enable rich text CODEC_KIND_TEXT_ID
    color text CODEC_KIND_TEXT_ID, rgb(64, 128, 255)

    ` there is room for three lines of this, and no more. the tests check every entry: see codec_texts_fit_in_their_slot.
    CODEC_DESC_TEXT_ID = createHighscoreText(CODEC_X + 86, CODEC_DETAIL_TOP + 43, 16, "desc")
    set text offset CODEC_DESC_TEXT_ID, 0, 0
    set text wrap CODEC_DESC_TEXT_ID, CODEC_WIDTH - 100
    color text CODEC_DESC_TEXT_ID, rgb(150, 190, 255)

    CODEC_CURSOR = createMenuBorder(ORDER_MENU_CURSOR)
    showInfoBorder(CODEC_CURSOR, 0)
return


` "Codec" on the main menu, or on the pause menu. show the codec, in place of the menu, until the player backs out.
menu_run_codec:
    CODEC_ON_LIST = 0
    codecGoToNew() `straight to what is new. see NEW IN THE CODEC in fish_headers_teach.
    openCodec()
    refreshCodec()
    mouseBackOn(TARGET_MENU, ORDER_MENU_TEXT) `see THE BACK BUTTON in fish_headers_mouse

    do
        gosub frame_codec
        sync

        ` these are checked after the frame, so that the press that picked "Codec" is not the press that leaves
        if new action down(ACT_CONFIRM) then exit
        if new action down(ACT_PAUSE) then exit
        codecBackClicked = mouseBackStep()
        if codecBackClicked then exit

        ` see codecGo for where each direction goes. a press that goes nowhere makes no sound.
        codecGoX = 0
        codecGoY = 0
        if new action down(ACT_RIGHT) then codecGoX = 1
        if new action down(ACT_LEFT) then codecGoX = -1
        if new action down(ACT_DOWN) then codecGoY = 1
        if new action down(ACT_UP) then codecGoY = -1
        codecWas = CODEC_SELECTED
        codecWasOnList = CODEC_ON_LIST
        if codecGoX <> 0 or codecGoY <> 0
            codecGo(codecGoX, codecGoY)
        endif
        codecMouse()
        codecMoved = 0
        if CODEC_SELECTED <> codecWas then codecMoved = 1
        if CODEC_ON_LIST <> codecWasOnList then codecMoved = 1

        if codecMoved
            refreshCodec()

            ` the same swell of sound that the highlight of the menu makes when it moves
            create basic tween SWAP_TWEEN_SFX, 0, 1, 150, 0
            set tween type SWAP_TWEEN_SFX, 1
        endif
    loop

    mouseBackOff()

    ` back to whichever menu the codec was opened from, with "Codec" highlighted again
    closeCodec()
    if MENU_MODE = MENU_MODE_PAUSE
        setMenuPage(MENU_PAGE_PAUSE)
    else
        setMenuPage(MENU_PAGE_MAIN)
    endif
    selectMenuItem(getMenuRow(MENU_ITEM_CODEC), 0)

    ` it was opened from info mode, so it goes straight back to the game. see NEW IN THE CODEC in fish_headers_teach.
    if CODEC_FROM_INFO
        CODEC_FROM_INFO = 0
        gosub menu_close_pause
    endif
return


` everything on the codec that changes from frame to frame
frame_codec:
    codecPulse# = .8 + .2 * sin(game ms() * .006)
    colorInfoBorder(CODEC_CURSOR, rgb(255, 255, 255, 255 * codecPulse#))
    codecNewDots() `see NEW IN THE CODEC in fish_headers_teach
    codecRainbowTint()

    gosub frame_menu_render
return


routines_codec_exit:


` a card has been seen in a game, so it is unlocked in the codec from now on. it was offered on the
` upgrade screen, or it was given to the player. this unlocks the entries that are not cards, too.
function codecSeeCard(cardIndex)
    ` what a demo shows was not seen by the player. see THE DEMO in fish_headers_demo.
    if DEMO_MODE then exitfunction
    if cardIndex >= 0 and cardIndex < CODEC_COUNT
        if CODEC_SEEN(cardIndex) = 0
            CODEC_SEEN(cardIndex) = 1
            set pref getCodecPref(cardIndex), 1
            ` and it is new, until it has been looked at. see NEW IN THE CODEC in fish_headers_teach.
            codecMarkNew(cardIndex)
        endif
    endif
endfunction


` where the preferences keep whether an entry has been seen. the cards have a run of them, and the first
` few of the entries that are not cards have another. the ones after those have a third, because the
` second one ran out of room.
function getCodecPref(prefEntry)
    prefSlot = CODEC_PREF + prefEntry

    ` there was room for 32 cards there. the ones after that are kept in a run of their own.
    if prefEntry >= CODEC_PREF_CARD_ROOM
        prefSlot = CODEC_PREF_LATE + (prefEntry - CODEC_PREF_CARD_ROOM)
    endif
    if prefEntry >= CARD_LENGTH
        prefExtra = prefEntry - CARD_LENGTH
        prefSlot = CODEC_PREF_EXTRA + prefExtra
        if prefExtra >= CODEC_PREF_EXTRA_ROOM
            prefSlot = CODEC_PREF_MORE + (prefExtra - CODEC_PREF_EXTRA_ROOM)

            ` SONG had an entry of its own once, right after SING. the ones that came after it are
            ` still remembered where they were, one further along.
            if prefEntry > CODEC_ENTRY_SING then prefSlot = prefSlot + 1
        endif

        ` rainbow fish and schooling fish came later, and have a run of their own
        if prefExtra >= CODEC_EXTRA_FISH
            prefSlot = CODEC_PREF_FISH + (prefExtra - CODEC_EXTRA_FISH)
        endif

        ` and that one ran out too. the words that bring somebody swimming through have a third.
        if prefExtra >= CODEC_EXTRA_PLAIN
            prefSlot = CODEC_PREF_CAMEO + (prefExtra - CODEC_EXTRA_PLAIN)
        endif

        ` the quests have a run of their own, by the number of the quest
        if prefExtra >= CODEC_EXTRA_COUNT
            prefSlot = QUEST_PREF_SEEN + 1 + (prefExtra - CODEC_EXTRA_COUNT)
        endif

        ` the usual ending moves along when there is a new word, so it is kept in a place of its own
        if prefEntry = CODEC_ENTRY_GOODBYE then prefSlot = PREF_ENDING_HOME
    endif
endfunction prefSlot


` which quest an entry of the codec is, or 0 for an entry that is not a quest
function getCodecQuest(questEntry)
    codecQuest = 0
    if CODEC_ENTRY_QUEST >= 0
        if questEntry >= CODEC_ENTRY_QUEST then codecQuest = questEntry + 1 - CODEC_ENTRY_QUEST
    endif
endfunction codecQuest


` the board has settled. whatever is on it that the codec has an entry for is unlocked: the special
` fish, and what can happen to a fish. handle_combos calls this.
function codecSeeBoard()
    for seeI = 0 to CELL_COUNT - 1
        seeKind = CELLS(seeI).value
        seeEntry = -1
        if seeKind = TEX_JELLY then seeEntry = CODEC_ENTRY_JELLY
        if seeKind = TEX_RAY then seeEntry = CODEC_ENTRY_RAY
        if seeKind = TEX_BOTTLE then seeEntry = CODEC_ENTRY_BOTTLE
        codecSeeCard(seeEntry)

        seeEntry = -1
        if CELLS(seeI).bellyUp = 1 then seeEntry = CODEC_ENTRY_BELLY
        if CELLS(seeI).bellyUp = 2 then seeEntry = CODEC_ENTRY_SKELETON
        codecSeeCard(seeEntry)

        seeEntry = -1
        if CELLS(seeI).stack > 0 then seeEntry = CODEC_ENTRY_STACK
        codecSeeCard(seeEntry)

        ` a rainbow fish. see fish_headers_rainbow.
        seeEntry = -1
        if RAINBOW_FISH(seeI)
            if seeKind > 0 then seeEntry = CODEC_ENTRY_RAINBOW
        endif
        codecSeeCard(seeEntry)

        ` the squid, at night. see fish_headers_squid.
        if SQUID_CELL = seeI
            codecSeeCard(CODEC_ENTRY_SQUID)
        endif

        ` a fish that is sitting on coral that is well
        seeEntry = -1
        if CORAL_CELLS(seeI) > CORAL_SICK(seeI)
            if seeKind > 0 then seeEntry = CODEC_ENTRY_HOME
        endif
        codecSeeCard(seeEntry)
    next
endfunction


` the picture of an entry. a card has its art. coral and horror coral have the badges that the table
` of high scores gives to the two endings, which are 16 pixels across, where the art of a card is 48.
` the two endings have a heart and an eye, which are 16 pixels across as well.
function getCodecEntryTex(entryIndex)
    entryTex = TEX_BADGE_CORAL
    if entryIndex = CODEC_ENTRY_HORROR then entryTex = TEX_BADGE_TENTACLE
    if entryIndex = CODEC_ENTRY_REEF then entryTex = TEX_ENDING_REEF
    if entryIndex = CODEC_ENTRY_ANCIENT then entryTex = TEX_ENDING_ANCIENT

    ` the special fish are their own pictures. the goldfish stands in for any fish that something has happened to.
    if entryIndex = CODEC_ENTRY_JELLY then entryTex = TEX_JELLY
    if entryIndex = CODEC_ENTRY_RAY then entryTex = TEX_RAY
    if entryIndex = CODEC_ENTRY_BOTTLE then entryTex = TEX_BOTTLE
    if entryIndex = CODEC_ENTRY_BELLY then entryTex = CODEC_FISH_TEX
    if entryIndex = CODEC_ENTRY_SKELETON then entryTex = SKELETON_TEX(CODEC_FISH_TEX)
    if entryIndex = CODEC_ENTRY_STACK then entryTex = CODEC_FISH_TEX
    if entryIndex = CODEC_ENTRY_HOME then entryTex = CODEC_FISH_TEX
    if entryIndex = CODEC_ENTRY_TUNA then entryTex = CODEC_TUNA_TEX
    if entryIndex = CODEC_ENTRY_CROOKED then entryTex = TEX_CROOKED
    if entryIndex = CODEC_ENTRY_DIVER then entryTex = TEX_CODEC_DIVER
    if entryIndex = CODEC_ENTRY_ALBUM then entryTex = TEX_ENDING_ALBUM
    if entryIndex = CODEC_ENTRY_RADIO then entryTex = TEX_CODEC_RADIO
    if entryIndex = CODEC_ENTRY_SING then entryTex = TEX_CODEC_RADIO
    if entryIndex = CODEC_ENTRY_CTHULHU then entryTex = TEX_BADGE_TENTACLE
    if entryIndex = CODEC_ENTRY_NIGHT then entryTex = TEX_CODEC_NIGHT
    if entryIndex = CODEC_ENTRY_RAINBOW then entryTex = CODEC_FISH_TEX `the goldfish, in every color. see codecRainbowTint.
    if entryIndex = CODEC_ENTRY_SCHOOL then entryTex = TEX_CODEC_SCHOOL
    if entryIndex = CODEC_ENTRY_SQUID then entryTex = TEX_SQUID
    if entryIndex = CODEC_ENTRY_STARS then entryTex = TEX_CODEC_NIGHT `the shapes are of the night. they have no picture of their own yet.
    if entryIndex = CODEC_ENTRY_FAVOR then entryTex = TEX_BADGE_TRIDENT `the badge that the table of high scores gives the ending
    if entryIndex = CODEC_ENTRY_CLEAN then entryTex = TEX_SQUID `its ink. it has no picture of its own yet, so it is the squid, pale.

    ` a word that brings somebody swimming through has the picture of whoever it brings
    entryCameo = entryIndex - CODEC_ENTRY_CAMEO
    if entryCameo >= 0
        if entryCameo < CAMEO_WORD_COUNT then entryTex = CAMEO_ICON_TEX(entryCameo)
    endif

    if entryIndex = CODEC_ENTRY_GOODBYE then entryTex = TEX_ENDING_GOODBYE
    if entryIndex = CODEC_ENTRY_CALL then entryTex = CARDS(ABILITY_INDEX_ANGLER).artTexId

    ` a quest has the picture that is on its badge
    entryQuest = getCodecQuest(entryIndex)
    if entryQuest > 0 then entryTex = QUEST_DEFS(entryQuest).iconTex
    if entryIndex < CARD_LENGTH then entryTex = CARDS(entryIndex).artTexId
endfunction entryTex


` a category starts here, in the list of the categories. the entries that are filed next are in it.
` its name is a key of the string table (codec.cat.*), which is looked up where the name is shown.
function codecStartCategory(cdcCatName$)
    CODEC_CAT_NAME$(CODEC_CAT_COUNT) = cdcCatName$
    CODEC_CAT_FIRST(CODEC_CAT_COUNT) = CODEC_ORDER_COUNT
    CODEC_CAT_SIZE(CODEC_CAT_COUNT) = 0
    CODEC_CAT_COUNT = CODEC_CAT_COUNT + 1
endfunction


` put a run of entries, which are in a row, at the end of the category that was started last
function codecFile(cdcFileEntry, cdcFileHowMany)
    cdcFileCat = CODEC_CAT_COUNT - 1
    cdcFileLast = cdcFileHowMany - 1
    for cdcFileN = 0 to cdcFileLast
        CODEC_ORDER(CODEC_ORDER_COUNT) = cdcFileEntry + cdcFileN
        CODEC_ORDER_COUNT = CODEC_ORDER_COUNT + 1
        CODEC_CAT_SIZE(cdcFileCat) = CODEC_CAT_SIZE(cdcFileCat) + 1
    next
endfunction


` 1 when any of the entries of a category has been seen. until then, the list does not give its name.
function codecCatSeen(cdcSeenCat)
    cdcSeenAny = 0
    cdcSeenFirst = CODEC_CAT_FIRST(cdcSeenCat)
    cdcSeenLast = cdcSeenFirst + CODEC_CAT_SIZE(cdcSeenCat)
    cdcSeenLast = cdcSeenLast - 1
    for cdcSeenAt = cdcSeenFirst to cdcSeenLast
        if CODEC_SEEN(CODEC_ORDER(cdcSeenAt)) then cdcSeenAny = 1
    next
endfunction cdcSeenAny


` work out which category the highlighted entry is in, and which of the entries of that category it is
function codecFindSelected()
    cdcFindLast = CODEC_ORDER_COUNT - 1
    for cdcFindAt = 0 to cdcFindLast
        if CODEC_ORDER(cdcFindAt) = CODEC_SELECTED
            for cdcFindCat = 0 to CODEC_CAT_COUNT - 1
                if cdcFindAt >= CODEC_CAT_FIRST(cdcFindCat)
                    CODEC_CAT = cdcFindCat
                    CODEC_CAT_AT = cdcFindAt - CODEC_CAT_FIRST(cdcFindCat)
                endif
            next
        endif
    next
endfunction


` a direction has been pressed. cdcGoX is 1 for right and -1 for left, and cdcGoY is 1 for down and -1 for up.
` in the grid, left and right go along the row, and left from the start of a row goes onto the list
` of the categories. up and down go between the rows, and the pages are one under the other: going
` off of the bottom of a page turns to the next one, and off of the last one goes to the category
` after. going up is the same, the other way. the categories go around.
` on the list, up and down go from category to category, and right goes back into the grid.
function codecGo(cdcGoX, cdcGoY)
    codecFindSelected()
    cdcGoCat = CODEC_CAT
    cdcGoAt = CODEC_CAT_AT
    cdcGoSize = CODEC_CAT_SIZE(cdcGoCat)
    cdcGoRow = cdcGoAt / CODEC_COLUMNS
    cdcGoCol = cdcGoAt mod CODEC_COLUMNS

    if CODEC_ON_LIST
        if cdcGoX > 0 then CODEC_ON_LIST = 0
        if cdcGoY <> 0
            cdcGoCat = cdcGoCat + cdcGoY
            if cdcGoCat >= CODEC_CAT_COUNT then cdcGoCat = 0
            if cdcGoCat < 0 then cdcGoCat = CODEC_CAT_COUNT - 1
            CODEC_SELECTED = CODEC_ORDER(CODEC_CAT_FIRST(cdcGoCat))
        endif
        exitfunction
    endif

    if cdcGoX > 0
        cdcGoNext = cdcGoAt + 1
        cdcGoLastCol = CODEC_COLUMNS - 1
        if cdcGoCol < cdcGoLastCol
            if cdcGoNext < cdcGoSize then cdcGoAt = cdcGoNext
        endif
    endif
    if cdcGoX < 0
        if cdcGoCol > 0
            cdcGoAt = cdcGoAt - 1
        else
            CODEC_ON_LIST = 1
        endif
    endif
    if cdcGoY > 0
        ` a row that has no tiles on it is off of the end of the category. the next one starts at its top.
        cdcGoRow = cdcGoRow + 1
        cdcGoNext = cdcGoRow * CODEC_COLUMNS
        if cdcGoNext >= cdcGoSize
            cdcGoCat = cdcGoCat + 1
            if cdcGoCat >= CODEC_CAT_COUNT then cdcGoCat = 0
            cdcGoRow = 0
        endif
        cdcGoAt = cdcGoRow * CODEC_COLUMNS + cdcGoCol
    endif
    if cdcGoY < 0
        ` and the category before is come into from underneath: at its last row
        cdcGoRow = cdcGoRow - 1
        if cdcGoRow < 0
            cdcGoCat = cdcGoCat - 1
            if cdcGoCat < 0 then cdcGoCat = CODEC_CAT_COUNT - 1
            cdcGoNext = CODEC_CAT_SIZE(cdcGoCat) - 1
            cdcGoRow = cdcGoNext / CODEC_COLUMNS
        endif
        cdcGoAt = cdcGoRow * CODEC_COLUMNS + cdcGoCol
    endif

    ` a row may not be full. a spot with no tile on it gives way to the last tile that there is.
    cdcGoSize = CODEC_CAT_SIZE(cdcGoCat)
    if cdcGoAt >= cdcGoSize then cdcGoAt = cdcGoSize - 1
    CODEC_SELECTED = CODEC_ORDER(CODEC_CAT_FIRST(cdcGoCat) + cdcGoAt)
endfunction


` the mouse. the highlight follows it over the tiles and over the list of the categories, and a click
` on one of the arrows turns the page. see THE MOUSE in fish_headers_mouse.
function codecMouse()
    codecFindSelected()
    cmCat = CODEC_CAT
    cmFirst = CODEC_CAT_FIRST(cmCat)
    cmPageStart = (CODEC_CAT_AT / CODEC_PAGE_SIZE) * CODEC_PAGE_SIZE
    cmSize = CODEC_CAT_SIZE(cmCat)

    cmLastSlot = CODEC_PAGE_SIZE - 1
    for cmSlot = 0 to cmLastSlot
        cmAt = cmPageStart + cmSlot
        if cmAt < cmSize
            cmX = getCodecTileX(cmSlot) - 18
            cmY = getCodecTileY(cmSlot) - 18
            cmOn = mouseHover(cmX, cmY, 36, 36)
            cmHit = mouseClick(cmX, cmY, 36, 36)
            if cmOn + cmHit > 0
                CODEC_ON_LIST = 0
                CODEC_SELECTED = CODEC_ORDER(cmFirst + cmAt)
            endif
        endif
    next

    cmLastCat = CODEC_CAT_COUNT - 1
    for cmCatI = 0 to cmLastCat
        cmY = CODEC_TOP + 6 + cmCatI * 14
        cmOn = mouseHover(CODEC_X + 5, cmY, CODEC_SIDE - 10, 14)
        cmHit = mouseClick(CODEC_X + 5, cmY, CODEC_SIDE - 10, 14)
        if cmOn + cmHit > 0
            cmChange = 1 - CODEC_ON_LIST
            if cmCatI <> cmCat then cmChange = 1
            if cmChange
                CODEC_ON_LIST = 1
                CODEC_SELECTED = CODEC_ORDER(CODEC_CAT_FIRST(cmCatI))
            endif
        endif
    next

    ` the arrows: "<" is the page before, and ">" is the page after
    cmArrowX = CODEC_X + CODEC_WIDTH - 28
    cmUp = mouseClick(cmArrowX, getCodecTileY(0) - 12, 24, 24)
    if cmUp
        if cmPageStart > 0
            CODEC_ON_LIST = 0
            CODEC_SELECTED = CODEC_ORDER(cmFirst + cmPageStart - CODEC_PAGE_SIZE)
        endif
    endif
    cmDown = mouseClick(cmArrowX, getCodecTileY(cmLastSlot) - 12, 24, 24)
    if cmDown
        cmNextPage = cmPageStart + CODEC_PAGE_SIZE
        if cmNextPage < cmSize
            CODEC_ON_LIST = 0
            CODEC_SELECTED = CODEC_ORDER(cmFirst + cmNextPage)
        endif
    endif
endfunction


` how many pages the grid has, for a category
function getCodecPageCount(pageCat)
    pageCount = (CODEC_CAT_SIZE(pageCat) + CODEC_PAGE_SIZE - 1) / CODEC_PAGE_SIZE
    if pageCount < 1 then pageCount = 1
endfunction pageCount


` where the middle of a tile is on the screen. the tiles of a page are numbered along the top row and
` then along the next. the grid is in the middle of what the list of the categories leaves of the panel.
function getCodecTileX(tileSlot)
    gridRoom = CODEC_WIDTH - CODEC_SIDE
    gridLeft = CODEC_X + CODEC_SIDE + (gridRoom - CODEC_COLUMNS * CODEC_TILE) / 2
    tileX = gridLeft + CODEC_TILE / 2 + (tileSlot mod CODEC_COLUMNS) * CODEC_TILE
endfunction tileX

function getCodecTileY(tileSlot)
    tileY = CODEC_TOP + 26 + (tileSlot / CODEC_COLUMNS) * CODEC_TILE
endfunction tileY


` show the codec, in place of the list of the menu. the high scores take the menu apart the same way.
function openCodec()
    openHighscoreChrome(CODEC_X, CODEC_TOP, CODEC_WIDTH, CODEC_HEIGHT)

    ` the codec is tall, so the title moves up to make room for it. closeCodec puts it back.
    MENU_TITLE_Y = CODEC_TOP - 40
    set text MENU_TITLE_TEXT_ID, loc$("codec.title")
    size text y MENU_TITLE_TEXT_ID, 36

    set text MENU_HINT_TEXT_ID, loc$("codec.hint")
    size text y MENU_HINT_TEXT_ID, 16

    ` refreshCodec shows the tiles, because how many there are depends on the page
    show text CODEC_COUNT_TEXT_ID
    show text CODEC_PAGE_TEXT_ID
    show sprite CODEC_PAGE_BACK_SPRITE
    for i = 0 to CODEC_CAT_COUNT - 1
        show text CODEC_CAT_TEXTS(i)
    next
    show sprite CODEC_CAT_BAR_SPRITE
    show sprite CODEC_SIDE_SPRITE
    show text CODEC_ARROW_TEXTS(0)
    show text CODEC_ARROW_TEXTS(1)
    show sprite CODEC_DIVIDER_SPRITE
    show sprite CODEC_BIG_SPRITE
    show text CODEC_NAME_TEXT_ID
    show text CODEC_KIND_TEXT_ID
    show text CODEC_DESC_TEXT_ID
    showInfoBorder(CODEC_CURSOR, 1)
endfunction


` put the codec away, and give the menu back its title, its panel and its list.
` setMenuPage has to be called after this, to lay the list out again.
function closeCodec()
    for i = 0 to CODEC_PAGE_SIZE - 1
        hide sprite CODEC_ICON_SPRITES(i)
        hide sprite CODEC_LOCK_SPRITES(i)
    next
    hide sprite CODEC_STACK_SPRITES(0)
    hide sprite CODEC_STACK_SPRITES(1)
    hide sprite CODEC_HEART_SPRITES(0)
    hide sprite CODEC_HEART_SPRITES(1)
    for i = 0 to CODEC_PAGE_SIZE
        hide sprite CODEC_CHECK_SPRITES(i)
    next
    hide text CODEC_COUNT_TEXT_ID
    hide text CODEC_PAGE_TEXT_ID
    hide sprite CODEC_PAGE_BACK_SPRITE
    for i = 0 to CODEC_CAT_COUNT - 1
        hide text CODEC_CAT_TEXTS(i)
    next
    hide sprite CODEC_CAT_BAR_SPRITE
    hide sprite CODEC_SIDE_SPRITE
    hide text CODEC_ARROW_TEXTS(0)
    hide text CODEC_ARROW_TEXTS(1)
    hide sprite CODEC_DIVIDER_SPRITE
    hide sprite CODEC_BIG_SPRITE
    hide text CODEC_NAME_TEXT_ID
    hide text CODEC_KIND_TEXT_ID
    hide text CODEC_DESC_TEXT_ID
    showInfoBorder(CODEC_CURSOR, 0)
    codecNewDotsHide()

    MENU_TITLE_Y = 62
    showMenuChrome(1)
endfunction


` put the page that the highlighted entry is on onto the tiles, color every tile by whether it is
` locked, put the outline on the highlighted one, and explain it.
function refreshCodec()
    ` the highlighted entry has been looked at, so it is not new any more. see NEW IN THE CODEC in fish_headers_teach.
    if CODEC_ON_LIST = 0
        codecMarkRead(CODEC_SELECTED)
    endif

    foundCount = 0
    for i = 0 to CODEC_COUNT - 1
        if CODEC_SEEN(i) then foundCount = foundCount + 1
    next
    set text CODEC_COUNT_TEXT_ID, loc$("codec.found", "found", foundCount, "total", CODEC_COUNT)

    ` the grid has the category that the highlighted entry is in, and the list says which one that is
    codecFindSelected()
    ` a category that nothing has been found in does not say what it is, the same as a locked tile
    for i = 0 to CODEC_CAT_COUNT - 1
        catColor = rgb(150, 190, 255)
        if codecCatSeen(i)
            set text CODEC_CAT_TEXTS(i), loc$(CODEC_CAT_NAME$(i))
        else
            set text CODEC_CAT_TEXTS(i), "???"
            catColor = rgb(120, 140, 185)
        endif
        if i = CODEC_CAT then catColor = rgb(255, 255, 255)
        color text CODEC_CAT_TEXTS(i), catColor
    next
    position sprite CODEC_CAT_BAR_SPRITE, CODEC_X + 5, CODEC_TOP + 6 + CODEC_CAT * 14

    pageNow = CODEC_CAT_AT / CODEC_PAGE_SIZE
    pageCount = getCodecPageCount(CODEC_CAT)
    set text CODEC_PAGE_TEXT_ID, loc$("codec.page", "page", pageNow + 1, "pages", pageCount)

    ` what the page number is written on sits on the corner of the panel, and is as wide as the words
    pageBackWide = get text size x(CODEC_PAGE_TEXT_ID) + 16
    pageBackLeft = CODEC_X + CODEC_WIDTH
    pageBackLeft = pageBackLeft - pageBackWide
    position sprite CODEC_PAGE_BACK_SPRITE, pageBackLeft, CODEC_TOP - 23
    size sprite CODEC_PAGE_BACK_SPRITE, pageBackWide, 23

    ` an arrow is only lit when there is a page of the category that way
    arrowColor = rgb(64, 128, 255, 60)
    if pageNow > 0 then arrowColor = rgb(255, 255, 255)
    color text CODEC_ARROW_TEXTS(0), arrowColor
    arrowColor = rgb(64, 128, 255, 60)
    pageLast = pageCount - 1
    if pageNow < pageLast then arrowColor = rgb(255, 255, 255)
    color text CODEC_ARROW_TEXTS(1), arrowColor

    ` the fish behind the fish of "stacked" only show while that entry does, and is unlocked
    hide sprite CODEC_STACK_SPRITES(0)
    hide sprite CODEC_STACK_SPRITES(1)
    rotate sprite CODEC_BIG_SPRITE, 0

    ` and the same goes for the heart of "heart home"
    hide sprite CODEC_HEART_SPRITES(0)
    hide sprite CODEC_HEART_SPRITES(1)

    ` and for the check marks of the quests that have been finished
    for i = 0 to CODEC_PAGE_SIZE
        hide sprite CODEC_CHECK_SPRITES(i)
    next

    for i = 0 to CODEC_PAGE_SIZE - 1
        ` a tile that the category has no entry for has the number of an entry that there is not
        shownEntry = CODEC_COUNT
        shownAt = pageNow * CODEC_PAGE_SIZE + i
        if shownAt < CODEC_CAT_SIZE(CODEC_CAT)
            shownEntry = CODEC_ORDER(CODEC_CAT_FIRST(CODEC_CAT) + shownAt)
        endif
        rotate sprite CODEC_ICON_SPRITES(i), 0
        if shownEntry < CODEC_COUNT
            ` the size is set again, because it is worked out from the size of the texture
            ` the art of a card is drawn at half of its size, and a badge at twice its size
            tileSize = 24
            if shownEntry >= CARD_LENGTH then tileSize = 32
            set sprite texture CODEC_ICON_SPRITES(i), getCodecEntryTex(shownEntry)
            size sprite CODEC_ICON_SPRITES(i), tileSize, tileSize
            cameoIconSize(CODEC_ICON_SPRITES(i), shownEntry, 32) `not all of those pictures are square
            show sprite CODEC_ICON_SPRITES(i)

            if CODEC_SEEN(shownEntry)
                hide sprite CODEC_LOCK_SPRITES(i)

                ` the art of a card is white, so it is tinted like the text of the menu is, and the
                ` highlighted one is left white.
                tileColor = rgb(150, 190, 255)
                if shownEntry = CODEC_SELECTED then tileColor = rgb(255, 255, 255)

                ` the picture of a fish has colors of its own, which a tint would muddy, so it is only dimmed
                if shownEntry >= CODEC_ENTRY_JELLY and shownEntry <> CODEC_SELECTED
                    tileColor = rgb(190, 190, 190)
                endif

                ` the pictures of the radio, and of its signals, are white, like the art of a card, and so is the one of the night
                if shownEntry >= CODEC_ENTRY_RADIO and shownEntry <> CODEC_SELECTED
                    if shownEntry <= CODEC_ENTRY_NIGHT
                        tileColor = rgb(150, 190, 255)
                    endif
                endif

                ` and the house of the usual ending is white, like the heart and the eye of the other endings
                if shownEntry = CODEC_ENTRY_GOODBYE and shownEntry <> CODEC_SELECTED
                    tileColor = rgb(150, 190, 255)
                endif
                ` and so are the shapes of the night, which have the picture of the night
                if shownEntry = CODEC_ENTRY_STARS and shownEntry <> CODEC_SELECTED
                    tileColor = rgb(150, 190, 255)
                endif
                ` and squeaky clean is the squid, washed pale
                if shownEntry = CODEC_ENTRY_CLEAN and shownEntry <> CODEC_SELECTED
                    tileColor = rgb(190, 240, 255)
                endif
                color sprite CODEC_ICON_SPRITES(i), tileColor

                ` a belly up fish is upside down
                if shownEntry = CODEC_ENTRY_BELLY
                    rotate sprite CODEC_ICON_SPRITES(i), 3.14159
                endif

                ` and a stacked one has another fish behind it, up and to the left
                if shownEntry = CODEC_ENTRY_STACK
                    set sprite texture CODEC_STACK_SPRITES(0), CODEC_FISH_TEX
                    size sprite CODEC_STACK_SPRITES(0), tileSize, tileSize
                    position sprite CODEC_STACK_SPRITES(0), getCodecTileX(i) - 5, getCodecTileY(i) - 5
                    color sprite CODEC_STACK_SPRITES(0), rgb(90, 115, 165)
                    show sprite CODEC_STACK_SPRITES(0)
                endif

                ` a quest that has been finished, in any game, has a check mark on the corner of its tile
                shownQuest = getCodecQuest(shownEntry)
                if shownQuest > 0
                    if QUEST_EVER_DONE(shownQuest)
                        show sprite CODEC_CHECK_SPRITES(i)
                    endif
                endif

                ` and one that is at home has a heart coming up from it
                if shownEntry = CODEC_ENTRY_HOME
                    size sprite CODEC_HEART_SPRITES(0), 12, 12
                    position sprite CODEC_HEART_SPRITES(0), getCodecTileX(i) + 9, getCodecTileY(i) - 12
                    show sprite CODEC_HEART_SPRITES(0)
                endif
            else
                ` a locked tile is only a question mark. its picture would give it away.
                show sprite CODEC_LOCK_SPRITES(i)
                hide sprite CODEC_ICON_SPRITES(i)
            endif
        else
            ` the last page may not be full
            hide sprite CODEC_ICON_SPRITES(i)
            hide sprite CODEC_LOCK_SPRITES(i)
        endif
    next

    selectedSlot = CODEC_CAT_AT mod CODEC_PAGE_SIZE
    if CODEC_ON_LIST
        ` the outline is on the list of the categories, around the bar
        movePageOutline(CODEC_CURSOR, CODEC_X + 5, CODEC_TOP + 6 + CODEC_CAT * 14, CODEC_SIDE - 10, 14)
    else
        movePageOutline(CODEC_CURSOR, getCodecTileX(selectedSlot) - 18, getCodecTileY(selectedSlot) - 18, 36, 36)
    endif

    ` the highlighted tile, explained. a locked one only says how to find it.
    if CODEC_SEEN(CODEC_SELECTED) = 0
        set sprite texture CODEC_BIG_SPRITE, TEX_LOCK
        size sprite CODEC_BIG_SPRITE, 48, 48
        color sprite CODEC_BIG_SPRITE, rgb(120, 140, 185)

        set text CODEC_NAME_TEXT_ID, "? ? ?"
        color text CODEC_NAME_TEXT_ID, rgb(120, 140, 185)
        set text CODEC_KIND_TEXT_ID, loc$("codec.kind.locked")
        set text CODEC_DESC_TEXT_ID, loc$("codec.locked.upgrade")

        ` the ones that are not cards do not turn up there, and nothing says where they do
        if CODEC_SELECTED >= CARD_LENGTH
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.none")
        endif

        ` the special fish, and what can happen to a fish, are found on the board
        if CODEC_SELECTED >= CODEC_ENTRY_JELLY
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.board")
        endif

        ` the diver, and its ending, are secrets, like the two endings of the coral, and nothing says where they are
        if CODEC_SELECTED = CODEC_ENTRY_DIVER
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.none")
        endif
        if CODEC_SELECTED = CODEC_ENTRY_ALBUM
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.none")
        endif

        ` a quest turns up with a round
        if getCodecQuest(CODEC_SELECTED) > 0
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.quest")
        endif

        ` and the QR code is not on the board, or anywhere, until it is asked for
        if CODEC_SELECTED = CODEC_ENTRY_TUNA
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.tuna")
        endif

        ` the radio is there for whoever holds on, and it knows the signals
        if CODEC_SELECTED = CODEC_ENTRY_RADIO
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.radio")
        endif
        if CODEC_SELECTED > CODEC_ENTRY_RADIO
            if CODEC_SELECTED <= CODEC_ENTRY_CTHULHU
                set text CODEC_DESC_TEXT_ID, loc$("codec.locked.signal")
            endif
        endif

        ` the night is found by whoever watches which way the water is going. see fish_headers_tide.
        if CODEC_SELECTED = CODEC_ENTRY_NIGHT
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.night")
        endif

        ` the words that bring somebody swimming through are signals too, and the radio gives one away at a time
        lockedCameo = CODEC_SELECTED - CODEC_ENTRY_CAMEO
        if lockedCameo >= 0
            if lockedCameo < CAMEO_WORD_COUNT
                set text CODEC_DESC_TEXT_ID, loc$("codec.locked.signal")
            endif
        endif

        ` the call of the angler is given away by the angler itself
        if CODEC_SELECTED = CODEC_ENTRY_CALL
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.call")
        endif

        ` the usual ending is there for whoever gets to the end of a game
        if CODEC_SELECTED = CODEC_ENTRY_GOODBYE
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.goodbye")
        endif

        ` the shapes of the night are for whoever watches the water at night, and their ending is a secret
        if CODEC_SELECTED = CODEC_ENTRY_STARS
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.stars")
        endif
        if CODEC_SELECTED = CODEC_ENTRY_FAVOR
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.none")
        endif
        if CODEC_SELECTED = CODEC_ENTRY_CLEAN
            set text CODEC_DESC_TEXT_ID, loc$("codec.locked.clean")
        endif
    else
        ` the size is set again, because it is worked out from the size of the texture
        set sprite texture CODEC_BIG_SPRITE, getCodecEntryTex(CODEC_SELECTED)
        size sprite CODEC_BIG_SPRITE, 48, 48
        color sprite CODEC_BIG_SPRITE, rgb(255, 255, 255)
        color text CODEC_NAME_TEXT_ID, rgb(255, 255, 255)

        ` coral and horror coral say what info mode says about them in a game
        if CODEC_SELECTED = CODEC_ENTRY_REEF
            set text CODEC_NAME_TEXT_ID, loc$("codec.reef.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.reef.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.ending")
            exitfunction
        endif
        ` the usual ending says what it says when it plays. see finale_goodbye, in fish_routines_coral.
        if CODEC_SELECTED = CODEC_ENTRY_GOODBYE
            set text CODEC_NAME_TEXT_ID, loc$("codec.goodbye.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.goodbye.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.ending")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_ANCIENT
            set text CODEC_NAME_TEXT_ID, loc$("codec.ancient.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.ancient.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.ending")
            exitfunction
        endif
        ` the diver says what info mode says about it in a game, and its ending has words of its own. see fish_headers_diver.
        if CODEC_SELECTED = CODEC_ENTRY_DIVER
            set text CODEC_NAME_TEXT_ID, INFOS(INFO_INDEX_DIVER).title$
            set text CODEC_DESC_TEXT_ID, INFOS(INFO_INDEX_DIVER).desc$
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_ALBUM
            set text CODEC_NAME_TEXT_ID, loc$("codec.album.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.album.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.ending")
            exitfunction
        endif
        ` the special fish
        if CODEC_SELECTED = CODEC_ENTRY_JELLY
            set text CODEC_NAME_TEXT_ID, loc$("codec.jelly.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.jelly.desc", "percent", JELLY_STING_CHANCE)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.special")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_RAY
            set text CODEC_NAME_TEXT_ID, loc$("codec.ray.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.ray.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.special")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_BOTTLE
            set text CODEC_NAME_TEXT_ID, loc$("codec.bottle.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.bottle.desc", "size", BOTTLE_GROUP_SIZE, "gain", BOTTLE_MULT_GAIN)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.special")
            exitfunction
        endif

        ` and what can happen to a fish
        if CODEC_SELECTED = CODEC_ENTRY_BELLY
            rotate sprite CODEC_BIG_SPRITE, 3.14159
            set text CODEC_NAME_TEXT_ID, loc$("codec.belly.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.belly.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.status")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_SKELETON
            set text CODEC_NAME_TEXT_ID, loc$("codec.skeleton.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.skeleton.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.status")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_STACK
            set sprite texture CODEC_STACK_SPRITES(1), CODEC_FISH_TEX
            size sprite CODEC_STACK_SPRITES(1), 48, 48
            position sprite CODEC_STACK_SPRITES(1), CODEC_X + 36, CODEC_DETAIL_TOP + 32
            color sprite CODEC_STACK_SPRITES(1), rgb(90, 115, 165)
            show sprite CODEC_STACK_SPRITES(1)
            set text CODEC_NAME_TEXT_ID, loc$("codec.stack.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.stack.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.status")
            exitfunction
        endif

        if CODEC_SELECTED = CODEC_ENTRY_HOME
            size sprite CODEC_HEART_SPRITES(1), 20, 20
            position sprite CODEC_HEART_SPRITES(1), CODEC_X + 60, CODEC_DETAIL_TOP + 18
            show sprite CODEC_HEART_SPRITES(1)
            set text CODEC_NAME_TEXT_ID, loc$("codec.home.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.home.desc", "times", CORAL_SCORE_BONUS)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.status")
            exitfunction
        endif

        if CODEC_SELECTED = CODEC_ENTRY_TUNA
            set text CODEC_NAME_TEXT_ID, loc$("codec.tuna.name")
            cdcMorse$ = codecMorse(MORSE_WORD_SOS)
            set text CODEC_DESC_TEXT_ID, loc$("codec.tuna.desc", "morse", cdcMorse$)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif

        ` the radio, which only gives one signal away, and the signals that have an entry of their
        ` own. SOS has the entry of the QR code, above, and TUNA has none. see MORSE in fish_headers.
        if CODEC_SELECTED = CODEC_ENTRY_RADIO
            set text CODEC_NAME_TEXT_ID, loc$("codec.radio.name")
            cdcMorse$ = codecMorse(MORSE_WORD_CQ)
            cdcSeconds = MORSE_WAKE_MS / 1000
            set text CODEC_DESC_TEXT_ID, loc$("codec.radio.desc", "seconds", cdcSeconds, "morse", cdcMorse$)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif
        ` SING and SONG do the same thing, so they are one entry, which either of them unlocks
        if CODEC_SELECTED = CODEC_ENTRY_SING
            set text CODEC_NAME_TEXT_ID, loc$("codec.sing.name")
            cdcMorse$ = codecMorse(MORSE_WORD_SING)
            cdcMorse2$ = codecMorse(MORSE_WORD_SONG)
            set text CODEC_DESC_TEXT_ID, loc$("codec.sing.desc", "morse", cdcMorse$, "morse2", cdcMorse2$)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.signal")
            exitfunction
        endif
        ` HELP and INFO do the same thing, so they are one entry, the same as SING and SONG
        if CODEC_SELECTED = CODEC_ENTRY_CALL
            set text CODEC_NAME_TEXT_ID, loc$("codec.call.name")
            cdcMorse$ = codecMorse(MORSE_WORD_HELP)
            cdcMorse2$ = codecMorse(MORSE_WORD_INFO)
            set text CODEC_DESC_TEXT_ID, loc$("codec.call.desc", "morse", cdcMorse$, "morse2", cdcMorse2$)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.signal")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_CTHULHU
            set text CODEC_NAME_TEXT_ID, loc$("codec.cthulhu.name")
            cdcMorse$ = codecMorse(MORSE_WORD_CTHULHU)
            set text CODEC_DESC_TEXT_ID, loc$("codec.cthulhu.desc", "morse", cdcMorse$)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.signal")
            exitfunction
        endif

        ` see THE NIGHT IN THE CODEC in fish_headers_tide
        if CODEC_SELECTED = CODEC_ENTRY_NIGHT
            set text CODEC_NAME_TEXT_ID, loc$("codec.night.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.night.desc", "tides", TIDE_CYCLES_TO_TURN)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif

        ` rainbow fish and schooling fish. see fish_headers_rainbow and fish_headers_school.
        if CODEC_SELECTED = CODEC_ENTRY_RAINBOW
            set text CODEC_NAME_TEXT_ID, loc$("codec.rainbow.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.rainbow.about")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.status")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_SCHOOL
            set text CODEC_NAME_TEXT_ID, loc$("codec.school.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.school.about")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.status")
            exitfunction
        endif

        ` the squid says as little as rainbow fish do. the shapes of the night say how they are made, like the
        ` night does, once one has been. see fish_headers_squid, and fish_headers_neptune for the ending.
        if CODEC_SELECTED = CODEC_ENTRY_SQUID
            set text CODEC_NAME_TEXT_ID, loc$("codec.squid.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.squid.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.special")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_STARS
            set text CODEC_NAME_TEXT_ID, loc$("codec.stars.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.stars.desc2", "times", STAR_BONUS)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_FAVOR
            set text CODEC_NAME_TEXT_ID, loc$("codec.favor.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.favor.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.ending")
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_CLEAN
            set text CODEC_NAME_TEXT_ID, loc$("codec.clean.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.clean.desc")
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif

        ` see DIAGONALS in fish_headers
        if CODEC_SELECTED = CODEC_ENTRY_CROOKED
            set text CODEC_NAME_TEXT_ID, loc$("codec.crooked.name")
            set text CODEC_DESC_TEXT_ID, loc$("codec.crooked.desc", "length", DIAGONAL_LENGTH)
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif

        ` a word that brings somebody swimming through. see CAMEOS in fish_headers_cameo.
        selectedCameo = CODEC_SELECTED - CODEC_ENTRY_CAMEO
        if selectedCameo >= 0
            if selectedCameo < CAMEO_WORD_COUNT
                selectedWord = MORSE_WORD_NEMO + selectedCameo
                cameoIconSize(CODEC_BIG_SPRITE, CODEC_SELECTED, 48)
                set text CODEC_NAME_TEXT_ID, loc$(CAMEO_NAME$(selectedCameo))
                cdcMorse$ = codecMorse(selectedWord)
                set text CODEC_DESC_TEXT_ID, loc$("codec.cameo.desc", "word", MORSE_WORD_NAME$(selectedWord), "morse", cdcMorse$, "says", loc$(CAMEO_SAYS$(selectedCameo)))
                set text CODEC_KIND_TEXT_ID, loc$("codec.kind.signal")
                exitfunction
            endif
        endif

        ` a quest says what info mode says about it in a game, and whether it has ever been finished
        selectedQuest = getCodecQuest(CODEC_SELECTED)
        if selectedQuest > 0
            set text CODEC_NAME_TEXT_ID, loc$(QUEST_DEFS(selectedQuest).name$)
            set text CODEC_DESC_TEXT_ID, loc$(QUEST_DEFS(selectedQuest).desc$)
            if QUEST_EVER_DONE(selectedQuest)
                set text CODEC_KIND_TEXT_ID, loc$("codec.kind.quest.done")
                show sprite CODEC_CHECK_SPRITES(CODEC_PAGE_SIZE)
            else
                set text CODEC_KIND_TEXT_ID, loc$("codec.kind.quest.todo")
            endif
            exitfunction
        endif

        if CODEC_SELECTED >= CARD_LENGTH
            extraInfo = INFO_INDEX_CORAL
            if CODEC_SELECTED = CODEC_ENTRY_HORROR then extraInfo = INFO_INDEX_CORAL_SICK
            set text CODEC_NAME_TEXT_ID, INFOS(extraInfo).title$
            set text CODEC_DESC_TEXT_ID, INFOS(extraInfo).desc$
            set text CODEC_KIND_TEXT_ID, loc$("codec.kind.secret")
            exitfunction
        endif

        set text CODEC_NAME_TEXT_ID, CARDS(CODEC_SELECTED).name$
        set text CODEC_DESC_TEXT_ID, CARDS(CODEC_SELECTED).desc$
        select CARDS(CODEC_SELECTED).abilityType
            case ABILITY_TYPE_PASSIVE
                set text CODEC_KIND_TEXT_ID, loc$("codec.kind.passive")
            endcase
            case ABILITY_TYPE_MOVE
                set text CODEC_KIND_TEXT_ID, loc$("codec.kind.move")
            endcase
            case ABILITY_TYPE_INSTANT
                set text CODEC_KIND_TEXT_ID, loc$("codec.kind.instant")
            endcase
        endselect
    endif
endfunction


` the dots and dashes of a signal, with a gap after every letter, for what the codec says about it.
` they are worked out from the word itself, so they are never wrong. see morseWord, in
` fish_routines_morse. the words around them are in the string table (codec.*.desc), with {$morse}
` where the dots and dashes go.
function codecMorse(signalWord)
    signalSays$ = ""
    signalFirst = signalWord * MORSE_SPELL_ROOM
    signalLastSpelt = MORSE_WORD_SPELL_LENGTH(signalWord) - 2
    for signalSpelt = 0 to signalLastSpelt
        signalMark = MORSE_WORD_SPELL(signalFirst + signalSpelt)
        if signalMark = 0 then signalSays$ = signalSays$ + "."
        if signalMark = 1 then signalSays$ = signalSays$ + "-"
        if signalMark = 2 then signalSays$ = signalSays$ + "  "
    next
endfunction signalSays$



` the picture of rainbow fish is the goldfish, going through every color, on its tile and as the big
` picture. frame_codec does this, after refreshCodec has given every tile its color.
function codecRainbowTint()
    crtNow# = game ms()
    crtHue# = crtNow# * .004
    crtR = 160 + 95 * sin(crtHue#)
    crtG = 160 + 95 * sin(crtHue# + 2.094)
    crtB = 160 + 95 * sin(crtHue# + 4.189)
    crtColor = rgb(crtR, crtG, crtB)
    if CODEC_SEEN(CODEC_ENTRY_RAINBOW) = 0 then exitfunction

    crtPage = CODEC_CAT_AT / CODEC_PAGE_SIZE
    for crtI = 0 to CODEC_PAGE_SIZE - 1
        crtAt = crtPage * CODEC_PAGE_SIZE + crtI
        if crtAt < CODEC_CAT_SIZE(CODEC_CAT)
            if CODEC_ORDER(CODEC_CAT_FIRST(CODEC_CAT) + crtAt) = CODEC_ENTRY_RAINBOW
                color sprite CODEC_ICON_SPRITES(crtI), crtColor
            endif
        endif
    next
    if CODEC_SELECTED = CODEC_ENTRY_RAINBOW
        color sprite CODEC_BIG_SPRITE, crtColor
    endif
endfunction


` the name of an entry of the codec, the way that the codec writes it over the entry. info mode lists the
` new entries by name. see NEW IN THE CODEC in fish_headers_teach. it is worked out the same way that
` refreshCodec works it out.
function codecEntryName(cenEntry)
    cenName$ = ""
    if cenEntry < CARD_LENGTH
        cenName$ = CARDS(cenEntry).name$
    endif
    if cenEntry = CODEC_ENTRY_CORAL
        cenName$ = INFOS(INFO_INDEX_CORAL).title$
    endif
    if cenEntry = CODEC_ENTRY_HORROR
        cenName$ = INFOS(INFO_INDEX_CORAL_SICK).title$
    endif
    if cenEntry = CODEC_ENTRY_REEF
        cenName$ = loc$("codec.reef.name")
    endif
    if cenEntry = CODEC_ENTRY_ANCIENT
        cenName$ = loc$("codec.ancient.name")
    endif
    if cenEntry = CODEC_ENTRY_GOODBYE
        cenName$ = loc$("codec.goodbye.name")
    endif
    if cenEntry = CODEC_ENTRY_DIVER
        cenName$ = INFOS(INFO_INDEX_DIVER).title$
    endif
    if cenEntry = CODEC_ENTRY_ALBUM
        cenName$ = loc$("codec.album.name")
    endif
    if cenEntry = CODEC_ENTRY_JELLY
        cenName$ = loc$("codec.jelly.name")
    endif
    if cenEntry = CODEC_ENTRY_RAY
        cenName$ = loc$("codec.ray.name")
    endif
    if cenEntry = CODEC_ENTRY_BOTTLE
        cenName$ = loc$("codec.bottle.name")
    endif
    if cenEntry = CODEC_ENTRY_BELLY
        cenName$ = loc$("codec.belly.name")
    endif
    if cenEntry = CODEC_ENTRY_SKELETON
        cenName$ = loc$("codec.skeleton.name")
    endif
    if cenEntry = CODEC_ENTRY_STACK
        cenName$ = loc$("codec.stack.name")
    endif
    if cenEntry = CODEC_ENTRY_HOME
        cenName$ = loc$("codec.home.name")
    endif
    if cenEntry = CODEC_ENTRY_TUNA
        cenName$ = loc$("codec.tuna.name")
    endif
    if cenEntry = CODEC_ENTRY_CROOKED
        cenName$ = loc$("codec.crooked.name")
    endif
    if cenEntry = CODEC_ENTRY_RADIO
        cenName$ = loc$("codec.radio.name")
    endif
    if cenEntry = CODEC_ENTRY_SING
        cenName$ = loc$("codec.sing.name")
    endif
    if cenEntry = CODEC_ENTRY_CTHULHU
        cenName$ = loc$("codec.cthulhu.name")
    endif
    if cenEntry = CODEC_ENTRY_NIGHT
        cenName$ = loc$("codec.night.name")
    endif
    if cenEntry = CODEC_ENTRY_RAINBOW
        cenName$ = loc$("codec.rainbow.name")
    endif
    if cenEntry = CODEC_ENTRY_SCHOOL
        cenName$ = loc$("codec.school.name")
    endif
    if cenEntry = CODEC_ENTRY_CALL
        cenName$ = loc$("codec.call.name")
    endif
    if cenEntry = CODEC_ENTRY_SQUID
        cenName$ = loc$("codec.squid.name")
    endif
    if cenEntry = CODEC_ENTRY_STARS
        cenName$ = loc$("codec.stars.name")
    endif
    if cenEntry = CODEC_ENTRY_FAVOR
        cenName$ = loc$("codec.favor.name")
    endif
    if cenEntry = CODEC_ENTRY_CLEAN
        cenName$ = loc$("codec.clean.name")
    endif
    cenCameo = cenEntry - CODEC_ENTRY_CAMEO
    if cenCameo >= 0
        if cenCameo < CAMEO_WORD_COUNT
            cenName$ = loc$(CAMEO_NAME$(cenCameo))
        endif
    endif
    cenQuest = getCodecQuest(cenEntry)
    if cenQuest > 0
        cenName$ = loc$(QUEST_DEFS(cenQuest).name$)
    endif
endfunction cenName$
