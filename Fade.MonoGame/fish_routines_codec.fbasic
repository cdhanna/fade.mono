goto routines_codec_exit

remstart
    THE CODEC
    the codec is a page of the main menu, and of the pause menu, that shows every upgrade there is to come across in the game.
    each one is a tile in a grid, and the tile that is highlighted is explained underneath the grid.

    an upgrade is locked until it has been seen in a game. a locked tile is a lock, and it does not
    say what it is. an upgrade is seen when it is one of the cards that the upgrade screen offers,
    whether or not it gets picked. what has been seen is kept in the preferences, so it stays
    unlocked for good.

    the entries are the cards, in the order of CARDS. entry n is card n. after the cards come the
    entries that are not cards: coral, and horror coral. those are not on the upgrade screen. they are
    seen when some of it grows on the board. see CODEC_ENTRY_CORAL in fish_headers. then the two
    endings, and then the special fish (jellyfish, stingray, bottle) and what can happen to a fish
    (belly up, skeletal, stacked, heart home), which are seen when one is on the board. and last, the
    QR code that the fish make when TUNA is typed, or tapped out in Morse code, which is seen when they make one. see TUNA in fish_headers.
    and after that, the crooked bar, which is seen when a line of fish pays out. see DIAGONALS in fish_headers.
    and the diver, and its ending. and the radio, which is seen when it first comes on, and the
    signals SING, SONG and CTHULHU, each of which is seen when it is sent. see MORSE in fish_headers.
    and after that, every quest, which is seen when it is the quest of a round, and has a check mark
    once it has been finished in any game. see THE QUESTS IN THE CODEC in fish_headers_quests.

    there are more upgrades than fit in the grid, so the grid has pages. a page is CODEC_PAGE_SIZE
    tiles, and there are only that many tile sprites: they are given the pictures of whichever page is
    showing. the page that is showing is the one that the highlighted entry is on. going off of
    either end of a row turns the page, and the arrows at the ends of the grid say so.

    the rest of the game only has to call codecSeeCard() when a card is seen.

    all of this is drawn into the menu's render target, in place of the list of the menu, the same
    way that the high scores are.
remend


` setup_menu comes here, because all of this is drawn with the menu.
setup_codec:
    CODEC_ENTRY_CORAL = CARD_LENGTH
    CODEC_ENTRY_HORROR = CARD_LENGTH + 1
    CODEC_ENTRY_REEF = CARD_LENGTH + 2
    CODEC_ENTRY_ANCIENT = CARD_LENGTH + 3
    CODEC_ENTRY_JELLY = CARD_LENGTH + 4
    CODEC_ENTRY_RAY = CARD_LENGTH + 5
    CODEC_ENTRY_BOTTLE = CARD_LENGTH + 6
    CODEC_ENTRY_BELLY = CARD_LENGTH + 7
    CODEC_ENTRY_SKELETON = CARD_LENGTH + 8
    CODEC_ENTRY_STACK = CARD_LENGTH + 9
    CODEC_ENTRY_HOME = CARD_LENGTH + 10
    CODEC_ENTRY_TUNA = CARD_LENGTH + 11
    CODEC_ENTRY_CROOKED = CARD_LENGTH + 12
    CODEC_ENTRY_DIVER = CARD_LENGTH + 13
    CODEC_ENTRY_ALBUM = CARD_LENGTH + 14
    CODEC_ENTRY_RADIO = CARD_LENGTH + 15
    CODEC_ENTRY_SING = CARD_LENGTH + 16
    CODEC_ENTRY_SONG = CARD_LENGTH + 17
    CODEC_ENTRY_CTHULHU = CARD_LENGTH + 18
    CODEC_ENTRY_NIGHT = CARD_LENGTH + 19

    ` and then every quest. see THE QUESTS IN THE CODEC in fish_headers_quests.
    CODEC_ENTRY_QUEST = CARD_LENGTH + CODEC_EXTRA_COUNT
    CODEC_COUNT = CARD_LENGTH + CODEC_EXTRA_COUNT + QUEST_COUNT
    for codecI = 1 to QUEST_COUNT
        QUEST_EVER_DONE(codecI) = get pref(QUEST_PREF_DONE + codecI, 0)
    next

    ` what has been seen, in every game that has ever been played
    for codecI = 0 to CODEC_COUNT - 1
        CODEC_SEEN(codecI) = get pref(getCodecPref(codecI), 0)
    next

    ` an ending that was reached before the codec had an entry for it counts, too
    if get pref(PREF_ENDING_REEF, 0) then codecSeeCard(CODEC_ENTRY_REEF)
    if get pref(PREF_ENDING_ANCIENT, 0) then codecSeeCard(CODEC_ENTRY_ANCIENT)
    if get pref(PREF_ENDING_DIVER, 0) then codecSeeCard(CODEC_ENTRY_ALBUM)

    texture reserve texture id(TEX_ENDING_REEF), "Fish/Textures/ending_reef"
    texture reserve texture id(TEX_ENDING_ANCIENT), "Fish/Textures/ending_ancient"
    texture reserve texture id(TEX_ENDING_ALBUM), "Fish/Textures/ending_album"
    texture reserve texture id(TEX_CODEC_DIVER), "Fish/Textures/codec_diver"
    texture reserve texture id(TEX_CROOKED), "Fish/Textures/Cards/crooked_bar"
    texture reserve texture id(TEX_CODEC_RADIO), "Fish/Textures/Cards/radio"
    texture reserve texture id(TEX_CODEC_NIGHT), "Fish/Textures/Cards/night_dive"

    ` what a locked entry has for a picture is a question mark, and not a lock, whatever the names say
    texture reserve texture id(TEX_LOCK), "Fish/Textures/Cards/question"

    ` the tiles of one page. each one is the art of a card, with a lock to go on top of it while it is
    ` locked. refreshCodec gives them the pictures of the page that is showing.
    ` the art is 48 pixels across, and is drawn at half of that.
    for codecI = 0 to CODEC_PAGE_SIZE - 1
        codecX = getCodecTileX(codecI)
        codecY = getCodecTileY(codecI)

        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, codecX, codecY, TEX_LOCK
        set sprite offset codecSprite, .5, .5
        size sprite codecSprite, 24, 24
        order sprite codecSprite, ORDER_MENU_TEXT
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_ICON_SPRITES(codecI) = codecSprite

        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, codecX, codecY, TEX_LOCK
        set sprite offset codecSprite, .5, .5
        size sprite codecSprite, 16, 16
        color sprite codecSprite, rgb(120, 140, 185)
        order sprite codecSprite, ORDER_MENU_TEXT + 1
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_LOCK_SPRITES(codecI) = codecSprite
    next

    ` the check mark of a quest that has been finished, on the corner of its tile, and one more by the
    ` big picture. refreshCodec shows the ones that are wanted.
    for codecI = 0 to CODEC_PAGE_SIZE
        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, getCodecTileX(codecI) + 11, getCodecTileY(codecI) + 11, TEX_Q_CHECK
        set sprite offset codecSprite, .5, .5
        size sprite codecSprite, 14, 14
        color sprite codecSprite, rgb(140, 235, 150)
        order sprite codecSprite, ORDER_MENU_TEXT + 2
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_CHECK_SPRITES(codecI) = codecSprite
    next
    position sprite CODEC_CHECK_SPRITES(CODEC_PAGE_SIZE), CODEC_X + 66, CODEC_DETAIL_TOP + 60
    size sprite CODEC_CHECK_SPRITES(CODEC_PAGE_SIZE), 21, 21

    ` the fish behind the fish in the picture of "stacked". refreshCodec puts them where they go.
    for codecI = 0 to 1
        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, 0, 0, TEX_LOCK
        set sprite offset codecSprite, .5, .5
        order sprite codecSprite, ORDER_MENU_TEXT - 1
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_STACK_SPRITES(codecI) = codecSprite
    next

    ` the heart over the fish in the picture of "heart home". refreshCodec puts them where they go.
    for codecI = 0 to 1
        codecSprite = 0
        reserve sprite id(codecSprite)
        sprite codecSprite, 0, 0, TEX_ENDING_REEF
        set sprite offset codecSprite, .5, .5
        color sprite codecSprite, rgb(255, 125, 155)
        order sprite codecSprite, ORDER_MENU_TEXT + 1
        set sprite render target codecSprite, TARGET_MENU
        hide sprite codecSprite
        CODEC_HEART_SPRITES(codecI) = codecSprite
    next

    ` the arrows at the two ends of the grid, and the page number in the corner of the panel
    codecGridMiddle = CODEC_TOP + 26 + (CODEC_ROWS - 1) * CODEC_TILE / 2
    CODEC_ARROW_TEXTS(0) = createHighscoreText(CODEC_X + 26, codecGridMiddle - 20, 40, "<")
    CODEC_ARROW_TEXTS(1) = createHighscoreText(CODEC_X + CODEC_WIDTH - 26, codecGridMiddle - 20, 40, ">")
    CODEC_PAGE_TEXT_ID = createHighscoreText(CODEC_X + CODEC_WIDTH - 8, CODEC_TOP - 20, 16, "page 1 of 1")
    set text offset CODEC_PAGE_TEXT_ID, 1, 0
    color text CODEC_PAGE_TEXT_ID, rgb(64, 128, 255)

    ` how many upgrades have been found, under the title
    CODEC_COUNT_TEXT_ID = createHighscoreText(WORLD_WIDTH / 2, CODEC_TOP - 20, 16, "0 of 0 found")
    color text CODEC_COUNT_TEXT_ID, rgb(150, 190, 255)

    ` a line across the panel, between the grid and what explains the highlighted tile
    reserve sprite id(CODEC_DIVIDER_SPRITE)
    sprite CODEC_DIVIDER_SPRITE, CODEC_X + 8, CODEC_DETAIL_TOP - 6, TEX_PIXEL
    set sprite offset CODEC_DIVIDER_SPRITE, 0, 0
    size sprite CODEC_DIVIDER_SPRITE, CODEC_WIDTH - 16, 1
    color sprite CODEC_DIVIDER_SPRITE, rgb(64, 128, 255, 120)
    order sprite CODEC_DIVIDER_SPRITE, ORDER_MENU_PANEL + 1
    set sprite render target CODEC_DIVIDER_SPRITE, TARGET_MENU
    hide sprite CODEC_DIVIDER_SPRITE

    ` the highlighted tile, explained: a big picture of it, its name, what kind of upgrade it is, and what it does
    reserve sprite id(CODEC_BIG_SPRITE)
    sprite CODEC_BIG_SPRITE, CODEC_X + 44, CODEC_DETAIL_TOP + 40, TEX_LOCK
    set sprite offset CODEC_BIG_SPRITE, .5, .5
    size sprite CODEC_BIG_SPRITE, 48, 48
    order sprite CODEC_BIG_SPRITE, ORDER_MENU_TEXT
    set sprite render target CODEC_BIG_SPRITE, TARGET_MENU
    hide sprite CODEC_BIG_SPRITE

    CODEC_NAME_TEXT_ID = createHighscoreText(CODEC_X + 86, CODEC_DETAIL_TOP, 24, "name")
    set text offset CODEC_NAME_TEXT_ID, 0, 0

    CODEC_KIND_TEXT_ID = createHighscoreText(CODEC_X + 86, CODEC_DETAIL_TOP + 25, 16, "kind")
    set text offset CODEC_KIND_TEXT_ID, 0, 0
    enable rich text CODEC_KIND_TEXT_ID
    color text CODEC_KIND_TEXT_ID, rgb(64, 128, 255)

    ` there is room for three lines of this, and no more. the tests check every entry: see codec_texts_fit_in_their_slot.
    CODEC_DESC_TEXT_ID = createHighscoreText(CODEC_X + 86, CODEC_DETAIL_TOP + 43, 16, "desc")
    set text offset CODEC_DESC_TEXT_ID, 0, 0
    set text wrap CODEC_DESC_TEXT_ID, CODEC_WIDTH - 100
    color text CODEC_DESC_TEXT_ID, rgb(150, 190, 255)

    CODEC_CURSOR = createMenuBorder(ORDER_MENU_CURSOR)
    showInfoBorder(CODEC_CURSOR, 0)
return


` "Codec" on the main menu, or on the pause menu. show the codec, in place of the menu, until the player backs out.
menu_run_codec:
    openCodec()
    refreshCodec()

    do
        gosub frame_codec
        sync

        ` these are checked after the frame, so that the press that picked "Codec" is not the press that leaves
        if new action down(ACT_CONFIRM) then exit
        if new action down(ACT_PAUSE) then exit

        ` left and right go along the row. going off of either end of it turns the page, and the pages
        ` go around. up and down go between the rows.
        codecPage = CODEC_SELECTED / CODEC_PAGE_SIZE
        codecSlot = CODEC_SELECTED mod CODEC_PAGE_SIZE
        codecRow = codecSlot / CODEC_COLUMNS
        codecCol = codecSlot mod CODEC_COLUMNS
        codecPageCount = getCodecPageCount()
        codecMoved = 0
        if new action down(ACT_RIGHT)
            codecCol = codecCol + 1
            codecNext = codecPage * CODEC_PAGE_SIZE + codecRow * CODEC_COLUMNS + codecCol
            if codecCol >= CODEC_COLUMNS or codecNext >= CODEC_COUNT
                codecCol = 0
                codecPage = codecPage + 1
                if codecPage >= codecPageCount then codecPage = 0
            endif
            codecMoved = 1
        endif
        if new action down(ACT_LEFT)
            codecCol = codecCol - 1
            if codecCol < 0
                codecCol = CODEC_COLUMNS - 1
                codecPage = codecPage - 1
                if codecPage < 0 then codecPage = codecPageCount - 1
            endif
            codecMoved = 1
        endif
        if new action down(ACT_DOWN)
            codecRow = codecRow + 1
            if codecRow >= CODEC_ROWS then codecRow = 0
            codecMoved = 1
        endif
        if new action down(ACT_UP)
            codecRow = codecRow - 1
            if codecRow < 0 then codecRow = CODEC_ROWS - 1
            codecMoved = 1
        endif

        if codecMoved
            ` the last page may not be full. a spot with no tile on it gives way to the top row, and
            ` then to the last tile that there is.
            codecNext = codecPage * CODEC_PAGE_SIZE + codecRow * CODEC_COLUMNS + codecCol
            if codecNext >= CODEC_COUNT then codecNext = codecPage * CODEC_PAGE_SIZE + codecCol
            if codecNext >= CODEC_COUNT then codecNext = CODEC_COUNT - 1
            CODEC_SELECTED = codecNext
            refreshCodec()

            ` the same swell of sound that the highlight of the menu makes when it moves
            create basic tween SWAP_TWEEN_SFX, 0, 1, 150, 0
            set tween type SWAP_TWEEN_SFX, 1
        endif
    loop

    ` back to whichever menu the codec was opened from, with "Codec" highlighted again
    closeCodec()
    if MENU_MODE = MENU_MODE_PAUSE
        setMenuPage(MENU_PAGE_PAUSE)
    else
        setMenuPage(MENU_PAGE_MAIN)
    endif
    selectMenuItem(getMenuRow(MENU_ITEM_CODEC), 0)
return


` everything on the codec that changes from frame to frame
frame_codec:
    codecPulse# = .8 + .2 * sin(game ms() * .006)
    colorInfoBorder(CODEC_CURSOR, rgb(255, 255, 255, 255 * codecPulse#))

    gosub frame_menu_render
return


routines_codec_exit:


` a card has been seen in a game, so it is unlocked in the codec from now on. it was offered on the
` upgrade screen, or it was given to the player. this unlocks the entries that are not cards, too.
function codecSeeCard(cardIndex)
    if cardIndex >= 0 and cardIndex < CODEC_COUNT
        if CODEC_SEEN(cardIndex) = 0
            CODEC_SEEN(cardIndex) = 1
            set pref getCodecPref(cardIndex), 1
        endif
    endif
endfunction


` where the preferences keep whether an entry has been seen. the cards have a run of them, and the first
` few of the entries that are not cards have another. the ones after those have a third, because the
` second one ran out of room.
function getCodecPref(prefEntry)
    prefSlot = CODEC_PREF + prefEntry
    if prefEntry >= CARD_LENGTH
        prefExtra = prefEntry - CARD_LENGTH
        prefSlot = CODEC_PREF_EXTRA + prefExtra
        if prefExtra >= CODEC_PREF_EXTRA_ROOM
            prefSlot = CODEC_PREF_MORE + (prefExtra - CODEC_PREF_EXTRA_ROOM)
        endif

        ` the quests have a run of their own, by the number of the quest
        if prefExtra >= CODEC_EXTRA_COUNT
            prefSlot = QUEST_PREF_SEEN + 1 + (prefExtra - CODEC_EXTRA_COUNT)
        endif
    endif
endfunction prefSlot


` which quest an entry of the codec is, or 0 for an entry that is not a quest
function getCodecQuest(questEntry)
    codecQuest = 0
    if CODEC_ENTRY_QUEST >= 0
        if questEntry >= CODEC_ENTRY_QUEST then codecQuest = questEntry + 1 - CODEC_ENTRY_QUEST
    endif
endfunction codecQuest


` the board has settled. whatever is on it that the codec has an entry for is unlocked: the special
` fish, and what can happen to a fish. handle_combos calls this.
function codecSeeBoard()
    for seeI = 0 to CELL_COUNT - 1
        seeKind = CELLS(seeI).value
        seeEntry = -1
        if seeKind = TEX_JELLY then seeEntry = CODEC_ENTRY_JELLY
        if seeKind = TEX_RAY then seeEntry = CODEC_ENTRY_RAY
        if seeKind = TEX_BOTTLE then seeEntry = CODEC_ENTRY_BOTTLE
        codecSeeCard(seeEntry)

        seeEntry = -1
        if CELLS(seeI).bellyUp = 1 then seeEntry = CODEC_ENTRY_BELLY
        if CELLS(seeI).bellyUp = 2 then seeEntry = CODEC_ENTRY_SKELETON
        codecSeeCard(seeEntry)

        seeEntry = -1
        if CELLS(seeI).stack > 0 then seeEntry = CODEC_ENTRY_STACK
        codecSeeCard(seeEntry)

        ` a fish that is sitting on coral that is well
        seeEntry = -1
        if CORAL_CELLS(seeI) > CORAL_SICK(seeI)
            if seeKind > 0 then seeEntry = CODEC_ENTRY_HOME
        endif
        codecSeeCard(seeEntry)
    next
endfunction


` the picture of an entry. a card has its art. coral and horror coral have the badges that the table
` of high scores gives to the two endings, which are 16 pixels across, where the art of a card is 48.
` the two endings have a heart and an eye, which are 16 pixels across as well.
function getCodecEntryTex(entryIndex)
    entryTex = TEX_BADGE_CORAL
    if entryIndex = CODEC_ENTRY_HORROR then entryTex = TEX_BADGE_TENTACLE
    if entryIndex = CODEC_ENTRY_REEF then entryTex = TEX_ENDING_REEF
    if entryIndex = CODEC_ENTRY_ANCIENT then entryTex = TEX_ENDING_ANCIENT

    ` the special fish are their own pictures. the goldfish stands in for any fish that something has happened to.
    if entryIndex = CODEC_ENTRY_JELLY then entryTex = TEX_JELLY
    if entryIndex = CODEC_ENTRY_RAY then entryTex = TEX_RAY
    if entryIndex = CODEC_ENTRY_BOTTLE then entryTex = TEX_BOTTLE
    if entryIndex = CODEC_ENTRY_BELLY then entryTex = CODEC_FISH_TEX
    if entryIndex = CODEC_ENTRY_SKELETON then entryTex = SKELETON_TEX(CODEC_FISH_TEX)
    if entryIndex = CODEC_ENTRY_STACK then entryTex = CODEC_FISH_TEX
    if entryIndex = CODEC_ENTRY_HOME then entryTex = CODEC_FISH_TEX
    if entryIndex = CODEC_ENTRY_TUNA then entryTex = CODEC_TUNA_TEX
    if entryIndex = CODEC_ENTRY_CROOKED then entryTex = TEX_CROOKED
    if entryIndex = CODEC_ENTRY_DIVER then entryTex = TEX_CODEC_DIVER
    if entryIndex = CODEC_ENTRY_ALBUM then entryTex = TEX_ENDING_ALBUM
    if entryIndex = CODEC_ENTRY_RADIO then entryTex = TEX_CODEC_RADIO
    if entryIndex = CODEC_ENTRY_SING then entryTex = TEX_CODEC_RADIO
    if entryIndex = CODEC_ENTRY_SONG then entryTex = TEX_CODEC_RADIO
    if entryIndex = CODEC_ENTRY_CTHULHU then entryTex = TEX_BADGE_TENTACLE
    if entryIndex = CODEC_ENTRY_NIGHT then entryTex = TEX_CODEC_NIGHT

    ` a quest has the picture that is on its badge
    entryQuest = getCodecQuest(entryIndex)
    if entryQuest > 0 then entryTex = QUEST_DEFS(entryQuest).iconTex
    if entryIndex < CARD_LENGTH then entryTex = CARDS(entryIndex).artTexId
endfunction entryTex


` how many pages the grid has
function getCodecPageCount()
    pageCount = (CODEC_COUNT + CODEC_PAGE_SIZE - 1) / CODEC_PAGE_SIZE
    if pageCount < 1 then pageCount = 1
endfunction pageCount


` where the middle of a tile is on the screen. the tiles of a page are numbered along the top row and
` then along the next. the grid is in the middle of the panel.
function getCodecTileX(tileSlot)
    gridLeft = CODEC_X + (CODEC_WIDTH - CODEC_COLUMNS * CODEC_TILE) / 2
    tileX = gridLeft + CODEC_TILE / 2 + (tileSlot mod CODEC_COLUMNS) * CODEC_TILE
endfunction tileX

function getCodecTileY(tileSlot)
    tileY = CODEC_TOP + 26 + (tileSlot / CODEC_COLUMNS) * CODEC_TILE
endfunction tileY


` show the codec, in place of the list of the menu. the high scores take the menu apart the same way.
function openCodec()
    openHighscoreChrome(CODEC_X, CODEC_TOP, CODEC_WIDTH, CODEC_HEIGHT)

    ` the codec is tall, so the title moves up to make room for it. closeCodec puts it back.
    MENU_TITLE_Y = CODEC_TOP - 40
    set text MENU_TITLE_TEXT_ID, "Codec"
    size text y MENU_TITLE_TEXT_ID, 36

    set text MENU_HINT_TEXT_ID, "{dir} choose    {confirm} back"
    size text y MENU_HINT_TEXT_ID, 16

    ` refreshCodec shows the tiles, because how many there are depends on the page
    show text CODEC_COUNT_TEXT_ID
    show text CODEC_PAGE_TEXT_ID
    show text CODEC_ARROW_TEXTS(0)
    show text CODEC_ARROW_TEXTS(1)
    show sprite CODEC_DIVIDER_SPRITE
    show sprite CODEC_BIG_SPRITE
    show text CODEC_NAME_TEXT_ID
    show text CODEC_KIND_TEXT_ID
    show text CODEC_DESC_TEXT_ID
    showInfoBorder(CODEC_CURSOR, 1)
endfunction


` put the codec away, and give the menu back its title, its panel and its list.
` setMenuPage has to be called after this, to lay the list out again.
function closeCodec()
    for i = 0 to CODEC_PAGE_SIZE - 1
        hide sprite CODEC_ICON_SPRITES(i)
        hide sprite CODEC_LOCK_SPRITES(i)
    next
    hide sprite CODEC_STACK_SPRITES(0)
    hide sprite CODEC_STACK_SPRITES(1)
    hide sprite CODEC_HEART_SPRITES(0)
    hide sprite CODEC_HEART_SPRITES(1)
    for i = 0 to CODEC_PAGE_SIZE
        hide sprite CODEC_CHECK_SPRITES(i)
    next
    hide text CODEC_COUNT_TEXT_ID
    hide text CODEC_PAGE_TEXT_ID
    hide text CODEC_ARROW_TEXTS(0)
    hide text CODEC_ARROW_TEXTS(1)
    hide sprite CODEC_DIVIDER_SPRITE
    hide sprite CODEC_BIG_SPRITE
    hide text CODEC_NAME_TEXT_ID
    hide text CODEC_KIND_TEXT_ID
    hide text CODEC_DESC_TEXT_ID
    showInfoBorder(CODEC_CURSOR, 0)

    MENU_TITLE_Y = 62
    showMenuChrome(1)
endfunction


` put the page that the highlighted entry is on onto the tiles, color every tile by whether it is
` locked, put the outline on the highlighted one, and explain it.
function refreshCodec()
    foundCount = 0
    for i = 0 to CODEC_COUNT - 1
        if CODEC_SEEN(i) then foundCount = foundCount + 1
    next
    set text CODEC_COUNT_TEXT_ID, str$(foundCount) + " of " + str$(CODEC_COUNT) + " found"

    pageNow = CODEC_SELECTED / CODEC_PAGE_SIZE
    pageCount = getCodecPageCount()
    set text CODEC_PAGE_TEXT_ID, "page " + str$(pageNow + 1) + " of " + str$(pageCount)

    ` the arrows are only lit when there is another page to turn to
    arrowColor = rgb(64, 128, 255, 60)
    if pageCount > 1 then arrowColor = rgb(255, 255, 255)
    color text CODEC_ARROW_TEXTS(0), arrowColor
    color text CODEC_ARROW_TEXTS(1), arrowColor

    ` the fish behind the fish of "stacked" only show while that entry does, and is unlocked
    hide sprite CODEC_STACK_SPRITES(0)
    hide sprite CODEC_STACK_SPRITES(1)
    rotate sprite CODEC_BIG_SPRITE, 0

    ` and the same goes for the heart of "heart home"
    hide sprite CODEC_HEART_SPRITES(0)
    hide sprite CODEC_HEART_SPRITES(1)

    ` and for the check marks of the quests that have been finished
    for i = 0 to CODEC_PAGE_SIZE
        hide sprite CODEC_CHECK_SPRITES(i)
    next

    for i = 0 to CODEC_PAGE_SIZE - 1
        shownEntry = pageNow * CODEC_PAGE_SIZE + i
        rotate sprite CODEC_ICON_SPRITES(i), 0
        if shownEntry < CODEC_COUNT
            ` the size is set again, because it is worked out from the size of the texture
            ` the art of a card is drawn at half of its size, and a badge at twice its size
            tileSize = 24
            if shownEntry >= CARD_LENGTH then tileSize = 32
            set sprite texture CODEC_ICON_SPRITES(i), getCodecEntryTex(shownEntry)
            size sprite CODEC_ICON_SPRITES(i), tileSize, tileSize
            show sprite CODEC_ICON_SPRITES(i)

            if CODEC_SEEN(shownEntry)
                hide sprite CODEC_LOCK_SPRITES(i)

                ` the art of a card is white, so it is tinted like the text of the menu is, and the
                ` highlighted one is left white.
                tileColor = rgb(150, 190, 255)
                if shownEntry = CODEC_SELECTED then tileColor = rgb(255, 255, 255)

                ` the picture of a fish has colors of its own, which a tint would muddy, so it is only dimmed
                if shownEntry >= CODEC_ENTRY_JELLY and shownEntry <> CODEC_SELECTED
                    tileColor = rgb(190, 190, 190)
                endif

                ` the pictures of the radio, and of its signals, are white, like the art of a card, and so is the one of the night
                if shownEntry >= CODEC_ENTRY_RADIO and shownEntry <> CODEC_SELECTED
                    if shownEntry <= CODEC_ENTRY_NIGHT
                        tileColor = rgb(150, 190, 255)
                    endif
                endif
                color sprite CODEC_ICON_SPRITES(i), tileColor

                ` a belly up fish is upside down
                if shownEntry = CODEC_ENTRY_BELLY
                    rotate sprite CODEC_ICON_SPRITES(i), 3.14159
                endif

                ` and a stacked one has another fish behind it, up and to the left
                if shownEntry = CODEC_ENTRY_STACK
                    set sprite texture CODEC_STACK_SPRITES(0), CODEC_FISH_TEX
                    size sprite CODEC_STACK_SPRITES(0), tileSize, tileSize
                    position sprite CODEC_STACK_SPRITES(0), getCodecTileX(i) - 5, getCodecTileY(i) - 5
                    color sprite CODEC_STACK_SPRITES(0), rgb(90, 115, 165)
                    show sprite CODEC_STACK_SPRITES(0)
                endif

                ` a quest that has been finished, in any game, has a check mark on the corner of its tile
                shownQuest = getCodecQuest(shownEntry)
                if shownQuest > 0
                    if QUEST_EVER_DONE(shownQuest)
                        show sprite CODEC_CHECK_SPRITES(i)
                    endif
                endif

                ` and one that is at home has a heart coming up from it
                if shownEntry = CODEC_ENTRY_HOME
                    size sprite CODEC_HEART_SPRITES(0), 12, 12
                    position sprite CODEC_HEART_SPRITES(0), getCodecTileX(i) + 9, getCodecTileY(i) - 12
                    show sprite CODEC_HEART_SPRITES(0)
                endif
            else
                ` a locked tile is only a question mark. its picture would give it away.
                show sprite CODEC_LOCK_SPRITES(i)
                hide sprite CODEC_ICON_SPRITES(i)
            endif
        else
            ` the last page may not be full
            hide sprite CODEC_ICON_SPRITES(i)
            hide sprite CODEC_LOCK_SPRITES(i)
        endif
    next

    selectedSlot = CODEC_SELECTED mod CODEC_PAGE_SIZE
    movePageOutline(CODEC_CURSOR, getCodecTileX(selectedSlot) - 18, getCodecTileY(selectedSlot) - 18, 36, 36)

    ` the highlighted tile, explained. a locked one only says how to find it.
    if CODEC_SEEN(CODEC_SELECTED) = 0
        set sprite texture CODEC_BIG_SPRITE, TEX_LOCK
        size sprite CODEC_BIG_SPRITE, 48, 48
        color sprite CODEC_BIG_SPRITE, rgb(120, 140, 185)

        set text CODEC_NAME_TEXT_ID, "? ? ?"
        color text CODEC_NAME_TEXT_ID, rgb(120, 140, 185)
        set text CODEC_KIND_TEXT_ID, "locked"
        set text CODEC_DESC_TEXT_ID, "Not found yet. It turns up on the upgrade screen."

        ` the ones that are not cards do not turn up there, and nothing says where they do
        if CODEC_SELECTED >= CARD_LENGTH
            set text CODEC_DESC_TEXT_ID, "Not found yet. No upgrade will bring it."
        endif

        ` the special fish, and what can happen to a fish, are found on the board
        if CODEC_SELECTED >= CODEC_ENTRY_JELLY
            set text CODEC_DESC_TEXT_ID, "Not found yet. It turns up on the board."
        endif

        ` the diver, and its ending, are secrets, like the two endings of the coral, and nothing says where they are
        if CODEC_SELECTED = CODEC_ENTRY_DIVER
            set text CODEC_DESC_TEXT_ID, "Not found yet. No upgrade will bring it."
        endif
        if CODEC_SELECTED = CODEC_ENTRY_ALBUM
            set text CODEC_DESC_TEXT_ID, "Not found yet. No upgrade will bring it."
        endif

        ` a quest turns up with a round
        if getCodecQuest(CODEC_SELECTED) > 0
            set text CODEC_DESC_TEXT_ID, "Not found yet. It turns up as the quest of a round."
        endif

        ` and the QR code is not on the board, or anywhere, until it is asked for
        if CODEC_SELECTED = CODEC_ENTRY_TUNA
            set text CODEC_DESC_TEXT_ID, "Not found yet. It has to be signaled. The Underwater Notes Await."
        endif

        ` the radio is there for whoever holds on, and it knows the signals
        if CODEC_SELECTED = CODEC_ENTRY_RADIO
            set text CODEC_DESC_TEXT_ID, "Not found yet. Hold on, and somebody may be listening."
        endif
        if CODEC_SELECTED > CODEC_ENTRY_RADIO
            if CODEC_SELECTED <= CODEC_ENTRY_CTHULHU
                set text CODEC_DESC_TEXT_ID, "Not found yet. The radio knows it."
            endif
        endif

        ` the night is found by whoever watches which way the water is going. see fish_headers_tide.
        if CODEC_SELECTED = CODEC_ENTRY_NIGHT
            set text CODEC_DESC_TEXT_ID, "Not found yet. The water comes in, and it goes out."
        endif
    else
        ` the size is set again, because it is worked out from the size of the texture
        set sprite texture CODEC_BIG_SPRITE, getCodecEntryTex(CODEC_SELECTED)
        size sprite CODEC_BIG_SPRITE, 48, 48
        color sprite CODEC_BIG_SPRITE, rgb(255, 255, 255)
        color text CODEC_NAME_TEXT_ID, rgb(255, 255, 255)

        ` coral and horror coral say what info mode says about them in a game
        if CODEC_SELECTED = CODEC_ENTRY_REEF
            set text CODEC_NAME_TEXT_ID, "The Reef, Saved"
            set text CODEC_DESC_TEXT_ID, "You listened."
            set text CODEC_KIND_TEXT_ID, "ending"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_ANCIENT
            set text CODEC_NAME_TEXT_ID, "The Ancient One"
            set text CODEC_DESC_TEXT_ID, "You listened to something dark."
            set text CODEC_KIND_TEXT_ID, "ending"
            exitfunction
        endif
        ` the diver says what info mode says about it in a game, and its ending has words of its own. see fish_headers_diver.
        if CODEC_SELECTED = CODEC_ENTRY_DIVER
            set text CODEC_NAME_TEXT_ID, INFOS(INFO_INDEX_DIVER).title$
            set text CODEC_DESC_TEXT_ID, INFOS(INFO_INDEX_DIVER).desc$
            set text CODEC_KIND_TEXT_ID, "secret"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_ALBUM
            set text CODEC_NAME_TEXT_ID, "The Album, Filled"
            set text CODEC_DESC_TEXT_ID, "The ocean is wonderful, and it is always nice to visit"
            set text CODEC_KIND_TEXT_ID, "ending"
            exitfunction
        endif
        ` the special fish
        if CODEC_SELECTED = CODEC_ENTRY_JELLY
            set text CODEC_NAME_TEXT_ID, "Jellyfish"
            set text CODEC_DESC_TEXT_ID, "Comes with the jellies card. When it pops, each fish next to it has a " + str$(JELLY_STING_CHANCE) + "% chance to go belly up, then skeletal."
            set text CODEC_KIND_TEXT_ID, "special fish"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_RAY
            set text CODEC_NAME_TEXT_ID, "Stingray"
            set text CODEC_DESC_TEXT_ID, "Comes with the rays card. When it pops, it clears its column the way it faces: up, or down if it is belly up."
            set text CODEC_KIND_TEXT_ID, "special fish"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_BOTTLE
            set text CODEC_NAME_TEXT_ID, "Bottle"
            set text CODEC_DESC_TEXT_ID, "With the bottles card, a group of " + str$(BOTTLE_GROUP_SIZE) + " or more leaves one behind. On the bottom row, it adds " + str$(BOTTLE_MULT_GAIN) + " to the multiplier."
            set text CODEC_KIND_TEXT_ID, "special fish"
            exitfunction
        endif

        ` and what can happen to a fish
        if CODEC_SELECTED = CODEC_ENTRY_BELLY
            rotate sprite CODEC_BIG_SPRITE, 3.14159
            set text CODEC_NAME_TEXT_ID, "Belly Up"
            set text CODEC_DESC_TEXT_ID, "A fish that floats upside down. It pops when the cursor comes to it, and so does every belly up fish next to it."
            set text CODEC_KIND_TEXT_ID, "status"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_SKELETON
            set text CODEC_NAME_TEXT_ID, "Skeletal"
            set text CODEC_DESC_TEXT_ID, "The bones of a fish. A fish that is swapped can make its group through skeletons of any kind. Death is the great equalizer."
            set text CODEC_KIND_TEXT_ID, "status"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_STACK
            set sprite texture CODEC_STACK_SPRITES(1), CODEC_FISH_TEX
            size sprite CODEC_STACK_SPRITES(1), 48, 48
            position sprite CODEC_STACK_SPRITES(1), CODEC_X + 36, CODEC_DETAIL_TOP + 32
            color sprite CODEC_STACK_SPRITES(1), rgb(90, 115, 165)
            show sprite CODEC_STACK_SPRITES(1)
            set text CODEC_NAME_TEXT_ID, "Stacked"
            set text CODEC_DESC_TEXT_ID, "More fish, stacked up behind one. When it pops, each fish in the stack pops first, and scores, and does what that fish does."
            set text CODEC_KIND_TEXT_ID, "status"
            exitfunction
        endif

        if CODEC_SELECTED = CODEC_ENTRY_HOME
            size sprite CODEC_HEART_SPRITES(1), 20, 20
            position sprite CODEC_HEART_SPRITES(1), CODEC_X + 60, CODEC_DETAIL_TOP + 18
            show sprite CODEC_HEART_SPRITES(1)
            set text CODEC_NAME_TEXT_ID, "Coral Home"
            set text CODEC_DESC_TEXT_ID, "Happy fish come from happy coral homes. They don't leave, they just score " + str$(CORAL_SCORE_BONUS) + " times as much."
            set text CODEC_KIND_TEXT_ID, "status"
            exitfunction
        endif

        if CODEC_SELECTED = CODEC_ENTRY_TUNA
            set text CODEC_NAME_TEXT_ID, "Donate"
            codecSignalText(MORSE_WORD_TUNA, "Type TUNA, or tap it out: ", ". The fish make a QR code. Read it with a phone, and help a coral reef.")
            set text CODEC_KIND_TEXT_ID, "secret"
            exitfunction
        endif

        ` the radio, which only gives one signal away, and the signals that have an entry of their
        ` own. SOS has none. see MORSE in fish_headers.
        if CODEC_SELECTED = CODEC_ENTRY_RADIO
            set text CODEC_NAME_TEXT_ID, "Radio"
            codecSignalText(MORSE_WORD_CQ, "Hold one button for " + str$(MORSE_WAKE_MS / 1000) + " seconds to turn it on, then tap in Morse code. To call anyone, CQ: ", ". Something may answer.")
            set text CODEC_KIND_TEXT_ID, "secret"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_SING
            set text CODEC_NAME_TEXT_ID, "Sing"
            codecSignalText(MORSE_WORD_SING, "Tap out SING on the radio: ", ". A hint of the hidden game plays, the bright way, with a trail.")
            set text CODEC_KIND_TEXT_ID, "signal"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_SONG
            set text CODEC_NAME_TEXT_ID, "Song"
            codecSignalText(MORSE_WORD_SONG, "Tap out SONG on the radio: ", ". A hint of the hidden game plays, the bright way, with a trail.")
            set text CODEC_KIND_TEXT_ID, "signal"
            exitfunction
        endif
        if CODEC_SELECTED = CODEC_ENTRY_CTHULHU
            set text CODEC_NAME_TEXT_ID, "Cthulhu"
            codecSignalText(MORSE_WORD_CTHULHU, "Tap out CTHULHU on the radio: ", ". Something comes up to see who called.")
            set text CODEC_KIND_TEXT_ID, "signal"
            exitfunction
        endif

        ` see THE NIGHT IN THE CODEC in fish_headers_tide
        if CODEC_SELECTED = CODEC_ENTRY_NIGHT
            set text CODEC_NAME_TEXT_ID, "Night Dive"
            set text CODEC_DESC_TEXT_ID, "Pop with the fish you shove aside to pull the tide out, then the one you carry to push it in. " + str$(TIDE_CYCLES_TO_TURN) + " tides bring the night."
            set text CODEC_KIND_TEXT_ID, "secret"
            exitfunction
        endif

        ` see DIAGONALS in fish_headers
        if CODEC_SELECTED = CODEC_ENTRY_CROOKED
            set text CODEC_NAME_TEXT_ID, "The Crooked Bar"
            set text CODEC_DESC_TEXT_ID, "Swap a fish into a line of " + str$(DIAGONAL_LENGTH) + " of its kind, corner to corner. Each stacks up. The multiplier grows by 1, plus 1 per fish past " + str$(DIAGONAL_LENGTH) + "."
            set text CODEC_KIND_TEXT_ID, "secret"
            exitfunction
        endif

        ` a quest says what info mode says about it in a game, and whether it has ever been finished
        selectedQuest = getCodecQuest(CODEC_SELECTED)
        if selectedQuest > 0
            set text CODEC_NAME_TEXT_ID, QUEST_DEFS(selectedQuest).name$
            set text CODEC_DESC_TEXT_ID, QUEST_DEFS(selectedQuest).desc$
            if QUEST_EVER_DONE(selectedQuest)
                set text CODEC_KIND_TEXT_ID, "quest, completed"
                show sprite CODEC_CHECK_SPRITES(CODEC_PAGE_SIZE)
            else
                set text CODEC_KIND_TEXT_ID, "quest, not completed yet"
            endif
            exitfunction
        endif

        if CODEC_SELECTED >= CARD_LENGTH
            extraInfo = INFO_INDEX_CORAL
            if CODEC_SELECTED = CODEC_ENTRY_HORROR then extraInfo = INFO_INDEX_CORAL_SICK
            set text CODEC_NAME_TEXT_ID, INFOS(extraInfo).title$
            set text CODEC_DESC_TEXT_ID, INFOS(extraInfo).desc$
            set text CODEC_KIND_TEXT_ID, "secret"
            exitfunction
        endif

        set text CODEC_NAME_TEXT_ID, CARDS(CODEC_SELECTED).name$
        set text CODEC_DESC_TEXT_ID, CARDS(CODEC_SELECTED).desc$
        select CARDS(CODEC_SELECTED).abilityType
            case ABILITY_TYPE_PASSIVE
                set text CODEC_KIND_TEXT_ID, "{passive} passive"
            endcase
            case ABILITY_TYPE_MOVE
                set text CODEC_KIND_TEXT_ID, "{move} move"
            endcase
            case ABILITY_TYPE_INSTANT
                set text CODEC_KIND_TEXT_ID, "{instant} instant"
            endcase
        endselect
    endif
endfunction


` what the codec says about a signal: some words, then the dots and dashes of the signal, with
` a gap after every letter, and then some more words. the dots and dashes are worked out from the
` word itself, so they are never wrong. see morseWord, in fish_routines_morse.
function codecSignalText(signalWord, signalLead$, signalTail$)
    signalSays$ = signalLead$
    signalFirst = signalWord * MORSE_SPELL_ROOM
    signalLastSpelt = MORSE_WORD_SPELL_LENGTH(signalWord) - 2
    for signalSpelt = 0 to signalLastSpelt
        signalMark = MORSE_WORD_SPELL(signalFirst + signalSpelt)
        if signalMark = 0 then signalSays$ = signalSays$ + "."
        if signalMark = 1 then signalSays$ = signalSays$ + "-"
        if signalMark = 2 then signalSays$ = signalSays$ + "  "
    next
    set text CODEC_DESC_TEXT_ID, signalSays$ + signalTail$
endfunction
