goto routines_debug_exit

remstart
    THE DEBUG CARDS
    a window in the debug panel, for working on the game, that gives the player any card there is.
    it is only there in debug mode (see DEBUG_MODE in fish_headers), and only while a game is being
    played. frame_dbg, in fish_routines, comes here on every frame.

    there is a button for every card, under the kind of card that it is. a card that is owned has
    how many times it has been taken after its name.
    - a passive is given the way that the upgrade screen gives it. one that can be taken more than
      once is taken once more for every press, with no limit.
    - a move goes into the slot that the slider is on, and whatever was in that slot is gone.
    - an instant happens right away, the way that it does when it is picked.

    debugGiveCard does the passives and the moves, so that the tests can call it.
remend

frame_debug_cards:
    debugLabel$ = "" `debug_card_label, further down, fills this in
    begin debug window("Cards")

    ` the round is over, right away: the points that it still needs are scored, and the upgrade
    ` screen comes up the way that it does for any round that is won. see debugEndRound.
    if debug button("end the round") = 1
        debugEndRound()
    endif
    debug text "fast: " + str$(FAST_STREAK) + " in a row"
    debug separator

    debug text "passives"
    for debugCardI = 0 to CARD_LENGTH - 1
        if CARDS(debugCardI).abilityType = ABILITY_TYPE_PASSIVE
            gosub debug_card_label
            if debug button(debugLabel$) = 1
                debugGiveCard(debugCardI, 0)
            endif
        endif
    next

    debug separator
    debug text "moves"
    if DEBUG_MOVE_SLOT > MOVE_SLOTS_OPEN then DEBUG_MOVE_SLOT = MOVE_SLOTS_OPEN
    debugSlotMoved = debug int slider("into slot", DEBUG_MOVE_SLOT, 1, MOVE_SLOTS_OPEN)
    for debugCardI = 0 to CARD_LENGTH - 1
        if CARDS(debugCardI).abilityType = ABILITY_TYPE_MOVE
            gosub debug_card_label
            if debug button(debugLabel$) = 1
                debugGiveCard(debugCardI, DEBUG_MOVE_SLOT - 1)
            endif
        endif
    next

    ` these go through the same routine that the upgrade screen uses, which looks at selectedAbilityIndex
    debug separator
    debug text "instants"
    for debugCardI = 0 to CARD_LENGTH - 1
        if CARDS(debugCardI).abilityType = ABILITY_TYPE_INSTANT
            gosub debug_card_label
            if debug button(debugLabel$) = 1
                selectedAbilityIndex = debugCardI
                CARDS(debugCardI).uses = CARDS(debugCardI).uses + 1
                codecSeeCard(debugCardI)
                gosub handle_ability_instant_effect
            endif
        endif
    next

    end debug window

    ` the hint of the diagonals, to tune by eye. see THE HINTS OF THE DIAGONALS in fish_headers. the numbers
    ` that are settled on have to be written into fish_headers by hand, because these are gone with the game.
    begin debug window("Diagonal hint")
    debug text "the drift along a line that is one short"
    debugHintMoved = debug float slider("how far (fish sizes)", DIAGONAL_HINT_SHUFFLE#, 0, .4)
    debugHintMoved = debug int slider("how long (ms)", DIAGONAL_HINT_SHUFFLE_MS, 100, 5000)
    debugHintMoved = debug int slider("gap to next fish (ms)", DIAGONAL_HINT_STEP_MS, 0, 2000)
    if debug button("play it now") = 1
        DIAGONAL_HINT_NOW_MS = game ms()
    endif
    debug separator
    debug text "the lean of a pair, as the current passes"
    debugHintMoved = debug float slider("lean (radians)", DIAGONAL_HINT_LEAN#, 0, .6)
    end debug window

    ` the icons of the keys and the buttons, for a device that is not the one in use. the kinds other
    ` than the keyboard and the xbox controller are steam's pictures, so they need steam to be up.
    ` see DEBUG_ICON_FORCE and STEAM'S PICTURES OF THE BUTTONS in fish_headers.
    begin debug window("Input icons")
    debugIconWas = DEBUG_ICON_FORCE
    debugIconSays$ = "as played"
    if DEBUG_ICON_FORCE = 0 then debugIconSays$ = "keyboard"
    if DEBUG_ICON_FORCE = 3 then debugIconSays$ = "xbox (our sheet)"
    if DEBUG_ICON_FORCE = 13 then debugIconSays$ = "playstation 5"
    if DEBUG_ICON_FORCE = 5 then debugIconSays$ = "playstation 4"
    if DEBUG_ICON_FORCE = 10 then debugIconSays$ = "switch pro"
    if DEBUG_ICON_FORCE = 14 then debugIconSays$ = "steam deck"
    if DEBUG_ICON_FORCE = 1 then debugIconSays$ = "steam controller"
    debug text "showing: " + debugIconSays$
    if steam available() = 0 then debug text "steam is not up, so every controller shows the sheet"
    debug separator
    if debug button("as played") = 1 then DEBUG_ICON_FORCE = -1
    if debug button("keyboard") = 1 then DEBUG_ICON_FORCE = 0
    if debug button("xbox (our sheet)") = 1 then DEBUG_ICON_FORCE = 3
    debug separator
    debug text "steam's pictures"
    if debug button("playstation 5") = 1 then DEBUG_ICON_FORCE = 13
    if debug button("playstation 4") = 1 then DEBUG_ICON_FORCE = 5
    if debug button("switch pro") = 1 then DEBUG_ICON_FORCE = 10
    if debug button("steam deck") = 1 then DEBUG_ICON_FORCE = 14
    if debug button("steam controller") = 1 then DEBUG_ICON_FORCE = 1
    end debug window

    ` steam is told too, so that it hands out the pictures of that kind. 0 is whatever is really there.
    if DEBUG_ICON_FORCE <> debugIconWas
        debugIconKind = 0
        if DEBUG_ICON_FORCE > 0 then debugIconKind = DEBUG_ICON_FORCE
        set steam input type debugIconKind
    endif

    ` a slow machine, on this one. every update, and every draw, takes this many milliseconds longer,
    ` and the catch up is how many updates monogame may run before it has to draw (0 is its own,
    ` which is 30). see PerfKnobs in Fade.MonoGame.Game, and the launch options --slow-update,
    ` --slow-draw and --max-catchup, which set the same from the start.
    begin debug window("Slow machine")
    dbgPerfDrawn = perf drawn per second()
    dbgPerfUpdates# = perf updates per draw()
    dbgPerfUpdates10 = dbgPerfUpdates# * 10.0
    debug text "drawn " + str$(dbgPerfDrawn) + " a second, " + str$(dbgPerfUpdates10) + " updates in 10 draws"
    dbgPerfUpdate# = perf slow update()
    if debug float slider("update + ms", dbgPerfUpdate#, 0.0, 40.0) = 1
        set perf slow update dbgPerfUpdate#
    endif
    dbgPerfDraw# = perf slow draw()
    if debug float slider("draw + ms", dbgPerfDraw#, 0.0, 40.0) = 1
        set perf slow draw dbgPerfDraw#
    endif
    dbgPerfCatchUp = perf max catch up()
    if debug int slider("max catch up (0 = 30)", dbgPerfCatchUp, 0, 30) = 1
        set perf max catch up dbgPerfCatchUp
    endif
    if debug button("back to normal") = 1
        set perf slow update 0.0
        set perf slow draw 0.0
        set perf max catch up 3
    endif
    end debug window
return


` what the button of the card debugCardI says: its name, and how many times it has been taken, if it has been
debug_card_label:
    debugLabel$ = CARDS(debugCardI).name$
    if CARDS(debugCardI).uses > 0
        debugLabel$ = debugLabel$ + "  x" + str$(CARDS(debugCardI).uses)
    else
        if CARDS(debugCardI).obtained > 0 then debugLabel$ = debugLabel$ + "  (owned)"
    endif
return


routines_debug_exit:


` score the points that the round still needs, so that it is over. the bar fills, and what comes
` next is what comes after any round: the upgrade screen, or the next round, or the end of the game.
` it does nothing while the bar is full already. the button of the debug panel calls this.
function debugEndRound()
    if SCORE_BAR_HOLD > 0 then exitfunction
    debugEndLeft = SCORE_BAR.endVal - CURRENT_SCORE
    if debugEndLeft < 10 then debugEndLeft = 10

    ` to the next 10 up, like everything else that scores
    debugEndLeft = ((debugEndLeft + 9) / 10) * 10
    queueScore(debugEndLeft, 0)
endfunction


` turn debug mode on: the inspector, the debug windows, and the debug keys. it stays on until the
` game is closed. the game that is being played is marked as one that had it, and so is every game
` after it: see isDebugEnvSet.
function debugModeOn()
    DEBUG_MODE = 1
    GAME_DEBUG_USED = 1
    enable debug inspector
endfunction


` the words "Debug Mode Enabled" splash up in the middle of the screen, for a moment. this is for
` when a player turns debug mode on in the middle of a game, with TUNA, so that they know that it
` happened. `splashNow` is the time, in milliseconds.
function debugSplashStart(splashNow)
    if DEBUG_SPLASH_MADE = 0
        DEBUG_SPLASH_MADE = 1
        reserve text id(DEBUG_SPLASH_TEXT_ID)
        text DEBUG_SPLASH_TEXT_ID, WORLD_WIDTH / 2, WORLD_HEIGHT / 2, SCORE_FONT, "Debug Mode Enabled"
        size text y DEBUG_SPLASH_TEXT_ID, 30
        set text offset DEBUG_SPLASH_TEXT_ID, .5, .5
        color text DEBUG_SPLASH_TEXT_ID, rgb(255, 226, 120)
        enable text drop shadow DEBUG_SPLASH_TEXT_ID, 2, -2, rgb(0, 0, 0)
        order text DEBUG_SPLASH_TEXT_ID, ORDER_INTRO
    endif
    DEBUG_SPLASH_ON = 1
    DEBUG_SPLASH_MS = splashNow
    show text DEBUG_SPLASH_TEXT_ID
    debugSplashStep(splashNow)
endfunction


` move the words along to this time. they pop up from a little lower down, quickly, stay, and fade away.
function debugSplashStep(splashNow)
    if DEBUG_SPLASH_ON = 0
        exitfunction
    endif
    splashAge = splashNow - DEBUG_SPLASH_MS
    if splashAge >= DEBUG_SPLASH_LIFE_MS
        DEBUG_SPLASH_ON = 0
        hide text DEBUG_SPLASH_TEXT_ID
        exitfunction
    endif

    splashAge# = splashAge
    splashIn# = DEBUG_SPLASH_IN_MS
    splashUp# = splashAge# / splashIn#
    if splashUp# > 1
        splashUp# = 1
    endif
    splashDrop# = 1 - splashUp#
    set text position DEBUG_SPLASH_TEXT_ID, WORLD_WIDTH / 2, WORLD_HEIGHT / 2 + 26 * splashDrop# * splashDrop#

    splashLeft# = DEBUG_SPLASH_LIFE_MS - splashAge
    splashOut# = DEBUG_SPLASH_OUT_MS
    splashShown# = splashLeft# / splashOut#
    if splashShown# > 1
        splashShown# = 1
    endif
    if splashUp# < splashShown#
        splashShown# = splashUp#
    endif
    set text alpha DEBUG_SPLASH_TEXT_ID, 255 * splashShown#
endfunction


` give the player a passive, or put a move in a slot, counting from 0. the slot does not matter for a
` passive. a passive that is owned, and can only be taken once, is left alone. a move takes the place
` of whatever was in the slot, and a move that is in some other slot already is moved from there.
function debugGiveCard(giveCard, giveSlot)
    if giveCard < 0 or giveCard >= CARD_LENGTH then exitfunction

    if CARDS(giveCard).abilityType = ABILITY_TYPE_PASSIVE
        giveOk = 1
        if CARDS(giveCard).obtained > 0 and CARDS(giveCard).stackable = 0 then giveOk = 0
        if giveOk
            grantPassive(giveCard)
        endif
    endif

    if CARDS(giveCard).abilityType = ABILITY_TYPE_MOVE
        if giveSlot >= 0 and giveSlot < MOVE_SLOTS_OPEN
            ` whatever is in the slot is gone, and so is this move from wherever else it was
            lastSlot = MOVE_SLOT_COUNT - 1
            for giveN = 0 to lastSlot
                giveGone = 0
                if MOVE_ABILITY_BINDINGS(giveN).assigned
                    if giveN = giveSlot then giveGone = 1
                    if MOVE_ABILITY_BINDINGS(giveN).abilityIndex = giveCard then giveGone = 1
                endif
                if giveGone
                    ejectMove(giveN)
                endif
            next
            grantMoveToSlot(giveCard, giveSlot)
        endif
    endif
endfunction
