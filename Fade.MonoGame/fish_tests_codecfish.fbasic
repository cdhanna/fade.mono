remstart
    THE TESTS OF RAINBOW FISH AND SCHOOLING FISH IN THE CODEC, and of the names of the new entries
    that info mode lists. see CODEC_EXTRA_FISH in fish_headers, and NEW IN THE CODEC in
    fish_headers_teach. fish_tests says how the tests work.
remend

test codec_fish_entries_keep_every_other_preference from fishBoard
    tCfRainbow = getCodecPref(CODEC_ENTRY_RAINBOW)
    tCfSchool = getCodecPref(CODEC_ENTRY_SCHOOL)
    assert tCfRainbow = CODEC_PREF_FISH, "rainbow fish has a run of preferences of its own"
    assert tCfSchool = CODEC_PREF_FISH + 1, "and schooling fish is the next one"

    ` what came before them, and what comes after them, is remembered where it always was
    tCfNight = getCodecPref(CODEC_ENTRY_NIGHT)
    assert tCfNight = CODEC_PREF_MORE + 9, "the night is where it was"
    tCfWord = getCodecPref(CODEC_ENTRY_CAMEO)
    assert tCfWord = CODEC_PREF_CAMEO, "the first word that brings somebody swimming through is where it was"
    tCfCall = getCodecPref(CODEC_ENTRY_CALL)
    assert tCfCall = CODEC_PREF_CAMEO + 9, "the call of the angler is where it was"
    tCfQuest = getCodecPref(CODEC_ENTRY_QUEST)
    assert tCfQuest = QUEST_PREF_SEEN + 1, "the first quest is where it was"
    tCfHome = getCodecPref(CODEC_ENTRY_GOODBYE)
    assert tCfHome = PREF_ENDING_HOME, "the usual ending is where it was"
    end
endtest

test codec_rainbow_fish_is_seen_on_the_board from fishBoard
    CODEC_SEEN(CODEC_ENTRY_RAINBOW) = 0
    codecSeeBoard()
    assert CODEC_SEEN(CODEC_ENTRY_RAINBOW) = 0, "a board with no rainbow fish does not unlock it"

    RAINBOW_FISH(testIndex(2, 2)) = 1
    codecSeeBoard()
    assert CODEC_SEEN(CODEC_ENTRY_RAINBOW) = 1, "a rainbow fish on the board unlocks it"
    assert CODEC_NEW(CODEC_ENTRY_RAINBOW) = 1, "and it is new"
    RAINBOW_FISH(testIndex(2, 2)) = 0
    end
endtest

test codec_every_entry_has_a_name_for_info_mode from fishBoard
    tCfNameless = 0
    tCfLast = CODEC_COUNT - 1
    for tCfEntry = 0 to tCfLast
        tCfName$ = codecEntryName(tCfEntry)
        if tCfName$ = "" then tCfNameless = tCfNameless + 1
    next
    assert tCfNameless = 0, "every entry of the codec has a name that info mode can list"
    assert CODEC_ORDER_COUNT = CODEC_COUNT, "and every entry is in a category"
    end
endtest


` THE THREE OF THE NIGHT (2026-10-27): the squid, the shapes painted in ink, and the ending that they bring.
` they are in the run of rainbow fish and schooling fish, and the entries after them moved along by three.
test codec_has_the_three_of_the_night from fishBoard
    assert CODEC_ENTRY_SQUID = CODEC_ENTRY_SCHOOL + 1, "the squid comes after schooling fish"
    assert CODEC_ENTRY_STARS = CODEC_ENTRY_SQUID + 1, "then the shapes in ink"
    assert CODEC_ENTRY_FAVOR = CODEC_ENTRY_STARS + 1, "then their ending"
    assert getCodecPref(CODEC_ENTRY_SQUID) = CODEC_PREF_FISH + 2, "they are remembered in the run of the fish"
    assert getCodecPref(CODEC_ENTRY_FAVOR) = CODEC_PREF_FISH + 4, "all three"
    assert getCodecPref(CODEC_ENTRY_CAMEO) = CODEC_PREF_CAMEO, "and the words are remembered where they always were"
    assert getCodecPref(CODEC_ENTRY_GOODBYE) = PREF_ENDING_HOME, "and so is the usual ending"

    assert CODEC_SEEN(CODEC_ENTRY_SQUID) = 0, "the squid is locked to begin with"
    SQUID_CELL = testIndex(2, 2)
    codecSeeBoard()
    assert CODEC_SEEN(CODEC_ENTRY_SQUID) = 1, "and a squid on the board unlocks it"
    SQUID_CELL = -1
    tCfKind = spotCodecEntry(SPOT_KIND_SQUID)
    assert tCfKind = CODEC_ENTRY_SQUID, "and its row in the look of info mode has the dot while it is new"

    assert CODEC_SEEN(CODEC_ENTRY_STARS) = 0, "the shapes are locked to begin with"
    starMade(0)
    assert CODEC_SEEN(CODEC_ENTRY_STARS) = 1, "and making one unlocks them"

    codecFindSelected()
    CODEC_SELECTED = CODEC_ENTRY_FAVOR
    codecFindSelected()
    assert CODEC_CAT = 4, "the god's favor is with the endings"
    end
endtest

` SQUEAKY CLEAN (2026-10-28): the ink of the day, after the ending of the night, in the run of the fish
test codec_has_squeaky_clean from fishBoard
    assert CODEC_ENTRY_CLEAN = CODEC_ENTRY_FAVOR + 1, "squeaky clean comes after the ending of the night"
    assert getCodecPref(CODEC_ENTRY_CLEAN) = CODEC_PREF_FISH + 5, "and is remembered in the run of the fish"
    assert getCodecPref(CODEC_ENTRY_CAMEO) = CODEC_PREF_CAMEO, "the words are remembered where they always were"
    assert CODEC_SEEN(CODEC_ENTRY_CLEAN) = 0, "it is locked to begin with"
    tCfTopic = anglerTopicOpen(ANGLER_T_CLEAN)
    assert tCfTopic = 0, "and the angler does not talk about it yet"

    ` a pot pays
    INK_DAY = 1
    INK_CLEAN(testIndex(2, 2)) = 1
    INK_POT = 1
    INK_LAST_WASHED = testIndex(2, 2)
    inkPotPays(0)
    assert CODEC_SEEN(CODEC_ENTRY_CLEAN) = 1, "the first pot that pays unlocks it"
    tCfTopic = anglerTopicOpen(ANGLER_T_CLEAN)
    assert tCfTopic = 1, "and the angler can be asked about it"
    tCfKind = spotCodecEntry(SPOT_KIND_CLEAN)
    assert tCfKind = CODEC_ENTRY_CLEAN, "and the look of a clean cell has its dot while it is new"

    CODEC_SELECTED = CODEC_ENTRY_CLEAN
    codecFindSelected()
    assert CODEC_CAT = 2, "it is one of the secrets"
    end
endtest
