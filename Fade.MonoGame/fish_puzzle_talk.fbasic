` the words of a reply on a text
function puzzleReplyWords(srText, srKind)
    select srKind
        case 0
            set text loc srText, "angler.reply.mm"
        endcase
        case 1
            set text loc srText, "angler.reply.why"
        endcase
        case 2
            set text loc srText, "angler.reply.more"
        endcase
        case 3
            set text loc srText, "angler.reply.dots"
        endcase
    endselect
endfunction
