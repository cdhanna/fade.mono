<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>
    <!-- A shipped game must not open a console window next to the game window on Windows.
         Debug keeps the console, because that is where the reload and build output goes. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>
    <!-- TRIMMING, opt-in: -p:FadeMonoTrim=true on a publish. Set here and not as
         -p:PublishTrimmed=true, because a property given on the command line reaches every
         project, and Facepunch.Steamworks also builds for net46, which cannot be trimmed
         (NETSDK1124). Set in this file, it applies to this project's publish only. -->
    <PropertyGroup Condition="'$(FadeMonoTrim)' == 'true'">
        <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>
    <!-- Kept whole, because they are reached by name at run time, where the trimmer cannot see:
           MonoGame.Framework   every .xnb names the reader that loads it, and MonoGame finds
                                that reader with Type.GetType (warning IL2057).
           Facepunch.Steamworks SteamInputGlyphs calls Steam Input's internal methods by name.
                                Trimmed, they are gone, and the game has no pictures of
                                controller buttons ("Facepunch.Steamworks has no Shutdown").
         Measured 2026-10-16 on win-x64: trimming takes the code from 96 MB to 33 MB. -->
    <!-- A shipped game leaves out the .NET runtime's debugger support: what a debugger attaches
         through (mscordbi, mscordaccore and its versioned copy), the PDB reader, and createdump,
         which only runs when a crash dump has been asked for with DOTNET_DbgEnableMiniDump.
         About 6 MB on Windows, 4 MB on macOS. The game itself runs without any of them; what is
         lost is attaching a debugger to a player's copy, or reading a dump from one. -->
    <Target Name="DropDebuggerSupportFromPublish" AfterTargets="ComputeResolvedFilesToPublishList"
            Condition="'$(Configuration)' != 'Debug'">
        <ItemGroup>
            <_DebuggerSupportFile Include="@(ResolvedFileToPublish)"
                                  Condition="$([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))
                                          OR $([System.String]::Copy('%(Filename)').StartsWith('libmscordaccore'))
                                          OR '%(Filename)' == 'mscordbi' OR '%(Filename)' == 'libmscordbi'
                                          OR $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))
                                          OR '%(Filename)' == 'createdump'" />
            <ResolvedFileToPublish Remove="@(_DebuggerSupportFile)" />
        </ItemGroup>
    </Target>
    <ItemGroup Condition="'$(FadeMonoTrim)' == 'true'">
        <TrimmerRootAssembly Include="MonoGame.Framework" />
        <TrimmerRootAssembly Condition="$(RuntimeIdentifier.StartsWith('win'))" Include="Facepunch.Steamworks.Win64" />
        <TrimmerRootAssembly Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))" Include="Facepunch.Steamworks.Posix" />
    </ItemGroup>
    <!-- Matches the conditional Fade.MonoGame.Content reference below: enables the
         in-process content hot-reload registration in Program.cs for Debug desktop. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(FadeMonoGamePlatform)' != 'Web'">
        <DefineConstants>$(DefineConstants);FADE_CONTENT_HOTRELOAD</DefineConstants>
    </PropertyGroup>
    <!-- A Debug build of the fish game has its debug data in Launch/GeneratedFade.g.cs as one string
         constant, on top of the bytecode. Together they passed what the compiler lets a program have in
         string constants (about 8.39 million characters, error CS8103) in October 2026. This flag has the
         compiler keep long strings as data instead, which has no such limit. It needs the compiler of the
         .NET 9 SDK or later. A Release build has no debug data, is nowhere near the limit, and is left alone. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Features>$(Features);experimental-data-section-string-literals</Features>
    </PropertyGroup>
    <!-- GeneratedFade.g.cs is written once per configuration, under obj/, instead of one file in
         Launch/ that both share. FadeBasic.Build only writes it again when a .fbasic or a reference
         is newer than it, and does not look at the configuration, so a Release build straight after
         a Debug one (a `dotnet test`) used to compile the Debug file: the tests, and the debug data
         that only the flag above lets compile, so it failed with CS8103. Under obj/, it is not
         picked up by the default Compile glob, and the generator only adds it to the build when
         it runs, which an up-to-date build skips: FadeCompileGeneratedLaunch adds it every time. -->
    <PropertyGroup>
        <FadeGeneratedLaunchFile>$(MSBuildProjectDirectory)/obj/$(Configuration)/GeneratedFade.g.cs</FadeGeneratedLaunchFile>
    </PropertyGroup>
    <!-- Whatever else has added it (the generator does when it runs), it is taken out and put
         back once, so that it is never compiled twice (warning CS2002). -->
    <Target Name="FadeCompileGeneratedLaunch" DependsOnTargets="GenerateFadeBasic" BeforeTargets="CoreCompile"
            Condition="Exists('$(FadeGeneratedLaunchFile)')">
        <ItemGroup>
            <Compile Remove="@(Compile)" Condition="'%(Filename)%(Extension)' == 'GeneratedFade.g.cs'" />
            <Compile Include="$(FadeGeneratedLaunchFile)" />
        </ItemGroup>
    </Target>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <MonoGamePlatform>DesktopGL</MonoGamePlatform>
        <FadeGenerateMain>false</FadeGenerateMain>
        <!-- The game is also compiled to C# (FadeBasic's C# backend) and runs that by default;
             FADE_BACKEND=vm at run time picks the bytecode VM from the same build. The Fade
             debugger and F2 module reload only work on the VM. -p:FadeBackend=VM leaves the
             C# out entirely. -->
        <FadeBackend Condition="'$(FadeBackend)'==''">CSharp</FadeBackend>
<!--        <FadeUseMtpRunner>True</FadeUseMtpRunner>-->
    </PropertyGroup>

    <!-- What the game is called and looks like before any Fade code runs: the window title,
         the exe and window icon, and the window it opens in. See
         Fade.MonoGame.Game/buildTransitive/FadeBasic.MonoGame.App.targets, imported at the
         bottom of this file (a package consumer gets it automatically; this project references
         the engine as a project, so it does not).

         The icon is the standing diver from DiverSheet.png, padded to 32x32 so it scales up by
         whole numbers. It must not be one of the fish. Icon.png is in git, not the R2 bucket:
         a build needs it before the bucket assets are checked.

         The window size is NOT here: fish.fbasic picks it at run time (half the display on a
         Mac), and then the size the player left it at takes over. -->
    <PropertyGroup>
        <FadeGameTitle>Fish Fish Pop</FadeGameTitle>
        <FadeGameIcon>Icon.png</FadeGameIcon>
        <!-- Fullscreen only in a build made by GitHub Actions (which sets GITHUB_ACTIONS=true),
             which is every build that reaches Steam. Any build on a dev machine, Release too,
             opens windowed. This is only where a NEW player starts: the menu setup in
             fish_routines_menu.fbasic makes it the default of the fullscreen option, and a
             player who has picked an option gets theirs. -->
        <FadeWindowMode>Windowed</FadeWindowMode>
        <FadeWindowMode Condition="'$(GITHUB_ACTIONS)' == 'true'">Fullscreen</FadeWindowMode>
        <FadeWindowResizable>true</FadeWindowResizable>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.png" />
    </ItemGroup>

    <!-- TODO: put this in a .props file -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ProjectDir</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>MonoGamePlatform</_Parameter1>
            <_Parameter2>$(MonoGamePlatform)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    
    <ItemGroup>

<!--        <ProjectReference Include="..\..\MonoGame\MonoGame.Framework\MonoGame.Framework.DesktopGL.csproj" />-->

        <ProjectReference Include="..\Fade.MonoGame.Game\Fade.MonoGame.Game.csproj" />

        <ProjectReference Include="..\Fade.MonoGame.Lib\Fade.MonoGame.Lib.csproj" />

        <!-- Steam: FadeSteamCommands, and the SteamSystem that Program.cs registers.
             See steam/SETUP.md, "Steamworks API". -->
        <ProjectReference Include="..\Fade.MonoGame.Steam\Fade.MonoGame.Steam.csproj" />

        <!-- Debug desktop: the content pipeline, injected into Game.Services in
             Program.cs (under FADE_CONTENT_HOTRELOAD) so the engine builds +
             hot-reloads assets in-process. Same seam the dotnet-new template uses. -->
        <ProjectReference Include="..\Fade.MonoGame.Content\Fade.MonoGame.Content.csproj"
                          Condition="'$(Configuration)' == 'Debug' and '$(FadeMonoGamePlatform)' != 'Web'" />

        <PackageReference Include="FadeBasic.Lang.Core" Version="$(FadeVersion)" />
        
        <PackageReference Include="FadeBasic.Build" Version="$(FadeVersion)" />
        <PackageReference Include="FadeBasic.Testing" Version="$(FadeVersion)" />
        
        <PackageReference Include="FadeBasic.Lib.Standard" Version="$(FadeVersion)" />

        <FadeCommand Include="FadeBasic.Lib.Standard" FullName="FadeBasic.Lib.Standard.StandardCommands" />
        <FadeCommand Include="Fade.MonoGame.Lib" FullName="Fade.MonoGame.Lib.FadeMonoGameCommands" />
        <!-- Must be mirrored in the CommandCollection in Program.cs, which is what the
             Debug runtime compile uses. -->
        <FadeCommand Include="Fade.MonoGame.Steam" FullName="Fade.MonoGame.Steam.FadeSteamCommands" />
        
        
        
        
        
<!--        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.3" />-->
<!--        <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonogameVersion)" />-->
    </ItemGroup>

    <!-- Desktop deps: MonoGame + ImGui. The runtime packages carry the native
         Vulkan/MoltenVK binaries per RID; Native itself is managed-only. -->
    <ItemGroup Condition="'$(FadeMonoGameIsDesktop)' == 'true'">
        <PackageReference Include="ImGui.NET" Version="1.91.6.1" PrivateAssets="all" Publish="true" />
    </ItemGroup>
    <ItemGroup Condition="'$(FadeMonoGamePlatform)' == 'Desktop'">
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonogameVersion)" PrivateAssets="all" Publish="true" />
    </ItemGroup>
    <ItemGroup Condition="'$(FadeMonoGamePlatform)' == 'DesktopVK'">
        <PackageReference Include="MonoGame.Framework.Native" Version="$(MonogameVersion)" PrivateAssets="all" Publish="true" />
        <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="$(MonogameVersion)" PrivateAssets="all" Publish="true" />
        <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="$(MonogameVersion)" PrivateAssets="all" Publish="true" />
        <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="$(MonogameVersion)" PrivateAssets="all" Publish="true" />
    </ItemGroup>

    <!-- Browser deps: KNI BlazorGL. No ImGui (cimgui has no WASM build). -->
    <ItemGroup Condition="'$(FadeMonoGamePlatform)' == 'Web'">
        <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="$(KniPlatformBlazorGLVersion)" PrivateAssets="all" />
    </ItemGroup>
    
    
    <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
        <Message Text="Restoring dotnet tools" Importance="High" />
        <Exec Command="dotnet tool restore" />
    </Target>

    <Target Name="BuildAndCopyContent" DependsOnTargets="IncludeContent">
        <Message Text="Rebuilding Content..." Importance="High" />
        <Copy
                SourceFiles="%(ExtraContent.Identity)"
                DestinationFiles="$(OutDir)%(ExtraContent.ContentDir)%(ExtraContent.RecursiveDir)%(ExtraContent.Filename)%(ExtraContent.Extension)"
                SkipUnchangedFiles="true"
        />
    </Target>
    
    <!-- Fail early and legibly when the bucket assets have not been fetched.
         Assets/Fish/{Audio,Fonts,Textures} live in Cloudflare R2, not git (see steam/SETUP.md).
         Without them the game starts and every texture and sound is missing, which reads as a
         rendering bug rather than a missing download. -->
    <Target Name="CheckBucketAssets" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/Assets/Fish/Textures')"
               Text="Fade.MonoGame/Assets/Fish/Textures is missing. The textures, audio and fonts live in Cloudflare R2, not git. Run build\fetch-assets.ps1 (or ./build/fetch-assets.sh) and build again." />
    </Target>

    <!-- Build Assets/ into Content/*.xnb at build time, and ship it.

         In Debug the engine does this in-process at startup, through the IContentBuilder
         that Program.cs registers, so nothing here is needed. A Release build has no
         pipeline, so without this target it ships with no Content folder at all.

         Uses the same CLI that Fade.MonoGame.Game uses to bake its own sprite shader, built
         the same way: as a plain desktop tool, with this publish's RID and platform stripped
         off. It is not a ProjectReference in Release on purpose, because that would put the
         content pipeline's tool binaries (ffmpeg, basisu, crunch) into the shipped game. -->
    <PropertyGroup>
        <_GameAssetsDir>$(MSBuildProjectDirectory)/Assets</_GameAssetsDir>
        <!-- No trailing slash: these are quoted on a command line, and on Windows a
             backslash before the closing quote would escape it. -->
        <_GameContentObjDir>$(MSBuildProjectDirectory)/obj/gamecontent/$(FadeMonoGamePlatform)</_GameContentObjDir>
        <_FadeContentProject>$(MSBuildProjectDirectory)/../Fade.MonoGame.Content/Fade.MonoGame.Content.csproj</_FadeContentProject>
    </PropertyGroup>

    <!-- SHIP SOUNDS AS OGG. Off by default: every sound ships as the 16-bit PCM .xnb the
         pipeline makes, which loads instantly but is ten times the size of the mp3.

         On (-p:FadeMonoEncodeAudioToOgg=true), a non-Debug build re-encodes each of those XNBs
         as Ogg Vorbis and ships Content/<name>.ogg in its place, and the game decodes them all
         back to XNBs when it starts, before the program runs (FadeContentManager in
         Fade.MonoGame.Game). Measured 2026-10-16 on the fish game: 223 MB of XNB to 12-16 MB
         of Ogg, and about 0.4 s to decode all of it on 16 cores (1.7 s on one).

         FadeMonoOggQuality is Vorbis's quality, -1 (smallest) to 10 (best). Debug builds never
         do any of this: their content is built in-process and is always XNB. -->
    <PropertyGroup>
        <FadeMonoEncodeAudioToOgg Condition="'$(FadeMonoEncodeAudioToOgg)' == ''">false</FadeMonoEncodeAudioToOgg>
        <FadeMonoOggQuality Condition="'$(FadeMonoOggQuality)' == ''">5</FadeMonoOggQuality>
        <!-- One folder per quality, so changing it re-encodes instead of reusing the old files. -->
        <_GameContentOggDir>$(_GameContentObjDir)/ogg-q$(FadeMonoOggQuality)</_GameContentOggDir>
        <_GameContentOggArgs Condition="'$(FadeMonoEncodeAudioToOgg)' == 'true'">--ogg-output &quot;$(_GameContentOggDir)&quot; --ogg-quality $(FadeMonoOggQuality)</_GameContentOggArgs>
    </PropertyGroup>

    <!-- SHIP XNBS COMPRESSED. Off by default. On (-p:FadeMonoCompressContent=true), a non-Debug
         build Brotli-compresses every XNB it ships (all but the sounds that go as .ogg) and ships
         Content/<name>.xnb.br in its place; the game inflates each one as it loads it
         (FadeContentManager in Fade.MonoGame.Game). Lossless: MonoGame reads the same bytes.
         Measured 2026-10-16 on the fish game: 138 textures, 16.3 MB of raw RGBA XNB, to 0.34 MB. -->
    <PropertyGroup>
        <FadeMonoCompressContent Condition="'$(FadeMonoCompressContent)' == ''">false</FadeMonoCompressContent>
        <_GameContentBrDir>$(_GameContentObjDir)/br</_GameContentBrDir>
        <_GameContentBrArgs Condition="'$(FadeMonoCompressContent)' == 'true'">--compress-output &quot;$(_GameContentBrDir)&quot;</_GameContentBrArgs>
    </PropertyGroup>
    <Target Name="BuildGameContent"
            Condition="'$(Configuration)' != 'Debug' AND '$(FadeMonoGamePlatform)' != 'Web' AND Exists('$(_GameAssetsDir)')"
            BeforeTargets="AssignTargetPaths">
        <Message Importance="high" Text="Building game content from $(_GameAssetsDir) for $(FadeMonoGamePlatform)..." />
        <MakeDir Directories="$(_GameContentObjDir)" />

        <!-- Restore in a separate process, then build. See the long note on the same pair of
             steps in Fade.MonoGame.Game.csproj for why the restore cannot be an MSBuild task. -->
        <Exec Command="dotnet restore &quot;$(_FadeContentProject)&quot;" StandardOutputImportance="low" />
        <MSBuild Projects="$(_FadeContentProject)"
                 Targets="Build"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;FadeMonoGamePlatform;SelfContained;PublishTrimmed;PublishReadyToRun">
            <Output TaskParameter="TargetOutputs" ItemName="_GameContentCli" />
        </MSBuild>

        <Exec Command="dotnet &quot;@(_GameContentCli)&quot; --platform $(FadeMonoGamePlatform) --source &quot;$(_GameAssetsDir)&quot; --output &quot;$(_GameContentObjDir)&quot; --intermediate &quot;$(_GameContentObjDir)/obj&quot; $(_GameContentOggArgs) $(_GameContentBrArgs)"
              CustomErrorRegularExpression="\[E\] .+" />

        <!-- The sounds the step above re-encoded, as paths under Content/ with no extension.
             Each one ships as its .ogg and not its .xnb. -->
        <ReadLinesFromFile Condition="'$(FadeMonoEncodeAudioToOgg)' == 'true'"
                           File="$(_GameContentOggDir)/converted.txt">
            <Output TaskParameter="Lines" ItemName="_OggSound" />
        </ReadLinesFromFile>
        <!-- The XNBs it compressed, the same way. Each one ships as its .xnb.br. -->
        <ReadLinesFromFile Condition="'$(FadeMonoCompressContent)' == 'true'"
                           File="$(_GameContentBrDir)/compressed.txt">
            <Output TaskParameter="Lines" ItemName="_CompressedXnb" />
        </ReadLinesFromFile>

        <!-- Declared here rather than statically: the files do not exist until the Exec
             above has run. AssignTargetPaths is late enough that Content added now is still
             copied to the output and publish folders. -->
        <ItemGroup>
            <_AllBuiltGameContent Include="$(_GameContentObjDir)/Content/**/*" />
            <_BuiltGameContent Include="$(_GameContentObjDir)/Content/**/*"
                               Exclude="@(_OggSound->'$(_GameContentObjDir)/Content/%(Identity).xnb');@(_CompressedXnb->'$(_GameContentObjDir)/Content/%(Identity).xnb')" />
            <Content Include="@(_BuiltGameContent)">
                <Link>Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
            <Content Include="@(_CompressedXnb->'$(_GameContentBrDir)/%(Identity).xnb.br')">
                <Link>Content/%(_CompressedXnb.Identity).xnb.br</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
            <Content Include="@(_OggSound->'$(_GameContentOggDir)/%(Identity).ogg')">
                <Link>Content/%(_OggSound.Identity).ogg</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
            <!-- Each sound's name and a hash of its .ogg: what the game caches the decoded
                 sound under, so an update re-decodes only the sounds it changed. -->
            <Content Condition="'$(FadeMonoEncodeAudioToOgg)' == 'true'"
                     Include="$(_GameContentOggDir)/sounds.manifest">
                <Link>Content/sounds.manifest</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
        </ItemGroup>

        <Error Condition="'@(_AllBuiltGameContent)' == ''"
               Text="Content build produced nothing from $(_GameAssetsDir). A Release build with no XNBs ships a game with no art and no sound." />
    </Target>

    <!-- LOCALIZATION AS BUILD ERRORS. After the Fade program is compiled, the content CLI's
         `strings check` parses it the same way, finds every string table key it uses, and checks
         them and the tables in Assets/$(FadeStringsFolder). Problems come out as errors and
         warnings with a file and line (codes FLOC001 and up; see localization-plan.md).

         Debug: a key the tables do not have yet is added to inbox.csv there and is only a
         warning, so writing new code is never blocked. Release: it, and any missing English or
         missing translation, is an error.

         -p:FadeLocStrict=false turns the errors for keys built with + and unknown keys into
         warnings, for while the game is half converted. No network is read. -->
    <PropertyGroup>
        <FadeStringsFolder Condition="'$(FadeStringsFolder)' == ''">Fish/Lang</FadeStringsFolder>
        <FadeLocStrict Condition="'$(FadeLocStrict)' == ''">true</FadeLocStrict>
        <_FadeStringsDir>$(MSBuildProjectDirectory)/Assets/$(FadeStringsFolder)</_FadeStringsDir>
        <_FadeStringsArgs Condition="'$(Configuration)' != 'Debug'">--release</_FadeStringsArgs>
        <_FadeStringsArgs Condition="'$(FadeLocStrict)' == 'false'">$(_FadeStringsArgs) --no-strict</_FadeStringsArgs>
    </PropertyGroup>
    <Target Name="FadeStringsCheck"
            AfterTargets="FadeMonoGameGenerateLaunch"
            BeforeTargets="CoreCompile"
            Condition="'$(FadeMonoGamePlatform)' != 'Web' AND Exists('$(_FadeStringsDir)')">
        <PropertyGroup>
            <!-- In the target: IntermediateOutputPath is not set yet where the project's own properties are. -->
            <_FadeStringsInputs>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)fade-strings.inputs</_FadeStringsInputs>
        </PropertyGroup>
        <ItemGroup>
            <!-- Debug references the content project, so its CLI is already built. Release
                 builds it in BuildGameContent above. -->
            <_FadeStringsCli Include="@(ReferencePath)" Condition="'%(Filename)' == 'Fade.MonoGame.Content'" />
            <_FadeStringsCli Include="@(_GameContentCli)" Condition="'@(_FadeStringsCli)' == ''" />
            <_FadeStringsInput Include="@(FadeSource->'source|%(FullPath)')" />
            <_FadeStringsInput Include="@(ReferencePath->'ref|%(FullPath)')" />
            <_FadeStringsInput Include="@(FadeCommand->'command|%(Identity)|%(FullName)')" />
            <_FadeStringsInput Include="probe|$(TargetDir)" />
        </ItemGroup>
        <Warning Condition="'@(_FadeStringsCli)' == ''" Text="No content CLI to run the localization check with; strings were not checked." />
        <WriteLinesToFile Condition="'@(_FadeStringsCli)' != ''" File="$(_FadeStringsInputs)" Lines="@(_FadeStringsInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Condition="'@(_FadeStringsCli)' != ''"
              Command="dotnet &quot;@(_FadeStringsCli)&quot; strings check --strings &quot;$(_FadeStringsDir)&quot; --inputs &quot;$(_FadeStringsInputs)&quot; --fonts &quot;$(MSBuildProjectDirectory)/Assets&quot; $(_FadeStringsArgs)"
              IgnoreExitCode="true"
              StandardOutputImportance="normal" />
    </Target>

    <!-- The strings sheet, from the game project:
           dotnet build -t:FadeStringsSync   new keys into the sheet, status/where back, snapshot CSVs updated
           dotnet build -t:FadeStringsPull   the sheet into the snapshot CSVs, nothing written to the sheet
         Both build first, so the check has just run and its inputs file is fresh. Pass the CLI's
         dry-run flag through FadeStringsArgs to see what sync would do. Credentials: see
         Fade.MonoGame.Content/Strings/SheetsClient.cs (.secrets/google-sheets-sa.json in the repo). -->
    <Target Name="FadeStringsSync" DependsOnTargets="Build">
        <Exec Command="dotnet &quot;@(_FadeStringsCli)&quot; strings sync --strings &quot;$(_FadeStringsDir)&quot; --inputs &quot;$(_FadeStringsInputs)&quot; $(FadeStringsArgs)" />
    </Target>
    <Target Name="FadeStringsPull" DependsOnTargets="Build">
        <Exec Command="dotnet &quot;@(_FadeStringsCli)&quot; strings pull --strings &quot;$(_FadeStringsDir)&quot; $(FadeStringsArgs)" />
    </Target>

