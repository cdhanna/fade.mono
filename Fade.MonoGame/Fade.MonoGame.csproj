    <!-- A shipped game has no tests in it. FadeBasic 0.2.6.1 compiles `test` blocks into the
         program whatever $(FadeEnableTesting) says (checked 2026-10-16: a Release build carried
         all 473), so the test files are left out of the build instead. Every fish_tests*.fbasic,
         including ones not added yet. Everything that runs tests builds Debug (ci.yml,
         run-long-tests.ps1, render-trailer.ps1); -p:FishShipTests=true keeps them in Release. -->
    <ItemGroup Condition="'$(Configuration)' != 'Debug' AND '$(FishShipTests)' != 'true'">
        <FadeSource Remove="fish_tests*.fbasic" />
    </ItemGroup>
    
    <!-- THE LEADERBOARDS: which ones this build uses, and the secret that it checks scores with.
         Program.cs reads both back and hands them to the SteamSystem.

         Two environment variables decide it, and the Steam workflow sets both:
           FISH_SCORE_KEY       a GitHub secret, so it is in a shipped build and nowhere in the source
           FISH_DEPLOY_BRANCH   the Steam branch that the build is for: "default", "test" or "none"

         A build for the default branch uses the "live_" leaderboards. A build for any other
         branch uses that branch's own: "test_". Each checks its scores with the secret and the
         name of the branch together, so a score from one branch also fails the check of the
         other. "none" is an upload that is set live by hand later, and it counts as "test".

         A build without the secret, which is every build on a dev machine, uses the "dev_"
         leaderboards with a key that is no secret at all.

         The secret should be letters and digits only: it passes through MSBuild, which gives
         a meaning to % and ; and $. -->
    <PropertyGroup>
        <FishScoreSecret Condition="'$(FishScoreSecret)' == ''">$(FISH_SCORE_KEY)</FishScoreSecret>
        <FishDeployBranch Condition="'$(FishDeployBranch)' == ''">$(FISH_DEPLOY_BRANCH)</FishDeployBranch>
        <FishDeployBranch Condition="'$(FishDeployBranch)' == '' OR '$(FishDeployBranch)' == 'none'">test</FishDeployBranch>

        <FishLeaderboardPrefix>dev_</FishLeaderboardPrefix>
        <FishScoreKey>dev</FishScoreKey>
    </PropertyGroup>
    <PropertyGroup Condition="'$(FishScoreSecret)' != ''">
        <FishLeaderboardPrefix>$(FishDeployBranch)_</FishLeaderboardPrefix>
        <FishLeaderboardPrefix Condition="'$(FishDeployBranch)' == 'default'">live_</FishLeaderboardPrefix>
        <FishScoreKey>$(FishScoreSecret).$(FishDeployBranch)</FishScoreKey>
    </PropertyGroup>
    <!-- Which commit a build was made from, for the version in the corner of the main menu.
         GITHUB_SHA is an environment variable that GitHub Actions sets, so a CI build has it
         and a build on a dev machine does not, and says "local". Program.cs reads it. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BuildCommit</_Parameter1>
            <_Parameter2>$(GITHUB_SHA)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>LeaderboardPrefix</_Parameter1>
            <_Parameter2>$(FishLeaderboardPrefix)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ScoreKey</_Parameter1>
            <_Parameter2>$(FishScoreKey)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Says which Steam game a build that was NOT started by Steam is: one line, the app id.
         It is not in git, and a CI build never has one, so it cannot reach a depot. It must
         not: with it, the game starts without a license. Without it, a build on a dev machine
         simply runs with no Steam. -->
    <!-- The folder that art can be dropped into to replace the game's own, without a rebuild.
         Only its readme ships; the pictures are put there by whoever is trying them out. See
         fish_routines_customart.fbasic. -->
    <ItemGroup>
        <None Remove="CustomArt\**" />
        <Content Include="CustomArt\README.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="Exists('steam_appid.txt')">
        <None Remove="steam_appid.txt" />
        <Content Include="steam_appid.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Launch\" />
    </ItemGroup>
    
    <ItemGroup>
      <ClCompile Include="Content\MySpriteEffect.fx" />
    </ItemGroup>

    <Import Project="..\Fade.MonoGame.Game\buildTransitive\FadeBasic.MonoGame.App.targets" />
</Project>
