#constant EASING_LINEAR 0
#constant EASING_BOUNCE 2

goto routines_exit

load_audio:
    global EXPLODE_SOUND_COUNT=2
    global dim EXPLODE_SOUNDS(2)

    EXPLODE_SOUNDS(0) = 0
    EXPLODE_SOUNDS(1) = 1

    # push asset "Fish/Audio/bubble-pop-2.mp3"
    # rename asset "Fish/Audio/bubble-pop-2"
    
    load sfx clip EXPLODE_SOUNDS(0), "Fish/Audio/bubble-pop-2"
    load sfx clip EXPLODE_SOUNDS(1), "Fish/Audio/bubble-pop-4"
    
    load sfx clip 100, "Fish/Audio/underwater-ambiencewav"


    ` the sound of a swap is a rush of the water that is already playing: a stretch of the underwater
    ` ambience, with only the middle of it kept, that swells up and dies away. Tools/swap_swell_gen.py
    ` makes it, and two other takes, "bright" and "quick", that can go here in its place.
    global SFX_CLIP_SWAP
    load sfx clip reserve sfx clip id(SFX_CLIP_SWAP), "Fish/Audio/swap-swell-soft"
    global SFX_SWAP
    sfx reserve sfx id(SFX_SWAP), SFX_CLIP_SWAP
    set sfx loop SFX_SWAP, 1
    set sfx volume SFX_SWAP 0
    play sfx SFX_SWAP


    global SFX_CLIP_DROP
    load sfx clip reserve sfx clip id(SFX_CLIP_DROP), "Fish/Audio/rocks-falling"
    global SFX_DROP
    sfx reserve sfx id(SFX_DROP), SFX_CLIP_DROP
    set sfx loop SFX_DROP, 1
    set sfx volume SFX_DROP, 0
    play sfx SFX_DROP

    global SFX_TWEEN_DROP
    reserve tween id(SFX_TWEEN_DROP)




    sfx 100,100
    `play sfx 100
    set sfx loop 100, 1

return

load_fonts:

    SCORE_FONT = 1
    font SCORE_FONT, "Fish/Fonts/ZeroCool"

    ` input icons. any rich text that uses the font can draw these by writing the name in braces, like "hold {swap}".
    ` they are pictures of keys, or of controller buttons, depending on what the player is using.
    ` frame_input_icons, in fish_routines_input, is where each one gets its name and its picture.
    gosub frame_input_icons

    ` an icon is as tall as a line of text by default. these are drawn a bit bigger, so that
    ` text that is 16 pixels tall draws the 20 pixel pictures at exactly their own size.
    for i = 1 to 7
        set font icon scale SCORE_FONT, i, 1.25, 1.25
    next
    set font icon scale SCORE_FONT, 11, 1.25, 1.25
    set font icon scale SCORE_FONT, 12, 1.25, 1.25
    set font icon scale SCORE_FONT, 13, 1.25, 1.25

    ` icons for the kinds of ability, like "{move} move"
    font icon SCORE_FONT, 8, "passive", TEX_TYPE_PASSIVE
    font icon SCORE_FONT, 9, "move", TEX_TYPE_MOVE
    font icon SCORE_FONT, 10, "instant", TEX_TYPE_INSTANT


    global SCORE_TEXT_COUNT = 100
    global SCORE_TEXT_NUM = 0
    global dim SCORE_TEXTS(SCORE_TEXT_COUNT) as floatingText

    ` the score texts are drawn to a render target of their own, which is see-through wherever there is
    ` nothing. then one sprite draws that render target over the board. see THE SCORE TEXTS in fish_headers.
    reserve render target id(TARGET_SCORE_TEXT)
    render target TARGET_SCORE_TEXT
    set render target background color TARGET_SCORE_TEXT, rgb(0, 0, 0, 0)

    reserve effect id(SCORE_TEXT_FX_ID)
    effect SCORE_TEXT_FX_ID, "Fish/Shaders/ScoreTextEffect"

    reserve sprite id(SCORE_TEXT_VIEW_SPRITE)
    sprite SCORE_TEXT_VIEW_SPRITE, 0, 0, render target texture(TARGET_SCORE_TEXT)
    set sprite offset SCORE_TEXT_VIEW_SPRITE, 0, 0
    size sprite SCORE_TEXT_VIEW_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    order sprite SCORE_TEXT_VIEW_SPRITE, ORDER_SCORE_TEXT
    set sprite effect SCORE_TEXT_VIEW_SPRITE, SCORE_TEXT_FX_ID

    for i = 0 to SCORE_TEXT_COUNT - 1
        SCORE_TEXTS(i) = {
            active = 0
            textId = i + 1 `TODO: add reserve, 
            floatTweenIdX = reserve tween id(n)
            floatTweenIdY = reserve tween id(n)
            fadeTweenId = reserve tween id(n)
            fadeInTweenId = reserve tween id(n)
            scaleOutTweenId = reserve tween id(n)
        }
        text SCORE_TEXTS(i).textId, 0, 0, SCORE_FONT, ""
        set text render target SCORE_TEXTS(i).textId, TARGET_SCORE_TEXT
        `hide text SCORE_TEXTS(i).textId
    next

    ` the numbers of THE RAINBOW SHARES are drawn to a render target of their own, which RainbowTextEffect
    ` turns to the rainbow. see fish_headers_rainbow.
    reserve render target id(TARGET_RAINBOW_TEXT)
    render target TARGET_RAINBOW_TEXT
    set render target background color TARGET_RAINBOW_TEXT, rgb(0, 0, 0, 0)

    reserve effect id(RAINBOW_TEXT_FX_ID)
    effect RAINBOW_TEXT_FX_ID, "Fish/Shaders/RainbowTextEffect"

    reserve sprite id(RAINBOW_TEXT_VIEW_SPRITE)
    sprite RAINBOW_TEXT_VIEW_SPRITE, 0, 0, render target texture(TARGET_RAINBOW_TEXT)
    set sprite offset RAINBOW_TEXT_VIEW_SPRITE, 0, 0
    size sprite RAINBOW_TEXT_VIEW_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    order sprite RAINBOW_TEXT_VIEW_SPRITE, ORDER_SCORE_TEXT + 1 `over the other numbers, so that it is not lost under them
    set sprite effect RAINBOW_TEXT_VIEW_SPRITE, RAINBOW_TEXT_FX_ID

return



load_textures:
    global TEX_CRAB
    global TEX_WORM

    texture free texture id(TEX_PUFFER), "Fish/Textures/Pufferfish"
    texture free texture id(TEX_CATFISH), "Fish/Textures/Catfish"
    texture free texture id(TEX_GOLDFISH), "Fish/Textures/Goldfish"
    texture free texture id(TEX_ANGELFISH), "Fish/Textures/Angelfish"
    texture free texture id(TEX_CRAB), "Fish/Textures/Crab - Dungeness"
    texture free texture id(TEX_BASS), "Fish/Textures/Bass"
    texture free texture id(TEX_WORM), "Fish/Textures/Worm"

    ` the kinds that only show up with their cards. see THE NEW KINDS OF FISH in fish_headers.
    ` they come right after the first seven, and the first seven must stay first: a new fish is picked by number.
    texture free texture id(TEX_JELLY), "Fish/Textures/Jellyfish"
    texture free texture id(TEX_RAY), "Fish/Textures/Stingray"
    texture free texture id(TEX_BOTTLE), "Fish/Textures/Bottle"

    ` the kinds that only a quest puts on the board. they come right after the bottle, so that they are
    ` fish 11 to 15. see THE QUEST KINDS in fish_headers_quests.
    texture free texture id(TEX_KRILL), "Fish/Textures/Quests/Krill"
    texture free texture id(TEX_SEAWEED), "Fish/Textures/Quests/Seaweed"
    texture free texture id(TEX_SAND_DOLLAR), "Fish/Textures/Quests/SandDollar"
    texture free texture id(TEX_TURTLE), "Fish/Textures/Quests/Turtle"
    texture free texture id(TEX_GLASS_FISH), "Fish/Textures/Quests/GlassFish"
    QUEST_SOLID_FROM = TEX_SEAWEED

    ` the diver comes right after those, so it is fish 16, and it never matches either. see fish_headers_diver.
    texture free texture id(TEX_DIVER), "Fish/Textures/Diver"

    ` most of the small pictures are rectangles of one atlas picture, and it has to be loaded before any of
    ` them. it comes after the fish, because the kind of a fish is the id of its texture, from 1 up to the
    ` diver: the atlas taking an id among them would put every kind out by one. see THE ATLAS in fish_routines_atlas.
    gosub load_atlas

    texture reserve texture id(TEX_NOISE), "Fish/Textures/Turbulence_13-256x256"

    ` every skeleton is the same pile of bones, whatever kind of fish it was. and the ghost that one
    ` turns into when it is matched. see EVERY SKELETON IS THE SAME PILE OF BONES in fish_headers.
    texture reserve texture id(TEX_BONES), "Fish/Textures/Bones"
    texture reserve texture id(TEX_GHOST), "Fish/Textures/Ghost"
    for skeletonTexN = 0 to 16
        SKELETON_TEX(skeletonTexN) = TEX_BONES
    next
    CODEC_FISH_TEX = TEX_GOLDFISH `the codec shows what can happen to a fish on a goldfish

    global dim FISH_COLORS(16)
    FISH_COLORS(getFishColorIndex(TEX_JELLY)) = rgb(200, 130, 255)
    FISH_COLORS(getFishColorIndex(TEX_RAY)) = rgb(120, 150, 200)
    FISH_COLORS(getFishColorIndex(TEX_BOTTLE)) = rgb(150, 220, 180)
    FISH_COLORS(getFishColorIndex(TEX_KRILL)) = rgb(255, 150, 130)
    FISH_COLORS(getFishColorIndex(TEX_SEAWEED)) = rgb(90, 200, 110)
    FISH_COLORS(getFishColorIndex(TEX_SAND_DOLLAR)) = rgb(240, 225, 170)
    FISH_COLORS(getFishColorIndex(TEX_TURTLE)) = rgb(90, 180, 110)
    FISH_COLORS(getFishColorIndex(TEX_GLASS_FISH)) = rgb(200, 225, 240)
    FISH_COLORS(getFishColorIndex(TEX_DIVER)) = rgb(245, 196, 62)
    FISH_COLORS(getFishColorIndex(TEX_PUFFER)) = rgb(250, 190, 54)
    FISH_COLORS(getFishColorIndex(TEX_CATFISH)) = rgb(160, 150, 121)
    FISH_COLORS(getFishColorIndex(TEX_GOLDFISH)) = rgb(255, 174, 48)
    FISH_COLORS(getFishColorIndex(TEX_ANGELFISH)) = rgb(255, 211, 52)
    FISH_COLORS(getFishColorIndex(TEX_CRAB)) = rgb(223, 55, 55)
    FISH_COLORS(getFishColorIndex(TEX_BASS)) = rgb(154, 181, 89)
    FISH_COLORS(getFishColorIndex(TEX_WORM)) = rgb(255, 144, 144)

    texture free texture id(TEX_SMOKE_1), "Fish/Textures/Free Smoke Fx  Pixel 04"
    set texture frame grid TEX_SMOKE_1, 10 8 `rows, columns

    texture free texture id(TEX_SMOKE_2), "Fish/Textures/Free Smoke Fx  Pixel 06"
    set texture frame grid TEX_SMOKE_2, 23 12 `rows, columns

    global SMOKE_ANIM_COUNT = 5
    global dim SMOKE_ANIMS(SMOKE_ANIM_COUNT) as smokeAnimInfo
    SMOKE_ANIMS(0) = {
        texId = TEX_SMOKE_1,
        startFrame = 8 * 2
        endFrame = 8 * 3
    }
    SMOKE_ANIMS(1) = {
        texId = TEX_SMOKE_1,
        startFrame = 8 * 7
        endFrame = 8 * 8
    }
    SMOKE_ANIMS(2) = {
        texId = TEX_SMOKE_2,
        startFrame = 12 * 2
        endFrame = 12 * 3
    }
    SMOKE_ANIMS(3) = {
        texId = TEX_SMOKE_2,
        startFrame = 12 * 4
        endFrame = 12 * 5
    }
    SMOKE_ANIMS(4) = {
        texId = TEX_SMOKE_2,
        startFrame = 12 * 6
        endFrame = 12 * 7
    }

    global SMOKE_COLOR_COUNT = 5
    global dim SMOKE_COLORS(SMOKE_COLOR_COUNT)
    SMOKE_COLORS(0) = rgb(143, 199, 255)
    SMOKE_COLORS(1) = rgb(120, 172, 224)
    SMOKE_COLORS(2) = rgb(143, 199, 255)
    SMOKE_COLORS(3) = rgb(141, 198, 255)
    SMOKE_COLORS(4) = rgb(121, 171, 222)

    ` pictures of keyboard keys, from kenney's input prompts pack (keyboard & mouse, default sheet).
    ` the original keys are 64 pixels, which turns to mush when drawn this small, so this sheet
    ` is the same grid shrunk down to 20 pixel keys.
    texture reserve texture id(TEX_KEYS), "Fish/Textures/Keys"
    texture reserve texture id(TEX_KEY_TAB), "Fish/Textures/KeyTab"
    texture reserve texture id(TEX_KEY_ESC), "Fish/Textures/KeyEsc"
    set texture frame grid TEX_KEYS, 16 17 `rows, columns

    ` and pictures of controller buttons, from the xbox series sheet of the same pack, shrunk the same way.
    texture reserve texture id(TEX_PAD), "Fish/Textures/Pad"
    set texture frame grid TEX_PAD, 10 10 `rows, columns

    ` the small pictures for each kind of ability. these are 16 pixels, to match 16 pixel text.
    texture reserve texture id(TEX_TYPE_PASSIVE), "Fish/Textures/Cards/type_passive"
    texture reserve texture id(TEX_TYPE_MOVE), "Fish/Textures/Cards/type_move"
    texture reserve texture id(TEX_TYPE_INSTANT), "Fish/Textures/Cards/type_instant"
    texture reserve texture id(TEX_CLOCK), "Fish/Textures/Cards/clock"

    ` the art for each card. it is drawn tinted and faint in the background of the card, so only the shape
    ` of the picture matters. these are 48 pixels, and get drawn twice as big.
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_BUNDLE).artTexId), "Fish/Textures/Cards/free_moves"
    texture reserve texture id(CARDS(ABILITY_INDEX_MIND_EXPANSION).artTexId), "Fish/Textures/Cards/mind_expansion"
    texture reserve texture id(CARDS(ABILITY_INDEX_WRAP).artTexId), "Fish/Textures/Cards/seamless"
    texture reserve texture id(CARDS(ABILITY_INDEX_CRABS).artTexId), "Fish/Textures/Cards/crabs"
    texture reserve texture id(CARDS(ABILITY_INDEX_BIRD_FEAST).artTexId), "Fish/Textures/Cards/bird_feast"
    texture reserve texture id(CARDS(ABILITY_INDEX_PASSIVE_STOCK_MARKET).artTexId), "Fish/Textures/Cards/stock_market"
    texture reserve texture id(CARDS(ABILITY_INDEX_THINK_BIGGER).artTexId), "Fish/Textures/Cards/think_bigger"
    texture reserve texture id(CARDS(ABILITY_INDEX_BOTTOM_FEEDER).artTexId), "Fish/Textures/Cards/bottom_feeder"
    ` the second copy uses the same texture. loading the same picture into a second texture came out as a black square.
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2).artTexId = CARDS(ABILITY_INDEX_BOTTOM_FEEDER).artTexId
    texture reserve texture id(CARDS(ABILITY_INDEX_CONTAGIOUS_SMILE).artTexId), "Fish/Textures/Cards/contagious_smile"
    texture reserve texture id(CARDS(ABILITY_INDEX_BOTTOMS_UP).artTexId), "Fish/Textures/Cards/bottoms_up"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_SHIFT).artTexId), "Fish/Textures/Cards/shift"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_CLONER).artTexId), "Fish/Textures/Cards/clone"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_BOMB3x3).artTexId), "Fish/Textures/Cards/bomb"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_LINE_OUT).artTexId), "Fish/Textures/Cards/line_out"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_FREE).artTexId), "Fish/Textures/Cards/free_swap"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_ROBOT).artTexId), "Fish/Textures/Cards/robot"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_KNOWN_FILL).artTexId), "Fish/Textures/Cards/known_fill"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_SLOT).artTexId), "Fish/Textures/Cards/tackle_box"
    texture reserve texture id(CARDS(ABILITY_INDEX_JELLIES).artTexId), "Fish/Textures/Cards/jellies"
    texture reserve texture id(CARDS(ABILITY_INDEX_RAYS).artTexId), "Fish/Textures/Cards/rays"
    texture reserve texture id(CARDS(ABILITY_INDEX_BOTTLES).artTexId), "Fish/Textures/Cards/bottles"
    texture reserve texture id(CARDS(ABILITY_INDEX_LISTEN).artTexId), "Fish/Textures/Cards/listen"
    texture reserve texture id(CARDS(ABILITY_INDEX_QUICK_SONG).artTexId), "Fish/Textures/Cards/quick_song"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_SONG).artTexId), "Fish/Textures/Cards/easy_song"
    texture reserve texture id(CARDS(ABILITY_INDEX_DEEP_POCKETS).artTexId), "Fish/Textures/Cards/deep_pockets"
    texture reserve texture id(CARDS(ABILITY_INDEX_SHOW_TIME).artTexId), "Fish/Textures/Cards/show_time"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_WASTE_BUCKET).artTexId), "Fish/Textures/Cards/waste_bucket"
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_BUNCH_UP).artTexId), "Fish/Textures/Cards/bunch_up"
    texture reserve texture id(CARDS(ABILITY_INDEX_SNEAKING_DEATH).artTexId), "Fish/Textures/Cards/sneaking_death"
    texture reserve texture id(CARDS(ABILITY_INDEX_LOWER_BAR).artTexId), "Fish/Textures/Cards/lower_the_bar"
    texture reserve texture id(CARDS(ABILITY_INDEX_MIDNIGHT_CRAB).artTexId), "Fish/Textures/Cards/midnight_crab"

    ` the cards that only a fast gives out. see THE FAST in fish_headers_fast. Tools/fast_art_gen.py draws them.
    texture reserve texture id(CARDS(ABILITY_INDEX_MOVE_ROTATE).artTexId), "Fish/Textures/Cards/rotate"
    texture reserve texture id(CARDS(ABILITY_INDEX_OPEN_BOOK).artTexId), "Fish/Textures/Cards/see_all"
    texture reserve texture id(CARDS(ABILITY_INDEX_OATH).artTexId), "Fish/Textures/Cards/oceanic_oath"
    texture reserve texture id(CARDS(ABILITY_INDEX_ANGLER).artTexId), "Fish/Textures/Cards/bright_idea"
    texture reserve texture id(CARDS(ABILITY_INDEX_FALL_IN_LINE).artTexId), "Fish/Textures/Cards/fall_in_line"
    texture reserve texture id(CARDS(ABILITY_INDEX_FLIPPER).artTexId), "Fish/Textures/Cards/flipper"
    texture reserve texture id(CARDS(ABILITY_INDEX_HIGH_STAKES).artTexId), "Fish/Textures/Cards/high_stakes"
    texture reserve texture id(CARDS(ABILITY_INDEX_TOLERANCE).artTexId), "Fish/Textures/Cards/tolerance"
    ` "moonlight" has the picture of the night for now, the same as the codec's entry for the night
    texture reserve texture id(CARDS(ABILITY_INDEX_MOONLIGHT).artTexId), "Fish/Textures/Cards/night_dive"

return

setup_grid:

    global CELL_SIZE = 28
    global CELL_ART_SIZE = 16
    global GRID_POS as vec = {
        x = 32 + 16 + 128, 
        y = 64
    }


    ` the board can grow, but it always fills the same square of the screen. so when it grows, the cells shrink.
    ` these are how big everything is on the board that a game starts with.
    global GRID_START_COUNT = 9
    global CELL_START_SIZE = CELL_SIZE
    global CELL_START_ART_SIZE = CELL_ART_SIZE
    global GRID_SPAN = GRID_START_COUNT * CELL_START_SIZE
    global GRID_CENTER as vec = {
        x = GRID_POS.x + GRID_SPAN / 2 - CELL_START_SIZE / 2,
        y = GRID_POS.y + GRID_SPAN / 2 - CELL_START_SIZE / 2
    }

    global CELL_COLUMN_COUNT = GRID_START_COUNT
    global CELL_ROW_COUNT = GRID_START_COUNT
    global CELL_COUNT as int = CELL_COLUMN_COUNT * CELL_ROW_COUNT

    ` there are enough cells for the biggest board that there can be. the ones that are not on the board yet are hidden.
    ` the board takes turns growing a column and a row, so half of the expansions go each way.
    global GRID_MAX_COUNT = GRID_START_COUNT + (BOARD_EXPANSION_MAX + 1) / 2
    global CELL_MAX_COUNT = GRID_MAX_COUNT * GRID_MAX_COUNT
    global dim CELLS(CELL_MAX_COUNT) as cell

    ` what kind of fish was in every cell, from before the board grew
    global dim EXPAND_VALUES(CELL_MAX_COUNT)
    global dim EXPAND_STACKS(CELL_MAX_COUNT) `and how many more fish were stacked up behind it
    global dim EXPAND_BELLY_UPS(CELL_MAX_COUNT) `and if it was belly up
    reserve tween id(BOARD_EXPAND_TWEEN_ID)

    global DEBUG_COLOR_COUNT = 1000
    global dim DEBUG_COLORS(DEBUG_COLOR_COUNT)
    for i = 1 to DEBUG_COLOR_COUNT
        DEBUG_COLORS(i-1) = rgb(rnd(255), rnd(255), rnd(255))
    next

    global REQUEST_COMBO_CHECK = 0

    cellId = 0
    for y = 1 to CELL_ROW_COUNT
        for x = 1 to CELL_COLUMN_COUNT
            CELLS(cellId) = {
                coord = {
                    x = x - 1, 
                    y = y - 1    
                }
                value = getRandomValue()
            }

            CELLS(cellId).value = getImpossibleRandomValueForCell(cellId)

            reserve sprite id(CELLS(cellId).spriteId)
            reserve sprite id(CELLS(cellId).fxSpriteId)
            reserve tween id(CELLS(cellId).comboDownShiftTweenId)
            reserve tween id(CELLS(cellId).comboAlphaTweenId)
            reserve tween id(CELLS(cellId).comboAnimTweenId)
            reserve tween id(CELLS(cellId).scaleWaveTweenId)
            reserve tween id(CELLS(cellId).shiftTweenId)
            create basic tween CELLS(cellId).scaleWaveTweenId, 1, 1, 100, 0

            reserve sfx id(CELLS(cellid).explodeSfxId)

            c as cell = CELLS(cellId)
            sprite c.spriteId, getCellX(c.coord.x), getCellY(c.coord.y), c.value
            order sprite c.spriteId, ORDER_FISH
            set sprite effect c.spriteId, FISH_FX_ID

            sprite c.fxSpriteId, getCellX(c.coord.y), getCellY(c.coord.y), TEX_SMOKE_1
            hide sprite c.fxSpriteId

            size sprite c.spriteId, CELL_ART_SIZE, CELL_ART_SIZE
            inc cellId


        next
    next

    ` the rest of the cells wait, out of sight, for the board to grow
    for cellId = CELL_COUNT to CELL_MAX_COUNT - 1
        reserve sprite id(CELLS(cellId).spriteId)
        reserve sprite id(CELLS(cellId).fxSpriteId)
        reserve tween id(CELLS(cellId).comboDownShiftTweenId)
        reserve tween id(CELLS(cellId).comboAlphaTweenId)
        reserve tween id(CELLS(cellId).comboAnimTweenId)
        reserve tween id(CELLS(cellId).scaleWaveTweenId)
        reserve tween id(CELLS(cellId).shiftTweenId)
        create basic tween CELLS(cellId).scaleWaveTweenId, 1, 1, 100, 0

        reserve sfx id(CELLS(cellId).explodeSfxId)

        order sprite CELLS(cellId).spriteId, ORDER_FISH
        set sprite effect CELLS(cellId).spriteId, FISH_FX_ID
        hide sprite CELLS(cellId).spriteId
        hide sprite CELLS(cellId).fxSpriteId
    next

    ` the sprites are centered on their cell position, so the grid starts half a cell early
    INFO_INDEX_GRID = INFO_LENGTH
    infoIndex = allocateInfoBlob(GRID_POS.x - CELL_SIZE / 2, GRID_POS.y - CELL_SIZE / 2, CELL_COLUMN_COUNT * CELL_SIZE, CELL_ROW_COUNT * CELL_SIZE, loc$("info.grid.title"), loc$("info.grid.desc"))

    ` info mode does not explain the board as a whole. the tutorial has done that by the time it is open.
    ` the blob is still kept, and still follows the board, for the angler, which shows a topic on it when
    ` nothing else is about it, and finds nothing there. see coralPlaceInfo.
    setInfoBlobEnabled(INFO_INDEX_GRID, 0)

    ` the things on the board get outlines of their own. see fish_headers_boardinfo.
    boardInfoSetup()
return

setup_score:


    global SCORE_SIZE as vec = {
        x = CELL_COLUMN_COUNT * CELL_SIZE, 
        y = 4
    }
    global SCORE_BAR as progressBar = createProgressBar(SCORE_POS, SCORE_SIZE)
    SCORE_BAR.startVal = 0
    SCORE_BAR.endVal = getRoundSpan(0)
    ` it is an upside down L: its name and its bar, all the way across, and its numbers, under the
    ` right end of the bar. see THE ONE THAT IS NOT A RECTANGLE in fish_headers.
    INFO_L_W = 100
    INFO_L_H = 14
    INFO_L_INDEX = INFO_LENGTH
    infoIndex = allocateInfoBlob(SCORE_POS.x - 4, SCORE_POS.y - 16, SCORE_SIZE.x + 8, 22, loc$("info.score.title"), loc$("info.score.desc"))
    INFO_INDEX_SCORE_BAR = infoIndex
    
    global dim PROGRESS_BARS(1) as progressBar
    global PROGRESS_BAR_COUNT = 1
    PROGRESS_BARS(0) = SCORE_BAR

    ` the bar that fills toward more multiplier, on top of the full one. see OVERFLOW in fish_headers.
    reserve sprite id(OVERFLOW_SPRITE)
    sprite OVERFLOW_SPRITE, SCORE_POS.x + 1, SCORE_POS.y + 1, TEX_PIXEL
    size sprite OVERFLOW_SPRITE, 0, SCORE_SIZE.y - 2
    set sprite offset OVERFLOW_SPRITE, 0, 0
    color sprite OVERFLOW_SPRITE, rgb(255, 220, 64, 255)

    ` global SCORE_SLIDE_BACKDROP_SPRITE
    ` global SCORE_SLIDE_FRONT_SPRITE
    ` global SCORE_SLIDE_TWEEN_ID

    ` reserve sprite id(SCORE_SLIDE_BACKDROP_SPRITE)
    ` reserve sprite id(SCORE_SLIDE_FRONT_SPRITE)
    ` reserve tween id(SCORE_SLIDE_TWEEN_ID)

    global CURRENT_SCORE = 0
    global CURRENT_ROUND = 0

    global ROUND_COUNT_TEXT_ID


    ` set up the "moves" label on left
    reserve text id(MOVE_TEXT_ID)
    text loc MOVE_TEXT_ID, 32, SCORE_POS.y - 16, SCORE_FONT, "hud.moves"
    order text MOVE_TEXT_ID, ORDER_HUD_TEXT
    size text max MOVE_TEXT_ID, 120, 20
    set text offset MOVE_TEXT_ID, 0, 0
    color text MOVE_TEXT_ID, rgb(64, 128, 255, 200)
    enable text drop shadow MOVE_TEXT_ID, 2, -2, rgb(0,0,0)
    infoIndex = allocateInfoBlob(32 - 4, SCORE_POS.y - 16 - 2, 56, 56, loc$("info.moves.title"), loc$("info.moves.desc"))
    MOVES_LABEL_TEXT_ID = MOVE_TEXT_ID
    INFO_INDEX_MOVE_COUNT = infoIndex


    ` re-use id, and set up "rounds left" label on right
    reserve text id(MOVE_TEXT_ID)
    text loc MOVE_TEXT_ID, 570 - 32, SCORE_POS.y - 16, SCORE_FONT, "hud.roundsleft"
    order text MOVE_TEXT_ID, ORDER_HUD_TEXT
    ` the label ends at the right edge, so a long one would run into the bar of the round
    size text max MOVE_TEXT_ID, 120, 20
    set text offset MOVE_TEXT_ID, 1, 0
    color text MOVE_TEXT_ID, rgb(64, 128, 255, 200)
    enable text drop shadow MOVE_TEXT_ID, 2, -2, rgb(0,0,0)
    infoIndex = allocateInfoBlob(570 - 32 - 104, SCORE_POS.y - 16 - 2, 108, 56, loc$("info.rounds.title"), loc$("info.rounds.desc"))
    ROUNDS_LABEL_TEXT_ID = MOVE_TEXT_ID
    INFO_INDEX_ROUNDS = infoIndex


    reserve text id(MOVE_COUNT_TEXT_ID)
    text MOVE_COUNT_TEXT_ID, 32 + 24 SCORE_POS.y + 42, SCORE_FONT, "0"
    order text MOVE_COUNT_TEXT_ID, ORDER_HUD_TEXT
    size text y MOVE_COUNT_TEXT_ID, 42

    set text offset MOVE_COUNT_TEXT_ID, .5, 1
    color text MOVE_COUNT_TEXT_ID, rgb(64, 128, 255, 200)
    enable text drop shadow MOVE_COUNT_TEXT_ID, 2, -2, rgb(0,0,0)

    reserve text id(ROUND_COUNT_TEXT_ID)
    text ROUND_COUNT_TEXT_ID, 570 - 64 - 10 SCORE_POS.y + 42, SCORE_FONT, str$(getRoundsLeft())
    order text ROUND_COUNT_TEXT_ID, ORDER_HUD_TEXT
    size text y ROUND_COUNT_TEXT_ID, 42
    set text offset ROUND_COUNT_TEXT_ID, .5, 1
    color text ROUND_COUNT_TEXT_ID, rgb(64, 128, 255, 200)
    enable text drop shadow ROUND_COUNT_TEXT_ID, 2, -2, rgb(0,0,0)
return




setup_selection:

    global COLLECTED_INPUT_MASK as long = 0
    global SELECTION_POS as vec = {
        x = CELL_COLUMN_COUNT / 2, y = CELL_ROW_COUNT / 2
    }

    global QUEUED_MOVE_MAX = 100
    global dim QUEUED_MOVES(QUEUED_MOVE_MAX) as move
    global QUEUED_MOVE_NUM
    global QUEUED_MOVE_TAIL

    global SELECTION_SPRITE
    reserve sprite id(SELECTION_SPRITE)
    gosub update_selection_position
    size sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE
    order sprite SELECTION_SPRITE, ORDER_SELECTION

    ` the cursor is a dark square with a thin outline, like the panel in info mode. the effect draws the
    ` outline, so that it stays one pixel thick while the cursor changes size.
    ` the outline is the color of the game's background, rgb(32, 40, 64), three and a half times as bright.
    global CURSOR_FX_ID
    reserve effect id(CURSOR_FX_ID)
    effect CURSOR_FX_ID, "Fish/Shaders/CursorEffect"
    set sprite effect SELECTION_SPRITE, CURSOR_FX_ID
    color sprite SELECTION_SPRITE, rgb(10, 14, 30, 90) `the fill is faint, so that the background shows through it
    set sprite all texcoord1 SELECTION_SPRITE, 112 / 255.0, 140 / 255.0, 224 / 255.0, 1

return


setup_swap_tweens:

    global TWEEN_SWAP_AX
    global TWEEN_SWAP_BX
    global TWEEN_SWAP_AY
    global TWEEN_SWAP_BY
    
    reserve tween id(TWEEN_SWAP_AX)
    reserve tween id(TWEEN_SWAP_AY)
    reserve tween id(TWEEN_SWAP_BX)
    reserve tween id(TWEEN_SWAP_BY)

    global SHAKE_TWEEN_ID
    reserve tween id (SHAKE_TWEEN_ID)

    global SELECTION_TWEEN_PUNCH_ID
    reserve tween id (SELECTION_TWEEN_PUNCH_ID)

    global SWAP_TWEEN_SFX
    reserve tween id (SWAP_TWEEN_SFX)

    reserve tween id (CURSOR_SHAKE_TWEEN_ID)

return


update_selection_position:
    position sprite SELECTION_SPRITE, getCellX(SELECTION_POS.x), getCellY(SELECTION_POS.y)
return


time# = 0
update_frame:
    ` the banner of a demo blinks, and a press stops it, even in the middle of a run of pops. see THE DEMO in fish_headers_demo.
    if DEMO_MODE
        demoTick()
    endif

    ` a new game on a seed, asked for from outside the menu. see A NEW GAME ON A SEED in fish_headers_seed.
    if REQUEST_SEED_RESTART
        REQUEST_SEED_RESTART = 0
        gosub reset_game
        gosub apply_game_options
    endif

    ` the `perf lap` between the parts is for the frame timing log. see the names in fish.fbasic.
    perf lap 8
    gosub frame_texts
    perf lap 10
    gosub frame_scale_wave
    perf lap 11
    gosub frame_fish_fx `after the scale wave, because it needs to know how big the fish ended up
    gosub frame_entrance `the fish falling in at the start of a game. see THE ENTRANCE in fish_headers_entrance.
    perf lap 12
    gosub frame_score
    perf lap 13
    gosub frame_passive_render
    perf lap 14
    gosub frame_move_ability_render
    perf lap 15
    gosub frame_free_moves
    perf lap 16
    stepCursorShake()
    stepMultiplier()
    perf lap 17
    stepCoral()
    stepTideSleep()
    stepGlow() `see fish_headers_glow
    stepSchool() `see fish_headers_school
    stepRainbowFish() `see fish_headers_rainbow
    stepBubbled() `see fish_headers_bubbled
    perf lap 18
    stepSkeletonGhosts()
    perf lap 19
    stepTuna()
    perf lap 20
    stepBeatLook()
    cursorShowStep() `the cursor pops in after a board, and fades in info mode. see fish_headers_cursorshow.
    gosub frame_spot `the list of what is on the board, in info mode. see fish_headers_spot.
    rotateDrawBox() `the outline of the box of a "rotate". see fish_headers_fast.
    perf lap 21
    gosub frame_hints
    perf lap 22
    updateBubbles()
    perf lap 23
    updateMusic()
    perf lap 24
    stepQuest()
    questTalkStep(game ms()) `the creature that talks about the quest that was taken. see fish_headers_questtalk.
    teachStep() `the words of a big moment, and the dark corners. see fish_headers_teach.
    codecNewStep() `the "new info!" badges. see NEW IN THE CODEC in fish_headers_teach.
    gosub frame_dbg
    perf lap 25

    ` when the fish go home, the things around the board fade away. this comes last, so that it has
    ` the last word on how they look. see THE FISH GO HOME in fish_headers.
    if HUD_KEEP# < 1
        applyHudFade()
    endif
    perf lap 26

return

` tell the fish effect how to draw every fish on the board. see FishEffect.fx for what the numbers mean.
frame_fish_fx:

    ` work out where every shockwave has got to on this frame, and which ones there are, so that
    ` the fish do not each have to
    shockNow = game ms()
    SHOCK_LIVE_COUNT = 0
    for s = 0 to SHOCK_COUNT - 1
        if SHOCKS(s).active
            shockAge = shockNow - SHOCKS(s).startMs
            shockLife# = SHOCKS(s).life
            if shockAge > SHOCKS(s).life
                ` it has run its course
                SHOCKS(s).active = 0
            else
                if shockAge >= 0
                    ` it swells up quickly, and then it dies away for the rest of its life
                    shockPower# = SHOCKS(s).strength# * (1 - (shockAge / shockLife#))
                    if shockAge < SHOCK_ATTACK then shockPower# = (shockPower# * shockAge) / SHOCK_ATTACK

                    ` the top of the bump starts right where the ring does, so the fish there feel it straight away
                    SHOCKS(s).radius# = (shockAge * SHOCK_SPEED#) / 1000
                    SHOCKS(s).power# = shockPower#

                    SHOCK_LIVE(SHOCK_LIVE_COUNT) = s
                    shockLiveR# = SHOCKS(s).radius#
                    SHOCK_LIVE_X#(SHOCK_LIVE_COUNT) = SHOCKS(s).x#
                    SHOCK_LIVE_Y#(SHOCK_LIVE_COUNT) = SHOCKS(s).y#
                    SHOCK_LIVE_R#(SHOCK_LIVE_COUNT) = shockLiveR#
                    SHOCK_LIVE_P#(SHOCK_LIVE_COUNT) = shockPower#
                    SHOCK_LIVE_DX#(SHOCK_LIVE_COUNT) = SHOCKS(s).dirX#
                    SHOCK_LIVE_DY#(SHOCK_LIVE_COUNT) = SHOCKS(s).dirY#
                    shockLiveOut# = shockLiveR# + SHOCK_WIDTH#
                    SHOCK_LIVE_OUT2#(SHOCK_LIVE_COUNT) = shockLiveOut# * shockLiveOut#
                    shockLiveIn# = shockLiveR# - SHOCK_WIDTH#
                    SHOCK_LIVE_IN2#(SHOCK_LIVE_COUNT) = -1
                    if shockLiveIn# > 0 then SHOCK_LIVE_IN2#(SHOCK_LIVE_COUNT) = shockLiveIn# * shockLiveIn#
                    SHOCK_LIVE_COUNT = SHOCK_LIVE_COUNT + 1
                endif
            endif
        endif
    next

    ` the same rings push the picture of the whole screen as they pass
    perf lap 30
    gosub frame_ripples
    perf lap 31

    ` which fish have one of their own kind at a corner. see DIAGONALS in fish_headers.
    stepDiagonalHints()
    perf lap 32
    diagonalPeriod = CURRENT_PERIOD#
    diagonalNudgeTime# = DIAGONAL_HINT_SHUFFLE_MS

    ` the cell that the diver's flashlight is in, or -1, and how far from it the cells to each side of
    ` it are. one that is off of the edge of the board is 0, which is the diver's own cell. see THE FLASHLIGHT
    ` in fish_headers_diver.
    torchAt = DIVER_LIGHT_AT
    torchUp = 0 - CELL_COLUMN_COUNT
    torchRight = 0
    torchLeft = 0
    if torchAt >= 0
        torchColumn = torchAt mod CELL_COLUMN_COUNT
        if torchColumn < CELL_COLUMN_COUNT - 1 then torchRight = 1
        if torchColumn > 0 then torchLeft = -1
    endif

    for i = 0 to CELL_COUNT - 1
        c = CELLS(i)

        ` the fish sit still, except for where a shockwave is passing under them, or a wave of the current.
        ` lift is how far up the bump the fish is, and lean is how steep the bump is under it, in each direction.
        lift# = 0
        leanX# = 0
        leanY# = 0
        shockTouched = 0 `1 once a ring reaches this fish. with none, there is nothing to bend over below.
        if SHOCK_LIVE_COUNT > 0
            for s = 0 to SHOCK_LIVE_COUNT - 1
                ` most fish are nowhere near most rings: those are left out before anything else is worked out
                shockX# = c.coord.x - SHOCK_LIVE_X#(s)
                shockY# = c.coord.y - SHOCK_LIVE_Y#(s)
                shockD2# = shockX# * shockX# + shockY# * shockY#
                if shockD2# >= SHOCK_LIVE_OUT2#(s) then skip
                if shockD2# <= SHOCK_LIVE_IN2#(s) then skip
                ` how far, without a square root: the longer way, and some of the shorter way, never more than
                ` about 4 in 100 off
                shockAX# = abs(shockX#)
                shockAY# = abs(shockY#)
                if shockAX# > shockAY#
                    shockDist# = shockAX# * .96 + shockAY# * .398
                else
                    shockDist# = shockAY# * .96 + shockAX# * .398
                endif

                ` this is 0 on top of the bump, 1 at the front edge of it, and -1 at the back edge
                shockAhead# = (shockDist# - SHOCK_LIVE_R#(s)) / SHOCK_WIDTH#
                if abs(shockAhead#) >= 1 then skip
                shockTouched = 1

                ` a ring that is headed one way is at its strongest for the fish that are that way from where
                ` it started. it fades off to the sides, and there is none of it for the fish straight behind.
                shockPower# = SHOCK_LIVE_P#(s)
                if shockDist# > .01
                    if SHOCK_LIVE_DX#(s) <> 0 or SHOCK_LIVE_DY#(s) <> 0
                        shockFacing# = .5 + (.5 * (shockX# * SHOCK_LIVE_DX#(s) + shockY# * SHOCK_LIVE_DY#(s))) / shockDist#
                        shockPower# = shockPower# * shockFacing# * shockFacing#
                    endif
                endif

                lift# = lift# + (.5 + .5 * cos(shockAhead# * 3.14159)) * shockPower#

                ` the fish in the very middle has no way to lean
                if shockDist# > .01
                    shockSlope# = sin(shockAhead# * 3.14159) * shockPower#
                    leanX# = leanX# + (shockSlope# * shockX#) / shockDist#
                    leanY# = leanY# + (shockSlope# * shockY#) / shockDist#
                endif
            next
        endif

        if shockTouched
            ` the sums bend over as they get big, so that rings on top of rings still show
            lift# = lift# / sqrt(1 + (lift# * lift#) / (SHOCK_LIFT_MAX# * SHOCK_LIFT_MAX#))
            leanBend# = sqrt(1 + (leanX# * leanX# + leanY# * leanY#) / (SHOCK_LEAN_MAX# * SHOCK_LEAN_MAX#))
            leanX# = leanX# / leanBend#
            leanY# = leanY# / leanBend#

            ` positive yaw faces the fish to the right, and positive pitch faces it up, which is the other way from y
            yaw# = leanX# * SHOCK_TILT#
            pitch# = 0 - leanY# * SHOCK_TILT#
            pushX# = leanX# * SHOCK_PUSH#
            pushY# = leanY# * SHOCK_PUSH# - lift# * SHOCK_BOB# `up the screen is the other way from y
            lift# = lift# * SHOCK_LIFT#
        else
            ` no ring is under it: all of that comes out as 0 anyway, and lift# already is
            yaw# = 0
            pitch# = 0
            pushX# = 0
            pushY# = 0
        endif

        ` the current. the phase goes around once for every wave, and it is later for the fish that are
        ` further along the way that the wave goes.
        currentAlong# = c.coord.x * CURRENT_DIR_X# + c.coord.y * CURRENT_DIR_Y#
        currentPhase# = (shockNow * 6.28318) / CURRENT_PERIOD# - currentAlong# * CURRENT_SPREAD#

        ` this is 1 when the wave is right on the fish, and it drops off to nothing very quickly on both
        ` sides of that, so the fish is still for most of the time
        currentNear# = .5 + .5 * cos(currentPhase#)
        currentNear# = currentNear# * currentNear#
        currentNear# = currentNear# * currentNear#
        currentNear# = currentNear# * currentNear#

        ` the fish leans one way as the wave gets to it, and the other way as it leaves. the 3.7 makes the most of that 1.
        currentLean# = sin(currentPhase#) * currentNear# * 3.7 * CURRENT_TILT#

        ` a fish that has one of its own kind at a corner leans toward it as the wave gets there, in place of
        ` leaning into the wave. see DIAGONALS in fish_headers.
        diagonalLeanX# = DIAGONAL_HINT_X(i)
        diagonalLeanY# = DIAGONAL_HINT_Y(i)
        if diagonalLeanX# <> 0 or diagonalLeanY# <> 0
            diagonalLean# = currentNear# * DIAGONAL_HINT_LEAN#
            yaw# = yaw# + diagonalLean# * diagonalLeanX#
            pitch# = pitch# - diagonalLean# * diagonalLeanY#
        else
            yaw# = yaw# + currentLean# * CURRENT_DIR_X#
            pitch# = pitch# - currentLean# * CURRENT_DIR_Y#
        endif

        ` and the fish of a line that is one short nudge along it, one after another, starting when the
        ` wave gets to the left end of the line
        if DIAGONAL_HINT_SLOPE(i) <> 0
            diagonalAge = shockNow + diagonalPeriod * 4
            diagonalAge = diagonalAge - DIAGONAL_HINT_DELAY(i)
            diagonalAge = diagonalAge mod diagonalPeriod

            ` the debug key plays it right away, without waiting for a wave. see frame_dbg.
            diagonalAsked = shockNow - DIAGONAL_HINT_NOW_MS
            if diagonalAsked < 5000
                diagonalAge = diagonalAsked - DIAGONAL_HINT_PLACE(i) * DIAGONAL_HINT_STEP_MS
                if diagonalAge < 0 then diagonalAge = DIAGONAL_HINT_SHUFFLE_MS
            endif
            if diagonalAge < DIAGONAL_HINT_SHUFFLE_MS
                diagonalAge# = diagonalAge
                ` it eases out and eases back, so that the fish never starts or stops with a jerk
                diagonalNudge# = sin((diagonalAge# * 3.14159) / diagonalNudgeTime#)
                ` the fish drifts toward the next corner of its line, and back. a push is in whole pixels, so
                ` it goes far enough, and slowly enough, to be a drift and not a hop.
                diagonalNudge# = diagonalNudge# * diagonalNudge# * DIAGONAL_HINT_SHUFFLE#
                diagonalSlope# = DIAGONAL_HINT_SLOPE(i)
                pushX# = pushX# + diagonalNudge#
                pushY# = pushY# + diagonalNudge# * diagonalSlope#
            endif
        endif

        ` nothing leans, shuffles or bobs while the fish are making the QR code. see TUNA in fish_headers.
        tunaCalm# = 1 - TUNA_EASED#
        if TUNA_EASED# > 0
            yaw# = yaw# * tunaCalm#
            pitch# = pitch# * tunaCalm#
            pushX# = pushX# * tunaCalm#
            pushY# = pushY# * tunaCalm#
            lift# = lift# * tunaCalm#
        endif

        ` a fish that is belly up is turned all the way over, top over bottom. the turn that is drawn chases
        ` the real one, so that the fish can be seen rolling over. once it is over, it rocks from side to
        ` side a little, like it is floating.
        bellyWant# = c.bellyUp * 3.14159
        bellyShown# = c.bellyShown# + (bellyWant# - c.bellyShown#) * BELLY_UP_EASE#
        if abs(bellyWant# - bellyShown#) < .01 then bellyShown# = bellyWant#
        CELLS(i).bellyShown# = bellyShown#
        pitch# = pitch# + bellyShown#

        ` a skeleton turns the rest of the way over, back to the right way up, and stops rocking as it gets there
        bellyRock# = bellyShown#
        if bellyRock# > 3.14159 then bellyRock# = 6.28318 - bellyRock#
        yaw# = yaw# + (sin(shockNow * .003 + i) * BELLY_UP_ROCK# * bellyRock# * tunaCalm#) / 3.14159

        ` a fish in a bubble floats around inside it, and rocks, and is seen through it. the effect takes
        ` 4000 more for that, further down. see HOW IT LOOKS in fish_headers_bubbled.
        bubbledHere = 0
        if BUBBLED_AT(i)
            if c.value > 0 then bubbledHere = 1
        endif
        if bubbledHere
            ` it starts to float as its bubble grows in, and it is seen through the bubble once that is
            ` most of the way there
            bubbledEase# = bubbledGrown(i)
            if bubbledEase# < .4 then bubbledHere = 0
            bubbledT# = shockNow * .001 * BUBBLED_WOBBLE_SPEED# + i * 2.3
            pushX# = pushX# + sin(bubbledT# * 1.3) * BUBBLED_WOBBLE# * bubbledEase#
            pushY# = pushY# + sin(bubbledT# * 1.9 + 1) * BUBBLED_WOBBLE# * .8 * bubbledEase#
            yaw# = yaw# + sin(bubbledT# * 1.1 + .5) * BUBBLED_WOBBLE_TURN# * bubbledEase#
            pitch# = pitch# + sin(bubbledT# * .8 + 2) * BUBBLED_WOBBLE_TURN# * .5 * bubbledEase#
        endif

        ` and it is drawn as its bones from the moment that it is edge on, so the fish goes over and the
        ` skeleton comes around. see SKELETONS in fish_headers. whatever else sets the picture of a fish
        ` only knows about its kind, so this puts the bones back on every frame, and takes them off
        ` again when the fish in the cell is not a skeleton any more.
        skeletonWant = 0
        if c.bellyUp = 2
            if c.value > 0
                if bellyShown# > 4.71 then skeletonWant = 1
            endif
        endif
        if i = SQUID_CELL then skeletonWant = 0
        if skeletonWant
            setFishTexture(c.spriteId, SKELETON_TEX(c.value))
            SKELETON_SHOWN(i) = 1
        else
            if SKELETON_SHOWN(i)
                SKELETON_SHOWN(i) = 0
                if c.value > 0
                    setFishTexture(c.spriteId, c.value)
                endif
            endif
        endif

        ` the squid of the night is drawn over the fish that it took. squidStep puts the fish back when
        ` it goes. see fish_headers_squid.
        if i = SQUID_CELL
            squidUnshow()
            setFishTexture(c.spriteId, TEX_SQUID)
            SQUID_SHOWN_CELL = i
        endif

        ` the count that is drawn chases the real one, so that a new fish slides out from behind
        stackWant# = c.stack + 1
        stackShown# = c.stackShown# + (stackWant# - c.stackShown#) * FISH_STACK_EASE#
        if abs(stackWant# - stackShown#) < .01 then stackShown# = stackWant#
        CELLS(i).stackShown# = stackShown#

        ` the effect grows the sprite to make room, so it needs to know how big the sprite is on the screen
        fishSize# = sprite width(c.spriteId) * sprite scale x(c.spriteId)

        ` a fish at an end of the trail of the glow is turned around. see WHAT SHOWS in fish_headers_glow.
        yaw# = yaw# + GLOW_TURN#(i) * 3.14159

        ` a fish that faces the other way from its picture is drawn turned around, and it turns slowly.
        ` see FACING in fish_headers_school.
        schoolFxWant# = 0
        schoolFxArt = 0
        if c.value > 0
            if c.value < 64
                schoolFxArt = SCHOOL_ART_FACE(c.value)
            endif
        endif
        if schoolFxArt <> 0
            if SCHOOL_FACE(i) <> schoolFxArt then schoolFxWant# = 1
        endif
        if SCHOOL_SNAP
            SCHOOL_SHOWN#(i) = schoolFxWant#
        else
            SCHOOL_SHOWN#(i) = SCHOOL_SHOWN#(i) + (schoolFxWant# - SCHOOL_SHOWN#(i)) * SCHOOL_TURN_STEP#
        endif
        yaw# = yaw# + SCHOOL_SHOWN#(i) * 3.14159
        set sprite all texcoord1 c.spriteId, pitch#, yaw#, stackShown#, fishSize#

        ` the fish goes to its place in the QR code, and gets smaller. see TUNA in fish_headers.
        tunaPushX# = TUNA_CELL_DX(i) * TUNA_EASED#
        tunaPushY# = TUNA_CELL_DY(i) * TUNA_EASED#

        ` at night the fish glow, but not a dead one, and not a bottle or anything of a quest's. the
        ` effect takes -1 for a fish that does not. see THE NIGHT DIVE in fish_headers_tide.
        ` the fish of a group that the night is holding are a little brighter, and one that is in a
        ` group that was just made flashes. see NOTHING POPS AT NIGHT, in the same place.
        nightGlow# = 0
        if TIDE_NIGHT
            if TIDE_BANKED(i) then nightGlow# = TIDE_BANK_GLOW#
            if TIDE_PULSE_UNTIL(i) > shockNow
                nightFlash# = TIDE_PULSE_UNTIL(i) - shockNow
                nightFlashSpan# = TIDE_PULSE_MS
                nightGlow# = nightGlow# + nightFlash# / nightFlashSpan#
            endif
        endif

        ` a jellyfish shimmers around its edge at night. it is only for fun. the effect takes 10 more
        ` for that. see THE NIGHT DIVE in fish_headers_tide.
        if c.value = TEX_JELLY then nightGlow# = nightGlow# + 10
        if c.bellyUp > 0 then nightGlow# = -1
        if c.value >= TEX_BOTTLE then nightGlow# = -1

        ` a fish in the light of the diver's flashlight is drawn the way that it is in the day. the
        ` effect takes -2 for that. see THE FLASHLIGHT in fish_headers_diver.
        if torchAt >= 0
            torchGap = i - torchAt
            if torchGap = CELL_COLUMN_COUNT then nightGlow# = -2
            if torchGap = torchUp then nightGlow# = -2
            if torchGap = torchRight then nightGlow# = -2
            if torchGap = torchLeft then nightGlow# = -2
        endif

        ` a picture from the CustomArt folder whose name ends in _b gets a black line drawn around it.
        ` the effect takes 100 more for that. the new art's thick line is a 2, and the effect takes 200
        ` more for that one. see fish_headers_customart.
        customOutline = CUSTOM_ART_OUTLINE(c.value)
        if skeletonWant
            customOutline = CUSTOM_ART_OUTLINE(CUSTOM_ART_BONES_SLOT)
        endif
        ` the squid glows the way that any fish does at night, whatever it took over, and its picture is
        ` one of the new ones, which have the thick line. see fish_headers_squid.
        if i = SQUID_CELL
            nightGlow# = 0
            customOutline = NEW_ART_THICK * 2
        endif
        if customOutline = 1 then nightGlow# = nightGlow# + 100
        if customOutline = 2 then nightGlow# = nightGlow# + 200

        ` a rainbow fish has a line of the rainbow. the effect takes 2000 more for that. see
        ` fish_headers_rainbow.
        if RAINBOW_FISH(i)
            if c.value > 0 then nightGlow# = nightGlow# + 2000
        endif

        ` a fish of a burst of the rainbow fish is flooded with the rainbow, from when it lights up until
        ` it pops. the effect takes 1000 more for that. see THE BURST in fish_headers_rainbow.
        ` and so is a fish of a group that brings more of them, for a moment. see AND THEY BREED.
        cellFlooded = 0
        if RAINBOW_BURST_CELLS(i)
            if shockNow < RAINBOW_BURST_UNTIL
                if shockNow >= RAINBOW_BURST_FROM(i) then cellFlooded = 1
            endif
        endif
        if shockNow < RAINBOW_LIT_UNTIL(i)
            if shockNow >= RAINBOW_LIT_FROM(i) then cellFlooded = 1
        endif
        if cellFlooded then nightGlow# = nightGlow# + 1000
        if bubbledHere then nightGlow# = nightGlow# + 4000

        ` the fish that the squid was on grows back in, and the squid grows in where it lands. see A PUSH in fish_headers_squid.
        if i = SQUID_BACK_CELL or i = SQUID_IN_CELL
            squidShrink = squidShrinkAt(i, shockNow)
            lift# = lift# - squidShrink * .001
        endif

        set sprite all texcoord2 c.spriteId, pushX# * fishSize# + tunaPushX#, pushY# * fishSize# + tunaPushY#, lift# + TUNA_SHRINK#, nightGlow#
    next

return

dbg# = 1.0
dbg_str$ = "world2"
frame_dbg:




















    ` the debug keys are only there in debug mode. see DEBUG_MODE in fish_headers.
    ` the debug panel also has a window that gives the player any card. see fish_routines_debug.
    ` U turns the fish above the cursor belly up, and a second press turns it into a skeleton.
    ` G grows coral on the cell that the cursor is on, and H grows horror coral there.
    ` N plays the hint of the diagonals, right away: the shuffle that runs along every line that is one short.
    ` J plays a hint, right away, the way that it looks without the "listen" card. K plays one the way
    ` that it looks with the card, after a group of five or more: brighter, with more bubbles, and a trail.
    ` R covers the whole board with coral, which saves the reef, and T covers it with horror coral, which
    ` summons the ancient one. the ending plays, and then the game ends, the way that it would have.
    ` Y wins the game the usual way, as if the last round had been got through, so the fish go home.
    ` M sounds the ding and starts a tune to move the cursor in time to. see THE DANCE in fish_headers.
    ` B puts a bottle on the cell that the cursor is on. carry it up to the top row for the diver. see fish_headers_diver.
    ` L puts a jellyfish there, and V a stingray.
    ` O fills the album of the diver, so that the diver swims up and its ending plays. it brings the diver down first, if it is not.
    ` 1 turns the thin black line drawn into the new art on or off, and 2 the thick deep-water line (on to start). see THE NEW ART in fish_headers_customart.
    if DEBUG_MODE
        debugSplashStep(game ms())
        gosub frame_debug_art_outline
        if MENU_MODE = 0
            gosub frame_debug_cards
            gosub frame_debug_beat
            gosub frame_debug_tide
            gosub frame_debug_glow
            gosub frame_debug_school
            gosub frame_debug_rainbow
            gosub frame_debug_quests
            gosub frame_debug_angler
            if INFO_MODE = 0
                ` the dance. see THE DANCE in fish_headers.
                if new key down(scancode("M"))
                    startBeatDance(1)
                endif
                if new key down(scancode("U"))
                    if SELECTION_POS.y > 0
                        dbgBellyIndex = SELECTION_POS.x + (SELECTION_POS.y - 1) * CELL_COLUMN_COUNT
                        if CELLS(dbgBellyIndex).bellyUp < 2
                            CELLS(dbgBellyIndex).bellyUp = CELLS(dbgBellyIndex).bellyUp + 1
                        endif
                    endif
                endif

                ` a bottle, for the diver. see fish_headers_diver.
                if new key down(scancode("B"))
                    dbgBottleIndex = SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT
                    CELLS(dbgBottleIndex).value = TEX_BOTTLE
                    RAINBOW_FISH(dbgBottleIndex) = 0
                    clearCellStack(dbgBottleIndex)
                    updateCell(CELLS(dbgBottleIndex))
                endif

                ` the ending of the diver, right away
                if new key down(scancode("O"))
                    diverDebugWin(SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT)
                endif

                ` a jellyfish, or a stingray, without their cards
                dbgSpawnKind = 0
                if new key down(scancode("L")) then dbgSpawnKind = TEX_JELLY
                if new key down(scancode("V")) then dbgSpawnKind = TEX_RAY
                if dbgSpawnKind > 0
                    dbgSpawnIndex = SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT
                    if CELLS(dbgSpawnIndex).value <> TEX_DIVER
                        CELLS(dbgSpawnIndex).value = dbgSpawnKind
                        clearCellStack(dbgSpawnIndex)
                        updateCell(CELLS(dbgSpawnIndex))
                    endif
                endif

                ` the hidden game. see CORAL in fish_headers.
                if new key down(scancode("G"))
                    coralDebugGrow(SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT, 0)
                endif
                if new key down(scancode("H"))
                    coralDebugGrow(SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT, 1)
                endif
                ` N plays the hint of the diagonals right away: the shuffle that runs along every line that is one short
                if new key down(scancode("N"))
                    DIAGONAL_HINT_NOW_MS = game ms()
                endif
                if new key down(scancode("J"))
                    coralClearHint()
                    CORAL_HINT_AS_LISTEN = 0
                    dbgHintMade = coralStartAnyHint()
                endif
                if new key down(scancode("K"))
                    coralClearHint()
                    CORAL_HINT_AS_LISTEN = 1
                    dbgHintMade = coralStartAnyHint()
                    CORAL_HINT_TRAIL_ON = dbgHintMade
                endif
                if new key down(scancode("R"))
                    coralDebugCover(0)
                endif
                if new key down(scancode("T"))
                    coralDebugCover(1)
                endif
                if new key down(scancode("Y"))
                    ` as if the last round had just been won. a game that was being carried on with is won again.
                    if CORAL_ENDING = 0
                        GAME_ENDLESS = 0
                        REQUEST_GAME_END = 1
                    endif
                endif
            endif
        endif
    endif
return
    begin debug window("Debug")
        debug inspector
    end debug window
    begin debug window("Console")
        debug console
    end debug window
return

` a stretch of the steam timeline for every round, from when the bar starts on it to when it fills up,
` so that a round can be found again in a recording of the game. the upgrade screen has a stretch of
` its own, which handle_ability_selection starts and advanceScoreBar ends, because the main loop does
` not come here while the upgrade screen is up.
frame_steam_timeline:
    ` a demo is not marked on the timeline. see THE DEMO in fish_headers_demo.
    if DEMO_MODE then return
    timelineRound = 0
    if MENU_MODE = 0
        if SCORE_BAR_HOLD = 0 then timelineRound = CURRENT_ROUND + 1
    else
        ` a pause leaves the round as it is. back at the title, there is no round.
        timelineRound = STEAM_TIMELINE_ROUND
        if MENU_MODE = MENU_MODE_MAIN then timelineRound = 0
    endif
    if timelineRound = STEAM_TIMELINE_ROUND then return

    STEAM_TIMELINE_ROUND = timelineRound
    if timelineRound = 0
        end steam timeline range STEAM_RANGE_ROUND
        clear steam timeline tooltip
        return
    endif
    start steam timeline range STEAM_RANGE_ROUND, loc$("steam.round", "round", timelineRound), "", "steam_flag", 50
    set steam timeline tooltip loc$("steam.round", "round", timelineRound)
return

frame_score:

    ` the points of the fish that popped on this frame go onto the bar
    stepScoreTicks()

    ` the round is over when the bar has been seen to fill up, which is a moment after the score got there
    if SCORE_BAR_HOLD = 0 and SCORE_SHOWN >= SCORE_BAR.endVal
        
        ` update the rounds left
        CURRENT_ROUND = CURRENT_ROUND + 1
        showRoundsLeft()

        ` a mark on the steam timeline, so that the round can be found again in a recording of the game
        if DEMO_MODE = 0
            add steam timeline event loc$("steam.round.cleared", "round", CURRENT_ROUND), loc$("steam.round.cleared.desc", "moves", CURRENT_MOVE_COUNT), "steam_checkmark", 100, 0
        endif

        ` the quest of the round is over with it. see QUESTS in fish_headers_quests.
        questRoundEnded()


        ` the bar stays full until an upgrade has been picked. then advanceScoreBar starts it on the next round.
        SCORE_BAR_HOLD = 1
        create basic tween SCORE_BAR.progressTweenId, tweenVal(SCORE_BAR.progressTweenId), 1, 90, 0
    endif

    ` the points past the end of a full bar go toward more multiplier. see OVERFLOW in fish_headers.
    stepOverflow()

    if SCORE_BAR_HOLD > 0

        ` show ability upgrade! but not while fish are still popping. it waits for the board to settle,
        ` and for the points of the last fish to get onto the bar, so that none of the overflow is missed.
        ` and for a quest that the round ended on to go off in its bubbles. see A QUEST THAT THE ROUND ENDS ON in fish_headers_quests.
        ` and, at the end of a night, for the constellation to pop and day to break, and for the pot of the
        ` day to pay, so that none of it is missed behind the upgrade screen. see THE END OF THE NIGHT and
        ` THE POT in fish_headers_squid.
        questLeaving = questHoldsRound()
        if SCORE_BAR_HOLD = 1 and REQUEST_COMBO_CHECK = 0 and LIVE_MOVE_ACTIVE = 0 and SCORE_TICK_COUNT = 0 and questLeaving = 0 and SQUID_ENDING = 0 and INK_PAYING = 0
            roundWasLast = 0
            if getRoundsLeft() <= 0
                ` a game that was won already, and is being carried on with, has no last round. see KEEP PLAYING in fish_headers.
                if GAME_ENDLESS = 0 then roundWasLast = 1
            endif
            if roundWasLast
                ` that was the last round, so the game is over. handle_game_end, in fish_routines_menu, says so.
                REQUEST_GAME_END = 1
                SCORE_BAR_HOLD = 2
            else
                ` and neither does a game under the "oceanic oath". see fish_headers_fast.
                roundNoUpgrade = GAME_ZEN
                if fastOath() then roundNoUpgrade = 1
                if DEMO_MODE then roundNoUpgrade = 1 `nor does a demo. see THE DEMO in fish_headers_demo.
                if roundNoUpgrade
                    ` a zen game has no upgrades. the bar empties out, and the next round starts.
                    advanceScoreBar()
                else
                    REQUEST_ABILITY_SELECTION = 1
                    SCORE_BAR_HOLD = 2
                endif
            endif
        endif

        ` until the upgrade screen comes up, the full bar fizzes with bubbles, all the way along it
        if game ms() >= SCORE_BAR_FIZZ_MS
            SCORE_BAR_FIZZ_MS = game ms() + SCORE_BAR_FIZZ_GAP
            for fizzN = 1 to 2
                fizzColor = rgb(64, 128, 255)
                ` once there are points past the end, it fizzes in the color of the overflow
                fizzOver = OVERFLOW_TIER + OVERFLOW_POINTS
                if fizzOver > 0 then fizzColor = getOverflowColor(OVERFLOW_TIER)
                if rnd(3) = 0 then fizzColor = rgb(255, 255, 255)
                spawnBubblesOnLayer(SCORE_BAR.pos.x + rnd(SCORE_BAR.size.x), SCORE_BAR.pos.y + 2, 2, 1, 0, fizzColor, ORDER_FLOAT_BUBBLES, 40, 255, 1)
            next

            ` the cursor on the board fizzes along with it, in the color of its outline
            fizzColor = rgb(112, 140, 224)
            if rnd(3) = 0 then fizzColor = rgb(255, 255, 255)
            spawnBubblesOnLayer(getCellX(SELECTION_POS.x), getCellY(SELECTION_POS.y), CELL_SIZE / 2, 1, 0, fizzColor, ORDER_FLOAT_BUBBLES, 40, 255, getBoardBubbleScale())
        endif

        ` and it shakes, the same as the bar does. a move that is playing out, or the shake of a move that
        ` cannot be made, puts the cursor where it wants it, so this leaves the cursor alone for those.
        if LIVE_MOVE_ACTIVE = 0 and CURSOR_SHAKING = 0
            position sprite SELECTION_SPRITE, getCellX(SELECTION_POS.x) + rnd(3) - 1, getCellY(SELECTION_POS.y) + rnd(3) - 1
        endif
    endif

    for i = 0 to PROGRESS_BAR_COUNT - 1
        bar = PROGRESS_BARS(i)
        barFill# = tweenVal(bar.progressTweenId)
        scoreWidth# = (bar.size.x - 2.0) * barFill#
        size sprite bar.foregroundSpriteId, scoreWidth#, 2

        ` the bar shakes by a pixel while it is filling up. while it is full and fizzing, it shakes
        ` every which way, and it is brighter. it sits still when it is emptying out, or doing nothing.
        barShakeX = 0
        barShakeY = 0
        barColor = rgb(64, 128, 255, 200)
        if barFill# > SCORE_BAR_LAST_FILL# then barShakeY = rnd(2)
        if SCORE_BAR_HOLD > 0
            barShakeX = rnd(3) - 1
            barShakeY = rnd(3) - 1
            barColor = rgb(190, 225, 255, 255)
        endif
        SCORE_BAR_LAST_FILL# = barFill#

        position sprite bar.backgroundSpriteId, bar.pos.x + barShakeX, bar.pos.y + barShakeY
        position sprite bar.foregroundSpriteId, bar.pos.x + 1 + barShakeX, bar.pos.y + 1 + barShakeY
        color sprite bar.foregroundSpriteId, barColor
        span = bar.endVal - bar.startVal
        z$ = "/"
        x$ = str$(span)
        ` a bar that is being held full says that it is full, and not how far past the end the score went
        shownInRound = SCORE_SHOWN - SCORE_BAR.startVal
        if SCORE_BAR_HOLD and shownInRound > span then shownInRound = span
        ` while the tutorial shows what the bar is, the numbers follow the bar. see tutorial_round_bar.
        if TUTORIAL_BAR_DEMO then shownInRound = span * barFill#
        y$ = str$(shownInRound)

        ` and once there are points past the end, it counts them toward the next bonus multiplier
        if OVERFLOW_NEED > 0 and OVERFLOW_POINTS > 0
            y$ = "+" + str$(OVERFLOW_POINTS)
            x$ = str$(OVERFLOW_NEED)
        endif

        concat$ = y$ + z$ + x$
        set text bar.textNumId, y$ + z$ + x$

        ` the overflow is drawn over the full bar, and shakes along with it
        overWidth# = (bar.size.x - 2.0) * OVERFLOW_FILL#
        size sprite OVERFLOW_SPRITE, overWidth#, 2
        position sprite OVERFLOW_SPRITE, bar.pos.x + 1 + barShakeX, bar.pos.y + 1 + barShakeY
        overDrawTier = OVERFLOW_TIER
        if overDrawTier >= OVERFLOW_TIER_MAX then overDrawTier = OVERFLOW_TIER_MAX - 1
        color sprite OVERFLOW_SPRITE, getOverflowColor(overDrawTier)
        set sprite alpha OVERFLOW_SPRITE, 255 * HUD_KEEP#
    next



return

` the upgrade screen comes here when an upgrade has been picked. see SCORE_BAR_HOLD in fish_headers.
advance_score_bar:
    advanceScoreBar()

    ` the cursor was shaking along with the full bar, and it goes back to exactly where it belongs
    gosub update_selection_position
return

` take the free moves off of the counter one at a time, so that the counter can be seen ticking down
frame_free_moves:
    if PENDING_FREE_MOVES > 0
        if is tween done(FREE_MOVES_TICK_TWEEN_ID)
            PENDING_FREE_MOVES = PENDING_FREE_MOVES - 1
            registerMove(-1)

            ` a little copy of the move flies off of the counter, the same way that score flies off of the fish
            freeMovePos as vec = {
                x = 94 + rnd(12),
                y = SCORE_POS.y + 24
            }
            txtId = spawnScoreText(freeMovePos, "-1", 0)
            color text txtId, rgb(190, 220, 255)

            ` every move that comes off gives the screen a little knock
            create basic tween FREE_MOVES_SHAKE_TWEEN_ID, 0, SHAKE_FREE_MOVE_AMOUNT#, 180, 0
            set tween type FREE_MOVES_SHAKE_TWEEN_ID, 1
            set screen shake bounce .5
            FREE_MOVES_SHAKING = 1

            ` and then wait a moment before the next one
            create basic tween FREE_MOVES_TICK_TWEEN_ID, 0, 1, 140, 0
        endif
    endif

    ` the combos shake the screen too, so only touch the shake while this one is running
    if FREE_MOVES_SHAKING
        if is tween done(FREE_MOVES_SHAKE_TWEEN_ID) > 0 AND PENDING_FREE_MOVES = 0
            set screen shake amount 0
            FREE_MOVES_SHAKING = 0
        else
            set screen shake amount tweenVal(FREE_MOVES_SHAKE_TWEEN_ID)
        endif
    endif
return

frame_texts:
    for i = 0 to SCORE_TEXT_COUNT - 1
        scoreTxt = SCORE_TEXTS(i)

        if scoreTxt.active = 0
            `hide text scoreTxt.textId
        else 
            `show text scoreTxt.textId
        endif
        
        if is tween done(scoreTxt.floatTweenIdX)

            ` TODO: this is all a mess. I don't know how I want the score to move.

            ` should it move up to the score bar?
            x = SCORE_BAR.pos.x + SCORE_BAR.size.x - 4 `* tweenVal(SCORE_BAR.progressTweenId)
            y = SCORE_BAR.pos.y

            ` or should it just go "up"
            ` a text on a board that has been zoomed out is smaller, and it floats a shorter way to match
            x = tweenVal(scoreTxt.floatTweenIdX)
            y = tweenVal(scoreTxt.floatTweenIdY) - 50 * scoreTxt.scale#

            `x+= (rnd(6)-3) * 5
            y -= rnd(2) * 4 * scoreTxt.scale#

            ` TODO: BUG: float division seems broken? These always come out to zero. 
            flip# = 1.0 / (WORLD_HEIGHT + 1.0)
            r# = tweenVal(scoreTxt.floatTweenIdY)/(WORLD_HEIGHT*1.0)
            speed = 200` + 2*tweenVal(scoreTxt.floatTweenIdY) `it would be nice to scale the duration with the distance needs to travel. 
            create basic tween scoreTxt.floatTweenIdX, tweenVal(scoreTxt.floatTweenIdX), x, speed, 150
            create basic tween scoreTxt.floatTweenIdY, tweenVal(scoreTxt.floatTweenIdY), y, speed, 150
        else
            set text position scoreTxt.textId, tweenVal(scoreTxt.floatTweenIdX), tweenVal(scoreTxt.floatTweenIdY)
        endif
        
        size text y scoreTxt.textId, tweenVal(scoreTxt.scaleOutTweenId)

        if is tween done(scoreTxt.fadeInTweenId) > 0
            set text alpha scoreTxt.textId, tweenVal(scoreTxt.fadeTweenId)
        else 
            set text alpha scoreTxt.textId, tweenVal(scoreTxt.fadeInTweenId)
        endif
        ` TODO: add 'set text alpha' command
    next
return

frame_scale_wave:

    for i = 0 to CELL_COUNT - 1
        c = CELLS(i)
        ` a fish that is sitting on coral is a little smaller. see A FISH ON CORAL in fish_headers.
        scale = tweenVal(c.scaleWaveTweenId) * CELL_ART_SIZE * CORAL_SIT#(i)
        size sprite c.spriteId, scale, scale
    next

return

handle_combos:

    remstart
        need to scan through the rows and find groups of similar valued cells 
        once a group of big-enough size is found, it blows up 
        all blow-ups happen "at once" (animated randomly) 
        then all cells need to "fall" to fill in gaps
        then new cells need to spawn in from the top and "fall" into place
    remend

    if REQUEST_COMBO_CHECK = 0 then return

    ` a swap that is still playing out has not happened yet, so the board is not ready to be looked at
    if LIVE_MOVE_ACTIVE then return

    ` day is breaking, and the light comes back before anything pops. see WHEN DAY BREAKS in fish_headers_tide.
    if TIDE_DAWN_UNTIL > 0
        dawnNow = game ms()
        if dawnNow < TIDE_DAWN_UNTIL then return
        TIDE_DAWN_UNTIL = 0
    endif

    ` the swap that set this look off, if one did. a big group that it finished leaves its bottle in the
    ` cell of the swap. the looks after it, as the board fills back in, have none. see BOTTLES in fish_headers.
    BOTTLE_LOOK_A = BOTTLE_SWAP_A
    BOTTLE_LOOK_B = BOTTLE_SWAP_B
    BOTTLE_SWAP_A = -1
    BOTTLE_SWAP_B = -1

    ` bubbles that touch come together and pop, and one on coral bursts. see HOW IT ENDS in fish_headers_bubbled.
    bubbledSettle()

    ` a bottle that has got to the bottom row pays out, and is popped along with whatever else pops
    checkBottles()

    ` there is one diver, at the most, and nothing has happened to it. see fish_headers_diver.
    diverMend()

    ` clear the combo mask...
    for i = 1 to CELL_COUNT
        c = CELLS(i-1)
        c.comboFillMask = 0
        c.comboFillId = 0
        c.comboBlownUp = 0
        c.comboDownShift = 0
    
        CELLS(i-1) = c
    next

    ` the groups that the night was holding are found again. see NOTHING POPS AT NIGHT in fish_headers_tide.
    tideLookStarts()

    ` the groups of the fish that a swap has just moved go through skeletons. see SKELETONS in fish_headers.
    skeletonsBeforeCombos()

    groupId = 0
    for i = 1 to CELL_COUNT
        c = CELLS(i-1)

        if c.comboFillMask > 0 then skip

        ` flood fill from this cell if it has not already been combo checked

        CELLS(i-1).comboFillId = groupId
        findCombos(i - 1, groupId)
        groupId += 1
    next

    ` the groups have been found, so the skeletons that were taken into one are the kinds of fish that they were again
    skeletonsAfterCombos()


    ` handle forced explosions...
    maxComboForce = 0
    for i = 0 to CELL_COUNT - 1
        c = CELLS(i)
        if c.comboForce > 0
            if c.comboForce > maxComboForce then maxComboForce = c.comboForce
            CELLS(i).comboFillId = c.comboForce + groupId `by adding them together, there are no overlaps, right?
        endif
    next

    ` a stingray that pops makes a forced group of its own on the way through the groups, so there has to
    ` be room for one in every column. see RAYS in fish_headers.
    forceBase = groupId
    rayForceMax = FORCE_RAY_DOWN + CELL_COLUMN_COUNT
    if maxComboForce < rayForceMax then maxComboForce = rayForceMax

    ` and a school that swims off makes one too, so there has to be room for one in every row. see fish_headers_school.
    schoolForceMax = FORCE_SCHOOL + CELL_ROW_COUNT
    if maxComboForce < schoolForceMax then maxComboForce = schoolForceMax
    groupId += maxComboForce

    ` DEBUG: just color the groups for debug visuals
    for i = 1 to CELL_COUNT
        `color sprite CELLS(i-1).spriteId, DEBUG_COLORS(CELLS(i-1).comboFillId)
    next

    ` animate explosions of all groups
    cellId = 0


    ` a fish that has sung on coral is forgotten once it is gone. see THE FISH ON CORAL SING in fish_headers.
    coralForgetSung()

    ` how long the pops are held back for the ghosts of the skeletons so far, in milliseconds. every
    ` group that has a skeleton in it adds to this. see THE GHOST OF A SKELETON in fish_headers.
    ghostWait = 0

    ` the first few times that something big happens in a game, the pops hold back for it, so that it
    ` can be seen. a coral song is known to be coming now. see THE BIG MOMENTS in fish_headers_teach.
    teachLookStart()
    ghostWait = ghostWait + TEACH_CLAIM_MS

    ` a swap that left a line of fish of one kind, corner to corner, gets paid for it, before any group
    ` is scored, and the pops wait until the line has been seen. see DIAGONALS in fish_headers.
    judgeDiagonals()
    ghostWait = ghostWait + DIAGONAL_WAIT

    ` and they wait for the diver, when it has a picture to take. see THE PICTURES in fish_headers_diver.
    diverSnapAhead(groupId)
    ghostWait = ghostWait + DIVER_SNAP_HOLD

    ` a big group bursts the rainbow fish. the burst goes first: a surge goes out from the cursor, and every
    ` rainbow fish pops as it gets to it. every other pop of this look, the big group's too, waits until the
    ` surge has got to the last of them. then the fish that the cursor is on swells up into a new rainbow
    ` fish, as the big group pops. see THE BURST in fish_headers_rainbow.
    rainbowBurstAhead(groupId, forceBase)

    ` a big group that the cursor pushed a fish into leaves that fish out, in a bubble. see fish_headers_bubbled.
    bubbledAhead(groupId)

    if RAINBOW_BURST_LIVE
        RAINBOW_BURST_WAIT = ghostWait
        rainbowBurstLight(ghostWait)
        ghostWait = ghostWait + RAINBOW_BURST_LAST
        ghostWait = ghostWait + RAINBOW_BURST_AFTER
    endif
    ` the first few times, the new rainbow fish waits for its words. see THE BIG MOMENTS in fish_headers_teach.
    teachRainbowNew = 0
    if RAINBOW_CURSOR_KEEP >= 0 then teachRainbowNew = 1
    if RAINBOW_FISH_SPAWN >= 0 then teachRainbowNew = 1
    if teachRainbowNew
        teachClaim(TEACH_RAINBOW_NEW, ghostWait)
        ghostWait = ghostWait + TEACH_CLAIM_MS
        teachShowCursor(TEACH_RAINBOW_NEW)
    endif
    rainbowCursorPunch(ghostWait)

    ` three rainbow fish that touch pop, whatever kinds they are, once a band of the rainbow has swept across
    ` them. see RAINBOW FISH ARE WILD in fish_headers_rainbow.
    rainbowWildAhead(groupId, forceBase)
    if RAINBOW_WILD_LIVE
        teachClaim(TEACH_RAINBOW_WILD, ghostWait)
        ghostWait = ghostWait + TEACH_CLAIM_MS
        teachShowCursor(TEACH_RAINBOW_WILD)
    endif
    if RAINBOW_WILD_LIVE
        RAINBOW_WILD_WAIT = ghostWait
        rainbowWildLight(ghostWait)
    endif

    ` a bubble whose fish is going to pop bursts first, as a moment of its own, and scores, and the pops
    ` wait for it. see THE BURST IS A MOMENT OF ITS OWN in fish_headers_bubbled.
    ghostWait = bubbledMomentAhead(groupId, ghostWait)

    totalComboCount = 0
    QUEST_BUNCH_GROUPS = 0
    CORAL_HELD_GROUPS = 0
    explodePitch# = (rnd(4)*.02)
    explodeIndex = 0
    requiredComboCount = getRequiredComboCount()

    ` a swap that put 3 fish together, which only "think bigger" kept from popping, is let off. see THINK BIGGER in fish_headers.
    THINK_BIGGER_HELD_GROUPS = thinkBiggerHeld()

    ` the fish of every group get counted, so that a group that is too small to do anything is passed
    ` over without a walk over the board. see COMBO_GROUP_SIZE in fish_headers.
    groupsCounted = 0
    if groupId < COMBO_GROUP_ROOM then groupsCounted = 1
    COMBO_GROUPS_STALE = 1
    COMBO_GROUP_WALKS = 0

    ` the rainbow fish that stay through this look share in every pop of it. see THE RAINBOW SHARES in fish_headers_rainbow.
    rainbowShareAhead(groupId, groupsCounted)

    for g = 0 to groupId

        groupIdle = 0
        if groupsCounted
            ` a group that was handled may have taken fish from another group, or made a forced one
            if COMBO_GROUPS_STALE
                comboCountGroups(groupId)
            endif
            if COMBO_GROUP_SIZE(g) < requiredComboCount
                if COMBO_GROUP_FORCED(g) = 0 then groupIdle = 1
            endif
        endif
        if groupIdle then skip
        COMBO_GROUPS_STALE = 1
        COMBO_GROUP_WALKS = COMBO_GROUP_WALKS + 1

        ` need to check if this group is big enough
        comboCount = 0
        comboWhole = 0
        comboOnCoral = 0 `1 when any fish of the group is on coral. the group has to be bigger then. see CORAL in fish_headers.
        comboForced = 0
        comboSwapped = 0
        comboCarried = 0 `1 when the fish that the cursor carried in the last swap is part of the group
        comboBones = 0 `1 when a skeleton is part of the group, and the group is fish that matched
        comboFresh = 0 `1 when any fish of the group has not sung on coral already, so there is something for the group to do
        groupForce = 0 `which kind of forced pop the group is, or 0 for fish that matched. see FORCED POPS in fish_headers.
        for i = 1 to CELL_COUNT
            cell = CELLS(i-1)

            if cell.comboFillId <> g then skip
            if cell.comboForce > 0
                comboForced = 1
                groupForce = cell.comboForce
            endif

            ` how many fish there are, if any of them is on coral, and if the last swap put one of them here
            comboWhole = comboWhole + 1
            if CORAL_CELLS(i-1) then comboOnCoral = 1
            if cell.bellyUp = 2
                if cell.comboForce = 0 then comboBones = 1
            endif
            comboHeld = coralHolds(i - 1, cell.comboForce)
            if comboHeld = 0 then comboFresh = 1
            if CORAL_SUNG(i-1) <> cell.value then comboFresh = 1
            comboAt = i - 1
            if comboAt = CORAL_SWAP_A then comboSwapped = 1
            if comboAt = CORAL_SWAP_B
                comboSwapped = 1
                comboCarried = 1
            endif
        next

        ` a group with a fish on coral in it has to be bigger to pop. a forced pop goes whatever its size.
        comboNeed = requiredComboCount
        if comboOnCoral then comboNeed = requiredComboCount + CORAL_GROUP_EXTRA
        comboCount = comboWhole
        if comboForced then comboCount = comboWhole + 99

        ` a group that the last swap put together, of fish that matched, means the swap made a match.
        ` whether it pops does not matter. see A SWAP THAT MAKES A MATCH in fish_routines_glow.
        if comboForced = 0
            if comboSwapped
                if comboWhole >= requiredComboCount
                    GLOW_SWAP_VALID = 1
                    SCHOOL_SWAP_VALID = 1
                    if comboCarried then SCHOOL_CARRIED_MATCHED = 1
                endif
            endif
        endif

        ` a group that the last swap put together, which only the coral kept from popping. the multiplier
        ` does not hold that swap against the player. see CORAL in fish_headers.
        if comboCount < comboNeed
            if comboWhole >= requiredComboCount
                if comboSwapped then CORAL_HELD_GROUPS = CORAL_HELD_GROUPS + 1
            endif
        endif

        if comboCount < comboNeed then skip `if this group is not big enough, then we can skip rendering the explosion

        ` at night, nothing that matched pops. the group is held until day breaks. see NOTHING POPS AT NIGHT in fish_headers_tide.
        nightHeld = 0
        if comboForced = 0
            nightHeld = tideHoldsGroup(g, comboSwapped)
        endif
        if nightHeld then skip

        ` a quest may be holding the group back, to pop later. see SLEEPERS in fish_quests.
        questHeld = 0
        if comboForced = 0
            questHeld = questHoldsGroup(g)
        endif
        if questHeld then skip

        ` every fish of the group is on coral, and has sung already. nothing has joined them, so they sit.
        ` when it was the last swap that put them together, out of fish that had all sung, they are
        ` happy about it: a heart comes up from each of them, and the multiplier does not hold the swap
        ` against the player. it scores nothing.
        if comboFresh = 0
            if comboSwapped
                CORAL_HELD_GROUPS = CORAL_HELD_GROUPS + 1
                for i = 1 to CELL_COUNT
                    if CELLS(i-1).comboFillId = g
                        coralHeartFrom(i - 1, 0)
                    endif
                next
            endif
        endif
        if comboFresh = 0 then skip

        ` a group with a skeleton in it waits for the ghost of the skeleton to be seen, and so does
        ` every group after it. see THE GHOST OF A SKELETON in fish_headers.
        if comboBones then ghostWait = ghostWait + SKELETON_GHOST_MS

        ` a belly up fish that the cursor came to, which is forced pop 1. see THE BIG MOMENTS in fish_headers_teach.
        if groupForce = 1
            teachClaim(TEACH_BELLY_UP, ghostWait)
            ghostWait = ghostWait + TEACH_CLAIM_MS
            teachShowGroup(TEACH_BELLY_UP, g)
        endif

        ` the belly up fish of the waste bucket score more
        groupBonus = 1
        if groupForce = FORCE_BUCKET then groupBonus = WASTE_BUCKET_BONUS

        ` a quest can make a group worth nothing. see questGroupScore in fish_routines_quests.
        groupBonus = groupBonus * questGroupScore(g)

        ` a rainbow fish beside a group sends a pulse into one of its cells once its fish are gone, and the
        ` fish that ends up there is a rainbow fish. see AND THEY BREED in fish_headers_rainbow.
        if comboForced = 0
            groupGoneAt = explodeIndex + comboWhole
            groupGoneAt = groupGoneAt * 50
            groupGoneAt = groupGoneAt + ghostWait
            rainbowBreedGroup(g, groupGoneAt)
        endif

        ` fish that are going into a stack are not a combo, so nothing gets added to them
        groupStock = isAbility_Passive_StockMarket()
        if groupForce = FORCE_BUNCH then groupStock = 0

        ` handle stock market ability
        if groupStock
            ` find a fish that is not part of a group, and add it to this group. 
            randoChance = random stream(RNG_BOARD, 10) >= 7 `30% chance
            if randoChance
               
                startIndex = random stream(RNG_BOARD, CELL_COUNT)
                for i = 0 to CELL_COUNT - 1
                    cellIndex = (i + startIndex) mod CELL_COUNT
                    ` not a fish that a quest has marked, or one of a quest's own. see questKeepsFish in fish_routines_quests.
                    stockOk = 1
                    if CELLS(cellIndex).comboFillMask > 0 then stockOk = 0
                    if questKeepsFish(cellIndex) then stockOk = 0
                    if stockOk
                        CELLS(cellIndex).comboFillId = g
                        ` 2, and not 1, so that a quest can tell the fish that the card added from the
                        ` fish that matched. see questCollectGroups in fish_routines_quests.
                        CELLS(cellIndex).comboFillMask = 2
                        showPassiveUsed(ABILITY_INDEX_PASSIVE_STOCK_MARKET)
                        exit
                    endif
                next
            endif
        endif

        ` a stingray that pops, for whatever reason, shoots up, and every fish above it pops too. see RAYS in fish_headers.
        ` rayBottomRow is the lowest row of the group, which is where a column that was shot up starts to pop from.
        rayBottomRow = 0
        for i = 0 to CELL_COUNT - 1
            if CELLS(i).comboFillId <> g then skip
            if CELLS(i).coord.y > rayBottomRow then rayBottomRow = CELLS(i).coord.y
            if groupForce = FORCE_BUNCH then skip

            ` a stingray that sings on coral does not pop, so it does not shoot
            rayHeld = coralHolds(i, groupForce)
            if rayHeld then skip
            if CELLS(i).value = TEX_RAY
                shootRay(i, forceBase)
            endif
        next

        ` a group of fish that all face the same way is a school, and it swims off. see fish_headers_school.
        SCHOOL_JUDGED = -1
        if comboForced = 0
            schoolJudge(g, forceBase, comboSwapped)
        endif
        ` and the school swims off after a moment to see it. see THE BIG MOMENTS in fish_headers_teach.
        if SCHOOL_JUDGED = g
            codecSeeCard(CODEC_ENTRY_SCHOOL) `and it is in the codec from now on
            teachClaim(TEACH_SCHOOL, ghostWait)
            ghostWait = ghostWait + TEACH_CLAIM_MS
            teachShowGroup(TEACH_SCHOOL, g)
        endif

        totalComboCount += 1
        if groupForce = FORCE_BUNCH then QUEST_BUNCH_GROUPS = QUEST_BUNCH_GROUPS + 1
        scoreAdd = 0

        ` the tide wants to know if the last swap put one of its two fish in this group. see fish_headers_tide.
        if comboForced = 0
            tideSawGroup(g)
        endif

        ` animate the exit of the group
        randomG = (totalComboCount-1)

        ` the group sends out a shockwave from the middle of itself, when the first of its fish pops
        groupSumX = 0
        groupSumY = 0
        groupSize# = 0
        groupDelay = (explodeIndex + 1) * 50 + ghostWait
        groupFirstIndex = explodeIndex

        for i = 1 to CELL_COUNT
            cell = CELLS(i-1)
            if cell.comboFillId <> g then skip

            groupSumX = groupSumX + cell.coord.x
            groupSumY = groupSumY + cell.coord.y
            groupSize# = groupSize# + 1

            ` a fish that is on coral does not pop. it stays, and sings, and scores more than it would
            ` have by popping. the fish of its stack score too, and stay. see THE FISH ON CORAL SING in fish_headers.
            cellSings = coralHolds(i - 1, groupForce)
            if cellSings
                explodeIndex += 1
                delay = explodeIndex * 50 + ghostWait

                singPoints = 0
                singLeft = 1 + cell.stack
                while singLeft > 0
                    singLeft = singLeft - 1
                    scoreAdd += 10
                    singPoints = singPoints + scoreAdd * SCORE_MULTIPLIER * SCHOOL_STAKES * CORAL_SCORE_BONUS
                endwhile

                singPos as vec = {
                    x = getCellX(cell.coord.x),
                    y = getCellY(cell.coord.y)
                }
                singTxtId = spawnBoardScoreText(singPos, "+" + str$(singPoints), delay, 800)
                color text singTxtId, rgb(255, 170, 190)
                queueScore(singPoints, delay)

                coralSing(i - 1, delay)
            endif
            if cellSings then skip

            CELLS(i-1).comboBlownUp = 1
            cellId = i-1

            ` fish that are going into a stack do not pop. they fade away, and score nothing. see BUNCH UP in fish_headers.
            ` the tween of the smoke is set to one that is over, because the loop further down waits on it.
            if groupForce = FORCE_BUNCH
                create basic tween cell.comboDownShiftTweenId, 255, 0, 180, 0
                create basic tween cell.comboAnimTweenId, 0, 0, 1, 0
            endif
            if groupForce = FORCE_BUNCH then skip

            smokeIndex = rnd(SMOKE_ANIM_COUNT)
            smoke = SMOKE_ANIMS(smokeIndex)

            explodeIndex += 1
            delay = explodeIndex * 50 + ghostWait `rnd(3)*75+25 `TODO: somehow use the delay to "randomize" the animation

            ` a column that a stingray shot up pops from the bottom to the top. see RAYS in fish_headers.
            ` one that a belly up stingray shot down pops from the top to the bottom, which is the order it has already.
            if groupForce >= FORCE_RAY and groupForce < FORCE_BOTTLE
                rayStep = (rayBottomRow + 1) - cell.coord.y
                delay = (groupFirstIndex + rayStep) * 50 + ghostWait
            endif

            ` the fish of a bomb pop out from the middle of it, in waves. see THE BOMB in fish_headers.
            if groupForce = FORCE_BOMB
                bombWave = abs(cell.coord.x - CELLS(BOMB_AT).coord.x)
                bombWave = bombWave + abs(cell.coord.y - CELLS(BOMB_AT).coord.y)
                delay = (groupFirstIndex + 1) * 50
                delay = delay + bombWave * BOMB_WAVE_MS
                delay = delay + ghostWait
            endif

            ` a fish of a burst pops when the surge gets to it, whatever group it is in. see THE BURST in
            ` fish_headers_rainbow.
            if RAINBOW_BURST_LIVE
                if RAINBOW_BURST_CELLS(i - 1) > 0
                    delay = RAINBOW_BURST_WAIT + RAINBOW_BURST_DELAY(i - 1)
                endif
            endif
            ` and the rainbow fish that are wild pop once the band has swept across them, one after another.
            ` see RAINBOW FISH ARE WILD in fish_headers_rainbow.
            if RAINBOW_WILD_LIVE
                if groupForce = FORCE_RAINBOW
                    delay = explodeIndex - groupFirstIndex
                    delay = delay - 1
                    delay = delay * 50
                    delay = delay + RAINBOW_WILD_WAIT
                    delay = delay + RAINBOW_WILD_SWEEP_MS
                endif
            endif

            ` a jellyfish stings the fish next to it, once all of the groups have been found.
            ` a stacked one stings once for itself, and once more for every jellyfish behind it.
            if cell.value = TEX_JELLY then CELLS(i-1).stings = 1 + cell.stack
            STING_DELAY(i-1) = delay

            ` a stacked fish pops the fish in its stack first, one at a time, and each of them scores
            ` as one more fish in the group. a score text comes out of the fish for every one of them.
            ` the loop that waits for the pops to finish, further down, takes them off of the stack
            ` at the same moments, so that the stack can be seen shrinking.
            ` the fish in front goes last, so everything of its own waits until the stack is gone.
            ` a fish that pops on coral scores more, and so does every fish of its stack. see CORAL in fish_headers.
            coralScore = 1
            if CORAL_CELLS(i-1) then coralScore = CORAL_SCORE_BONUS

            stackLeft = cell.stack
            if stackLeft > BUNCH_STACK_MAX then stackLeft = BUNCH_STACK_MAX
            CELLS(i-1).stackPopMs = game ms() + delay

            ` a skeleton pops into a ghost, in the color of what it is standing for, a while before it
            ` pops with its group. see THE GHOST OF A SKELETON in fish_headers.
            cellGhost = 0
            if cell.bellyUp = 2
                if groupForce = 0
                    cellGhost = 1
                    spawnSkeletonGhost(i - 1, delay - SKELETON_GHOST_MS, delay)
                endif
            endif
            while stackLeft > 0
                stackLeft = stackLeft - 1

                stackTxtPos as vec = {
                    x = getCellX(cell.coord.x),
                    y = getCellY(cell.coord.y)
                }
                scoreAdd += 10
                scorePoints = scoreAdd * SCORE_MULTIPLIER * SCHOOL_STAKES * groupBonus * coralScore `see THE MULTIPLIER in fish_headers
                ` this one is gone by the time the next fish of the stack pops, so that each of them
                ` gets a text of its own to be read
                stackTxtId = spawnBoardScoreText(stackTxtPos, "+" + str$(scorePoints), delay, FISH_STACK_POP_GAP - 20)
                color text stackTxtId, FISH_COLORS(getFishColorIndex(cell.value))
                queueScore(scorePoints, delay) `the bar gets these when this fish of the stack pops

                delay = delay + FISH_STACK_POP_GAP
            endwhile

            ` a fish of a school does not pop: there is no puff and no bang. a fish just like it swims off
            ` into the background, from where it is. see A SCHOOL SWIMS OFF in fish_headers_school.
            cellSchools = 0
            if SCHOOL_JUDGED = g then cellSchools = 1
            if cellSchools
                create basic tween cell.comboAnimTweenId, 0, 0, 1, 0
                hide sprite cell.fxSpriteId
                schoolFishLeaves(i - 1, delay)
            else
                ` kaboom sprite
                create basic tween cell.comboAnimTweenId, smoke.startFrame, smoke.endFrame, 400, delay
                set tween easing cell.comboAnimTweenId, EASING_LINEAR
                show sprite cell.fxSpriteId
                rotate sprite cell.fxSpriteId, rnd(8) * .25
                color sprite cell.fxSpriteId, SMOKE_COLORS(rnd(SMOKE_COLOR_COUNT))
                sprite cell.fxSpriteId, getCellX(cell.coord.x), getCellY(cell.coord.y), smoke.texId

                ` sfx
                sfx cell.explodeSfxId, rnd(EXPLODE_SOUND_COUNT)
                delay play sfx cell.explodeSfxId, delay
                set sfx pitch cell.explodeSfxId, explodePitch#
                explodePitch# -= .02
            endif

            ` by day, the ink under it is washed off as it pops. see THE INK OF THE DAY in fish_headers_squid.
            inkWashed(i - 1, delay)

            ` a puff of bubbles, in the color of the fish
            spawnBubbles(getCellX(cell.coord.x), getCellY(cell.coord.y), CELL_SIZE / 4, 5, delay, FISH_COLORS(getFishColorIndex(cell.value)))

            ` animate fade out. the bones of a skeleton are gone as soon as its ghost is there. a fish of a
            ` school is gone quickly, since the one that swims off takes its place.
            if cellGhost
                create basic tween cell.comboDownShiftTweenId, 255, 0, 40, delay - SKELETON_GHOST_MS
            else
                if cellSchools
                    create basic tween cell.comboDownShiftTweenId, 255, 0, 60, delay
                else
                    create basic tween cell.comboDownShiftTweenId, 255, 0, 250, delay
                endif
            endif

            ` animate screen shake
            ` the knock comes when the pops do, and not while the ghosts are still showing
            create basic tween SHAKE_TWEEN_ID, 0, SHAKE_POP_AMOUNT#, 350, ghostWait
            set tween type SHAKE_TWEEN_ID, 1
            set screen shake bounce .5

            ` spawn score text
            txtPos as vec = {
                x = getCellX(cell.coord.x),
                y = getCellY(cell.coord.y)
            }
            scoreAdd += 10
            ` a rainbow fish is worth more. see THE RAINBOW FISH in fish_headers_rainbow.
            cellRainbow = rainbowFishScore(i - 1)
            cellWorth = scoreAdd + cellRainbow
            scorePoints = cellWorth * SCORE_MULTIPLIER * SCHOOL_STAKES * groupBonus * coralScore
            txtId = spawnBoardScoreText(txtPos, "+" + str$(scorePoints), delay, 800)
            color text txtId, FISH_COLORS(getFishColorIndex(cell.value))

            ` create basic tween SCORE_BAR.progressTweenId, getScoreRatio(0), getScoreRatio(scoreAdd), 100, 50
            ` the bar gets these when the fish pops, and not before. see THE SCORE THAT SHOWS in fish_headers.
            queueScore(scorePoints, delay)

            ` and every rainbow fish that stays on the board adds to it, with a number of its own. see THE RAINBOW SHARES in fish_headers_rainbow.
            if RAINBOW_SHARE_COUNT > 0
                cellShare = RAINBOW_SHARE_BONUS * SCORE_MULTIPLIER * SCHOOL_STAKES * groupBonus * coralScore
                rainbowSharePop(cellShare, delay, i - 1)
            endif

            ` a fish in a bubble bursts it, and it scores. see HOW IT ENDS in fish_headers_bubbled.
            bubbledPop(i - 1, delay)

        next

        if groupSize# > 0
            groupMidX# = groupSumX / groupSize#
            groupMidY# = groupSumY / groupSize#

            ` a bigger group sends a stronger one
            groupShock# = SHOCK_COMBO_STRENGTH# + (groupSize# - requiredComboCount) * SHOCK_COMBO_GROW#
            if groupShock# < SHOCK_COMBO_STRENGTH# then groupShock# = SHOCK_COMBO_STRENGTH#
            if groupShock# > 1 then groupShock# = 1
            spawnShockwave(groupMidX#, groupMidY#, groupShock#, groupDelay)

            ` and a ring goes out through the fish in the background. see A POP SENDS A WAVE in fish_headers_school.
            groupWaveX# = getCellX(0) + groupMidX# * CELL_SIZE
            groupWaveY# = getCellY(0) + groupMidY# * CELL_SIZE
            flockWave(groupWaveX#, groupWaveY#, groupSize#, groupDelay)

            ` a big group brings a hint with the next wave of the current. see THE HINTS in fish_headers.
            if groupSize# >= CORAL_HINT_GROUP_SIZE then CORAL_HINT_DUE = 1

            ` with the "bottles" card, a big group of fish that matched leaves a bottle behind, in the
            ` cell of the group that is closest to the middle of it. see BOTTLES in fish_headers.
            bottleOk = isAbility_Bottles()
            ` a fish that the group left out, in a bubble, still counts. see fish_headers_bubbled.
            bottleGroupSize# = groupSize#
            if g = BUBBLED_GROUP then bottleGroupSize# = groupSize# + 1
            if bottleGroupSize# < BOTTLE_GROUP_SIZE then bottleOk = 0
            if groupForce > 0 then bottleOk = 0
            if bottleOk
                ` a group that a swap finished leaves it in the cell of the swap, if that fish pops
                bottleBest = bottleSwapCell(g)
                bottleBestDist# = 9999
                if bottleBest >= 0
                    if CELLS(bottleBest).comboBlownUp then bottleBestDist# = -1
                    if CELLS(bottleBest).comboBlownUp = 0 then bottleBest = -1
                endif
                for i = 0 to CELL_COUNT - 1
                    if CELLS(i).comboFillId <> g then skip
                    if CELLS(i).comboBlownUp = 0 then skip `a fish that sang on coral is still there, so there is no room for a bottle
                    bottleDX# = CELLS(i).coord.x - groupMidX#
                    bottleDY# = CELLS(i).coord.y - groupMidY#
                    bottleDist# = bottleDX# * bottleDX# + bottleDY# * bottleDY#
                    if bottleDist# < bottleBestDist#
                        bottleBestDist# = bottleDist#
                        bottleBest = i
                    endif
                next
                if bottleBest >= 0
                    CELLS(bottleBest).bottleDue = 1
                    showPassiveUsed(ABILITY_INDEX_BOTTLES)
                endif
            endif
        endif

    next


    ` the diver takes a picture of every fish that is popping right next to it. see fish_headers_diver.
    diverJudge()

    ` reset comboForce
    for i = 0 to CELL_COUNT - 1
        CELLS(i).comboForce = 0
    next

    ` the glow steps for the swap that led to this look, if it made a match. see fish_headers_glow.
    glowJudgeSwap()

    ` and the school of the kind that the cursor carried pops, if it made a match. see THE CURSOR
    ` CALLS ON THE SCHOOLS in fish_headers_school.
    schoolJudgeSwap()

    ` the swap that led to this look at the board was a push, or a pull, and the water moves for it.
    ` this comes first, because the multiplier forgets the swap. see fish_headers_tide.
    judgeTide()

    ` a swap that led to this look at the board either popped something, or it did not. the fish that are
    ` popping now were scored with the multiplier as it was, and a new one counts from the next pop.
    judgeMultiplierSwaps(totalComboCount)

    ` and if that swap came at the end of one of the hidden patterns, this is where coral grows. the fish
    ` that are popping now were scored without it. see CORAL in fish_headers.
    judgeCoralCast(totalComboCount)

    ` the quest of the round hears what is popping, and whether the last swap popped anything. fish that
    ` "bunch up" put into a stack go away, but they do not pop. see BUNCH UP in fish_headers.
    questJudge(totalComboCount - QUEST_BUNCH_GROUPS)

    ` a moment that was claimed at the start of the look, and did not happen, is dropped. see THE BIG
    ` MOMENTS in fish_headers_teach.
    teachLookJudged()

    ` the tests stop here. what pops has been decided and scored, and none of it has been animated yet.
    _combos_judged:

    ` the pops of the little boards of the very first game bring the pieces of the game in, and the next
    ` board. see THE FIRST DIVE, in fish_routines_intro. only the pop that a move makes counts, and not
    ` the ones that follow from it.
    if TUTORIAL_BOARD
        if totalComboCount > 0
            if SEABED_COMBO = 0
                gosub tutorial_pop
            endif
        endif
    endif

    ` the sea floor lights up for every group that pops in a run, and dims when the board settles. see THE MOOD in fish_headers.
    SEABED_COMBO = SEABED_COMBO + totalComboCount

    ` exit early if no combos
    if totalComboCount = 0
        REQUEST_COMBO_CHECK = 0
        SEABED_COMBO = 0
        RAINBOW_NO_BREED = 0 `the board has settled, so groups bring rainbow fish again. see fish_headers_rainbow.
        KNOWN_FILL_VALUE = 0 `a "known fill" swap that popped nothing has nothing to fill
        TUTORIAL_SCORE_HOLD = 0 `the fish that brought the bar of the round in have all popped, so the next ones score

        ` the special fish on the board, and what has happened to the fish on it, are in the codec from now on
        codecSeeBoard()

        ` the board has settled, so this is when a move gets its chance to turn a fish belly up
        rollBellyUpFish()

        ` and the quest of the round gets its turn to change the board
        questSettled()

        ` and a diver that is done, or out of air, swims up to the top and goes
        diverSettled()
        gosub diver_rise
        return
    endif

    ` with the "contagious smile" card, a fish that is right next to a fish that popped has a chance
    ` to pick up one more fish for its stack. a fish only gets the one chance, however many popped around it.
    if isAbility_ContagiousSmile()
        for i = 0 to CELL_COUNT - 1
            c = CELLS(i)
            if c.comboBlownUp then skip

            nextToPop = 0
            if c.coord.x > 0
                if CELLS(i - 1).comboBlownUp then nextToPop = 1
            endif
            if c.coord.x < CELL_COLUMN_COUNT - 1
                if CELLS(i + 1).comboBlownUp then nextToPop = 1
            endif
            if c.coord.y > 0
                if CELLS(i - CELL_COLUMN_COUNT).comboBlownUp then nextToPop = 1
            endif
            if c.coord.y < CELL_ROW_COUNT - 1
                if CELLS(i + CELL_COLUMN_COUNT).comboBlownUp then nextToPop = 1
            endif

            if nextToPop
                tryStackFish(i, getContagiousSmileChance(), 150, ABILITY_INDEX_CONTAGIOUS_SMILE)
            endif
        next
    endif

    ` a jellyfish that popped stings the fish right next to it. see JELLIES in fish_headers.
    for i = 0 to CELL_COUNT - 1
        if CELLS(i).stings = 0 then skip
        stingsLeft = CELLS(i).stings
        CELLS(i).stings = 0
        ` the jellyfish of a stack pop one after the other, and each one stings as it goes
        stingWait = STING_DELAY(i)
        while stingsLeft > 0
            stingsLeft = stingsLeft - 1
            stingJelly(i, stingWait)
            stingWait = stingWait + FISH_STACK_POP_GAP
        endwhile
    next

    ` the tests stop here too. the fish around the ones that pop have had their chance to stack up or get stung.
    _combos_spread:

    ` the player can keep moving the cursor and swapping fish through all of what follows, as long as
    ` they leave the fish that the combo is busy with alone. see LIVE MOVES in fish_headers.
    ` each part waits for the swap that is playing to finish before it moves on to the next part,
    ` so that a fish is never halfway through a swap when it is told to fall.

    ` wait for all exit animations to finish
    COMBO_PHASE = 1
    repeat
        anyStillPlaying = 0
        if is tween done(SHAKE_TWEEN_ID) < 1
            anyStillPlaying = 1
            set screen shake amount tweenVal(SHAKE_TWEEN_ID)
            else
            set screen shake amount 0

        endif
        for i = 1 to CELL_COUNT
            cell = CELLS(i-1)
            if cell.comboBlownUp <> 1 then skip

            ` the fish in its stack go one at a time. each one gives the fish a little jump, and a few bubbles.
            if cell.stack > 0
                anyStillPlaying = 1
                if game ms() >= cell.stackPopMs
                    CELLS(i-1).stack = cell.stack - 1
                    CELLS(i-1).stackPopMs = cell.stackPopMs + FISH_STACK_POP_GAP
                    create basic tween cell.scaleWaveTweenId, 1.5, 1, 200, 0
                    spawnBubbles(getCellX(cell.coord.x), getCellY(cell.coord.y), CELL_SIZE / 4, 4, 0, FISH_COLORS(getFishColorIndex(cell.value)))
                endif
            endif

            if is tween done(cell.comboDownShiftTweenId) < 1 OR is tween done(cell.comboAnimTweenId) < 1
                anyStillPlaying = 1
            endif

            set sprite frame cell.fxSpriteId, tweenVal(cell.comboAnimTweenId)
            if tweenRatio(cell.comboAnimTweenId) > 0 AND is tween done(cell.comboAnimTweenId) < 1
                show sprite cell.fxSpriteId
            else
                hide sprite cell.fxSpriteId
            endif


            set sprite alpha cell.spriteId, tweenVal(cell.comboDownShiftTweenId)
            `position sprite cell.spriteId, sprite x(cell.spriteId), tweenVal(cell.comboDownShiftTweenId)
        next

        LIVE_MOVE_HOLD = 0
        if anyStillPlaying = 0 then LIVE_MOVE_HOLD = 1
        gosub frame_combo_input
        if LIVE_MOVE_ACTIVE then anyStillPlaying = 1

        gosub update_frame
        sync
    until anyStillPlaying = 0

    ` the fish that popped took their stacks with them
    for i = 0 to CELL_COUNT - 1
        if CELLS(i).comboBlownUp
            clearCellStack(i)
        endif
    next

    ` with the "bottles" card, a big group left a bottle behind. it takes the place of the fish that
    ` popped there, so that cell is not empty, and the bottle falls with the rest of the fish.
    for i = 0 to CELL_COUNT - 1
        if CELLS(i).bottleDue
            CELLS(i).bottleDue = 0
            CELLS(i).comboBlownUp = 0
            CELLS(i).value = TEX_BOTTLE
            RAINBOW_FISH(i) = 0 `a bottle is never a rainbow fish, even where one popped. see A BOTTLE IS NEVER ONE.
            updateCell(CELLS(i))
            set sprite alpha CELLS(i).spriteId, 255
            create basic tween CELLS(i).scaleWaveTweenId, 1.6, 1, 250, 0
            spawnBubbles(getCellX(CELLS(i).coord.x), getCellY(CELLS(i).coord.y), CELL_SIZE / 3, 8, 0, FISH_COLORS(getFishColorIndex(TEX_BOTTLE)))
        endif
    next

    ` a quest may leave something behind the same way, or bring a fish back
    questAfterPops()

    ` and nothing pops the diver
    diverAfterPops()

    ` for all cells that are not blown up, need to find out where they should live...
    startIndexOfLastRow = CELL_COUNT - CELL_COLUMN_COUNT
    for x = 1 to CELL_COLUMN_COUNT

        ` start at the bottom and work up.
        index = startIndexOfLastRow + (x-1)

        ` work up the column looking for empty spots
        emptyCount = 0
        for y = 1 to CELL_ROW_COUNT

            cell = CELLS(index)
            if cell.comboBlownUp
                ` keep track that this cell is "gone" in the column
                emptyCount += 1
            else
                ` save that the cell needs to move so many units DOWN 
                CELLS(index).comboDownShift = emptyCount
            endif

            ` move the index UP the grid by 1 row
            index -= CELL_COLUMN_COUNT 
        next
    next

    ` the cells that will be empty are known now, so the fish from the schools that will fill them set
    ` off already. see THEY ARE PICKED EARLY in fish_headers_school.
    schoolEarlyPicks()

    ` and now for all cells, need to tween them to the correct position 
    for i = 1 to CELL_COUNT
        cell = CELLS(i-1)

        ` hide the fxSprite if it was used
        hide sprite cell.fxSpriteId

        create basic tween cell.comboDownShiftTweenId, getCellY(cell.coord.y), getCellY(cell.coord.y + cell.comboDownShift), 500, 0
        set tween easing cell.comboDownShiftTweenId, EASING_BOUNCE
    next

    COMBO_PHASE = 2
    repeat
        for i = 1 to CELL_COUNT
            cell = CELLS(i-1)

            ` only the fish that are falling get moved. the rest are where they belong, unless the
            ` player is swapping them, and then the swap is what moves them.
            if cell.comboDownShift = 0 then skip
            position sprite cell.spriteId, sprite x(cell.spriteId), tweenVal(cell.comboDownShiftTweenId)
        next

        anyStillPlaying = 0
        if is tween done(CELLS(0).comboDownShiftTweenId) < 1 then anyStillPlaying = 1

        LIVE_MOVE_HOLD = 0
        if anyStillPlaying = 0 then LIVE_MOVE_HOLD = 1
        gosub frame_combo_input
        if LIVE_MOVE_ACTIVE then anyStillPlaying = 1

        gosub update_frame
        sync
    until anyStillPlaying = 0

    ` now all the cells have animated to the right spot; but we need to do 2 things...
    `  1. ACTUALLY move the shizam to the shoozum 
    `  2. all the blown up tiles need to be created and dropped in from the top 

    ` step 1; swap all the cells that dropped
    for x = 1 to CELL_COLUMN_COUNT

        ` start at the bottom and work up.
        index = startIndexOfLastRow + (x-1)
        for y = 1 to CELL_ROW_COUNT
            cell = CELLS(index)

            updateCell(cell)
            set sprite alpha cell.spriteId, 255

            droppedToIndex = index + (cell.comboDownShift*CELL_COLUMN_COUNT)

            tempValue = cell.value
            CELLS(index).value = CELLS(droppedToIndex).value
            CELLS(droppedToIndex).value = tempValue
            swapCellStacks(index, droppedToIndex)

            tempValue = cell.comboBlownUp
            CELLS(index).comboBlownUp = CELLS(droppedToIndex).comboBlownUp
            CELLS(droppedToIndex).comboBlownUp = tempValue

            ` this brings the correct value from the upper cell to the lower cell
            updateCell(CELLS(droppedToIndex))
            updateCell(CELLS(index))

            ` a fish that fell may have come down to the bottom row
            if cell.comboBlownUp = 0 and cell.comboDownShift > 0
                fishHitBottom(droppedToIndex, 0)
            endif

            index -= CELL_COLUMN_COUNT

        next
    next

    set sfx volume SFX_DROP, 1

    ` the cells that popped are empty until a new fish has been picked for them. a new fish is picked
    ` so that it does not pop when it lands, and a cell that is still empty must not look like a
    ` fish while that is being worked out. see NEW FISH in fish_headers.
    for i = 0 to CELL_COUNT - 1
        if CELLS(i).comboBlownUp > 0
            CELLS(i).value = 0

            ` and a new fish comes in facing the usual way. see WHAT SHOWS in fish_headers_glow.
            GLOW_TURN#(i) = 0
        endif
    next

    ` once the round has been won, no new fish is let through that would pop
    NEW_FISH_ROUND_WON = 0
    if CURRENT_SCORE >= SCORE_BAR.endVal then NEW_FISH_ROUND_WON = 1

    ` step 2; spawn in new cells and animate them falling in
    for i = 1 to CELL_COUNT
        cell = CELLS(i - 1)
        y = getCellY(cell.coord.y)
        targetY = y
        startAlpha = 255
        targetAlpha = 255
        cellFromSchool = -1
        if cell.comboBlownUp > 0
            ` a little board of the tutorial has its new fish picked out already. see THE LITTLE BOARDS in fish_routines_intro.
            if TUTORIAL_BOARD
                CELLS(i-1).value = tutorialNewFish(i - 1)
            else
                CELLS(i-1).value = getImpossibleRandomValueForCell(i - 1)
            endif

            ` after a "known fill" swap, the new fish are all the kind that was moved. see KNOWN FILL in fish_headers.
            if KNOWN_FILL_VALUE > 0 then CELLS(i-1).value = KNOWN_FILL_VALUE

            ` a quest may have its own idea of what drops in. see FORECAST in fish_quests.
            CELLS(i-1).value = questNewFish(i - 1, CELLS(i-1).value)

            ` after a swap that went down, it may be a fish from the schools. see THE FISH COME HOME in fish_headers_school.
            cellFromSchool = schoolDrawTake(i - 1)

            ` and it faces one way or the other. see FACING in fish_headers_school.
            schoolNewFish(i - 1)
            rainbowNewFish(i - 1) `an ordinary fish. see fish_headers_rainbow.
            bubbledNewFish(i - 1) `with no bubble. see fish_headers_bubbled.
            setFishTexture(cell.spriteId, CELLS(i-1).value)
            targetY = y - CELL_SIZE * 2
            startAlpha = 0
            `color sprite cell.spriteId, rgb(0,0,0)
        endif

        delay = cell.coord.x * 20 + (CELL_ROW_COUNT - cell.coord.y)*20

        ` a new fish that drops in may come down to the bottom row
        if cell.comboBlownUp > 0
            fishHitBottom(i - 1, delay + 250)
        endif

        create basic tween cell.comboDownShiftTweenId, targetY, y, 300, delay
        set tween easing cell.comboDownShiftTweenId, EASING_BOUNCE
        create basic tween cell.comboAlphaTweenId, startAlpha, targetAlpha, 150, delay

        ` a fish from the schools darts over to the column, and the new fish is not seen until it gets there
        if cellFromSchool >= 0
            schoolDrawLand(cellFromSchool, i - 1, y, targetY, delay)
        endif
    next

    ` that was the one fill that a "known fill" swap gets
    KNOWN_FILL_VALUE = 0

    ` a big group leaves a rainbow fish where the cursor was. see WHERE THEY COME FROM in fish_headers_rainbow.
    rainbowSpawnNow()
    rainbowSeedNow() `and the fish in a cell that a pulse clouded is one too. see AND THEY BREED.

    ` wait for all exit animations to finish
    COMBO_PHASE = 3
    repeat
        anyStillPlaying = 0
        for i = 1 to CELL_COUNT
            cell = CELLS(i-1)
            if cell.comboBlownUp <> 1 then skip

            if is tween done(cell.comboDownShiftTweenId) < 1
                anyStillPlaying = 1
            endif



            position sprite cell.spriteId, sprite x(cell.spriteId), tweenVal(cell.comboDownShiftTweenId)
            set sprite alpha cell.spriteId, tweenVal(cell.comboAlphaTweenId)
        next

        LIVE_MOVE_HOLD = 0
        if anyStillPlaying = 0 then LIVE_MOVE_HOLD = 1
        gosub frame_combo_input
        if LIVE_MOVE_ACTIVE then anyStillPlaying = 1

        gosub update_frame
        sync
    until anyStillPlaying = 0

    ` the combo is done with all of its fish
    COMBO_PHASE = 0
    LIVE_MOVE_HOLD = 0

    set sfx volume SFX_DROP, 0

return


` grow the board by one column or one row, for the "mind expansion" card.
` the board keeps the same square of the screen, so everything on it shrinks and slides over to
` make room, as if the camera was pulling back. then the new fish drop in, the same way that
` new fish drop in after a combo.
handle_board_expansion:

    if PENDING_BOARD_EXPANSIONS <= 0 then return

    ` let a swap that is playing out finish first. the board cannot change shape under it.
    if LIVE_MOVE_ACTIVE then return
    PENDING_BOARD_EXPANSIONS = PENDING_BOARD_EXPANSIONS - 1

    ` the board is as big as it gets
    if CELL_COLUMN_COUNT >= GRID_MAX_COUNT and CELL_ROW_COUNT >= GRID_MAX_COUNT then return

    ` the quest of the round holds still while the board grows. see questBoardGrowing.
    questBoardGrowing()

    ` remember how the board is laid out now, so that the fish can slide from there
    oldColumns = CELL_COLUMN_COUNT
    oldCellSize = CELL_SIZE
    oldArtSize = CELL_ART_SIZE
    oldGridX = GRID_POS.x
    oldGridY = GRID_POS.y
    for i = 0 to CELL_COUNT - 1
        EXPAND_VALUES(i) = CELLS(i).value
        EXPAND_STACKS(i) = CELLS(i).stack
        EXPAND_BELLY_UPS(i) = CELLS(i).bellyUp
    next

    ` a square board gets a new column on the right. that leaves it wider than it is tall, so the
    ` next time it gets a new row on the top, which makes it square again.
    expandColumns = CELL_COLUMN_COUNT
    expandRows = CELL_ROW_COUNT
    rowShift = 0
    addColumn = 0
    if CELL_COLUMN_COUNT <= CELL_ROW_COUNT
        addColumn = 1
        expandColumns = expandColumns + 1
    else
        expandRows = expandRows + 1
        rowShift = 1
    endif
    resizeGrid(expandColumns, expandRows)

    ` the coral stays with the cells that it was on
    coralBoardGrew(oldColumns, rowShift)
    ` and so do the ink and the squid. see fish_headers_squid.
    inkBoardGrew(oldColumns, rowShift)

    ` the fish that were already on the board keep their kind. a new row pushes them all down by one.
    ` comboBlownUp marks the cells that need a new fish, the same as it does after a combo.
    for i = 0 to CELL_COUNT - 1
        c = CELLS(i)
        oldY = c.coord.y - rowShift
        if c.coord.x < oldColumns and oldY >= 0
            c.value = EXPAND_VALUES(c.coord.x + oldY * oldColumns)
            c.stack = EXPAND_STACKS(c.coord.x + oldY * oldColumns)
            c.stackShown# = c.stack + 1
            c.bellyUp = EXPAND_BELLY_UPS(c.coord.x + oldY * oldColumns)
            c.bellyShown# = c.bellyUp * 3.14159
            c.comboBlownUp = 0
        else
            c.stack = 0
            c.stackShown# = 0
            c.bellyUp = 0
            c.bellyShown# = 0
            c.comboBlownUp = 1
        endif
        CELLS(i) = c
    next

    ` the cursor stays on the fish that it was on
    SELECTION_POS.y = SELECTION_POS.y + rowShift

    ` and the quest of the round comes along, with everything that it knows by the cell
    questBoardMoved(oldColumns, rowShift)

    ` the cells to the left and above already have their fish by the time a new cell gets its turn
    for i = 0 to CELL_COUNT - 1
        c = CELLS(i)
        cellY = getCellY(c.coord.y)

        if c.comboBlownUp
            CELLS(i).value = getImpossibleRandomValueForCell(i)

            ` a new column fills from the bottom up, and a new row fills from left to right
            stagger = c.coord.x
            if addColumn then stagger = CELL_ROW_COUNT - (c.coord.y + 1)
            delay = 250 + stagger * 30

            sprite c.spriteId, getCellX(c.coord.x), cellY - CELL_SIZE * 2, CELLS(i).value
            size sprite c.spriteId, CELL_ART_SIZE, CELL_ART_SIZE
            set sprite alpha c.spriteId, 0

            create basic tween c.comboDownShiftTweenId, cellY - CELL_SIZE * 2, cellY, 300, delay
            set tween easing c.comboDownShiftTweenId, EASING_BOUNCE
            create basic tween c.comboAlphaTweenId, 0, 255, 150, delay

            ` a few bubbles come off of the fish as it lands
            spawnBubbles(getCellX(c.coord.x), cellY, CELL_SIZE / 4, 3, delay + 200, FISH_COLORS(getFishColorIndex(CELLS(i).value)))
        else
            ` the cell holds a different fish than it did before, but that fish does not move until the loop below
            setFishTexture(c.spriteId, c.value)
            set sprite alpha c.spriteId, 255
            show sprite c.spriteId
        endif
    next

    ` the zoom goes from 0 (the old board) to 1 (the new board).
    ` a cell is at "origin + coordinate * cell size", so sliding the origin and the cell size slides every fish.
    ` the old origin is where the new top left cell would have been on the old board, even if that is off of the top of it.
    create basic tween BOARD_EXPAND_TWEEN_ID, 0, 1, 450, 0
    oldGridY = oldGridY - rowShift * oldCellSize

    dropSfxOn = 0
    repeat
        anyStillPlaying = 0
        if is tween done(BOARD_EXPAND_TWEEN_ID) < 1 then anyStillPlaying = 1

        ` this sizes the fish for the new board, so it goes before the fish get their in-between size
        gosub update_frame

        zoom# = tweenVal(BOARD_EXPAND_TWEEN_ID)
        zoomCellSize# = oldCellSize + (CELL_SIZE - oldCellSize) * zoom#
        zoomArtSize# = oldArtSize + (CELL_ART_SIZE - oldArtSize) * zoom#
        zoomGridX# = oldGridX + (GRID_POS.x - oldGridX) * zoom#
        zoomGridY# = oldGridY + (GRID_POS.y - oldGridY) * zoom#

        for i = 0 to CELL_COUNT - 1
            c = CELLS(i)
            if c.comboBlownUp
                if is tween done(c.comboDownShiftTweenId) < 1 then anyStillPlaying = 1

                ` the drop sound starts with the first fish that shows up
                if dropSfxOn = 0 and tweenVal(c.comboAlphaTweenId) > 0
                    dropSfxOn = 1
                    set sfx volume SFX_DROP, 1
                endif

                position sprite c.spriteId, sprite x(c.spriteId), tweenVal(c.comboDownShiftTweenId)
                set sprite alpha c.spriteId, tweenVal(c.comboAlphaTweenId)
            else
                position sprite c.spriteId, zoomGridX# + c.coord.x * zoomCellSize#, zoomGridY# + c.coord.y * zoomCellSize#
                size sprite c.spriteId, zoomArtSize#, zoomArtSize#
            endif
        next

        position sprite SELECTION_SPRITE, zoomGridX# + SELECTION_POS.x * zoomCellSize#, zoomGridY# + SELECTION_POS.y * zoomCellSize#
        scale sprite SELECTION_SPRITE, zoomCellSize#, zoomCellSize#

        sync
    until anyStillPlaying = 0

    set sfx volume SFX_DROP, 0

    ` put everything exactly where it belongs
    for i = 0 to CELL_COUNT - 1
        CELLS(i).comboBlownUp = 0
        updateCell(CELLS(i))
        set sprite alpha CELLS(i).spriteId, 255
    next
    scale sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE
    gosub update_selection_position

    questBoardGrew()

    ` the new fish may have landed next to two of their own kind
    REQUEST_COMBO_CHECK = 1

return



end `TODO: this shouldn't need to exist because the `return` statement... without this, I see a "symbol already declared" 
routines_exit:
