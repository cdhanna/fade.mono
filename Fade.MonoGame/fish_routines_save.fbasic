goto routines_save_exit

remstart
    THE SAVED GAME
    the game in progress is saved so that it can be carried on with later. there is only ever one of them.
    it is kept in the preferences, as a block of whole numbers that starts at SAVE_PREF, well away from the
    numbers that the options use.

    only the rules of the game are saved: which fish are on the board, the score, and the upgrades. nothing
    about how any of it is drawn is saved. loading puts the game back to how it starts, with reset_game,
    and then puts the saved numbers on top of that. everything on the screen follows from the numbers.

    the game is saved when it is paused, and whenever the board has settled after something changed. so
    closing the window in the middle of a game loses, at the very most, the move that was still playing out.

    SAVE_VERSION has to go up whenever what is saved changes, so that an old save is thrown away instead of
    being read as something that it is not.
remend


` write the game in progress into the preferences.
save_game:

    ` all of this is written to the file once, at the end, instead of once for every number
    begin pref batch

    set pref SAVE_PREF, SAVE_VERSION
    set pref SAVE_PREF + 1, 1 `there is a saved game
    set pref SAVE_PREF + 2, CELL_COLUMN_COUNT
    set pref SAVE_PREF + 3, CELL_ROW_COUNT
    set pref SAVE_PREF + 4, CURRENT_SCORE
    set pref SAVE_PREF + 5, CURRENT_ROUND
    set pref SAVE_PREF + 6, CURRENT_MOVE_COUNT
    set pref SAVE_PREF + 7, PENDING_FREE_MOVES
    set pref SAVE_PREF + 8, PENDING_BOARD_EXPANSIONS
    set pref SAVE_PREF + 9, SCORE_BAR.startVal
    set pref SAVE_PREF + 10, SCORE_BAR.endVal
    set pref SAVE_PREF + 11, SELECTION_POS.x
    set pref SAVE_PREF + 12, SELECTION_POS.y
    set pref SAVE_PREF + 13, BELLY_UP_ROLL_DUE
    set pref SAVE_PREF + 14, REQUEST_ABILITY_SELECTION
    set pref SAVE_PREF + 15, PASSIVE_COUNT
    set pref SAVE_PREF + 16, MOVE_ABILITY_COUNT
    set pref SAVE_PREF + 17, SCORE_MULTIPLIER
    set pref SAVE_PREF + 18, MULT_PROGRESS

    ` how many times every card has been taken
    for saveI = 0 to CARD_LENGTH - 1
        set pref SAVE_PREF_CARDS + saveI, CARDS(saveI).uses
    next

    ` the passives, in the order that they were taken, which is the order that they are listed in
    for saveI = 0 to PASSIVE_BINDINGS_LENGTH - 1
        if saveI < PASSIVE_COUNT
            set pref SAVE_PREF_PASSIVES + saveI, PASSIVE_BINDINGS(saveI).abilityIndex
        endif
    next

    set pref SAVE_PREF + 19, MOVE_SLOTS_OPEN

    ` the kind of game that it is
    set pref SAVE_PREF + 20, GAME_ROUND_CAP
    set pref SAVE_PREF + 21, GAME_ZEN

    ` the highest that the multiplier has been, for the table of high scores
    set pref SAVE_PREF + 22, BEST_MULTIPLIER

    ` and whether it was won already, and is being carried on with. see KEEP PLAYING in fish_headers.
    set pref SAVE_PREF + 23, GAME_ENDLESS

    ` and whether a debug environment variable has been set at any time while it was played, so that
    ` carrying it on without one does not hide that. see STEAM_FLAG_DEBUG in fish_headers.
    if isDebugEnvSet() then GAME_DEBUG_USED = 1
    set pref SAVE_PREF + 24, GAME_DEBUG_USED

    ` and the upgrades that have been picked, with the move that each was picked on
    set pref SAVE_PREF_LOG, GAME_LOG_COUNT
    if GAME_LOG_COUNT > 0
        for saveI = 0 to GAME_LOG_COUNT - 1
            set pref SAVE_PREF_LOG + 1 + saveI, GAME_LOG(saveI)
        next
    endif

    ` the move in every slot, and how long it has left to recharge. the move is saved as one more
    ` than its card, so that 0 can stand for a slot that is empty.
    for saveI = 0 to MOVE_SLOT_COUNT - 1
        saveMove = 0
        if MOVE_ABILITY_BINDINGS(saveI).assigned then saveMove = MOVE_ABILITY_BINDINGS(saveI).abilityIndex + 1
        set pref SAVE_PREF_MOVES + saveI * 2, saveMove
        set pref SAVE_PREF_MOVES + saveI * 2 + 1, MOVE_ABILITY_BINDINGS(saveI).movesLeft
    next

    ` the board. everything about a cell is packed into one number: the kind of fish, then
    ` how many are stacked behind it, then whether it is belly up, then whether the cell has coral on it:
    ` 1 for coral, and 2 for horror coral.
    for saveI = 0 to CELL_COUNT - 1
        set pref SAVE_PREF_CELLS + saveI, CELLS(saveI).value + CELLS(saveI).stack * 100 + CELLS(saveI).bellyUp * 100000 + CORAL_CELLS(saveI) * (1 + CORAL_SICK(saveI)) * 1000000
    next

    ` the hidden patterns. see CORAL in fish_headers.
    coralSave()

    end pref batch

    SAVE_SIGNATURE = saveSignature()
return


` put the saved game on top of a game that has just been reset. reset_game has to be called first.
load_game:

    ` the board is the size that it was
    resizeGrid(get pref(SAVE_PREF + 2, GRID_START_COUNT), get pref(SAVE_PREF + 3, GRID_START_COUNT))
    scale sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE

    for saveI = 0 to CARD_LENGTH - 1
        CARDS(saveI).uses = get pref(SAVE_PREF_CARDS + saveI)
    next

    ` the passives are taken again, one at a time, the same way that the upgrade screen gives them out.
    ` taking one counts a use, so the count starts again from nothing and is counted back up.
    loadCount = get pref(SAVE_PREF + 15)
    for saveI = 0 to PASSIVE_BINDINGS_LENGTH - 1
        if saveI < loadCount
            loadAbility = get pref(SAVE_PREF_PASSIVES + saveI)
            loadUses = CARDS(loadAbility).uses
            if loadUses < 1 then loadUses = 1
            CARDS(loadAbility).uses = 0
            for loadN = 1 to loadUses
                grantPassive(loadAbility)
            next
        endif
    next

    ` and so are the moves, each one back in the slot that it was in. a move that was recharging still is.
    MOVE_SLOTS_OPEN = get pref(SAVE_PREF + 19, MOVE_SLOT_START_COUNT)
    for saveI = 0 to MOVE_SLOT_COUNT - 1
        loadMove = get pref(SAVE_PREF_MOVES + saveI * 2)
        if loadMove > 0
            grantMoveToSlot(loadMove - 1, saveI)

            loadLeft = get pref(SAVE_PREF_MOVES + saveI * 2 + 1)
            MOVE_ABILITY_BINDINGS(saveI).movesLeft = loadLeft
            if loadLeft > 0
                set text MOVE_ABILITY_BINDINGS(saveI).timerTextId, str$(loadLeft)
            endif
        endif
    next

    ` the board. see save_game for how a cell is packed into one number.
    for saveI = 0 to CELL_COUNT - 1
        loadPacked = get pref(SAVE_PREF_CELLS + saveI, 1)
        CELLS(saveI).value = loadPacked mod 100
        CELLS(saveI).stack = (loadPacked / 100) mod 1000
        CELLS(saveI).bellyUp = (loadPacked / 100000) mod 10
        CELLS(saveI).bellyShown# = CELLS(saveI).bellyUp * 3.14159 `it is over already, and a skeleton is all the way around
        loadCoral = loadPacked / 1000000
        CORAL_CELLS(saveI) = 0
        CORAL_SICK(saveI) = 0
        if loadCoral > 0 then CORAL_CELLS(saveI) = 1
        if loadCoral > 1 then CORAL_SICK(saveI) = 1
        updateCell(CELLS(saveI))
        set sprite alpha CELLS(saveI).spriteId, 255
    next
    coralLoad()

    SELECTION_POS.x = get pref(SAVE_PREF + 11)
    SELECTION_POS.y = get pref(SAVE_PREF + 12)
    gosub update_selection_position

    ` the score, and the bar that it fills
    CURRENT_SCORE = get pref(SAVE_PREF + 4)
    syncScoreShown()
    CURRENT_ROUND = get pref(SAVE_PREF + 5)

    ` the kind of game that it is. a game that was saved before there were kinds is a long, normal one.
    GAME_ROUND_CAP = get pref(SAVE_PREF + 20, 100)
    GAME_ZEN = get pref(SAVE_PREF + 21, 0)
    GAME_ENDLESS = get pref(SAVE_PREF + 23, 0)
    GAME_DEBUG_USED = get pref(SAVE_PREF + 24, 0)
    CURRENT_MOVE_COUNT = get pref(SAVE_PREF + 6)
    PENDING_FREE_MOVES = get pref(SAVE_PREF + 7)
    PENDING_BOARD_EXPANSIONS = get pref(SAVE_PREF + 8)
    BELLY_UP_ROLL_DUE = get pref(SAVE_PREF + 13)
    REQUEST_ABILITY_SELECTION = get pref(SAVE_PREF + 14)

    SCORE_BAR.startVal = get pref(SAVE_PREF + 9)
    SCORE_BAR.endVal = get pref(SAVE_PREF + 10, 100)
    PROGRESS_BARS(0) = SCORE_BAR
    setProgressTween(SCORE_BAR, CURRENT_SCORE)

    ` a game that was saved with a round won, and no upgrade picked for it yet, still has its bar held full.
    ` the round was already counted when it was won. see SCORE_BAR_HOLD in fish_headers for what the numbers mean.
    if CURRENT_SCORE >= SCORE_BAR.endVal
        SCORE_BAR_HOLD = 1
        if REQUEST_ABILITY_SELECTION then SCORE_BAR_HOLD = 2
        create basic tween SCORE_BAR.progressTweenId, 1, 1, 1, 0
    endif

    ` the multiplier. a game that was saved before there was one has none, so it starts from x1.
    SCORE_MULTIPLIER = get pref(SAVE_PREF + 17, 1)
    if SCORE_MULTIPLIER < 1 then SCORE_MULTIPLIER = 1
    MULT_PROGRESS = get pref(SAVE_PREF + 18, 0)

    ` a game that was saved before the highest multiplier was kept only knows the one that it has now
    BEST_MULTIPLIER = get pref(SAVE_PREF + 22, SCORE_MULTIPLIER)
    if BEST_MULTIPLIER < SCORE_MULTIPLIER then BEST_MULTIPLIER = SCORE_MULTIPLIER

    ` the upgrades that had been picked. a game that was saved before they were written down has none.
    GAME_LOG_COUNT = get pref(SAVE_PREF_LOG, 0)
    if GAME_LOG_COUNT > HISCORE_LOG_MAX then GAME_LOG_COUNT = HISCORE_LOG_MAX
    if GAME_LOG_COUNT < 0 then GAME_LOG_COUNT = 0
    if GAME_LOG_COUNT > 0
        for saveI = 0 to GAME_LOG_COUNT - 1
            GAME_LOG(saveI) = get pref(SAVE_PREF_LOG + 1 + saveI, 0)
        next
    endif
    refreshMultiplier(1)

    registerMove(0) `this writes the number of moves onto the screen
    showRoundsLeft()

    ` what was just loaded is what is saved, so there is nothing new to save yet
    SAVE_SIGNATURE = saveSignature()
return


` the main loop comes here on every frame of the game. it saves the game when something has changed.
frame_autosave:
    if MENU_MODE then return

    ` not while fish are still popping and falling. the board is saved once it has settled.
    if REQUEST_COMBO_CHECK then return

    ` and not while a move is playing, or more are waiting behind it. writing the file takes a while, and
    ` a run of quick moves would write it over and over. it is saved once, when they are all done.
    if LIVE_MOVE_ACTIVE then return
    if QUEUED_MOVE_NUM > 0 then return

    saveNow = saveSignature()
    if saveNow <> SAVE_SIGNATURE
        gosub save_game
    endif
return


` a new game has been started, so the saved one is not there to go back to any more.
forget_saved_game:
    set pref SAVE_PREF + 1, 0
    SAVE_SIGNATURE = -1
return


` the main menu's "Resume". put the saved game back, and then the bubbles take the menu away.
menu_resume_game:
    gosub reset_game
    gosub load_game

    TRANSITION_TO_MENU = 0
    gosub menu_transition

    MENU_MODE = MENU_MODE_CLOSED
return


routines_save_exit:


` is there a saved game that this version of the game can read?
function hasSavedGame()
    found = 0
    if get pref(SAVE_PREF + 1) = 1
        if get pref(SAVE_PREF) = SAVE_VERSION
            found = 1
        endif
    endif
endfunction found


` a number that changes whenever something that gets saved changes. the game is only saved when this
` is different from what it was at the last save, so that it is not saved on every frame.
function saveSignature()
    signature = CURRENT_MOVE_COUNT * 7 + CURRENT_SCORE * 13 + CURRENT_ROUND * 101
    signature = signature + CELL_COUNT * 3 + PASSIVE_COUNT * 17 + MOVE_ABILITY_COUNT * 19
    signature = signature + PENDING_FREE_MOVES * 23 + PENDING_BOARD_EXPANSIONS * 29 + REQUEST_ABILITY_SELECTION * 31
    signature = signature + SCORE_MULTIPLIER * 41 + MULT_PROGRESS * 43 + GAME_LOG_COUNT * 61
    signature = signature + CORAL_COUNT * 67 + CORAL_CASTS * 71 + GAME_ENDLESS * 73
    for i = 0 to CARD_LENGTH - 1
        signature = signature + CARDS(i).uses * (37 + i)
    next

    ` which move is in which slot, and how long each has left to recharge. the "free move" changes
    ` the board without changing the count of moves, and this is what gives that away.
    signature = signature + MOVE_SLOTS_OPEN * 47
    for i = 0 to MOVE_SLOT_COUNT - 1
        if MOVE_ABILITY_BINDINGS(i).assigned
            signature = signature + (MOVE_ABILITY_BINDINGS(i).abilityIndex + 1) * (53 + i * 6) + MOVE_ABILITY_BINDINGS(i).movesLeft * (59 + i * 6)
        endif
    next
endfunction signature


` give the player a passive upgrade, and put it in the list at the side of the board.
` a passive that can be taken more than once keeps the one row, which says how many times it has been taken.
` the upgrade screen calls this when a passive is picked, and load_game calls it to put the passives back.
function grantPassive(abilityIndex)
    CARDS(abilityIndex).uses = CARDS(abilityIndex).uses + 1
    codecSeeCard(abilityIndex) `a zen game is given its passive without it ever being offered

    if CARDS(abilityIndex).obtained
        ` the row fades in again to show the change
        for passiveI = 0 to PASSIVE_COUNT - 1
            if PASSIVE_BINDINGS(passiveI).abilityIndex = abilityIndex
                set text PASSIVE_BINDINGS(passiveI).titleTextId, CARDS(abilityIndex).name$ + " x" + str$(CARDS(abilityIndex).uses)
                size text x PASSIVE_BINDINGS(passiveI).titleTextId, 100, .1, .3
                create basic tween PASSIVE_BINDINGS(passiveI).fadeTweenId, 0, 1, 400, 0
            endif
        next
    else
        binding = PASSIVE_BINDINGS(PASSIVE_COUNT)
        binding.assigned = 1
        binding.abilityIndex = abilityIndex

        set text binding.titleTextId, CARDS(abilityIndex).name$
        size text x binding.titleTextId, 100, .1, .3 `fit the name to the column, so that a long one does not run off of the screen
        PASSIVE_BINDINGS(PASSIVE_COUNT) = binding
        PASSIVE_COUNT = PASSIVE_COUNT + 1
        create basic tween binding.fadeTweenId, 0, 1, 400, 0
        CARDS(abilityIndex).obtained = 1

        ` the passive explains itself in info mode, instead of the empty space
        setInfoBlobEnabled(INFO_INDEX_PASSIVES, 0)
        infoIndex = allocateInfoBlob(WORLD_WIDTH - 124, ABILITY_ROWS_Y + 2 - (PASSIVE_COUNT - 1) * 18, 112, 18, CARDS(abilityIndex).name$, CARDS(abilityIndex).desc$)
    endif
endfunction


` give the player a move upgrade, ready to use, in the given slot, which has to be empty. the slot
` says which button uses the move, and which row it gets in the list at the side of the board.
` the screen where a move gets put in a slot calls this, and load_game calls it to put the moves back.
function grantMoveToSlot(abilityIndex, slot)
    codecSeeCard(abilityIndex)
    moveBinding = MOVE_ABILITY_BINDINGS(slot)
    moveBinding.assigned = 1
    moveBinding.abilityIndex = abilityIndex
    moveBinding.slotIndex = slot
    moveBinding.movesLeft = 0 `start ready
    moveBinding.resetTimer = CARDS(abilityIndex).moveClock
    moveBinding.moveValue = CARDS(abilityIndex).moveValue

    moveBinding.actionId = ACT_ABILITY(slot)
    moveBinding.icon$ = "move" + str$(slot + 1)

    set text moveBinding.titleTextId, CARDS(abilityIndex).name$
    size text x moveBinding.titleTextId, 100, .1, .3 `fit the name to the column, so that a long one does not run into the key
    set text moveBinding.keyTextId, "{" + moveBinding.icon$ + "}"

    ` the move explains itself in info mode. a slot only ever gets one info blob, and whichever move
    ` is in the slot uses it. layoutMoveInfos switches it off while the slot is empty.
    moveCool$ = "It recharges after " + str$(moveBinding.resetTimer) + " moves."
    if moveBinding.resetTimer <= 0 then moveCool$ = "It never has to recharge."
    moveInfo$ = CARDS(abilityIndex).desc$ + ". Hold {" + moveBinding.icon$ + "} and press {dir} to use it. " + moveCool$ + " Press {confirm} here to move it to another button."
    if moveBinding.hasInfo
        INFOS(moveBinding.infoIndex).title$ = CARDS(abilityIndex).name$
        INFOS(moveBinding.infoIndex).desc$ = moveInfo$
    else
        moveBinding.infoIndex = allocateInfoBlob(12, ABILITY_ROWS_Y + 2 - slot * 18, 140, 18, CARDS(abilityIndex).name$, moveInfo$)
        moveBinding.hasInfo = 1
    endif

    MOVE_ABILITY_BINDINGS(slot) = moveBinding
    MOVE_ABILITY_COUNT = MOVE_ABILITY_COUNT + 1
    create basic tween moveBinding.fadeTweenId, 0, 1, 400, 0
    CARDS(abilityIndex).obtained = 1

    layoutMoveInfos()
endfunction


` the moves are listed at the side of the board in the order of their slots, packed together, so
` which row a move is on depends on which of the slots before it are empty. frame_move_ability_render
` puts the rows there on every frame, and this puts the info blobs of the moves on the same rows.
` the blob of a slot that is empty is switched off.
function layoutMoveInfos()
    infoRow = 0
    for infoSlot = 0 to MOVE_SLOT_COUNT - 1
        if MOVE_ABILITY_BINDINGS(infoSlot).hasInfo
            rowBlob = INFOS(MOVE_ABILITY_BINDINGS(infoSlot).infoIndex)
            rowBlob.enabled = 0
            if MOVE_ABILITY_BINDINGS(infoSlot).assigned
                rowBlob.enabled = 1
                rowBlob.topLeft.y = ABILITY_ROWS_Y + 2 - infoRow * 18
            endif
            INFOS(MOVE_ABILITY_BINDINGS(infoSlot).infoIndex) = rowBlob
        endif
        if MOVE_ABILITY_BINDINGS(infoSlot).assigned then infoRow = infoRow + 1
    next

    ` the empty space where the moves go is never explained
    setInfoBlobEnabled(INFO_INDEX_MOVES, 0)
endfunction


` which slot is the info blob at `infoIndex` explaining the move of? -1 if it is not a move's blob.
function getInfoMoveSlot(infoIndex)
    foundSlot = -1
    for infoSlot = 0 to MOVE_SLOT_COUNT - 1
        if MOVE_ABILITY_BINDINGS(infoSlot).assigned
            if MOVE_ABILITY_BINDINGS(infoSlot).hasInfo
                if MOVE_ABILITY_BINDINGS(infoSlot).infoIndex = infoIndex then foundSlot = infoSlot
            endif
        endif
    next
endfunction foundSlot


` a move in a slot has `coolMoves` moves to wait before it can be used again
function setMoveCooldown(slot, coolMoves)
    MOVE_ABILITY_BINDINGS(slot).movesLeft = coolMoves
    if coolMoves > 0
        set text MOVE_ABILITY_BINDINGS(slot).timerTextId, str$(coolMoves)
    endif
endfunction


` take the move that is in the given slot out of it. unless it gets put in another slot, its card
` can be offered again by a later upgrade. the slot keeps its info blob for the next move that goes in it.
function ejectMove(slot)
    if MOVE_ABILITY_BINDINGS(slot).assigned
        CARDS(MOVE_ABILITY_BINDINGS(slot).abilityIndex).obtained = 0
        MOVE_ABILITY_BINDINGS(slot).assigned = 0
        MOVE_ABILITY_BINDINGS(slot).movesLeft = 0
        MOVE_ABILITY_COUNT = MOVE_ABILITY_COUNT - 1

        ` frame_move_ability_render does not touch the row of an empty slot, so put it away here
        set text alpha MOVE_ABILITY_BINDINGS(slot).titleTextId, 0
        set text alpha MOVE_ABILITY_BINDINGS(slot).keyTextId, 0
        set text alpha MOVE_ABILITY_BINDINGS(slot).timerTextId, 0

        layoutMoveInfos()
    endif
endfunction
