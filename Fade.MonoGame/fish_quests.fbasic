    if QUEST_ID = QUEST_TETHER
        questTether(qEv, qA, qB)
    endif
    if QUEST_ID = QUEST_LANTERN
        questLantern(qEv, qA, qB)
    endif
    if QUEST_ID = QUEST_HATCH
        questHatch(qEv, qA, qB)
