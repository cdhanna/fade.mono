
` CUSTOM ART. see fish_routines_customart.
` a picture in the CustomArt folder whose name ends in _b gets a black line drawn around it by
` FishEffect, one pixel wide, outside the picture. this says which ones did: 1 for those. it is
` by kind of fish, which is the same number as its texture, and the bones have a place of their own.
global CUSTOM_ART_SLOTS = 32
global CUSTOM_ART_BONES_SLOT = 30
global dim CUSTOM_ART_OUTLINE(CUSTOM_ART_SLOTS)
global CUSTOM_ART_COUNT = 0 `how many pictures came from the folder
