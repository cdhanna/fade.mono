remstart
    THE TESTS OF THE RAINBOW FISH. see fish_headers_rainbow.
    most of them pop five in a row across the top, with fish 6, which is a big group, and look at what a
    rainbow fish lower down does.
remend

test rainbow_burst_takes_a_pair_along from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_BURST_COUNT
    testCursor(4, 6)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(6, 3)) = 1
    testPut(7, 3, 7)
    testPut(8, 3, 7)

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_BURST_COUNT = tRainbowBefore + 1, "five in a row bursts the rainbow fish"
    assert testPops(6, 3) = 1, "the rainbow fish pops"
    assert testPops(7, 3) = 1, "and the pair beside it, which it makes three, goes with it"
    assert testPops(8, 3) = 1, "all of the pair"
    assert testPops(5, 3) = 0, "and nothing else beside it"
    assert RAINBOW_CURSOR_KEEP = testIndex(4, 6), "and the fish where the cursor is is due to turn into a new one"
    assert RAINBOW_FISH_SPAWN = -1, "so none is due once the board fills in"
    end
endtest

test rainbow_burst_pops_a_rainbow_fish_on_its_own from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(6, 4)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert testPops(6, 4) = 1, "a rainbow fish with nothing to take along still pops"
    end
endtest

test rainbow_no_burst_without_a_big_group from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_BURST_COUNT
    for tRainbowX = 0 to 3
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(6, 3)) = 1
    testPut(7, 3, 7)
    testPut(8, 3, 7)

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_BURST_COUNT = tRainbowBefore, "four in a row does not burst them"
    assert testPops(6, 3) = 0, "so the rainbow fish stays"
    assert testPops(7, 3) = 0, "and so does the pair"
    assert RAINBOW_BURST_LIVE = 0, "and no surge goes out"
    assert RAINBOW_FISH_SPAWN = -1, "and no new one is due"
    assert RAINBOW_CURSOR_KEEP = -1, "anywhere"
    end
endtest

test rainbow_big_group_with_the_cursor_in_it_brings_none from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_BURST_COUNT
    testCursor(2, 0)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(6, 4)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert testPops(2, 0) = 1, "the fish of the big group that the cursor is on pops with the rest"
    assert RAINBOW_CURSOR_KEEP = -1, "so it does not turn into a rainbow fish"
    assert RAINBOW_FISH_SPAWN = -1, "and none is due anywhere"
    assert RAINBOW_BURST_COUNT = tRainbowBefore + 1, "but the big group still bursts the rainbow fish"
    assert testPops(6, 4) = 1, "so the one on the board pops"

    runto _loop
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 0, "and there are none left"
    end
endtest

test rainbow_big_group_leaves_one_at_the_cursor_elsewhere from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testCursor(4, 6)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    runto _loop

    assert RAINBOW_FISH(testIndex(4, 6)) = 1, "the fish where the cursor is, away from the group, turns into a rainbow fish"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 1, "and it is the only one"
    end
endtest

test rainbow_surge_gets_to_the_near_one_first from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testCursor(2, 0)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    tRainbowNear = testIndex(2, 2)
    tRainbowFar = testIndex(8, 8)
    RAINBOW_FISH(tRainbowNear) = 1
    RAINBOW_FISH(tRainbowFar) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_BURST_LIVE = 1, "the big group sends out a surge"
    assert RAINBOW_BURST_DELAY(tRainbowNear) < RAINBOW_BURST_DELAY(tRainbowFar), "it gets to the near rainbow fish first"
    assert STING_DELAY(tRainbowNear) < STING_DELAY(tRainbowFar), "so the near one pops first"
    tRainbowGroupWait = STING_DELAY(testIndex(0, 0))
    assert tRainbowGroupWait > STING_DELAY(tRainbowFar), "and the big group pops after the last of them"
    end
endtest

test rainbow_pair_pops_after_the_one_that_took_it from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testCursor(4, 6)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(6, 3)) = 1
    testPut(7, 3, 7)
    testPut(8, 3, 7)

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    tRainbowAfter = RAINBOW_BURST_DELAY(testIndex(6, 3)) + RAINBOW_BURST_ALONG
    assert RAINBOW_BURST_DELAY(testIndex(7, 3)) = tRainbowAfter, "the pair pops just after the rainbow fish that took it along"
    assert RAINBOW_BURST_DELAY(testIndex(8, 3)) = tRainbowAfter, "both of it"
    end
endtest

test rainbow_fish_scores_more from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    RAINBOW_FISH(testIndex(0, 0)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    tRainbowWant = 60 + RAINBOW_FISH_BONUS
    assert CURRENT_SCORE = tRainbowWant, "three fish score 10 + 20 + 30, and the rainbow one 5 more"
    end
endtest

test rainbow_fish_goes_with_a_swap from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowA = testIndex(3, 3)
    tRainbowB = testIndex(4, 3)
    RAINBOW_FISH(tRainbowA) = 1
    swapCellStacks(tRainbowA, tRainbowB)
    assert RAINBOW_FISH(tRainbowA) = 0, "the cell that it left is not one"
    assert RAINBOW_FISH(tRainbowB) = 1, "and the cell that it went to is"
    end
endtest

test rainbow_fish_in_a_pop_is_used_up from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    RAINBOW_FISH(testIndex(1, 0)) = 1
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    runto _loop

    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 0, "the rainbow fish popped, and the fish that came in are ordinary"
    end
endtest

test rainbow_fish_beside_a_pop_brings_more from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_BREED_COUNT
    testCursor(5, 6)
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    RAINBOW_FISH(testIndex(1, 1)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_BREED_COUNT = tRainbowBefore + 1, "a rainbow fish beside a group that pops sends a flow"
    assert RAINBOW_SEED_CELL(testIndex(5, 6)) = 1, "to the cell that the cursor is on"
    assert RAINBOW_SEED_CELL(testIndex(1, 0)) = 0, "and not to the group"

    runto _loop
    runto _loop
    assert RAINBOW_FISH(testIndex(5, 6)) = 1, "once the board has filled back in, and the flow has got there, the fish at the cursor is a rainbow fish"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 2, "so there is one more, and only one"
    end
endtest

test rainbow_fish_in_a_group_brings_none from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    RAINBOW_FISH(testIndex(0, 0)) = 1
    RAINBOW_FISH(testIndex(1, 1)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    tRainbowSeeded = 0
    for tRainbowX = 0 to 2
        tRainbowSeeded = tRainbowSeeded + RAINBOW_SEED_CELL(testIndex(tRainbowX, 0))
    next
    tRainbowSeeded = tRainbowSeeded + RAINBOW_SEED_CELL(SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT)
    assert tRainbowSeeded = 0, "a group with a rainbow fish in it brings none, even beside another one"
    end
endtest

` the numbers that the saved game keeps bring back the same rainbow fish. the preferences are mocked in
` the tests, so this goes through the numbers that rainbowSave writes, and rainbowLoad reads.
test rainbow_fish_are_saved from fishBoard
    dim tRainbowSaved(14)
    rainbowFishReset()
    RAINBOW_FISH(testIndex(0, 0)) = 1
    RAINBOW_FISH(testIndex(5, 3)) = 1
    tRainbowLastCell = CELL_COUNT - 1
    RAINBOW_FISH(tRainbowLastCell) = 1
    for tRainbowP = 0 to 13
        tRainbowSaved(tRainbowP) = rainbowSaveNumber(tRainbowP)
    next

    rainbowFishReset()
    for tRainbowP = 0 to 13
        rainbowLoadNumber(tRainbowP, tRainbowSaved(tRainbowP))
    next

    assert RAINBOW_FISH(testIndex(0, 0)) = 1, "the first cell's rainbow fish comes back"
    assert RAINBOW_FISH(testIndex(5, 3)) = 1, "and one in the middle"
    assert RAINBOW_FISH(tRainbowLastCell) = 1, "and the last cell's"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 3, "and no others"
    end
endtest

test rainbow_burst_brings_none from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testCursor(4, 6)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(1, 1)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    tRainbowSeeded = 0
    tRainbowLastCell = CELL_COUNT - 1
    for tRainbowX = 0 to tRainbowLastCell
        tRainbowSeeded = tRainbowSeeded + RAINBOW_SEED_CELL(tRainbowX)
    next
    assert tRainbowSeeded = 0, "a big group beside a rainbow fish brings none, since the burst pops it"
    assert RAINBOW_NO_BREED = 1, "and no group brings any until the board settles"
    end
endtest

test rainbow_fish_in_a_school_pops_in_a_burst from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    flockReset()
    FLOCK_ON(0) = 1
    FLOCK_RAINBOW(0) = 1
    FLOCK_X#(0) = 100
    FLOCK_Y#(0) = 100
    testCursor(2, 0)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_BURST_LIVE = 1, "a rainbow fish out in a school sends the surge out"
    assert RAINBOW_FLOCK_POP_AT(0) > 0, "and it is due to pop when the surge gets to it"
    end
endtest

test rainbow_fish_are_wild from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_WILD_COUNT
    RAINBOW_FISH(testIndex(3, 4)) = 1
    RAINBOW_FISH(testIndex(4, 4)) = 1
    RAINBOW_FISH(testIndex(4, 5)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_WILD_COUNT = tRainbowBefore + 1, "three rainbow fish that touch match, whatever kinds they are"
    assert testPops(3, 4) = 1, "so all of them pop"
    assert testPops(4, 4) = 1, "the middle one"
    assert testPops(4, 5) = 1, "and the one below it"
    assert RAINBOW_WILD_SWEEP_MS > 0, "once a band of the rainbow has swept across them"
    tRainbowSwept = RAINBOW_WILD_WAIT + RAINBOW_WILD_SWEEP_MS
    tRainbowHeld = 0
    if STING_DELAY(testIndex(3, 4)) >= tRainbowSwept then tRainbowHeld = 1
    assert tRainbowHeld = 1, "so their pops wait for it"
    end
endtest

test rainbow_two_rainbow_fish_are_not_enough from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_WILD_COUNT
    RAINBOW_FISH(testIndex(3, 4)) = 1
    RAINBOW_FISH(testIndex(4, 4)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_WILD_COUNT = tRainbowBefore, "two rainbow fish do not match on their own"
    assert testPops(3, 4) = 0, "so they stay"
    end
endtest

` A BOTTLE IS NEVER ONE. see fish_headers_rainbow.

test rainbow_bottle_where_a_rainbow_fish_popped_is_not_one from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    grantPassive(ABILITY_INDEX_BOTTLES)
    testCursor(4, 6)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(2, 0)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert CELLS(testIndex(2, 0)).bottleDue = 1, "the rainbow fish in the middle of the big group is where the bottle goes"

    runto _loop
    assert CELLS(testIndex(2, 0)).value = TEX_BOTTLE, "the bottle is there"
    assert RAINBOW_FISH(testIndex(2, 0)) = 0, "and it is not a rainbow fish"
    assert RAINBOW_FISH(testIndex(4, 6)) = 1, "the fish where the cursor is still turns into one"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 1, "and it is the only one"
    end
endtest

test rainbow_cursor_on_a_bottle_turns_the_fish_beside_it from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testCursor(4, 3)
    testPut(4, 3, TEX_BOTTLE)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert RAINBOW_CURSOR_KEEP = -1, "the bottle at the cursor does not swell up into a rainbow fish"

    runto _loop
    assert RAINBOW_FISH(testIndex(4, 3)) = 0, "the bottle is not a rainbow fish"
    assert RAINBOW_FISH(testIndex(3, 3)) = 1, "the fish beside it is"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 1, "and it is the only one"
    end
endtest

test rainbow_flow_to_a_bottle_turns_the_fish_beside_it from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    tRainbowBefore = RAINBOW_BREED_COUNT
    testCursor(5, 3)
    testPut(5, 3, TEX_BOTTLE)
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    RAINBOW_FISH(testIndex(1, 1)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert RAINBOW_BREED_COUNT = tRainbowBefore + 1, "the rainbow fish beside the group sends a flow to the bottle"

    runto _loop
    runto _loop
    assert RAINBOW_FISH(testIndex(5, 3)) = 0, "the bottle is not a rainbow fish"
    assert RAINBOW_FISH(testIndex(4, 3)) = 1, "the fish beside it is"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 2, "so there is one more, and only one"
    end
endtest

` BOTTLES AND RAINBOW FISH. see WHERE THEY COME FROM in fish_headers_rainbow, and BOTTLES in fish_headers.

test rainbow_bottle_at_the_cursor_and_no_new_rainbow from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    grantPassive(ABILITY_INDEX_BOTTLES)
    tRainbowBefore = RAINBOW_BURST_COUNT
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(3, 0, 6)
    testPut(4, 0, 6)
    testPut(2, 1, 6)
    RAINBOW_FISH(testIndex(6, 4)) = 1
    testCursor(2, 1)
    testQueueMove(0, -1, 1, -1)

    runto _combos_judged
    assert testPops(2, 0) = 1, "the fish that the cursor carried up finished a group of five, and pops with it"
    assert CELLS(testIndex(2, 0)).bottleDue = 1, "it leaves its bottle where the cursor is"
    assert RAINBOW_CURSOR_KEEP = -1, "the cursor fish was part of the big group, so no new one is due at the cursor"
    assert RAINBOW_FISH_SPAWN = -1, "or anywhere"
    assert RAINBOW_BURST_COUNT = tRainbowBefore + 1, "the rainbow fish still burst, the same as without the card"
    assert testPops(6, 4) = 1, "so the one on the board pops"

    runto _loop
    assert CELLS(testIndex(2, 0)).value = TEX_BOTTLE, "the bottle is there"
    rainbowFishCount()
    assert RAINBOW_FISH_COUNT = 0, "and no rainbow fish"
    end
endtest

test rainbow_and_bottle_when_the_other_fish_finished_the_group from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    grantPassive(ABILITY_INDEX_BOTTLES)
    tRainbowBefore = RAINBOW_BURST_COUNT
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(3, 0, 6)
    testPut(4, 0, 6)
    testPut(2, 1, 6)
    testCursor(2, 0)
    testQueueMove(0, 1, 1, -1)

    runto _combos_judged
    assert totalComboCount = 1, "the fish that came up the other way finished a group of five"
    assert CELLS(testIndex(2, 0)).bottleDue = 1, "it leaves its bottle where that fish is"
    assert RAINBOW_BURST_COUNT = tRainbowBefore + 1, "and the rainbow goes as well"
    assert RAINBOW_CURSOR_KEEP = testIndex(2, 1), "with a new one where the cursor is"

    runto _loop
    assert CELLS(testIndex(2, 0)).value = TEX_BOTTLE, "so there is a bottle"
    assert RAINBOW_FISH(testIndex(2, 1)) = 1, "and a rainbow fish"
    end
endtest

` THE RAINBOW SHARES. see fish_headers_rainbow.

test rainbow_fish_on_the_board_share_in_every_pop from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    RAINBOW_FISH(testIndex(6, 4)) = 1
    RAINBOW_FISH(testIndex(8, 6)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert RAINBOW_SHARE_COUNT = 2, "both rainbow fish stay on the board"
    tRainbowWant = 60 + 3 * 2 * RAINBOW_SHARE_BONUS
    assert CURRENT_SCORE = tRainbowWant, "three fish score 10 + 20 + 30, and each rainbow fish adds to each of them"
    end
endtest

test rainbow_burst_uses_the_shares_up from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    testCursor(4, 6)
    for tRainbowX = 0 to 4
        testPut(tRainbowX, 0, 6)
    next
    RAINBOW_FISH(testIndex(6, 4)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert testPops(6, 4) = 1, "the big group bursts the rainbow fish"
    assert RAINBOW_SHARE_COUNT = 0, "so it shares in none of the pops"
    end
endtest

test rainbow_every_rainbow_fish_gets_a_pulse from fishBoard
    rainbowFishReset()
    RAINBOW_FISH_ON = 1
    ` fourteen big clouds from a while ago, past half of their lives, take up most of the room
    tRainbowNow = game ms()
    for tRainbowC = 0 to 13
        RAINBOW_CLOUD_X#(tRainbowC) = -500
        RAINBOW_CLOUD_Y#(tRainbowC) = -500
        RAINBOW_CLOUD_AT(tRainbowC) = tRainbowNow - 1000
        RAINBOW_CLOUD_SIZE#(tRainbowC) = 1
    next
    testPut(0, 2, 6)
    testPut(1, 2, 6)
    testPut(2, 2, 6)
    RAINBOW_FISH(testIndex(5, 4)) = 1
    RAINBOW_FISH(testIndex(7, 4)) = 1
    RAINBOW_FISH(testIndex(5, 6)) = 1
    RAINBOW_FISH(testIndex(7, 6)) = 1
    RAINBOW_FISH(testIndex(6, 0)) = 1
    RAINBOW_FISH(testIndex(8, 0)) = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert RAINBOW_SHARE_COUNT = 6, "all six rainbow fish stay through the look"
    assert RAINBOW_PULSE_DUE_COUNT = 18, "and each pulses for each of the three pops"
    tRainbowF = 0
    while RAINBOW_PULSE_DUE_COUNT > 0
        runto frame_dbg
        tRainbowF = tRainbowF + 1
        if tRainbowF > 200 then exit
    endwhile
    assert RAINBOW_PULSE_DUE_COUNT = 0, "the pulses have all gone out"

    ` every one of them has a pulse cloud of its own
    tRainbowCovered = 0
    for tRainbowCell = 0 to CELL_COUNT - 1
        if RAINBOW_FISH(tRainbowCell)
            tRainbowX# = getCellX(tRainbowCell mod CELL_COLUMN_COUNT)
            tRainbowY# = getCellY(tRainbowCell / CELL_COLUMN_COUNT)
            tRainbowHas = 0
            for tRainbowC = 0 to 15
                if RAINBOW_CLOUD_SIZE#(tRainbowC) < 0
                    if RAINBOW_CLOUD_X#(tRainbowC) = tRainbowX#
                        if RAINBOW_CLOUD_Y#(tRainbowC) = tRainbowY# then tRainbowHas = 1
                    endif
                endif
            next
            tRainbowCovered = tRainbowCovered + tRainbowHas
        endif
    next
    assert tRainbowCovered = 6, "every rainbow fish got a pulse cloud, though the room was nearly all taken"
    end
endtest
