goto routines_surface_exit

remstart
    THE SURFACE
    the main menu is the view from the surface of the water: the sun going down, and the dive boat, with
    a diver sat on the back of it. starting a game goes under, and going back to the main menu comes
    back up.

    the sky and the sea are one sprite that covers the whole menu, drawn by the surface effect. the boat
    is a sprite on top of that. both are drawn into the menu's render target, behind the menu.

    the wave of bubbles is the waterline. the bubble mask is filled in wherever the water is, so the
    surface shows where the mask is empty. when the game starts the wave goes up the screen, and the
    water comes up with it. see menu_transition, in fish_routines_menu.

    on the way back to the main menu, the water drains down the screen. bubbles do not go down, so
    there are none in that. the water is everything under a wavy line with foam on it, which the
    effects draw. see THE WATERLINE in fish_headers.

    the watery wobble over the whole screen is only for under the water. so the screen effect looks at
    the same mask, or the same line, while the water goes by, and it is off for as long as the main menu is up.

    the sky goes a long way up, to where it is black and full of stars. the splash screen is up there,
    and the camera comes down from it to the boat. see menu_run_splash, in fish_routines_credits.
remend

setup_surface:
    ` the globals are declared in the fish headers, so that functions can use them no matter where they are called from

    reserve effect id(SURFACE_FX_ID)
    effect SURFACE_FX_ID, "Fish/Shaders/SurfaceEffect"

    ` the surface comes in two sets of colors. it is the middle of the day, unless the clock of the
    ` computer says that it is the evening or the night, and then the sun is going down.
    SURFACE_DAY = 1
    surfaceHour = clock hour()
    if surfaceHour >= SURFACE_EVENING_HOUR or surfaceHour < SURFACE_MORNING_HOUR then SURFACE_DAY = 0

    ` the FISH_SKY environment variable picks one, whatever the time is
    surfaceSky$ = env$("FISH_SKY")
    if surfaceSky$ = "day" then SURFACE_DAY = 1
    if surfaceSky$ = "evening" then SURFACE_DAY = 0

    ` in the evening the boat is a dark shape against the sun, and in the day it is a white boat
    if SURFACE_DAY
        texture reserve texture id(TEX_DIVE_BOAT), "Fish/Textures/Menu/dive_boat_day"
    else
        texture reserve texture id(TEX_DIVE_BOAT), "Fish/Textures/Menu/dive_boat"
    endif

    ` what the main menu remembers of the hidden game. see THE MAIN MENU REMEMBERS in fish_headers.
    SURFACE_REEF = get pref(PREF_ENDING_REEF, 0)
    SURFACE_ANCIENT = get pref(PREF_ENDING_ANCIENT, 0)
    if is env set("FISH_MENU_REEF")
        SURFACE_REEF = 1
    endif
    if is env set("FISH_MENU_ANCIENT")
        SURFACE_ANCIENT = 1
    endif

    reserve sprite id(SURFACE_SPRITE)
    sprite SURFACE_SPRITE, 0, 0, TEX_PIXEL
    set sprite offset SURFACE_SPRITE, 0, 0
    size sprite SURFACE_SPRITE, WORLD_WIDTH, WORLD_HEIGHT
    order sprite SURFACE_SPRITE, ORDER_MENU_SURFACE
    set sprite effect SURFACE_SPRITE, SURFACE_FX_ID
    set sprite render target SURFACE_SPRITE, TARGET_MENU

    ` the picture of the boat is 168 by 80, and the bottom of it is the waterline
    reserve sprite id(SURFACE_BOAT_SPRITE)
    sprite SURFACE_BOAT_SPRITE, 0, 0, TEX_DIVE_BOAT
    order sprite SURFACE_BOAT_SPRITE, ORDER_MENU_SURFACE + 1
    set sprite render target SURFACE_BOAT_SPRITE, TARGET_MENU

    ` the two reefs, once the reef has been saved. see THE REEFS OF THE MAIN MENU in fish_headers.
    SURFACE_REEF_AT_X(0) = 98
    SURFACE_REEF_AT_DOWN(0) = 66
    SURFACE_REEF_AT_SCALE(0) = 30
    SURFACE_REEF_AT_FLIP(0) = 1
    SURFACE_REEF_SEED#(0) = 0
    SURFACE_REEF_AT_X(1) = 452
    SURFACE_REEF_AT_DOWN(1) = 104
    SURFACE_REEF_AT_SCALE(1) = 37
    SURFACE_REEF_AT_FLIP(1) = -1
    SURFACE_REEF_SEED#(1) = 2.6
    for surfaceReefI = 0 to 1
        reserve effect id(surfaceReefFx)
        if surfaceReefI = 0
            effect surfaceReefFx, "Fish/Shaders/ReefEffect"
        else
            effect surfaceReefFx, "Fish/Shaders/ReefEffectB"
        endif
        SURFACE_REEF_FX(surfaceReefI) = surfaceReefFx

        reserve sprite id(surfaceReefId)
        sprite surfaceReefId, 0, 0, TEX_PIXEL
        set sprite offset surfaceReefId, 0, 0
        size sprite surfaceReefId, WORLD_WIDTH, WORLD_HEIGHT
        order sprite surfaceReefId, ORDER_MENU_SURFACE + 2
        set sprite effect surfaceReefId, surfaceReefFx
        set sprite render target surfaceReefId, TARGET_MENU
        hide sprite surfaceReefId
        SURFACE_REEF_SPRITES(surfaceReefI) = surfaceReefId
    next

    ` the fish that swim over the reef, once the reef has been saved. see THE MAIN MENU REMEMBERS in
    ` fish_headers. they are the fish of the game: a kind of fish is the number of its picture.
    for surfaceFishI = 0 to SURFACE_FISH_COUNT - 1
        reserve sprite id(surfaceFishId)
        sprite surfaceFishId, 0, 0, surfaceFishI + 1
        size sprite surfaceFishId, SURFACE_FISH_SIZE, SURFACE_FISH_SIZE
        color sprite surfaceFishId, rgb(190, 215, 255)

        ` the crab and the worm are out of the water, so they are their own colors
        if surfaceFishI + 1 = TEX_CRAB or surfaceFishI + 1 = TEX_WORM
            color sprite surfaceFishId, rgb(255, 255, 255)
        endif
        order sprite surfaceFishId, ORDER_MENU_SURFACE + 3 `on top of the reefs
        set sprite render target surfaceFishId, TARGET_MENU
        hide sprite surfaceFishId
        SURFACE_FISH_SPRITES(surfaceFishI) = surfaceFishId

        ` they start out spread across the reef
        SURFACE_FISH_GO#(surfaceFishI) = (surfaceFishI * .37) - (surfaceFishI * 37) / 100
    next

    ` the camera that slides the main menu up the screen as the game goes under. a camera in the
    ` middle of its render target does not move anything.
    reserve camera id(MENU_CAMERA_ID)
    camera MENU_CAMERA_ID, WORLD_WIDTH / 2, WORLD_HEIGHT / 2
    set render target camera TARGET_MENU, MENU_CAMERA_ID
return


` move the surface. frame_menu_render comes here on every frame that a menu is drawn.
frame_surface:
    applyScreenWater()

    ` the main menu stays where it is, at the surface, while the camera goes under. so it slides up
    ` the screen by as much as the horizon does. the menu's render target has a camera of its own
    ` for that, which moves everything that is drawn there. any other menu is not moved at all.
    surfaceShift = 0
    if MENU_MODE = MENU_MODE_MAIN then surfaceShift = SURFACE_SINK# * SURFACE_SINK_DISTANCE
    position camera MENU_CAMERA_ID, WORLD_WIDTH / 2, WORLD_HEIGHT / 2 + surfaceShift

    if MENU_MODE <> MENU_MODE_MAIN then return

    ` the sky and the sea are moved by the surface effect, and not by the camera, so that sprite
    ` is put wherever the camera is looking. the boat is too, further down.
    position sprite SURFACE_SPRITE, 0, surfaceShift

    surfaceTime# = game ms() * .001

    ` menu_transition eases this, so that the camera gets going before the wave of bubbles does
    surfaceSink# = SURFACE_SINK#

    ` the camera bobs in the water, so everything far away goes up and down together. the horizon
    ` climbs up the screen as the camera goes under, and it drops off of the bottom when the camera looks up.
    surfaceBob# = sin(surfaceTime# * .9) * 2.5
    surfaceHorizon# = SURFACE_HORIZON + surfaceBob# + SURFACE_PAN# - surfaceSink# * SURFACE_SINK_DISTANCE

    ` the water right in front of the camera comes up the screen as the camera goes under, too
    surfaceSwell# = WORLD_HEIGHT + SURFACE_PAN# - (30 + surfaceBob# * 1.5 + surfaceSink# * SURFACE_SWELL_RISE)

    ` the boat is closer than the horizon, and it rocks on a swell of its own
    surfaceBoatY# = surfaceHorizon# + 30 + sin(surfaceTime# * 1.3 + 1) * 1.5
    position sprite SURFACE_BOAT_SPRITE, SURFACE_BOAT_X, surfaceBoatY# + surfaceShift - 37

    set effect param float SURFACE_FX_ID, "Time", surfaceTime#
    set effect param float SURFACE_FX_ID, "Day", SURFACE_DAY
    set effect param float2 SURFACE_FX_ID, "Size", WORLD_WIDTH, WORLD_HEIGHT
    set effect param float SURFACE_FX_ID, "Horizon", surfaceHorizon#
    set effect param float SURFACE_FX_ID, "Swell", surfaceSwell#

    ` the reef, and the thing on the horizon. see THE MAIN MENU REMEMBERS in fish_headers. the thing sets
    ` out again whenever the main menu has been away, and it comes on quickly at first and then slower
    ` and slower, so it is always coming and it never arrives.
    surfaceNow = game ms()
    if surfaceNow - SURFACE_MONSTER_SEEN_MS > 1500 then SURFACE_MONSTER_START_MS = surfaceNow
    SURFACE_MONSTER_SEEN_MS = surfaceNow
    surfaceComing# = (surfaceNow - SURFACE_MONSTER_START_MS) * .001
    surfaceComing# = surfaceComing# / (surfaceComing# + SURFACE_MONSTER_HALF#)
    ` the reef fades away as the camera goes under, and so do its fish
    surfaceReef# = 1 - surfaceSink# * SURFACE_REEF_FADE#
    if surfaceReef# < 0 then surfaceReef# = 0
    ` the options page can turn either of them off. see OPTION_MENU_REEF in fish_headers.
    surfaceReef# = surfaceReef# * SURFACE_REEF * OPTION_MENU_REEF
    surfaceAncient = SURFACE_ANCIENT * OPTION_MENU_MONSTER
    set effect param float2 SURFACE_FX_ID, "Endings", surfaceReef#, surfaceAncient

    ` the two reefs. each has a sprite and an effect of its own, and is put wherever the camera is
    ` looking, the same as the sky and the sea are. the sea is green in the day once the ancient one has come.
    for surfaceReefI = 0 to 1
        if surfaceReef# > 0
            show sprite SURFACE_REEF_SPRITES(surfaceReefI)
        else
            hide sprite SURFACE_REEF_SPRITES(surfaceReefI)
        endif
        position sprite SURFACE_REEF_SPRITES(surfaceReefI), 0, surfaceShift

        set effect param float SURFACE_REEF_FX(surfaceReefI), "Time", surfaceTime#
        set effect param float2 SURFACE_REEF_FX(surfaceReefI), "Size", WORLD_WIDTH, WORLD_HEIGHT
        set effect param float SURFACE_REEF_FX(surfaceReefI), "Horizon", surfaceHorizon#
        set effect param float SURFACE_REEF_FX(surfaceReefI), "Swell", surfaceSwell#
        set effect param float SURFACE_REEF_FX(surfaceReefI), "Day", SURFACE_DAY
        set effect param float4 SURFACE_REEF_FX(surfaceReefI), "Where", SURFACE_REEF_AT_X(surfaceReefI), SURFACE_REEF_AT_DOWN(surfaceReefI), SURFACE_REEF_AT_SCALE(surfaceReefI), SURFACE_REEF_AT_FLIP(surfaceReefI)
        set effect param float SURFACE_REEF_FX(surfaceReefI), "Seed", SURFACE_REEF_SEED#(surfaceReefI)
        set effect param float SURFACE_REEF_FX(surfaceReefI), "Fade", surfaceReef#
        set effect param float SURFACE_REEF_FX(surfaceReefI), "Sick", surfaceAncient * SURFACE_DAY
    next

    ` the fish swim across the reef from left to right, the way that they face, each at its own
    ` depth and its own speed, and bob a little. each one fades in on the way on and out on the way off.
    surfaceFishStep# = (surfaceNow - SURFACE_FISH_MS) * .001
    SURFACE_FISH_MS = surfaceNow
    if surfaceFishStep# > .05 then surfaceFishStep# = .05
    if surfaceFishStep# < 0 then surfaceFishStep# = 0
    for surfaceFishI = 0 to SURFACE_FISH_COUNT - 1
        ` each one goes a little further across on every frame, and comes back on at the left when it gets to the right
        surfaceFishGo# = SURFACE_FISH_GO#(surfaceFishI) + surfaceFishStep# / (SURFACE_FISH_LAP# - surfaceFishI * 1.5)
        if surfaceFishGo# >= 1 then surfaceFishGo# = surfaceFishGo# - 1
        SURFACE_FISH_GO#(surfaceFishI) = surfaceFishGo#
        ` the fish swim across a reef, and they take turns at which one: every other fish has the reef
        ` on the right. a - b + c comes out as a - (b + c), so the subtraction has brackets of its own.
        surfaceFishMid = SURFACE_REEF_X
        surfaceFishDown = SURFACE_REEF_DOWN
        if surfaceFishI mod 2 = 1
            surfaceFishMid = SURFACE_REEF2_X
            surfaceFishDown = SURFACE_REEF2_DOWN
        endif
        surfaceFishX# = (surfaceFishMid - 100) + surfaceFishGo# * 200
        surfaceFishY# = surfaceHorizon# + surfaceFishDown + 8 + surfaceFishI * 4 + sin(surfaceTime# * 1.4 + surfaceFishI * 2) * 2
        surfaceFishSeen# = 210 * sin(surfaceFishGo# * 3.14159)

        ` the crab and the worm do not swim, and they do not fade in and out. each one goes slowly back
        ` and forth on the rock of its reef that stands out of the water. see SURFACE_CRAB_X in fish_headers.
        if surfaceFishI + 1 = TEX_CRAB
            surfaceFishX# = SURFACE_CRAB_X + sin(surfaceTime# * .45) * SURFACE_WALK
            surfaceFishY# = surfaceHorizon# + SURFACE_CRAB_DOWN
            surfaceFishSeen# = 255
        endif
        if surfaceFishI + 1 = TEX_WORM
            surfaceFishX# = SURFACE_WORM_X + sin(surfaceTime# * .33 + 2) * SURFACE_WALK
            surfaceFishY# = surfaceHorizon# + SURFACE_WORM_DOWN
            surfaceFishSeen# = 255
        endif
        position sprite SURFACE_FISH_SPRITES(surfaceFishI), surfaceFishX#, surfaceFishY# + surfaceShift

        ` they are only there while there is a reef for them to be over
        if surfaceReef# > 0
            show sprite SURFACE_FISH_SPRITES(surfaceFishI)
        else
            hide sprite SURFACE_FISH_SPRITES(surfaceFishI)
        endif
        set sprite alpha SURFACE_FISH_SPRITES(surfaceFishI), surfaceFishSeen# * surfaceReef#
    next
    set effect param float SURFACE_FX_ID, "Coming", surfaceComing#

    ` the hull is not in the middle of the picture, because the diver's fins stick out of the back
    set effect param float3 SURFACE_FX_ID, "Boat", SURFACE_BOAT_X - 10, surfaceBoatY#, 60
return


routines_surface_exit:


` show or hide the surface. it is only behind the main menu, and never behind the pause menu.
function showSurface(isVisible)
    if isVisible
        show sprite SURFACE_SPRITE
        show sprite SURFACE_BOAT_SPRITE
    else
        hide sprite SURFACE_SPRITE
        hide sprite SURFACE_BOAT_SPRITE
    endif

    ` the reefs and their fish go when the surface does. frame_surface brings them back.
    if isVisible = 0
        hide sprite SURFACE_REEF_SPRITES(0)
        hide sprite SURFACE_REEF_SPRITES(1)
        for i = 0 to SURFACE_FISH_COUNT - 1
            hide sprite SURFACE_FISH_SPRITES(i)
        next
    endif
endfunction


` tell the screen effect where the water is, so that it only wobbles what is under it.
` the effect loses its parameters when it is reloaded, so this is called on every frame.
function applyScreenWater()
    set effect param texture 1, "MaskTexture", render target texture(TARGET_MASK)
    set effect param float 1, "UseMask", TRANSITION_SURFACE
    set effect param float 1, "Submerged", 1 - SURFACE_UP
    set effect param float4 1, "WaterLine", WATERLINE_Y#, WATERLINE_TILT#, game ms() * .001, WATERLINE_USE
    set effect param float2 1, "Grid", WORLD_WIDTH, WORLD_HEIGHT
endfunction
