
end `end the program if we encounter this

type cell
    coord as vec
    value
    spriteId
    fxSpriteId
    shiftTweenId `re-use this for bomb animation 
    scaleWaveTweenId
    comboDownShiftTweenId
    comboAlphaTweenId
    comboAnimTweenId
    comboFillMask
    comboFillId
    comboBlownUp
    comboDownShift
    comboForce
    explodeSfxId
    stack `how many more fish are stacked up behind this one
    stackShown# `how many fish are being drawn. it chases stack + 1, so that a new one slides out.
    stackPopMs `while the fish is popping, when the next fish of its stack goes
    bellyUp `1 when the fish is floating upside down. see BOTTOMS UP in fish_headers.
    bellyShown# `how far over it is being drawn, in radians. it chases the real thing, so that the fish rolls over.
    stings `1 when a jellyfish is popping here, and has not stung the fish next to it yet. see JELLIES in fish_headers.
    bottleDue `1 when the fish that is popping here leaves a bottle behind. see BOTTLES in fish_headers.
endtype

type smokeAnimInfo
    texId
    startFrame
    endFrame
endtype

type vec
    x, y
endtype

type vecF
    x#, y#
endtype

type move
    dir as vec
    swap
    moveBindingIndex
endtype

type floatingText
    active
    textId
    floatTweenIdX
    floatTweenIdY
    fadeInTweenId
    fadeTweenId
    scaleOutTweenId
    scale# `how many times as big as usual it is. the ones on a board that has grown are smaller.
endtype

type progressBar

    startVal
    endVal


    pos as vec
    size as vec
    backgroundSpriteId
    foregroundSpriteId
    progressTweenId
    scaleTweenId

    textNumId
    textTitleId
endtype


type ability
    obtained
    name$
    desc$
    stackable as boolean
    abilityType
    moveClock
    moveValue
    artTexId `the picture in the background of the card on the upgrade screen
    maxUses `how many times the card can be taken. 0 means that there is no limit.
    uses `how many times the card has been taken so far
endtype

type passiveDisplay
    assigned as boolean
    abilityIndex
    slotIndex

    fadeTweenId
    shakeTweenId `shakes the name when the passive does its thing
    titleTextId
    descTextId
endtype


type moveDisplay
    assigned as boolean
    abilityIndex
    slotIndex

    fadeTweenId

    titleTextId
    timerTextId
    descTextId
    keyTextId `a picture of the key that uses the move

    readyTweenId `gives the key a little punch when the move is ready again
    shakeTweenId `shakes the cooldown number when the move gets used before it is ready
    useShakeTweenId `shakes the whole row when the move gets used


    moveValue
    actionId `the input action that uses the move. it is one of ACT_ABILITY.
    icon$ `the name of the input icon for that action, like "move1"
    movesLeft
    resetTimer

    hasInfo `1 once the slot has an info blob. a move that takes over the slot takes over the blob too.
    infoIndex

endtype

` one row of the list of slots, on the screen where a new move gets put in a slot
type equipRow
    kind `EQUIP_ROW_SLOT, EQUIP_ROW_SPARE, or EQUIP_ROW_DONE
    slotIndex `the slot that it stands for, when it stands for one
    panelSpriteId
    keyTextId `a picture of the button of the slot
    nameTextId `the move that is in the slot
    noteTextId `how long that move takes to recharge
    border as infoBorder
endtype

type abilityChoice
    available as boolean
    abilityIndex

    transformId

    titleTextId
    typeTextId
    descTextId

    spriteId
    artSpriteId
    border as infoBorder
    sizeTweenId

endtype

` four thin sprites that draw a rectangle outline
type infoBorder
    topId
    bottomId
    leftId
    rightId
endtype

type infoBlob
    topLeft as vec
    size as vec

    title$
    desc$ 

    `is the infoBlob currently being used?
    assigned as boolean

    `a disabled blob keeps its slot, but cannot be highlighted
    enabled as boolean

    `the faint outline that shows this thing COULD be highlighted
    border as infoBorder
endtype

` one line of the menu
type menuItem
    name$
    desc$
    textId
    ready `0 for the things that are not built yet
endtype

` one bubble in the wave that wipes between the menu and the game
type bubble
    spriteId `the bubble that is seen
    maskSpriteId `the same bubble as a solid circle, which is drawn into the mask
    tideSpriteId `only the bubbles in the front of the wave have one. it fills in the mask underneath the bubble.
    x
    offsetY `how far behind the front of the wave it is. negative is ahead of the front.
    size
    phase `so that they do not all wobble together
endtype

` one of the little bubbles that floats up from something that just happened. see fish_routines_bubbles.
type floatBubble
    active
    spriteId
    x#, y#
    vx#, vy# `the push that it started with, in pixels per second. it dies away.
    rise `how fast it floats up, in pixels per second
    size
    phase `so that they do not all wobble together
    age `milliseconds since it showed up
    life `how many milliseconds it lasts before it pops
    delay `milliseconds left to wait before it shows up
    loud `1 if it makes a sound when it pops
    alpha `255 for a solid bubble, and less for a faint one
    star `1 if it is a sparkle and not a bubble. a sparkle twinkles where it is, and does not float up or pop.
endtype

` a ring that spreads across the board and tilts the fish as it passes. see SHOCKWAVES in fish_headers.
type shockwave
    active
    x#, y# `where it started, in cells. it can be in between two cells.
    startMs `when it starts. this can be in the future, to line it up with something that is delayed.
    strength# `how strong it is, where 1 is a full one
    life `how many milliseconds it lasts. it gets weaker the whole time.
    dirX#, dirY# `the way that it is headed. it is strongest that way, and there is none of it behind. a ring that goes every way has 0 for both.
    radius# `how far out the top of the bump is on this frame, in cells
    power# `how strong it is on this frame, now that it has swelled up or died away some
endtype

` one looping layer of the music, like the rumble or a chord. see fish_routines_music.
type musicLayer
    sfxId
    mix# `how loud it is when its level is all the way up
    level# `how far up it is right now, from 0 to 1
    target# `the level that it is fading to
    speed# `how much the level moves in a second
    driftMin#, driftMax# `it wanders between these levels on its own. it stays put if the highest is 0.
    driftMs `when it picks a new level next
    scene `MUSIC_SCENE_SURFACE or MUSIC_SCENE_DEEP if it is only heard in one of them, or MUSIC_SCENE_BOTH
endtype

` a sound that the music plays once, now and then, like a whale
type musicShot
    sfxId
    volume#
    wobble `how far its pitch can be off, in hundredths of an octave, so that it is different every time
    gapMin `the shortest wait before it plays on its own again, in milliseconds
    gapMax `the longest wait. it never plays on its own if this is 0.
    nextMs `when it plays on its own next
    scene `it only plays on its own in this scene, or in both of them if this is MUSIC_SCENE_BOTH
endtype

` one thing that rolls by in the credits. it is some text, or it is a picture.
type creditLine
    isSprite `1 for a picture, 0 for text
    id `the sprite id or the text id, depending
    x
    y `how far down the roll it is
endtype