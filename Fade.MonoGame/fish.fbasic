#CONSTANT SAMPLER_STATE_POINT 1

global SCREEN_WIDTH = 1920
global SCREEN_HEIGHT = 1080
if is os mac()
    SCREEN_WIDTH = display width() * .5
    SCREEN_HEIGHT = display height() * .5 - 75
endif

` a build from github starts fullscreen (FadeWindowMode in the csproj). then there is no window to size,
` and this would change the resolution of the monitor instead. SCREEN_WIDTH and SCREEN_HEIGHT are still the
` window's size the first time the player leaves fullscreen.
if is fullscreen() = 0
    set screen size SCREEN_WIDTH, SCREEN_HEIGHT
endif
` sprite 100, 0, 0, 0
` sprite 5, 0, 0, 0

` color sprite 100, hsl(0, 100.00%, 50.00%)

` the world space is a tiny pixelly space
global WORLD_WIDTH = 570
global WORLD_HEIGHT = 320

` where the bottom row of the ability lists sits, on both sides of the screen. the rows stack upwards from here.
` it leaves a strip along the bottom of the screen for the line of key hints.
global ABILITY_ROWS_Y = WORLD_HEIGHT - 46
set render size WORLD_WIDTH, WORLD_HEIGHT

` every pixel of the world is drawn with 2 by 2 pixels. the world stays 570 by 320, and a fish is still
` 16 across, but the new fish art is 32 pixels, and at 1 it lost every other row and column of them.
` the text is cleaner too, because the font is made big and shrunk to fit. the old 16 pixel art looks
` the same as it did. this has to come before any render target is made: they are made at this scale too.
` FISH_RENDER_SCALE draws it with more pixels still: the Steam page's art is drawn at 7 (render-capsules.ps1).
global RENDER_SCALE = 2
if val(env$("FISH_RENDER_SCALE")) > 0 then RENDER_SCALE = val(env$("FISH_RENDER_SCALE"))
set render scale RENDER_SCALE
` set stage sampler 1 SAMPLER_STATE_POINT
` set background color rgb(32, 40, 64)
set render target background color 1, rgb(32, 40, 64)
sync

set window title("Fish Fish Pop")

` escape opens the pause menu, instead of closing the window. quitting is on the menus.
disable escape quit
`focus window

` `TEST START
` SCORE_FONT = 1
` font SCORE_FONT, "Fish/Fonts/ZeroCool"


` sprite 1, 100, 100, 0
` set sprite offset 1, 0, 0
` size sprite 1, 100, 100
` color sprite 1, rgb(255, 0, 0)
` text 2, 100, 120, 1, "hello"

` ` order text 1, 20
` order sprite 1, 10

` do 
`     sync
` loop
` end
` `TEST END.

global SCORE_FONT


effect 1, "Fish/Shaders/ScreenEffect"
set screen effect 1
` the water moves as much as it always has, until setup_menu reads the option. see THE WATER MOTION.
set effect param float4 1, "Motion", 1, 1, WATER_HINT_DIM#, 0

` the water runs on a picture three times the size of the game's, and that is stretched to the window.
` without this it runs once for every pixel of the window, which on a big screen is a great many more.
` at 2 it starts to look soft on a big screen, and 1 is a blur. it is 4 and not 3 because of the render
` scale of 2 above: the picture is 1140 across, and 3 times the world would stretch it by one and a half,
` which doubles every other pixel.
set screen effect scale 4


effect FISH_FX_ID, "Fish/Shaders/FishEffect"


` the strings of the game, in the player's language, before anything that shows them is set up: the
` setups below fetch some of them with loc$. setup_menu loads them again, and that does no harm.
load strings "Fish/Lang"
OPTION_LANGUAGE = get pref(PREF_LANGUAGE, 0)
applyLanguage()

gosub setup_abilities
gosub load_textures
gosub load_custom_art
gosub load_audio
gosub setup_music
gosub setup_input
gosub load_fonts
gosub setup_infos
gosub setup_grid
gosub setup_selection
gosub setup_swap_tweens
gosub setup_score
gosub setup_multiplier
gosub setup_coral
gosub setup_passives
gosub setup_moves
gosub setup_ability_selection
gosub setup_move_equip
gosub setup_quests `the spot that info mode has for the quest of the round has to be made before INFO_BASE_LENGTH is taken
gosub setup_codec_spot `and the same goes for the spot that opens the codec. see NEW IN THE CODEC in fish_headers_teach.

` everything that can be explained in info mode from here on belongs to an upgrade, and goes away with a new game
INFO_BASE_LENGTH = INFO_LENGTH

gosub setup_intro
gosub setup_seabed `before the menu, because the menu draws frames as soon as it is set up, and every frame moves the sea floor
gosub setup_menu
gosub setup_mouse `the mouse, for the menus. see THE MOUSE in fish_headers_mouse.
gosub setup_upgrade_wipe `this uses the menu's effect, and the cards and rows of the upgrade screen
gosub setup_book `the page of the upgrade screen that lays out every card. see THE BOOK in fish_headers_fast
gosub setup_passive_drop `the page of the upgrade screen that drops a passive, which is drawn the same way
gosub setup_float_bubbles `these use the bubble effect, which the menu loads
gosub setup_zaps
gosub setup_tuna
gosub setup_morse
gosub setup_cameo `the words that these swim through for are set in setup_morse
gosub setup_beat `these use the bubble effect too
gosub setup_angler `on top of the dark of info mode, and after the hints that it puts its lights in
gosub setup_questtalk `the creatures that talk when a quest is taken. it borrows the voices of the angler.
gosub setup_demo `the game plays itself when the main menu is left alone. see THE DEMO in fish_headers_demo.
gosub setup_teach `the first few times something big happens, the game slows down for it. see THE BIG MOMENTS in fish_headers_teach.



p# = 0

isAbility_Wrap()
sync
        dbg_count = 0
        
` debug mode is for working on the game. set the FISH_DEBUG environment variable to start in it.
` a player can turn it on too, by tapping out TUNA. see DEBUG_MODE in fish_headers.
if is env set("FISH_DEBUG")
    debugModeOn()
endif
` the parts of a frame, for the frame timing log. see `perf lap`, and FADE_PERF_LOG in Game1.
perf name 1, "icons and water"
perf name 2, "input"
perf name 3, "board check and pops"
perf name 4, "endings"
perf name 5, "info"
perf name 6, "autosave"
perf name 7, "rest of the loop"
perf name 8, "between updates (pop loops)"
perf name 10, "texts"
perf name 11, "scale wave"
perf name 12, "fish fx: every fish"
perf name 13, "score"
perf name 14, "passive rows"
perf name 15, "move rows"
perf name 16, "free moves"
perf name 17, "cursor and multiplier"
perf name 18, "coral"
perf name 19, "skeleton ghosts"
perf name 20, "tuna"
perf name 21, "beat look"
perf name 22, "hints"
perf name 23, "bubbles"
perf name 24, "music"
perf name 25, "debug"
perf name 26, "hud fade"
perf name 30, "fish fx: shockwaves"
perf name 31, "fish fx: ripples"
perf name 32, "fish fx: diagonal hints"
do



    COLLECTED_INPUT_MASK = 0

    ` TODO: stupid FX system loses parameters between reloads, so best to s8et them in a loop. 
    set effect param float 1, "TimeSpeed", 1
    applyScreenWater()
    applyTunaScreen()

    ` show keys or controller buttons, depending on which one the player touched last
    gosub frame_input_icons
    gosub frame_mouse `see THE MOUSE in fish_headers_mouse

    ` the bar under a steam recording of the game shows the menus in one color, and the game in another
    timelineMode = 1
    if MENU_MODE then timelineMode = 3
    if DEMO_MODE then timelineMode = 3 `nobody is playing a demo. see THE DEMO in fish_headers_demo.
    if timelineMode <> STEAM_TIMELINE_MODE
        STEAM_TIMELINE_MODE = timelineMode
        set steam timeline mode timelineMode
    endif
    gosub frame_steam_timeline
    perf lap 1

    ` the main menu, left alone, starts a demo, and anything pressed in a demo stops it. see THE DEMO in fish_headers_demo.
    gosub frame_demo

    if MENU_MODE
        ` a menu is up, so the game waits underneath it.
        gosub frame_mouse_menu
        gosub frame_menu

    else
        gosub frame_info_toggle
        gosub frame_mouse_board

        if INFO_MODE
            ` handle info mode.
            gosub handle_info_input

        else
            ` handle the gameplay.

            gosub handle_ability_selection
            gosub handle_board_expansion
            gosub handle_angler `the "bright idea" card. see THE ANGLER in fish_headers_angler.
            gosub process_input
            perf lap 2
            gosub handle_combos
            gosub tutorial_advance `the next little board of the tutorial, once one has popped. see THE LITTLE BOARDS in fish_routines_intro.
            perf lap 3

            ` the pause key brings up the pause menu. so does the steam overlay, when the player brings
            ` it up over the game: the game gets no keys while it is up, and it would run on without them.
            wantPause = new action down(ACT_PAUSE)
            if steam overlay open() then wantPause = 1
            if wantPause
                tunaHide() `the code is drawn on top of everything, so it goes before the menu comes. see TUNA in fish_headers.
                gosub menu_open_pause
            endif

            ` when the last round has been won, the game is over
            ` the hidden game has two endings of its own, and each of them ends the game. see THE TWO ENDINGS in fish_headers.
            gosub handle_coral_ending

            gosub handle_game_end
            perf lap 4

        endif

        gosub frame_info_render
        perf lap 5
        gosub update_frame

        ` keep the saved game up to date, so that the game can be closed at any time and carried on with later
        gosub frame_autosave
        perf lap 6
    endif
    perf lap 7

    sync

    _loop:
loop

end
