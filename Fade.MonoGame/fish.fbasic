#CONSTANT SAMPLER_STATE_POINT 1

global SCREEN_WIDTH = 1920
global SCREEN_HEIGHT = 1080
if is os mac()
    SCREEN_WIDTH = display width() * .5
    SCREEN_HEIGHT = display height() * .5 - 75
endif

test sampleTest
    waitSeconds = 2
    gosub runforseconds

    ` the game opens on the main menu, and the test is about the game
    skipMainMenu()

    ` force a combo by setting the first 3 cells to the same value...
    CELLS(1).value = CELLS(0).value
    CELLS(2).value = CELLS(0).value
    updateCell(CELLS(1))
    updateCell(CELLS(2))

    waitSeconds = 1
    gosub runforseconds

    REQUEST_COMBO_CHECK = 1
    assert CURRENT_SCORE = 0 ` assert there is no score at the start.

    waitSeconds = 2
    gosub runforseconds

    ` assert that score was awarded for the combo
    assert CURRENT_SCORE > 0
    
    end `end the test
    runForSeconds:
        endFrame = frame number() + (60 * waitSeconds)
        while frame number() <= endFrame
            runto _loop
        endwhile
    return
endtest



set screen size SCREEN_WIDTH, SCREEN_HEIGHT
`set fullscreen 1
` sprite 100, 0, 0, 0
` sprite 5, 0, 0, 0

` color sprite 100, hsl(0, 100.00%, 50.00%)

` the world space is a tiny pixelly space
global WORLD_WIDTH = 570
global WORLD_HEIGHT = 320

` where the bottom row of the ability lists sits, on both sides of the screen. the rows stack upwards from here.
` it leaves a strip along the bottom of the screen for the line of key hints.
global ABILITY_ROWS_Y = WORLD_HEIGHT - 46
set render size WORLD_WIDTH, WORLD_HEIGHT
` set stage sampler 1 SAMPLER_STATE_POINT
` set background color rgb(32, 40, 64)
set render target background color 1, rgb(32, 40, 64)
sync

set window title("Fish Fish Pop")

` escape opens the pause menu, instead of closing the window. quitting is on the menus.
disable escape quit
`focus window

` `TEST START
` SCORE_FONT = 1
` font SCORE_FONT, "Fish/Fonts/ZeroCool"


` sprite 1, 100, 100, 0
` set sprite offset 1, 0, 0
` size sprite 1, 100, 100
` color sprite 1, rgb(255, 0, 0)
` text 2, 100, 120, 1, "hello"

` ` order text 1, 20
` order sprite 1, 10

` do 
`     sync
` loop
` end
` `TEST END.

global SCORE_FONT


effect 1, "Fish/Shaders/ScreenEffect"
set screen effect 1


effect FISH_FX_ID, "Fish/Shaders/FishEffect"


gosub setup_abilities
gosub load_textures
gosub load_audio
gosub setup_music
gosub setup_input
gosub load_fonts
gosub setup_infos
gosub setup_grid
gosub setup_selection
gosub setup_swap_tweens
gosub setup_score
gosub setup_multiplier
gosub setup_passives
gosub setup_moves
gosub setup_ability_selection
gosub setup_move_equip

` everything that can be explained in info mode from here on belongs to an upgrade, and goes away with a new game
INFO_BASE_LENGTH = INFO_LENGTH

gosub setup_seabed `before the menu, because the menu draws frames as soon as it is set up, and every frame moves the sea floor
gosub setup_menu
gosub setup_upgrade_wipe `this uses the menu's effect, and the cards and rows of the upgrade screen
gosub setup_float_bubbles `these use the bubble effect, which the menu loads



p# = 0

isAbility_Wrap()
sync
        dbg_count = 0
        
` the debug inspector is only for working on the game. set the FISH_DEBUG environment variable to get it.
if is env set("FISH_DEBUG")
    enable debug inspector
endif
do



    COLLECTED_INPUT_MASK = 0

    ` TODO: stupid FX system loses parameters between reloads, so best to s8et them in a loop. 
    set effect param float 1, "TimeSpeed", 1
    applyScreenWater()

    ` show keys or controller buttons, depending on which one the player touched last
    gosub frame_input_icons

    if MENU_MODE
        ` a menu is up, so the game waits underneath it.
        gosub frame_menu

    else
        gosub frame_info_toggle

        if INFO_MODE
            ` handle info mode.
            gosub handle_info_input

        else
            ` handle the gameplay.

            gosub handle_ability_selection
            gosub handle_board_expansion
            gosub process_input
            gosub handle_combos

            ` the pause key brings up the pause menu
            if new action down(ACT_PAUSE)
                gosub menu_open_pause
            endif

            ` when the last round has been won, the game is over
            gosub handle_game_end

        endif

        gosub frame_info_render
        gosub update_frame

        ` keep the saved game up to date, so that the game can be closed at any time and carried on with later
        gosub frame_autosave
    endif

    sync

    _loop:
loop

end
