

goto routines_abilities_exit

setup_abilities:

    ` instants
    CARDS(ABILITY_INDEX_MOVE_BUNDLE) = {
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
    }
    CARDS(ABILITY_INDEX_MIND_EXPANSION) = {
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = BOARD_EXPANSION_MAX
    }
    CARDS(ABILITY_INDEX_MOVE_SLOT) = {
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = MOVE_SLOT_COUNT - MOVE_SLOT_START_COUNT
    }

    ` see DEEP POCKETS in fish_headers. taking it is all that it takes: getUpgradeChoiceCount looks at how
    ` many times it has been taken, so handle_ability_instant_effect has nothing to do for it.
    CARDS(ABILITY_INDEX_DEEP_POCKETS) = {
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = UPGRADE_CHOICES_MAX - UPGRADE_CHOICES_START
    }

