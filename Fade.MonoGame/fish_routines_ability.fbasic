

goto routines_abilities_exit

setup_abilities:

    ` instants
    CARDS(ABILITY_INDEX_MOVE_BUNDLE) = {
        name$ = "negative moves",
        desc$ = "Give back " + str$(FREE_MOVES_AMOUNT) + " moves to your score"
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
    }
    CARDS(ABILITY_INDEX_MIND_EXPANSION) = {
        name$ = "mind expansion",
        desc$ = "Add a new row or column of fish to the board."
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = BOARD_EXPANSION_MAX
    }
    CARDS(ABILITY_INDEX_MOVE_SLOT) = {
        name$ = "tackle box"
        desc$ = "Opens another slot, so that one more special move can be carried."
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = MOVE_SLOT_COUNT - MOVE_SLOT_START_COUNT
    }

    ` see DEEP POCKETS in fish_headers. taking it is all that it takes: getUpgradeChoiceCount looks at how
    ` many times it has been taken, so handle_ability_instant_effect has nothing to do for it.
    CARDS(ABILITY_INDEX_DEEP_POCKETS) = {
        name$ = "deep pockets"
        desc$ = "Every upgrade from now on has " + str$(UPGRADE_CHOICES_MAX) + " cards to pick from."
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = UPGRADE_CHOICES_MAX - UPGRADE_CHOICES_START
    }

    ` passives
    CARDS(ABILITY_INDEX_WRAP) = {
        name$ = "seamless"
        desc$ = "move fish around the edges of the grid"
        obtained = 0,
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_CRABS) = {
        name$ = "crabs"
        desc$ = "higher % chance that crabs spawn"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BIRD_FEAST) = {
        name$ = "bird feast"
        desc$ = "lower % chance that worms spawn"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_PASSIVE_STOCK_MARKET) = {
        name$ = "stock market"
        desc$ = "30% chance to add random fish to every combo"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_THINK_BIGGER) = {
        name$ = "think bigger"
        desc$ = "combos need 4 fish instead of 3"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER) = {
        name$ = "bottom feeder"
        desc$ = str$(BOTTOM_FEEDER_CHANCE) + "% chance that a fish stacks up when it lands on the bottom row"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2) = {
        name$ = "bottom feeder 2"
        desc$ = "raises the chance that a fish stacks up on the bottom row to " + str$(BOTTOM_FEEDER_CHANCE_2) + "%"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_CONTAGIOUS_SMILE) = {
        name$ = "contagious smile"
        desc$ = "adds a " + str$(CONTAGIOUS_SMILE_CHANCE) + "% chance that a fish stacks up when a combo pops next to it."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 1
        maxUses = CONTAGIOUS_SMILE_MAX
    }
    CARDS(ABILITY_INDEX_BOTTOMS_UP) = {
        name$ = "bottoms up"
        desc$ = "adds a " + str$(BOTTOMS_UP_CHANCE) + "% chance that a move turns a fish belly up. touch it with the cursor to pop it."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 1
        maxUses = BOTTOMS_UP_MAX
    }

    ` see JELLIES, RAYS and BOTTLES in fish_headers
    CARDS(ABILITY_INDEX_JELLIES) = {
        name$ = "jellies"
        desc$ = str$(JELLY_SPAWN_CHANCE) + "% jellyfish, then " + str$(JELLY_SPAWN_CHANCE + JELLY_SPAWN_STEP) + ", then " + str$(JELLY_SPAWN_CHANCE + JELLY_SPAWN_STEP * 2) + ". rays thin them. a pop may flip fish next to it."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 1
        maxUses = JELLY_MAX
    }
    CARDS(ABILITY_INDEX_RAYS) = {
        name$ = "rays"
        desc$ = str$(RAY_SPAWN_CHANCE) + "% stingrays, then " + str$(RAY_SPAWN_CHANCE + RAY_SPAWN_STEP) + ", then " + str$(RAY_SPAWN_CHANCE + RAY_SPAWN_STEP * 2) + ". jellies thin them. a pop clears the column it faces."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 1
        maxUses = RAY_MAX
    }
    ` see LISTEN in fish_headers
    CARDS(ABILITY_INDEX_LISTEN) = {
        name$ = "listen"
        desc$ = "Stay awhile, and listen to the song of the sea."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    ` see THE OPENING SWAP in fish_headers
    CARDS(ABILITY_INDEX_QUICK_SONG) = {
        name$ = "quick song"
        desc$ = "A song no longer needs its opening swap."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BOTTLES) = {
        name$ = "bottles"
        desc$ = "a group of " + str$(BOTTLE_GROUP_SIZE) + " or more leaves a bottle. on the bottom row, it adds " + str$(BOTTLE_MULT_GAIN) + " to the multiplier."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }


    ` moves
    CARDS(ABILITY_INDEX_MOVE_SHIFT) = {
        name$ = "shift"
        desc$ = "move an entire row or column at once"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_SHIFT]
    }
    CARDS(ABILITY_INDEX_MOVE_CLONER) = {
        name$ = "clone"
        desc$ = "copy fish instead of swapping"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_CLONE]
    }
    CARDS(ABILITY_INDEX_MOVE_BOMB3x3) = {
        name$ = "bomb"
        desc$ = "blow up 9 fish"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_BOMB3x3]
    }
    CARDS(ABILITY_INDEX_MOVE_LINE_OUT) = {
        name$ = "line out"
        desc$ = "blow up an entire row or column"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_LINE_OUT]
    }

    ` this one is a swap like any other, so it does not stop the game while it plays. see LIVE_MOVE_FREE.
    CARDS(ABILITY_INDEX_MOVE_FREE) = {
        name$ = "free move"
        desc$ = "swap without using up a move, or risking the multiplier"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 2
        moveValue = [MOVE_FREE]
    }

    ` see THE OPENING SWAP in fish_headers. the cursor moves on its own, so this does not stop the game either.
    CARDS(ABILITY_INDEX_MOVE_SONG) = {
        name$ = "easy song"
        desc$ = "Begin a song. Walk it, and it is sung."
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = CORAL_SONG_COOLDOWN
        moveValue = [MOVE_SONG]
    }

    ` see THE ROBOT in fish_headers
    CARDS(ABILITY_INDEX_MOVE_ROBOT) = {
        name$ = "robot"
        desc$ = "makes " + str$(ROBOT_SWAPS) + " good swaps near the cursor, all for one move"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = ROBOT_COOLDOWN
        moveValue = [MOVE_ROBOT]
    }

    ` see KNOWN FILL in fish_headers
    CARDS(ABILITY_INDEX_MOVE_KNOWN_FILL) = {
        name$ = "known fill"
        desc$ = "a swap. if it pops fish, the new fish that drop in are all the kind that was moved"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = KNOWN_FILL_COOLDOWN
