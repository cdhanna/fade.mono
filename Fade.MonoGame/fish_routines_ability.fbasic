    CARDS(ABILITY_INDEX_MOVE_SLOT).desc$ = loc$("ability.tacklebox.desc")
    CARDS(ABILITY_INDEX_DEEP_POCKETS).name$ = loc$("ability.deeppockets.name")
    CARDS(ABILITY_INDEX_DEEP_POCKETS).desc$ = loc$("ability.deeppockets.desc", "cards", UPGRADE_CHOICES_MAX)
    CARDS(ABILITY_INDEX_SHOW_TIME).name$ = loc$("ability.showtime.name")
    CARDS(ABILITY_INDEX_SHOW_TIME).desc$ = loc$("ability.showtime.desc", "songs", SHOW_TIME_HINTS)

    ` passives
    CARDS(ABILITY_INDEX_WRAP).name$ = loc$("ability.seamless.name")
    CARDS(ABILITY_INDEX_WRAP).desc$ = loc$("ability.seamless.desc")
    CARDS(ABILITY_INDEX_CRABS).name$ = loc$("ability.crabs.name")
    CARDS(ABILITY_INDEX_CRABS).desc$ = loc$("ability.crabs.desc")
    ` "bird feast" was about worms. the worm is a starfish in the new art, so the card is about those now.
    CARDS(ABILITY_INDEX_BIRD_FEAST).name$ = loc$("ability.starless.name")
    CARDS(ABILITY_INDEX_BIRD_FEAST).desc$ = loc$("ability.starless.desc")
    CARDS(ABILITY_INDEX_PASSIVE_STOCK_MARKET).name$ = loc$("ability.stockmarket.name")
    CARDS(ABILITY_INDEX_PASSIVE_STOCK_MARKET).desc$ = loc$("ability.stockmarket.desc")
    CARDS(ABILITY_INDEX_THINK_BIGGER).name$ = loc$("ability.thinkbigger.name")
    CARDS(ABILITY_INDEX_THINK_BIGGER).desc$ = loc$("ability.thinkbigger.letoff.desc")
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER).name$ = loc$("ability.bottomfeeder.name")
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER).desc$ = loc$("ability.bottomfeeder.desc", "percent", BOTTOM_FEEDER_CHANCE)
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2).name$ = loc$("ability.bottomfeeder2.name")
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2).desc$ = loc$("ability.bottomfeeder2.desc", "percent", BOTTOM_FEEDER_CHANCE_2)
    CARDS(ABILITY_INDEX_CONTAGIOUS_SMILE).name$ = loc$("ability.contagioussmile.name")
