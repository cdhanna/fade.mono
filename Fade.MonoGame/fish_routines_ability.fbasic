        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 0
        moveValue = [MOVE_WASTE_BUCKET]
    }

    ` see BUNCH UP in fish_headers
    CARDS(ABILITY_INDEX_MOVE_BUNCH_UP) = {
        name$ = "bunch up"
        desc$ = "a swap that stacks the fish it connects into one, instead of popping them"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = BUNCH_UP_COOLDOWN
        moveValue = [MOVE_BUNCH_UP]
