        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 0
        moveValue = [MOVE_WASTE_BUCKET]
    }

    ` see BUNCH UP in fish_headers
    CARDS(ABILITY_INDEX_MOVE_BUNCH_UP) = {
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = BUNCH_UP_COOLDOWN
        moveValue = [MOVE_BUNCH_UP]
    }

    ` the three cards that only a fast gives out. see THE FAST in fish_headers_fast. they are never
    ` dealt: assign_ability_selection passes over every card from FAST_CARD_FROM on.
    CARDS(ABILITY_INDEX_MOVE_ROTATE) = {
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = ROTATE_COOLDOWN
        moveValue = [MOVE_ROTATE]
    }
    CARDS(ABILITY_INDEX_OPEN_BOOK) = {
        obtained = 0
