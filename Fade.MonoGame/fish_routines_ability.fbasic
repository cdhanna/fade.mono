` how many of the two cells of the last swap are in a group that would have popped without "think bigger",
` and did not pop with it. handle_combos calls this once it has found the groups. see THINK BIGGER in fish_headers.
function thinkBiggerHeld()
    held = 0
    if isAbility_ThinkBigger()
        held = thinkBiggerHeldCell(CORAL_SWAP_A) + thinkBiggerHeldCell(CORAL_SWAP_B)
    endif
endfunction held

` 1 when the cell is in a group of at least THINK_BIGGER_LET_OFF_SIZE fish that matched, and 0 otherwise.
` a group that is big enough to pop anyway fills the bar, so it does not matter that it counts here too.
function thinkBiggerHeldCell(heldCell)
    held = 0
    if heldCell >= 0
        heldGroup = CELLS(heldCell).comboFillId
        if heldGroup >= 0
            if CELLS(heldCell).comboForce = 0
                heldSize = 0
                heldLast = CELL_COUNT - 1
                for heldAt = 0 to heldLast
                    if CELLS(heldAt).comboFillId = heldGroup then heldSize = heldSize + 1
                next
                if heldSize >= THINK_BIGGER_LET_OFF_SIZE then held = 1
            endif
        endif
    endif
endfunction held

