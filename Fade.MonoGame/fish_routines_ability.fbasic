    CARDS(ABILITY_INDEX_MIDNIGHT_CRAB).name$ = loc$("ability.midnightcrab.name")
    CARDS(ABILITY_INDEX_MIDNIGHT_CRAB).desc$ = loc$("ability.midnightcrab.desc")
