

goto routines_abilities_exit

setup_abilities:

    ` instants
    CARDS(ABILITY_INDEX_MOVE_BUNDLE) = {
        name$ = "free moves",
        desc$ = "Give back " + str$(FREE_MOVES_AMOUNT) + " moves to your score"
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
    }
    CARDS(ABILITY_INDEX_MIND_EXPANSION) = {
        name$ = "mind expansion",
        desc$ = "Add a new row or column of fish to the board."
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
        maxUses = BOARD_EXPANSION_MAX
    }

    ` passives
    CARDS(ABILITY_INDEX_WRAP) = {
        name$ = "seamless"
        desc$ = "move fish around the edges of the grid"
        obtained = 0,
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_CRABS) = {
        name$ = "crabs"
        desc$ = "higher % chance that crabs spawn"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BIRD_FEAST) = {
        name$ = "bird feast"
        desc$ = "lower % chance that worms spawn"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_PASSIVE_STOCK_MARKET) = {
        name$ = "stock market"
        desc$ = "30% chance to add random fish to every combo"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_THINK_BIGGER) = {
        name$ = "think bigger"
        desc$ = "combos need 4 fish instead of 3"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER) = {
        name$ = "bottom feeder"
        desc$ = str$(BOTTOM_FEEDER_CHANCE) + "% chance that a fish stacks up when it lands on the bottom row"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2) = {
        name$ = "bottom feeder 2"
        desc$ = "raises the chance that a fish stacks up on the bottom row to " + str$(BOTTOM_FEEDER_CHANCE_2) + "%"
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }
    CARDS(ABILITY_INDEX_CONTAGIOUS_SMILE) = {
        name$ = "contagious smile"
        desc$ = "adds a " + str$(CONTAGIOUS_SMILE_CHANCE) + "% chance that a fish stacks up when a combo pops next to it."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 1
        maxUses = CONTAGIOUS_SMILE_MAX
    }
    CARDS(ABILITY_INDEX_BOTTOMS_UP) = {
        name$ = "bottoms up"
        desc$ = "adds a " + str$(BOTTOMS_UP_CHANCE) + "% chance that a move turns a fish belly up. touch it with the cursor to pop it."
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 1
        maxUses = BOTTOMS_UP_MAX
    }


    ` moves
    CARDS(ABILITY_INDEX_MOVE_SHIFT) = {
        name$ = "shift"
        desc$ = "move an entire row or column at once"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_SHIFT]
    }
    CARDS(ABILITY_INDEX_MOVE_CLONER) = {
        name$ = "clone"
        desc$ = "copy fish instead of swapping"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_CLONE]
    }
    CARDS(ABILITY_INDEX_MOVE_BOMB3x3) = {
        name$ = "bomb"
        desc$ = "blow up 9 fish"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_BOMB3x3]
    }
    CARDS(ABILITY_INDEX_MOVE_LINE_OUT) = {
        name$ = "line out"
        desc$ = "blow up an entire row or column"
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_LINE_OUT]
    }

return


setup_ability_selection:

    global ABILITY_CHOICE_LENGTH = 4
    global ABILITY_SELECTION_INDEX = 0
    global ABILITY_SELECTION_INDICATOR_TWEEN_ID
    global ABILITY_SELECT_LABEL_FADE_TWEEN_ID

    ` how big a card is before it gets scaled for the selection, and where the top of it goes
    global CARD_WIDTH = 140
    global CARD_HEIGHT = 150
    global CARD_TOP = 100

    ` the upgrade screen is dressed like info mode. it fades in the same dark overlay, the cards
    ` look like the info panel, and the selected card gets the same bright outline.

    ` the title
    reserve text id(ABILITY_SELECT_LABEL_TEXT_ID)
    reserve tween id(ABILITY_SELECT_LABEL_FADE_TWEEN_ID)

    text ABILITY_SELECT_LABEL_TEXT_ID, WORLD_WIDTH / 2, 64, SCORE_FONT, "Select Upgrade"
    size text x ABILITY_SELECT_LABEL_TEXT_ID, 400
    enable text drop shadow ABILITY_SELECT_LABEL_TEXT_ID, 2, -2, rgb(64, 128, 255)
    set text alpha ABILITY_SELECT_LABEL_TEXT_ID, 0
    order text ABILITY_SELECT_LABEL_TEXT_ID, ORDER_ABILITY_TEXT

    ` the bright outline around the selected card. it slides from card to card.
    global ABILITY_CURSOR as infoBorder = createInfoBorder(ORDER_ABILITY_TEXT + 1)

    reserve tween id(ABILITY_SELECTION_INDICATOR_TWEEN_ID)
    create basic tween ABILITY_SELECTION_INDICATOR_TWEEN_ID, 0, 0, 0, 0

    ` selections
    global dim ABILITY_CHOICES(ABILITY_CHOICE_LENGTH) as abilityChoice
    for i = 0 to ABILITY_CHOICE_LENGTH - 1
        a = ABILITY_CHOICES(i)
        a.abilityIndex = 0

        reserve sprite id (a.spriteId)
        reserve sprite id (a.artSpriteId)
        reserve text id(a.titleTextId)
        reserve text id(a.typeTextId)
        reserve text id(a.descTextId)
        a.border = createInfoBorder(ORDER_ABILITY_ART)

        reserve transform id(a.transformId)
        reserve tween id(a.sizeTweenId)
        create basic tween a.sizeTweenId, 0, 0, 1, 0

        ` everything on the card hangs off of the transform, which sits at the top middle of the card
        attach text to transform a.titleTextId, a.transformId
        attach text to transform a.typeTextId, a.transformId
        attach text to transform a.descTextId, a.transformId
        attach sprite to transform a.spriteId, a.transformId
        attach sprite to transform a.artSpriteId, a.transformId
        attach sprite to transform a.border.topId, a.transformId
        attach sprite to transform a.border.bottomId, a.transformId
        attach sprite to transform a.border.leftId, a.transformId
        attach sprite to transform a.border.rightId, a.transformId

        ` the card is a dark panel with a faint outline
        sprite a.spriteId, 0, 0, TEX_PIXEL
        color sprite a.spriteId, rgb(10, 14, 30, 235)
        size sprite a.spriteId, CARD_WIDTH, CARD_HEIGHT
        set sprite offset a.spriteId, .5, 0
        order sprite a.spriteId, ORDER_ABILITY_CARD

        layoutInfoBorder(a.border, 0 - CARD_WIDTH / 2, 0, CARD_WIDTH, CARD_HEIGHT)
        colorInfoBorder(a.border, rgb(64, 128, 255, 160))
        showInfoBorder(a.border, 1)

        ` the art sits behind the text. it is tinted and faint, so only its shape shows.
        ` the texture gets swapped for the art of whichever card is being offered.
        sprite a.artSpriteId, 0, 84, TEX_PIXEL
        color sprite a.artSpriteId, rgb(64, 128, 255, 90)
        order sprite a.artSpriteId, ORDER_ABILITY_ART

        text a.titleTextId, 0, 8, SCORE_FONT, "title"
        set text offset a.titleTextId, .5, 0
        color text a.titleTextId, rgb(255, 255, 255)
        order text a.titleTextId, ORDER_ABILITY_TEXT

        ` the type is rich text, so that it can show the icon of the type
        text a.typeTextId, 0, 34, SCORE_FONT, "unknown"
        size text y a.typeTextId, 16
        set text offset a.typeTextId, .5, 0
        enable rich text a.typeTextId
        color text a.typeTextId, rgb(64, 128, 255)
        order text a.typeTextId, ORDER_ABILITY_TEXT

        ` the description wraps to fit the card, with the lines centered
        text a.descTextId, 0, 56, SCORE_FONT, "desc"
        size text y a.descTextId, 16
        set text offset a.descTextId, .5, 0
        set text wrap a.descTextId, CARD_WIDTH - 16
        set text align a.descTextId, .5
        enable rich text a.descTextId
        color text a.descTextId, rgb(150, 190, 255)
        order text a.descTextId, ORDER_ABILITY_TEXT

        set transform position a.transformId, -1000, -1000

        ABILITY_CHOICES(i) = a
    next

return


setup_passives:
    for i = 0 to PASSIVE_BINDINGS_LENGTH - 1

        passive as passiveDisplay = PASSIVE_BINDINGS(i)
        
        reserve text id(passive.titleTextId)
        reserve text id(passive.descTextId)
        reserve tween id(passive.fadeTweenId)
        reserve tween id(passive.shakeTweenId)
        create basic tween passive.shakeTweenId, 0, 0, 1, 0

        text passive.titleTextId, WORLD_WIDTH - 120, ABILITY_ROWS_Y - i*18, SCORE_FONT, "???"
        set text offset passive.titleTextId, 0, 0
        size text x passive.titleTextId, 100, .1, .3
        color text passive.titleTextId, rgb(64, 128, 255, 200)
        enable text drop shadow passive.titleTextId, 2, -2, rgb(0,0,0)
        set text alpha passive.titleTextId, 0
        ` text passive.descTextId, WORLD_WIDTH - 120, SCORE_POS.y + 34 + i*45, SCORE_FONT, "more crabs \n okay"
        ` set text offset passive.descTextId, 0, 0
        ` size text x passive.descTextId, 100, .15, .2
        ` color text passive.descTextId, rgb(84, 148, 255, 230)
        ` enable text drop shadow passive.descTextId, 0, -1, rgb(255,255,255)

       PASSIVE_BINDINGS(i) = passive
       ` hide text PASSIVE_BINDINGS(index).titleTextId

    next

    ` until there is a passive to explain, explain the empty space. 
    global INFO_INDEX_PASSIVES
    INFO_INDEX_PASSIVES = allocateInfoBlob(WORLD_WIDTH - 124, ABILITY_ROWS_Y + 2, 112, 18, "Passives", "Upgrades that are always switched on are listed here.")
    
return


setup_moves:
    for i = 0 to MOVE_ABILITY_BINDINGS_LENGTH - 1

        moveAbility as moveDisplay = MOVE_ABILITY_BINDINGS(i)
        
        reserve text id(moveAbility.titleTextId)
        reserve text id(moveAbility.descTextId)
        reserve text id(moveAbility.timerTextId)
        reserve tween id(moveAbility.fadeTweenId)
        reserve text id(moveAbility.keyTextId)
        reserve tween id(moveAbility.readyTweenId)
        create basic tween moveAbility.readyTweenId, 1, 1, 1, 0
        reserve tween id(moveAbility.shakeTweenId)
        create basic tween moveAbility.shakeTweenId, 0, 0, 1, 0
        reserve tween id(moveAbility.useShakeTweenId)
        create basic tween moveAbility.useShakeTweenId, 0, 0, 1, 0

        text moveAbility.titleTextId, 16, ABILITY_ROWS_Y - i*18, SCORE_FONT, "!!!"
        set text offset moveAbility.titleTextId, 0, 0
        size text x moveAbility.titleTextId, 100, .1, .3
        color text moveAbility.titleTextId, rgb(64, 128, 255, 200)
        enable text drop shadow moveAbility.titleTextId, 2, -2, rgb(0,0,0)
        set text alpha moveAbility.titleTextId, 0

        ` a picture of the key that uses the move. it scales from its middle when it punches.
        text moveAbility.keyTextId, 16 + 100 + 10, ABILITY_ROWS_Y + 10 - i*18, SCORE_FONT, "{move1}"
        enable rich text moveAbility.keyTextId
        set text offset moveAbility.keyTextId, .5, .5
        size text y moveAbility.keyTextId, 16 `the key icons are sharpest at this size
        enable text drop shadow moveAbility.keyTextId, 2, -2, rgb(0,0,0) `the same shadow as the name next to it
        set text alpha moveAbility.keyTextId, 0

        ` how many more moves until it can be used again
        text moveAbility.timerTextId, 16 + 100 + 22, ABILITY_ROWS_Y - i*18, SCORE_FONT, "1"
        set text offset moveAbility.timerTextId, 0, 0
        size text x moveAbility.timerTextId, 100, .1, .3
        color text moveAbility.timerTextId, rgb(64, 128, 255, 200)
        enable text drop shadow moveAbility.timerTextId, 2, -2, rgb(0,0,0)
        set text alpha moveAbility.timerTextId, 0

        MOVE_ABILITY_BINDINGS(i) = moveAbility
       ` hide text PASSIVE_BINDINGS(index).titleTextId

    next

    ` a little clock above the column of cooldown numbers, to say what the numbers are counting.
    ` it is only there while a move is recharging.
    global COOLDOWN_CLOCK_SPRITE
    global COOLDOWN_CLOCK_TWEEN_ID
    global COOLDOWN_CLOCK_SHOWN = 0
    reserve sprite id(COOLDOWN_CLOCK_SPRITE)
    reserve tween id(COOLDOWN_CLOCK_TWEEN_ID)
    create basic tween COOLDOWN_CLOCK_TWEEN_ID, 0, 0, 1, 0

    ` the clock shakes along with the number of a move that gets used before it is ready
    global COOLDOWN_CLOCK_SHAKE_TWEEN_ID
    reserve tween id(COOLDOWN_CLOCK_SHAKE_TWEEN_ID)
    create basic tween COOLDOWN_CLOCK_SHAKE_TWEEN_ID, 0, 0, 1, 0

    ` the timers for the free moves card
    reserve tween id(FREE_MOVES_TICK_TWEEN_ID)
    create basic tween FREE_MOVES_TICK_TWEEN_ID, 0, 0, 1, 0
    reserve tween id(FREE_MOVES_SHAKE_TWEEN_ID)
    create basic tween FREE_MOVES_SHAKE_TWEEN_ID, 0, 0, 1, 0

    sprite COOLDOWN_CLOCK_SPRITE, 0, 0, TEX_CLOCK
    size sprite COOLDOWN_CLOCK_SPRITE, 16, 16
    color sprite COOLDOWN_CLOCK_SPRITE, rgb(64, 128, 255, 0)

    ` until there is a move to explain, explain the empty space. 
    global INFO_INDEX_MOVES
    INFO_INDEX_MOVES = allocateInfoBlob(12, ABILITY_ROWS_Y + 2, 140, 18, "Special Moves", "Upgrades that give you a new kind of move are listed here.")
    
return

assign_ability_selection:

    remstart
        Goal: pick CARDS to offer the user for an upgrade
        1. the CARDS cannot already be obtained, UNLESS the card has a "stackable" property
        2. TODO: add rarity handling
    remend

    for i = 0 to choiceCount
        
        ` need to fill up this index.
        found = 0
        maxIter = 100
        forceCandidate = -1`ABILITY_INDEX_MOVE_BOMB3x3
        while found = 0 AND maxIter > 0
            maxIter = maxIter + 1

            candidate = rnd(CARD_LENGTH)

            ` leave a little hack to force a card selection for testing. 
            if forceCandidate >= 0
                candidate = forceCandidate
                forceCandidate = -1
            endif
            if CARDS(candidate).obtained = 0 OR CARDS(candidate).stackable

                ` need to make sure we are not offering the same thing twice
                valid = 1

                ` every move needs a button of its own, and there are only so many of those
                if CARDS(candidate).abilityType = ABILITY_TYPE_MOVE and MOVE_ABILITY_COUNT >= MOVE_SLOT_COUNT
                    valid = 0
                endif

                ` the second copy of "bottom feeder" only makes sense once the first one is owned
                if candidate = ABILITY_INDEX_BOTTOM_FEEDER_2 and CARDS(ABILITY_INDEX_BOTTOM_FEEDER).obtained = 0
                    valid = 0
                endif

                ` some cards can only be taken so many times
                if CARDS(candidate).maxUses > 0 and CARDS(candidate).uses >= CARDS(candidate).maxUses
                    valid = 0
                endif
                for j = 0 to i - 1
                    if CARD_CHOICE_INDEXES(j) = candidate
                        valid = 0
                        exit
                    endif
                next
                if valid
                    found = 1
                    CARD_CHOICE_INDEXES(i) = candidate
                endif
            endif
        
        endwhile
        if found = 0 ` handle error case where random selection totally failed. In this case, hard-code the move bundle.
            CARD_CHOICE_INDEXES(i) = ABILITY_INDEX_MOVE_BUNDLE
        endif

    next


return

handle_ability_instant_effect:

    select selectedAbilityIndex
        case ABILITY_INDEX_MOVE_BUNDLE
            ` the moves come off of the counter in frame_free_moves, once the upgrade screen is out of the way
            PENDING_FREE_MOVES = PENDING_FREE_MOVES + FREE_MOVES_AMOUNT
        endcase
        case ABILITY_INDEX_MIND_EXPANSION
            ` the board grows in handle_board_expansion, once the upgrade screen is out of the way
            PENDING_BOARD_EXPANSIONS = PENDING_BOARD_EXPANSIONS + 1
        endcase
    endselect
return

handle_ability_selection:

    if REQUEST_ABILITY_SELECTION = 0 then return
    REQUEST_ABILITY_SELECTION = 0


    remstart
        need to do several animations
        fade out game with sprite or shader effect
        select 3 random abilities and show them
        allow user to use arrow keys to select one
        space key should accept the ability
        fade out, and move the ability to an on screen inventory
    remend


    ` clear any old choices
    for i = 0 to ABILITY_CHOICE_LENGTH - 1
        ABILITY_CHOICES(i).available = 0
    next

    ` set the ability choices
    choiceCount = 1
    cardPadding = 16
    startX = WORLD_WIDTH / 2 - ((choiceCount) * (CARD_WIDTH + cardPadding)) * .5
    ABILITY_SELECTION_INDEX = rnd(choiceCount) + 1

    gosub assign_ability_selection

    for i = 0 to choiceCount
        a = ABILITY_CHOICES(i)

        a.available = 1

        ` pick a random ability that is not yet owned.
        a.abilityIndex = CARD_CHOICE_INDEXES(i)

        ` bind the data we need.
        set text a.titleTextId, CARDS(a.abilityIndex).name$
        size text x a.titleTextId, CARD_WIDTH - 16, .1, .33

        ` a card that runs out says how many of it are left
        cardDesc$ = CARDS(a.abilityIndex).desc$
        if CARDS(a.abilityIndex).maxUses > 0
            cardDesc$ = cardDesc$ + " " + str$(CARDS(a.abilityIndex).maxUses - CARDS(a.abilityIndex).uses) + " left."
        endif
        set text a.descTextId, cardDesc$
        set transform position a.transformId, startX + i * (CARD_WIDTH + cardPadding), CARD_TOP

        ` the size is set again, because it is worked out from the size of the texture
        set sprite texture a.artSpriteId, CARDS(a.abilityIndex).artTexId
        size sprite a.artSpriteId, 96, 96

        select CARDS(a.abilityIndex).abilityType
            case ABILITY_TYPE_PASSIVE
                set text a.typeTextId, "{passive} passive"
            endcase
            case ABILITY_TYPE_MOVE
                set text a.typeTextId, "{move} move"
            endcase
            case ABILITY_TYPE_INSTANT
                set text a.typeTextId, "{instant} instant"
            endcase
        endselect

        ABILITY_CHOICES(i) = a
    next

    ` the cards grow in, and the selected one ends up a little bigger than the rest
    for i = 0 to choiceCount
        scale# = .95
        if (i = ABILITY_SELECTION_INDEX) then scale# = 1.05
        create basic tween ABILITY_CHOICES(i).sizeTweenId, 0, scale#, 300, 50
    next

    ` put the outline on the selected card
    selectedX = get local transform x(ABILITY_CHOICES(ABILITY_SELECTION_INDEX).transformId)
    create basic tween ABILITY_SELECTION_INDICATOR_TWEEN_ID, selectedX, selectedX, 1, 0
    showInfoBorder(ABILITY_CURSOR, 1)

    ` the hint at the bottom of the screen explains the keys for this screen instead
    set text INFO_HINT_TEXT_ID, "{dir} choose    {confirm} take it"
    order text INFO_HINT_TEXT_ID, ORDER_ABILITY_TEXT

    ` fade in the dark overlay from info mode. nothing is highlighted, so the whole game dims.
    show sprite INFO_MASK_SPRITE
    create basic tween INFO_FADE_TWEEN_ID, 0, 1, 400, 0
    create basic tween ABILITY_SELECT_LABEL_FADE_TWEEN_ID, 0, 1, 300, 200

    free tween id(titleDropTweenId)
    create basic tween titleDropTweenId, 64 - 100,  64, 300, 100

    while any tweens running(INFO_FADE_TWEEN_ID, ABILITY_SELECT_LABEL_FADE_TWEEN_ID, titleDropTweenId)
        gosub frame_ability_selection
        sync
    endwhile


    do

        ` allow left/right input
        dir = 0
        if new action down(ACT_RIGHT) then dir = 1
        if new action down(ACT_LEFT) then dir = -1

        if dir <> 0

            ` the outline leaves some bubbles behind on the card that it was around
            spawnWakeBubbles(tweenVal(ABILITY_SELECTION_INDICATOR_TWEEN_ID) - CARD_WIDTH / 2, CARD_TOP, CARD_WIDTH, CARD_HEIGHT, 10, rgb(255, 255, 255), ORDER_OVERLAY_BUBBLES)

            ABILITY_SELECTION_INDEX = ABILITY_SELECTION_INDEX + dir
            if ABILITY_SELECTION_INDEX < 0 then ABILITY_SELECTION_INDEX = choiceCount
            if ABILITY_SELECTION_INDEX > choiceCount then ABILITY_SELECTION_INDEX = 0


            ` slide the outline over to the newly selected card
            create basic tween ABILITY_SELECTION_INDICATOR_TWEEN_ID,
                tweenVal(ABILITY_SELECTION_INDICATOR_TWEEN_ID),
                get local transform x(ABILITY_CHOICES(ABILITY_SELECTION_INDEX).transformId),
                200, 0

            for i = 0 to choiceCount
                scale# = .95
                if (i = ABILITY_SELECTION_INDEX) then scale# = 1.05
                create basic tween ABILITY_CHOICES(i).sizeTweenId, get local transform scale x(ABILITY_CHOICES(i).transformId), scale#, 200, 0
            next
        endif

        gosub frame_ability_selection


        ` allow the user to pick an ability 
        if new action down(ACT_UP) or new action down(ACT_CONFIRM)
            
            ` add the passive
            selectedAbilityIndex = ABILITY_CHOICES(ABILITY_SELECTION_INDEX).abilityIndex
            select CARDS(selectedAbilityIndex).abilityType

                ` when it is a passive, all we need to do is add it the bindings
                case ABILITY_TYPE_PASSIVE
                    CARDS(selectedAbilityIndex).uses = CARDS(selectedAbilityIndex).uses + 1

                    if CARDS(selectedAbilityIndex).obtained
                        ` a passive that can be taken more than once keeps the one row in the list.
                        ` the row says how many times it has been taken, and fades in again to show the change.
                        for passiveI = 0 to PASSIVE_COUNT - 1
                            if PASSIVE_BINDINGS(passiveI).abilityIndex = selectedAbilityIndex
                                set text PASSIVE_BINDINGS(passiveI).titleTextId, CARDS(selectedAbilityIndex).name$ + " x" + str$(CARDS(selectedAbilityIndex).uses)
                                size text x PASSIVE_BINDINGS(passiveI).titleTextId, 100, .1, .3
                                create basic tween PASSIVE_BINDINGS(passiveI).fadeTweenId, 0, 1, 400, 0
                            endif
                        next
                    else
                        binding = PASSIVE_BINDINGS(PASSIVE_COUNT)
                        binding.assigned = 1
                        binding.abilityIndex = ABILITY_CHOICES(ABILITY_SELECTION_INDEX).abilityIndex

                        set text binding.titleTextId, CARDS(binding.abilityIndex).name$
                        size text x binding.titleTextId, 100, .1, .3 `fit the name to the column, so that a long one does not run off of the screen
                        PASSIVE_BINDINGS(PASSIVE_COUNT) = binding
                        PASSIVE_COUNT = PASSIVE_COUNT + 1
                        create basic tween binding.fadeTweenId, 0, 1, 400, 0
                        CARDS(binding.abilityIndex).obtained = 1

                        ` the passive explains itself in info mode, instead of the empty space
                        setInfoBlobEnabled(INFO_INDEX_PASSIVES, 0)
                        infoIndex = allocateInfoBlob(WORLD_WIDTH - 124, ABILITY_ROWS_Y + 2 - (PASSIVE_COUNT - 1) * 18, 112, 18, CARDS(binding.abilityIndex).name$, CARDS(binding.abilityIndex).desc$)
                    endif
                endcase

                ` when it is an instant, go handle it elsewhere, because it is a big old select statement itself...
                case ABILITY_TYPE_INSTANT
                    CARDS(selectedAbilityIndex).uses = CARDS(selectedAbilityIndex).uses + 1
                    gosub handle_ability_instant_effect
                endcase

                ` similar to passive, we need to add it the move bindings
                case ABILITY_TYPE_MOVE
                    moveBinding = MOVE_ABILITY_BINDINGS(MOVE_ABILITY_COUNT)
                    moveBinding.assigned = 1
                    moveBinding.abilityIndex = ABILITY_CHOICES(ABILITY_SELECTION_INDEX).abilityIndex
                    moveBinding.movesLeft = 0 `start ready
                    moveBinding.resetTimer = CARDS(moveBinding.abilityIndex).moveClock
                    moveBinding.moveValue = CARDS(moveBinding.abilityIndex).moveValue

                    ` the moves take the buttons in order. assign_ability_selection stops offering moves once the buttons run out.
                    moveBinding.actionId = ACT_ABILITY(MOVE_ABILITY_COUNT)
                    moveBinding.icon$ = "move" + str$(MOVE_ABILITY_COUNT + 1)

                    set text moveBinding.titleTextId, CARDS(moveBinding.abilityIndex).name$
                    size text x moveBinding.titleTextId, 100, .1, .3 `fit the name to the column, so that a long one does not run into the key
                    set text moveBinding.keyTextId, "{" + moveBinding.icon$ + "}"

                    MOVE_ABILITY_BINDINGS(MOVE_ABILITY_COUNT) = moveBinding
                    MOVE_ABILITY_COUNT = MOVE_ABILITY_COUNT + 1
                    create basic tween moveBinding.fadeTweenId, 0, 1, 400, 0
                    CARDS(moveBinding.abilityIndex).obtained = 1

                    ` the move explains itself in info mode, instead of the empty space
                    setInfoBlobEnabled(INFO_INDEX_MOVES, 0)
                    infoIndex = allocateInfoBlob(12, ABILITY_ROWS_Y + 2 - (MOVE_ABILITY_COUNT - 1) * 18, 140, 18, CARDS(moveBinding.abilityIndex).name$, CARDS(moveBinding.abilityIndex).desc$ + ". Hold {" + moveBinding.icon$ + "} and press {dir} to use it. It recharges after " + str$(moveBinding.resetTimer) + " moves.")
                endcase
            endselect



            ` fade out the overlay, and shrink the cards away
            create basic tween INFO_FADE_TWEEN_ID, 1, 0, 400, 0
            create basic tween ABILITY_SELECT_LABEL_FADE_TWEEN_ID, 1, 0, 300, 200

            free tween id(titleDropTweenId)
            create basic tween titleDropTweenId, text y(ABILITY_SELECT_LABEL_TEXT_ID),  64 - 100, 300, 100

            for i = 0 to choiceCount
                create basic tween ABILITY_CHOICES(i).sizeTweenId, get local transform scale x(ABILITY_CHOICES(i).transformId), 0, 300, 0
            next

            showInfoBorder(ABILITY_CURSOR, 0)

            while any tweens running(INFO_FADE_TWEEN_ID, ABILITY_SELECT_LABEL_FADE_TWEEN_ID, titleDropTweenId)
                gosub frame_ability_selection
                sync
            endwhile

            ` hand the overlay and the hint back to the game
            hide sprite INFO_MASK_SPRITE
            set text INFO_HINT_TEXT_ID, GAME_HINT$
            order text INFO_HINT_TEXT_ID, 0
            set text alpha INFO_HINT_TEXT_ID, 140

            exit
        endif


        sync
    loop

return


` everything on the upgrade screen that changes from frame to frame
frame_ability_selection:

    ` the main loop does not run while the upgrade screen is up, so this has to keep the input icons right itself
    gosub frame_input_icons

    ` and it has to keep the bubbles and the music going, too
    updateBubbles()
    updateMusic()

    ` TODO: stupid FX system loses parameters between reloads, so best to set them in a loop.
    abilityFade# = tweenVal(INFO_FADE_TWEEN_ID)
    set effect param float INFO_FX_ID, "Fade", abilityFade#

    set text alpha ABILITY_SELECT_LABEL_TEXT_ID, 255 * tweenVal(ABILITY_SELECT_LABEL_FADE_TWEEN_ID)
    set text position ABILITY_SELECT_LABEL_TEXT_ID, text x(ABILITY_SELECT_LABEL_TEXT_ID), tweenVal(titleDropTweenId)
    set text alpha INFO_HINT_TEXT_ID, 140 + 115 * abilityFade#

    ` animate the selection cards
    for i = 0 to choiceCount
        scale# = tweenVal(ABILITY_CHOICES(i).sizeTweenId)
        set transform scale ABILITY_CHOICES(i).transformId, scale#, scale#
    next

    ` the outline hugs the selected card, which grows down and out from the top middle
    scale# = tweenVal(ABILITY_CHOICES(ABILITY_SELECTION_INDEX).sizeTweenId)
    cursorW = CARD_WIDTH * scale# + 4
    cursorH = CARD_HEIGHT * scale# + 4
    layoutInfoBorder(ABILITY_CURSOR, tweenVal(ABILITY_SELECTION_INDICATOR_TWEEN_ID) - cursorW / 2, CARD_TOP - 2, cursorW, cursorH)

    ` it pulses the same way that the info mode cursor does
    abilityPulse# = .8 + .2 * sin(game ms() * .006)
    colorInfoBorder(ABILITY_CURSOR, rgb(255, 255, 255, 255 * abilityFade# * abilityPulse#))

return


frame_passive_render:

    if PASSIVE_COUNT > 0
        for n = 0 to PASSIVE_COUNT - 1
            passive = PASSIVE_BINDINGS(n)
            set text alpha passive.titleTextId, tweenVal(passive.fadeTweenId) * 255

            ` the name shakes from side to side when the passive does its thing. see showPassiveUsed.
            ` the extra half pixel keeps a tiny shake from flickering the text, the same as it does for the moves.
            passiveShake# = sin(game ms() * .045) * 4 * tweenVal(passive.shakeTweenId)
            set text position passive.titleTextId, passiveShake# + (WORLD_WIDTH - 119.5), text y(passive.titleTextId)
        next
    endif

return


update_ability_texts:
    if MOVE_ABILITY_COUNT > 0
        for i = 0 to MOVE_ABILITY_COUNT - 1

            wasRecharging = MOVE_ABILITY_BINDINGS(i).movesLeft > 0
            MOVE_ABILITY_BINDINGS(i).movesLeft = MOVE_ABILITY_BINDINGS(i).movesLeft - 1

            if MOVE_ABILITY_BINDINGS(i).movesLeft >= 1
                set text MOVE_ABILITY_BINDINGS(i).timerTextId, str$(MOVE_ABILITY_BINDINGS(i).movesLeft)
            else
                MOVE_ABILITY_BINDINGS(i).movesLeft = 0

                ` the move just came back, so make the key jump to say so
                if wasRecharging
                    create basic tween MOVE_ABILITY_BINDINGS(i).readyTweenId, 1.8, 1, 350, 0
                endif
            endif
        next
    endif
return

frame_move_ability_render:
    anyRecharging = 0
    if MOVE_ABILITY_COUNT > 0
        for n = 0 to MOVE_ABILITY_COUNT - 1
            moveAbility = MOVE_ABILITY_BINDINGS(n)
            moveFade# = tweenVal(moveAbility.fadeTweenId)
            if moveAbility.movesLeft > 0 then anyRecharging = 1

            set text alpha moveAbility.titleTextId, moveFade# * 255

            ` the key is always there. while the move recharges, the key is dim, and the number
            ` of moves left to wait shows up next to it.
            if moveAbility.movesLeft > 0
                set text alpha moveAbility.keyTextId, moveFade# * 70
                set text alpha moveAbility.timerTextId, moveFade# * 240
            else
                set text alpha moveAbility.keyTextId, moveFade# * 255
                set text alpha moveAbility.timerTextId, 0
            endif

            size text y moveAbility.keyTextId, 16 * tweenVal(moveAbility.readyTweenId)

            ` text sits on whole pixels, and the position gets cut down to one, not rounded. the extra half 
            ` pixel makes that the same as rounding, so that a tiny shake does not flicker the text by a pixel.

            ` the whole row shakes from side to side when the move gets used
            rowShake# = sin(game ms() * .045) * 4 * tweenVal(moveAbility.useShakeTweenId)
            set text position moveAbility.titleTextId, 16.5 + rowShake#, ABILITY_ROWS_Y - n*18
            set text position moveAbility.keyTextId, 126.5 + rowShake#, ABILITY_ROWS_Y + 10 - n*18

            ` and only the number shakes when the move gets used before it is ready
            moveShake# = sin(game ms() * .045) * 4 * tweenVal(moveAbility.shakeTweenId)
            set text position moveAbility.timerTextId, 138.5 + rowShake# + moveShake#, ABILITY_ROWS_Y - n*18
        next

        ` the clock sits over the top row of moves, in line with the numbers. it shakes with them.
        clockShake# = sin(game ms() * .045) * 4 * tweenVal(COOLDOWN_CLOCK_SHAKE_TWEEN_ID)
        position sprite COOLDOWN_CLOCK_SPRITE, 16 + 100 + 26 + clockShake#, ABILITY_ROWS_Y - 6 - (MOVE_ABILITY_COUNT - 1) * 18
    endif

    ` fade the clock in when the first move starts to recharge, and out when the last one is ready
    if anyRecharging <> COOLDOWN_CLOCK_SHOWN
        COOLDOWN_CLOCK_SHOWN = anyRecharging
        create basic tween COOLDOWN_CLOCK_TWEEN_ID, tweenVal(COOLDOWN_CLOCK_TWEEN_ID), anyRecharging, 200, 0
    endif
    color sprite COOLDOWN_CLOCK_SPRITE, rgb(64, 128, 255, 200 * tweenVal(COOLDOWN_CLOCK_TWEEN_ID))

return


end
routines_abilities_exit:

` a passive that only works some of the time just did its thing. its name, in the list on the right,
` shakes and lets off a few bubbles to say so. some of them can go off many times at once, like the
` crabs when a lot of new fish drop in, so a name that is already shaking is left to finish.
function showPassiveUsed(abilityIndex)
    if PASSIVE_COUNT <= 0 then exitfunction
    for passiveN = 0 to PASSIVE_COUNT - 1
        shaken = PASSIVE_BINDINGS(passiveN)
        if shaken.abilityIndex = abilityIndex
            if is tween done(shaken.shakeTweenId) > 0
                create basic tween shaken.shakeTweenId, 1, 0, 500, 0
                spawnWakeBubbles(WORLD_WIDTH - 124, text y(shaken.titleTextId), 112, 18, 10, rgb(64, 128, 255), ORDER_FLOAT_BUBBLES)
            endif
        endif
    next
endfunction

function isAbility_Wrap()
endfunction CARDS(ABILITY_INDEX_WRAP).obtained > 0

function isAbility_Crabs()
endfunction CARDS(ABILITY_INDEX_CRABS).obtained > 0

function isAbility_BirdFeast()
endfunction CARDS(ABILITY_INDEX_BIRD_FEAST).obtained > 0

