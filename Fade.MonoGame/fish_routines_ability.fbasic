    }
    CARDS(ABILITY_INDEX_OATH) = {
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }

    ` see THE ANGLER in fish_headers_angler. it comes after the cards of the fast, but it is dealt.
    CARDS(ABILITY_INDEX_ANGLER) = {
        obtained = 0
        abilityType = ABILITY_TYPE_INSTANT,
        stackable = 1
    }

    ` see THE CARD in fish_headers_school. it comes after the angler, and it is dealt too.
    CARDS(ABILITY_INDEX_FALL_IN_LINE) = {
        obtained = 0
        abilityType = ABILITY_TYPE_PASSIVE
        stackable = 0
    }

    ` see THREE MORE CARDS in fish_headers_school. these are dealt too.
    CARDS(ABILITY_INDEX_FLIPPER) = {
        obtained = 0
        abilityType = ABILITY_TYPE_MOVE
        stackable = 0
        moveClock = 4
        moveValue = [MOVE_FLIPPER]
    }
    CARDS(ABILITY_INDEX_HIGH_STAKES) = {
