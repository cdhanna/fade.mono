` how many cards the upgrade screen offers. see DEEP POCKETS in fish_headers.
function getUpgradeChoiceCount()
    pocketCount = UPGRADE_CHOICES_START + CARDS(ABILITY_INDEX_DEEP_POCKETS).uses
    if pocketCount > UPGRADE_CHOICES_MAX then pocketCount = UPGRADE_CHOICES_MAX
endfunction pocketCount

` how many moves it costs to deal the cards of the upgrade screen again. see THE REROLL in fish_headers.
function getRerollCost()
endfunction (UPGRADE_REROLLS + 1) * UPGRADE_REROLL_STEP

function isAbility_Listen()
endfunction CARDS(ABILITY_INDEX_LISTEN).obtained > 0

function isAbility_QuickSong()
endfunction CARDS(ABILITY_INDEX_QUICK_SONG).obtained > 0

` how many fish in a hundred pick up a fish from a pop next to them. the card adds to it every time it is taken.
function getContagiousSmileChance()
endfunction CARDS(ABILITY_INDEX_CONTAGIOUS_SMILE).uses * CONTAGIOUS_SMILE_CHANCE

` how many new fish in a hundred are jellyfish. the card adds to it every time it is taken, and the
` "rays" cards water it down. see JELLIES in fish_headers.
function getJellyChance()
    jellyCards = CARDS(ABILITY_INDEX_JELLIES).uses
    jellyRivals = CARDS(ABILITY_INDEX_RAYS).uses
    jellyChance = 0
    if jellyCards > 0
        ` the first card is worth more than the ones after it. see JELLIES in fish_headers.
        jellyTotal = JELLY_SPAWN_CHANCE + (jellyCards - 1) * JELLY_SPAWN_STEP
        jellyChance = (jellyTotal * jellyCards) / (jellyCards + jellyRivals)
    endif
endfunction jellyChance

` and how many are stingrays, which the "jellies" cards water down the same way
function getRayChance()
    rayCards = CARDS(ABILITY_INDEX_RAYS).uses
    rayRivals = CARDS(ABILITY_INDEX_JELLIES).uses
    rayChance = 0
    if rayCards > 0
        ` the first card is worth more than the ones after it. see RAYS in fish_headers.
        rayTotal = RAY_SPAWN_CHANCE + (rayCards - 1) * RAY_SPAWN_STEP
        rayChance = (rayTotal * rayCards) / (rayCards + rayRivals)
    endif
endfunction rayChance

` how many moves in a hundred turn a fish belly up. the card adds to it every time it is taken.
function getBottomsUpChance()
endfunction CARDS(ABILITY_INDEX_BOTTOMS_UP).uses * BOTTOMS_UP_CHANCE

` how many landings on the bottom row in a hundred pick up a fish, with the cards that are owned
function getBottomFeederChance()
    chance = 0
    if CARDS(ABILITY_INDEX_BOTTOM_FEEDER).obtained > 0 then chance = BOTTOM_FEEDER_CHANCE
    if CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2).obtained > 0 then chance = BOTTOM_FEEDER_CHANCE_2
endfunction chance

` how many connected fish of the same kind it takes to make a combo
function getRequiredComboCount()
    required = 3
    if isAbility_ThinkBigger() then required = 4
endfunction required