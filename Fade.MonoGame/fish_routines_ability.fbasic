    CARDS(ABILITY_INDEX_BOTTOMS_UP).name$ = loc$("ability.bottomsup.name")
    CARDS(ABILITY_INDEX_BOTTOMS_UP).desc$ = loc$("ability.bottomsup.desc", "percent", BOTTOMS_UP_CHANCE)
    CARDS(ABILITY_INDEX_JELLIES).name$ = loc$("ability.jellies.name")
    CARDS(ABILITY_INDEX_JELLIES).desc$ = loc$("ability.jellies.desc", "first", JELLY_SPAWN_CHANCE, "second", JELLY_SPAWN_CHANCE + JELLY_SPAWN_STEP, "third", JELLY_SPAWN_CHANCE + JELLY_SPAWN_STEP * 2)
    CARDS(ABILITY_INDEX_RAYS).name$ = loc$("ability.rays.name")
    CARDS(ABILITY_INDEX_RAYS).desc$ = loc$("ability.rays.desc", "first", RAY_SPAWN_CHANCE, "second", RAY_SPAWN_CHANCE + RAY_SPAWN_STEP, "third", RAY_SPAWN_CHANCE + RAY_SPAWN_STEP * 2)
    CARDS(ABILITY_INDEX_LISTEN).name$ = loc$("ability.listen.name")
    CARDS(ABILITY_INDEX_LISTEN).desc$ = loc$("ability.listen.desc")
    CARDS(ABILITY_INDEX_QUICK_SONG).name$ = loc$("ability.quicksong.name")
    CARDS(ABILITY_INDEX_QUICK_SONG).desc$ = loc$("ability.quicksong.desc")
    CARDS(ABILITY_INDEX_SNEAKING_DEATH).name$ = loc$("ability.sneakingdeath.name")
    CARDS(ABILITY_INDEX_SNEAKING_DEATH).desc$ = loc$("ability.sneakingdeath.desc")
