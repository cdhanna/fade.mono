function getCellX(column)
endfunction GRID_POS.x + column * CELL_SIZE

function getCellY(row)
endfunction GRID_POS.y + row * CELL_SIZE

function getCellIndex(pos as vec)
endfunction pos.x + pos.y * CELL_COLUMN_COUNT

` change how many columns and rows the board has.
` the board always fills the same square of the screen, and stays in the middle of it, so the cells
` get smaller as the board gets bigger. this puts every cell in its place in the grid, but it does
` not decide which fish is in it, and it does not move any sprites. the caller does those.
function resizeGrid(columns, rows)
    CELL_COLUMN_COUNT = columns
    CELL_ROW_COUNT = rows
    CELL_COUNT = columns * rows

    ` the longest side of the board is the one that has to fit
    longest = columns
    if rows > longest then longest = rows
    CELL_SIZE = GRID_SPAN / longest

    ` the fish do not shrink along with the cells. a picture of a fish is CELL_START_ART_SIZE pixels
    ` across, and drawing it any smaller than that leaves some of its pixels out, which makes the fish
    ` hard to tell apart. so on a bigger board they are the same size, and closer together. they only
    ` shrink if the cells get too small to hold them.
    CELL_ART_SIZE = CELL_START_ART_SIZE
    if CELL_ART_SIZE > CELL_SIZE - 1 then CELL_ART_SIZE = CELL_SIZE - 1

    ` the sprites are centered on their cell position, so the grid starts half a cell in.
    ` a - b + c comes out as a - (b + c), so the subtraction goes last
    GRID_POS.x = GRID_CENTER.x + CELL_SIZE / 2 - (columns * CELL_SIZE) / 2
    GRID_POS.y = GRID_CENTER.y + CELL_SIZE / 2 - (rows * CELL_SIZE) / 2

    ` the smoke is not sized in pixels like the fish are, so it gets scaled instead
    startSize# = CELL_START_SIZE
    fxScale# = CELL_SIZE / startSize#

    for i = 0 to CELL_MAX_COUNT - 1
        c = CELLS(i)
        if i < CELL_COUNT
            c.coord.x = i mod columns
            c.coord.y = i / columns
        else
            ` this cell is not on the board
            hide sprite c.spriteId
        endif
        scale sprite c.fxSpriteId, fxScale#, fxScale#
        hide sprite c.fxSpriteId
        CELLS(i) = c
    next

    ` info mode explains the board, wherever the board is now
    coralPlaceInfo()
endfunction

function getFishColorIndex(fishValue)
endfunction fishValue - 1

` pick the kind of a new fish for a cell, so that the fish does not pop the moment that it arrives.
` a kind is no good if the new fish, together with the fish of that kind that it would touch, and the
` ones that those touch, would be a group big enough to pop. every side of the cell is looked at.
` see NEW FISH in fish_headers. a cell that is waiting for a new fish of its own has to have a value
` of 0 by the time this is called, so that it does not count as a fish of any kind.
function getImpossibleRandomValueForCell(cellId)
    required = getRequiredComboCount()

    ` now and then a new fish may be let through that does pop, but never once the round has been won
    allowCombo = 0
    if NEW_FISH_COMBO_CHANCE > 0
        if rnd(100) < NEW_FISH_COMBO_CHANCE then allowCombo = 1
    endif
    if NEW_FISH_ROUND_WON then allowCombo = 0

    ` most new fish are not even allowed to touch a fish of their own kind. a pair does not pop, but a
    ` board that is full of pairs pops every time that fish fall, because a pair only needs one more.
    ` so `tooBig` is how big a group the new fish must not make: 2 for most of them, which is a
    ` pair, and the size that pops for the few that are allowed to make a pair.
    tooBig = 2
    if rnd(100) < NEW_FISH_PAIR_CHANCE then tooBig = required
    if NEW_FISH_ROUND_WON then tooBig = 2
    if tooBig > required then tooBig = required

    ` the kinds are tried at random first, so that the cards that change how often a kind shows up
    ` still do. when luck runs out, they are tried in order. there is always one that works, because
    ` the cell only touches four others, and there are more kinds than that.
    picked = getRandomValue()
    if allowCombo = 0
        tries = 0
        isSafe = 0
        while isSafe = 0
            groupSize = countFishGroup(cellId, picked, tooBig)
            if groupSize < tooBig
                isSafe = 1
            else
                tries = tries + 1
                if tries < 30
                    picked = getRandomValue()
                else
                    picked = (tries mod 7) + 1
                    if tries > 44 then isSafe = 1
                endif
            endif
        endwhile
    endif
endfunction picked


` how big the group would be, if the fish in a cell were of the given kind: the cell itself, the fish
` of that kind that touch it, the ones that touch those, and so on. the counting stops at `enough`,
` because all that anyone wants to know is whether the group is big enough to pop.
function countFishGroup(cellId, fishValue, enough)
    ` a cell is marked with this number when it has been counted, so the marks never have to be wiped
    NEW_FISH_STAMP = NEW_FISH_STAMP + 1
    NEW_FISH_MARKS(cellId) = NEW_FISH_STAMP

    ` the cells that have been found, and whose sides have not been looked at yet
    NEW_FISH_STACK(0) = cellId
    stackSize = 1

    found = 0
    while stackSize > 0
        stackSize = stackSize - 1
        spot = NEW_FISH_STACK(stackSize)
        found = found + 1
        if found >= enough
            stackSize = 0
        else
            spotX = spot mod CELL_COLUMN_COUNT
            spotY = spot / CELL_COLUMN_COUNT
            for side = 0 to 3
                nextSpot = -1
                if side = 0
                    if spotX > 0 then nextSpot = spot - 1
                endif
                if side = 1
                    if spotX < CELL_COLUMN_COUNT - 1 then nextSpot = spot + 1
                endif
                if side = 2
                    if spotY > 0 then nextSpot = spot - CELL_COLUMN_COUNT
                endif
                if side = 3
                    if spotY < CELL_ROW_COUNT - 1 then nextSpot = spot + CELL_COLUMN_COUNT
                endif

                if nextSpot >= 0
                    if NEW_FISH_MARKS(nextSpot) <> NEW_FISH_STAMP
                        if CELLS(nextSpot).value = fishValue
                            NEW_FISH_MARKS(nextSpot) = NEW_FISH_STAMP
                            NEW_FISH_STACK(stackSize) = nextSpot
                            stackSize = stackSize + 1
                        endif
                    endif
                endif
            next
        endif
    endwhile
endfunction found

` send a ring out across the board from a spot, which tilts the fish as it passes.
` the spot is in cells, and the ring starts `delay` milliseconds from now.
function spawnShockwave(x#, y#, strength#, delay)
    spawnShockwaveToward(x#, y#, 0, 0, strength#, delay, SHOCK_LIFE)
endfunction

` the same, but the ring is headed one way. it is strongest that way, it fades off to the sides, and
` there is none of it behind. the direction is how many cells across and down, like a move is.
function spawnShockwaveToward(x#, y#, dirX, dirY, strength#, delay, life)

    ` use one that is not going. when they are all going, the oldest one has the least left to lose.
    slot = -1
    oldest = 0
    for n = 0 to SHOCK_COUNT - 1
        if SHOCKS(n).active = 0
            slot = n
            exit
        endif
        if SHOCKS(n).startMs < SHOCKS(oldest).startMs then oldest = n
    next
    if slot < 0 then slot = oldest

    SHOCKS(slot) = {
        active = 1
        x# = x#
        y# = y#
        startMs = game ms() + delay
        strength# = strength#
        life = life
        dirX# = dirX
        dirY# = dirY
    }
endfunction

` STACKS. the stack of a fish is kept on its cell, the same as its kind is. so whenever a fish moves
` to a different cell, its stack has to be moved along with it. these do that.

` two fish trade places
function swapCellStacks(aIndex, bIndex)
    tempStack = CELLS(aIndex).stack
    tempShown# = CELLS(aIndex).stackShown#
    CELLS(aIndex).stack = CELLS(bIndex).stack
    CELLS(aIndex).stackShown# = CELLS(bIndex).stackShown#
    CELLS(bIndex).stack = tempStack
    CELLS(bIndex).stackShown# = tempShown#

    ` a fish that is belly up stays that way
    tempBelly = CELLS(aIndex).bellyUp
    tempBellyShown# = CELLS(aIndex).bellyShown#
    CELLS(aIndex).bellyUp = CELLS(bIndex).bellyUp
    CELLS(aIndex).bellyShown# = CELLS(bIndex).bellyShown#
    CELLS(bIndex).bellyUp = tempBelly
    CELLS(bIndex).bellyShown# = tempBellyShown#

    ` a fish that has sung on coral has still sung, wherever on the coral it goes. see THE FISH ON CORAL SING in fish_headers.
    tempSung = CORAL_SUNG(aIndex)
    CORAL_SUNG(aIndex) = CORAL_SUNG(bIndex)
    CORAL_SUNG(bIndex) = tempSung
endfunction

` one fish takes the place of another
function copyCellStack(fromIndex, toIndex)
    CELLS(toIndex).stack = CELLS(fromIndex).stack
    CELLS(toIndex).stackShown# = CELLS(fromIndex).stackShown#
    CELLS(toIndex).bellyUp = CELLS(fromIndex).bellyUp
    CELLS(toIndex).bellyShown# = CELLS(fromIndex).bellyShown#
endfunction

` a fish goes away, or a brand new one shows up
function clearCellStack(index)
    CELLS(index).stack = 0
    CELLS(index).stackShown# = 0
    CELLS(index).bellyUp = 0
    CELLS(index).bellyShown# = 0
endfunction

` a fish just landed in this cell, from a row above it. with the "bottom feeder" card, a fish that lands
` on the bottom row has a chance to pick up one more fish. the bubbles that show it off start `delay`
` milliseconds from now, for a fish that is still on its way down.
function fishHitBottom(index, delay)
    ` whatever sang in this cell is not what is in it now. see THE FISH ON CORAL SING in fish_headers.
    CORAL_SUNG(index) = 0

    if isAbility_BottomFeeder()
        if CELLS(index).coord.y = CELL_ROW_COUNT - 1
            ` the second copy of the card is the one doing the work, when it is owned
            feederIndex = ABILITY_INDEX_BOTTOM_FEEDER
            if CARDS(ABILITY_INDEX_BOTTOM_FEEDER_2).obtained > 0 then feederIndex = ABILITY_INDEX_BOTTOM_FEEDER_2
            tryStackFish(index, getBottomFeederChance(), delay, feederIndex)
        endif
    endif
endfunction

` give the fish in this cell a chance, out of a hundred, to pick up one more fish for its stack.
` a puff of bubbles shows it off, `delay` milliseconds from now.
function tryStackFish(index, chance, delay, abilityIndex)
    lucky = CELLS(index)
    if lucky.stack < FISH_STACK_MAX
        if rnd(100) < chance
            CELLS(index).stack = lucky.stack + 1
            showPassiveUsed(abilityIndex)
            spawnBubbles(getCellX(lucky.coord.x), getCellY(lucky.coord.y), CELL_SIZE / 3, 10, delay, FISH_COLORS(getFishColorIndex(lucky.value)))
        endif
    endif
endfunction

` BOTTOMS UP. see fish_headers.

` a move was made, and the board has settled. with the "bottoms up" card, that has a chance to turn
` one fish on the board belly up. the fish under the cursor is left alone, because the cursor has to
` come to a fish to pop it.
function rollBellyUpFish()
    if BELLY_UP_ROLL_DUE = 0 then exitfunction
    BELLY_UP_ROLL_DUE = 0

    ` horror coral has its own say about the fish that are on it, with or without the card
    rollHorrorCoral()

    if rnd(100) >= getBottomsUpChance() then exitfunction

    cursorIndex = getCellIndex(SELECTION_POS)
    startIndex = rnd(CELL_COUNT)
    for n = 0 to CELL_COUNT - 1
        index = (n + startIndex) mod CELL_COUNT
        if index <> cursorIndex and CELLS(index).bellyUp = 0
            unlucky = CELLS(index)
            CELLS(index).bellyUp = 1
            showPassiveUsed(ABILITY_INDEX_BOTTOMS_UP)
            spawnBubbles(getCellX(unlucky.coord.x), getCellY(unlucky.coord.y), CELL_SIZE / 3, 10, 0, FISH_COLORS(getFishColorIndex(unlucky.value)))
            exit
        endif
    next
endfunction

` the cursor just came to this cell. a fish that is belly up pops when that happens, and so does every
` belly up fish right next to it. handle_combos does the popping, and after that it finds any combos
` that the fish falling in have made.
function popBellyUpFish(index)
    ` a skeleton is not belly up, and none of this happens to one. see SKELETONS in fish_headers.
    touched = CELLS(index)
    if touched.bellyUp <> 1 then exitfunction

    ` it is already going to pop, with the rest of the belly up fish, because of the waste bucket
    if touched.comboForce > 0 then exitfunction

    CELLS(index).comboForce = 1
    if touched.coord.x > 0
        if CELLS(index - 1).bellyUp = 1 then CELLS(index - 1).comboForce = 1
    endif
    if touched.coord.x < CELL_COLUMN_COUNT - 1
        if CELLS(index + 1).bellyUp = 1 then CELLS(index + 1).comboForce = 1
    endif
    if touched.coord.y > 0
        if CELLS(index - CELL_COLUMN_COUNT).bellyUp = 1 then CELLS(index - CELL_COLUMN_COUNT).comboForce = 1
    endif
    if touched.coord.y < CELL_ROW_COUNT - 1
        if CELLS(index + CELL_COLUMN_COUNT).bellyUp = 1 then CELLS(index + CELL_COLUMN_COUNT).comboForce = 1
    endif

    REQUEST_COMBO_CHECK = 1
endfunction

` RAYS. see fish_headers.

` the stingray in this cell is popping, so it swims off the way that it is facing, and every fish in
` its column on that side of it pops too, as a group of their own. a stingray faces up, so that is the
` fish above it. one that is belly up faces down, so that is the fish below it.
` handle_combos calls this while it is going through the groups, and the group that is made
` here gets its turn later in that same pass. `groupBase` is the number that the groups of the forced
` pops start from. a fish that is popping already, or is in the group of the stingray, is left alone.
function shootRay(index, groupBase)
    rayColumn = CELLS(index).coord.x
    rayHome = CELLS(index).coord.y
    rayFirst = 0
    rayLast = rayHome - 1
    rayForce = FORCE_RAY + rayColumn
    if CELLS(index).bellyUp = 1
        rayFirst = rayHome + 1
        rayLast = CELL_ROW_COUNT - 1
        rayForce = FORCE_RAY_DOWN + rayColumn
    endif
    if rayLast < rayFirst then exitfunction

    rayShot = 0
    for rayRow = rayFirst to rayLast
        rayIndex = rayColumn + rayRow * CELL_COLUMN_COUNT
        rayOk = 1
        if CELLS(rayIndex).comboBlownUp then rayOk = 0
        if CELLS(rayIndex).comboForce > 0 then rayOk = 0
        if CELLS(rayIndex).comboFillId = CELLS(index).comboFillId then rayOk = 0
        if rayOk
            CELLS(rayIndex).comboForce = rayForce
            CELLS(rayIndex).comboFillId = groupBase + rayForce
            CELLS(rayIndex).comboFillMask = 1
            rayShot = 1

            ` a trail of bubbles goes along the column ahead of the pops, away from the stingray
            rayWait = abs(rayHome - rayRow) * 40
            spawnBubbles(getCellX(rayColumn), getCellY(rayRow), CELL_SIZE / 4, 3, rayWait, FISH_COLORS(getFishColorIndex(TEX_RAY)))
        endif
    next
    if rayShot
        showPassiveUsed(ABILITY_INDEX_RAYS)
    endif
endfunction

` JELLIES. see fish_headers.

` the jellyfish in this cell is popping, and it stings the fish right next to it. it pops `delay`
` milliseconds from now, and that is when the bolts jump to the fish that it stung.
function stingJelly(index, delay)
    stingX = CELLS(index).coord.x
    stingY = CELLS(index).coord.y
    if stingX > 0
        stingNeighbor(index, index - 1, delay)
    endif
    if stingX < CELL_COLUMN_COUNT - 1
        stingNeighbor(index, index + 1, delay)
    endif
    if stingY > 0
        stingNeighbor(index, index - CELL_COLUMN_COUNT, delay)
    endif
    if stingY < CELL_ROW_COUNT - 1
        stingNeighbor(index, index + CELL_COLUMN_COUNT, delay)
    endif
endfunction

` the jellyfish in the one cell has a go at the fish in the other, and sends a bolt to it if it lands
function stingNeighbor(jellyIndex, fishIndex, delay)
    if stingFish(fishIndex)
        spawnZap(getCellX(CELLS(jellyIndex).coord.x), getCellY(CELLS(jellyIndex).coord.y), getCellX(CELLS(fishIndex).coord.x), getCellY(CELLS(fishIndex).coord.y), delay)

        ` a puff of bubbles where the bolt lands. they are the color of bone when the fish is one now.
        stingTint = FISH_COLORS(getFishColorIndex(TEX_JELLY))
        if CELLS(fishIndex).bellyUp = 2 then stingTint = rgb(236, 232, 204)
        spawnBubbles(getCellX(CELLS(fishIndex).coord.x), getCellY(CELLS(fishIndex).coord.y), CELL_SIZE / 3, 8, delay + 60, stingTint)
    endif
endfunction

` the fish in this cell is next to a jellyfish that is popping. it has a chance to get stung. a fish
` that is stung goes belly up, and one that is belly up already turns into a skeleton. a fish that is
` popping too, or is a skeleton already, or is a bottle, is left alone. this is 1 when the sting landed.
function stingFish(index)
    if CELLS(index).comboBlownUp then exitfunction 0
    if CELLS(index).bellyUp >= 2 then exitfunction 0
    if CELLS(index).value = TEX_BOTTLE then exitfunction 0
    if rnd(100) >= JELLY_STING_CHANCE then exitfunction 0

    CELLS(index).bellyUp = CELLS(index).bellyUp + 1
    showPassiveUsed(ABILITY_INDEX_JELLIES)
endfunction 1

` BOTTLES. see fish_headers.

` every bottle that is on the bottom row adds to the multiplier, and is marked to pop. handle_combos
` calls this every time that it looks at the board, before it finds the groups.
function checkBottles()
    bottomStart = CELL_COUNT - CELL_COLUMN_COUNT
    lastColumn = CELL_COLUMN_COUNT - 1
    for bottleColumn = 0 to lastColumn
        bottleIndex = bottomStart + bottleColumn
        if CELLS(bottleIndex).value = TEX_BOTTLE
            if CELLS(bottleIndex).comboForce < FORCE_BOTTLE
                CELLS(bottleIndex).comboForce = FORCE_BOTTLE + bottleColumn
                ` a stacked bottle pays out once for itself, and once more for every bottle behind it.
                ` a bottle that is a skeleton pays more. see SKELETONS in fish_headers.
                bottleGain = BOTTLE_MULT_GAIN
                if CELLS(bottleIndex).bellyUp = 2 then bottleGain = BOTTLE_SKELETON_GAIN
                addMultiplier(bottleGain * (1 + CELLS(bottleIndex).stack))
                showPassiveUsed(ABILITY_INDEX_BOTTLES)
                spawnBubbles(getCellX(bottleColumn), getCellY(CELL_ROW_COUNT - 1), CELL_SIZE / 3, 12, 0, rgb(255, 255, 255))
            endif
        endif
    next
endfunction

` THE WASTE BUCKET. see fish_headers.

` how many fish on the board are belly up, or skeletons
function countBellyUpFish()
    bellyCount = 0
    lastCell = CELL_COUNT - 1
    for bellyIndex = 0 to lastCell
        if CELLS(bellyIndex).bellyUp then bellyCount = bellyCount + 1
    next
endfunction bellyCount

` mark every belly up fish, and every skeleton, to pop, all as one group. handle_combos does the popping, and scores them.
` the cursor ends up one cell over, the way that it was pointed, like it does after any other special move.
function doWasteBucket(start as vec, dir as vec)
    spawnCursorWake(start.x, start.y)
    target as vec = addCoordinates(start, dir)

    lastCell = CELL_COUNT - 1
    for bellyIndex = 0 to lastCell
        if CELLS(bellyIndex).bellyUp
            CELLS(bellyIndex).comboForce = FORCE_BUCKET
            spawnBubbles(getCellX(CELLS(bellyIndex).coord.x), getCellY(CELLS(bellyIndex).coord.y), CELL_SIZE / 3, 6, 0, rgb(255, 255, 255))
        endif
    next

    cursorX = getCellX(start.x)
    cursorY = getCellY(start.y)
    endX = getCellX(target.x)
    endY = getCellY(target.y)
    create basic tween TWEEN_SWAP_AX, 0, 1, 150, 0
    while is tween done(TWEEN_SWAP_AX) < 1
        glide# = tweenVal(TWEEN_SWAP_AX)
        position sprite SELECTION_SPRITE, cursorX + (endX - cursorX) * glide#, cursorY + (endY - cursorY) * glide#
        collectInput()
        updateBubbles()
        sync
    endwhile

    registerMove(1)
endfunction

` BUNCH UP. see fish_headers.

` the fish that are joined up with the one in this cell all go into a stack behind it, if there are
` enough of them to have popped. they are marked to go away, and handle_combos fills their cells back in.
function bunchGroup(keepIndex, required)
    ` it is already going into the stack of the other fish of the swap, which is the same kind
    if CELLS(keepIndex).comboForce > 0 then exitfunction

    ROBOT_STAMP = ROBOT_STAMP + 1
    bunchSize = robotGroupSize(keepIndex, CELLS(keepIndex).value, ROBOT_STAMP)
    if bunchSize < required then exitfunction

    ` every fish of the group counts, and so does every fish that was stacked behind one of them
    bunchTotal = 0
    lastCell = CELL_COUNT - 1
    for bunchIndex = 0 to lastCell
        if CELLS(bunchIndex).comboFillId = ROBOT_STAMP
            bunchTotal = bunchTotal + 1 + CELLS(bunchIndex).stack
            if bunchIndex <> keepIndex
                CELLS(bunchIndex).comboForce = FORCE_BUNCH
                CELLS(bunchIndex).stack = 0
                spawnBubbles(getCellX(CELLS(bunchIndex).coord.x), getCellY(CELLS(bunchIndex).coord.y), CELL_SIZE / 4, 4, 0, FISH_COLORS(getFishColorIndex(CELLS(bunchIndex).value)))
            endif
        endif
    next

    ` the one in front is not part of its own stack
    bunchStack = bunchTotal - 1
    if bunchStack > BUNCH_STACK_MAX then bunchStack = BUNCH_STACK_MAX
    CELLS(keepIndex).stack = bunchStack
    create basic tween CELLS(keepIndex).scaleWaveTweenId, 1.6, 1, 300, 0
endfunction

` the fish in the `start` cell and the one in the `target` cell trade places, and the cursor goes along
` with the first one. the special moves that are swaps use this. it stops the game until it has played out.
function playSpecialSwap(start as vec, target as vec)
    spawnCursorWake(start.x, start.y)
    aIndex = getCellIndex(start)
    bIndex = getCellIndex(target)

    startX = getCellX(start.x)
    startY = getCellY(start.y)
    endX = getCellX(target.x)
    endY = getCellY(target.y)
    duration = 150

    create basic tween TWEEN_SWAP_AX, startX, endX, duration, 0
    create basic tween TWEEN_SWAP_AY, startY, endY, duration, 0
    create basic tween TWEEN_SWAP_BX, endX, startX, duration, 0
    create basic tween TWEEN_SWAP_BY, endY, startY, duration, 0

    create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, CELL_SIZE * 1.5, 150, 50
    set tween type SELECTION_TWEEN_PUNCH_ID, 1

    create basic tween SWAP_TWEEN_SFX, 0, 1, 150, 0
    set tween type SWAP_TWEEN_SFX, 1

    while (is tween done(TWEEN_SWAP_AX) < 1) or (is tween done(SELECTION_TWEEN_PUNCH_ID) < 1)
        position sprite CELLS(aIndex).spriteId, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        position sprite CELLS(bIndex).spriteId, tweenVal(TWEEN_SWAP_BX), tweenVal(TWEEN_SWAP_BY)
        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)
        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        collectInput()
        updateBubbles()
        sync
    endwhile
    scale sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE
    set sfx volume SFX_SWAP, 0

    ` they really do trade places now
    tradeValue = CELLS(bIndex).value
    CELLS(bIndex).value = CELLS(aIndex).value
    CELLS(aIndex).value = tradeValue
    swapCellStacks(aIndex, bIndex)
    updateCell(CELLS(aIndex))
    updateCell(CELLS(bIndex))
endfunction

` swap the fish under the cursor with the one next to it, and then stack up whatever that connects.
` this stops the game until it has played out, the same as the other special moves do.
function doBunchUp(start as vec, dir as vec)
    target as vec = addCoordinates(start, dir)
    playSpecialSwap(start, target)

    ` the fish that went with the cursor gets its stack first, and then the one that came back the other way
    required = getRequiredComboCount()
    bunchGroup(getCellIndex(target), required)
    bunchGroup(getCellIndex(start), required)

    registerMove(1)
endfunction

function updateCell(c as cell)
    sprite c.spriteId, getCellX(c.coord.x), getCellY(c.coord.y), fishPicture(c.value, c.bellyUp)
endfunction

` the picture of a fish of a kind: the fish, or the bones of it when it is a skeleton. see SKELETONS in
` fish_headers. `fishState` is the bellyUp of the fish.
function fishPicture(fishKind, fishState)
    fishShown = fishKind
    if fishState = 2
        if fishKind > 0
            fishShown = SKELETON_TEX(fishKind)
        endif
    endif
endfunction fishShown
 
function spawnScoreText(pos as vec, score$, delay)
    textId = spawnScoreTextScaled(pos, score$, delay, 800, 1)
endfunction textId

` a score text that comes out of a fish on the board. the "mind expansion" card makes the cells of the
` board smaller, and these shrink along with the fish, the same as the bubbles do.
` the text is gone again `life` milliseconds after it shows up. 800 is the usual. a short one makes
` room for the next text to come out of the same spot.
function spawnBoardScoreText(pos as vec, score$, delay, life)
    textId = spawnScoreTextScaled(pos, score$, delay, life, getBoardBubbleScale())
endfunction textId

` the one that does the work. `textScale#` is 1 for a text of the usual size.
function spawnScoreTextScaled(pos as vec, score$, delay, life, textScale#)
    ` a short one shrinks and fades more quickly, so that it still gets some time at full size
    fadeTime = 200
    shrinkTime = 300
    if life < 600
        fadeTime = 120
        shrinkTime = 160
    endif

    i = SCORE_TEXT_NUM
    SCORE_TEXT_NUM += 1

    if SCORE_TEXT_NUM >= SCORE_TEXT_COUNT then SCORE_TEXT_NUM = 0

    txt = SCORE_TEXTS(i)
    txt.active = 1
    SCORE_TEXTS(i).scale# = textScale#`frame_texts needs it, to know how far to float the text

    ` everything about the text is this many times as big: its letters, its shadow, and how far it moves
    textHeight# = 24 * textScale#
    textRise# = 15 * textScale#
    textDrift# = (rnd(10) - 5) * textScale#

    set text txt.textId, score$
    set text position txt.textId, pos.x, pos.y
    set text alpha txt.textId, 0
    size text y txt.textId, textHeight#
    rotate text txt.textId, rnd(10)*.05 - .25
    enable text drop shadow txt.textId, 2 * textScale#, -4 * textScale#, rgb(0,0,40)

    create basic tween txt.floatTweenIdX, pos.x, pos.x + textDrift#, 230, delay + 50
    create basic tween txt.floatTweenIdY, pos.y, pos.y - textRise#, 260, delay + 50
    ` while nothing scores, the numbers that float up off of the fish are not shown either
    textAlpha = 255
    if tutorialScoreOff() then textAlpha = 0

    create basic tween txt.fadeInTweenId,   0, textAlpha,     100, delay
    create basic tween txt.fadeTweenId,     textAlpha, 0,     fadeTime, delay + life - fadeTime
    create basic tween txt.scaleOutTweenId, textHeight#, 4 * textScale#, shrinkTime, delay + life - shrinkTime

endfunction txt.textId

function setProgressTween(bar as progressBar, progress)
    x = progress - bar.startVal
    dist# = bar.endVal - bar.startVal

    r# = x / dist#

    create basic tween bar.progressTweenId, tweenVal(bar.progressTweenId), r#, 100, 50

endfunction

` score some points, and have them show up on the bar `delay` milliseconds from now.
` see THE SCORE THAT SHOWS in fish_headers.
function queueScore(points, delay)
    ` the very first game does not score until the bar of the round is on the screen
    if tutorialScoreOff() then exitfunction

    CURRENT_SCORE = CURRENT_SCORE + points

    if SCORE_TICK_COUNT < SCORE_TICK_MAX
        SCORE_TICK_MS(SCORE_TICK_COUNT) = game ms() + delay
        SCORE_TICK_POINTS(SCORE_TICK_COUNT) = points
        SCORE_TICK_COUNT = SCORE_TICK_COUNT + 1
    else
        ` there is no room to wait, so these show up right away
        SCORE_SHOWN = SCORE_SHOWN + points
    endif
endfunction

` move the points that are due onto the bar. frame_score calls this on every frame.
function stepScoreTicks()
    if SCORE_TICK_COUNT > 0
        tickNow = game ms()
        tickGot = 0
        tickI = 0
        while tickI < SCORE_TICK_COUNT
            if SCORE_TICK_MS(tickI) <= tickNow
                SCORE_SHOWN = SCORE_SHOWN + SCORE_TICK_POINTS(tickI)
                tickGot = 1

                ` the last one in the list takes its place, and gets looked at next
                SCORE_TICK_COUNT = SCORE_TICK_COUNT - 1
                SCORE_TICK_MS(tickI) = SCORE_TICK_MS(SCORE_TICK_COUNT)
                SCORE_TICK_POINTS(tickI) = SCORE_TICK_POINTS(SCORE_TICK_COUNT)
            else
                tickI = tickI + 1
            endif
        endwhile

        ` the bar slides to the new score. it is quick, so that it keeps up with fish that pop one right after another.
        if tickGot
            tickSpan# = SCORE_BAR.endVal - SCORE_BAR.startVal
            tickAhead# = SCORE_SHOWN - SCORE_BAR.startVal
            tickRatio# = tickAhead# / tickSpan#
            if tickRatio# > 1 then tickRatio# = 1
            create basic tween SCORE_BAR.progressTweenId, tweenVal(SCORE_BAR.progressTweenId), tickRatio#, 90, 0
        endif
    endif
endfunction

` the score that shows is the real score, with nothing waiting. for a new game, and a loaded one.
function syncScoreShown()
    SCORE_SHOWN = CURRENT_SCORE
    SCORE_TICK_COUNT = 0
    SCORE_BAR_HOLD = 0
endfunction

` how many points the round takes. `roundIndex` is 0 for the first round. see HOW LONG A ROUND IS in fish_headers.
function getRoundSpan(roundIndex)
    roundNumber# = roundIndex + 1
    roundBase# = SCORE_ROUND_BASE
    roundSpan# = roundBase# * pow(roundNumber#, SCORE_ROUND_POWER#)

    ` to the nearest 10, because everything that scores is a multiple of 10
    roundTens = (roundSpan# + 5) / 10
    roundSpan = roundTens * 10
    if roundSpan < 10 then roundSpan = 10
endfunction roundSpan

` an upgrade has been picked, so the bar that was being held full empties out, and starts on the next round.
function advanceScoreBar()
    if SCORE_BAR_HOLD
        SCORE_BAR_HOLD = 0

        ` the round was counted when its bar filled up, so CURRENT_ROUND is already the round that is starting
        newSpan = getRoundSpan(CURRENT_ROUND)
        newStart = SCORE_BAR.endVal

        ` whatever was scored past the end of the last round is already part of this one, but only so much
        ` of it. past that, the round starts later instead, so that the score is still all there.
        carryMax = newSpan * SCORE_CARRY_MAX#
        carried = CURRENT_SCORE - newStart
        if carried > carryMax then newStart = CURRENT_SCORE - carryMax

        SCORE_BAR.startVal = newStart
        SCORE_BAR.endVal = newStart + newSpan
        PROGRESS_BARS(0) = SCORE_BAR

        barSpan# = SCORE_BAR.endVal - SCORE_BAR.startVal
        barAhead# = SCORE_SHOWN - SCORE_BAR.startVal
        barRatio# = barAhead# / barSpan#
        if barRatio# > 1 then barRatio# = 1

        ` the bar is empty right away, and stays that way for a moment so that it is seen to be empty.
        ` then it grows from the left to where the new round starts.
        create basic tween SCORE_BAR.progressTweenId, 0, barRatio#, 450, 350
    endif
endfunction

function getRoundsLeft()

endfunction GAME_ROUND_CAP - CURRENT_ROUND

` write how many rounds are left onto the screen. a game that was won, and is being carried on with,
` says how many rounds past the end it is. see KEEP PLAYING in fish_headers.
function showRoundsLeft()
    roundsWords$ = str$(getRoundsLeft())
    if GAME_ENDLESS
        roundsWords$ = "+" + str$(CURRENT_ROUND - GAME_ROUND_CAP)
    endif
    set text ROUND_COUNT_TEXT_ID, roundsWords$
endfunction

` how many rounds a game of the given length has. the length is one of the GAME_LENGTH constants.
function getGameLengthRounds(length)
    rounds = 30
    if length = GAME_LENGTH_SHORT then rounds = 5
    if length = GAME_LENGTH_LONG then rounds = 100
endfunction rounds

function createProgressBar(pos as vec, size as vec)
    bar as progressBar 
    bar.pos = pos
    bar.size = size

    reserve sprite id(bar.backgroundSpriteId)
    reserve sprite id(bar.foregroundSpriteId)

    reserve tween id(bar.progressTweenId)
    reserve tween id(bar.scaleTweenId)

    sprite bar.backgroundSpriteId, pos.x, pos.y, TEX_PIXEL
    size sprite bar.backgroundSpriteId, size.x, size.y
    set sprite offset bar.backgroundSpriteId, 0, 0
    color sprite bar.backgroundSpriteId, rgb(32, 64, 128, 128)

    sprite bar.foregroundSpriteId, pos.x + 1, pos.y + 1, TEX_PIXEL
    size sprite bar.foregroundSpriteId, 0, size.y - 2
    set sprite offset bar.foregroundSpriteId, 0, 0
    color sprite bar.foregroundSpriteId, rgb(64, 128, 255, 200)

    reserve text id(bar.textNumId)
    text bar.textNumId, pos.x + size.x, pos.y+2, SCORE_FONT, "0/100"
    size text y bar.textNumId, 15
    set text offset bar.textNumId, 1, 0
    color text bar.textNumId, rgb(64, 128, 255, 200)
    enable text drop shadow bar.textNumId, 2, -2, rgb(0,0,0)

    reserve text id(bar.textTitleId)
    text bar.textTitleId, pos.x, pos.y+3, SCORE_FONT, "Round Progress"
    size text y bar.textTitleId, 20
    set text offset bar.textTitleId, 0, 1
    color text bar.textTitleId, rgb(64, 128, 255, 200)
    enable text drop shadow bar.textTitleId, 1, -1, rgb(0,0,0)
    

endfunction bar


function findCombos(cIndex, groupId)
    ` find the cell to the left, 
    leftIndex = cIndex - 1
    rightIndex = cIndex + 1
    topIndex = cIndex - CELL_COLUMN_COUNT
    lowIndex = cIndex + CELL_COLUMN_COUNT

    cell = CELLS(cIndex)

    hasLeft = cell.coord.x > 0
    hasRight = cell.coord.x < CELL_COLUMN_COUNT - 1
    hasTop = cell.coord.y > 0
    hasLow = cell.coord.y < CELL_ROW_COUNT - 1


    if hasLeft
        left = CELLS(leftIndex)
        if left.comboFillMask = 0 AND left.value = cell.value
            left.comboFillMask = 1
            left.comboFillId = groupId
            CELLS(leftIndex) = left
            findCombos(leftIndex, groupId)
        endif
    endif
    if hasRight
        right = CELLS(rightIndex)
        if right.comboFillMask = 0 AND right.value = cell.value
            right.comboFillMask = 1
            right.comboFillId = groupId

            CELLS(rightIndex) = right
            findCombos(rightIndex, groupId)
        endif
    endif
    if hasTop
        top = CELLS(topIndex)
        if top.comboFillMask = 0 AND top.value = cell.value
            top.comboFillMask = 1
            top.comboFillId = groupId
            CELLS(topIndex) = top
            findCombos(topIndex, groupId)
        endif
    endif
    if hasLow
        low = CELLS(lowIndex)
        if low.comboFillMask = 0 AND low.value = cell.value
            low.comboFillMask = 1
            low.comboFillId = groupId
            CELLS(lowIndex) = low
            findCombos(lowIndex, groupId)
        endif
    endif

endfunction



function collectInput()

    if frame number() = COLLECTED_INPUT_MASK then exitfunction

    ` the bar is full and fizzing, so the round is over, and the upgrade screen is on its way. the cursor
    ` stays where it is until the next round starts. a move that is already playing out still finishes,
    ` but the ones that were waiting behind it are dropped, so that they do not go off after the upgrade.
    if SCORE_BAR_HOLD > 0
        QUEUED_MOVE_NUM = 0
        QUEUED_MOVE_TAIL = 0
        exitfunction
    endif

    swapDir as vec = {
        x = 0, 
        y = 0
    } 

    isSwap = action down(ACT_SWAP)
    swapVal = -1
    if MOVE_ABILITY_COUNT > 0
        for i = 0 to MOVE_SLOT_COUNT - 1
            moveBinding = MOVE_ABILITY_BINDINGS(i)
            if moveBinding.assigned = 0 then skip

            isKey = action down(moveBinding.actionId)
            ` TODO: check for the ready staus when actually processing input.
            `isReady = moveBinding.movesLeft <= 0

            if isKey ` and isReady
                swapVal = i
            endif

        next i
    endif

    
`    isShift = isAbility_MoveShift() and key down(scancode("Z"))

    if new action down(ACT_RIGHT) then swapDir.x = 1
    if new action down(ACT_LEFT) then swapDir.x = -1
    if new action down(ACT_UP) then swapDir.y = -1
    if new action down(ACT_DOWN) then swapDir.y = 1

    ` the queue is full. moves can pile up now that they can be made while a combo is going.
    if QUEUED_MOVE_NUM >= QUEUED_MOVE_MAX - 1 then exitfunction

    if swapDir.x <> 0 or swapDir.y <> 0
        QUEUED_MOVES(QUEUED_MOVE_NUM) = {
            dir = swapDir
            swap = 0,
            moveBindingIndex = swapVal
        }
        if isSwap then QUEUED_MOVES(QUEUED_MOVE_NUM).swap = 1
        ` if isShift then QUEUED_MOVES(QUEUED_MOVE_NUM).swap = MOVE_SHIFT
        ` if swapVal >= 0 then QUEUED_MOVES(QUEUED_MOVE_NUM).moveBindingIndex = swapVal
        QUEUED_MOVE_NUM += 1
        COLLECTED_INPUT_MASK = frame number()
    endif

endfunction

global soap = 4



function addCoordinates(start as vec, dir as vec)
    target as vec = {
        x = start.x + dir.x, 
        y = start.y + dir.y
    }
    

    if isAbility_Wrap()

        if target.x >= CELL_COLUMN_COUNT
            target.x = target.x - CELL_COLUMN_COUNT
        endif
        if target.x < 0
            target.x = CELL_COLUMN_COUNT + target.x
        endif

        if target.y >= CELL_ROW_COUNT
            target.y = target.y - CELL_ROW_COUNT
        endif
        if target.y < 0
            target.y = CELL_ROW_COUNT + target.y
        endif

    endif

endfunction target


function getRandomValue()
    ` the kinds that only show up with their cards. see THE NEW KINDS OF FISH in fish_headers.
    ` one roll decides between the two of them, so that neither gets in ahead of the other
    newJellyChance = getJellyChance()
    newRayChance = getRayChance()
    if newJellyChance + newRayChance > 0
        newKindRoll = rnd(100)
        if newKindRoll < newJellyChance
            exitfunction TEX_JELLY
        endif
        if newKindRoll < newJellyChance + newRayChance
            exitfunction TEX_RAY
        endif
    endif

    if (isAbility_Crabs())
        if rnd(10) > 7 `a 20 % chance to spawn a crab.
            showPassiveUsed(ABILITY_INDEX_CRABS)
            exitfunction TEX_CRAB
        endif
    endif

    if (isAbility_BirdFeast())
        ` worm is the last texture, so ignoring it is simple.
        if (rnd(10) > 7) ` a 20% chance to not pick worm.
            showPassiveUsed(ABILITY_INDEX_BIRD_FEAST)
            exitfunction rnd(6) + 1
        endif
    endif

endfunction rnd(7)+1

function doBomb(start as vec, dir as vec)
    spawnCursorWake(start.x, start.y)
    target as vec = addCoordinates(start, dir)
    aIndex = getCellIndex(start)

    duration = 150

    startPosition as vec = {
        x = getCellX(start.x),
        y = getCellY(start.y)
    }
    endPosition as vec = {
        x = getCellX(target.x),
        y = getCellY(target.y)
    }
    ` start scale down tween.
    create basic tween TWEEN_SWAP_AX, startPosition.x, endPosition.x, duration, 0
    create basic tween TWEEN_SWAP_AY, startPosition.y, endPosition.y, duration, 0

    create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, CELL_SIZE * 1.5, 150, 50
    set tween type SELECTION_TWEEN_PUNCH_ID, 1

    ` the loops below wait on the tween of the last fish that the bomb reached. part of the bomb can be
    ` off of the board, so this is not always the last fish that the loops look at. the fish in the
    ` middle is always on the board, so there is always one.
    lastTweenId = cells(aIndex).shiftTweenId

    for x = -1 to 1
        for y = -1 to 1
            offset as vec = {
                x = x, 
                y = y
            }
            position as vec = addCoordinates(start, offset)
            if position.x >= 0 and position.x < CELL_COLUMN_COUNT
                if position.y >= 0 and position.y < CELL_ROW_COUNT
                    bIndex = getCellIndex(position)
                    cells(bIndex).value = cells(aIndex).value
                    ` the copy is a copy of the whole stack
                    copyCellStack(aIndex, bIndex)
                    lastTweenId = cells(bIndex).shiftTweenId
                    create basic tween lastTweenId, 1, 0, duration * .8, 0 `scale down.
                endif
            endif
        next
    next


    ` scale down all the sprites...
    while (is tween done(lastTweenId) < 1) 
        for x = -1 to 1
            for y = -1 to 1
                offset = {
                    x = x, 
                    y = y
                }
                position = addCoordinates(start, offset)
                
                if position.x >= 0 and position.x < CELL_COLUMN_COUNT
                    if position.y >= 0 and position.y < CELL_ROW_COUNT
                        bIndex = getCellIndex(position)
                        scaleVal = tweenVal(cells(bIndex).shiftTweenId)
                        scale sprite cells(bIndex).spriteId, scaleVal, scaleVal
                    endif
                endif
            next 
        next

        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)

        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        collectInput()
        updateBubbles()
        sync
    endwhile

    
    ` start scale up tween.
    for x = -1 to 1
        for y = -1 to 1
            offset = {
                x = x, 
                y = y
            }
            position = addCoordinates(start, offset)
            duration = 70
            if position.x >= 0 and position.x < CELL_COLUMN_COUNT
                if position.y >= 0 and position.y < CELL_ROW_COUNT
                    bIndex = getCellIndex(position)
                    updateCell(cells(bIndex))
                    lastTweenId = cells(bIndex).shiftTweenId
                    create basic tween lastTweenId, 0, 1, duration*.2, 0 `scale up.
                endif
            endif
        next
    next


    ` scale up all the sprites...
    while (is tween done(lastTweenId) < 1) 
        for x = -1 to 1
            for y = -1 to 1
                offset = {
                    x = x, 
                    y = y
                }
                position = addCoordinates(start, offset)
                
                if position.x >= 0 and position.x < CELL_COLUMN_COUNT
                    if position.y >= 0 and position.y < CELL_ROW_COUNT
                        bIndex = getCellIndex(position)
                        scaleVal = tweenVal(cells(bIndex).shiftTweenId)
                        scale sprite cells(bIndex).spriteId, scaleVal, scaleVal
                    endif
                endif
            next 
        next

        
        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)

        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        collectInput()
        updateBubbles()
        sync
    endwhile

    registerMove(1)
endfunction

function doLineOut(start as vec, dir as vec)
    spawnCursorWake(start.x, start.y)
    target as vec = addCoordinates(start, dir)
    aIndex = getCellIndex(start)

    duration = 150

    startPosition as vec = {
        x = getCellX(start.x),
        y = getCellY(start.y)
    }
    endPosition as vec = {
        x = getCellX(target.x),
        y = getCellY(target.y)
    }
    ` move selection sprite toward target
    create basic tween TWEEN_SWAP_AX, startPosition.x, endPosition.x, duration, 0
    create basic tween TWEEN_SWAP_AY, startPosition.y, endPosition.y, duration, 0

    create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, CELL_SIZE * 1.5, 150, 50
    set tween type SELECTION_TWEEN_PUNCH_ID, 1

    ` determine the line to blow up based on swap direction
    ` horizontal swap: blow up the entire row
    ` vertical swap: blow up the entire column
    if dir.x <> 0
        lineSize = CELL_COLUMN_COUNT
    else
        lineSize = CELL_ROW_COUNT
    endif

    position as vec
    for i = 0 to lineSize - 1
        if dir.x <> 0
            position = { x = i, y = start.y }
        else
            position = { x = start.x, y = i }
        endif
        bIndex = getCellIndex(position)
        cells(bIndex).value = cells(aIndex).value
        ` the copy is a copy of the whole stack
        copyCellStack(aIndex, bIndex)
        lastTweenId = cells(bIndex).shiftTweenId
        create basic tween lastTweenId, 1, 0, duration * .8, 0
    next

    ` scale down all the sprites in the line
    while (is tween done(lastTweenId) < 1)
        for i = 0 to lineSize - 1
            if dir.x <> 0
                position = { x = i, y = start.y }
            else
                position = { x = start.x, y = i }
            endif
            bIndex = getCellIndex(position)
            scaleVal = tweenVal(cells(bIndex).shiftTweenId)
            scale sprite cells(bIndex).spriteId, scaleVal, scaleVal
        next

        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)

        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        collectInput()
        updateBubbles()
        sync
    endwhile

    ` start scale up tween
    for i = 0 to lineSize - 1
        if dir.x <> 0
            position = { x = i, y = start.y }
        else
            position = { x = start.x, y = i }
        endif
        bIndex = getCellIndex(position)
        updateCell(cells(bIndex))
        lastTweenId = cells(bIndex).shiftTweenId
        create basic tween lastTweenId, 0, 1, duration * .2, 0
    next

    ` scale up all the sprites in the line
    while (is tween done(lastTweenId) < 1)
        for i = 0 to lineSize - 1
            if dir.x <> 0
                position = { x = i, y = start.y }
            else
                position = { x = start.x, y = i }
            endif
            bIndex = getCellIndex(position)
            scaleVal = tweenVal(cells(bIndex).shiftTweenId)
            scale sprite cells(bIndex).spriteId, scaleVal, scaleVal
        next

        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)

        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        collectInput()
        updateBubbles()
        sync
    endwhile

    registerMove(1)
endfunction

function doClone(start as vec, dir as vec)
    spawnCursorWake(start.x, start.y)
    target as vec = addCoordinates(start, dir)

    aIndex = getCellIndex(start)
    bIndex = getCellIndex(target)

    ` do a little fake animation thiny? 
    startPosition as vec = {
        x = getCellX(start.x),
        y = getCellY(start.y)
    }
    endPosition as vec = {
        x = getCellX(target.x),
        y = getCellY(target.y)
    }

    ` there are 4 tweens, 
    duration = 150
    
    ` this is the sprite moving into the slot. 
    create basic tween TWEEN_SWAP_AX, startPosition.x, endPosition.x, duration, 0
    create basic tween TWEEN_SWAP_AY, startPosition.y, endPosition.y, duration, 0

    ` this is the slotted sprite vanishing
    create basic tween TWEEN_SWAP_BX, 1, 0, duration * .25, 0

    ` this is the sprite re-appearing in the old slot. 
    create basic tween TWEEN_SWAP_BY, 0, 1, duration * .75, duration * .25 `it starts after the other one has finished. 

    create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, CELL_SIZE * 1.5, 150, 50
    set tween type SELECTION_TWEEN_PUNCH_ID, 1

    create basic tween SWAP_TWEEN_SFX, 0, 1, 150, 0
    set tween type SWAP_TWEEN_SFX, 1

    while (is tween done(TWEEN_SWAP_AX) < 1) or (is tween done(SELECTION_TWEEN_PUNCH_ID) < 1)

        position sprite cells(aIndex).spriteId, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
            ` position sprite cells(bIndex).spriteId, tweenVal(TWEEN_SWAP_BX), tweenVal(TWEEN_SWAP_BY)
        
        if (is tween done(TWEEN_SWAP_BX) < 1)
            scale sprite cells(bIndex).spriteId, tweenVal(TWEEN_SWAP_BX), tweenVal(TWEEN_SWAP_BX)
        else 
            position sprite cells(bIndex).spriteId, startPosition.x, startPosition.y
            set sprite texture cells(bIndex).spriteId, fishPicture(cells(aIndex).value, cells(aIndex).bellyUp)
            scale sprite cells(bIndex).spriteId, tweenVal(TWEEN_SWAP_BY), tweenVal(TWEEN_SWAP_BY)

        endif

        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)

        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        collectInput()
        updateBubbles()
        sync

    endwhile


    ` map the values of the cells to the new values 
    t = cells(bIndex).value
    cells(bIndex).value = cells(aIndex).value
    ` cells(aIndex).value = t

    ` the copy is a copy of the whole stack
    copyCellStack(aIndex, bIndex)

    updateCell(cells(aIndex))
    updateCell(cells(bIndex))

    registerMove(1)

endfunction


function doShift(start as vec, dir as vec)
    spawnCursorWake(start.x, start.y)
    target as vec = addCoordinates(start, dir)
    aIndex = getCellIndex(start)

    ` identify all sprites in row
    a as vec = {
        x = 0, 
        y = start.y
    }
    if dir.x = 0
        a.x = start.x
        a.y = 0
    endif


    ai = getCellIndex(a)
    startPosition as vec = {
        x = getCellX(start.x),
        y = getCellY(start.y)
    }
    endPosition as vec = {
        x = getCellX(target.x),
        y = getCellY(target.y)
    }
    duration = 150

    ` a row is as long as the number of columns, and a column is as long as the number of rows
    shiftSize = CELL_COLUMN_COUNT
    if (dir.x = 0)
        shiftSize = CELL_ROW_COUNT
    endif
    for i = 0 to shiftSize - 1
        
        if dir.x = 1
            index = ai + i
            startVal = getCellX(i)
            endVal = getCellX(i + 1)
            if i = shiftSize - 1 then endVal = getCellX(0)
        endif
 
        if dir.y = 1
            index = ai + (i * CELL_COLUMN_COUNT)
            startVal = getCellY(i)
            endVal = getCellY(i + 1)
            if i = shiftSize - 1 then endVal = getCellY(0)
        endif

        if dir.x = -1
            index = ai + i
            startVal = getCellX(i)
            endVal = getCellX(i - 1)
            if i = 0 then endVal = getCellX(CELL_COLUMN_COUNT - 1)
        endif

        if dir.y = -1
            index = ai + (i * CELL_COLUMN_COUNT)
            startVal = getCellY(i)
            endVal = getCellY(i - 1)
            if i = 0 then endVal = getCellY(CELL_ROW_COUNT - 1)
        endif

        cell = cells(index)
        create basic tween cell.shiftTweenId, startVal, endVal, duration, 0
    next 

    create basic tween TWEEN_SWAP_AX, startPosition.x, endPosition.x, duration, 0
    create basic tween TWEEN_SWAP_AY, startPosition.y, endPosition.y, duration, 0

    create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, CELL_SIZE * 1.5, duration, 50
    set tween type SELECTION_TWEEN_PUNCH_ID, 1

    create basic tween SWAP_TWEEN_SFX, 0, 1, duration, 0
    set tween type SWAP_TWEEN_SFX, 1

    while any tweens running(cells(ai).shiftTweenId)
        for i = 0 to shiftSize - 1
            index = ai + i

            if (dir.y <> 0)
                index = ai + i*CELL_COLUMN_COUNT
            endif

            cell = cells(index)

            if dir.y = 0
                position sprite cell.spriteId, tweenVal(cell.shiftTweenId), sprite y(cell.spriteId)
            else
                position sprite cell.spriteId, sprite x(cell.spriteId), tweenVal(cell.shiftTweenId)
            endif
            position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
            scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)

            set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)
        next
        updateBubbles()
        sync
    endwhile

    ` actually update the map
    
    ` the stacks move along with the fish. the one that falls off of the end comes back on at the start.
    temp = 0
    tempStack = 0
    tempShown# = 0
    tempBelly = 0
    tempBellyShown# = 0
    if (dir.x = 1)
        temp = cells(ai + (shiftSize - 1)).value
        tempStack = cells(ai + (shiftSize - 1)).stack
        tempShown# = cells(ai + (shiftSize - 1)).stackShown#
        tempBelly = cells(ai + (shiftSize - 1)).bellyUp
        tempBellyShown# = cells(ai + (shiftSize - 1)).bellyShown#
        for i = (shiftSize - 1) to 1 step -1
            index = ai + i
            cells(index).value = cells(index - 1).value
            copyCellStack(index - 1, index)
            updateCell(cells(index))
        next

        cells(ai).value = temp
        cells(ai).stack = tempStack
        cells(ai).stackShown# = tempShown#
        cells(ai).bellyUp = tempBelly
        cells(ai).bellyShown# = tempBellyShown#
        updateCell(cells(ai))
    endif

    if (dir.x = -1)
        temp = cells(ai).value
        tempStack = cells(ai).stack
        tempShown# = cells(ai).stackShown#
        tempBelly = cells(ai).bellyUp
        tempBellyShown# = cells(ai).bellyShown#
        for i = 0 to (shiftSize - 2)
            index = ai + i
            cells(index).value = cells(index + 1).value
            copyCellStack(index + 1, index)
            updateCell(cells(index))
        next

        cells(ai + shiftSize-1).value = temp
        cells(ai + shiftSize-1).stack = tempStack
        cells(ai + shiftSize-1).stackShown# = tempShown#
        cells(ai + shiftSize-1).bellyUp = tempBelly
        cells(ai + shiftSize-1).bellyShown# = tempBellyShown#
        updateCell(cells(ai + shiftSize-1))
    endif

    if (dir.y = 1)
        endIndex = ai + ((CELL_ROW_COUNT-1) * CELL_COLUMN_COUNT)
        temp = cells(endIndex).value
        tempStack = cells(endIndex).stack
        tempShown# = cells(endIndex).stackShown#
        tempBelly = cells(endIndex).bellyUp
        tempBellyShown# = cells(endIndex).bellyShown#
        for i = (shiftSize - 1) to 1 step -1

            index = ai + ((i) * CELL_COLUMN_COUNT)
            prevIndex = ai + ((i - 1) * CELL_COLUMN_COUNT)
            cells(index).value = cells(prevIndex).value
            copyCellStack(prevIndex, index)
            updateCell(cells(index))
        next

        cells(ai).value = temp
        cells(ai).stack = tempStack
        cells(ai).stackShown# = tempShown#
        cells(ai).bellyUp = tempBelly
        cells(ai).bellyShown# = tempBellyShown#
        updateCell(cells(ai))

        ` the fish from the row above came down to the bottom row
        fishHitBottom(endIndex, 0)
    endif

    if (dir.y = -1)
        endIndex = ai + ((CELL_ROW_COUNT-1) * CELL_COLUMN_COUNT)
        temp = cells(ai).value
        tempStack = cells(ai).stack
        tempShown# = cells(ai).stackShown#
        tempBelly = cells(ai).bellyUp
        tempBellyShown# = cells(ai).bellyShown#
        for i = 0 to (shiftSize - 2)

            index = ai + ((i) * CELL_COLUMN_COUNT)
            prevIndex = ai + ((i + 1) * CELL_COLUMN_COUNT)
            cells(index).value = cells(prevIndex).value
            copyCellStack(prevIndex, index)
            updateCell(cells(index))
        next

        cells(endIndex).value = temp
        cells(endIndex).stack = tempStack
        cells(endIndex).stackShown# = tempShown#
        cells(endIndex).bellyUp = tempBelly
        cells(endIndex).bellyShown# = tempBellyShown#
        updateCell(cells(endIndex))

        ` the fish from the top row came around to the bottom row
        fishHitBottom(endIndex, 0)
    endif

    registerMove(1)


endfunction

` LIVE MOVES. see the notes in fish_headers.

` is a combo busy with the fish in this cell? a swap cannot touch one that is.
function isCellLocked(index)
    locked = 0
    if COMBO_PHASE > 0
        ` a fish that is popping, or the empty spot that it left, or a new fish dropping into one
        if CELLS(index).comboBlownUp then locked = 1

        ` while the fish fall, the ones that have a gap under them are on the move
        if COMBO_PHASE = 2
            if CELLS(index).comboDownShift > 0 then locked = 1
        endif
    endif
endfunction locked

` start a swap from the cursor to the cell next to it, or only move the cursor there.
` this says 1 if it started. it does not start if it would leave the board, or if it is a swap that
` would touch a fish that a combo is busy with.
function startLiveMove(dirX, dirY, wantSwap)
    started = 0

    liveDir as vec = {
        x = dirX,
        y = dirY
    }
    liveTarget as vec = addCoordinates(SELECTION_POS, liveDir)

    allowed = 1
    if liveTarget.x < 0 then allowed = 0
    if liveTarget.x >= CELL_COLUMN_COUNT then allowed = 0
    if liveTarget.y < 0 then allowed = 0
    if liveTarget.y >= CELL_ROW_COUNT then allowed = 0

    if allowed
        aIndex = getCellIndex(SELECTION_POS)
        bIndex = getCellIndex(liveTarget)
        if wantSwap
            if isCellLocked(aIndex) then allowed = 0
            if isCellLocked(bIndex) then allowed = 0
        endif
    endif

    if allowed
        ` the cursor leaves a few bubbles behind
        spawnCursorWake(SELECTION_POS.x, SELECTION_POS.y)

        startX = getCellX(SELECTION_POS.x)
        startY = getCellY(SELECTION_POS.y)
        endX = getCellX(liveTarget.x)
        endY = getCellY(liveTarget.y)
        duration = LIVE_MOVE_TIME
        punchDelay = 50

        ` a move that comes right after another one has a softer punch. see LIVE_PUNCH_RAPID_GAP in fish_headers.
        livePunch# = 1.0
        liveNowMs# = game ms()
        liveSinceLast# = liveNowMs# - LIVE_MOVE_LAST_MS#
        LIVE_MOVE_LAST_MS# = liveNowMs#
        if liveSinceLast# < LIVE_PUNCH_CALM_GAP#
            livePunchOver# = liveSinceLast# - LIVE_PUNCH_RAPID_GAP#
            livePunchSpan# = LIVE_PUNCH_CALM_GAP# - LIVE_PUNCH_RAPID_GAP#
            livePunch# = livePunchOver# / livePunchSpan#
            if livePunch# < LIVE_PUNCH_SOFT# then livePunch# = LIVE_PUNCH_SOFT#
        endif

        ` the moves that are waiting behind this one hurry it along. this one is already off of the queue.
        ` the pace does not jump to what the queue asks for. it goes half of the way there on every move,
        ` so that a run of moves speeds up and slows down smoothly. see LIVE_MOVE_TIME in fish_headers.
        liveBacklog = QUEUED_MOVE_NUM - QUEUED_MOVE_TAIL
        liveInRun = 0
        if liveSinceLast# < LIVE_PUNCH_CALM_GAP# then liveInRun = 1
        if liveInRun = 0 then LIVE_MOVE_PACE = LIVE_MOVE_TIME `the run before this one is over
        if liveBacklog > 0 then liveInRun = 1
        if liveInRun
            livePaceWant = LIVE_MOVE_TIME / (1 + liveBacklog)
            if livePaceWant < LIVE_MOVE_MIN_TIME then livePaceWant = LIVE_MOVE_MIN_TIME
            LIVE_MOVE_PACE = (LIVE_MOVE_PACE + livePaceWant) / 2
            duration = LIVE_MOVE_PACE

            ` the punch does not lag behind a move that is part of a run
            punchDelay = 0

            ` and the quicker the move, the softer the punch gets
            liveDuration# = duration
            liveFullTime# = LIVE_MOVE_TIME
            liveSpeed# = liveDuration# / liveFullTime#
            if liveSpeed# < livePunch# then livePunch# = liveSpeed#
        else
            ` a move on its own starts a new run, at the usual pace
            LIVE_MOVE_PACE = LIVE_MOVE_TIME
        endif

        ` at its fullest, the cursor swells to one and a half times its size
        liveCell# = CELL_SIZE
        punchGrow# = liveCell# * livePunch# * 0.5
        punchSize# = liveCell# + punchGrow#

        ` the fish that the cursor is on goes along with it, and the other one comes back the other way
        create basic tween TWEEN_SWAP_AX, startX, endX, duration, 0
        create basic tween TWEEN_SWAP_AY, startY, endY, duration, 0
        create basic tween TWEEN_SWAP_BX, endX, startX, duration, 0
        create basic tween TWEEN_SWAP_BY, endY, startY, duration, 0

        ` the punch and the sound last as long as the move does
        create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, punchSize#, duration, punchDelay
        set tween type SELECTION_TWEEN_PUNCH_ID, 1

        create basic tween SWAP_TWEEN_SFX, 0, 1, duration, 0
        set tween type SWAP_TWEEN_SFX, 1

        LIVE_MOVE_ACTIVE = 1
        LIVE_MOVE_IS_SWAP = wantSwap
        LIVE_MOVE_FREE = 0 `startFreeMove sets this, after it has started the swap
        LIVE_MOVE_A = aIndex
        LIVE_MOVE_B = bIndex
        LIVE_MOVE_FROM_X = SELECTION_POS.x
        LIVE_MOVE_FROM_Y = SELECTION_POS.y
        LIVE_MOVE_TO_X = liveTarget.x
        LIVE_MOVE_TO_Y = liveTarget.y
        LIVE_MOVE_DIR_X = dirX
        LIVE_MOVE_DIR_Y = dirY
        started = 1

        ` a shake that was still going is over. the cursor is on its way somewhere now.
        CURSOR_SHAKING = 0
    else
        ` the move cannot be made, so the cursor shakes toward where it was asked to go
        CURSOR_SHAKING = 1
        CURSOR_SHAKE_DIR_X = dirX
        CURSOR_SHAKE_DIR_Y = dirY
        create basic tween CURSOR_SHAKE_TWEEN_ID, 1, 0, CURSOR_SHAKE_TIME, 0
    endif
endfunction started

` play the shake that the cursor does when a move cannot be made. this runs on every frame.
function stepCursorShake()
    if CURSOR_SHAKING
        ` a move that is playing out puts the cursor where it wants it
        if LIVE_MOVE_ACTIVE = 0
            cursorX = getCellX(SELECTION_POS.x)
            cursorY = getCellY(SELECTION_POS.y)

            if is tween done(CURSOR_SHAKE_TWEEN_ID) >= 1
                ` it is over, so the cursor goes back to exactly where it belongs
                CURSOR_SHAKING = 0
                position sprite SELECTION_SPRITE, cursorX, cursorY
            else
                ` it lunges the way that it was asked to go, and wobbles back as the shake dies away
                shakeNow# = sin(game ms() * .05) * CURSOR_SHAKE_SIZE * tweenVal(CURSOR_SHAKE_TWEEN_ID)
                position sprite SELECTION_SPRITE, cursorX + CURSOR_SHAKE_DIR_X * shakeNow#, cursorY + CURSOR_SHAKE_DIR_Y * shakeNow#
            endif
        endif
    endif
endfunction

` move the swap, or the cursor, that is playing out along by one frame. when it gets to the end, the two
` fish really do trade places, and the cursor really is on the new cell.
` this says 0 if nothing is playing, 1 if it still is, and 2 if it finished on this frame.
function stepLiveMove()
    result = 0
    if LIVE_MOVE_ACTIVE
        result = 1

        if LIVE_MOVE_IS_SWAP
            position sprite CELLS(LIVE_MOVE_A).spriteId, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
            position sprite CELLS(LIVE_MOVE_B).spriteId, tweenVal(TWEEN_SWAP_BX), tweenVal(TWEEN_SWAP_BY)
        endif

        position sprite SELECTION_SPRITE, tweenVal(TWEEN_SWAP_AX), tweenVal(TWEEN_SWAP_AY)
        scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)
        set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

        finished = 0
        if is tween done(TWEEN_SWAP_AX) >= 1
            if is tween done(SELECTION_TWEEN_PUNCH_ID) >= 1 then finished = 1
        endif

        if finished
            result = 2
            LIVE_MOVE_ACTIVE = 0

            if LIVE_MOVE_IS_SWAP
                t = CELLS(LIVE_MOVE_B).value
                CELLS(LIVE_MOVE_B).value = CELLS(LIVE_MOVE_A).value
                CELLS(LIVE_MOVE_A).value = t
                swapCellStacks(LIVE_MOVE_A, LIVE_MOVE_B)

                updateCell(CELLS(LIVE_MOVE_A))
                updateCell(CELLS(LIVE_MOVE_B))

                ` the groups of the two fish that a swap has moved can go through skeletons, when the board is looked at next. see SKELETONS in fish_headers.
                SKELETON_WILD_A = LIVE_MOVE_A
                SKELETON_WILD_B = LIVE_MOVE_B

                ` a fish that gets swapped down to the bottom row did not land there, so it gets no chance
                ` at a stack from the "bottom feeder" card

                ` the swap of the "free move" card is not counted as a move, and the multiplier does not
                ` care if it pops anything
                if LIVE_MOVE_FREE = 0
                    registerMove(1)

                    ` the multiplier wants to know if this swap pops anything
                    multiplierSwapMade()
                    CORAL_SWAP_A = LIVE_MOVE_A
                    CORAL_SWAP_B = LIVE_MOVE_B

                    ` and so does a hidden pattern that the cursor has just walked. see CORAL in fish_headers.
                    coralSwapStepped(LIVE_MOVE_FROM_X, LIVE_MOVE_FROM_Y, LIVE_MOVE_DIR_X, LIVE_MOVE_DIR_Y)
                else
                    coralTrailClear()
                endif

                ` a swap may turn a fish belly up, once the board has settled
                BELLY_UP_ROLL_DUE = 1

                ` and it sends out a shockwave from where it started, headed the way that it went
                spawnShockwaveToward(LIVE_MOVE_FROM_X, LIVE_MOVE_FROM_Y, LIVE_MOVE_DIR_X, LIVE_MOVE_DIR_Y, SHOCK_SWAP_STRENGTH#, 0, SHOCK_LIFE)
            else
                ` the cursor moved on its own, which may be a step of a hidden pattern. see CORAL in fish_headers.
                coralCursorStepped(LIVE_MOVE_FROM_X, LIVE_MOVE_FROM_Y, LIVE_MOVE_DIR_X, LIVE_MOVE_DIR_Y)
            endif

            SELECTION_POS.x = LIVE_MOVE_TO_X
            SELECTION_POS.y = LIVE_MOVE_TO_Y
            position sprite SELECTION_SPRITE, getCellX(SELECTION_POS.x), getCellY(SELECTION_POS.y)

            ` the cursor swelled up on the way, and it ends up exactly the size of a cell again
            scale sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE

            ` with the "bottoms up" card, a fish that is belly up pops when the cursor comes to it.
            ` not one that a combo is already busy with, though.
            if isCellLocked(LIVE_MOVE_B) = 0
                popBellyUpFish(LIVE_MOVE_B)
            endif

            ` the board may have a new combo on it now
            REQUEST_COMBO_CHECK = 1
        endif
    endif
endfunction result

` use the "free move" that is in the given slot. it is a swap like any other, except that it is not
` counted as a move, and the multiplier does not care if it pops anything.
` this says 1 if the swap started. if it could not, the move is not used up.
function startFreeMove(slot, dirX, dirY)
    freeStarted = startLiveMove(dirX, dirY, 1)
    if freeStarted
        LIVE_MOVE_FREE = 1

        ` it did not cost a move, so the other moves do not get any closer to being ready
        MOVE_ABILITY_BINDINGS(slot).movesLeft = MOVE_ABILITY_BINDINGS(slot).resetTimer
        set text MOVE_ABILITY_BINDINGS(slot).timerTextId, str$(MOVE_ABILITY_BINDINGS(slot).movesLeft)
        create basic tween MOVE_ABILITY_BINDINGS(slot).useShakeTweenId, 1, 0, 500, 0
    endif
endfunction freeStarted

` THE ROBOT. see the notes in fish_headers.

` how many fish of this kind are joined up with the one in this cell, counting it.
` every search has a stamp of its own, and a cell that already has the stamp has been counted. the
` stamp goes in comboFillId, which handle_combos wipes clean before it uses it for anything.
function robotGroupSize(index, value, stamp)
    total = 0
    if CELLS(index).comboFillId <> stamp
        if CELLS(index).value = value
            CELLS(index).comboFillId = stamp
            total = 1

            groupX = CELLS(index).coord.x
            groupY = CELLS(index).coord.y
            if groupX > 0
                total = total + robotGroupSize(index - 1, value, stamp)
            endif
            if groupX < CELL_COLUMN_COUNT - 1
                total = total + robotGroupSize(index + 1, value, stamp)
            endif
            if groupY > 0
                total = total + robotGroupSize(index - CELL_COLUMN_COUNT, value, stamp)
            endif
            if groupY < CELL_ROW_COUNT - 1
                total = total + robotGroupSize(index + CELL_COLUMN_COUNT, value, stamp)
            endif
        endif
    endif
endfunction total

` mark every fish that is joined up with the one in this cell as spoken for, so that a later swap of
` the robot's does not take one of them away again. the mark goes in comboFillMask, which handle_combos
` wipes clean too.
function robotClaimGroup(index, value)
    if CELLS(index).comboFillMask = 0
        if CELLS(index).value = value
            CELLS(index).comboFillMask = 1

            claimX = CELLS(index).coord.x
            claimY = CELLS(index).coord.y
            if claimX > 0
                robotClaimGroup(index - 1, value)
            endif
            if claimX < CELL_COLUMN_COUNT - 1
                robotClaimGroup(index + 1, value)
            endif
            if claimY > 0
                robotClaimGroup(index - CELL_COLUMN_COUNT, value)
            endif
            if claimY < CELL_ROW_COUNT - 1
                robotClaimGroup(index + CELL_COLUMN_COUNT, value)
            endif
        endif
    endif
endfunction

` how many fish would pop if the fish in these two cells traded places. 0 means that it is not a good swap.
function robotSwapScore(aIndex, bIndex, required)
    score = 0
    usable = 1
    if CELLS(aIndex).value = CELLS(bIndex).value then usable = 0
    if CELLS(aIndex).comboFillMask then usable = 0
    if CELLS(bIndex).comboFillMask then usable = 0

    ` a fish that is going to pop anyway, like a belly up one that the cursor came to, stays where it is
    if CELLS(aIndex).comboForce > 0 then usable = 0
    if CELLS(bIndex).comboForce > 0 then usable = 0

    if usable
        ` try it out, count, and put them back
        tryValue = CELLS(aIndex).value
        CELLS(aIndex).value = CELLS(bIndex).value
        CELLS(bIndex).value = tryValue

        ROBOT_STAMP = ROBOT_STAMP + 1
        sizeA = robotGroupSize(aIndex, CELLS(aIndex).value, ROBOT_STAMP)
        ROBOT_STAMP = ROBOT_STAMP + 1
        sizeB = robotGroupSize(bIndex, CELLS(bIndex).value, ROBOT_STAMP)
        if sizeA >= required then score = score + sizeA
        if sizeB >= required then score = score + sizeB

        tryValue = CELLS(aIndex).value
        CELLS(aIndex).value = CELLS(bIndex).value
        CELLS(bIndex).value = tryValue
    endif
endfunction score

` forget which fish are spoken for. handle_combos leaves marks of its own in comboFillMask, so the
` robot does this before it looks at anything.
function robotClearClaims()
    lastClaim = CELL_COUNT - 1
    for claimIndex = 0 to lastClaim
        CELLS(claimIndex).comboFillMask = 0
    next
endfunction

` if the fish in this cell is in a group that is big enough to pop, the group is spoken for
function robotClaimMade(index, required)
    ROBOT_STAMP = ROBOT_STAMP + 1
    madeSize = robotGroupSize(index, CELLS(index).value, ROBOT_STAMP)
    if madeSize >= required
        robotClaimGroup(index, CELLS(index).value)
    endif
endfunction

` the cursor goes from one spot on the screen to another
function robotHop(fromX, fromY, toX, toY)
    create basic tween TWEEN_SWAP_AX, 0, 1, ROBOT_HOP_TIME, 0
    while is tween done(TWEEN_SWAP_AX) < 1
        hop# = tweenVal(TWEEN_SWAP_AX)
        position sprite SELECTION_SPRITE, fromX + (toX - fromX) * hop#, fromY + (toY - fromY) * hop#
        collectInput()
        updateBubbles()
        sync
    endwhile
    position sprite SELECTION_SPRITE, toX, toY
endfunction

` how many cells the robot takes the cursor along, going this way from this cell. that is as far as
` the edge of the board. with the "seamless" card it goes around the edge and carries on, all the way
` back to the cell that it started on.
function robotStrides(start as vec, dir as vec)
    strides = 0
    if isAbility_Wrap()
        if dir.x <> 0 then strides = CELL_COLUMN_COUNT
        if dir.y <> 0 then strides = CELL_ROW_COUNT
    else
        if dir.x > 0 then strides = CELL_COLUMN_COUNT - 1 - start.x
        if dir.x < 0 then strides = start.x
        if dir.y > 0 then strides = CELL_ROW_COUNT - 1 - start.y
        if dir.y < 0 then strides = start.y
    endif
endfunction strides

` which column, and which row, the robot is in when it has gone this many cells. going off one edge
` of the board comes back on at the other.
function robotLineX(startX, dirX, strides)
    lineX = (startX + dirX * strides + CELL_COLUMN_COUNT) mod CELL_COLUMN_COUNT
endfunction lineX

function robotLineY(startY, dirY, strides)
    lineY = (startY + dirY * strides + CELL_ROW_COUNT) mod CELL_ROW_COUNT
endfunction lineY

` the robot takes the cursor in a straight line, the way that it was pointed, from the cell that it
` is on to the edge of the board. on every cell that it comes to, it makes the swaps that pop
` something, and when there are none left to make, it goes on to the next one. a swap takes the cursor
` along with it, and it comes back.
` the cursor ends up at the edge of the board. with the "seamless" card it goes around the edge
` instead, and ends up back where it started. process_input puts it there. see robotStrides.
` this stops the game until it has played out, the same as the other special moves do.
function doRobot(start as vec, dir as vec)
    required = getRequiredComboCount()
    robotClearClaims()
    spawnCursorWake(start.x, start.y)

    made = 0
    strideCount = robotStrides(start, dir)
    cursorX = getCellX(start.x)
    cursorY = getCellY(start.y)
    lastX = start.x
    lastY = start.y

    for robotStride = 0 to strideCount
        atX = robotLineX(start.x, dir.x, robotStride)
        atY = robotLineY(start.y, dir.y, robotStride)
        atIndex = atX + atY * CELL_COLUMN_COUNT
        hopX = getCellX(atX)
        hopY = getCellY(atY)

        if robotStride > 0
            ` going around the edge, the cursor does not slide back across the whole board. it is
            ` just there, on the other side.
            aroundEdge = 0
            lineJump = (atX - lastX) + (atY - lastY)
            if lineJump > 1 then aroundEdge = 1
            if lineJump < -1 then aroundEdge = 1
            if aroundEdge
                position sprite SELECTION_SPRITE, hopX, hopY
            else
                robotHop(cursorX, cursorY, hopX, hopY)
            endif
            cursorX = hopX
            cursorY = hopY
            lastX = atX
            lastY = atY

            ` it leaves bubbles on every cell that it comes to, so that the way it went can be seen
            spawnCursorWake(atX, atY)

            ` with the "bottoms up" card, a fish that is belly up pops when the cursor comes to it
            popBellyUpFish(atIndex)
        endif

        searching = 1
        while searching
            ` of the fish next to this one, find the one to swap with that would pop the most
            bestScore = 0
            bestB = 0
            for ringSide = 0 to 3
                sideX = atX
                sideY = atY
                if ringSide = 0 then sideX = atX + 1
                if ringSide = 1 then sideY = atY + 1
                if ringSide = 2 then sideX = atX - 1
                if ringSide = 3 then sideY = atY - 1

                sideOnBoard = 1
                if sideX < 0 then sideOnBoard = 0
                if sideY < 0 then sideOnBoard = 0
                if sideX >= CELL_COLUMN_COUNT then sideOnBoard = 0
                if sideY >= CELL_ROW_COUNT then sideOnBoard = 0

                if sideOnBoard
                    sideIndex = sideX + sideY * CELL_COLUMN_COUNT
                    sideScore = robotSwapScore(atIndex, sideIndex, required)
                    if sideScore > bestScore
                        bestScore = sideScore
                        bestB = sideIndex
                    endif
                endif
            next

            if bestScore = 0
                ` there is nothing left to do here, so it goes on
                searching = 0
            else
                made = made + 1

                ` the two fish trade places, and the cursor rides along with the first one
                toX = getCellX(CELLS(bestB).coord.x)
                toY = getCellY(CELLS(bestB).coord.y)

                create basic tween TWEEN_SWAP_BX, 0, 1, ROBOT_SWAP_TIME, 0
                create basic tween SELECTION_TWEEN_PUNCH_ID, CELL_SIZE, CELL_SIZE * 1.5, ROBOT_SWAP_TIME, 0
                set tween type SELECTION_TWEEN_PUNCH_ID, 1
                create basic tween SWAP_TWEEN_SFX, 0, 1, ROBOT_SWAP_TIME, 0
                set tween type SWAP_TWEEN_SFX, 1

                while is tween done(TWEEN_SWAP_BX) < 1
                    slide# = tweenVal(TWEEN_SWAP_BX)
                    position sprite CELLS(atIndex).spriteId, hopX + (toX - hopX) * slide#, hopY + (toY - hopY) * slide#
                    position sprite CELLS(bestB).spriteId, toX + (hopX - toX) * slide#, toY + (hopY - toY) * slide#
                    position sprite SELECTION_SPRITE, hopX + (toX - hopX) * slide#, hopY + (toY - hopY) * slide#
                    scale sprite SELECTION_SPRITE, tweenVal(SELECTION_TWEEN_PUNCH_ID), tweenVal(SELECTION_TWEEN_PUNCH_ID)
                    set sfx volume SFX_SWAP, tweenVal(SWAP_TWEEN_SFX)

                    collectInput()
                    updateBubbles()
                    sync
                endwhile
                scale sprite SELECTION_SPRITE, CELL_SIZE, CELL_SIZE
                set sfx volume SFX_SWAP, 0

                ` they really do trade places now
                tradeValue = CELLS(bestB).value
                CELLS(bestB).value = CELLS(atIndex).value
                CELLS(atIndex).value = tradeValue
                swapCellStacks(atIndex, bestB)
                updateCell(CELLS(atIndex))
                updateCell(CELLS(bestB))

                ` the groups that it made are spoken for, so that the next swap leaves them alone
                robotClaimMade(atIndex, required)
                robotClaimMade(bestB, required)

                ` a few bubbles on both fish, so that each swap gets noticed
                spawnBubbles(hopX, hopY, CELL_SIZE / 4, 4, 0, rgb(255, 255, 255))
                spawnBubbles(toX, toY, CELL_SIZE / 4, 4, 0, rgb(255, 255, 255))

                ` and the cursor comes back to its line
                robotHop(toX, toY, hopX, hopY)
            endif
        endwhile
    next

    ` all of it counts as one move, even when it found no swap to make
    ROBOT_LAST_COUNT = made
    registerMove(1)
endfunction

` KNOWN FILL. see the notes in fish_headers.

` swap the fish under the cursor with the one next to it. if that pops anything, the new fish that
` drop in are all the kind that was moved. handle_combos does that part.
` this stops the game until it has played out, the same as the other special moves do.
function doKnownFill(start as vec, dir as vec)
    target as vec = addCoordinates(start, dir)
    movedValue = CELLS(getCellIndex(start)).value

    playSpecialSwap(start, target)

    ` a bottle is never copied. process_input turns the move down when the swap has a bottle in it,
    ` so this only matters to something that calls this directly.
    KNOWN_FILL_VALUE = movedValue
    if movedValue = TEX_BOTTLE then KNOWN_FILL_VALUE = 0

    registerMove(1)
endfunction

` THE FIRST DIVE. the very first game brings its pieces in one at a time, and a piece does not count
` anything until it is there. see fish_routines_intro.

` 1 while the count of moves and the multiplier are not on the screen yet
function tutorialMovesOff()
    isOff = 0
    if TUTORIAL_STAGE > 0 and TUTORIAL_STAGE < 4 then isOff = 1
endfunction isOff

` 1 while the bar of the round is not on the screen yet, or the fish that brought it in are still popping
function tutorialScoreOff()
    isOff = 0
    if TUTORIAL_STAGE > 0 then isOff = 1
    if TUTORIAL_SCORE_HOLD then isOff = 1
endfunction isOff

function registerMove(delta)
    ` the very first game does not count moves until the count is on the screen
    if tutorialMovesOff() then exitfunction

    ` register the move against the score
    CURRENT_MOVE_COUNT = CURRENT_MOVE_COUNT + delta
    set text MOVE_COUNT_TEXT_ID, str$(CURRENT_MOVE_COUNT)
endfunction