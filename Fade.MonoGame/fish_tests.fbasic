    HUD_KEEP# = 0
    applyHudFade()
    FISH_AWAY = 1

    ` a new game puts all of it back
    resetCoral()
    tBack = 0
    if HUD_KEEP# = 1 then tBack = 1
    assert tBack = 1, "the things around the board are all there again"
    assert FISH_AWAY = 0, "and the fish are not away"
    end
endtest

test fish_come_home_when_the_game_is_carried_on from fishBoard
    ` the fish have gone, the way that they do when a game is won
    tSprite = CELLS(testIndex(2, 3)).spriteId
    position sprite tSprite, WORLD_WIDTH + 200, 40
    FISH_AWAY = 1

    fishComeHome()
    assert FISH_AWAY = 0, "the fish are not away any more"
    assert sprite x(tSprite) = getCellX(2), "a fish is back in its column"
    assert sprite y(tSprite) = getCellY(3), "and in its row"

    ` and when they never left, nothing is moved
    position sprite tSprite, 7, 9
    fishComeHome()
    assert sprite x(tSprite) = 7, "a fish that did not go anywhere is left where it is"
    end
endtest

test show_time_makes_the_next_two_hints_the_easy_kind from fishBoard
    assert CARDS(ABILITY_INDEX_SHOW_TIME).abilityType = ABILITY_TYPE_INSTANT, "show time is an instant"
    assert CORAL_SHOW_TIME_LEFT = 0, "nothing is owed to start with"

    ` taking the card
    takeShowTime()
    assert CORAL_SHOW_TIME_LEFT = SHOW_TIME_HINTS, "taking it owes two easy hints"

    ` a hint is owed, for a big group, and the board has settled. three times over.
    coralClearHint()
    CORAL_HINT_AS_LISTEN = 0
    CORAL_HINT_DUE = 1
    REQUEST_COMBO_CHECK = 0
    coralRollHint()
    assert CORAL_HINT_START_MS >= 0, "a hint started"
    assert CORAL_HINT_AS_LISTEN = 1, "and it is drawn the way that the listen card draws one"
    assert CORAL_HINT_TRAIL_ON = 1, "with the trail"
    assert CORAL_SHOW_TIME_LEFT = 1, "that was the first of the two"

    coralClearHint()
    CORAL_HINT_AS_LISTEN = 0
    CORAL_HINT_DUE = 1
    coralRollHint()
    assert CORAL_HINT_AS_LISTEN = 1, "the second one is the easy kind too"
    assert CORAL_SHOW_TIME_LEFT = 0, "and that is both of them"

    coralClearHint()
    CORAL_HINT_AS_LISTEN = 0
    CORAL_HINT_DUE = 1
    coralRollHint()
    assert CORAL_HINT_START_MS >= 0, "the third hint starts like any other"
    assert CORAL_HINT_AS_LISTEN = 0, "but it is back to the usual kind"
    end
endtest

test coral_cast_overwrites_the_kind_of_the_coral_it_crosses from fishBoard
