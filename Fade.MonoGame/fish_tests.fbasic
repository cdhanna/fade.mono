    assert CELLS(testIndex(5, 4)).comboForce = 0, "and neither is the belly up fish next to it"
    assert REQUEST_COMBO_CHECK = 0, "nothing asks for a look at the board"

    popBellyUpFish(testIndex(5, 4))
    assert CELLS(testIndex(5, 4)).comboForce = 1, "the belly up fish pops when it is touched"
    assert CELLS(testIndex(4, 4)).comboForce = 0, "and it does not take the skeleton with it"
    assert countBellyUpFish() = 2, "but the waste bucket counts them both"
    end
endtest

test walking_a_used_pattern_shakes_its_song from fishBoard
    ` up, left, up has been cast already, and none of the patterns that are out is anything like it
    CORAL_SEQ_LENGTH(0) = 0
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    CORAL_USED(0) = 76
    CORAL_USED(1) = 85
    CORAL_USED_COUNT = 2
    coralRunesRefresh()
    assert CORAL_RUNE_SHAKE_MS(0) < 0, "nothing is shaking to start with"

    ` some other walk does nothing
    coralTrailClear()
    coralCursorStepped(4, 6, 1, 0)
    coralCursorStepped(5, 6, 1, 0)
    coralCursorStepped(6, 6, 0, -1)
    coralSwapMade(6, 5)
    assert CORAL_RUNE_SHAKE_MS(0) < 0, "a walk that is not a used pattern shakes nothing"

    ` the used one, walked from the far end: down, right, down
    coralCursorStepped(3, 4, 0, 1)
    coralCursorStepped(3, 5, 1, 0)
    coralCursorStepped(4, 5, 0, 1)
    coralSwapMade(4, 6)
    assert CORAL_RUNE_SHAKE_MS(0) >= 0, "the song of the pattern that was walked again shakes"
    assert CORAL_RUNE_SHAKE_MS(1) < 0, "and the other song does not"
    assert CORAL_COUNT = 0, "no coral grows from a pattern that is used up"
    assert CORAL_PENDING_SLOT = -1, "and nothing is waiting on the swap"
    end
endtest

test things_around_the_board_come_back_for_a_new_game from fishBoard
