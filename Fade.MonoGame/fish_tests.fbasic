    end
endtest

test coral_quick_song_takes_away_the_opening_swap from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)
    CARDS(ABILITY_INDEX_QUICK_SONG).obtained = 1

    ` right, down, and then up, left, up
    coralCursorStepped(3, 5, 1, 0)
    coralCursorStepped(4, 5, 0, 1)
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    coralSwapMade(3, 4)
    CARDS(ABILITY_INDEX_QUICK_SONG).obtained = 0

    assert CORAL_PENDING_SLOT = 0, "with the card, the steps before the pattern do not matter"
    assert CORAL_PENDING_COUNT = 4, "and only the cells of the pattern are walked over"
    assert CORAL_PENDING_X(0) = 4, "starting from where the pattern did"
    assert CORAL_PENDING_Y(0) = 6, "and not from where the cursor first moved"
    end
endtest

test coral_a_special_move_is_not_an_opening_swap from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    coralTrailClear()
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    coralSwapMade(3, 4)

    assert CORAL_PENDING_SLOT < 0, "the pattern after a special move is not between two swaps"
    end
endtest

test coral_easy_song_casts_on_the_last_step from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` a long walk first, which would spoil it without the move
    coralCursorStepped(3, 5, 1, 0)
    coralCursorStepped(4, 5, 0, 1)

    coralOpenSong()
    assert CORAL_OPEN = 1, "the move opens a song"
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    assert CORAL_OPEN = 1, "it stays open while the steps are the steps of a pattern"
    assert CORAL_COUNT = 0, "and nothing grows until the last one"
    coralCursorStepped(3, 5, 0, -1)

    assert CORAL_OPEN = 0, "the last step closes it"
    assert CORAL_COUNT = 4, "and coral grew on the four cells, with no swap at all"
    assert CORAL_CELLS(testIndex(4, 6)) = 1, "from where the song was opened"
    assert CORAL_CELLS(testIndex(3, 4)) = 1, "to where the cursor ended up"
    assert CORAL_CASTS = 1, "the pattern is cast"
    end
endtest

test coral_easy_song_is_lost_on_a_wrong_step from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    coralOpenSong()
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, 1, 0)
    assert CORAL_OPEN = 0, "a step that is not of any pattern loses the song"

    ` and the pattern after that is not between two swaps
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    assert CORAL_COUNT = 0, "walking it now does nothing"
    coralSwapMade(3, 4)
    assert CORAL_PENDING_SLOT < 0, "and neither does a swap at the end of it"
    end
endtest

test coral_easy_song_walks_a_pattern_from_the_far_end from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` up, left, up is down, right, down from the far end
    coralOpenSong()
    coralCursorStepped(3, 4, 0, 1)
    assert CORAL_OPEN = 1, "the first step from the far end keeps it open"
    coralCursorStepped(3, 5, 1, 0)
    coralCursorStepped(4, 5, 0, 1)
    assert CORAL_COUNT = 4, "and the whole of it from the far end casts it"
    end
endtest

test coral_first_patterns_are_short_and_double_back from fishBoard
    resetCoral()
    for tSlot = 0 to CORAL_LIVE_COUNT - 1
        tLength = coralTryFromCode(CORAL_SEQ_CODE(tSlot))
        assert tLength = 3, "the first patterns of a game have three steps"
        assert coralTryDoublesBack(tLength) = 1, "and each one doubles back on itself"
    next

    CORAL_TRY_STEPS(0) = CORAL_UP
    CORAL_TRY_STEPS(1) = CORAL_LEFT
    CORAL_TRY_STEPS(2) = CORAL_UP
    assert coralTryDoublesBack(3) = 0, "a staircase does not"
    CORAL_TRY_STEPS(2) = CORAL_DOWN
    assert coralTryDoublesBack(3) = 1, "and a hook does"
    end
endtest

test coral_patterns_are_all_different from fishBoard
    ` with the dice stuck, the patterns have to be found by going through them in order
    mock rnd
    endmock 0

    ` this is about having more than one pattern out, which the game can still do
    CORAL_LIVE_COUNT = 3
    resetCoral()

    assert CORAL_SEQ_LENGTH(0) = CORAL_FIRST_LENGTH, "the first patterns are short"
    assert CORAL_SEQ_LENGTH(1) = CORAL_FIRST_LENGTH, "all of them"
    assert CORAL_SEQ_LENGTH(2) = CORAL_FIRST_LENGTH, "that are out"
    assert CORAL_SEQ_CODE(0) <> CORAL_SEQ_CODE(1), "and no two are the same"
    assert CORAL_SEQ_CODE(1) <> CORAL_SEQ_CODE(2), "whichever two"
    assert CORAL_SEQ_CODE(0) <> CORAL_SEQ_CODE(2), "they are"

    ` cast the first one. the stuck dice only ever roll that same pattern again.
    tCastCode = CORAL_SEQ_CODE(0)
    CORAL_PENDING_SLOT = 0
    CORAL_PENDING_COUNT = 0
    judgeCoralCast(1)

    assert CORAL_USED(0) = tCastCode, "the pattern that was cast is written down"
    assert CORAL_SEQ_LENGTH(0) > 0, "and a new one took its place"
    assert CORAL_SEQ_CODE(0) <> tCastCode, "which is not the one that was cast"
    assert CORAL_SEQ_CODE(1) <> tCastCode, "and neither is"
    assert CORAL_SEQ_CODE(2) <> tCastCode, "any other"
    CORAL_LIVE_COUNT = 1
    end
endtest

test coral_group_that_sings_is_a_good_swap_for_the_multiplier from fishBoard
    SCORE_MULTIPLIER = 3
    CORAL_CELLS(testIndex(2, 0)) = 1
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 1, 6)
    testCursor(2, 1)
    testQueueMove(0, -1, 1, -1)

    runto _combos_judged

    assert totalComboCount = 1, "the swap made a group of three, and the one on coral sings"
    assert testPopCount() = 2, "the other two pop"
    assert CURRENT_MOVE_COUNT = 1, "it was a move"
    assert SCORE_MULTIPLIER >= 3, "and a good one, so the multiplier is not taken down"
    end
endtest

test coral_group_from_before_does_not_spare_the_multiplier from fishBoard
    ` three in a row that are already sitting there on coral, and have sung
    SCORE_MULTIPLIER = 3
    for tColumn = 0 to 2
        CORAL_CELLS(testIndex(tColumn, 0)) = 1
        testPut(tColumn, 0, 6)
        CORAL_SUNG(testIndex(tColumn, 0)) = 6
    next

    ` and a swap somewhere else that makes nothing
    testCursor(4, 4)
    testQueueMove(1, 0, 1, -1)

    runto _combos_judged

    assert totalComboCount = 0, "nothing popped, and nothing sang"
    assert SCORE_MULTIPLIER = 2, "and the swap did not make the group, so it costs the multiplier as usual"
    end
endtest

test coral_fish_that_have_sung_can_not_be_moved_around_to_sing_again from fishBoard
    ` a square of coral, two by two, with three fish in it that have sung already. any three cells
    ` of the square are a group, so moving one of the fish to the empty corner makes a group again.
    SCORE_MULTIPLIER = 3
    CORAL_CELLS(testIndex(0, 0)) = 1
    CORAL_CELLS(testIndex(1, 0)) = 1
    CORAL_CELLS(testIndex(0, 1)) = 1
    CORAL_CELLS(testIndex(1, 1)) = 1
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(0, 1, 6)
    CORAL_SUNG(testIndex(0, 0)) = 6
    CORAL_SUNG(testIndex(1, 0)) = 6
    CORAL_SUNG(testIndex(0, 1)) = 6

    testCursor(1, 0)
    testQueueMove(0, 1, 1, -1)

    runto _combos_judged

    assert CELLS(testIndex(1, 1)).value = 6, "the fish was moved to the empty corner"
    assert CORAL_SUNG(testIndex(1, 1)) = 6, "and it has still sung"
    assert totalComboCount = 0, "so nothing sang"
    assert CURRENT_SCORE = 0, "and nothing was scored"
    assert CORAL_HELD_GROUPS = 1, "the swap did put a group together"
    assert SCORE_MULTIPLIER = 3, "so the multiplier does not hold it against the player"
    end
endtest

test coral_works_in_a_zen_game from fishBoard
    ` a zen game has the one passive, which lets the cursor go around the edges of the board
    GAME_ZEN = 1
    grantPassive(ABILITY_INDEX_WRAP)
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` the step to the left goes around the edge, and the swap at the end makes three in a row
    tLastColumn = CELL_COLUMN_COUNT - 1
    testPut(tLastColumn - 2, 3, 6)
    testPut(tLastColumn - 1, 3, 6)
    testPut(tLastColumn, 4, 6)
    testCursor(0, 6)
    testQueueMove(0, -1, 0, -1)
    testQueueMove(-1, 0, 0, -1)
    testQueueMove(0, -1, 0, -1)
    testQueueMove(0, -1, 1, -1)

    runto _combos_judged
    runto _combos_judged
    runto _combos_judged
    runto _combos_judged

    assert totalComboCount = 1, "the swap popped something"
    assert CORAL_COUNT = 4, "and the pattern was cast"
    assert CORAL_CELLS(testIndex(0, 6)) = 1, "where the walk started"
    assert CORAL_CELLS(testIndex(0, 5)) = 1, "and on the left edge"
    assert CORAL_CELLS(testIndex(tLastColumn, 5)) = 1, "and on the right edge, where the step around came out"
    assert CORAL_CELLS(testIndex(tLastColumn, 4)) = 1, "and where it ended"
    end
endtest

test coral_hint_lays_the_pattern_on_the_board from fishBoard
    ` with the dice stuck, the pattern goes as far up and to the left as it fits
    mock rnd
    endmock 0
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    tMade = coralStartHint(0)

    assert tMade = 1, "the hint was started"
    assert CORAL_HINT_START_MS >= 0, "and it is playing"
    assert CORAL_HINT_COUNT = 4, "it goes over the four cells of the pattern"
    assert CORAL_HINT_X(0) = 1, "from the cell that the walk starts on"
    assert CORAL_HINT_Y(0) = 2, "which is two rows down, so that the rest fits above it"
    assert CORAL_HINT_X(1) = 1, "then the one above that"
    assert CORAL_HINT_Y(1) = 1, "one row up"
    assert CORAL_HINT_X(2) = 0, "then the one to the left of that"
    assert CORAL_HINT_Y(2) = 1, "in the same row"
    assert CORAL_HINT_X(3) = 0, "and it ends on the one above that"
    assert CORAL_HINT_Y(3) = 0, "in the top row"

    ` it sets out from the first cell, and it is on the next one a step later, and in between the two halfway
    tColumn0# = getCellX(0)
    tColumn1# = getCellX(1)
    tRow0# = getCellY(0)
    tRow1# = getCellY(1)
    tRow2# = getCellY(2)
    coralHintPointAt(0)
    assert CORAL_HINT_POINT_X# = tColumn1#, "it starts on the first cell"
    assert CORAL_HINT_POINT_Y# = tRow2#, "of the walk"
    coralHintPointAt(CORAL_HINT_STEP_MS)
    assert CORAL_HINT_POINT_Y# = tRow1#, "a step later it is on the second"
    coralHintPointAt(CORAL_HINT_STEP_MS / 2)
    tBetween = 0
    if CORAL_HINT_POINT_Y# < tRow2#
        if CORAL_HINT_POINT_Y# > tRow1#
            tBetween = 1
        endif
    endif
    assert tBetween = 1, "and halfway there it is in between the two"
    coralHintPointAt(CORAL_HINT_STEP_MS * 50)
    assert CORAL_HINT_POINT_X# = tColumn0#, "and it stops on the last cell"
    assert CORAL_HINT_POINT_Y# = tRow0#, "however long it has been"

    ` and it plays out on the screen without anything going wrong
    runto _loop
    runto _loop
    tShowing = 0
    if CORAL_HINT_POWER# > 0
        tShowing = 1
    endif
    assert tShowing = 1, "it is showing"
    end
endtest

test coral_pattern_can_be_walked_from_the_far_end from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` up, left, up from the far end is down, right, down
    coralCursorStepped(3, 4, 0, 1)
    coralCursorStepped(3, 5, 1, 0)
    coralCursorStepped(4, 5, 0, 1)
    coralSwapMade(4, 6)

    assert CORAL_PENDING_SLOT = 0, "the pattern was walked, from its other end"
    assert CORAL_PENDING_COUNT = 4, "over the same four cells"
    assert CORAL_PENDING_X(0) = 3, "starting from where the pattern ends"
    assert CORAL_PENDING_Y(0) = 4, "when it is walked the usual way"
    end
endtest

test coral_turned_around_steps_are_not_the_pattern from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` down, left, down has every step turned around, but not the order. it is a different shape.
    coralCursorStepped(4, 4, 0, 1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, 1)
    coralSwapMade(3, 6)

    assert CORAL_PENDING_SLOT = -1, "turning the steps around without walking them backwards is not the pattern"
    end
endtest

test coral_same_pattern_from_the_far_end_is_not_a_new_one from fishBoard
    ` this is about a pattern that does not double back, so that rule is put aside
    CORAL_DOUBLE_BACK = 0

    ` down, right, down is up, left, up from the far end
    CORAL_TRY_STEPS(0) = CORAL_DOWN
    CORAL_TRY_STEPS(1) = CORAL_RIGHT
    CORAL_TRY_STEPS(2) = CORAL_DOWN

    CORAL_SEQ_LENGTH(0) = 0
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    assert coralTryIsGood(3) = 1, "with nothing else out, it is a fine pattern"

    coralSetSequence(0, 76)
    CORAL_TRY_STEPS(0) = CORAL_DOWN
    CORAL_TRY_STEPS(1) = CORAL_RIGHT
    CORAL_TRY_STEPS(2) = CORAL_DOWN
    assert coralTryIsGood(3) = 0, "but not while the same pattern is out"

    CORAL_SEQ_LENGTH(0) = 0
    CORAL_USED(0) = 76
    CORAL_USED_COUNT = 1
    assert coralTryIsGood(3) = 0, "and not once the same pattern has been cast"
    CORAL_DOUBLE_BACK = 1
    end
endtest

test coral_big_group_brings_a_hint from fishBoard
    for tColumn = 0 to 4
        testPut(tColumn, 0, 6)
    next

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert CORAL_HINT_DUE = 1, "five fish popping means that a hint is owed"

    ` no wave of the current is setting out, so the only hint that can start is the one that is owed
    mock rnd
    endmock 0
    coralClearHint()
    CORAL_HINT_ROLLED = coralWaveNow()

    coralRollHint()
    assert CORAL_HINT_START_MS = -1, "it waits while the fish are still popping"

    REQUEST_COMBO_CHECK = 0
    coralRollHint()
    assert CORAL_HINT_START_MS >= 0, "and it starts as soon as the board has settled"
    assert CORAL_HINT_DUE = 0, "and then it is not owed any more"
    end
endtest

test coral_small_group_does_not_bring_a_hint from fishBoard
    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    testPut(3, 0, 6)

    REQUEST_COMBO_CHECK = 1
    runto _combos_judged

    assert totalComboCount = 1, "four fish popped"
    assert CORAL_HINT_DUE = 0, "but that is not a big enough group to bring a hint"
    end
endtest

test coral_only_the_last_songs_are_kept from fishBoard
    ` cast one more pattern than there is room to remember
    tFirstCode = CORAL_SEQ_CODE(0)
    tLastCode = 0
    for tCast = 0 to CORAL_USED_MAX
        tLastCode = CORAL_SEQ_CODE(0)
        CORAL_PENDING_SLOT = 0
        CORAL_PENDING_COUNT = 0
        judgeCoralCast(1)
    next

    assert CORAL_CASTS = CORAL_USED_MAX + 1, "every one of them was cast"
    assert CORAL_USED_COUNT = CORAL_USED_MAX, "but only so many are remembered"
    assert CORAL_USED(CORAL_USED_MAX - 1) = tLastCode, "the one that was cast last is at the end"

    tStillThere = 0
    for tSong = 0 to CORAL_USED_MAX - 1
        if CORAL_USED(tSong) = tFirstCode
            tStillThere = 1
        endif
    next
    assert tStillThere = 0, "and the one that was cast first has been forgotten, so it can be given out again"
    assert CORAL_RUNE_SHOWN(0) > 0, "every one that is remembered has a song drawn for it"
    assert INFOS(INFO_INDEX_SONGS).enabled = 1, "and info mode explains the songs now that there are some"
    end
endtest

test coral_songs_are_not_explained_before_there_are_any from fishBoard
    assert CORAL_USED_COUNT = 0, "nothing has been cast"
    assert INFOS(INFO_INDEX_SONGS).enabled = 0, "so info mode has nothing to say about songs"
    assert INFOS(INFO_INDEX_SONGS).title$ = "Songs", "it will call them songs when it does"
    end
endtest

test listen_makes_a_hint_easier_to_see from fishBoard
    mock rnd
    endmock 0
    assert isAbility_Listen() = 0, "the card is not owned to start with"

    ` without the card
    coralClearHint()
    tMade = coralStartHint(0)
    runto _loop
    runto _loop
    tPlain# = CORAL_HINT_GLOW_REACH#
    tPlainOn = 0
    if CORAL_HINT_LISTEN# > 0
        tPlainOn = 1
    endif
    assert tPlainOn = 0, "the specks are not told about a card that is not owned"

    ` and with it
    grantPassive(ABILITY_INDEX_LISTEN)
    assert isAbility_Listen() = 1, "now it is owned"
    coralClearHint()
    tMade = coralStartHint(0)
    runto _loop
    runto _loop

    tListenOn = 0
    if CORAL_HINT_LISTEN# > 0
        tListenOn = 1
    endif
    tFurther = 0
    if CORAL_HINT_GLOW_REACH# > tPlain#
        tFurther = 1
    endif
    tBrighter = 0
    if CORAL_HINT_GLOW_POWER# > CORAL_HINT_POWER#
        tBrighter = 1
    endif
    assert tListenOn = 1, "the specks are told about the card"
    assert tFurther = 1, "they glow further out from the hint"
    assert tBrighter = 1, "and brighter"
    end
endtest

` THE TWO ENDINGS. these only look at which ending is due. playing one out waits on the player.

test ending_enough_coral_saves_the_reef from fishBoard
    tNeed = coralEndNeed()
    tNeedShare = tNeed * 100
    tBoardShare = CELL_COUNT * CORAL_END_SHARE
    assert tNeedShare >= tBoardShare, "the share of the board that an ending needs, in whole cells"
    assert tNeed < CELL_COUNT, "which is not the whole board"

    for tCell = 0 to tNeed - 2
        CORAL_CELLS(tCell) = 1
    next
    coralRecount()
    assert CORAL_ENDING_DUE = 0, "one cell short is not an ending"
    assert coralBarFill(0) < 1000, "and the bar of the reef is not full"

    CORAL_CELLS(tNeed - 1) = 1
    coralRecount()
    assert CORAL_ENDING_DUE = CORAL_ENDING_REEF, "enough coral saves the reef"
    assert coralBarFill(0) = 1000, "and its bar is full"
    assert coralBarFill(1) = 0, "the bar of the ancient one has nothing in it"
    end
endtest

test ending_enough_horror_coral_summons_the_ancient_one from fishBoard
    tNeed = coralEndNeed()
    for tCell = 0 to tNeed - 2
        CORAL_CELLS(tCell) = 1
        CORAL_SICK(tCell) = 1
    next
    coralRecount()
    assert CORAL_ENDING_DUE = 0, "one cell short is not an ending"

    CORAL_CELLS(tNeed - 1) = 1
    CORAL_SICK(tNeed - 1) = 1
    coralRecount()
    assert CORAL_ENDING_DUE = CORAL_ENDING_ANCIENT, "enough horror coral summons the ancient one"
    assert coralBarFill(1) = 1000, "and its bar is full"
    end
endtest

test ending_horror_coral_does_not_count_toward_the_reef from fishBoard
    ` the whole board has coral on it, and half of that is horror coral, so neither kind has enough
    for tCell = 0 to CELL_COUNT - 1
        CORAL_CELLS(tCell) = 1
        CORAL_SICK(tCell) = tCell mod 2
    next
    coralRecount()
    assert CORAL_COMPLETE = 1, "the whole board has coral on it"
    assert CORAL_ENDING_DUE = 0, "but neither kind has its share, so there is no ending"
    end
endtest

test ending_goes_on_the_table_as_a_badge from fishBoard
    tInitials = packInitials(2, 7, 4)
    tPlace = insertHighscore(0, tInitials + CORAL_ENDING_ANCIENT * HISCORE_BADGE_STEP, 1, 3)

    assert tPlace = 0, "a game of one move goes to the top of the table"
    assert getScoreBadge(HISCORE_NAMES(0)) = CORAL_ENDING_ANCIENT, "its row has the badge of its ending"
    assert getScoreInitials(HISCORE_NAMES(0)) = tInitials, "and the initials are the ones that were entered"
    assert getScoreBadge(HISCORE_NAMES(1)) = 0, "the row that it pushed down has no badge"
    assert getScoreBadge(tInitials) = 0, "and neither does a game that ended the usual way"
    end
endtest

test coral_stays_put_when_the_board_grows from fishBoard
    tLastRow = CELL_ROW_COUNT - 1
    tLastColumn = CELL_COLUMN_COUNT - 1
    CORAL_CELLS(testIndex(0, tLastRow)) = 1
    CORAL_CELLS(testIndex(tLastColumn, 0)) = 1

    ` the first one adds a column on the right, and the second one adds a row on the top
    PENDING_BOARD_EXPANSIONS = 2
    runto _loop
    runto _loop

    assert CELL_COLUMN_COUNT = tLastColumn + 2, "the board got a column"
    assert CELL_ROW_COUNT = tLastRow + 2, "and a row"
    assert CORAL_COUNT = 2, "the coral is all still there"
    assert CORAL_CELLS(testIndex(0, tLastRow + 1)) = 1, "the coral in the bottom corner is still in the bottom corner"
    assert CORAL_CELLS(testIndex(tLastColumn, 1)) = 1, "and the coral in the top row was pushed down with its row"
    assert CORAL_CELLS(testIndex(tLastColumn, 0)) = 0, "so the new row has none"
    end
endtest


` KNOWN FILL AND BOTTLES

test known_fill_is_turned_down_for_a_bottle from fishBoard
    grantMoveToSlot(ABILITY_INDEX_MOVE_KNOWN_FILL, 0)
    MOVE_ABILITY_BINDINGS(0).movesLeft = 0
    testPut(4, 4, TEX_BOTTLE)
    tWasNext = CELLS(testIndex(5, 4)).value
    testCursor(4, 4)
    testQueueMove(1, 0, 1, 0)

    runto _loop
    runto _loop
    runto _loop

    assert CELLS(testIndex(4, 4)).value = TEX_BOTTLE, "the bottle is where it was"
    assert CELLS(testIndex(5, 4)).value = tWasNext, "and so is the fish next to it"
    assert MOVE_ABILITY_BINDINGS(0).movesLeft = 0, "the move was not used up"
    assert CURRENT_MOVE_COUNT = 0, "and it was not a move"
    end
endtest

test known_fill_is_turned_down_for_a_swap_onto_a_bottle from fishBoard
    grantMoveToSlot(ABILITY_INDEX_MOVE_KNOWN_FILL, 0)
    MOVE_ABILITY_BINDINGS(0).movesLeft = 0
    testPut(5, 4, TEX_BOTTLE)
    tWasHere = CELLS(testIndex(4, 4)).value
    testCursor(4, 4)
    testQueueMove(1, 0, 1, 0)

    runto _loop
    runto _loop
    runto _loop

    assert CELLS(testIndex(5, 4)).value = TEX_BOTTLE, "the bottle is where it was"
    assert CELLS(testIndex(4, 4)).value = tWasHere, "and so is the fish that was under the cursor"
    assert MOVE_ABILITY_BINDINGS(0).movesLeft = 0, "the move was not used up"
    end
endtest

test known_fill_still_works_without_a_bottle from fishBoard
    grantMoveToSlot(ABILITY_INDEX_MOVE_KNOWN_FILL, 0)
    MOVE_ABILITY_BINDINGS(0).movesLeft = 0
    tWasHere = CELLS(testIndex(4, 4)).value
    testCursor(4, 4)
    testQueueMove(1, 0, 1, 0)

    runto _loop
    runto _loop
    runto _loop

    assert CELLS(testIndex(5, 4)).value = tWasHere, "the fish was swapped"
    assert MOVE_ABILITY_BINDINGS(0).movesLeft > 0, "and the move has to recharge"
    end
endtest


` THE CODEC

test codec_has_entries_for_coral_after_the_cards from fishBoard
    assert CODEC_COUNT = CARD_LENGTH + 11, "every card, coral, horror coral, the two endings, three special fish, and four things that happen to a fish"
    assert CODEC_ENTRY_JELLY = CARD_LENGTH + 4, "the special fish come after the endings"
    assert CODEC_ENTRY_STACK = CARD_LENGTH + 9, "stacked comes after the other things that happen to a fish"
    assert CODEC_ENTRY_HOME = CARD_LENGTH + 10, "and heart home is last"
    assert getCodecPref(CODEC_ENTRY_STACK) = CODEC_PREF_EXTRA + 9, "stacked is remembered where it always was"
    assert getCodecPref(CODEC_ENTRY_HOME) = CODEC_PREF_MORE, "and heart home is not remembered where the saved game starts"
    assert CODEC_ENTRY_REEF = CARD_LENGTH + 2, "the reef that was saved comes after those"
    assert CODEC_ENTRY_ANCIENT = CARD_LENGTH + 3, "and the ancient one is last"
    assert CODEC_ENTRY_CORAL = CARD_LENGTH, "coral comes after the cards"
    assert CODEC_ENTRY_HORROR = CARD_LENGTH + 1, "and horror coral after that"
    assert CODEC_SEEN(CODEC_ENTRY_CORAL) = 0, "coral is locked to begin with"
    assert CODEC_SEEN(CODEC_ENTRY_HORROR) = 0, "and so is horror coral"
    end
endtest

test codec_unlocks_what_is_on_the_board from fishBoard
    assert CODEC_SEEN(CODEC_ENTRY_RAY) = 0, "the stingray is locked to begin with"
    assert CODEC_SEEN(CODEC_ENTRY_BELLY) = 0, "and so is belly up"

    testPut(0, 0, TEX_RAY)
    CELLS(testIndex(2, 2)).bellyUp = 1
    CELLS(testIndex(4, 4)).stack = 1
    codecSeeBoard()

    assert CODEC_SEEN(CODEC_ENTRY_RAY) = 1, "a stingray on the board is in the codec"
    assert CODEC_SEEN(CODEC_ENTRY_BELLY) = 1, "and so is a fish that is belly up"
    assert CODEC_SEEN(CODEC_ENTRY_STACK) = 1, "and one that is stacked"
    assert CODEC_SEEN(CODEC_ENTRY_JELLY) = 0, "but not a jellyfish, when there is none"
    assert CODEC_SEEN(CODEC_ENTRY_BOTTLE) = 0, "or a bottle"
    assert CODEC_SEEN(CODEC_ENTRY_SKELETON) = 0, "or a skeleton"
    assert CODEC_SEEN(CODEC_ENTRY_HOME) = 0, "or a fish at home, when there is no coral"

    ` a fish on horror coral is not at home, and one on coral that is well is
    CORAL_CELLS(testIndex(1, 1)) = 1
    CORAL_SICK(testIndex(1, 1)) = 1
    codecSeeBoard()
    assert CODEC_SEEN(CODEC_ENTRY_HOME) = 0, "a fish on horror coral is not at home"
    CORAL_CELLS(testIndex(3, 3)) = 1
    codecSeeBoard()
    assert CODEC_SEEN(CODEC_ENTRY_HOME) = 1, "a fish on coral that is well is in the codec"
    end
endtest

test codec_unlocks_coral_when_some_grows from fishBoard
    CORAL_CELLS(0) = 1
    coralRecount()

    assert CODEC_SEEN(CODEC_ENTRY_CORAL) = 1, "coral that has grown is in the codec"
    assert CODEC_SEEN(CODEC_ENTRY_HORROR) = 0, "but horror coral is not, until there is some"
    end
endtest

test codec_unlocks_horror_coral_on_its_own from fishBoard
    CORAL_CELLS(0) = 1
    CORAL_SICK(0) = 1
    coralRecount()

    assert CODEC_SEEN(CODEC_ENTRY_HORROR) = 1, "horror coral that has grown is in the codec"
    assert CODEC_SEEN(CODEC_ENTRY_CORAL) = 0, "and coral is not, when all of it is horror coral"
    end
endtest


` THE DOUBLE STING

test second_sting_turns_a_belly_up_fish_into_a_skeleton from fishBoard
    mock rnd
    endmock 0
    testPut(1, 1, TEX_JELLY)
    testPut(2, 1, TEX_JELLY)
    testPut(3, 1, TEX_JELLY)
    CELLS(testIndex(2, 0)).bellyUp = 1
    CELLS(testIndex(1, 0)).bellyUp = 2

    REQUEST_COMBO_CHECK = 1
    runto _combos_spread

    assert CELLS(testIndex(2, 0)).bellyUp = 2, "a belly up fish that is stung turns into a skeleton"
    assert CELLS(testIndex(3, 0)).bellyUp = 1, "a fish that was fine only goes belly up"
    assert CELLS(testIndex(1, 0)).bellyUp = 2, "and a skeleton stays a skeleton"
    end
endtest

test stacked_jelly_stings_a_fish_to_the_bone from fishBoard
    mock rnd
    endmock 0
    testPut(1, 1, TEX_JELLY)
    testPut(2, 1, TEX_JELLY)
    testPut(3, 1, TEX_JELLY)
    CELLS(testIndex(2, 1)).stack = 1

    REQUEST_COMBO_CHECK = 1
    runto _combos_spread

    assert CELLS(testIndex(2, 0)).bellyUp = 2, "two stings from the one stack make a skeleton"
    assert CELLS(testIndex(1, 0)).bellyUp = 1, "the fish next to a jellyfish with no stack is only belly up"
    assert CELLS(testIndex(2, 2)).bellyUp = 2, "the fish under the stack is a skeleton too"
    end
endtest

test sting_that_lands_sends_a_bolt from fishBoard
    mock rnd
    endmock 0
    testPut(4, 4, TEX_JELLY)
    tZapsBefore = ZAP_LIVE

    stingJelly(testIndex(4, 4), 0)

    assert ZAP_LIVE = tZapsBefore + 4, "one bolt for each of the four fish around it"
    end
endtest


` THE ENDINGS, IN THE CODEC AND ON THE OPTIONS PAGE

test codec_unlocks_an_ending_when_it_is_reached from fishBoard
    tWasReef = SURFACE_REEF
    tWasAncient = SURFACE_ANCIENT
    CODEC_SEEN(CODEC_ENTRY_REEF) = 0
    CODEC_SEEN(CODEC_ENTRY_ANCIENT) = 0

    coralEndingRemember(CORAL_ENDING_REEF)
    assert CODEC_SEEN(CODEC_ENTRY_REEF) = 1, "saving the reef is in the codec"
    assert CODEC_SEEN(CODEC_ENTRY_ANCIENT) = 0, "and the other ending is still locked"

    coralEndingRemember(CORAL_ENDING_ANCIENT)
    assert CODEC_SEEN(CODEC_ENTRY_ANCIENT) = 1, "summoning the ancient one is in the codec"

    SURFACE_REEF = tWasReef
    SURFACE_ANCIENT = tWasAncient
    end
endtest

test options_page_only_has_what_the_menu_remembers from fishBoard
    tWasReef = SURFACE_REEF
    tWasAncient = SURFACE_ANCIENT

    SURFACE_REEF = 0
    SURFACE_ANCIENT = 0
    setMenuPage(MENU_PAGE_OPTIONS)
    tPlain = MENU_PAGE_LENGTH
    tHasReef = 0
    tHasMonster = 0
    for tI = 0 to MENU_PAGE_LENGTH - 1
        if MENU_PAGE_ITEMS(tI) = MENU_ITEM_SET_REEF then tHasReef = 1
        if MENU_PAGE_ITEMS(tI) = MENU_ITEM_SET_MONSTER then tHasMonster = 1
    next
    assert tHasReef = 0, "no line for the reef before it has been saved"
    assert tHasMonster = 0, "and none for the monster before it has been summoned"

    SURFACE_REEF = 1
    setMenuPage(MENU_PAGE_OPTIONS)
    assert MENU_PAGE_LENGTH = tPlain + 1, "the reef gets a line once it is there"
    assert MENU_PAGE_ITEMS(MENU_PAGE_LENGTH - 2) = MENU_ITEM_SET_REEF, "just above Back"
    assert MENU_PAGE_ITEMS(MENU_PAGE_LENGTH - 1) = MENU_ITEM_SET_BACK, "and Back is still last"

    SURFACE_ANCIENT = 1
    setMenuPage(MENU_PAGE_OPTIONS)
    assert MENU_PAGE_LENGTH = tPlain + 2, "and so does the monster"
    assert MENU_PAGE_ITEMS(MENU_PAGE_LENGTH - 2) = MENU_ITEM_SET_MONSTER, "under the reef"

    tWasOn = OPTION_MENU_MONSTER
    changeMenuOption(MENU_ITEM_SET_MONSTER, 1)
    assert OPTION_MENU_MONSTER = 1 - tWasOn, "picking the line turns the monster off or on"
    changeMenuOption(MENU_ITEM_SET_MONSTER, 1)
    assert OPTION_MENU_MONSTER = tWasOn, "and picking it again puts it back"

    SURFACE_REEF = tWasReef
    SURFACE_ANCIENT = tWasAncient
    end
endtest


` THE STREAKS OF THE LISTEN CARD

test hint_from_a_big_group_is_the_one_that_streaks from fishBoard
    grantPassive(ABILITY_INDEX_LISTEN)

    ` a hint that anything else brought
    coralClearHint()
    tMade = coralStartHint(0)
    assert tMade = 1, "there is a hint"
    assert CORAL_HINT_TRAIL_ON = 0, "but no big group of fish brought it, so it leaves no streaks"

    ` and one that a big group of fish is owed
    coralClearHint()
    CORAL_HINT_DUE = 1
    runto _loop
    runto _loop
    assert CORAL_HINT_DUE = 0, "the hint that was owed has set out"
    assert CORAL_HINT_TRAIL_ON = 1, "and it is the kind that leaves streaks"

    coralClearHint()
    assert CORAL_HINT_TRAIL_ON = 0, "which is over when the hint is"
    end
endtest


` THE DEBUG CARDS. see fish_routines_debug.

test debug_gives_a_passive from fishBoard
    debugGiveCard(ABILITY_INDEX_THINK_BIGGER, 0)
    assert CARDS(ABILITY_INDEX_THINK_BIGGER).obtained = 1, "the passive is owned"
    tPassives = PASSIVE_COUNT

    debugGiveCard(ABILITY_INDEX_THINK_BIGGER, 0)
    assert PASSIVE_COUNT = tPassives, "a passive that can only be taken once is not given twice"

    debugGiveCard(ABILITY_INDEX_CONTAGIOUS_SMILE, 0)
    debugGiveCard(ABILITY_INDEX_CONTAGIOUS_SMILE, 0)
    assert CARDS(ABILITY_INDEX_CONTAGIOUS_SMILE).uses = 2, "one that stacks is taken once more every time"
    end
endtest

test debug_puts_a_move_in_a_slot from fishBoard
    debugGiveCard(ABILITY_INDEX_MOVE_BOMB3x3, 1)
    assert MOVE_ABILITY_BINDINGS(1).assigned = 1, "the slot has a move in it"
    assert MOVE_ABILITY_BINDINGS(1).abilityIndex = ABILITY_INDEX_MOVE_BOMB3x3, "and it is the one that was asked for"
    assert MOVE_ABILITY_COUNT = 1, "that is one move"

    ` another move into the same slot
    debugGiveCard(ABILITY_INDEX_MOVE_CLONER, 1)
    assert MOVE_ABILITY_BINDINGS(1).abilityIndex = ABILITY_INDEX_MOVE_CLONER, "the new move took its place"
    assert CARDS(ABILITY_INDEX_MOVE_BOMB3x3).obtained = 0, "and the old one is not owned any more"
    assert MOVE_ABILITY_COUNT = 1, "so it is still one move"

    ` the same move into a different slot
    debugGiveCard(ABILITY_INDEX_MOVE_CLONER, 0)
    assert MOVE_ABILITY_BINDINGS(0).abilityIndex = ABILITY_INDEX_MOVE_CLONER, "the move is in its new slot"
    assert MOVE_ABILITY_BINDINGS(1).assigned = 0, "and it is gone from the old one"
    assert MOVE_ABILITY_COUNT = 1, "so it is still one move"

    ` a slot that is not open
    debugGiveCard(ABILITY_INDEX_MOVE_BOMB3x3, MOVE_SLOTS_OPEN)
    assert CARDS(ABILITY_INDEX_MOVE_BOMB3x3).obtained = 0, "a slot that is not open gets nothing"
    end
endtest


` A SWAP AS THE LAST STEP OF A PATTERN

test coral_swap_is_not_a_step_of_a_pattern from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` up and left are walked, and the last step up is the swap
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralSwapStepped(3, 5, 0, -1)

    assert CORAL_PENDING_SLOT < 0, "the swap does not finish the pattern. all of it is walked first."
    assert CORAL_TRAIL_COUNT = 1, "the steps are forgotten, and the step of the swap is the first of the next walk"
    end
endtest

test coral_opening_swap_can_be_the_first_step from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` the swap goes up, and then left and up are walked
    coralSwapStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    coralSwapMade(3, 4)

    assert CORAL_PENDING_SLOT = 0, "the opening swap was the first step of the pattern"
    assert CORAL_PENDING_COUNT = 4, "over all four of its cells"
    assert CORAL_PENDING_X(0) = 4, "starting from where the swap was made"
    assert CORAL_PENDING_Y(0) = 6, "starting from where the swap was made"
    end
endtest

test coral_opening_swap_does_not_have_to_be_a_step from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` the swap goes up to where the pattern starts, and then all of it is walked
    coralSwapStepped(4, 7, 0, -1)
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    coralSwapMade(3, 4)

    assert CORAL_PENDING_SLOT = 0, "the pattern after the swap counts too"
    assert CORAL_PENDING_COUNT = 4, "and the cell that the swap was made from is not one of its cells"
    assert CORAL_PENDING_Y(0) = 6, "it starts where the walk did"
    end
endtest

test coral_a_step_between_the_swap_and_the_pattern_spoils_it from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    coralSwapStepped(5, 7, 0, -1)
    coralCursorStepped(5, 6, -1, 0)
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    coralSwapMade(3, 4)

    assert CORAL_PENDING_SLOT < 0, "a step that is not of the pattern, after the swap, is one too many"
    end
endtest

test coral_swap_from_the_end_of_a_pattern_still_works from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralCursorStepped(3, 5, 0, -1)
    coralSwapStepped(3, 4, 1, 0)

    assert CORAL_PENDING_SLOT = 0, "the whole pattern was walked, and then the swap was made"
    assert CORAL_PENDING_COUNT = 4, "so it is the four cells of the walk"
    assert CORAL_PENDING_X(3) = 3, "ending where the swap was made from, and not where it went"
    assert CORAL_PENDING_Y(3) = 4, "ending where the swap was made from, and not where it went"
    end
endtest

test coral_swap_as_the_wrong_last_step_is_not_the_pattern from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)

    ` up and left are walked, but the swap goes left again, where the pattern goes up
    coralCursorStepped(4, 6, 0, -1)
    coralCursorStepped(4, 5, -1, 0)
    coralSwapStepped(3, 5, -1, 0)

    assert CORAL_PENDING_SLOT = -1, "a swap that goes the wrong way does not finish the pattern"
    end
endtest



` THE LUCKY TRAIL OF THE LISTEN CARD

test listen_lucky_hint_leaves_a_trail from fishBoard
    grantPassive(ABILITY_INDEX_LISTEN)

    ` every roll comes up: the wave of the current brings a hint, and the hint is a lucky one
    mock rnd
    endmock 0
    coralClearHint()
    CORAL_HINT_ROLLED = -1
    runto _loop
    runto _loop

    assert CORAL_HINT_START_MS >= 0, "a hint came on its own"
    assert CORAL_HINT_TRAIL_ON = 1, "and it was a lucky one, so it leaves a trail"
    end
endtest

test listen_unlucky_hint_leaves_no_trail from fishBoard
    grantPassive(ABILITY_INDEX_LISTEN)

    ` the first roll brings the hint, and the second one is the luck, which does not come up
    global tLuckRolls = 0
    mock rnd
        tLuckRolls = tLuckRolls + 1
        tLuckRoll = 0
        if tLuckRolls = 2
            tLuckRoll = 50
        endif
    endmock tLuckRoll
    coralClearHint()
    CORAL_HINT_ROLLED = -1
    runto _loop
    runto _loop

    assert CORAL_HINT_START_MS >= 0, "a hint came on its own"
    assert CORAL_HINT_TRAIL_ON = 0, "but it was not a lucky one, so it leaves no trail"
    end
endtest

test listen_hint_without_the_card_is_never_lucky from fishBoard
    mock rnd
    endmock 0
    coralClearHint()
    CORAL_HINT_ROLLED = -1
    runto _loop
    runto _loop

    assert CORAL_HINT_START_MS >= 0, "a hint came on its own"
    assert CORAL_HINT_TRAIL_ON = 0, "and without the card there is no trail, whatever the luck"
    end
endtest


` DEEP POCKETS, AND THE REROLL

test deep_pockets_adds_a_card_to_the_upgrade_screen from fishBoard
    assert getUpgradeChoiceCount() = 2, "the upgrade screen offers two cards"

    CARDS(ABILITY_INDEX_DEEP_POCKETS).uses = 1
    assert getUpgradeChoiceCount() = 3, "and three once the card has been taken"

    CARDS(ABILITY_INDEX_DEEP_POCKETS).uses = 5
    assert getUpgradeChoiceCount() = 3, "and never more than that"
    assert CARDS(ABILITY_INDEX_DEEP_POCKETS).maxUses = 1, "the card is only offered until it has been taken"
    assert CARDS(ABILITY_INDEX_DEEP_POCKETS).abilityType = ABILITY_TYPE_INSTANT, "and it is an instant"
    end
endtest

test reroll_costs_more_every_time from fishBoard
    UPGRADE_REROLLS = 0
    assert getRerollCost() = 5, "the first one costs 5 moves"
    UPGRADE_REROLLS = 1
    assert getRerollCost() = 10, "the second costs 10"
    UPGRADE_REROLLS = 2
    assert getRerollCost() = 15, "the third costs 15"
    UPGRADE_REROLLS = 3
    assert getRerollCost() = 20, "and the fourth costs 20"
    assert UPGRADE_REROLL_MAX = 4, "which is the last one"
    end
endtest


` WHAT stepCoral LEAVES ALONE

test coral_shadows_are_only_for_fish_next_to_coral from fishBoard
    CORAL_CELLS(testIndex(4, 4)) = 1
    coralRecount()

    assert CORAL_NEAR(testIndex(4, 4)) = 1, "the cell with the coral"
    assert CORAL_NEAR(testIndex(5, 5)) = 1, "and the ones around it, corners too"
    assert CORAL_NEAR(testIndex(3, 4)) = 1, "on every side"
    assert CORAL_NEAR(testIndex(6, 4)) = 0, "but not the ones further off"
    assert CORAL_NEAR(testIndex(0, 0)) = 0, "or the far corner"

    stepCoral()
    assert CORAL_DRAWN(testIndex(4, 4)) = 1, "the square of coral is showing"
    assert CORAL_DRAWN(testIndex(0, 0)) = 0, "and there is none where there is no coral"
    assert CORAL_SHADOW_DRAWN(testIndex(4, 5)) = 1, "the fish next to the coral has a shadow"
    assert CORAL_SHADOW_DRAWN(testIndex(0, 0)) = 0, "and the one in the far corner has none"

    resetCoral()
    stepCoral()
    assert CORAL_DRAWN(testIndex(4, 4)) = 0, "the square is put away when the coral is gone"
    assert CORAL_SHADOW_DRAWN(testIndex(4, 5)) = 0, "and so is the shadow"
    end
endtest


test coral_easy_song_move_opens_and_casts_through_the_input from fishBoard
    CORAL_SEQ_LENGTH(1) = 0
    CORAL_SEQ_LENGTH(2) = 0
    coralSetSequence(0, 76)
    grantMoveToSlot(ABILITY_INDEX_MOVE_SONG, 0)
    MOVE_ABILITY_BINDINGS(0).movesLeft = 0

    ` up with the move, which opens the song and takes its first step, and then left, and up
    testCursor(4, 6)
    testQueueMove(0, -1, 1, 0)
    testQueueMove(-1, 0, 0, -1)
    testQueueMove(0, -1, 0, -1)
    for tI = 1 to 120
        runto _loop
    next

    assert MOVE_ABILITY_BINDINGS(0).movesLeft > 0, "the move has to recharge"
    assert CORAL_OPEN = 0, "the song is over"
    assert CORAL_COUNT = 4, "and coral grew on the four cells that the cursor walked, with no swap"
    assert CORAL_CELLS(testIndex(4, 6)) = 1, "from where the move was used"
    assert CORAL_CELLS(testIndex(3, 4)) = 1, "to where the cursor ended up"
    end
endtest

test coral_only_one_pattern_is_out_at_a_time from fishBoard
    resetCoral()
    assert CORAL_SEQ_LENGTH(0) > 0, "there is a pattern"
    assert CORAL_SEQ_LENGTH(1) = 0, "and only the one"
    assert CORAL_SEQ_LENGTH(2) = 0, "and only the one"

    CORAL_PENDING_SLOT = 0
    CORAL_PENDING_COUNT = 0
    judgeCoralCast(1)
    assert CORAL_SEQ_LENGTH(0) > 0, "a new one takes its place when it is cast"
    assert CORAL_SEQ_LENGTH(1) = 0, "and there is still only the one"
    end
endtest
