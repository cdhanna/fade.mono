    assert INFOS(INFO_INDEX_CORAL_SICK).enabled = 1, "and one for the horror coral"
    assert INFOS(INFO_INDEX_GRID).size.x + INFOS(INFO_INDEX_CORAL).size.x + INFOS(INFO_INDEX_CORAL_SICK).size.x = CELL_COLUMN_COUNT * CELL_SIZE, "the board is split between the three"
    assert INFOS(INFO_INDEX_CORAL_SICK).topLeft.x = INFOS(INFO_INDEX_CORAL).topLeft.x + INFOS(INFO_INDEX_CORAL).size.x, "side by side"
    end
endtest

