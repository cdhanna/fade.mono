` THE DIVE BOAT of the main menu, out of art/dive_boat.fink. made by build/fink_export.py: run that
` again, rather than editing this. every tag of the boat is a place on it that the man can be, and its
` pictures are Fish/Textures/Menu/dive_boat_<place>.png, and _day.png for the middle of the day. BOAT_MAN_X and
` BOAT_MAN_Y are where the point "man" is on each, in the picture's own pixels (168 by 80).
#constant BOAT_PLACES 3
global dim BOAT_PLACE$(3)
global dim BOAT_MAN_X(3)
global dim BOAT_MAN_Y(3)
global BOAT_ART_W = 168
global BOAT_ART_H = 80
BOAT_PLACE$(0) = "sit"
BOAT_MAN_X(0) = 145
BOAT_MAN_Y(0) = 37
BOAT_PLACE$(1) = "man1"
BOAT_MAN_X(1) = 24
BOAT_MAN_Y(1) = 33
BOAT_PLACE$(2) = "man2"
BOAT_MAN_X(2) = 112
BOAT_MAN_Y(2) = 33
