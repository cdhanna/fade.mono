` THE SCORES ON STEAM. every table has a leaderboard on Steam, and a game that ends is sent to the one
` for its table. the routines are in fish_routines_highscores, and THE SCORES ON STEAM there explains them.
#constant HISCORE_SCOPE_LOCAL 0
#constant HISCORE_SCOPE_FRIENDS 1
#constant HISCORE_SCOPE_GLOBAL 2
global HISCORE_SCOPE = 0 `whose scores the table is showing. one of the HISCORE_SCOPE constants.

` the scores that come back from Steam are written into a table of their own, after the six real ones,
` so that everything that draws a table can draw them too. it is never saved.
global HISCORE_ONLINE_TABLE = 6
global dim HISCORE_ONLINE_ROWS(8) `which row of what Steam sent back each row of that table is. -1 is none.
global HISCORE_ONLINE_COUNT = 0 `how many rows of that table are filled in
global HISCORE_ONLINE_ME = -1 `which row of that table is the player's own, or -1
global HISCORE_ONLINE_BOARD = 0 `the leaderboard that the scores were asked from, or 0 for none
global HISCORE_ONLINE_STATE = -1 `what "steam scores state" said when the table was last filled in
global HISCORE_SEND_BOARD = 0 `the leaderboard that a game is on its way to, or 0 when none is
global HISCORE_STATUS_TEXT_ID `says why there are no scores from Steam to show: still loading, or none yet

` how a game is packed into the details of its score on Steam. the first bits say what follows, so
` that a later version of the game can pack it another way and still read the old ones.
` a detail is 32 bits, so detail n starts at bit n * 32.
global STEAM_PACK_VERSION = 1
global STEAM_BIT_VERSION = 0 `4 bits: STEAM_PACK_VERSION
global STEAM_BIT_INITIALS = 4 `15 bits: the initials, packed by packInitials
global STEAM_BIT_LOG_COUNT = 19 `7 bits: how many upgrades are in the log
global STEAM_BIT_GAP_WIDTH = 26 `4 bits: how many bits every gap of the log takes
global STEAM_DETAIL_MULT = 1 `the highest that the multiplier got
global STEAM_DETAIL_SEED = 2 `the seed of the board. there is no such thing yet, so it is 0.
global STEAM_DETAIL_FLAGS = 3 `32 flags. the lowest two bits are the ending of the hidden game, and then STEAM_FLAG_DEBUG. the rest are 0.
global STEAM_FLAG_DEBUG = 4 `the game was played with one of the debug environment variables set. see isDebugEnvSet.
global GAME_DEBUG_USED = 0 `1 when the game that is being played has had one of them set at any time, or has had debug mode on. it is saved with the game.
global DEBUG_SPLASH_TEXT_ID = 0 `the words that splash up when SOS turns debug mode on. they are made the first time that they are needed.
global DEBUG_SPLASH_MADE = 0 `1 once they have been made
global DEBUG_SPLASH_ON = 0 `1 while they are on the screen
global DEBUG_SPLASH_MS = 0 `when they came up
global DEBUG_SPLASH_IN_MS = 180 `how long they take to pop up, in milliseconds
global DEBUG_SPLASH_LIFE_MS = 1700 `how long they are there for, all told
