` every time that it is taken, so it can be taken as many times as there are slots that start out shut.
global MOVE_SLOT_START_COUNT = 3
global MOVE_SLOTS_OPEN = 3

` which device the input icons were last set up for. -1 means that they have not been set up at all.
global INPUT_ICON_DEVICE = -1

