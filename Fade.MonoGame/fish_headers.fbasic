global dim HISCORE_DETAIL_ART_SPRITES(7) `the picture from the card
global dim HISCORE_DETAIL_NAME_TEXTS(7)
global dim HISCORE_DETAIL_KIND_TEXTS(7) `passive, move or instant, with its icon
global dim HISCORE_DETAIL_MOVE_TEXTS(7) `the move that it was picked on

global HISCORE_CURSOR as infoBorder `the outline around a row of the table or a tab, and around the letter that is being changed
