global CORAL_LISTEN_BUBBLES = 3 `how many more bubbles come up at each end
global CORAL_HINT_GLOW_POWER# = 0 `how strongly the specks glow on this frame. it is CORAL_HINT_POWER#, and more with the card.
global CORAL_HINT_LISTEN# = 0 `1 on a frame that the card is owned, for the specks effect
global dim CORAL_HINT_TRAIL#(16) `eight spots along the path of the hint, from where it is to where it was, each CORAL_HINT_TRAIL_MS before the last, with the corners rounded off. x and then y of each.
global CORAL_HINT_TRAIL_MS = 320
global CORAL_HINT_AS_LISTEN = 0 `1 while the hint that is playing is drawn as if the card were owned. "show time" does this, and so does the K debug key.
global CORAL_HINT_TRAIL_ON = 0 `1 while the hint that is playing is one that leaves a trail, with the card
global CORAL_LISTEN_LUCK = 10 `how many of the hints that come on their own in a hundred leave a trail too, with the card. nothing says so.

global CORAL_HINT_CHANCE = 30 `how many waves of the current in a hundred bring a hint
global CORAL_HINT_GROUP_SIZE = 5 `a group of this many fish that pops always brings one
global CORAL_HINT_STEP_MS = 1400 `how long it takes to get from one cell to the next, in milliseconds
global CORAL_HINT_FADE_MS = 450 `how long it takes to swell up at the start, and to die away at the end
global CORAL_HINT_TAIL_MS = 750 `the specks glow this far behind it
global CORAL_HINT_BUBBLES = 2 `how many bubbles come up at each end
