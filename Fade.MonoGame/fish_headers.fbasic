` FLOATING BUBBLES. the routines are in fish_routines_bubbles.
global FLOAT_BUBBLE_COUNT = 300
global dim FLOAT_BUBBLES(FLOAT_BUBBLE_COUNT) as floatBubble
global FLOAT_BUBBLE_NEXT = 0 `the bubble that the next spawn will use
global FLOAT_BUBBLE_LIVE = 0 `how many are going right now. when there are none, there is nothing to do on a frame.
global FLOAT_BUBBLE_LAST_MS = 0
global ORDER_FLOAT_BUBBLES = 26 `on top of the fish, and underneath the info screen
global ORDER_OVERLAY_BUBBLES = 120 `on top of the info screen and the upgrade screen
global ORDER_MENU_FLOAT_BUBBLES = 205 `on top of the menu, and underneath the wave of bubbles that wipes it

` the sound budget. one bubble in this many makes a sound when it pops, there are only so many
` sounds to go around, and there has to be this many milliseconds between two of them.
global FLOAT_BUBBLE_LOUD_ODDS = 6
global FLOAT_BUBBLE_WAKE_LOUD_ODDS = 14 `the bubbles in the wake of a cursor are quieter, because there are so many of them
global FLOAT_BUBBLE_WAKE_ALPHA = 110 `and they are faint, so that they do not get in the way. 255 is solid.
global FLOAT_BUBBLE_WAKE_COLOR = rgb(210, 170, 255) `a pale version of the purple of the cursor on the board
global FLOAT_BUBBLE_SFX_COUNT = 8
global FLOAT_BUBBLE_SFX_GAP = 45
global dim FLOAT_BUBBLE_SFX(FLOAT_BUBBLE_SFX_COUNT)
global FLOAT_BUBBLE_SFX_NEXT = 0
global FLOAT_BUBBLE_CLIP_COUNT = 2 `the sound clips that a pop can be
global dim FLOAT_BUBBLE_CLIPS(FLOAT_BUBBLE_CLIP_COUNT)
global FLOAT_BUBBLE_SFX_LAST_MS = 0

` the "mind expansion" card adds a column or a row to the board, whichever one keeps the board closest to a square.
` the board grows after the upgrade screen has closed, so that it can be seen happening.
` the routine that does it, handle_board_expansion, is in fish_routines, because it has to come after the grid is declared.
global BOARD_EXPANSION_MAX = 4
global PENDING_BOARD_EXPANSIONS = 0
global BOARD_EXPAND_TWEEN_ID
global INFO_INDEX_GRID = 0 `the info blob that explains the board. it has to follow the board when the board changes size.

