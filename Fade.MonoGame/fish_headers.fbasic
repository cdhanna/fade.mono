` the front of the wave is not level. it leans to one side and bows in the middle, by a different
` amount every time, so that the wave sweeps across the screen as it goes up.
` this is the most that any part of the front can be above or below the middle of it.
global TRANSITION_SWEEP_MAX = 90

` the front of the wave starts below the screen, far enough down that the bubbles ahead of it are hidden too.
` it ends above the screen, far enough up that the bubbles behind it are gone too.
global TRANSITION_LINE_START = 600
global TRANSITION_LINE_TRAVEL = 850


` THE MUSIC. the routines are in fish_routines_music, and the top of that file explains how it works.
global MUSIC_VOLUME# = .65 `how loud all of the music is when the music option is all the way up, from 0 to 1
global MUSIC_LAST_MS = 0

` the layers are loops that never stop. they are only turned up and down.
#constant MUSIC_LAYER_RUMBLE 0
#constant MUSIC_LAYER_WASH 1
#constant MUSIC_LAYER_CURRENT 2
#constant MUSIC_LAYER_PAD_DM 3
#constant MUSIC_LAYER_PAD_BB 4
#constant MUSIC_LAYER_DEEP 5
#constant MUSIC_LAYER_TRICKLE 6
#constant MUSIC_LAYER_CRACKLE 7
#constant MUSIC_LAYER_SURF_ABOVE 8
#constant MUSIC_LAYER_AMBIENCE 9
#constant MUSIC_LAYER_AMBIENCE_LOW 10
global MUSIC_LAYER_COUNT = 11
global dim MUSIC_LAYERS(MUSIC_LAYER_COUNT) as musicLayer

` there are two scenes. at the surface there are waves breaking, and down in the deep it is dark
` and muffled, with bubbles going by. some of the layers are only heard in one of the scenes.
` the depth is how far down the music is, from 0 (the surface) to 1 (the deep), and the layers
` of the two scenes fade into each other as it changes. setMusicDepth() changes it.
#constant MUSIC_SCENE_BOTH 0
#constant MUSIC_SCENE_SURFACE 1
#constant MUSIC_SCENE_DEEP 2
global MUSIC_DEPTH# = 0
global MUSIC_DEPTH_TARGET# = 0 `the depth that it is on its way to
global MUSIC_DEPTH_SPEED# = 0 `how much the depth moves in a second
global MUSIC_SCENE_MS = 0 `when it goes to the other scene next
global MUSIC_SCENE_GAP_MIN = 60000 `it stays in a scene for somewhere between these, in milliseconds.
global MUSIC_SCENE_GAP_MAX = 120000 `0 means that the scene only changes when setMusicDepth() is called.
global MUSIC_SCENE_FADE# = 15 `how many seconds it takes to go from one scene to the other
global MUSIC_DIVE_FADE# = 4 `the same, for when the game starts (it dives) and when it goes back to the main menu (it surfaces)

` a layer that wanders picks a new level after a wait that is somewhere between these, in milliseconds
global MUSIC_DRIFT_GAP_MIN = 15000
global MUSIC_DRIFT_GAP_MAX = 30000
global MUSIC_DRIFT_FADE# = 8 `and takes this many seconds to get there

` the two pad layers are chords, and only one of them is up at a time. they take turns.
#constant MUSIC_CHORD_DM 0
` MUSIC_CHORD_ANY is for a melody that does not care which chord is up
#constant MUSIC_CHORD_BB 1
#constant MUSIC_CHORD_ANY 2
global MUSIC_CHORD = 0
global MUSIC_CHORD_MS = 0 `when the chord changes next
global MUSIC_CHORD_GAP_MIN = 25000 `a chord lasts somewhere between these, in milliseconds.
global MUSIC_CHORD_GAP_MAX = 45000 `0 means that the chord only changes when setMusicChord() is called.
global MUSIC_CHORD_FADE# = 6 `how many seconds it takes to go from one chord to the other
global MUSIC_CHORD_LEAD = 3500 `a melody that has to change the chord waits this many milliseconds for it to arrive

` the shots are sounds that play once, now and then
#constant MUSIC_SHOT_PING 0
#constant MUSIC_SHOT_WHALE_LOW 1
#constant MUSIC_SHOT_WHALE_HIGH 2
#constant MUSIC_SHOT_BUBBLES_SPARSE 3
#constant MUSIC_SHOT_BUBBLES_DENSE 4
#constant MUSIC_SHOT_TANK_CLINK 5
#constant MUSIC_SHOT_BOAT_PASS 6
#constant MUSIC_SHOT_DOLPHIN 7
#constant MUSIC_SHOT_THUNDER_ABOVE 8
global MUSIC_SHOT_COUNT = 9
global dim MUSIC_SHOTS(MUSIC_SHOT_COUNT) as musicShot

` the notes that a melody can use, from low to high. there is a sound for every one of them.
#constant REST 0
` they are the scale of F major, which is also the scale of D minor. Bb is B flat.
#constant D4 1
#constant E4 2
#constant F4 3
#constant G4 4
#constant A4 5
#constant Bb4 6
#constant C5 7
#constant D5 8
#constant E5 9
#constant F5 10
#constant G5 11
#constant A5 12
#constant Bb5 13
#constant C6 14

` the instruments that a melody can be played on. every one of them has a sound for every note.
` the bell is a clear ring. it is good for slow tunes with room in them.
` the pluck is a plucked string, like a harp. it is good for quick runs of notes.
` the swell is a soft tone that fades in. it takes a second to arrive, so it is only good for slow tunes.
#constant INSTRUMENT_BELL 0
#constant INSTRUMENT_PLUCK 1
#constant INSTRUMENT_SWELL 2
global MUSIC_INSTRUMENT_COUNT = 3
global MUSIC_NOTE_SLOTS = 15 `a rest, and the 14 notes
global dim MUSIC_NOTE_SFX(45) `every note of the first instrument, and then every note of the next one
global dim MUSIC_INSTRUMENT_VOLUME#(3) `how loud each instrument is next to the others. setup_music fills these in.

` the melodies are written in setup_melodies. all of their beats are kept in one long list,
` and every melody knows where it starts in the list and how many beats long it is.
global MELODY_MAX = 32
global MELODY_COUNT = 0
global dim MELODY_FIRST(MELODY_MAX)
global dim MELODY_LENGTH(MELODY_MAX)
global dim MELODY_BEAT(MELODY_MAX) `how many milliseconds a beat lasts
global dim MELODY_INSTRUMENT(MELODY_MAX)
global dim MELODY_CHORD(MELODY_MAX) `the chord that it wants underneath it, or MUSIC_CHORD_ANY
global MELODY_NOTE_MAX = 1024
global MELODY_NOTE_TOTAL = 0
global dim MELODY_NOTES(MELODY_NOTE_MAX)

global MELODY_VOLUME# = .28
global MELODY_GAP_MIN = 20000 `after a melody ends, the next one starts on its own after a wait
global MELODY_GAP_MAX = 45000 `somewhere between these, in milliseconds. 0 means that one never does.
global MELODY_AUTO_MS = 0 `when the next one starts on its own
global MELODY_PLAYING = -1 `the melody that is playing, or -1
global MELODY_LAST = -1 `the one that played last, so that it is not picked twice in a row
global MELODY_STEP = 0 `the beat of it that is next
global MELODY_NEXT_MS = 0 `when that beat is due
