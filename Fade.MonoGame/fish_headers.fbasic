global INTRO_FADE_MS = 700 `how long a line takes to fade in, and to fade out
global INTRO_DIM_ALPHA = 90 `how dark the water gets behind the lines, out of 255

` 0 when there is no tutorial. 1 while the lines of text are still to come, and everything is off of the
` screen. 2 while the big info key is waiting to be pressed. 3 when the fish are in, and the next pop
` brings in the moves and the multiplier. 4 when those are in, and the next pop brings in the bar of
` the round and the rounds that are left.
global TUTORIAL_STAGE = 0
