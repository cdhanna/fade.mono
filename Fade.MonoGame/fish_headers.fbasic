global CORAL_HINT_REACH# = .5 `and how far from it the specks glow, the same way. the lit patch is a square, so .5 is exactly one cell.
global CORAL_HINT_SPECK_GLOW# = 1.8 `how many times as bright the specks glow as the coral does. the specks effect stops at 4, with the card and all.
global CORAL_HINT_ROLLED = -1 `the last wave of the current that has had its roll for a hint
