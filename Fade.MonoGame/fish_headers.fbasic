` the sound budget. one bubble in this many makes a sound when it pops, there are only so many
` sounds to go around, and there has to be this many milliseconds between two of them.
global FLOAT_BUBBLE_LOUD_ODDS = 6
global FLOAT_BUBBLE_WAKE_LOUD_ODDS = 14 `the bubbles in the wake of a cursor are quieter, because there are so many of them
global FLOAT_BUBBLE_WAKE_ALPHA = 110 `and they are faint, so that they do not get in the way. 255 is solid.
global FLOAT_BUBBLE_WAKE_COLOR = rgb(170, 195, 255) `a pale version of the blue of the outline of the cursor on the board
global FLOAT_BUBBLE_SFX_COUNT = 8
global FLOAT_BUBBLE_SFX_GAP = 45
