` EQUIPPING A MOVE. there are more moves than there are buttons, so a move has to be put in a slot to
` be used. one screen does all of it. it lists the slots that are open, each with its button and the
` move that is in it, all greyed out. the player picks a row up, and then picks another row, and the
` moves in the two rows trade places.
` when a move has just been picked on the upgrade screen, it is not in a slot yet. if there is a slot
` that is empty, it goes straight into the first one, and the screen does not come up at all.
` when every slot is full, it waits in a row of its own, the spare row, at the top of the list, and
` it gets a slot by trading places with one. the spare row is labelled "available", and the rows of
` the slots are labelled "inventory".
` whatever is in the spare row when the player is done is left behind, and is gone until an upgrade
` offers it again, so the player is asked first.
` the same screen, without the spare row, can be opened at any time to move the moves between the
` buttons: from info mode, with the confirm button on a move, and from the pause menu.
` the routines are in fish_routines_equip.
#constant EQUIP_ROW_SLOT 0
#constant EQUIP_ROW_SPARE 1
#constant EQUIP_ROW_DONE 2
#constant EQUIP_MODE_UPGRADE 0
#constant EQUIP_MODE_REARRANGE 1
global EQUIP_MODE = 0
global EQUIP_HELD = -1 `the row that has been picked up, or -1
global EQUIP_SPARE = -1 `the card of the move that is in the spare row, or -1
global EQUIP_SPARE_LEFT = 0 `how long that move has left to recharge
global EQUIP_START_SLOT = -1 `the slot to start on, when the screen is opened to rearrange. -1 is the first one.
global EQUIP_SPARE_GAP = 6 `how much further the spare row is from the slots than the slots are from each other
global EQUIP_ROW_MAX = 7 `a row for every slot, the spare row, and the row that says "done"
global dim EQUIP_ROWS(EQUIP_ROW_MAX) as equipRow
global EQUIP_ROW_COUNT = 0 `how many rows are showing. the last one is "done".
global EQUIP_SELECTED = 0 `the highlighted row
global EQUIP_CONFIRMING = 0 `1 while the player is being asked if they are sure
global EQUIP_CONFIRM_YES = 0 `which answer is highlighted
global EQUIP_ROW_WIDTH = 260 `wide enough that a long name does not run into the note at the other end
global EQUIP_ROW_HEIGHT = 20
global EQUIP_ROW_GAP = 2
global EQUIP_ROWS_TOP = 126
global EQUIP_OPTION_WIDTH = 60 `how wide the outline around an answer is
global EQUIP_ROW_X = 0 `the left edge of the rows. setup_move_equip works these out, because the size of the world is not known here.
global EQUIP_NO_X = 0 `the middle of each of the two answers. they go to the right of the highlighted row.
global EQUIP_YES_X = 0
