` the wave of bubbles. the first few are big, and sit in a row to make the front of the wave.
` the rest are small, and are scattered ahead of the front and behind it.
global BUBBLE_FRONT_COUNT = 13
global BUBBLE_COUNT = 140
global dim BUBBLES(BUBBLE_COUNT) as bubble
global TRANSITION_TWEEN_ID
global SFX_CLIP_BUBBLES
