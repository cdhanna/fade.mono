global dim CORAL_TRAIL_Y(CORAL_STEP_MAX)

` a pattern that was walked, and then followed by a swap. handle_combos has not said yet if that swap popped anything.
global CORAL_PENDING_SLOT = -1 `the slot of the pattern, or -1 if there is none waiting
global CORAL_PENDING_COUNT = 0 `how many cells were walked over
global dim CORAL_PENDING_X(16)
