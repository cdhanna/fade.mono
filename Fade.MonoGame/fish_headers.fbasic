global SPLASH_PAN_DURATION = 3200 `how long the camera takes to come down from there, in milliseconds
global MENU_CHROME_ALPHA# = 1 `0 when the title and the list of the menu are see-through. they fade in as the camera comes down.

` THE SEA FLOOR. what is behind the board while the game is being played. the routines are in fish_routines_seabed.
global SEABED_FX_ID
global SEABED_SPRITE `the water, the light and the rock
global SNOW_FX_ID
global SNOW_SPRITE `the specks that drift in front of the fish
global ORDER_SEABED = -10 `underneath everything
global ORDER_SNOW = 27 `on top of the fish and the bubbles, and underneath the score text

` THE MOOD. one swap can set off a run of pops: fish pop, the board fills back in, and that pops more.
` the water gets brighter, the shafts of light get stronger, and the words around the board light up,
` for every group of fish that pops in the run. when the board settles, it all dims back down. so
` every move breathes in and out, and a long run lights the whole place up.
global SEABED_COMBO = 0 `how many groups of fish have popped since the board was last settled. handle_combos keeps count.
global SEABED_MOOD# = 0 `0 is the dim water of a settled board, and 1 is as bright as it gets
global SEABED_MOOD_HALF# = 3 `how many groups it takes to get half of the way to the brightest. it never quite gets there.
global SEABED_MOOD_EASE# = .0015 `how much of the way up to where it should be it goes in a millisecond
global SEABED_MOOD_FALL# = .0005 `and how much of the way down. it comes up quicker than it settles.
global SEABED_LAST_MS = 0

` THE RAINBOW. when a run of pops is a long one, the specks in the water turn the colors of the rainbow
` every time more fish pop. then it fades, until the next pop.
global SEABED_SURGE# = 0 `1 when more fish have just popped. it dies away to 0.
global SEABED_SURGE_FADE# = .00025 `how much of the surge goes away in a millisecond
global SEABED_SURGE_WAS# = 0 `where the mood was headed on the last frame, to tell when it goes up
global SEABED_RAINBOW_FROM# = .3 `how high the mood has to be for there to be any rainbow at all
global SEABED_RAINBOW_FULL# = .6 `and how high for all of it
global SEABED_RAINBOW_REST# = .25 `how much of the rainbow stays between one pop and the next, while the mood is high
global SEABED_RAINBOW# = 0 `how much rainbow is showing. it chases what the surge says, so that it does not snap on.
global SEABED_RAINBOW_EASE# = .003 `how much of the way there it goes in a millisecond

` the specks drift faster when the mood is high. the effects can not just be told a faster speed, because
` the specks would all jump to somewhere else. so they move by a clock of their own, and it is the
` clock that runs faster.
global SEABED_SNOW_CLOCK# = 0 `in seconds
global SEABED_SNOW_RUSH# = 1.5 `how much faster the clock runs when the mood is all the way up. 1 is twice as fast.

` THE CURRENT. every so often a little wave comes through the board, from the top left to the bottom
` right. each fish leans into it as it gets there, and back out of it as it leaves, and then sits still
` until the next one. the fish do not move from their places. frame_fish_fx, in fish_routines, does it.
global CURRENT_PERIOD# = 9000 `how long it is from one wave to the next, in milliseconds
global CURRENT_SPREAD# = .25 `how much later the wave gets to the next fish along. smaller is a wider, faster wave.
global CURRENT_DIR_X# = .89 `which way the wave goes: this many cells across,
global CURRENT_DIR_Y# = .45 `and this many down
global CURRENT_TILT# = .3 `how far a fish leans at the most, in radians

` RIPPLES. the rings that tilt the fish also push the picture of the whole screen as they pass, like
` a bulge in the water. the pushes of all the rings add up, so two rings that cross do not hide each other.
` the screen effect does it, for this many of the strongest rings at once.
` this has to be how many Ripple parameters ScreenEffect.fx has.
global RIPPLE_COUNT = 8

` THE WATERLINE. going from the game back up to the main menu, the water drains down the screen. there
` are no bubbles in that. the menu's effect and the screen effect both draw the water as everything
` below a wavy line, in place of looking at the bubble mask.
global WATERLINE_USE = 0 `1 while that is going on
global WATERLINE_Y# = 0 `how far down the screen the line is, where 0 is the top and 1 is the bottom
global WATERLINE_TILT# = 0 `how much lower the right end of the line is than the left end, measured the same way

` THE SAVED GAME. the routines are in fish_routines_save.
