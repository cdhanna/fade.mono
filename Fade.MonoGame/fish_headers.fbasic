` EQUIPPING A MOVE. there are more moves than there are buttons, so a move that is picked on the upgrade
` screen has to be put in a slot. the screen lists the slots that are open, each with its button and the
` move that is in it, all greyed out, and the player picks one. picking a slot that has a move in it
` throws that move out, and it is gone until an upgrade offers it again, so the player is asked first.
` the last row leaves the new move behind instead, and that asks first too.
` the routines are in fish_routines_equip.
global EQUIP_ROW_MAX = 5 `a row for every slot, and one more to leave the move behind
global dim EQUIP_ROWS(EQUIP_ROW_MAX) as equipRow
global EQUIP_ROW_COUNT = 0 `how many rows are showing. the last one leaves the move behind.
global EQUIP_SELECTED = 0 `the highlighted row
global EQUIP_CONFIRMING = 0 `1 while the player is being asked if they are sure
global EQUIP_CONFIRM_YES = 0 `which answer is highlighted
global EQUIP_ROW_WIDTH = 230
global EQUIP_ROW_HEIGHT = 22
global EQUIP_ROW_GAP = 4
global EQUIP_ROWS_TOP = 128
global EQUIP_OPTION_WIDTH = 60 `how wide the outline around an answer is
global EQUIP_ROW_X = 0 `the left edge of the rows. setup_move_equip works these out, because the size of the world is not known here.
global EQUIP_NO_X = 0 `the middle of each of the two answers. they go to the right of the row that was picked.
global EQUIP_YES_X = 0
global EQUIP_FADE_TWEEN_ID
global EQUIP_CURSOR_TWEEN_ID
