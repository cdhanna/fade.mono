    set sprite offset tTvMenu, 0, 0
    size sprite tTvMenu, WORLD_WIDTH, WORLD_HEIGHT
    color sprite tTvMenu, rgb(0, 0, 0)
    order sprite tTvMenu, 300
    set sprite render target tTvMenu, TARGET_MENU
    for tTrFrame = 1 to 10
        runto update_frame
    next
