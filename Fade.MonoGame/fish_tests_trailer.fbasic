` CAPTIONS. short lines for the cuts in build/cuts to put between their shots: the words rise in over
` the empty sea the way the title at the start does, stay a moment, and fade. one video for each, from
` one run. the words are written by build/trailer_captions.py, which writes this test.
test trailer_captions from trailerShot
    trailerNoUi()
    trailerFishAway()
    set sprite alpha SELECTION_SPRITE, 0
    for tCapF = 1 to 30
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        runto update_frame
    next

    ` "Swap. Pop. Take your time."
    trailerWordOn("Swap.", 0)
    trailerWordOn("Pop.", 0)
    trailerWordSub("Take", 1, 28)
    trailerWordSub("your", 1, 28)
    trailerWordSub("time.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_swap")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "A new card every round."
    trailerWordOn("A", 0)
    trailerWordOn("new", 0)
    trailerWordOn("card", 0)
    trailerWordSub("every", 1, 28)
    trailerWordSub("round.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_cards")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "Meet the locals. They have favors to ask."
    trailerWordOn("Meet", 0)
    trailerWordOn("the", 0)
    trailerWordOn("locals.", 0)
    trailerWordSub("They", 1, 28)
    trailerWordSub("have", 1, 28)
    trailerWordSub("favors", 1, 28)
    trailerWordSub("to", 1, 28)
    trailerWordSub("ask.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_locals")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "When night falls, nothing pops."
    trailerWordOn("When", 0)
    trailerWordOn("night", 0)
    trailerWordOn("falls,", 0)
    trailerWordSub("nothing", 1, 28)
    trailerWordSub("pops.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_night")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "Not everything down here is friendly."
    trailerWordOn("Not", 0)
    trailerWordOn("everything", 0)
    trailerWordSub("down", 1, 28)
    trailerWordSub("here", 1, 28)
    trailerWordSub("is", 1, 28)
    trailerWordSub("friendly.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_deep")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "Thirty rounds. How few moves will you need?"
    trailerWordOn("Thirty", 0)
    trailerWordOn("rounds.", 0)
    trailerWordSub("How", 1, 28)
    trailerWordSub("few", 1, 28)
    trailerWordSub("moves", 1, 28)
    trailerWordSub("will", 1, 28)
    trailerWordSub("you", 1, 28)
    trailerWordSub("need?", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_moves")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "Listen closely. The sea is full of secrets."
    trailerWordOn("Listen", 0)
    trailerWordOn("closely.", 0)
    trailerWordSub("The", 1, 28)
    trailerWordSub("sea", 1, 28)
    trailerWordSub("is", 1, 28)
    trailerWordSub("full", 1, 28)
    trailerWordSub("of", 1, 28)
    trailerWordSub("secrets.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_listen")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "No timer. No rush. Just the sea."
    trailerWordOn("No", 0)
    trailerWordOn("timer.", 0)
    trailerWordSub("No", 1, 28)
    trailerWordSub("rush.", 1, 28)
    trailerWordSub("Just", 1, 28)
    trailerWordSub("the", 1, 28)
    trailerWordSub("sea.", 1, 28)
    trailerTitleLayout(WORLD_HEIGHT / 2)
    trailerLineWait(1, 30)
    trailerRecord("trailer_cap_quiet")
    for tCapF = 0 to 200
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(tCapF - 8, 12, 1)
        runto update_frame
    next
    for tCapF = 0 to 24
        tCapA# = tCapF
        tCapA# = 1 - tCapA# / 24.0
        hintShow(0)
        trailerHideBut(-1, -1, -1, -1)
        trailerRiseTitle(400, 12, tCapA#)
        runto update_frame
    next
    record stop
    for tCapN = 0 to TR_WORD_COUNT - 1
        hide text TR_WORD(tCapN)
    next
    TR_WORD_COUNT = 0

    ` "30 Rounds. Relax, you cannot lose."
    trailerWordOn("30", 0)
    trailerWordOn("Rounds.", 0)
    trailerWordSub("Relax,", 1, 28)
    trailerWordSub("you", 1, 28)
    trailerWordSub("cannot", 1, 28)
