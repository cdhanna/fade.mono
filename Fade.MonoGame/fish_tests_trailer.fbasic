    for tTrFrame = 1 to 112
        runto frame_menu_render
    next
    record stop
    end
endtest


` THE QUESTS, sixteen of them, for the cut to lay out on one screen (see "grid" in build/trailer_cut.json).
` each quest is forced on a board of its own, and its creature starts to talk about it as the video starts
` (see THE QUEST TALK in fish_headers_questtalk). the box is a little higher than in the game, so that the
` crop of the grid has all of it. they all wait the same, and the grid starts them all at the same frame, so
` that every box in it is up and its line is out. the cursor makes swaps that pop, walking to the one that
` pops the most each time, so that the quest has things to do, and the box stays up through them. then the
` boxes bubble away, one after the other, from the top left corner of the grid down to the bottom right:
` each one on frame 632, and 7 frames later for every step that its place in the grid is from the corner.

test trailer_quest_01 from trailerShot
    trailerHudLevel(0)
    trailerDeal(31)
    questForce(QUEST_SHARK)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    questPickUp()
    trailerCursor(4, 4)
    for tTqF = 1 to 40
        runto update_frame
    next
    ` the box fades with what is around the board, so that is up, with every part of it off but the quest
    QTALK_ENABLED = 1
    QTALK_BOX_Y = 196
    QTALK_HOLD_MS = 600000
    HUD_KEEP# = .9999
    TR_Q_CLOSE = 632
    trailerRecord("trailer_quest_01")
    questTalkStart(QUEST_SHARK)
    for tTqF = 1 to 150
        runto update_frame
        trailerQuestTick()
    next
    while record frame count() < 830
        trailerBestSwap()
        tTqCol = TR_BEST_CELL mod CELL_COLUMN_COUNT
        tTqRow = TR_BEST_CELL / CELL_COLUMN_COUNT
        trailerWalkTo(tTqCol, tTqRow)
        tTqGuard = 0
        while trailerWalked() = 0
            trailerWalkStep()
            runto update_frame
            trailerQuestTick()
            tTqGuard = tTqGuard + 1
            if tTqGuard > 200
                trailerCursor(TR_WALK_TO_X, TR_WALK_TO_Y)
            endif
        endwhile
        if TR_BEST_DOWN
            trailerMove(0, 1, 1)
        else
            trailerMove(1, 0, 1)
        endif
        for tTqF = 1 to 70
            runto update_frame
            trailerQuestTick()
        next
    endwhile
    record stop
    end
endtest
