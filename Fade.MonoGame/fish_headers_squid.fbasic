global STAR_SNOW_BOTTOM = 34 `and how far above the bottom of the screen it stops, for the sand, which is in front of the plankton
global STAR_SNOW_SLACK = 8 `how far below the top of it a hint starts to fade out, in pixels
global STAR_BAND_LEFT = 0 `where starSnowBand leaves its answer
global STAR_BAND_TOP = 0
global STAR_BAND_WIDE = 0
global STAR_BAND_TALL = 0
