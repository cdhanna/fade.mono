global STAR_SNOW_HOLD = 3800 `when they start to fade
global STAR_SNOW_FADE = 1000 `how long they take to

` THE FANFARE. a few notes of the music's own instruments, one after the other. squidStep plays them.
global FANFARE_MAX = 64
global dim FANFARE_AT(64) `when each note is due, on the clock of the game, or 0 when it has been played
global dim FANFARE_INST(64)
