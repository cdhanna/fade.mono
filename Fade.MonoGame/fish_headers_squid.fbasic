global dim STAR_SNOW_LINES#(3) `how bright the lines of each are, from 0 to 1
global dim STAR_SNOW_SWEEP#(3) `and how far across it they have swept, from 0 to 1
global dim STAR_SNOW_FROM(3) `when it came, on the clock of the game
global STAR_SNOW_PITCH = 5 `how far apart the lights of a hint are, in grains. it has to be the same as HINT_PITCH in HintSnowEffect.fx and SeabedEffect.fx.
global STAR_SNOW_GRAIN = 2 `how big a grain of the plankton is, in pixels
global STAR_SNOW_RISE# = 5 `how fast the plankton rises, in pixels a second
global STAR_SNOW_SWAY = 6 `and how far it sways to either side
global HINT_FX_ID = 0
