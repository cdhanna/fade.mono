global ORDER_HINTS = -9 `just on top of the sea floor, which the plankton is part of
global dim STAR_SNOW_SIDE(3) `which side of the board each is on: 0 the left, 1 the right
global STAR_AT_X = 0 `where starSnowAt leaves its answer
global STAR_AT_Y = 0
` the open water either side of the board, which the hints stay in: where it starts, across, and how wide it is
