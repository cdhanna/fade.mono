global dim STAR_SHAPE_LEN(16) `and how many there are
global dim STAR_SHAPE_WIDE(16) `how many cells across it is, and down, as it is written
global dim STAR_SHAPE_TALL(16)
global dim STAR_X(160)
global dim STAR_Y(160)
global dim STAR_PIECE(160) `the piece of its shape that every cell is in, from 1. setup_stars works it out.
global dim STAR_PIECE_LEN(160) `how many cells the piece of every cell has

global dim STAR_PICK(3) `the shape that is in the sky tonight for each of the three, or -1
global dim STAR_MADE(3) `1 when it has been made tonight
global dim STAR_MADE_AT(3) `where it was made: the cell that its first cell is in
global dim STAR_MADE_TURN(3) `and the turn that it was made in, from 0 to 3
global dim STAR_CLAIM(400) `the constellation that every cell is part of, from 1, or 0
global STAR_TURN_X = 0 `where starTurned leaves its answer
global STAR_TURN_Y = 0
global dim STAR_PIECE_HAS(17) `scratch, for starFits: the piece of the ink that each piece of the shape is in
global STAR_BONUS = 10 `how many times as much as a fish of a group its size each fish of a made constellation scores
global STAR_LAST_SCORE = 0 `what the last constellation to pop scored, for the tests
global dim STAR_POP_DUE(3) `1 while a made constellation is waiting to pop
global dim STAR_POP_MS(3) `when it pops, on the clock of the game
global dim STAR_POPPED(3) `1 once it has
global STAR_POP_WAIT = 1100 `how long a made constellation shimmers before it pops

global dim STAR_SHAPE_MASK(1024) `1 for every spot of the grid of every shape that has a star in it: 64 to a shape, 8 to a row. starShapesDone fills it in.

global dim STAR_SKY_X(3) `where the middle of each of the three is, from the middle of the moon
global dim STAR_SKY_Y(3)
