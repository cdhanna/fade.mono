global STAR_FLASH_LONG = 1800 `how long the shimmer lasts
global dim STAR_SKY_SHOWN#(3) `how much of each hint in the water is there, from 0 to 1, as it fades in and out

` THE HINTS IN THE SNOW. see starSkyDraw. where each of the three is, as it drifts, and its round of lines.
` a hint is made of the plankton, the little lights that drift up through the water at night, which are
` on grains of 2 pixels. see SeabedEffect.fx and HintSnowEffect.fx.
` there is one hint at a time, but while one fades out the next fades in, so there are three places for
` them. each is a hint in the water, and not one of the three shapes of the night: STAR_SNOW_SLOT says
` which shape it is.
global dim STAR_SNOW_SLOT(3) `which of the three shapes of the night it is, or -1 when it is not in use
global dim STAR_SNOW_STATE(3) `0 when it is not in use, 1 while it is the one, and 2 while it fades out
global dim STAR_SNOW_MADE(3) `1 when its shape has been made, for the effects
global dim STAR_SNOW_SHOWN#(3) `how much of it is there, with the night, for the effects
global STAR_SNOW_NEXT = 0 `the shape that came last. the next to come is the one after it.
global STAR_SNOW_LAST_SIDE = 0 `the side that the last one came on. the next comes on the other.
global STAR_SNOW_FIRST = 1 `1 until the first of the night has come
global STAR_SNOW_LAST_MS = 0 `when starSkyDraw last ran, for the fades
global STAR_SNOW_COME = 1500 `how long one takes to fade in, or out, in milliseconds
global dim STAR_SNOW_CX(3) `the grain of the top left light of each, which moves with the plankton
