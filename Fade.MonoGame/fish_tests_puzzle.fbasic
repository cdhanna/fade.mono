test puzzle_undo_brings_back_a_bubble_and_a_rainbow_fish from fishBoard
    RAINBOW_FISH_ON = 1
    tpFishUp()
    testPut(1, 6, TEX_BASS)
    testPut(2, 6, TEX_CRAB)
    testPut(3, 6, TEX_BASS)
    testPut(4, 6, TEX_CRAB)
    testPut(5, 6, TEX_PUFFER)
    BUBBLED_AT(56) = 1
    BUBBLED_AT(58) = 1
    RAINBOW_FISH(59) = 1
    tpQueueSwap(56, 57)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
