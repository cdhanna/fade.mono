test puzzle_a_new_fish_is_explained_on_the_board_that_it_comes_in_on from fishBoard
    tpPuzzleUp(PUZZLE_NEW_BUBBLE)
    tpBubbles = bubbledCount()
    assert tpBubbles > 0, "the first board of bubbles has one"
    tpPuzzleUp(PUZZLE_NEW_BUBBLE - 1)
    tpBubbles = bubbledCount()
    assert tpBubbles = 0, "and the one before it does not"
    tpPuzzleUp(PUZZLE_NEW_RAINBOW)
    tpRainbows = 0
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        tpRainbows = tpRainbows + RAINBOW_FISH(tpI)
    next
    assert tpRainbows > 0, "the first board of rainbow fish has one"
    tpBelly = 0
