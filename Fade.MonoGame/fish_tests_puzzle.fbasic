test puzzle_her_words_do_not_follow_her from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_SWIM_X# = 240
    PUZZLE_GO_X# = 400
    PUZZLE_SWIM_Y# = 100
    PUZZLE_GO_Y# = 100
    tpSpeed# = PUZZLE_SWIM_SPEED#
    guideSay(lockey$("angler.puzzle.d1.a"))
    runto _loop
    tpWordsSay = word count(ANGLER_LAST$)
    assert tpWordsSay = 8, "the line comes apart into its words"
    tpFirst = PUZZLE_SAY_FIRST

    ` the first word comes out right where she is
    tpTick = 0
    while PUZZLE_SAY_OUT < 1 and tpTick < 400
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpSayX = PUZZLE_WORD_X#(tpFirst)
    tpSwimX = PUZZLE_SWIM_X#
    tpAhead = abs(tpSayX - tpSwimX)
    assert tpAhead < 100, "the word is right behind her mouth, and not out on its way to somewhere else"

    ` the next one has its place after the first one, and the first one does not move
    tpTick = 0
    while PUZZLE_SAY_OUT < 2 and tpTick < 400
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpBackX = PUZZLE_WORD_X#(tpFirst)
    tpNextX = PUZZLE_WORD_X#(tpFirst + 1)
    assert tpBackX = tpSayX, "the word before it stays where it is"
    tpGap = tpBackX + PUZZLE_WORD_W#(tpFirst)
    assert tpNextX >= tpGap, "so that they are in a line behind her, and not on top of each other"
    tpSpeedNow# = PUZZLE_SWIM_SPEED#
    assert tpSpeedNow# = tpSpeed#, "and she does not hurry for it"

    ` she goes off somewhere else, and the words do not go with her
    PUZZLE_SWIM_X# = 450
    PUZZLE_SWIM_Y# = 40
    runto _loop
    runto _loop
    tpNowX = PUZZLE_WORD_X#(tpFirst)
    assert tpNowX = tpBackX, "the words do not follow her"

    ` each word leans a way of its own
    tpLeans = 0
    for tpN = 1 to tpWordsSay - 1
        tpA = PUZZLE_WORD_TILT#(tpFirst) * 10000
        tpB = PUZZLE_WORD_TILT#(tpFirst + tpN) * 10000
        if tpA <> tpB then tpLeans = 1
    next
    assert tpLeans = 1, "they do not lean the same way"

    ` the next thing that she says starts from her again
    tpLine = ANGLER_SAYS
    guideSay(lockey$("angler.puzzle.d1.b"))
    tpTick = 0
    while PUZZLE_SAY_FIRST = tpFirst and tpTick < 800
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpNext = PUZZLE_SAY_FIRST
    assert tpNext <> tpFirst, "a new line has words of its own"
    tpEnd = PUZZLE_WORD_END(tpFirst)
    assert tpEnd > 0, "and the words of the line before it start to go"
    end
endtest


