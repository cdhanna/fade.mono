    BUBBLED_AT(56) = 1
    tpNo = puzzleBlocksSwap(56, 57)
    assert tpNo = 0, "and with a bubble in it, it is"
    tpNo = puzzleBlocksSwap(55, 56)
    assert tpNo = 0, "from either side"

    BUBBLED_AT(59) = 1
    tpQueueSwap(56, 57)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
