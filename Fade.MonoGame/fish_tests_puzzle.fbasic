test puzzle_she_finishes_a_thought_before_the_next_one from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_LANE = 0
    puzzleDebugSay(lockey$("angler.puzzle.d4.a"))
    tpTick = 0
    while PUZZLE_SAY_OUT < 2 and tpTick < 400
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpLine = ANGLER_SAYS
    tpFirst = PUZZLE_SAY_FIRST
    tpCount = PUZZLE_SAY_COUNT
    guideSay(lockey$("angler.puzzle.stuck2"))
    assert ANGLER_SAYS = tpLine, "she does not stop in the middle"
    assert PUZZLE_SAY_PUSHED = 1, "she hurries instead"

    tpTick = 0
    while ANGLER_SAYS = tpLine and tpTick < 800
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert ANGLER_SAYS = tpLine + 1, "and then she says it"
    assert PUZZLE_SAY_OUT = 0, "with none of it out yet"
    runto _loop
    tpOld = puzzleOldWordsUp()
    assert tpOld = 1, "because the old words are still going"
    tpOldAll = 0
    for tpN = 0 to tpCount - 1
        tpSlot = (tpFirst + tpN) mod PUZZLE_WORD_SLOTS
        if PUZZLE_WORD_STATE(tpSlot) = 2
            tpOldAll = tpOldAll + PUZZLE_WORD_QUICK(tpSlot)
        endif
    next
    assert tpOldAll > 0, "and they are going at once"

    tpStart = game ms()
    tpTick = 0
    while PUZZLE_SAY_OUT = 0 and tpTick < 400
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpTook = game ms() - tpStart
    tpOld = puzzleOldWordsUp()
    assert tpOld = 0, "they have gone when the new one starts"
    assert tpTook < 500, "and that does not take long"
    end
endtest


test puzzle_undo_cuts_through_a_swap from fishBoard
    tpPuzzleUp(0)
    guideShow()
    tpBoardWas = tpBoardSum()
    tpCursorWas = SELECTION_POS.x + SELECTION_POS.y * PUZZLE_SIDE
    tpPlay(0, 0)
    tpTick = 0
    while LIVE_MOVE_ACTIVE = 0 and tpTick < 200
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert LIVE_MOVE_ACTIVE = 1, "the swap is playing"
    PUZZLE_UNDO_WANT = 1
    runto _loop
    assert PUZZLE_UNDO_WANT = 0, "undo does not wait for it"
    assert LIVE_MOVE_ACTIVE = 0, "the swap has stopped"
    assert REQUEST_COMBO_CHECK = 0, "and nothing is going to pop"
    tpBoardNow = tpBoardSum()
    assert tpBoardNow = tpBoardWas, "the board is back"
    tpPlaced = tpFishOutOfPlace()
    assert tpPlaced = 0, "and every fish is where it belongs"

    tpN = 0
    tpSwaps = PUZZLE_SWAPS(0)
    while tpN < tpSwaps
        tpPlay(0, tpN)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
        tpN = tpN + 1
    endwhile
    tpFish = puzzleFishLeft()
    assert tpFish = 0, "and the board still works"
    end
endtest


