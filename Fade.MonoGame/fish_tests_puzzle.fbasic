        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    tpFish = puzzleFishLeft()
    assert tpFish = 3, "two bubbles that touch both pop, whatever kinds they are"
    tpLeft = bubbledCount()
    assert tpLeft = 0, "and they are gone"
    end
endtest


