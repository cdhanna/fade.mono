test puzzle_a_long_line_is_a_paragraph from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_SWIM_X# = 300
    PUZZLE_GO_X# = 400
    PUZZLE_SWIM_Y# = 100
    PUZZLE_GO_Y# = 100
    PUZZLE_LANE = 0
    guideSay(lockey$("angler.puzzle.d1.b"))
    runto _loop
    runto _loop

    ` confirm lets out the rest of it
    guideHurry()
    runto _loop
    runto _loop
    tpOut = PUZZLE_SAY_OUT
    tpCount = PUZZLE_SAY_COUNT
    assert tpOut = tpCount, "every word is out"
    tpState = PUZZLE_WORD_STATE(PUZZLE_SAY_FIRST)
    assert tpState = 2, "and it stays out, and does not vanish because it came out all at once"
    assert PUZZLE_SAY_HOLD = 0, "and nothing is waiting"
    assert PUZZLE_SAY_ROWS > 1, "it is too long for one row"

    tpSlot = PUZZLE_SAY_FIRST
    tpLift = PUZZLE_WORD_TO_LIFT#(tpSlot)
    assert tpLift > 0, "the first rows have moved up"
    tpSlot = PUZZLE_SAY_FIRST + tpCount - 1
    tpLift = PUZZLE_WORD_TO_LIFT#(tpSlot)
    assert tpLift = 0, "and the last one is level with her"

    for tpN = 0 to tpCount - 1
        tpSlot = PUZZLE_SAY_FIRST + tpN
        tpEnd = PUZZLE_WORD_X#(tpSlot) + PUZZLE_WORD_W#(tpSlot)
        assert tpEnd <= WORLD_WIDTH, "and the words are all in the water"
        tpStart = PUZZLE_WORD_X#(tpSlot)
        assert tpStart >= 0, "on both sides"
    next
    end
endtest


