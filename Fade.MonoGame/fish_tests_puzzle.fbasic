test puzzle_rows_start_at_the_ends_of_phrases from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_LANE = 1
    guideSay(lockey$("angler.puzzle.d7.b"))
