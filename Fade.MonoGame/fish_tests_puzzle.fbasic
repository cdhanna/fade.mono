    endwhile
            assert tpFloating() = 0, "no fish is left hanging in the water"
        next
        tpFish = puzzleFishLeft()
        assert tpFish = 0, "the list of swaps clears the board"
    next
    end
endtest


` put a puzzle up, the way that puzzle_deal does, without the wait
function tpPuzzleUp(tpUpBoard)
    PUZZLE_ON = 1
    PUZZLE_NOW = tpUpBoard
    PUZZLE_CLEARED_MS = 0
    PUZZLE_AGAIN = 0
    puzzleBoard()
    PUZZLE_FISH_WAS = puzzleFishLeft()
    tpUpCursor = puzzleLowestFish()
    SELECTION_POS.x = tpUpCursor mod PUZZLE_SIDE
    SELECTION_POS.y = tpUpCursor / PUZZLE_SIDE
    QUEUED_MOVE_NUM = 0
    QUEUED_MOVE_TAIL = 0
endfunction


` the fish to the right of this one, if it can be swapped with it, or -1
function tpSwapRight(tpRightAt)
    if tpRightAt mod PUZZLE_SIDE = PUZZLE_SIDE - 1 then exitfunction -1
    tpRightTo = tpRightAt + 1
    if CELLS(tpRightAt).value = 0 then exitfunction -1
    if CELLS(tpRightTo).value = 0 then exitfunction -1
    tpRightNo = puzzleBlocksSwap(tpRightAt, tpRightTo)
    if tpRightNo then exitfunction -1
endfunction tpRightTo


` a move with the cursor here. a test has to wait for the fish after it.
function tpQueueMove(tpMoveA, tpMoveB, tpMoveSwaps)
    SELECTION_POS.x = tpMoveA mod PUZZLE_SIDE
    SELECTION_POS.y = tpMoveA / PUZZLE_SIDE
    tpMoveX = (tpMoveB mod PUZZLE_SIDE) - (tpMoveA mod PUZZLE_SIDE)
    tpMoveY = (tpMoveB / PUZZLE_SIDE) - (tpMoveA / PUZZLE_SIDE)
    tpMoveDir as vec = {
        x = tpMoveX,
        y = tpMoveY
    }
    QUEUED_MOVES(QUEUED_MOVE_NUM) = {
        dir = tpMoveDir
        swap = tpMoveSwaps,
        moveBindingIndex = -1
    }
    QUEUED_MOVE_NUM = QUEUED_MOVE_NUM + 1
endfunction


function tpQueueSwap(tpSwapA, tpSwapB)
    tpQueueMove(tpSwapA, tpSwapB, 1)
endfunction


` do what the hint says. a test has to wait for the fish after it.
function tpHintPlay()
    puzzleHint()
    assert PUZZLE_HINT_BACK = 0, "there is a hint from here"
    tpHintA = PUZZLE_HINT_A
    tpHintB = PUZZLE_HINT_B
    if tpHintA <> tpHintB
        tpQueueSwap(tpHintA, tpHintB)
        exitfunction
    endif

    ` the cursor comes to a belly up fish, from a side that it can get to
    tpSideCursor = SELECTION_POS.x + SELECTION_POS.y * PUZZLE_SIDE
    tpReached = puzzleHintKey(tpSideCursor)
    tpCursor = -1
    for tpSide = 0 to 3
        tpFrom = -1
        if tpSide = 0 and tpHintB mod PUZZLE_SIDE > 0 then tpFrom = tpHintB - 1
        if tpSide = 1 and tpHintB mod PUZZLE_SIDE < PUZZLE_SIDE - 1 then tpFrom = tpHintB + 1
        if tpSide = 2 then tpFrom = tpHintB - PUZZLE_SIDE
        if tpSide = 3 then tpFrom = tpHintB + PUZZLE_SIDE
        if tpFrom >= 0 and tpFrom < CELL_COUNT
            if PUZZLE_FLOOD_SEEN(tpFrom) = PUZZLE_FLOOD_STAMP then tpCursor = tpFrom
        endif
    next
    assert tpCursor >= 0, "the cursor can get to the fish of the hint"
    tpQueueMove(tpCursor, tpHintB, 0)
endfunction


` looks at every pair of words on the screen, the way that they are now. a word that is on its way out of her
` mouth is left out, and so is one that has mostly faded.
function tpWordsMeasure()
    tpWNow = game ms()
    tpWLast = PUZZLE_WORD_SLOTS - 1
    tpWFade = PUZZLE_SAY_FADE_MS / 2
    for tpW = 0 to tpWLast
        PUZZLE_WORD_FROM_ROW(tpW) = 0
        if PUZZLE_WORD_STATE(tpW) = 2 and PUZZLE_WORD_SMALL(tpW) = 0
            PUZZLE_WORD_FROM_ROW(tpW) = 1
            if PUZZLE_WORD_SHOWN_Y#(tpW) < TP_WORDS_TOP#
                TP_WORDS_TOP# = PUZZLE_WORD_SHOWN_Y#(tpW)
            endif
            if PUZZLE_WORD_END(tpW) > 0 and tpWNow > PUZZLE_WORD_END(tpW) + tpWFade
                PUZZLE_WORD_FROM_ROW(tpW) = 0
            endif
        endif
    next
    tpWTall# = PUZZLE_SAY_SIZE * .75
    for tpW = 0 to tpWLast - 1
        if PUZZLE_WORD_FROM_ROW(tpW)
            for tpV = tpW + 1 to tpWLast
                if PUZZLE_WORD_FROM_ROW(tpV)
                    tpDX# = abs(PUZZLE_WORD_SHOWN_X#(tpW) - PUZZLE_WORD_SHOWN_X#(tpV))
                    tpDX# = tpDX# - (PUZZLE_WORD_W#(tpW) + PUZZLE_WORD_W#(tpV)) / 2
                    tpDY# = abs(PUZZLE_WORD_SHOWN_Y#(tpW) - PUZZLE_WORD_SHOWN_Y#(tpV))
                    tpLeanW# = abs(sin(PUZZLE_WORD_SHOWN_TILT#(tpW))) * PUZZLE_WORD_W#(tpW) / 2
                    tpLeanV# = abs(sin(PUZZLE_WORD_SHOWN_TILT#(tpV))) * PUZZLE_WORD_W#(tpV) / 2
                    tpDY# = tpDY# - (tpWTall# + tpLeanW# + tpLeanV#)
                    if tpDX# < 0 and tpDY# < 0
                        TP_WORDS_TOUCHED = TP_WORDS_TOUCHED + 1
                        if PUZZLE_WORD_LINE(tpW) <> PUZZLE_WORD_LINE(tpV)
                            TP_WORDS_LINES = TP_WORDS_LINES + 1
                        else
                            if PUZZLE_WORD_ROW(tpW) = PUZZLE_WORD_ROW(tpV)
                                TP_WORDS_ROW = TP_WORDS_ROW + 1
                            else
                                TP_WORDS_ROWS = TP_WORDS_ROWS + 1
                            endif
                        endif
                    endif
                endif
            next
        endif
    next
endfunction


` a puzzle with no fish in it, for a test to put its own in
function tpFishUp()
    tpPuzzleUp(0)
    tpEmptyLast = CELL_COUNT - 1
    for tpEmptyI = 0 to tpEmptyLast
        puzzlePut(tpEmptyI, 0)
    next
endfunction


` the key of the board as it is now
function tpBoardKey()
    tpKeyMove = puzzleHintHere()
    tpKeyIs = puzzleHintKey(SELECTION_POS.x + SELECTION_POS.y * PUZZLE_SIDE)
endfunction tpKeyIs


` a move, the way that the hints write it
function tpPlayMove(tpMoveIs)
    tpMoveFrom = tpMoveIs / 10000
    tpMoveTo = tpMoveIs mod 10000
    if tpMoveTo >= 1000
        tpQueueMove(tpMoveFrom, tpMoveTo - 1000, 0)
    else
        tpQueueMove(tpMoveFrom, tpMoveTo, 1)
    endif
endfunction


` make one swap of the list of a board
function tpPlay(tpPlayBoard, tpPlayN)
    tpA = PUZZLE_SWAP_A(tpPlayBoard * PUZZLE_SWAP_ROOM + tpPlayN)
    tpB = PUZZLE_SWAP_B(tpPlayBoard * PUZZLE_SWAP_ROOM + tpPlayN)
    tpSwaps = 1
    if tpB >= 1000
        tpB = tpB - 1000
        tpSwaps = 0
    endif
    SELECTION_POS.x = tpA mod PUZZLE_SIDE
    SELECTION_POS.y = tpA / PUZZLE_SIDE
    tpDirX = (tpB mod PUZZLE_SIDE) - (tpA mod PUZZLE_SIDE)
    tpDirY = (tpB / PUZZLE_SIDE) - (tpA / PUZZLE_SIDE)
    tpQueue as vec = {
        x = tpDirX,
        y = tpDirY
    }
    QUEUED_MOVES(QUEUED_MOVE_NUM) = {
        dir = tpQueue
        swap = tpSwaps,
        moveBindingIndex = -1
    }
    QUEUED_MOVE_NUM = QUEUED_MOVE_NUM + 1
endfunction


` how many fish are not at their place on the board
function tpFishOutOfPlace()
    tpOut = 0
    tpOutLast = CELL_COUNT - 1
    for tpOutI = 0 to tpOutLast
        if CELLS(tpOutI).value > 0
            tpOutX# = sprite x(CELLS(tpOutI).spriteId) - getCellX(CELLS(tpOutI).coord.x)
            tpOutY# = sprite y(CELLS(tpOutI).spriteId) - getCellY(CELLS(tpOutI).coord.y)
            if abs(tpOutX#) > 1 then tpOut = tpOut + 1
            if abs(tpOutY#) > 1 then tpOut = tpOut + 1
        endif
    next
endfunction tpOut


` how many fish have water under them
function tpFloating()
    tpHanging = 0
    for tpFX = 0 to PUZZLE_SIDE - 1
        tpSeen = 0
        for tpFY = 0 to PUZZLE_SIDE - 1
            tpV = CELLS(tpFX + tpFY * PUZZLE_SIDE).value
            if tpV > 0 then tpSeen = 1
            if tpV = 0 and tpSeen = 1 then tpHanging = tpHanging + 1
        next
    next
endfunction tpHanging


` 1 while anything is moving on the board, or waiting to
function tpBusy()
    tpIsBusy = 0
    if REQUEST_COMBO_CHECK then tpIsBusy = 1
    if LIVE_MOVE_ACTIVE then tpIsBusy = 1
    if QUEUED_MOVE_NUM > QUEUED_MOVE_TAIL then tpIsBusy = 1
endfunction tpIsBusy


global TP_TALL_BOARD = 0

` how tall the tallest of the things that Ava says at the puzzles is, in this language
function tpTallest()
    tpMost = 0
    for tpSayBoard = 0 to PUZZLE_COUNT - 1
        puzzleOpening(tpSayBoard)
        tpWordsHere = word count(ANGLER_LAST$)
        if tpWordsHere > TP_MOST_WORDS then TP_MOST_WORDS = tpWordsHere
        tpHigh = get text size y(ANGLER_SAY_TEXT_ID)
        if tpHigh > tpMost
            tpMost = tpHigh
            TP_TALL_BOARD = tpSayBoard
        endif
        set text ANGLER_SAY_TEXT_ID, GUIDE_QUEUE$(0)
        tpHigh = get text size y(ANGLER_SAY_TEXT_ID)
        if tpHigh > tpMost
            tpMost = tpHigh
            TP_TALL_BOARD = tpSayBoard
        endif
        puzzleCleared(tpSayBoard)
        tpHigh = get text size y(ANGLER_SAY_TEXT_ID)
        if tpHigh > tpMost
            tpMost = tpHigh
            TP_TALL_BOARD = tpSayBoard
        endif
    next
    guideSay(lockey$("angler.puzzle.stuck2"))
    tpHigh = get text size y(ANGLER_SAY_TEXT_ID)
    if tpHigh > tpMost then tpMost = tpHigh
    guideSay(lockey$("angler.puzzle.another"))
    tpHigh = get text size y(ANGLER_SAY_TEXT_ID)
    if tpHigh > tpMost then tpMost = tpHigh
    set text wrap ANGLER_SAY_TEXT_ID, ANGLER_BOX_W - 20
    TP_TALK_TALL = 0
    for tpTalk = 1 to PUZZLE_TALK_LAST
        for tpPart = 1 to 5
            puzzleTalkSay(tpTalk, tpPart)
            tpHigh = get text size y(ANGLER_SAY_TEXT_ID)
            if tpHigh > TP_TALK_TALL then TP_TALK_TALL = tpHigh
        next
    next
    set text wrap ANGLER_SAY_TEXT_ID, PUZZLE_SAY_WRAP
endfunction tpMost


` a number that comes out the same for the same fish in the same cells
function tpBoardSum()
    tpSum = 0
    tpSumLast = CELL_COUNT - 1
    for tpSumI = 0 to tpSumLast
        tpSum = (tpSum * 31 + CELLS(tpSumI).value + tpSumI) mod 1000003
    next
endfunction tpSum


` what the preferences say, for a mock of get pref
function tpPrefSet(tpSetAt, tpSetTo)
    if tpSetAt = PUZZLE_PREF then TP_PREF_BOARD = tpSetTo
    if tpSetAt = PUZZLE_PREF + 2 then TP_PREF_STAYED = tpSetTo
    if tpSetAt = PUZZLE_GONE_PREF then TP_PREF_GONE = tpSetTo
endfunction


function tpPrefAt(tpAtIndex)
    tpAtValue = 0
    if tpAtIndex = PUZZLE_PREF then tpAtValue = TP_PREF_BOARD
    if tpAtIndex = PUZZLE_PREF + 2 then tpAtValue = TP_PREF_STAYED
    if tpAtIndex = PUZZLE_GONE_PREF then tpAtValue = TP_PREF_GONE
endfunction tpAtValue
