test puzzle_undo_takes_back_a_pop from fishBoard
    tpPuzzleUp(0)
    tpBoardWas = tpBoardSum()
    tpFishWas = puzzleFishLeft()
    tpCellA = PUZZLE_SWAP_A(0)

    tpPlay(0, 0)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    tpFish = puzzleFishLeft()
    assert tpFish < tpFishWas, "the swap popped some"
    assert PUZZLE_UNDO_COUNT = 1, "and it can be taken back"

    puzzleUndo()
    tpBoardNow = tpBoardSum()
    assert tpBoardNow = tpBoardWas, "the board is the way that it was"
    assert PUZZLE_UNDO_COUNT = 0, "and there is nothing more to take back"
    assert SELECTION_POS.x + SELECTION_POS.y * CELL_COLUMN_COUNT = tpCellA, "and the cursor went back"

    ` the list still clears it from there
    tpSwapCount = PUZZLE_SWAPS(0)
    for tpN = 0 to tpSwapCount - 1
        tpPlay(0, tpN)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    next
    tpFish = puzzleFishLeft()
    assert tpFish = 0, "and it can be played again from there"

    ` every swap can be taken back, all the way to the start
    tpN = PUZZLE_UNDO_COUNT
    while tpN > 0
        puzzleUndo()
        tpN = tpN - 1
    endwhile
    tpBoardNow = tpBoardSum()
    assert tpBoardNow = tpBoardWas, "all of the way back to the board that came in"

    ` and with nothing to take back, nothing happens
    puzzleUndo()
    tpBoardNow = tpBoardSum()
    assert tpBoardNow = tpBoardWas, "one too many does nothing"
    assert PUZZLE_UNDO_COUNT = 0, "and the count stays at nothing"
    end
endtest


