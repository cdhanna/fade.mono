test puzzle_a_big_group_leaves_nothing_behind from fishBoard
    RAINBOW_FISH_ON = 1
    BUBBLED_ON = 1
    tpPuzzleUp(0)
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        CELLS(tpI).value = 0
    next

    ` one swap makes two groups of five, with the cursor pushing a fish into each. in a game, that leaves a
    ` rainbow fish or a fish in a bubble behind, which is a fish that the proof of a board did not count on.
    for tpX = 0 to 4
        testPut(tpX, 6, TEX_BASS)
        testPut(tpX, 5, TEX_CRAB)
    next
    testPut(2, 6, TEX_CRAB)
    testPut(2, 5, TEX_BASS)
    testCursor(2, 5)
    testQueueMove(0, 1, 1, -1)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    tpFish = puzzleFishLeft()
    assert tpFish = 0, "no rainbow fish and no bubble: every fish has gone"
    end
endtest


test puzzle_lines_fit_the_box from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    set text wrap ANGLER_SAY_TEXT_ID, PUZZLE_SAY_WRAP
    tpRoom = 150
    for tpLang = 0 to 4
        if tpLang = 0 then set language "en"
        if tpLang = 1 then set language "pt-BR"
        if tpLang = 2 then set language "fr"
        if tpLang = 3 then set language "de"
        if tpLang = 4 then set language "pl"
        tpTall = tpTallest()
        print "[puzzle fit] language " + str$(tpLang) + " tallest " + str$(tpTall) + " room " + str$(tpRoom) + " board " + str$(TP_TALL_BOARD)
        assert tpTall <= tpRoom, "what she says over a board is not a wall of words"
        assert TP_MOST_WORDS <= 32, "and it fits in the words that can be in the water"
        assert TP_TALK_TALL <= 48, "and a talk fits the usual box"
    next
    set language "en"
    end
endtest


test puzzle_runs_out_and_the_player_stays from fishBoard
    tpPuzzleUp(PUZZLE_COUNT - 1)
    guideShow()
    PUZZLE_STAY_MS = 0
    PUZZLE_CLEAR_HOLD_MS = 0
    GUIDE_HOLD_MS = 1

    ` the last board has just been cleared
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        CELLS(tpI).value = 0
    next
    runto _loop
    assert PUZZLE_CLEARED_MS > 0, "the last board is clear"

    tpTick = 0
    tpSawAlone = 0
    tpSawAsked = 0
    while PUZZLE_AFTER = 0 and tpTick < 4000
        runto _loop
        anglerSpeakAll()
        if PUZZLE_ALONE_MS > 0 then tpSawAlone = 1
        if PUZZLE_ASKED then tpSawAsked = 1
        tpTick = tpTick + 1
    endwhile
    assert tpSawAlone = 1, "first there is nothing left"
    assert tpSawAsked = 1, "then she asks if the player is still here"
    assert PUZZLE_AFTER = 1, "and then she makes another one"
    tpFish = puzzleFishLeft()
    assert tpFish > 0, "and it is on the board"
    end
endtest


test puzzle_a_talk_comes_after_every_third_board from fishBoard
    tpWhich = puzzleTalkAfter(1)
    assert tpWhich = 0, "no talk after the second board"
    tpWhich = puzzleTalkAfter(2)
    assert tpWhich = 1, "the first talk is after the third"
    tpWhich = puzzleTalkAfter(14)
    assert tpWhich = 10, "the one that says it is half of them is after the fifteenth"
    tpWhich = puzzleTalkAfter(26)
    assert tpWhich = 19, "the last talk is after the twenty-seventh"
    tpWhich = puzzleTalkAfter(29)
    assert tpWhich = 0, "and the last board has the ending instead"

    ` clear the third board, and go through the talk with every key held
    mock new action down
    endmock TP_PRESS
    tpPuzzleUp(2)
    guideShow()
    puzzleSwimOn()
    PUZZLE_CLEAR_HOLD_MS = 0
    GUIDE_HOLD_MS = 1
    ANGLER_SWIM_MS = 1
    PUZZLE_RUSH_SPEED# = 100000
    PUZZLE_FISH_WAS = 1
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        CELLS(tpI).value = 0
    next
    runto angler_frame
    assert PUZZLE_TALK_NOW = 1, "the talk is the angler's usual scene"
    assert GUIDE_ON = 0, "and she is not the guide while it goes on"
    TP_PRESS = 1
    runto _puzzle_talked
    TP_PRESS = 0
    assert GUIDE_ON = 1, "she goes back to wandering around"
    runto _loop
    tpN = 0
    while PUZZLE_NOW = 2 and tpN < 3000
        runto _loop
        tpN = tpN + 1
    endwhile
    assert PUZZLE_NOW = 3, "and the next board came in"
    end
endtest


test puzzle_picks_up_where_the_player_got_to from fishBoard
