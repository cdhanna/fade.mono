    for tpI = 0 to tpLast
        tpBelly = tpBelly + CELLS(tpI).bellyUp
    next
    assert tpBelly = 0, "the boards before belly up fish come in are only swaps"
    tpPuzzleUp(PUZZLE_NEW_BELLY)
    for tpI = 0 to tpLast
        tpBelly = tpBelly + CELLS(tpI).bellyUp
    next
    assert tpBelly > 0, "and belly up fish come in on the board that she says that"
    end
endtest


test long_puzzles_agree_with_the_game from fishBoard
    if val(env$("FISH_TESTS_LONG")) = 0 then end
    RAINBOW_FISH_ON = 1
    BUBBLED_ON = 1
    puzzleCheckList()
    assert PUZZLE_CHECKS > 0, "there is something to check"
    for tpBoard = 0 to PUZZLE_COUNT - 1
        tpPuzzleUp(tpBoard)
        tpSwapCount = PUZZLE_SWAPS(tpBoard)
        for tpN = 0 to tpSwapCount - 1
            tpOthers = PUZZLE_CHECKS - 1
            for tpC = 0 to tpOthers
                if PUZZLE_CHECK_AT(tpC) = tpBoard * 100 + tpN
                    tpPlayMove(PUZZLE_CHECK_MOVE(tpC))
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
                    runto _loop
                    tpHere = tpBoardKey()
                    assert tpHere = PUZZLE_CHECK_KEY(tpC), "the board ends up where the solver says that it does"
                    assert PUZZLE_LOST = PUZZLE_CHECK_LOST(tpC), "and it is lost when the solver says that it is"
                    PUZZLE_UNDO_WANT = 1
                    runto _loop
                    runto _loop
                    assert PUZZLE_LOST = 0, "and it is not, once that is taken back"
                endif
            next
            tpPlay(tpBoard, tpN)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
            runto _loop
        next
    next
    end
endtest


test long_puzzles_all_clear from fishBoard
    if val(env$("FISH_TESTS_LONG")) = 0 then end
    RAINBOW_FISH_ON = 1
    BUBBLED_ON = 1
    for tpBoard = 0 to PUZZLE_COUNT - 1
        tpPuzzleUp(tpBoard)
