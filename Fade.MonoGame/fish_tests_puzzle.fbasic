remstart
    THE TESTS OF THE PUZZLES OF THE LONG VISIT
    see fish_headers_puzzle. a puzzle that cannot be cleared must never ship, so long_puzzles_all_clear
    plays the swaps of every board through the real game, and the other tests look after the rules
    that the swaps were proven with. see the top of fish_tests for how the tests work.
remend

global TP_TALK_TALL = 0
global TP_MOST_WORDS = 0
global TP_PREF_BOARD = 0 `what a mock of get pref says, for the tests that need something to have been saved
global TP_PREF_STAYED = 0
global TP_PRESS = 0 `every key is down while this is 1. a talk is a scene that holds the game, and it needs them.
global TP_WORDS_TOP# = 999 `the highest that a word has been
global TP_PREF_GONE = 0
global TP_WORDS_TOUCHED = 0 `how many times two words touched, and how: in a row, between rows, and between lines
global TP_WORDS_ROW = 0
global TP_WORDS_ROWS = 0
global TP_WORDS_LINES = 0

test puzzle_fish_do_not_come_back from fishBoard
    tpPuzzleUp(0)
    tpBoardWas = puzzleFishLeft()
    assert tpBoardWas > 5, "the first board has fish on it"

    tpPlay(0, 0)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    tpFish = puzzleFishLeft()
    assert tpFish < tpBoardWas, "a swap of the list pops some"
    assert tpFloating() = 0, "and the ones over them have fallen"

    tpSwapCount = PUZZLE_SWAPS(0)
    for tpN = 1 to tpSwapCount - 1
        tpPlay(0, tpN)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    next
    tpFish = puzzleFishLeft()
    assert tpFish = 0, "and the list clears the sea, with nothing dropping in"
    end
endtest


test puzzle_undo_key_counts_while_fish_fall from fishBoard
    tpPuzzleUp(0)
    guideShow()
    tpBoardWas = tpBoardSum()
    tpPlay(0, 0)
    tpTick = 0
    while PUZZLE_UNDO_COUNT = 0 and tpTick < 200
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert PUZZLE_UNDO_COUNT = 1, "the swap has started"

    ` the key is pressed while it is all still going on
    PUZZLE_UNDO_WANT = 1
    tpTick = 0
    while PUZZLE_UNDO_WANT > 0 and tpTick < 2000
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert PUZZLE_UNDO_WANT = 0, "it happens as soon as the fish have stopped"
    tpBoardNow = tpBoardSum()
    assert tpBoardNow = tpBoardWas, "and the board is back"
    end
endtest


test puzzle_she_swims_on_both_sides_of_the_fish from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    assert PUZZLE_IN_FRONT = 0, "she starts behind the fish"

    ` nothing changes while she is over the board
    PUZZLE_SWIM_X# = getCellX(4)
    PUZZLE_GO_X# = getCellX(4) + 1
    PUZZLE_SWIM_Y# = 100
    PUZZLE_GO_Y# = 100
    PUZZLE_WANT_FRONT = 1
    runto _loop
    runto _loop
    assert PUZZLE_IN_FRONT = 0, "she does not change sides in the middle of the fish"

    ` and it does once she is out past the edge
    PUZZLE_SWIM_X# = 2
    PUZZLE_GO_X# = -200
    PUZZLE_GO_Y# = 100
    PUZZLE_WANT_FRONT = 1
    runto _loop
    runto _loop
    assert PUZZLE_IN_FRONT = 1, "she comes around the edge of the board"

    ` she keeps going by herself, wherever she gets to
    PUZZLE_SWIM_SPEED# = 100000
    tpWasX = PUZZLE_GO_X#
    tpTick = 0
    tpMoved = 0
    while tpMoved = 0 and tpTick < 300
        runto _loop
        tpNowX = PUZZLE_GO_X#
        if tpNowX <> tpWasX then tpMoved = 1
        tpTick = tpTick + 1
    endwhile
    assert tpMoved = 1, "she picks somewhere else to swim to"
    end
endtest


test puzzle_she_keeps_out_from_behind_the_fish from fishBoard
    tpPuzzleUp(0)
    tpTop = puzzleFishTop()
    tpFloor = getCellY(CELL_ROW_COUNT - 1) + CELL_SIZE / 2
    tpTall = ANGLER_ART_H * ANGLER_SCALE * PUZZLE_SIZE_NEAR#
    tpCrossed = 0
    tpOver = 0
    tpUnder = 0
    tpBad = 0
    PUZZLE_SWIM_X# = 20
    PUZZLE_SWIM_Y# = 150
    PUZZLE_LANE = -1
    for tpN = 0 to 300
        puzzleSwimNext()
        tpFromX = PUZZLE_SWIM_X#
        tpFromY = PUZZLE_SWIM_Y#
        tpToX = PUZZLE_GO_X#
        tpToY = PUZZLE_GO_Y#
        PUZZLE_SWIM_X# = PUZZLE_GO_X#
        PUZZLE_SWIM_Y# = PUZZLE_GO_Y#
        tpEnded = puzzleOffBoard()
        assert tpEnded = 1, "she always ends up out past the side of the board"

        ` across the board she stays level, in water that has no fish in it
        tpAcross = tpToX - tpFromX
        if tpAcross < 0 then tpAcross = 0 - tpAcross
        if tpAcross > 150
            tpCrossed = tpCrossed + 1
            if tpToY <> tpFromY then tpBad = 1
            tpIsOver = 0
            if tpToY + tpTall <= tpTop then tpIsOver = 1
            tpIsUnder = 0
            if tpToY >= tpFloor then tpIsUnder = 1
            if tpIsOver + tpIsUnder = 0 then tpBad = 1
            tpOver = tpOver + tpIsOver
            tpUnder = tpUnder + tpIsUnder
        endif
    next
    assert tpBad = 0, "she goes around the fish"
    assert tpOver > 0, "over them"
    assert tpUnder > 0, "and under them"
    end
endtest


test puzzle_remembers_that_the_player_stayed from fishBoard
    mock get pref(tpPrefIndex, tpPrefElse)
    endmock tpPrefAt(tpPrefIndex)
    tpStay = puzzleStaying()
    assert tpStay = 0, "nobody has stayed yet"
    tpWant = puzzleWanted()
    assert tpWant = 0, "and a new game is a usual game"

    TP_PREF_STAYED = 1
    tpStay = puzzleStaying()
    assert tpStay = 1, "the game remembers it"
    tpWant = puzzleWanted()
    assert tpWant = 1, "and a new game is a puzzle, with no help from outside"

    PUZZLE_LEFT = 1
    tpWant = puzzleWanted()
    assert tpWant = 0, "until the player tells her that they are leaving"
    PUZZLE_LEFT = 0
    end
endtest


test puzzle_picks_up_where_the_player_left_off from fishBoard
    mock get pref(tpPrefIndex, tpPrefElse)
    endmock tpPrefAt(tpPrefIndex)
    TP_PREF_BOARD = 7
    TP_PREF_STAYED = 1
    puzzleWhere()
    assert PUZZLE_ASK = 1, "New Game has to ask first"
    assert PUZZLE_NOW = 7, "and it knows which board the player got to"

    ` Resume does not ask
    PUZZLE_RESUMED = 1
    puzzleWhere()
    assert PUZZLE_ASK = 0, "Resume goes straight back"
    assert PUZZLE_RESUMED = 0, "only that once"
    assert PUZZLE_NOW = 7, "to the same board"

    ` a number from outside does not take the player back to the start
    mock is env set(tpEnvName$)
    endmock tpEnvName$ = "FISH_PUZZLE"
    mock env$(tpEnvAsked$)
    endmock "1"
    puzzleWhere()
    assert PUZZLE_NOW = 7, "a number is only for when there is nothing to pick up"

    TP_PREF_BOARD = 0
    puzzleWhere()
    assert PUZZLE_NOW = 0, "and then it says where to start"
    end
endtest


test puzzle_words_stay_where_they_come_out from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_SWIM_X# = 300
    PUZZLE_SWIM_Y# = 40
    PUZZLE_LANE = 0
    PUZZLE_SAY_SPEED# = 300
    guideSay(lockey$("angler.puzzle.d4.a"))
    tpFirst = PUZZLE_SAY_FIRST
    tpTick = 0
    while tpTick < 400 and (PUZZLE_SAY_COUNT = 0 or PUZZLE_SAY_OUT < 3)
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpFirst = PUZZLE_SAY_FIRST
    assert PUZZLE_SAY_OUT >= 3, "the words come out"
    tpWasX# = PUZZLE_WORD_X#(tpFirst)
    tpSpeed# = PUZZLE_WORD_X#(tpFirst + 1)
    tpEnd# = tpWasX# + PUZZLE_WORD_W#(tpFirst)
    assert tpSpeed# >= tpEnd#, "and one is not on top of the one before it"

    ` however far she goes, the words stay
    for tpN = 0 to 30
        runto _loop
    next
    tpNow# = PUZZLE_WORD_X#(tpFirst)
    assert tpNow# = tpWasX#, "a word does not move along"
    PUZZLE_SAY_SPEED# = 30
    end
endtest


test puzzle_a_row_under_the_fish_fades_before_the_next_one from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_SAY_SPEED# = 120
    PUZZLE_LANE = 1
    puzzleDebugSay(lockey$("angler.puzzle.d7.b"))
    assert PUZZLE_SAY_ROWS > 1, "it takes a few rows"
    tpFirst = PUZZLE_SAY_FIRST
    tpSecond = -1
    tpN = 0
    while tpN < PUZZLE_SAY_COUNT
        tpSlot = (PUZZLE_SAY_FIRST + tpN) mod PUZZLE_WORD_SLOTS
        if tpSecond < 0 and PUZZLE_WORD_ROW(tpSlot) = 1 then tpSecond = tpSlot
        tpN = tpN + 1
    endwhile
    tpTick = 0
    while PUZZLE_WORD_END(tpFirst) = 0 and tpTick < 3000
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert PUZZLE_WORD_END(tpFirst) > 0, "the row is told to fade"
    tpLift = PUZZLE_WORD_TO_LIFT#(tpFirst)
    assert tpLift = 0, "and it does not move up into the fish"
    assert PUZZLE_WORD_STATE(tpSecond) = 1, "and the next row has not started"

    tpTick = 0
    while PUZZLE_WORD_STATE(tpSecond) = 1 and tpTick < 3000
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert PUZZLE_WORD_STATE(tpFirst) = 0, "the row has gone by the time that the next one starts"
    end
endtest


test puzzle_every_swap_has_to_pop from fishBoard
    tpPuzzleUp(0)
    tpFirstA = PUZZLE_SWAP_A(0)
    tpFirstB = PUZZLE_SWAP_B(0)
    tpNo = puzzleBlocksSwap(tpFirstA, tpFirstB)
    assert tpNo = 0, "the first swap of the list pops, so it can be made"

    tpBlocked = 0
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast - 1
        if CELLS(tpI).value > 0 and CELLS(tpI + 1).value > 0
            tpNo = puzzleBlocksSwap(tpI, tpI + 1)
            tpBlocked = tpBlocked + tpNo
        endif
    next
    assert tpBlocked > 0, "and one that pops nothing cannot"
    tpNoneLeft = puzzleNoMoveLeft()
    assert tpNoneLeft = 0, "and the board is not out of moves"
    end
endtest


test puzzle_hint_clears_a_board_of_each_fish_from_the_start from fishBoard
    RAINBOW_FISH_ON = 1
    for tpRule = 0 to 4
        tpPuzzleUp(tpRule * 6)
        tpFish = puzzleFishLeft()
        tpTurns = 0
        while tpFish > 0 and tpTurns < 40
            tpHintPlay()
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
            tpFish = puzzleFishLeft()
            tpTurns = tpTurns + 1
        endwhile
        assert tpFish = 0, "the hints clear the board"
    next
    end
endtest


test puzzle_hint_says_how_far_to_take_back_a_swap_that_lost from fishBoard
    tpPuzzleUp(0)
    puzzleHint()
    assert PUZZLE_HINT_BACK = 0, "the board can be won from the start"
    tpGoodA = PUZZLE_HINT_A
    tpGoodB = PUZZLE_HINT_B

    ` a swap that pops, and has no way on from it
    tpLost = 0
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        tpTo = tpSwapRight(tpI)
        if tpLost = 0 and tpTo >= 0
            tpQueueSwap(tpI, tpTo)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
            puzzleHint()
            if PUZZLE_HINT_BACK = 1
                tpLost = 1
            else
                puzzleUndo()
            endif
        endif
    next
    assert tpLost = 1, "a swap that lost the board is found"
    assert PUZZLE_HINT_A < 0, "and no fish hops, because there is nothing good to do from here"

    puzzleUndo()
    puzzleHint()
    assert PUZZLE_HINT_BACK = 0, "once it has been taken back, the hint is there again"
    assert PUZZLE_HINT_A + PUZZLE_HINT_B = tpGoodA + tpGoodB, "and it is the same one"
    end
endtest


test puzzle_the_snow_stops_on_a_lost_board_and_she_says_nothing from fishBoard
    tpPuzzleUp(0)
    guideShow()
    PUZZLE_STILL_SECS# = .05
    PUZZLE_STILL_BACK_SECS# = .05
    tpIsLost = puzzleIsLost()
    assert tpIsLost = 0, "the board can be won from the start"

    tpFound = 0
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        tpTo = tpSwapRight(tpI)
        if tpFound = 0 and tpTo >= 0
            tpQueueSwap(tpI, tpTo)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
            tpIsLost = puzzleIsLost()
            if tpIsLost
                runto _loop
                tpNoMove = puzzleNoMoveLeft()
                if tpNoMove = 0 then tpFound = 1
            endif
            if tpFound = 0
                assert PUZZLE_LOST = tpIsLost, "the board is only called lost when it is"
                PUZZLE_UNDO_WANT = 1
                runto _loop
                runto _loop
            endif
        endif
    next
    assert tpFound = 1, "a swap that lost the board and left moves is found"
    assert PUZZLE_LOST = 1, "the water knows"

    tpWaited = 0
    while PUZZLE_STILL# < 1 and tpWaited < 600
        runto _loop
        tpWaited = tpWaited + 1
    endwhile
    assert PUZZLE_STILL# = 1, "the snow stops"
    runto _loop
    tpClockWas# = SEABED_SNOW_CLOCK#
    runto _loop
    runto _loop
    assert SEABED_SNOW_CLOCK# = tpClockWas#, "and it hangs still"
    assert PUZZLE_STUCK_SAID = 0, "and she says nothing while there are moves left"

    PUZZLE_UNDO_WANT = 1
    runto _loop
    runto _loop
    assert PUZZLE_LOST = 0, "a swap taken back is not lost"
    tpWaited = 0
    while PUZZLE_STILL# > 0 and tpWaited < 600
        runto _loop
        tpWaited = tpWaited + 1
    endwhile
    assert PUZZLE_STILL# = 0, "and the snow gets going again"
    tpClockWas# = SEABED_SNOW_CLOCK#
    runto _loop
    runto _loop
    assert SEABED_SNOW_CLOCK# > tpClockWas#, "and it moves"
    end
endtest


test puzzle_she_only_speaks_when_the_snow_has_stopped_and_no_move_is_left from fishBoard
    tpPuzzleUp(0)
    guideShow()
    PUZZLE_STILL_SECS# = 600
    PUZZLE_LOST = 1
    PUZZLE_NO_MOVE = 1
    runto _loop
    runto _loop
    assert PUZZLE_STUCK_SAID = 0, "the snow has not stopped yet"
    PUZZLE_STILL# = 1
    runto _loop
    runto _loop
    assert PUZZLE_STUCK_SAID = 1, "and now there is nothing else to do"
    end
endtest


test puzzle_she_does_not_say_the_board_is_lost_the_same_way_twice from fishBoard
    tpPuzzleUp(0)
    guideShow()
    PUZZLE_ON = 0
    tpDifferent = 0
    tpWas$ = ""
    for tpN = 0 to 30
        puzzleSayLost()
        assert ANGLER_LAST$ <> tpWas$, "it is never the same one twice"
        tpWas$ = ANGLER_LAST$
    next
    end
endtest


test puzzle_hint_stops_once_a_move_is_made from fishBoard
    tpPuzzleUp(0)
    guideShow()
    PUZZLE_HINT_WANT = 1
    runto _loop
    runto _loop
    assert PUZZLE_HINT_WANT = 0, "the button is answered once the fish have stopped"
    assert PUZZLE_HINT_A >= 0, "and a fish hops"
    tpQueueSwap(PUZZLE_HINT_A, PUZZLE_HINT_B)
    runto _loop
    runto _loop
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile
    runto _loop
    assert PUZZLE_HINT_A < 0, "and it is gone after the swap"
    assert PUZZLE_HINT_SAID$ = "", "and so are the words"
    end
endtest


test puzzle_belly_up_fish_pops_when_the_cursor_comes_to_it from fishBoard
    tpPuzzleUp(PUZZLE_NEW_BELLY)
    tpCell = -1
    tpLast = CELL_COUNT - 1
    for tpI = 0 to tpLast
        if CELLS(tpI).bellyUp = 1 and tpCell < 0 then tpCell = tpI
    next
    assert tpCell >= 0, "the board has a belly up fish"
    tpWas = puzzleFishLeft()

    ` from the side that the list of the board does not care about
    tpFromX = tpCell mod PUZZLE_SIDE
    tpDirX = 1
    if tpFromX = PUZZLE_SIDE - 1 then tpDirX = -1
    SELECTION_POS.x = tpFromX + tpDirX
    SELECTION_POS.y = tpCell / PUZZLE_SIDE
    tpStep as vec = {
        x = 0 - tpDirX,
        y = 0
    }
    QUEUED_MOVES(QUEUED_MOVE_NUM) = {
        dir = tpStep
        swap = 0,
        moveBindingIndex = -1
    }
    QUEUED_MOVE_NUM = QUEUED_MOVE_NUM + 1
    tpTick = 0
    tpNow = tpWas
    while tpNow = tpWas and tpTick < 300
        runto _loop
        tpNow = puzzleFishLeft()
        tpTick = tpTick + 1
    endwhile
    assert tpNow < tpWas, "it pops"
    tpBusyNow = tpBusy()
    while tpBusyNow
        runto _loop
        tpBusyNow = tpBusy()
    endwhile

    puzzleUndo()
    tpBack = puzzleFishLeft()
    assert tpBack = tpWas, "and it can be taken back"
    tpTurned = 0
    for tpI = 0 to tpLast
        if CELLS(tpI).bellyUp = 1 then tpTurned = 1
    next
    assert tpTurned = 1, "belly up again"
    end
endtest


test puzzle_words_come_out_of_her_mouth_and_go_over_her_head from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_LANE = 0
    puzzleDebugSay(lockey$("angler.puzzle.d4.a"))
    tpTick = 0
    while PUZZLE_SAY_OUT < 1 and tpTick < 40
        runto _loop
        tpTick = tpTick + 1
    endwhile
    tpFirst = PUZZLE_SAY_FIRST
    assert PUZZLE_SAY_OUT >= 1, "the word comes out"
    tpSwimY# = PUZZLE_SWIM_Y#
    tpRowY# = PUZZLE_WORD_FROM_Y#(tpFirst)
    tpBornY# = PUZZLE_WORD_BORN_Y#(tpFirst)
    assert tpBornY# > tpSwimY#, "it starts at her mouth, inside her picture"
    assert tpRowY# < tpSwimY#, "and its place is over her head"
    tpBornX# = PUZZLE_WORD_BORN_X#(tpFirst)
    tpPlaceX# = PUZZLE_WORD_X#(tpFirst)
    assert tpPlaceX# < tpBornX#, "just behind her mouth"
    assert PUZZLE_WORD_SMALL(tpFirst) = 1, "and it is on its way"

    tpTick = 0
    while PUZZLE_WORD_SMALL(tpFirst) = 1 and tpTick < 200
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert PUZZLE_WORD_SMALL(tpFirst) = 0, "and it gets there"
    end
endtest


test puzzle_words_never_touch from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_SAY_SPEED# = 120
    TP_WORDS_TOUCHED = 0
    TP_WORDS_ROW = 0
    TP_WORDS_ROWS = 0
    TP_WORDS_LINES = 0

    ` a paragraph over the fish, then one under them, then one that follows another with nothing in between, and
    ` then one under the fish that the player hurries
    for tpTurn = 0 to 3
        if tpTurn < 2
            PUZZLE_LANE = tpTurn
            puzzleDebugSay(lockey$("angler.puzzle.d7.b"))
        endif
        if tpTurn = 2
            PUZZLE_LANE = 0
            puzzleDebugSay(lockey$("angler.puzzle.d4.a"))
            guideThen(lockey$("angler.puzzle.d7.b"))
        endif
        if tpTurn = 3
            PUZZLE_LANE = 1
            puzzleDebugSay(lockey$("angler.puzzle.d7.b"))
        endif
        tpTick = 0
        tpQuiet = 0
        while tpQuiet < 60 and tpTick < 4000
            runto _loop
            tpWordsMeasure()
            tpTick = tpTick + 1
            if tpTurn = 3 and tpTick = 120 then guideHurry()
            tpTalking = ANGLER_SPEAKING + GUIDE_QUEUED
            if PUZZLE_SAY_OUT < PUZZLE_SAY_COUNT then tpTalking = 1
            if tpTalking > 0
                tpQuiet = 0
            else
                tpQuiet = tpQuiet + 1
            endif
        endwhile
    next
    assert TP_WORDS_ROW = 0, "no word touches the next one along"
    assert TP_WORDS_ROWS = 0, "or one in another row"
    assert TP_WORDS_LINES = 0, "or one of another line"
    end
endtest


test puzzle_words_never_go_off_the_top_of_the_screen from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()

    ` fish right up to the top of the board, so there is only room for a row over her
    CELLS(4).value = CELLS(58).value
    PUZZLE_SAY_SPEED# = 120
    TP_WORDS_TOP# = 999
    for tpTurn = 0 to 1
        PUZZLE_LANE = 0
        puzzleDebugSay(lockey$("angler.puzzle.d7.b"))
        assert PUZZLE_SAY_ROWS > 1, "it takes more rows than there is room for"
        assert PUZZLE_SAY_FADES = 1, "so they fade, one at a time"
        tpTick = 0
        tpQuiet = 0
        while tpQuiet < 120 and tpTick < 4000
            runto _loop
            tpWordsMeasure()
            tpTick = tpTick + 1
            if tpTurn = 1 and tpTick = 60 then guideHurry()
            tpTalking = ANGLER_SPEAKING + GUIDE_QUEUED
            if PUZZLE_SAY_OUT < PUZZLE_SAY_COUNT then tpTalking = 1
            if tpTalking > 0
                tpQuiet = 0
            else
                tpQuiet = tpQuiet + 1
            endif
        endwhile
    next
    assert TP_WORDS_TOP# < 999, "words came out"
    assert TP_WORDS_TOP# >= PUZZLE_SAY_CEILING - 3, "and none of them went over the top of the screen"
    end
endtest


test puzzle_it_is_dark_down_here_but_it_is_not_night from fishBoard
    tpPuzzleUp(0)
    PUZZLE_DEEP_SHOWN# = 0
    tpTick = 0
    while tpTick < 300
        runto _loop
        tpTick = tpTick + 1
    endwhile
    assert PUZZLE_DEEP_SHOWN# > .1, "it gets dark"
    assert TIDE_NIGHT = 0, "and it is not night"
    assert TIDE_NIGHT_SHOWN# < .01, "and nothing that looks at the night can tell"
    end
endtest


test puzzle_the_pause_menu_has_nothing_that_is_not_down_here from fishBoard
    tpPuzzleUp(0)
    setMenuPage(MENU_PAGE_PAUSE)
    tpMoves = 0
    tpNewGame = 0
    tpCodec = 0
    tpResume = 0
    for tpN = 0 to MENU_PAGE_LENGTH - 1
        if MENU_PAGE_ITEMS(tpN) = MENU_ITEM_MOVES then tpMoves = 1
        if MENU_PAGE_ITEMS(tpN) = MENU_ITEM_NEW_GAME then tpNewGame = 1
        if MENU_PAGE_ITEMS(tpN) = MENU_ITEM_CODEC then tpCodec = 1
        if MENU_PAGE_ITEMS(tpN) = MENU_ITEM_RESUME then tpResume = 1
    next
    assert tpResume = 1, "the game can be gone back to"
    assert tpMoves = 0, "there is no inventory"
    assert tpNewGame = 0, "and a new game is for the main menu"
    assert tpCodec = 0, "and there is nothing to look up"

    PUZZLE_ON = 0
    setMenuPage(MENU_PAGE_PAUSE)
    tpMoves = 0
    for tpN = 0 to MENU_PAGE_LENGTH - 1
        if MENU_PAGE_ITEMS(tpN) = MENU_ITEM_MOVES then tpMoves = 1
    next
    assert tpMoves = 1, "a usual game still has one"
    end
endtest


test puzzle_a_game_goes_where_it_is_told_and_not_where_the_environment_says from fishBoard
    mock get pref(tpPrefIndex, tpPrefElse)
    endmock tpPrefAt(tpPrefIndex)
    mock is env set(tpEnvName$)
    endmock 1
    TP_PREF_STAYED = 0
    TP_PREF_GONE = 0
    PUZZLE_LEFT = 0
    PUZZLE_ENV_SPENT = 0
    OPTION_GAME_INTRO = 0
    tpWanted = puzzleWanted()
    assert tpWanted = 1, "the environment gets a player in"

    OPTION_GAME_INTRO = 1
    tpWanted = puzzleWanted()
    assert tpWanted = 0, "but asking for the intro is asking for the usual game"
    OPTION_GAME_INTRO = 0

    PUZZLE_ENV_SPENT = 1
    tpWanted = puzzleWanted()
    assert tpWanted = 0, "and after that it does not count"

    TP_PREF_STAYED = 1
    tpWanted = puzzleWanted()
    assert tpWanted = 1, "a player who stayed goes back down"

    TP_PREF_GONE = 1
    tpWanted = puzzleWanted()
    assert tpWanted = 0, "but she does not come back"
    TP_PREF_STAYED = 0
    TP_PREF_GONE = 0
    end
endtest


test puzzle_the_ava_window_puts_the_game_in_a_state from fishBoard
    mock get pref(tpPrefIndex, tpPrefElse)
    endmock tpPrefAt(tpPrefIndex)
