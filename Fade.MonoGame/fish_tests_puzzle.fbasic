    runto _loop
    runto _loop
    tpCount = PUZZLE_SAY_COUNT
    assert PUZZLE_SAY_ROWS > 1, "it takes a few rows"
    for tpN = 1 to tpCount - 1
        tpSlot = PUZZLE_SAY_FIRST + tpN
        if PUZZLE_WORD_ROW(tpSlot) <> PUZZLE_WORD_ROW(tpSlot - 1)
            tpLeft# = PUZZLE_WORD_X#(tpSlot)
            tpStart# = PUZZLE_SAY_LEFT#
            assert tpLeft# = tpStart#, "every row starts at the same place"
            tpEnds = puzzleWordEndsPhrase(word of$(ANGLER_LAST$, tpN - 1))
            assert tpEnds = 1, "and the row before it ended on a phrase"
        endif
    next
    end
endtest


test puzzle_a_paragraph_drifts_until_it_is_out_of_the_fish from fishBoard
    tpPuzzleUp(0)
    guideShow()
    puzzleSwimOn()
    PUZZLE_LANE = 0
    PUZZLE_SAY_STAY_MS = 100000
    guideSay(lockey$("angler.puzzle.d1.a"))
    guideHurry()
    runto _loop
    runto _loop
    tpSlot = PUZZLE_SAY_FIRST
    tpTop# = puzzleFishTop()

    ` down in the fish it keeps going up
    tpCount = PUZZLE_SAY_COUNT
    for tpN = 0 to tpCount - 1
        PUZZLE_WORD_FROM_Y#(tpSlot + tpN) = tpTop# + 30
        PUZZLE_WORD_UP#(tpSlot + tpN) = 0
    next
    for tpN = 0 to 10
        runto _loop
    next
    tpUp# = PUZZLE_WORD_UP#(tpSlot)
    assert tpUp# > 0, "it drifts up"

    ` once all of it is out of them, it stops
    for tpN = 0 to tpCount - 1
        PUZZLE_WORD_FROM_Y#(tpSlot + tpN) = tpTop# - 60
        PUZZLE_WORD_UP#(tpSlot + tpN) = 0
    next
    for tpN = 0 to 10
        runto _loop
    next
    tpUp# = PUZZLE_WORD_UP#(tpSlot)
    assert tpUp# = 0, "and it stops once it is clear"

    ` every word of it drifts the same, so the rows stay rows
    for tpN = 0 to tpCount - 1
        PUZZLE_WORD_FROM_Y#(tpSlot + tpN) = tpTop# + 30
        PUZZLE_WORD_UP#(tpSlot + tpN) = 0
    next
    for tpN = 0 to 10
        runto _loop
    next
    tpFar# = PUZZLE_WORD_UP#(tpSlot)
    tpLast# = PUZZLE_WORD_UP#(tpSlot + tpCount - 1)
    assert tpFar# = tpLast#, "all together"
    PUZZLE_SAY_STAY_MS = 2000
    end
endtest


