        endcase
    endselect
endfunction


` the first board with a gate, and the first with a tent, from 0, or -1. see THE FISH in fish_headers_puzzle. a gate is
` two belly up fish on a diagonal, and a tent has one with a belly up fish on both of the diagonals under it.
function puzzleFindGates()
    PUZZLE_NEW_GATE = -1
    PUZZLE_NEW_TENT = -1
    pfgLastBoard = PUZZLE_COUNT - 1
    pfgLastY = PUZZLE_TALL - 2
    pfgLastX = PUZZLE_SIDE - 1
    for pfgBoard = 0 to pfgLastBoard
        for pfgY = 0 to pfgLastY
            pfgRow = PUZZLE_BELLIES(pfgBoard * PUZZLE_SIDE + pfgY)
            pfgBelow = PUZZLE_BELLIES(pfgBoard * PUZZLE_SIDE + pfgY + 1)
            for pfgX = 0 to pfgLastX
                pfgHere = puzzleBit(pfgRow, pfgX)
                if pfgHere
                    pfgLeft = 0
                    pfgRight = 0
                    if pfgX > 0
                        pfgLeft = puzzleBit(pfgBelow, pfgX - 1)
                    endif
                    if pfgX < pfgLastX
                        pfgRight = puzzleBit(pfgBelow, pfgX + 1)
                    endif
                    if pfgLeft + pfgRight > 0
                        if PUZZLE_NEW_GATE < 0 then PUZZLE_NEW_GATE = pfgBoard
                    endif
                    if pfgLeft + pfgRight = 2
                        if PUZZLE_NEW_TENT < 0 then PUZZLE_NEW_TENT = pfgBoard
                    endif
                endif
            next
        next
    next
endfunction
