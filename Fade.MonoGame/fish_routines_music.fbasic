goto routines_music_exit

remstart
    THE MUSIC
    there is no song. the music is made out of parts that the game mixes together as it goes,
    so it never plays the same way twice. there are three kinds of part.

    LAYERS are loops that never stop, like the rumble of the deep, or a chord. a layer is only
    ever turned up and down. setMusicLayer() fades one to a new level.

    there are two SCENES, the surface and the deep, and some layers are only heard in one of
    them. the music drifts from one to the other and back. setMusicDepth() sends it to one.

    SHOTS are sounds that play once, now and then, like a whale. every shot plays on a timer
    of its own, and playMusicShot() plays one right away.

    MELODIES are written by hand, as notes, in setup_melodies, which is right below this.
    one is picked at random every so often. playRandomMelody() and playMelody() start one
    right away, and playMusicNote() plays a single note. a melody is played on one of a
    few instruments, and it can ask for the chord that suits it.

    all of the notes are from one scale, and both of the chords fit that scale. so most
    notes sound fine at any time, and a melody does not have to care which chord is up.

    the game can call any of those functions when something happens. the rest of it runs
    itself: the chords take turns, some of the layers wander up and down, and the timers go.
    the numbers that decide how often are in fish_headers, under THE MUSIC.

    updateMusic() has to be called on every frame, the same as updateBubbles().

    the sounds were made by Tools/ocean_music_gen.py, and the voices of the coral by Tools/coral_voices_gen.py.
remend


` THE MELODIES. this is the place to write new ones.
`
` newMelody() starts one. it says how many milliseconds a beat lasts, which instrument plays it
` (INSTRUMENT_BELL, INSTRUMENT_PLUCK, INSTRUMENT_SWELL, INSTRUMENT_CHOIR or INSTRUMENT_WAIL), and which chord it wants underneath it
` (MUSIC_CHORD_DM, MUSIC_CHORD_BB, or MUSIC_CHORD_ANY if it does not care). a melody that wants
` a chord brings that chord in before it starts, and keeps it there until it is over.
`
` after that, every melodyBar() adds 8 beats to it, and every melodyBar9() adds 9, for tunes that
` count in threes. a beat is a note, or it is REST for a beat of silence. a note rings for a few
` seconds, so a held note is written as a note with rests after it.
`
` these are the notes, from low to high:   D4 E4 F4 G4 A4 Bb4 C5   D5 E5 F5 G5 A5 Bb5 C6
` D, F, G, A and C sound fine over anything. E and Bb (B flat) have more color, and are there
` for tunes that need them.
`
` there can be MELODY_MAX melodies, and a melody can have as many bars as it likes.
`
` all of these tunes are old enough to belong to everybody. they are moved into the key of the
` game, and only the top line is played, so they are close to the real thing and not the same as it.
setup_melodies:

    ` "clair de lune", by debussy (1905). the first four bars. a bar of it is 9 beats.
    newMelody(520, INSTRUMENT_BELL, MUSIC_CHORD_DM)
    melodyBar9(REST, C5, C6, REST, REST, REST, A5, REST, REST)
    melodyBar9(REST, G5, A5, G5, REST, REST, REST, REST, REST)
    melodyBar9(REST, F5, G5, F5, REST, A5, REST, REST, F5)
    melodyBar9(REST, E5, F5, E5, REST, REST, REST, REST, REST)

    ` "clair de lune", the four bars after that, where the line winds its way down
    newMelody(520, INSTRUMENT_BELL, MUSIC_CHORD_BB)
    melodyBar9(REST, D5, E5, D5, G5, D5, C5, D5, C5)
    melodyBar9(REST, Bb4, C5, Bb4, REST, REST, A4, REST, REST)
    melodyBar9(REST, A4, Bb4, A4, D5, A4, G4, A4, G4)
    melodyBar9(REST, F4, G4, F4, REST, REST, E4, REST, REST)

    ` "arabesque no. 1", by debussy (1891). the tune that tumbles down, from the sixth bar. it goes in threes.
    newMelody(260, INSTRUMENT_PLUCK, MUSIC_CHORD_ANY)
    melodyBar(F5, G5, D5, F5, C5, D5, A4, C5)
    melodyBar(G4, A4, F4, A4, E4, REST, REST, REST)
    melodyBar(REST, REST, D4, REST, REST, REST, REST, REST)

    ` "arabesque no. 1", the slow line that rises out of the opening, from the third bar
    newMelody(700, INSTRUMENT_BELL, MUSIC_CHORD_BB)
    melodyBar(D5, G5, D5, REST, D5, G5, Bb5, REST)
    melodyBar(Bb5, REST, A5, G5, REST, REST, REST, REST)

    ` "la fille aux cheveux de lin", by debussy (1910). the opening.
    ` this one was written down from memory, and has not been checked against the score.
    newMelody(300, INSTRUMENT_PLUCK, MUSIC_CHORD_ANY)
    melodyBar(C5, REST, REST, REST, REST, REST, A4, F4)
    melodyBar(D4, REST, F4, A4, C5, REST, A4, F4)
    melodyBar(D4, REST, REST, REST, REST, REST, REST, REST)

    ` "gymnopedie no. 1", by satie (1888). the first phrase.
    ` this one was written down from memory too.
    newMelody(1000, INSTRUMENT_SWELL, MUSIC_CHORD_BB)
    melodyBar(A5, C6, Bb5, A5, E5, D5, E5, F5)
    melodyBar(C5, REST, REST, REST, REST, REST, A4, REST)

    ` the melodies up to here take turns on their own. the ones from here on only play when the game asks for them.
    MELODY_AUTO_COUNT = MELODY_COUNT

    ` THE MUSIC OF THE CORAL. see fish_headers. a note that is played again while it is still ringing
    ` starts over, which cuts it short, so these tunes hold a note where the real thing says it twice.

    ` the tunes of praise, for when coral grows. the choir sings them. they are glad, and a little sad
    ` with it: slow, with long notes that are left to ring into each other, and most of them fall
    ` more than they rise. and they are short. each one is a single phrase, a handful of notes, with
    ` the last note starting within about five seconds of the first, so that it is an answer to the
    ` coral growing and is over while that is still what just happened.
    MELODY_CORAL_FIRST = MELODY_COUNT

    ` "going home", the slow tune of the new world symphony, by dvorak (1893). the first two bars.
    newMelody(420, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(A4, REST, REST, C5, REST, REST, REST, REST)
    melodyBar(A4, REST, REST, G4, F4, REST, REST, REST)

    ` the londonderry air, an old irish tune. the way in, and the first climb.
    newMelody(520, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(E4, F4, G4, A4, REST, REST, G4, A4)
    melodyBar(D5, C5, A4, REST, REST, REST, REST, REST)

    ` "amazing grace", to the tune "new britain" (1829). the first three words. a beat is half of a step of it.
    newMelody(520, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar9(C5, REST, F5, REST, REST, REST, A5, F5, A5)

    ` "abide with me", to the tune "eventide" (1861). the first bar and a half.
    newMelody(700, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(A4, REST, REST, G4, F4, REST, C5, REST)

    ` the canon in d, by pachelbel (about 1680). the start of the line that walks down, turned back home.
    newMelody(900, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(A5, G5, F5, E5, F5, REST, REST, REST)

    ` the canon by tallis (1567). the first line.
    newMelody(650, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(F4, REST, E4, F4, REST, G4, REST, A4)

    ` the lullaby by brahms (1868). the first few notes.
    newMelody(520, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(A4, REST, C5, REST, REST, REST, A4, REST)
    melodyBar(C5, REST, REST, REST, REST, REST, REST, REST)

    ` the rest of these are not from anywhere.

    ` up the chord, to the top
    newMelody(650, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(F4, REST, A4, REST, C5, REST, F5, REST)

    ` a sigh that falls, leans on the note above, and settles
    newMelody(600, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(C5, REST, REST, A4, REST, REST, Bb4, REST)
    melodyBar(A4, REST, REST, REST, REST, REST, REST, REST)

    ` a climb, and a drop that stops short of home
    newMelody(650, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(F4, REST, A4, REST, C5, REST, REST, G4)

    ` from high up, down through the one note that aches, to rest
    newMelody(650, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    melodyBar(A5, REST, REST, G5, REST, E5, REST, F5)

    MELODY_CORAL_COUNT = MELODY_COUNT - MELODY_CORAL_FIRST

    ` the laments, for when horror coral grows. the wail sings them, an octave below where they are
    ` written. they are as short as the tunes of praise are.
    MELODY_HORROR_FIRST = MELODY_COUNT

    ` "dies irae", the chant for the dead, from the 1200s. the first line.
    newMelody(650, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(F5, E5, F5, D5, E5, C5, D5, REST)

    ` a walk down to the bottom of the scale. this one is not from anywhere.
    newMelody(650, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(A5, REST, G5, REST, F5, REST, E5, D5)

    ` "veni, veni, emmanuel", a chant from the 1400s. the first line.
    newMelody(600, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(D5, F5, A5, REST, REST, G5, Bb5, A5)

    ` the funeral march, by chopin (1839). the first bar, and the step up that follows it.
    newMelody(520, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(D5, REST, REST, D5, D5, REST, REST, D5)
    melodyBar(F5, REST, REST, REST, REST, REST, REST, REST)

    ` the rest of these are not from anywhere either.

    ` sighs, two notes at a time, each pair lower than the last
    newMelody(700, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(A5, G5, REST, F5, E5, REST, D5, REST)

    ` up the chord, as if there was hope, and back down
    newMelody(650, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(D5, REST, F5, REST, A5, REST, G5, F5)

    ` a cry up to the top, and a fall that does not get all of the way home
    newMelody(650, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(D5, REST, REST, Bb5, REST, A5, REST, G5)

    ` low down, turning around one note, and sinking
    newMelody(650, INSTRUMENT_WAIL, MUSIC_CHORD_DM)
    melodyBar(A4, REST, Bb4, A4, REST, G4, REST, D4)

    MELODY_HORROR_COUNT = MELODY_COUNT - MELODY_HORROR_FIRST

    ` the tunes that are made up on the spot are written into this one. see makeCoralTune.
    MELODY_MADE = MELODY_COUNT
    newMelody(500, INSTRUMENT_CHOIR, MUSIC_CHORD_BB)
    for madeBeat = 1 to MELODY_MADE_BEATS
        melodyBeat(REST)
    next

    ` a tune of praise is made up out of these notes, which sound fine over anything
    CORAL_TUNE_SCALE(0) = D4
    CORAL_TUNE_SCALE(1) = F4
    CORAL_TUNE_SCALE(2) = G4
    CORAL_TUNE_SCALE(3) = A4
    CORAL_TUNE_SCALE(4) = C5
    CORAL_TUNE_SCALE(5) = D5
    CORAL_TUNE_SCALE(6) = F5
    CORAL_TUNE_SCALE(7) = G5
    CORAL_TUNE_SCALE(8) = A5
    CORAL_TUNE_SCALE(9) = C6

    ` and it comes to rest on an A or a C, which are these places in that list. it does not go all
    ` of the way home to F, so it is left hanging a little. there is room here for six.
    CORAL_TUNE_ENDS(0) = 3
    CORAL_TUNE_ENDS(1) = 4
    CORAL_TUNE_ENDS(2) = 8
    CORAL_TUNE_ENDS(3) = 9
    CORAL_TUNE_ENDS(4) = 3
    CORAL_TUNE_ENDS(5) = 4

    ` a lament uses every note, and comes to rest on a D or an A
    CORAL_TUNE_ENDS(6) = D4
    CORAL_TUNE_ENDS(7) = A4
    CORAL_TUNE_ENDS(8) = D5
    CORAL_TUNE_ENDS(9) = A5

return


setup_music:

    ` the number is how loud the layer is when it is all the way up, and the scene is where it is heard.

    ` the surface: a rumble, waves breaking, and the pull of the water
    addMusicLayer(MUSIC_LAYER_RUMBLE, "Fish/Audio/Music/loop-rumble", .7, MUSIC_SCENE_SURFACE)
    addMusicLayer(MUSIC_LAYER_WASH, "Fish/Audio/Music/loop-wash", .45, MUSIC_SCENE_SURFACE)
    addMusicLayer(MUSIC_LAYER_CURRENT, "Fish/Audio/Music/loop-current", .35, MUSIC_SCENE_SURFACE)

    ` the deep: a darker rumble with a slow throb, a thin stream of bubbles, the far away crackle of a reef,
    ` and the waves that are breaking up at the surface, which are only a dull roll from down here
    addMusicLayer(MUSIC_LAYER_DEEP, "Fish/Audio/Music/loop-deep", .7, MUSIC_SCENE_DEEP)
    addMusicLayer(MUSIC_LAYER_TRICKLE, "Fish/Audio/Music/loop-trickle", .04, MUSIC_SCENE_DEEP) `it drips, so there is only a hint of it
    addMusicLayer(MUSIC_LAYER_CRACKLE, "Fish/Audio/Music/loop-crackle", .12, MUSIC_SCENE_DEEP)
    addMusicLayer(MUSIC_LAYER_SURF_ABOVE, "Fish/Audio/Music/loop-surf-above", .5, MUSIC_SCENE_DEEP)

    ` and a recording of being under the water. this is the sound of the deep, more than anything else is.
    ` the recording is a quiet one, so this is a copy of it that has been made louder.
    addMusicLayer(MUSIC_LAYER_AMBIENCE, "Fish/Audio/Music/loop-ambience", 1, MUSIC_SCENE_DEEP)

    ` the same recording again, slowed down, which makes it lower and further away. it comes and goes under the other one.
    addMusicLayer(MUSIC_LAYER_AMBIENCE_LOW, "Fish/Audio/Music/loop-ambience-low", .45, MUSIC_SCENE_DEEP)

    ` the chords are heard in both
    addMusicLayer(MUSIC_LAYER_PAD_DM, "Fish/Audio/Music/loop-pad-dm", .45, MUSIC_SCENE_BOTH)
    addMusicLayer(MUSIC_LAYER_PAD_BB, "Fish/Audio/Music/loop-pad-bb", .45, MUSIC_SCENE_BOTH)

    ` these layers wander between two levels on their own. the wash never goes away, and the current comes and goes.
    setMusicLayerDrift(MUSIC_LAYER_WASH, .4, 1)
    setMusicLayerDrift(MUSIC_LAYER_CURRENT, 0, 1)
    setMusicLayerDrift(MUSIC_LAYER_TRICKLE, .3, 1)
    setMusicLayerDrift(MUSIC_LAYER_CRACKLE, .3, 1)
    setMusicLayerDrift(MUSIC_LAYER_SURF_ABOVE, .5, 1)
    setMusicLayerDrift(MUSIC_LAYER_AMBIENCE_LOW, .35, 1)

    ` how loud it is, how far its pitch can wander (in hundredths of an octave), the shortest and
    ` the longest wait before it plays on its own again, in milliseconds, and the scene that it
    ` plays on its own in. a shot with no longest wait never plays on its own.
    addMusicShot(MUSIC_SHOT_PING, "Fish/Audio/Music/shot-ping", .25, 0, 30000, 70000, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_WHALE_LOW, "Fish/Audio/Music/shot-whale-low", .3, 6, 45000, 100000, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_WHALE_HIGH, "Fish/Audio/Music/shot-whale-high", .22, 6, 60000, 130000, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_BUBBLES_SPARSE, "Fish/Audio/Music/shot-bubbles-sparse", .2, 10, 20000, 50000, MUSIC_SCENE_SURFACE)
    addMusicShot(MUSIC_SHOT_BUBBLES_DENSE, "Fish/Audio/Music/shot-bubbles-dense", .2, 10, 50000, 110000, MUSIC_SCENE_SURFACE)
    addMusicShot(MUSIC_SHOT_TANK_CLINK, "Fish/Audio/Music/shot-tank-clink", .18, 3, 40000, 90000, MUSIC_SCENE_DEEP)
    addMusicShot(MUSIC_SHOT_BOAT_PASS, "Fish/Audio/Music/shot-boat-pass", .35, 4, 60000, 140000, MUSIC_SCENE_DEEP)
    addMusicShot(MUSIC_SHOT_DOLPHIN, "Fish/Audio/Music/shot-dolphin", .2, 4, 50000, 120000, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_THUNDER_ABOVE, "Fish/Audio/Music/shot-thunder-above", .45, 5, 70000, 160000, MUSIC_SCENE_DEEP)

    ` the instruments. the name is the start of the name of every one of its sound files,
    ` and the number is how loud it is next to the others.
    addMusicInstrument(INSTRUMENT_BELL, "Fish/Audio/Music/note", 1)
    addMusicInstrument(INSTRUMENT_PLUCK, "Fish/Audio/Music/pluck", 1)
    addMusicInstrument(INSTRUMENT_SWELL, "Fish/Audio/Music/swell", 1)
    addMusicInstrument(INSTRUMENT_CHOIR, "Fish/Audio/Music/choir", 1)
    addMusicInstrument(INSTRUMENT_WAIL, "Fish/Audio/Music/wail", 1)

    ` the screams that come with horror coral. they have no wait, so they never play on their own.
    addMusicShot(MUSIC_SHOT_SCREAM, "Fish/Audio/Music/shot-scream", CORAL_SCREAM_VOLUME#, 5, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_SCREAM_2, "Fish/Audio/Music/shot-scream-2", CORAL_SCREAM_VOLUME#, 5, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_SCREAM_3, "Fish/Audio/Music/shot-scream-3", CORAL_SCREAM_VOLUME#, 5, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_SCREAM_4, "Fish/Audio/Music/shot-scream-4", CORAL_SCREAM_VOLUME#, 5, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_SCREAM_5, "Fish/Audio/Music/shot-scream-5", CORAL_SCREAM_VOLUME#, 5, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_SCREAM_6, "Fish/Audio/Music/shot-scream-6", CORAL_SCREAM_VOLUME#, 5, 0, 0, MUSIC_SCENE_BOTH)

    ` and the slow ones, for the ending with the ancient one
    addMusicShot(MUSIC_SHOT_DIRGE, "Fish/Audio/Music/shot-dirge-1", CORAL_SCREAM_VOLUME#, 0, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_DIRGE_2, "Fish/Audio/Music/shot-dirge-2", CORAL_SCREAM_VOLUME#, 0, 0, 0, MUSIC_SCENE_BOTH)
    addMusicShot(MUSIC_SHOT_DIRGE_3, "Fish/Audio/Music/shot-dirge-3", CORAL_SCREAM_VOLUME#, 0, 0, 0, MUSIC_SCENE_BOTH)

    ` the phrases that are sung when coral grows. see THE RECORDED PRAISE in fish_headers.
    for praiseN = 0 to CORAL_PRAISE_COUNT - 1
        praiseClipId = 0
        praiseSfxId = 0
        reserve sfx clip id(praiseClipId)
        load sfx clip praiseClipId, "Fish/Audio/Music/praise-" + str$(praiseN + 1)
        reserve sfx id(praiseSfxId)
        sfx praiseSfxId, praiseClipId
        set sfx group praiseSfxId, SFX_GROUP_MUSIC
        CORAL_PRAISE_SFX(praiseN) = praiseSfxId
    next

    gosub setup_melodies

    applyMusicVolume()

    ` the music comes in a layer at a time. the current stays away until it wanders in.
    MUSIC_LAST_MS = game ms()
    fadeMusicLayer(MUSIC_LAYER_RUMBLE, 1, 6)
    fadeMusicLayer(MUSIC_LAYER_WASH, 1, 10)

    ` it starts at the surface. the layers of the deep are up already, and are heard once it gets down there.
    fadeMusicLayer(MUSIC_LAYER_DEEP, 1, 1)
    fadeMusicLayer(MUSIC_LAYER_TRICKLE, 1, 1)
    fadeMusicLayer(MUSIC_LAYER_CRACKLE, 1, 1)
    fadeMusicLayer(MUSIC_LAYER_SURF_ABOVE, 1, 1)
    fadeMusicLayer(MUSIC_LAYER_AMBIENCE, 1, 1)
    fadeMusicLayer(MUSIC_LAYER_AMBIENCE_LOW, 1, 1)
    MUSIC_SCENE_MS = MUSIC_LAST_MS + musicWait(MUSIC_SCENE_GAP_MIN, MUSIC_SCENE_GAP_MAX) / 2
    setMusicChord(MUSIC_CHORD_DM, 10)
    MELODY_AUTO_MS = MUSIC_LAST_MS + musicWait(MELODY_GAP_MIN, MELODY_GAP_MAX) / 2

return


routines_music_exit:


` keep the music going. this fades the layers, and plays whatever is due.
` it works out how much time has gone by on its own, so calling it twice on a frame does no harm.
function updateMusic()

    now = game ms()
    elapsed = now - MUSIC_LAST_MS
    if elapsed <= 0 then exitfunction
    MUSIC_LAST_MS = now

    ` the game can stall, when a window is dragged for example, and a fade should not jump when it comes back
    if elapsed > 100 then elapsed = 100
    seconds# = elapsed * .001

    ` the chords take turns
    if MUSIC_CHORD_GAP_MAX > 0 and now >= MUSIC_CHORD_MS
        setMusicChord(1 - MUSIC_CHORD, MUSIC_CHORD_FADE#)
    endif

    ` the music goes down to the deep, and comes back up, in turns
    if MUSIC_SCENE_GAP_MAX > 0 and now >= MUSIC_SCENE_MS
        if MUSIC_DEPTH_TARGET# > .5
            setMusicDepth(0, MUSIC_SCENE_FADE#)
        else
            setMusicDepth(1, MUSIC_SCENE_FADE#)
        endif
    endif

    if MUSIC_DEPTH# <> MUSIC_DEPTH_TARGET#
        change# = MUSIC_DEPTH_SPEED# * seconds#
        if MUSIC_DEPTH# < MUSIC_DEPTH_TARGET#
            MUSIC_DEPTH# = MUSIC_DEPTH# + change#
            if MUSIC_DEPTH# > MUSIC_DEPTH_TARGET# then MUSIC_DEPTH# = MUSIC_DEPTH_TARGET#
        else
            MUSIC_DEPTH# = MUSIC_DEPTH# - change#
            if MUSIC_DEPTH# < MUSIC_DEPTH_TARGET# then MUSIC_DEPTH# = MUSIC_DEPTH_TARGET#
        endif
    endif

    ` the hush comes on, or lifts, a little at a time. see MUSIC_HUSH in fish_headers.
    if MUSIC_HUSH# <> MUSIC_HUSH_TARGET#
        change# = seconds# / MUSIC_HUSH_SECONDS#
        if MUSIC_HUSH# < MUSIC_HUSH_TARGET#
            MUSIC_HUSH# = MUSIC_HUSH# + change#
            if MUSIC_HUSH# > MUSIC_HUSH_TARGET# then MUSIC_HUSH# = MUSIC_HUSH_TARGET#
        else
            MUSIC_HUSH# = MUSIC_HUSH# - change#
            if MUSIC_HUSH# < MUSIC_HUSH_TARGET# then MUSIC_HUSH# = MUSIC_HUSH_TARGET#
        endif
    endif

    for i = 0 to MUSIC_LAYER_COUNT - 1
        l = MUSIC_LAYERS(i)

        ` a layer that wanders picks a new level every so often
        if l.driftMax# > 0 and now >= l.driftMs
            fadeMusicLayer(i, l.driftMin# + (l.driftMax# - l.driftMin#) * rnd(101) * .01, MUSIC_DRIFT_FADE#)
            MUSIC_LAYERS(i).driftMs = now + musicWait(MUSIC_DRIFT_GAP_MIN, MUSIC_DRIFT_GAP_MAX)
            l = MUSIC_LAYERS(i)
        endif

        ` move the level toward where it is going
        if l.level# <> l.target#
            change# = l.speed# * seconds#
            if l.level# < l.target#
                l.level# = l.level# + change#
                if l.level# > l.target# then l.level# = l.target#
            else
                l.level# = l.level# - change#
                if l.level# < l.target# then l.level# = l.target#
            endif
            MUSIC_LAYERS(i) = l
        endif

        ` a layer that belongs to one scene is only as loud as the music is close to that scene
        heard# = l.level# * l.mix#
        if l.scene = MUSIC_SCENE_SURFACE then heard# = heard# * (1 - MUSIC_DEPTH#)
        if l.scene = MUSIC_SCENE_DEEP then heard# = heard# * MUSIC_DEPTH#
        ` a hush takes every layer away but the two that are the sound of deep water, and those come up
        if i = MUSIC_LAYER_RUMBLE or i = MUSIC_LAYER_DEEP
            heard# = heard# + (l.mix# - heard#) * MUSIC_HUSH#
        else
            heard# = heard# * (1 - MUSIC_HUSH#)
        endif
        set sfx volume l.sfxId, heard#
    next

    ` while it is hushed, nothing starts on its own
    if MUSIC_HUSH_TARGET# > 0 then exitfunction

    for i = 0 to MUSIC_SHOT_COUNT - 1
        s = MUSIC_SHOTS(i)
        if s.gapMax > 0 and now >= s.nextMs

            ` a shot that belongs to the other scene waits for another turn
            away = 0
            if s.scene = MUSIC_SCENE_SURFACE and MUSIC_DEPTH# > .5 then away = 1
            if s.scene = MUSIC_SCENE_DEEP and MUSIC_DEPTH# < .5 then away = 1

            if away
                MUSIC_SHOTS(i).nextMs = now + musicWait(s.gapMin, s.gapMax) / 2
            else
                playMusicShot(i)
            endif
        endif
    next

    if MELODY_PLAYING >= 0
        if now >= MELODY_NEXT_MS
            m = MELODY_PLAYING

            ` every note is a little louder or quieter than the last, the way that a person would play it
            playMusicNote(MELODY_INSTRUMENT(m), MELODY_NOTES(MELODY_FIRST(m) + MELODY_STEP), MELODY_VOLUME# * MELODY_GAIN# * (.8 + rnd(21) * .01))

            ` the next beat is timed from when this one was due, so that the beats do not drift.
            ` but if the game stalled, the beats that were missed are not all played at once.
            MELODY_NEXT_MS = MELODY_NEXT_MS + MELODY_BEAT(m)
            if MELODY_NEXT_MS < now then MELODY_NEXT_MS = now + MELODY_BEAT(m)

            MELODY_STEP = MELODY_STEP + 1
            if MELODY_STEP >= MELODY_LENGTH(m)
                MELODY_PLAYING = -1
                MELODY_AUTO_MS = now + musicWait(MELODY_GAP_MIN, MELODY_GAP_MAX)
            endif
        endif
    else
        if MELODY_GAP_MAX > 0 and now >= MELODY_AUTO_MS
            playRandomMelody()
        endif
    endif

endfunction


` fade a layer to a level, from 0 to 1, over some seconds.
` a layer that wanders will leave the level alone for a while, and then go back to wandering.
` setMusicLayerDrift(layer, 0, 0) stops it from wandering at all.
function setMusicLayer(layer, level#, seconds#)
    fadeMusicLayer(layer, level#, seconds#)
    MUSIC_LAYERS(layer).driftMs = game ms() + musicWait(MUSIC_DRIFT_GAP_MIN, MUSIC_DRIFT_GAP_MAX)
endfunction


` make a layer wander between two levels on its own. 0 and 0 makes it stay where it is put.
function setMusicLayerDrift(layer, lowest#, highest#)
    MUSIC_LAYERS(layer).driftMin# = lowest#
    MUSIC_LAYERS(layer).driftMax# = highest#
    MUSIC_LAYERS(layer).driftMs = game ms() + musicWait(MUSIC_DRIFT_GAP_MIN, MUSIC_DRIFT_GAP_MAX)
endfunction


` take the music down to the deep, or back up to the surface, over some seconds.
` the depth is from 0 (the surface) to 1 (the deep), and anything in between is a mix of the two.
` the music goes on drifting between the two afterwards, unless MUSIC_SCENE_GAP_MAX is 0.
function setMusicDepth(depth#, seconds#)
    if depth# < 0 then depth# = 0
    if depth# > 1 then depth# = 1
    if seconds# < .01 then seconds# = .01

    distance# = abs(depth# - MUSIC_DEPTH#)
    MUSIC_DEPTH_TARGET# = depth#
    MUSIC_DEPTH_SPEED# = distance# / seconds#
    MUSIC_SCENE_MS = game ms() + musicWait(MUSIC_SCENE_GAP_MIN, MUSIC_SCENE_GAP_MAX)
endfunction


` bring one of the chords up, and take the other one away, over some seconds.
` the chords go on taking turns afterwards, unless MUSIC_CHORD_GAP_MAX is 0.
function setMusicChord(chord, seconds#)
    MUSIC_CHORD = chord
    MUSIC_CHORD_MS = game ms() + musicWait(MUSIC_CHORD_GAP_MIN, MUSIC_CHORD_GAP_MAX)

    if chord = MUSIC_CHORD_DM
        fadeMusicLayer(MUSIC_LAYER_PAD_DM, 1, seconds#)
        fadeMusicLayer(MUSIC_LAYER_PAD_BB, 0, seconds#)
    else
        fadeMusicLayer(MUSIC_LAYER_PAD_DM, 0, seconds#)
        fadeMusicLayer(MUSIC_LAYER_PAD_BB, 1, seconds#)
    endif
endfunction


` turn all of the music up or down, to match the music option. the options page calls this when the option changes.
function applyMusicVolume()
    set sfx group volume SFX_GROUP_MUSIC, MUSIC_VOLUME# * OPTION_MUSIC * .1
endfunction


` play one of the shots right away. it is a little different every time.
function playMusicShot(shot)
    s = MUSIC_SHOTS(shot)
    set sfx volume s.sfxId, s.volume# * (.8 + rnd(21) * .01)
    set sfx pitch s.sfxId, (rnd(s.wobble * 2 + 1) - s.wobble) * .01
    set sfx pan s.sfxId, (rnd(121) - 60) * .01
    play sfx s.sfxId

    MUSIC_SHOTS(shot).nextMs = game ms() + musicWait(s.gapMin, s.gapMax)
endfunction


` play a single note on one of the instruments. playing a note that is still ringing starts it over.
function playMusicNote(instrument, note, volume#)
    if note = REST then exitfunction

    sfxId = MUSIC_NOTE_SFX(instrument * MUSIC_NOTE_SLOTS + note)
    set sfx volume sfxId, volume# * MUSIC_INSTRUMENT_VOLUME#(instrument)
    set sfx pan sfxId, (rnd(61) - 30) * .01
    play sfx sfxId
endfunction


` start a melody, by its number. the first one in setup_melodies is 0.
` it takes the place of a melody that is already playing.
function playMelody(index)
    if index < 0 or index >= MELODY_COUNT then exitfunction

    now = game ms()
    MELODY_PLAYING = index
    MELODY_LAST = index
    MELODY_STEP = 0
    MELODY_NEXT_MS = now
    MELODY_GAIN# = 1

    chord = MELODY_CHORD(index)
    if chord <> MUSIC_CHORD_ANY
        ` the chord that it wants comes in first, and the melody waits for it
        if chord <> MUSIC_CHORD
            setMusicChord(chord, MUSIC_CHORD_FADE#)
            MELODY_NEXT_MS = now + MUSIC_CHORD_LEAD
        endif

        ` and that chord stays until the last note has rung out
        melodyEnd = MELODY_NEXT_MS + MELODY_LENGTH(index) * MELODY_BEAT(index) + 4000
        if MUSIC_CHORD_MS < melodyEnd then MUSIC_CHORD_MS = melodyEnd
    endif
endfunction


` start a melody that is picked at random. it is never the one that played last.
` only the melodies that take turns on their own are picked from. see MELODY_AUTO_COUNT.
function playRandomMelody()
    if MELODY_AUTO_COUNT = 0 then exitfunction

    index = rnd(MELODY_AUTO_COUNT)
    if index = MELODY_LAST then index = (index + 1) mod MELODY_AUTO_COUNT
    playMelody(index)
endfunction


` THE MUSIC OF THE CORAL. see fish_headers. a song has been cast, and coral has grown: the choir sings
` one of the tunes of praise. or, when `isHorror` is 1, it was horror coral: there is a scream from far
` away, and then one of the laments. either one takes the place of a melody that was playing.
function playCoralMusic(isHorror)
    if MELODY_MADE < 0 then exitfunction

    ` the praise is a recording of a woman singing. see THE RECORDED PRAISE in fish_headers.
    if isHorror = 0
        if CORAL_PRAISE_RECORDED
            playCoralPraise()
            exitfunction
        endif
    endif

    coralTuneFirst = MELODY_CORAL_FIRST
    coralTuneCount = MELODY_CORAL_COUNT
    coralTuneChord = MUSIC_CHORD_BB
    if isHorror
        coralTuneFirst = MELODY_HORROR_FIRST
        coralTuneCount = MELODY_HORROR_COUNT
        coralTuneChord = MUSIC_CHORD_DM
    endif

    ` one of the tunes that has not been heard yet, since the game was opened
    coralTuneLeft = 0
    if coralTuneCount > 0
        for coralTuneN = 0 to coralTuneCount - 1
            if MELODY_HEARD(coralTuneFirst + coralTuneN) = 0 then coralTuneLeft = coralTuneLeft + 1
        next
    endif

    coralTune = MELODY_MADE
    if coralTuneLeft > 0
        coralTunePick = rnd(coralTuneLeft)
        for coralTuneN = 0 to coralTuneCount - 1
            if MELODY_HEARD(coralTuneFirst + coralTuneN) = 0
                if coralTunePick = 0 then coralTune = coralTuneFirst + coralTuneN
                coralTunePick = coralTunePick - 1
            endif
        next
        MELODY_HEARD(coralTune) = 1
    else
        ` they have all been heard, so from here on every tune is a new one
        makeCoralTune(isHorror)
    endif

    ` the chord comes in with the tune, and not ahead of it, because this is an answer to what the player just did
    setMusicChord(coralTuneChord, 3)
    playMelody(coralTune)
    MELODY_GAIN# = CORAL_MUSIC_VOLUME#

    if isHorror
        ` one of the screams is heard first, and the lament comes in under the end of it
        playMusicShot(MUSIC_SHOT_SCREAM + rnd(MUSIC_SCREAM_COUNT))
        MELODY_NEXT_MS = MELODY_NEXT_MS + CORAL_LAMENT_WAIT
        MUSIC_CHORD_MS = MUSIC_CHORD_MS + CORAL_LAMENT_WAIT
    endif
endfunction


` THE RECORDED PRAISE. see fish_headers. sing one of the phrases, over the brighter chord. it takes the
` place of a melody that was playing, and no other melody starts until it has had time to finish.
function playCoralPraise()
    if CORAL_PRAISE_COUNT = 0 then exitfunction

    ` how many have not had their turn yet. when they all have, they all get another, but the one that
    ` just played does not go first.
    praiseLeft = 0
    for praiseI = 0 to CORAL_PRAISE_COUNT - 1
        if CORAL_PRAISE_HEARD(praiseI) = 0 then praiseLeft = praiseLeft + 1
    next
    praiseHeldBack = -1
    if praiseLeft = 0
        for praiseI = 0 to CORAL_PRAISE_COUNT - 1
            CORAL_PRAISE_HEARD(praiseI) = 0
        next
        praiseLeft = CORAL_PRAISE_COUNT
        if CORAL_PRAISE_COUNT > 1
            if CORAL_PRAISE_LAST >= 0
                praiseHeldBack = CORAL_PRAISE_LAST
                CORAL_PRAISE_HEARD(praiseHeldBack) = 1
                praiseLeft = praiseLeft - 1
            endif
        endif
    endif

    praisePick = rnd(praiseLeft)
    praiseNow = -1
    for praiseI = 0 to CORAL_PRAISE_COUNT - 1
        if CORAL_PRAISE_HEARD(praiseI) = 0
            if praisePick = 0 then praiseNow = praiseI
            praisePick = praisePick - 1
        endif
    next

    ` the one that was held back is in for the rest of this time around
    if praiseHeldBack >= 0
        CORAL_PRAISE_HEARD(praiseHeldBack) = 0
    endif
    if praiseNow < 0 then exitfunction
    CORAL_PRAISE_HEARD(praiseNow) = 1
    CORAL_PRAISE_LAST = praiseNow

    ` the brighter chord comes in under it, and stays. a melody that was playing stops, and none starts for a while.
    praiseMs = game ms()
    praiseUntil = praiseMs + CORAL_PRAISE_HOLD
    setMusicChord(MUSIC_CHORD_BB, 3)
    if MUSIC_CHORD_MS < praiseUntil then MUSIC_CHORD_MS = praiseUntil
    MELODY_PLAYING = -1
    if MELODY_AUTO_MS < praiseUntil + MELODY_GAP_MIN then MELODY_AUTO_MS = praiseUntil + MELODY_GAP_MIN

    set sfx volume CORAL_PRAISE_SFX(praiseNow), CORAL_PRAISE_VOLUME#
    set sfx pan CORAL_PRAISE_SFX(praiseNow), 0
    play sfx CORAL_PRAISE_SFX(praiseNow)
endfunction


` make up a tune for the coral, and write it into the melody MELODY_MADE. see THE MUSIC OF THE CORAL in fish_headers.
`
` a tune of praise is an arch: it starts low, climbs for the first half, and comes back down to rest
` on a note of the chord. it only uses the notes that sound fine over anything, and it mostly goes
` from one of them to the next. it is slow, with long notes.
` a lament starts high and sinks, a step at a time, with a step back up now and then, like a sob. it
` uses every note of the scale, it has longer waits in it, and it comes to rest on a D or an A.
`
` either way it is one bar long, and short, like the ones that were written.
function makeCoralTune(isHorror)
    madeFirst = MELODY_FIRST(MELODY_MADE)
    ` one bar, like the ones that were written, and the last note is on the last beat of it
    madeLength = 8
    if madeLength > MELODY_MADE_BEATS then madeLength = MELODY_MADE_BEATS
    madeLastNote = madeLength - 1
    madeHalf = madeLastNote / 2

    ` where it is: a place in CORAL_TUNE_SCALE for praise, and a note for a lament
    madeLowest = 0
    madeHighest = 9
    madeAt = 1 + rnd(3)
    madeAfterRest = 55
    madeAfterNote = 12
    MELODY_BEAT(MELODY_MADE) = 550 + rnd(3) * 50
    MELODY_INSTRUMENT(MELODY_MADE) = INSTRUMENT_CHOIR
    MELODY_CHORD(MELODY_MADE) = MUSIC_CHORD_BB
    if isHorror
        madeLowest = D4
        madeHighest = C6
        madeAt = D5 + rnd(3) * 2
        madeAfterRest = 60
        madeAfterNote = 20
        MELODY_BEAT(MELODY_MADE) = 600 + rnd(3) * 50
        MELODY_INSTRUMENT(MELODY_MADE) = INSTRUMENT_WAIL
        MELODY_CHORD(MELODY_MADE) = MUSIC_CHORD_DM
    endif

    madeRested = 1
    for madeN = 0 to madeLength - 1
        ` is there a note on this beat? the first beat has one, and the last note is where it comes to rest.
        madePlay = 0
        if madeN = 0 then madePlay = 1
        if madeN > 0
            if madeN < madeLastNote
                madeChance = madeAfterNote
                if madeRested then madeChance = madeAfterRest
                if rnd(100) < madeChance then madePlay = 1
            endif
        endif
        if madeN = madeLastNote then madePlay = 2

        ` which way it goes from the note before
        if madePlay = 1
            if madeN > 0
                madeRoll = rnd(100)
                madeMove = 1
                if isHorror
                    madeMove = -1
                    if madeRoll < 10 then madeMove = -2
                    if madeRoll >= 75 then madeMove = 1
                else
                    if madeRoll < 15 then madeMove = 2
                    if madeRoll >= 85 then madeMove = -1
                    if madeN >= madeHalf then madeMove = 0 - madeMove
                endif

                ` it turns around at the top and at the bottom
                madeTo = madeAt + madeMove
                if madeTo > madeHighest then madeTo = madeAt - 1
                if madeTo < madeLowest then madeTo = madeAt + 1
                madeAt = madeTo
            endif
        endif

        ` the closest place to rest
        if madePlay = 2
            madeEndFirst = 0
            madeEndLast = 5
            if isHorror
                madeEndFirst = 6
                madeEndLast = 9
            endif
            madeBest = CORAL_TUNE_ENDS(madeEndFirst)
            for madeEnd = madeEndFirst to madeEndLast
                madeEndAt = CORAL_TUNE_ENDS(madeEnd)
                if abs(madeEndAt - madeAt) < abs(madeBest - madeAt)
                    madeBest = madeEndAt
                endif
            next
            madeAt = madeBest
        endif

        madeNote = REST
        if madePlay > 0
            madeNote = madeAt
            if isHorror = 0
                madeNote = CORAL_TUNE_SCALE(madeAt)
            endif
        endif
        MELODY_NOTES(madeFirst + madeN) = madeNote

        madeRested = 1
        if madePlay > 0 then madeRested = 0
    next
    MELODY_LENGTH(MELODY_MADE) = madeLength
endfunction


` start writing a new melody. a beat of it lasts this many milliseconds, and it is played on this
` instrument. the chord is the one that it wants underneath it, or MUSIC_CHORD_ANY.
function newMelody(beatMs, instrument, chord)
    if MELODY_COUNT >= MELODY_MAX then exitfunction

    MELODY_FIRST(MELODY_COUNT) = MELODY_NOTE_TOTAL
    MELODY_LENGTH(MELODY_COUNT) = 0
    MELODY_BEAT(MELODY_COUNT) = beatMs
    MELODY_INSTRUMENT(MELODY_COUNT) = instrument
    MELODY_CHORD(MELODY_COUNT) = chord
    MELODY_COUNT = MELODY_COUNT + 1
endfunction


` add 8 beats to the melody that is being written
function melodyBar(n1, n2, n3, n4, n5, n6, n7, n8)
    melodyBeat(n1)
    melodyBeat(n2)
    melodyBeat(n3)
    melodyBeat(n4)
    melodyBeat(n5)
    melodyBeat(n6)
    melodyBeat(n7)
    melodyBeat(n8)
endfunction


` add 9 beats to the melody that is being written, for a tune that counts in threes
function melodyBar9(n1, n2, n3, n4, n5, n6, n7, n8, n9)
    melodyBeat(n1)
    melodyBeat(n2)
    melodyBeat(n3)
    melodyBeat(n4)
    melodyBeat(n5)
    melodyBeat(n6)
    melodyBeat(n7)
    melodyBeat(n8)
    melodyBeat(n9)
endfunction


` add one beat to the melody that is being written
function melodyBeat(note)
    if MELODY_COUNT = 0 or MELODY_NOTE_TOTAL >= MELODY_NOTE_MAX then exitfunction

    MELODY_NOTES(MELODY_NOTE_TOTAL) = note
    MELODY_NOTE_TOTAL = MELODY_NOTE_TOTAL + 1
    MELODY_LENGTH(MELODY_COUNT - 1) = MELODY_LENGTH(MELODY_COUNT - 1) + 1
endfunction


` the fade itself. setMusicLayer is the one to call from the game.
function fadeMusicLayer(layer, level#, seconds#)
    if level# < 0 then level# = 0
    if level# > 1 then level# = 1
    if seconds# < .01 then seconds# = .01

    distance# = abs(level# - MUSIC_LAYERS(layer).level#)
    MUSIC_LAYERS(layer).target# = level#
    MUSIC_LAYERS(layer).speed# = distance# / seconds#
endfunction


` a wait of a random length, in milliseconds
function musicWait(shortest, longest)
    waitMs = shortest
    if longest > shortest then waitMs = shortest + rnd(longest + 1 - shortest)
endfunction waitMs


` load a loop, and start it playing with the volume all the way down
function addMusicLayer(layer, path$, mix#, scene)
    clipId = 0
    sfxId = 0
    reserve sfx clip id(clipId)
    load sfx clip clipId, path$
    reserve sfx id(sfxId)
    sfx sfxId, clipId
    set sfx group sfxId, SFX_GROUP_MUSIC
    set sfx loop sfxId, 1
    set sfx volume sfxId, 0
    play sfx sfxId

    MUSIC_LAYERS(layer).sfxId = sfxId
    MUSIC_LAYERS(layer).mix# = mix#
    MUSIC_LAYERS(layer).scene = scene
endfunction


function addMusicShot(shot, path$, volume#, wobble, gapMin, gapMax, scene)
    clipId = 0
    sfxId = 0
    reserve sfx clip id(clipId)
    load sfx clip clipId, path$
    reserve sfx id(sfxId)
    sfx sfxId, clipId
    set sfx group sfxId, SFX_GROUP_MUSIC

    MUSIC_SHOTS(shot).sfxId = sfxId
    MUSIC_SHOTS(shot).volume# = volume#
    MUSIC_SHOTS(shot).wobble = wobble
    MUSIC_SHOTS(shot).gapMin = gapMin
    MUSIC_SHOTS(shot).gapMax = gapMax
    MUSIC_SHOTS(shot).scene = scene
    MUSIC_SHOTS(shot).nextMs = game ms() + musicWait(gapMin, gapMax)
endfunction


` load every note of an instrument. the files are named for the notes, like "pluck-bb4".
function addMusicInstrument(instrument, name$, volume#)
    MUSIC_INSTRUMENT_VOLUME#(instrument) = volume#

    addMusicNote(instrument, D4, name$ + "-d4")
    addMusicNote(instrument, E4, name$ + "-e4")
    addMusicNote(instrument, F4, name$ + "-f4")
    addMusicNote(instrument, G4, name$ + "-g4")
    addMusicNote(instrument, A4, name$ + "-a4")
    addMusicNote(instrument, Bb4, name$ + "-bb4")
    addMusicNote(instrument, C5, name$ + "-c5")
    addMusicNote(instrument, D5, name$ + "-d5")
    addMusicNote(instrument, E5, name$ + "-e5")
    addMusicNote(instrument, F5, name$ + "-f5")
    addMusicNote(instrument, G5, name$ + "-g5")
    addMusicNote(instrument, A5, name$ + "-a5")
    addMusicNote(instrument, Bb5, name$ + "-bb5")
    addMusicNote(instrument, C6, name$ + "-c6")
endfunction


function addMusicNote(instrument, note, path$)
    clipId = 0
    sfxId = 0
    reserve sfx clip id(clipId)
    load sfx clip clipId, path$
    reserve sfx id(sfxId)
    sfx sfxId, clipId
    set sfx group sfxId, SFX_GROUP_MUSIC

    MUSIC_NOTE_SFX(instrument * MUSIC_NOTE_SLOTS + note) = sfxId
endfunction
