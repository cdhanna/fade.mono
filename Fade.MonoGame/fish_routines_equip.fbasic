goto routines_equip_exit

remstart
    EQUIPPING A MOVE
    the screen that puts the moves in their slots, where every slot is a button.
    see EQUIPPING A MOVE in fish_headers for the rules.

    it is a page of the upgrade screen. it borrows the title and the bright outline of the upgrade
    screen, and it is drawn to the same render target. see THE UPGRADE WIPE in fish_routines_upgrade.

    there are two ways in:
    - handle_move_equip, when a move is picked on the upgrade screen. the upgrade screen is already
      up, and handle_ability_selection carries on with closing it when this is done.
    - handle_move_rearrange, at any other time, to move the moves between the buttons. it brings
      the upgrade screen up with nothing else on it, and takes it away again.

    the names in here all start with "equip", because this runs in the middle of
    handle_ability_selection, and it must not touch anything that it is in the middle of using.
remend

setup_move_equip:

    EQUIP_ROW_X = (WORLD_WIDTH - EQUIP_ROW_WIDTH) / 2
    EQUIP_NO_X = EQUIP_ROW_X + EQUIP_ROW_WIDTH + 10 + EQUIP_OPTION_WIDTH / 2
    EQUIP_YES_X = EQUIP_NO_X + EQUIP_OPTION_WIDTH + 8

    ` the fade goes from 0 (put away) to 1 (showing)
    reserve tween id(EQUIP_FADE_TWEEN_ID)
    create basic tween EQUIP_FADE_TWEEN_ID, 0, 0, 1, 0

    ` where the top of the bright outline is, as it slides from row to row
    reserve tween id(EQUIP_CURSOR_TWEEN_ID)
    create basic tween EQUIP_CURSOR_TWEEN_ID, 0, 0, 1, 0

    ` the rows are put where they go when the page is opened, by equip_build_rows, because
    ` which rows there are depends on what the page was opened for
    for i = 0 to EQUIP_ROW_MAX - 1
        equipSetup = EQUIP_ROWS(i)

        reserve sprite id(equipSetup.panelSpriteId)
        reserve text id(equipSetup.keyTextId)
        reserve text id(equipSetup.nameTextId)
        reserve text id(equipSetup.noteTextId)
        equipSetup.border = createInfoBorder(ORDER_ABILITY_ART)

        ` the row is a dark panel with a faint outline, like a card
        sprite equipSetup.panelSpriteId, 0, 0, TEX_PIXEL
        set sprite offset equipSetup.panelSpriteId, 0, 0
        size sprite equipSetup.panelSpriteId, EQUIP_ROW_WIDTH, EQUIP_ROW_HEIGHT
        order sprite equipSetup.panelSpriteId, ORDER_ABILITY_CARD
        hide sprite equipSetup.panelSpriteId

        ` the button of the slot, then the move that is in it, laid out like the list at the side of the board
        text equipSetup.keyTextId, 0, 0, SCORE_FONT, "{move1}"
        enable rich text equipSetup.keyTextId
        set text offset equipSetup.keyTextId, .5, .5
        size text y equipSetup.keyTextId, 16 `the key icons are sharpest at this size
        order text equipSetup.keyTextId, ORDER_ABILITY_TEXT
        hide text equipSetup.keyTextId

        text equipSetup.nameTextId, 0, 0, SCORE_FONT, "empty"
        set text offset equipSetup.nameTextId, 0, 0
        size text x equipSetup.nameTextId, 120, .1, .3
        order text equipSetup.nameTextId, ORDER_ABILITY_TEXT
        hide text equipSetup.nameTextId

        ` a note about the move, at the right end of the row
        text equipSetup.noteTextId, 0, 0, SCORE_FONT, " "
        set text offset equipSetup.noteTextId, 1, 0
        size text y equipSetup.noteTextId, 16
        order text equipSetup.noteTextId, ORDER_ABILITY_TEXT
        hide text equipSetup.noteTextId

        EQUIP_ROWS(i) = equipSetup
    next

    ` what the highlighted move does, above the rows, so that the player does not have to remember the cards
    reserve text id(EQUIP_DESC_TEXT_ID)
    text EQUIP_DESC_TEXT_ID, WORLD_WIDTH / 2, 92, SCORE_FONT, "desc"
    size text y EQUIP_DESC_TEXT_ID, 16
    set text offset EQUIP_DESC_TEXT_ID, .5, 0
    set text wrap EQUIP_DESC_TEXT_ID, 440
    set text align EQUIP_DESC_TEXT_ID, .5
    enable rich text EQUIP_DESC_TEXT_ID
    color text EQUIP_DESC_TEXT_ID, rgb(150, 190, 255)
    order text EQUIP_DESC_TEXT_ID, ORDER_ABILITY_TEXT
    hide text EQUIP_DESC_TEXT_ID

    ` the question takes the place of that, when the player has to be asked if they are sure
    reserve text id(EQUIP_PROMPT_TEXT_ID)
    text EQUIP_PROMPT_TEXT_ID, WORLD_WIDTH / 2, 92, SCORE_FONT, "sure?"
    size text y EQUIP_PROMPT_TEXT_ID, 16
    set text offset EQUIP_PROMPT_TEXT_ID, .5, 0
    set text wrap EQUIP_PROMPT_TEXT_ID, 440
    set text align EQUIP_PROMPT_TEXT_ID, .5
    color text EQUIP_PROMPT_TEXT_ID, rgb(255, 255, 255)
    order text EQUIP_PROMPT_TEXT_ID, ORDER_ABILITY_TEXT
    hide text EQUIP_PROMPT_TEXT_ID

    ` and the two answers go to the right of the highlighted row, with "no" the nearer one.
    ` they are put on that row when the question is asked.
    reserve text id(EQUIP_NO_TEXT_ID)
    text EQUIP_NO_TEXT_ID, EQUIP_NO_X, 0, SCORE_FONT, "No"
    size text y EQUIP_NO_TEXT_ID, 20
    set text offset EQUIP_NO_TEXT_ID, .5, 0
    order text EQUIP_NO_TEXT_ID, ORDER_ABILITY_TEXT
    hide text EQUIP_NO_TEXT_ID

    reserve text id(EQUIP_YES_TEXT_ID)
    text EQUIP_YES_TEXT_ID, EQUIP_YES_X, 0, SCORE_FONT, "Yes"
    size text y EQUIP_YES_TEXT_ID, 20
    set text offset EQUIP_YES_TEXT_ID, .5, 0
    order text EQUIP_YES_TEXT_ID, ORDER_ABILITY_TEXT
    hide text EQUIP_YES_TEXT_ID

    ` the labels sit to the left of the rows that they are about, and end at the edge of the rows.
    ` equip_build_rows puts them next to the right rows.
    reserve text id(EQUIP_INVENTORY_TEXT_ID)
    text EQUIP_INVENTORY_TEXT_ID, EQUIP_ROW_X - 8, 0, SCORE_FONT, "inventory"
    size text y EQUIP_INVENTORY_TEXT_ID, 16
    set text offset EQUIP_INVENTORY_TEXT_ID, 1, 0
    color text EQUIP_INVENTORY_TEXT_ID, rgb(150, 190, 255)
    order text EQUIP_INVENTORY_TEXT_ID, ORDER_ABILITY_TEXT
    hide text EQUIP_INVENTORY_TEXT_ID

    reserve text id(EQUIP_AVAILABLE_TEXT_ID)
    text EQUIP_AVAILABLE_TEXT_ID, EQUIP_ROW_X - 8, 0, SCORE_FONT, "available"
    size text y EQUIP_AVAILABLE_TEXT_ID, 16
    set text offset EQUIP_AVAILABLE_TEXT_ID, 1, 0
    color text EQUIP_AVAILABLE_TEXT_ID, rgb(150, 190, 255)
    order text EQUIP_AVAILABLE_TEXT_ID, ORDER_ABILITY_TEXT
    hide text EQUIP_AVAILABLE_TEXT_ID

return


` the player picked the move `selectedAbilityIndex` on the upgrade screen. when there is a slot that is
` empty, it goes straight into the first one. otherwise it goes in the spare row, and the player has
` to trade it into a slot, or leave it behind.
handle_move_equip:

    equipOpenSlot = -1
    for equipN = 0 to MOVE_SLOTS_OPEN - 1
        if equipOpenSlot < 0
            if MOVE_ABILITY_BINDINGS(equipN).assigned = 0 then equipOpenSlot = equipN
        endif
    next
    if equipOpenSlot >= 0
        grantMoveToSlot(selectedAbilityIndex, equipOpenSlot)
        return
    endif

    ` the cards shrink away, and the title goes with them, because it is about to say something else
    for i = 0 to choiceCount
        create basic tween ABILITY_CHOICES(i).sizeTweenId, get local transform scale x(ABILITY_CHOICES(i).transformId), 0, 200, 0
    next
    showInfoBorder(ABILITY_CURSOR, 0)
    create basic tween ABILITY_SELECT_LABEL_FADE_TWEEN_ID, 1, 0, 200, 0
    while is tween done(ABILITY_SELECT_LABEL_FADE_TWEEN_ID) < 1
        gosub frame_ability_selection
        sync
    endwhile

    set text ABILITY_SELECT_LABEL_TEXT_ID, "Choose a Button"
    size text x ABILITY_SELECT_LABEL_TEXT_ID, 400

    EQUIP_MODE = EQUIP_MODE_UPGRADE
    EQUIP_SPARE = selectedAbilityIndex
    EQUIP_SPARE_LEFT = 0
    gosub equip_build_rows

    ` the new move starts out picked up, with the outline on the first slot
    EQUIP_HELD = 0
    EQUIP_SELECTED = 1
    gosub equip_refresh

    equipCursorY = getEquipRowY(EQUIP_SELECTED)
    create basic tween EQUIP_CURSOR_TWEEN_ID, equipCursorY, equipCursorY, 1, 0
    showInfoBorder(ABILITY_CURSOR, 1)

    create basic tween EQUIP_FADE_TWEEN_ID, 0, 1, 200, 0
    create basic tween ABILITY_SELECT_LABEL_FADE_TWEEN_ID, 0, 1, 200, 0

    gosub equip_run

    ` put the page away. handle_ability_selection closes the rest of the screen after this.
    showInfoBorder(ABILITY_CURSOR, 0)
    create basic tween EQUIP_FADE_TWEEN_ID, 1, 0, 200, 0
    while is tween done(EQUIP_FADE_TWEEN_ID) < 1
        gosub frame_ability_selection
        gosub frame_move_equip
        sync
    endwhile
    gosub equip_hide_rows

    ` whatever was left in the spare row is left behind
    EQUIP_SPARE = -1

return


` open the page to move the moves between the buttons. this can be called at any time that the game
` is being played. set EQUIP_START_SLOT first, to start on the row of that slot.
handle_move_rearrange:

    equipStartSlot = EQUIP_START_SLOT
    EQUIP_START_SLOT = -1
    if MOVE_ABILITY_COUNT <= 0 then return

    ` the moves that are waiting in the queue were aimed at the buttons as they are now
    gosub clear_queued_moves

    set text ABILITY_SELECT_LABEL_TEXT_ID, "Rearrange Moves"
    size text x ABILITY_SELECT_LABEL_TEXT_ID, 400

    EQUIP_MODE = EQUIP_MODE_REARRANGE
    EQUIP_SPARE = -1
    EQUIP_SPARE_LEFT = 0
    gosub equip_build_rows

    EQUIP_HELD = -1
    EQUIP_SELECTED = 0
    for equipN = 0 to EQUIP_ROW_COUNT - 1
        if EQUIP_ROWS(equipN).kind = EQUIP_ROW_SLOT
            if EQUIP_ROWS(equipN).slotIndex = equipStartSlot then EQUIP_SELECTED = equipN
        endif
    next
    gosub equip_refresh

    equipCursorY = getEquipRowY(EQUIP_SELECTED)
    create basic tween EQUIP_CURSOR_TWEEN_ID, equipCursorY, equipCursorY, 1, 0
    showInfoBorder(ABILITY_CURSOR, 1)
    hide text UPGRADE_SKIP_TEXT_ID

    ` the upgrade screen comes up with only this page on it. the wave of bubbles wipes it in, the same
    ` as it does after a round, so everything is put where it ends up first. see handle_ability_selection.
    order text INFO_HINT_TEXT_ID, ORDER_ABILITY_TEXT
    hintMode(0)
    set text render target INFO_HINT_TEXT_ID, TARGET_UPGRADE `the wave of bubbles brings the hints in with the rest of the page
    create basic tween INFO_FADE_TWEEN_ID, 1, 1, 1, 0
    create basic tween ABILITY_SELECT_LABEL_FADE_TWEEN_ID, 1, 1, 1, 0
    create basic tween EQUIP_FADE_TWEEN_ID, 1, 1, 1, 0
    free tween id(titleDropTweenId)
    create basic tween titleDropTweenId, 64, 64, 1, 0
    gosub frame_ability_selection
    gosub frame_move_equip

    TRANSITION_FOR_UPGRADE = 1
    TRANSITION_TO_MENU = 1
    gosub menu_transition
    TRANSITION_FOR_UPGRADE = 0

    gosub equip_run

    ` the screen fades away, just as it is, and the game comes back
    create basic tween INFO_FADE_TWEEN_ID, 1, 0, 400, 0
    while is tween done(INFO_FADE_TWEEN_ID) < 1
        gosub frame_ability_selection
        gosub frame_move_equip
        sync
    endwhile
    hide sprite UPGRADE_COMPOSITE_SPRITE

    ` none of it is being drawn any more, so it can all be put away
    create basic tween INFO_FADE_TWEEN_ID, 0, 0, 1, 0
    create basic tween ABILITY_SELECT_LABEL_FADE_TWEEN_ID, 0, 0, 1, 0
    create basic tween EQUIP_FADE_TWEEN_ID, 0, 0, 1, 0
    showInfoBorder(ABILITY_CURSOR, 0)
    gosub equip_hide_rows
    gosub frame_ability_selection

    ` hand the hint back to the game
    set text INFO_HINT_TEXT_ID, GAME_HINT$
    reset text render target INFO_HINT_TEXT_ID
    hintMode(1)
    order text INFO_HINT_TEXT_ID, 0
    set text alpha INFO_HINT_TEXT_ID, 140

return


` decide which rows the page has, put them where they go, and show them. equip_refresh fills them in.
` the spare row is first, when a new move is waiting for a slot. then there is a row for every slot
` that is open, and the last row is the one that says "done".
equip_build_rows:

    EQUIP_ROW_COUNT = 0
    if EQUIP_MODE = EQUIP_MODE_UPGRADE
        EQUIP_ROWS(EQUIP_ROW_COUNT).kind = EQUIP_ROW_SPARE
        EQUIP_ROWS(EQUIP_ROW_COUNT).slotIndex = -1
        EQUIP_ROW_COUNT = EQUIP_ROW_COUNT + 1
    endif
    for equipN = 0 to MOVE_SLOTS_OPEN - 1
        EQUIP_ROWS(EQUIP_ROW_COUNT).kind = EQUIP_ROW_SLOT
        EQUIP_ROWS(EQUIP_ROW_COUNT).slotIndex = equipN
        EQUIP_ROW_COUNT = EQUIP_ROW_COUNT + 1
    next
    EQUIP_ROWS(EQUIP_ROW_COUNT).kind = EQUIP_ROW_DONE
    EQUIP_ROWS(EQUIP_ROW_COUNT).slotIndex = -1
    EQUIP_ROW_COUNT = EQUIP_ROW_COUNT + 1

    for equipN = 0 to EQUIP_ROW_COUNT - 1
        equipPlace = EQUIP_ROWS(equipN)
        equipPlaceY = getEquipRowY(equipN)

        position sprite equipPlace.panelSpriteId, EQUIP_ROW_X, equipPlaceY
        layoutInfoBorder(equipPlace.border, EQUIP_ROW_X, equipPlaceY, EQUIP_ROW_WIDTH, EQUIP_ROW_HEIGHT)
        set text position equipPlace.keyTextId, EQUIP_ROW_X + 14, equipPlaceY + 11
        set text position equipPlace.nameTextId, EQUIP_ROW_X + 28, equipPlaceY + 1
        set text position equipPlace.noteTextId, EQUIP_ROW_X + EQUIP_ROW_WIDTH - 6, equipPlaceY + 3

        show sprite equipPlace.panelSpriteId
        show text equipPlace.keyTextId
        show text equipPlace.nameTextId
        show text equipPlace.noteTextId
        showInfoBorder(equipPlace.border, 1)
    next

    ` the labels go next to the first row of what they are about. the spare row is row 0 when there is one.
    if EQUIP_MODE = EQUIP_MODE_UPGRADE
        set text position EQUIP_AVAILABLE_TEXT_ID, EQUIP_ROW_X - 8, getEquipRowY(0) + 3
        set text position EQUIP_INVENTORY_TEXT_ID, EQUIP_ROW_X - 8, getEquipRowY(1) + 3
        show text EQUIP_AVAILABLE_TEXT_ID
    else
        set text position EQUIP_INVENTORY_TEXT_ID, EQUIP_ROW_X - 8, getEquipRowY(0) + 3
    endif
    show text EQUIP_INVENTORY_TEXT_ID

    EQUIP_CONFIRMING = 0
    EQUIP_CONFIRM_YES = 0
    show text EQUIP_DESC_TEXT_ID

return


` write what is in every row onto it, and what the highlighted row is, and which keys do what.
` this is called whenever any of that changes.
equip_refresh:

    for equipN = 0 to EQUIP_ROW_COUNT - 1
        equipFill = EQUIP_ROWS(equipN)
        equipFillMove = getEquipRowMove(equipN)

        equipFillName$ = "empty"
        equipFillNote$ = " "
        if equipFillMove >= 0
            equipFillName$ = CARDS(equipFillMove).name$
            equipFillNote$ = str$(CARDS(equipFillMove).moveClock) + " move recharge"
            if CARDS(equipFillMove).moveClock <= 0 then equipFillNote$ = "no recharge"
        endif

        select equipFill.kind
            case EQUIP_ROW_SLOT
                set text equipFill.keyTextId, "{move" + str$(equipFill.slotIndex + 1) + "}"
            endcase
            case EQUIP_ROW_SPARE
                ` it has no button, so it shows the picture that stands for a move instead
                set text equipFill.keyTextId, "{move}"
                if equipFillMove >= 0
                    equipFillNote$ = "no button"
                else
                    equipFillName$ = "nothing"
                endif
            endcase
            case EQUIP_ROW_DONE
                set text equipFill.keyTextId, " "
                equipFillName$ = "done"
            endcase
        endselect

        set text equipFill.nameTextId, equipFillName$
        size text x equipFill.nameTextId, 120, .1, .3 `fit the name to the row, the same as the list at the side of the board
        set text equipFill.noteTextId, equipFillNote$
    next

    ` the line above the rows is about the highlighted row
    equipAboutMove = getEquipRowMove(EQUIP_SELECTED)
    equipAbout$ = "An empty button."
    if equipAboutMove >= 0
        equipAbout$ = CARDS(equipAboutMove).name$ + ": " + CARDS(equipAboutMove).desc$
    endif
    if EQUIP_ROWS(EQUIP_SELECTED).kind = EQUIP_ROW_SPARE
        if equipAboutMove >= 0
            equipAbout$ = equipAbout$ + ". It is not on a button."
        else
            equipAbout$ = "Nothing is waiting for a button."
        endif
    endif
    if EQUIP_ROWS(EQUIP_SELECTED).kind = EQUIP_ROW_DONE
        equipAbout$ = "Back to the game."
        if EQUIP_SPARE >= 0
            equipAbout$ = "Back to the game, without " + CARDS(EQUIP_SPARE).name$ + "."
        endif
    endif
    set text EQUIP_DESC_TEXT_ID, equipAbout$

    if EQUIP_HELD >= 0
        set text INFO_HINT_TEXT_ID, "{dir} choose    {confirm} swap with this    {pause} put down"
    else
        set text INFO_HINT_TEXT_ID, "{dir} choose    {confirm} pick up    {pause} done"
    endif

return


` let the player move the moves around, until they say that they are done
equip_run:

    equipDone = 0
    while equipDone = 0

        ` what the player pressed on this frame
        equipPressConfirm = new action down(ACT_CONFIRM)
        equipPressBack = new action down(ACT_PAUSE)
        equipSide = 0
        if new action down(ACT_RIGHT) then equipSide = 1
        if new action down(ACT_LEFT) then equipSide = -1
        equipDir = 0
        if new action down(ACT_DOWN) then equipDir = 1
        if new action down(ACT_UP) then equipDir = -1

        if EQUIP_CONFIRMING
            ` the player is being asked if they are sure. the answers are side by side, and "yes" is the
            ` far one, so it takes a press of right to get to it. it cannot be picked by leaning on one button.
            if equipSide > 0 then EQUIP_CONFIRM_YES = 1
            if equipSide < 0 then EQUIP_CONFIRM_YES = 0

            equipAnswered = equipPressConfirm

            ` the pause key backs out, the same as it does on the menus
            if equipPressBack
                equipAnswered = 1
                EQUIP_CONFIRM_YES = 0
            endif

            if equipAnswered
                if EQUIP_CONFIRM_YES
                    equipDone = 1
                else
                    ` back to the rows
                    EQUIP_CONFIRMING = 0
                    hide text EQUIP_PROMPT_TEXT_ID
                    hide text EQUIP_NO_TEXT_ID
                    hide text EQUIP_YES_TEXT_ID
                    show text EQUIP_DESC_TEXT_ID
                    gosub equip_refresh
                endif
            endif
        else
            if equipDir <> 0
                ` the outline leaves some bubbles behind on the row that it was around
                spawnWakeBubbles(EQUIP_ROW_X, tweenVal(EQUIP_CURSOR_TWEEN_ID), EQUIP_ROW_WIDTH, EQUIP_ROW_HEIGHT, 8, rgb(255, 255, 255), ORDER_OVERLAY_BUBBLES)

                EQUIP_SELECTED = EQUIP_SELECTED + equipDir
                if EQUIP_SELECTED < 0 then EQUIP_SELECTED = EQUIP_ROW_COUNT - 1
                if EQUIP_SELECTED >= EQUIP_ROW_COUNT then EQUIP_SELECTED = 0

                create basic tween EQUIP_CURSOR_TWEEN_ID, tweenVal(EQUIP_CURSOR_TWEEN_ID), getEquipRowY(EQUIP_SELECTED), 120, 0
                gosub equip_refresh
            endif

            ` the pause key puts down a row that is picked up. with nothing picked up, it is the same as "done".
            equipFinish = 0
            if equipPressBack
                if EQUIP_HELD >= 0
                    EQUIP_HELD = -1
                    gosub equip_refresh
                else
                    equipFinish = 1
                endif
            endif

            if equipPressConfirm
                if EQUIP_ROWS(EQUIP_SELECTED).kind = EQUIP_ROW_DONE
                    equipFinish = 1
                else
                    if EQUIP_HELD < 0
                        ` pick the row up
                        EQUIP_HELD = EQUIP_SELECTED
                    else
                        ` the row that was picked up trades places with this one. on the row that
                        ` it came from, it is only put back down.
                        if EQUIP_HELD <> EQUIP_SELECTED
                            equipUsedSpare = 0
                            if EQUIP_ROWS(EQUIP_HELD).kind = EQUIP_ROW_SPARE then equipUsedSpare = 1
                            if EQUIP_ROWS(EQUIP_SELECTED).kind = EQUIP_ROW_SPARE then equipUsedSpare = 1

                            swapEquipRows(EQUIP_HELD, EQUIP_SELECTED)

                            ` once the new move has a button, the next thing to do is most likely to finish
                            if equipUsedSpare
                                gosub equip_select_done
                            endif
                        endif
                        EQUIP_HELD = -1
                    endif
                    gosub equip_refresh
                endif
            endif

            if equipFinish
                EQUIP_HELD = -1
                if EQUIP_SPARE >= 0
                    ` a move is about to be left behind, so ask first. the answers go on the "done" row.
                    gosub equip_select_done
                    EQUIP_CONFIRMING = 1
                    EQUIP_CONFIRM_YES = 0 `start on "no", so that leaning on the button does not lose a move

                    set text EQUIP_PROMPT_TEXT_ID, "Leave " + CARDS(EQUIP_SPARE).name$ + " behind? You lose it until an upgrade offers it again."
                    equipAnswerY = getEquipRowY(EQUIP_SELECTED) + 1
                    set text position EQUIP_NO_TEXT_ID, EQUIP_NO_X, equipAnswerY
                    set text position EQUIP_YES_TEXT_ID, EQUIP_YES_X, equipAnswerY

                    hide text EQUIP_DESC_TEXT_ID
                    show text EQUIP_PROMPT_TEXT_ID
                    show text EQUIP_NO_TEXT_ID
                    show text EQUIP_YES_TEXT_ID
                    set text INFO_HINT_TEXT_ID, "{dir} choose    {confirm} answer    {pause} go back"
                else
                    equipDone = 1
                endif
            endif
        endif

        gosub frame_ability_selection
        gosub frame_move_equip
        sync
    endwhile

return


` slide the outline to the row that says "done"
equip_select_done:
    EQUIP_SELECTED = EQUIP_ROW_COUNT - 1
    create basic tween EQUIP_CURSOR_TWEEN_ID, tweenVal(EQUIP_CURSOR_TWEEN_ID), getEquipRowY(EQUIP_SELECTED), 120, 0
return


equip_hide_rows:
    for equipN = 0 to EQUIP_ROW_MAX - 1
        hide sprite EQUIP_ROWS(equipN).panelSpriteId
        hide text EQUIP_ROWS(equipN).keyTextId
        hide text EQUIP_ROWS(equipN).nameTextId
        hide text EQUIP_ROWS(equipN).noteTextId
        showInfoBorder(EQUIP_ROWS(equipN).border, 0)
    next
    hide text EQUIP_DESC_TEXT_ID
    hide text EQUIP_PROMPT_TEXT_ID
    hide text EQUIP_NO_TEXT_ID
    hide text EQUIP_YES_TEXT_ID
    hide text EQUIP_INVENTORY_TEXT_ID
    hide text EQUIP_AVAILABLE_TEXT_ID
    EQUIP_CONFIRMING = 0
    EQUIP_HELD = -1
    EQUIP_ROW_COUNT = 0
return


` everything on this page that changes from frame to frame. this comes after frame_ability_selection,
` which puts the bright outline around a card, so that the outline ends up where this page wants it.
frame_move_equip:

    equipFade# = tweenVal(EQUIP_FADE_TWEEN_ID)

    ` the rows are grey. the highlighted one is white, and the one that is picked up is blue, with a
    ` brighter outline, so that it can be seen from wherever the highlight has gone.
    for equipN = 0 to EQUIP_ROW_COUNT - 1
        equipDraw = EQUIP_ROWS(equipN)

        equipR = 140
        equipG = 140
        equipB = 140
        equipKeyAlpha = 130
        equipEdgeR = 130
        equipEdgeG = 130
        equipEdgeB = 135
        equipEdgeAlpha = 160
        if equipN = EQUIP_SELECTED
            equipR = 255
            equipG = 255
            equipB = 255
            equipKeyAlpha = 255
        endif
        if equipN = EQUIP_HELD
            equipR = 110
            equipG = 180
            equipB = 255
            equipKeyAlpha = 255
            equipEdgeR = 110
            equipEdgeG = 180
            equipEdgeB = 255
            equipEdgeAlpha = 255
        endif

        color sprite equipDraw.panelSpriteId, rgb(20, 20, 24, 235 * equipFade#)
        colorInfoBorder(equipDraw.border, rgb(equipEdgeR, equipEdgeG, equipEdgeB, equipEdgeAlpha * equipFade#))

        color text equipDraw.nameTextId, rgb(equipR, equipG, equipB)
        set text alpha equipDraw.nameTextId, 255 * equipFade#
        color text equipDraw.noteTextId, rgb(equipR, equipG, equipB)
        set text alpha equipDraw.noteTextId, 200 * equipFade#
        color text equipDraw.keyTextId, rgb(equipR, equipG, equipB)
        set text alpha equipDraw.keyTextId, equipKeyAlpha * equipFade#
    next

    set text alpha EQUIP_DESC_TEXT_ID, 255 * equipFade#
    set text alpha EQUIP_PROMPT_TEXT_ID, 255 * equipFade#
    set text alpha EQUIP_INVENTORY_TEXT_ID, 255 * equipFade#
    set text alpha EQUIP_AVAILABLE_TEXT_ID, 255 * equipFade#

    ` the bright outline is around the highlighted row, or around the highlighted answer
    if EQUIP_ROW_COUNT > 0
        if EQUIP_CONFIRMING
            equipNoTone = 255
            equipYesTone = 140
            equipOptionX = EQUIP_NO_X
            if EQUIP_CONFIRM_YES
                equipNoTone = 140
                equipYesTone = 255
                equipOptionX = EQUIP_YES_X
            endif
            color text EQUIP_NO_TEXT_ID, rgb(equipNoTone, equipNoTone, equipNoTone)
            set text alpha EQUIP_NO_TEXT_ID, 255 * equipFade#
            color text EQUIP_YES_TEXT_ID, rgb(equipYesTone, equipYesTone, equipYesTone)
            set text alpha EQUIP_YES_TEXT_ID, 255 * equipFade#

            layoutInfoBorder(ABILITY_CURSOR, equipOptionX - EQUIP_OPTION_WIDTH / 2, getEquipRowY(EQUIP_SELECTED) - 2, EQUIP_OPTION_WIDTH, EQUIP_ROW_HEIGHT + 4)
        else
            layoutInfoBorder(ABILITY_CURSOR, EQUIP_ROW_X - 2, tweenVal(EQUIP_CURSOR_TWEEN_ID) - 2, EQUIP_ROW_WIDTH + 4, EQUIP_ROW_HEIGHT + 4)
        endif
    endif

return


routines_equip_exit:


` where the top of a row of the list is. the spare row, when there is one, is the first row, and it
` sits a little apart from the slots.
function getEquipRowY(equipIndex)
    equipTop = EQUIP_ROWS_TOP + equipIndex * (EQUIP_ROW_HEIGHT + EQUIP_ROW_GAP)
    if EQUIP_MODE = EQUIP_MODE_UPGRADE
        if equipIndex > 0 then equipTop = equipTop + EQUIP_SPARE_GAP
    endif
endfunction equipTop


` the card of the move that is in a row of the list, or -1 if there is no move in it
function getEquipRowMove(equipIndex)
    rowMove = -1
    if EQUIP_ROWS(equipIndex).kind = EQUIP_ROW_SPARE then rowMove = EQUIP_SPARE
    if EQUIP_ROWS(equipIndex).kind = EQUIP_ROW_SLOT
        rowSlot = EQUIP_ROWS(equipIndex).slotIndex
        if MOVE_ABILITY_BINDINGS(rowSlot).assigned then rowMove = MOVE_ABILITY_BINDINGS(rowSlot).abilityIndex
    endif
endfunction rowMove


` how many moves the move in a row of the list has to wait before it can be used again
function getEquipRowCooldown(equipIndex)
    rowCooldown = 0
    if EQUIP_ROWS(equipIndex).kind = EQUIP_ROW_SPARE then rowCooldown = EQUIP_SPARE_LEFT
    if EQUIP_ROWS(equipIndex).kind = EQUIP_ROW_SLOT
        rowSlot = EQUIP_ROWS(equipIndex).slotIndex
        if MOVE_ABILITY_BINDINGS(rowSlot).assigned then rowCooldown = MOVE_ABILITY_BINDINGS(rowSlot).movesLeft
    endif
endfunction rowCooldown


` put a move in a row of the list, in place of whatever is there. -1 leaves the row empty.
function setEquipRowMove(equipIndex, abilityIndex, coolMoves)
    if EQUIP_ROWS(equipIndex).kind = EQUIP_ROW_SPARE
        EQUIP_SPARE = abilityIndex
        EQUIP_SPARE_LEFT = coolMoves
    endif
    if EQUIP_ROWS(equipIndex).kind = EQUIP_ROW_SLOT
        rowSlot = EQUIP_ROWS(equipIndex).slotIndex
        ejectMove(rowSlot)
        if abilityIndex >= 0
            grantMoveToSlot(abilityIndex, rowSlot)
            setMoveCooldown(rowSlot, coolMoves)
        endif
    endif
endfunction


` the moves in two rows of the list trade places. a move that is recharging carries on from where it was.
function swapEquipRows(rowA, rowB)
    moveA = getEquipRowMove(rowA)
    coolA = getEquipRowCooldown(rowA)
    moveB = getEquipRowMove(rowB)
    coolB = getEquipRowCooldown(rowB)

    ` both rows are emptied first, so that a move is never in two slots at once
    setEquipRowMove(rowA, -1, 0)
    setEquipRowMove(rowB, -1, 0)
    setEquipRowMove(rowA, moveB, coolB)
    setEquipRowMove(rowB, moveA, coolA)
endfunction
