test quest_pilot_fish_takes_a_ring_with_a_swap_from_it from fishBoard
    testCursor(4, 4)
    questForce(QUEST_PILOT_FISH)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tRing = QUEST_V(1)

    ` the cursor walks onto the ring, and the little fish is one step behind
    questCursorStepped(tRing + 1, tRing)
    assert QUEST_V(0) = tRing + 1, "the little fish is on the cell that the cursor just left"

    ` a swap somewhere else that pops fish does not take the ring
    questSwapDone(tRing + 1, tRing)
    questJudge(1)
    questJudge(0)
    questSettled()
    assert QUEST_PROG_NOW = 0, "a pop while the little fish is not in a ring takes nothing"

    ` a swap that starts on the ring leaves the little fish in it, and if it pops, that takes the ring
    questSwapDone(tRing, tRing + 1)
    questCursorStepped(tRing, tRing + 1)
    assert QUEST_V(0) = tRing, "a swap away from the ring leaves the little fish in it"
    questJudge(1)
    questJudge(0)
    questSettled()
    assert QUEST_PROG_NOW = 1, "and a pop then takes the ring"

    ` a ring is only taken once
    questSwapDone(tRing, tRing + 1)
    questJudge(1)
    questJudge(0)
    questSettled()
    assert QUEST_PROG_NOW = 1, "the same ring does not count twice"
    end
endtest

test quest_descriptions_fit_in_the_codec from fishBoard
    ` how tall the tallest description of a card is, in the codec, where they are known to fit
    tCardTall = 0
    tLastCard = CARD_LENGTH - 1
    for tCard = 0 to tLastCard
        set text CODEC_DESC_TEXT_ID, CARDS(tCard).desc$
        tHigh = get text size y(CODEC_DESC_TEXT_ID)
        if tHigh > tCardTall then tCardTall = tHigh
    next

    ` no description of a quest is taller than that, or than the room that there is under the name
    tQuestTall = 0
    for tQuest = 1 to QUEST_COUNT
        set text CODEC_DESC_TEXT_ID, QUEST_DEFS(tQuest).desc$
        tHigh = get text size y(CODEC_DESC_TEXT_ID)
        if tHigh > tQuestTall then tQuestTall = tHigh
    next
    tRoom = CODEC_TOP + CODEC_HEIGHT
    tRoom = tRoom - CODEC_DETAIL_TOP
    tRoom = tRoom - 43
    tFits = 0
    if tQuestTall <= tCardTall then tFits = 1
    if tQuestTall <= tRoom then tFits = 1
    assert tFits = 1, "the longest description of a quest is no taller than the longest of a card, or fits under the name"
    assert tQuestTall <= tRoom, "and it fits in the room that the codec has under the name"
    end
endtest

test quest_is_written_into_the_log_of_its_round from fishBoard
    ` an upgrade in a round with no quest
    GAME_LOG_COUNT = 0
    CURRENT_MOVE_COUNT = 40
    logUpgrade(7)
    assert logQuestOf(GAME_LOG(0)) = 0, "a round with no quest finished in it has none in the log"
    assert logMoveOf(GAME_LOG(0)) = 40, "the move of the upgrade is what it always was"
    assert GAME_LOG(0) mod 100 = 7, "and so is the card"
    assert GAME_LOG(0) = 4007, "a round with no quest is written exactly as it was before there were quests"

    ` a quest is finished, and the next upgrade carries it
    questForce(QUEST_WAKE)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    questComplete()
    assert QUEST_LOG_PENDING = QUEST_WAKE, "a quest that is finished waits for the upgrade of its round"
    CURRENT_MOVE_COUNT = 95
    logUpgrade(12)
    assert logQuestOf(GAME_LOG(1)) = QUEST_WAKE, "the upgrade of the round says which quest was finished"
    assert logMoveOf(GAME_LOG(1)) = 95, "and its move"
    assert GAME_LOG(1) mod 100 = 12, "and its card"
    assert QUEST_LOG_PENDING = 0, "the next round starts with none"

    ` the round after that has none again
    CURRENT_MOVE_COUNT = 130
    logUpgrade(3)
    assert logQuestOf(GAME_LOG(2)) = 0, "one quest does not carry over to the next round"

    ` the biggest numbers still come apart, and stay inside of what a number can hold
    QUEST_LOG_PENDING = QUEST_COUNT
    CURRENT_MOVE_COUNT = 499999
    logUpgrade(30)
    assert logQuestOf(GAME_LOG(3)) = QUEST_COUNT, "the last quest fits"
    assert logMoveOf(GAME_LOG(3)) = 499999, "with the most moves that are written down"
    assert GAME_LOG(3) mod 100 = 30, "and the last card"
    tPositive = 0
    if GAME_LOG(3) > 0 then tPositive = 1
    assert tPositive = 1, "without running past the biggest number that there is"

    ` a quest that is finished in the last round, after the last upgrade, goes with the count
    QUEST_LOG_PENDING = QUEST_TURTLE
    takeGameLog(0)
    assert logCountOf(HISCORE_LOGS(0)) = 4, "the count of a log is still how many upgrades it has"
    assert logLastQuestOf(HISCORE_LOGS(0)) = QUEST_TURTLE, "and it carries the quest of the last round"
    assert logRowsOf(HISCORE_LOGS(0)) = 5, "the page that shows the game has a row for each upgrade, and one for the last round"
    assert logRowsOf(4) = 4, "a game with no quest in its last round has a row for each upgrade, and no more"

    ` the page that shows the game has the quest in a column of its own
    refreshHighscoreDetails(0, 0)
    tNamedWide# = get text size x(HISCORE_DETAIL_QUEST_TEXTS(1))
    tBlankWide# = get text size x(HISCORE_DETAIL_QUEST_TEXTS(0))
    tNamed = 0
    if tNamedWide# > 10 then tNamed = 1
    tBlank = 0
    if tBlankWide# < 10 then tBlank = 1
    assert tNamed = 1, "the row of the round with a quest names it, in the quest column"
    assert tBlank = 1, "and the row of a round with none is blank there"
    assert logQuestOf(HISCORE_LOGS(2)) = QUEST_WAKE, "the log that a table keeps has the quests in it"

    ` a log from before there were quests reads as it did
    assert logCountOf(37) = 37, "an old count is a count"
    assert logLastQuestOf(37) = 0, "with no quest"
    assert logQuestOf(123456) = 0, "and an old upgrade has no quest"
    assert logMoveOf(123456) = 1234, "and the move that it always had"
    end
endtest

test quest_long_game_is_sixty_rounds from fishBoard
    assert getGameLengthRounds(GAME_LENGTH_LONG) = 60, "a long game has 60 rounds"
    assert getGameLengthRounds(GAME_LENGTH_REGULAR) = 30, "a regular one still has 30"
    assert getGameLengthRounds(GAME_LENGTH_SHORT) = 5, "and a short one 5"

    ` the most bits that a long game can take on steam: every upgrade with the widest gap, and a quest in every round
    tLogBits = 60 * (STEAM_CARD_BITS + STEAM_GAP_BITS_MAX)
    tQuestBits = 60 * (1 + STEAM_QUEST_BITS) + STEAM_QUEST_BITS + 1
    tUsed = STEAM_BIT_LOG + tLogBits + tQuestBits
    tFits = 0
    if tUsed <= STEAM_BITS_TOTAL then tFits = 1
    assert tFits = 1, "the log and the quests of the longest game always fit in a score on steam"
    end
endtest

test quest_is_pointed_out_from_its_pickup from fishBoard
    questForce(QUEST_TURTLE)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_HILITE = 0, "nothing is pointed out while the cursor is on the board"

