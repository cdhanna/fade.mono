    CURRENT_ROUND = 2
    questForce(QUEST_PUFFERS)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_PROG_NEED = 12, "it takes twelve swaps in a row in the first round that has quests"
