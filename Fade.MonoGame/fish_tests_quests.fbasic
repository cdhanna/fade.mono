remstart
    THE TESTS OF THE QUESTS
    see QUESTS in fish_headers_quests, and fish_tests for how the tests work.

    a quest is set up by stepQuest, once the board is still, so a test asks for the quest with
    questForce, says that the board is still, and calls stepQuest itself. most of what a quest does
    comes from being told what happened, so the tests tell it: questSwapDone for a swap,
    questJudge for a look at the board, and questSettled for a board that has gone still.
remend

test quest_none_before_the_third_round from fishBoard
    CURRENT_ROUND = 1
    SCORE_BAR_HOLD = 1
    advanceScoreBar()
    assert QUEST_ID = 0, "the second round has no quest"

    CURRENT_ROUND = 2
    SCORE_BAR_HOLD = 1
    advanceScoreBar()
    assert QUEST_ID = QUEST_LOST_PAIR, "the third round has the first quest of a game, which is the lost pair"
    assert QUEST_INIT_DUE = 1, "and it is set up once the board is still"
    assert QUEST_ARRIVING = 1, "though not right away"

    REQUEST_COMBO_CHECK = 0
    SCORE_BAR_HOLD = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_NONE, "it has not shown up when the round has only just started"

    ` a move pops one group, and that is not enough to bring it
    assert QUEST_DOT_COUNT = 2, "the first round with a quest has two dots, so it takes two groups in one turn"
    questJudge(1)
    assert QUEST_ARRIVE_READY = 0, "one group does not bring the quest"
    assert QUEST_SLOT_ON = 1, "the strip where its name will go is there from this round on"
    assert QUEST_DOTS_MODE = 2, "and the dots say that one was not enough"
    assert QUEST_DOTS_BOUNCE = 1, "one of them bounces, and the other one shakes"

    ` the board goes still, and the next turn starts from nothing
    questJudge(0)
    questSettled()
    questJudge(1)
    assert QUEST_ARRIVE_READY = 0, "one group in the next turn is not added to the one before"
    assert QUEST_DOTS_BOUNCE = 1, "one dot bounces for it"

    ` a second group in that turn does it. all of the dots bounce, and the pickup shows up as the
    ` last of them lands.
    QUEST_DOT_GAP = 0 `the tests do not wait for the dots
    QUEST_DOT_TIME = 0
    REQUEST_COMBO_CHECK = 1
    questJudge(1)
    assert QUEST_ARRIVE_READY = 1, "two groups in one turn bring the quest"
    assert QUEST_DOTS_MODE = 1, "both dots bounce for it"
    assert QUEST_DOTS_BOUNCE = 2, "every one of them"
    assert QUEST_STATE = QSTATE_NONE, "and the pickup is not there until the last dot has landed"
    questStepArrive()
    assert QUEST_STATE = QSTATE_OFFERED, "and then it is, without waiting for the board to be still"
    assert QUEST_ID = QUEST_LOST_PAIR, "it is the first quest of the game"

    ` more groups in the same turn do not swap it for another
    questJudge(3)
    questStepArrive()
    assert QUEST_ID = QUEST_LOST_PAIR, "the turn that brought it does not also swap it"

    ` but another turn that pops enough does
    questJudge(0)
    questSettled()
    questJudge(3)
    assert QUEST_ID = QUEST_LOST_PAIR, "the pickup that is waiting stays until the dots have bounced again"

    ` the old one pops, for a few points, and its cell is empty for a moment
    QUEST_SWAP_GAP = 0 `the tests do not wait for the gap
    tScoreBefore = CURRENT_SCORE
    tPickRow = QUEST_PICK_CELL / CELL_COLUMN_COUNT
    questStepArrive()
    assert CURRENT_SCORE = tScoreBefore + QUEST_SWAP_POINTS, "the pickup that was waiting pops for a few points"
    assert QUEST_PICK_CELL = -1, "and its cell is empty"
    assert QUEST_ID = QUEST_LOST_PAIR, "the next one has not come yet"
    assert INFOS(INFO_INDEX_QUEST_PICK).enabled = 0, "so info mode has nothing there to explain"

    ` and then the next one shows up, in the same cell
    questStepArrive()
    assert QUEST_STATE = QSTATE_OFFERED, "a pickup is waiting again after another turn like that"
    assert QUEST_PICK_CELL / CELL_COLUMN_COUNT = tPickRow, "in the cell that the old one popped in"
    tSwapped = 1
    if QUEST_ID = QUEST_LOST_PAIR then tSwapped = 0
    assert tSwapped = 1, "and it is the pickup of a different quest"
    QUEST_ID = QUEST_LOST_PAIR
    questArriveNow()
    questJudge(0)
    questSettled()
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_OFFERED, "and it has once its wait is over, as a pickup beside the board"
    assert INFOS(INFO_INDEX_QUEST).enabled = 0, "with nothing for info mode to explain yet"
    questPickUp()
    assert QUEST_STATE = QSTATE_ACTIVE, "it starts when it is picked up"
    assert INFOS(INFO_INDEX_QUEST).enabled = 1, "and then info mode explains it"
    tOne = questFindMark(1)
    tTwo = questFindMark(2)
    assert tTwo = tOne + 4, "the lost pair are four cells apart in a row"
    assert QUEST_USED(QUEST_LOST_PAIR) = 1, "and now it has been tried"

    ` once it has been picked up, a turn that pops enough does not swap it for anything
    questJudge(3)
    questStepArrive()
    assert QUEST_ID = QUEST_LOST_PAIR, "a quest that is being played stays"

    ` every fifth round has one more dot, up to eight
    CURRENT_ROUND = QUEST_FIRST_ROUND + 4
    assert questDotCount() = 2, "four rounds on, there are still two dots"
    CURRENT_ROUND = QUEST_FIRST_ROUND + 5
    assert questDotCount() = 3, "five rounds on, there are three"
    CURRENT_ROUND = QUEST_FIRST_ROUND + 11
    assert questDotCount() = 4, "and four from ten rounds on"
    CURRENT_ROUND = QUEST_FIRST_ROUND + 90
    assert questDotCount() = 8, "and never more than eight"
    end
endtest

test quest_that_never_showed_up_does_not_hold_the_upgrade_screen from fishBoard
    ` the round starts with a quest on its way, and no turn ever pops enough to bring it
    CURRENT_ROUND = QUEST_FIRST_ROUND
    SCORE_BAR_HOLD = 1
    advanceScoreBar()
    assert QUEST_ARRIVING = 1, "the quest of the round is on its way"
    tOnItsWay = QUEST_ID
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_NONE, "and has not shown up"

    ` the round ends, the board settles, and the upgrade screen is free to come up
    CURRENT_ROUND = QUEST_FIRST_ROUND + 1
    questRoundEnded()
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert questHoldsRound() = 0, "nothing keeps the upgrade screen waiting"

    ` and it is still on its way in the next round
    SCORE_BAR_HOLD = 1
    advanceScoreBar()
    assert QUEST_ID = tOnItsWay, "the same quest is on its way in the next round"
    assert QUEST_ARRIVING = 1, "still waiting for a turn that pops enough"
    end
endtest

test quest_that_was_waiting_does_not_hold_the_upgrade_screen from fishBoard
    questForce(QUEST_WAKE)
    QUEST_REARM = 0 `as it shows up in a round, waiting to be started
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_OFFERED, "a pickup is waiting beside the board"

    questRoundEnded()
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_OFFERED, "and it is still waiting when the round is over"
    assert questHoldsRound() = 0, "with nothing to keep the upgrade screen waiting"
    end
endtest

test quest_does_not_come_around_twice_in_a_game from fishBoard
    ` every round takes a quest that has not had its turn, until they all have
    for tQuest = 0 to QUEST_COUNT
        QUEST_TEMP(tQuest) = 0
    next
    for tTurn = 1 to QUEST_COUNT
        tPicked = questNextQuest(0)
        if tTurn = 1
            assert tPicked = QUEST_LOST_PAIR, "the first quest of a game is the lost pair"
        endif
        QUEST_TEMP(tPicked) = QUEST_TEMP(tPicked) + 1
        QUEST_USED(tPicked) = 1 `it is picked up, which is what counts as its turn
    next
    tOnce = 1
    for tQuest = 1 to QUEST_COUNT
        if QUEST_TEMP(tQuest) <> 1 then tOnce = 0
    next
    assert tOnce = 1, "the first 32 rounds have each of the 32 quests once"

    tPicked = questNextQuest(0)
    tAgain = 0
    if tPicked >= 1
        if tPicked <= QUEST_COUNT then tAgain = 1
    endif
    assert tAgain = 1, "and then they start to come around again"
    assert QUEST_USED(tPicked) = 0, "with every one of them still to try"

    ` a pickup that is swapped for another is never swapped for itself
    for tTurn = 1 to 40
        tOther = questNextQuest(QUEST_WAKE)
        if tOther = QUEST_WAKE then tAgain = 0
    next
    assert tAgain = 1, "the quest that is waiting is not picked again in its own place"

    ` a quest that the debug window started has had its turn too
    resetQuests()
    questForce(QUEST_WAKE)
    assert QUEST_USED(QUEST_WAKE) = 1, "a quest that was asked for by name has had its turn"

    ` and what has had its turn is saved with the game, as a bit for every quest
    resetQuests()
    assert QUEST_USED(QUEST_WAKE) = 0, "a new game starts with every quest still to come"
    end
endtest

test quest_every_one_runs from fishBoard
    ` every quest is set up, picked up if it has to be, told about a swap that pops three fish and
    ` a swap that pops nothing, and drawn. none of them may bring the game down.
    for tQuest = 1 to QUEST_COUNT
        testBoard()
        testCursor(4, 4)
        questForce(tQuest)
        REQUEST_COMBO_CHECK = 0
        stepQuest()
        assert QUEST_ID = tQuest, "the quest that was asked for is the quest of the round"

        if QUEST_STATE = QSTATE_OFFERED
            questPickUp()
        endif
        assert QUEST_STATE = QSTATE_ACTIVE, "it is being played, once it has been set up and picked up"

        ` a swap that pops the first three fish of the top row
        questSwapDone(40, 41)
        questCursorStepped(40, 41)
        for tPop = 0 to 2
            CELLS(tPop).comboBlownUp = 1
            CELLS(tPop).comboFillId = 300
        next
        tWorth = questGroupScore(300)
        tHeld = questHoldsGroup(300)
        questJudge(1)
        for tPop = 0 to 2
            CELLS(tPop).comboBlownUp = 0
        next
        questAfterPops()
        tKind = questNewFish(0, 3)
        questJudge(0)
        questSettled()
        REQUEST_COMBO_CHECK = 0
        stepQuest()

        ` a swap that pops nothing, twice, with a frame after each
        for tMiss = 1 to 2
            questSwapDone(41, 42)
            questCursorStepped(41, 42)
            tLetOff = questMissLetOff()
            questJudge(0)
            questSettled()
            REQUEST_COMBO_CHECK = 0
            stepQuest()
            questCursorStepped(42, 41)
            stepQuest()
        next

        assert QUEST_ID = tQuest, "and it is still the quest of the round after all of that"
    next

    ` the last one is taken away, and what it put on the board goes with it
    questForce(0)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tSpecial = 0
    tLast = CELL_COUNT - 1
    for tIndex = 0 to tLast
        if CELLS(tIndex).value >= TEX_KRILL then tSpecial = tSpecial + 1
    next
    assert tSpecial = 0, "no fish of a quest's own kind is left on the board"
    end
endtest

test quest_every_one_finishes from fishBoard
    ` finishing a quest counts it, and pays it, whichever quest it is
    for tQuest = 1 to QUEST_COUNT
        testBoard()
        questForce(tQuest)
        REQUEST_COMBO_CHECK = 0
        stepQuest()
        questComplete()
        assert QUEST_STATE = QSTATE_DONE, "the quest is done"
        assert QUESTS_DONE = tQuest, "and it has been counted"
        REQUEST_COMBO_CHECK = 0
        stepQuest()
    next
    end
endtest

test quest_pays_all_that_the_round_still_needs from fishBoard
    SCORE_BAR.startVal = 0
    SCORE_BAR.endVal = 1000
    PROGRESS_BARS(0) = SCORE_BAR
    CURRENT_SCORE = 200
    questForce(QUEST_CONTINUOUS)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert questPayout() = 800, "all of the 800 points that are left"

    questComplete()
    assert CURRENT_SCORE = 1000, "the payout is scored, and that is the round won"
    assert CURRENT_SCORE = SCORE_BAR.endVal, "right to the end of the bar"
    assert QUESTS_DONE = 1, "and the quest is counted"

    ` the points float up off of the little bar in shares, as it drains, and they add up
    assert QUEST_PAY_TEXT_COUNT = 8, "a payout of 800 floats up in eight shares"
    QUEST_PAY_MS = game ms() - QUEST_PAY_TIME
    for tShare = 1 to 8
        questStepPay()
    next
    assert QUEST_PAY_TEXT_N = 8, "every share has floated up by the time that the bar has drained"
    assert QUEST_PAY_GIVEN = 800, "and together they are the whole payout"

    questComplete()
    assert QUESTS_DONE = 1, "a quest is only finished once"
    assert CURRENT_SCORE = 1000, "and only paid once"

    CURRENT_SCORE = 980
    assert questPayout() = 50, "a quest never pays less than a twentieth of the round"
    CURRENT_SCORE = 405
    assert questPayout() = 600, "and it rounds up to the next ten, so that it is never short of the end"
    end
endtest

test quest_sand_dollar_only_breaks_when_a_miss_moved_it from fishBoard
    questForce(QUEST_LEFT_RIGHT)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert CELLS(1).value = TEX_SAND_DOLLAR, "the sand dollar starts one cell in from the top left"

    ` a swap somewhere else that pops nothing
    questSwapDone(testIndex(4, 4), testIndex(5, 4))
    questJudge(0)
    questSettled()
    assert QUEST_STATE = QSTATE_ACTIVE, "a miss that did not move it leaves it alone"
    assert QUEST_INIT_DUE = 0, "and the quest does not start over"

    ` a swap that moves it and pops fish
    CELLS(1).value = CELLS(2).value
    CELLS(2).value = TEX_SAND_DOLLAR
    questSwapDone(1, 2)
    questJudge(1)
    questJudge(0)
    questSettled()
    assert QUEST_STATE = QSTATE_ACTIVE, "a swap that moved it and popped fish is how it travels"
    assert QUEST_PROG_NOW = 2, "and the badge says how far it has got"

    ` a swap that moves it and pops nothing
    CELLS(2).value = CELLS(3).value
    CELLS(3).value = TEX_SAND_DOLLAR
    questSwapDone(2, 3)
    questJudge(0)
    questSettled()
    assert QUEST_INIT_DUE = 1, "a miss that moved it breaks it, and the quest starts over"
    end
endtest

test quest_free_move_can_move_a_quest_thing from fishBoard
    questForce(QUEST_LEFT_RIGHT)
    REQUEST_COMBO_CHECK = 0
    stepQuest()

    ` the swap of the "free move" card moves the sand dollar, and pops nothing
    CELLS(1).value = CELLS(2).value
    CELLS(2).value = TEX_SAND_DOLLAR
    LIVE_MOVE_FREE = 1
    questSwapDone(1, 2)
    LIVE_MOVE_FREE = 0
    questJudge(0)
    questSettled()
    assert QUEST_STATE = QSTATE_ACTIVE, "a free move that moved the sand dollar does not break it"
    assert QUEST_INIT_DUE = 0, "and the quest does not start over"
    assert QUEST_PROG_NOW = 2, "the sand dollar is where the free move put it"
    end
endtest

test quest_has_a_codec_entry_that_is_marked_when_it_is_finished from fishBoard
    assert CODEC_ENTRY_QUEST = CARD_LENGTH + 29,"the quests come after everything else in the codec"
    tEntry = CODEC_ENTRY_QUEST + QUEST_WAKE - 1
    assert getCodecQuest(tEntry) = QUEST_WAKE, "an entry knows which quest it is"
    assert getCodecQuest(CODEC_ENTRY_CROOKED) = 0, "and the entry before the quests is not one"
    assert getCodecPref(tEntry) = QUEST_PREF_SEEN + QUEST_WAKE, "a quest is remembered by its number"
    assert CODEC_SEEN(tEntry) = 0, "a quest is locked to begin with"
    assert QUEST_EVER_DONE(QUEST_WAKE) = 0, "and has never been finished"

    questForce(QUEST_WAKE)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert CODEC_SEEN(tEntry) = 1, "the quest of a round is in the codec"
    assert QUEST_EVER_DONE(QUEST_WAKE) = 0, "but it is not marked until it is finished"

    questComplete()
    assert QUEST_EVER_DONE(QUEST_WAKE) = 1, "and then it is"

    ` a new game does not take the mark away
    resetQuests()
    assert QUEST_EVER_DONE(QUEST_WAKE) = 1, "the mark is for good"
    assert getCodecEntryTex(tEntry) = QUEST_DEFS(QUEST_WAKE).iconTex, "its picture is the one on its badge"
    end
endtest

test quest_pickup_is_off_of_the_board from fishBoard
    questForce(QUEST_REMORA)
    QUEST_REARM = 0 `as it shows up in a round, waiting to be started
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_OFFERED, "the remora waits to be started"
    assert QUEST_PICK_CELL mod CELL_COLUMN_COUNT = CELL_COLUMN_COUNT - 1, "its pickup is beside the last cell of a row"
    tRow = QUEST_PICK_CELL / CELL_COLUMN_COUNT
    tLastColumn = CELL_COLUMN_COUNT - 1

    ` walking onto the cell beside it does nothing, and neither does a push some other way from there
    testCursor(tLastColumn, tRow)
    questCursorStepped(QUEST_PICK_CELL - 1, QUEST_PICK_CELL)
    assert QUEST_STATE = QSTATE_OFFERED, "the cursor coming to the cell beside it does not start it"
    assert questCursorBumped(0, -1, 0) = 0, "a push up from there is not a step out onto it"
    assert questCursorBumped(-1, 0, 0) = 0, "and neither is a push to the left"

    ` nor does a push off of the edge from another row
    testCursor(tLastColumn, tRow + 2)
    assert questCursorBumped(1, 0, 0) = 0, "a push off of the edge from another row is not a step out onto it"

    ` stepping out onto it does not start it. it shows the check mark.
    testCursor(tLastColumn, tRow)
    assert questCursorBumped(1, 0, 0) = 1, "a step off of the edge from the cell beside it goes out onto it"
    assert QUEST_CURSOR_OUT = 1, "and the cursor is out on it"
    assert QUEST_STATE = QSTATE_OFFERED, "which does not start the quest"
    assert SELECTION_POS.x = tLastColumn, "as far as the board knows, the cursor has not moved"

    ` out there, a plain step down does nothing, and a swap down starts the quest
    assert questCursorBumped(0, 1, 0) = 1, "a step down from out there is taken, and does nothing"
    assert QUEST_STATE = QSTATE_OFFERED, "the quest still waits"
    QUEST_ACCEPT_TIME = 0 `the tests do not wait for the swap to play out
    assert questCursorBumped(0, 1, 1) = 1, "a swap down puts the pickup onto the check mark"
    assert QUEST_STATE = QSTATE_OFFERED, "the quest does not start until the swap has played out"
    assert questCursorBumped(-1, 0, 0) = 1, "and nothing else can be done while it plays"
    assert QUEST_CURSOR_OUT = 1, "so the cursor is still out"
    questStepCursorOut()
    assert QUEST_STATE = QSTATE_ACTIVE, "which starts the quest"
    assert QUEST_PICK_CELL / CELL_COLUMN_COUNT = tRow + 1, "the pickup stays where the check mark was, one row down"
    assert QUEST_CURSOR_OUT = 1, "and the cursor stays out on it"
    assert SELECTION_POS.y = tRow + 1, "beside the row that it is in now"

    ` out there, a swap down does nothing, because the X is above it
    assert questCursorBumped(0, 1, 1) = 1, "a swap down from there is taken"
    questStepCursorOut()
    assert QUEST_STATE = QSTATE_ACTIVE, "and does nothing"

    ` stepping back onto the board leaves the quest running
    assert questCursorBumped(-1, 0, 0) = 1, "a step back toward the board is taken"
    assert QUEST_CURSOR_OUT = 0, "and brings the cursor in"
    assert QUEST_STATE = QSTATE_ACTIVE, "with the quest still running"

    ` the pickup is not beside its old row any more
    testCursor(tLastColumn, tRow)
    assert questCursorBumped(1, 0, 0) = 0, "a push off of the edge from the row that it left goes nowhere"

    ` going back out to it, and swapping it up onto the X, drops it
    testCursor(tLastColumn, tRow + 1)
    assert questCursorBumped(1, 0, 0) = 1, "the cursor can go out to the pickup of a quest that is running"
    assert QUEST_STATE = QSTATE_ACTIVE, "which does not drop it"
    assert questCursorBumped(0, -1, 1) = 1, "a swap up puts the pickup onto the X"
    questStepCursorOut()
    assert QUEST_INIT_DUE = 1, "which drops the quest, so that it starts over, waiting"
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_STATE = QSTATE_OFFERED, "it waits to be started again"
    assert QUEST_PICK_CELL / CELL_COLUMN_COUNT = tRow, "with its pickup back in the row that it started in"
    assert QUEST_CURSOR_OUT = 1, "and the cursor still out on it"
    assert SELECTION_POS.y = tRow, "beside that row"
    end
endtest

test quest_seaweed_grows_in_every_column_that_pops_on_the_bottom from fishBoard
    questForce(QUEST_SEAWEED)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tBottom = CELL_ROW_COUNT - 1

    ` there is a stalk in one column already, two tall
    testPut(1, tBottom, TEX_SEAWEED)
    testPut(1, tBottom - 1, TEX_SEAWEED)

    ` three fish pop along the bottom row, in three other columns, and one right on top of the stalk
    CELLS(testIndex(4, tBottom)).comboBlownUp = 1
    CELLS(testIndex(5, tBottom)).comboBlownUp = 1
    CELLS(testIndex(6, tBottom)).comboBlownUp = 1
    CELLS(testIndex(1, tBottom - 2)).comboBlownUp = 1
    ` and one that is not on the bottom row, and has no seaweed under it
    CELLS(testIndex(8, 3)).comboBlownUp = 1
    questJudge(1)
    assert QUEST_REBORN(testIndex(4, tBottom)) = TEX_SEAWEED, "a pop on the bottom row plants seaweed"
    assert QUEST_REBORN(testIndex(5, tBottom)) = TEX_SEAWEED, "in every column that it happens in"
    assert QUEST_REBORN(testIndex(6, tBottom)) = TEX_SEAWEED, "however many there are"
    assert QUEST_REBORN(testIndex(1, tBottom - 2)) = TEX_SEAWEED, "and a pop on top of a stalk grows that stalk"
    assert QUEST_REBORN(testIndex(8, 3)) = 0, "a pop with no seaweed under it, off of the bottom row, plants nothing"

    questAfterPops()
    questJudge(0)
    questSettled()
    assert CELLS(testIndex(5, tBottom)).value = TEX_SEAWEED, "the seaweed is there once the pops are over"
    assert QUEST_PROG_NOW = 3, "and the badge counts the tallest stalk"
    end
endtest

test quest_seaweed_grows_through_coral from fishBoard
    questForce(QUEST_SEAWEED)
    REQUEST_COMBO_CHECK = 0
    stepQuest()

    tBottom = CELL_ROW_COUNT - 1
    testPut(3, tBottom, TEX_SEAWEED)
    CORAL_CELLS(testIndex(3, tBottom - 1)) = 1
    CORAL_CELLS(testIndex(3, tBottom - 2)) = 1
    questSettled()
    assert CELLS(testIndex(3, tBottom - 1)).value = TEX_SEAWEED, "seaweed under coral grows into it right away"
    assert CELLS(testIndex(3, tBottom - 2)).value = TEX_SEAWEED, "and on through the coral above that"
    tAbove = 0
    if CELLS(testIndex(3, tBottom - 3)).value = TEX_SEAWEED then tAbove = 1
    assert tAbove = 0, "and it stops where the coral does"
    assert QUEST_PROG_NOW = 3, "the badge says how tall it is"
    end
endtest

test quest_shark_eats_a_group_two_cells_away from fishBoard
    questForce(QUEST_SHARK)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    questPickUp()
    QUEST_V(0) = testIndex(4, 4)

    ` a group whose nearest fish is two cells from the shark
    testPut(6, 3, 6)
    testPut(7, 3, 6)
    testPut(8, 3, 6)
    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert totalComboCount = 1, "the three fish pop"
    assert CURRENT_SCORE = 0, "and the shark eats them, from two cells away"
    assert QUEST_V(2) = 1, "which it remembers"
    end
endtest

test quest_shark_leaves_a_group_three_cells_away from fishBoard
    questForce(QUEST_SHARK)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    questPickUp()
    QUEST_V(0) = testIndex(4, 4)

    testPut(7, 0, 6)
    testPut(7, 1, 6)
    testPut(8, 1, 6)
    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert totalComboCount = 1, "the three fish pop"
    assert CURRENT_SCORE = 60, "and score, because the shark is three cells away"
    end
endtest

test quest_keeps_its_fish_from_the_stock_market from fishBoard
    assert questKeepsFish(testIndex(2, 2)) = 0, "a plain fish is anyone's"
    QUEST_MARK(testIndex(2, 2)) = 2
    assert questKeepsFish(testIndex(2, 2)) = 1, "a fish that a quest has marked is not"
    testPut(5, 5, TEX_TURTLE)
    assert questKeepsFish(testIndex(5, 5)) = 1, "and neither is a fish of a quest's own kind"
    end
endtest

test quest_turtle_cannot_be_swapped from fishBoard
    testPut(3, 3, TEX_TURTLE)
    assert questLocksCell(testIndex(3, 3)) = 1, "the turtle cannot be swapped"
    assert questLocksCell(testIndex(4, 3)) = 0, "the fish next to it can"

    ` a swap from the turtle, and a swap into it, are both turned down
    testCursor(3, 3)
    assert startLiveMove(1, 0, 1) = 0, "a swap that would carry the turtle away does not start"
    testCursor(2, 3)
    assert startLiveMove(1, 0, 1) = 0, "and neither does a swap that would push a fish into its place"
    assert CELLS(testIndex(3, 3)).value = TEX_TURTLE, "the turtle is where it was"

    ` the cursor can still walk over it
    assert startLiveMove(1, 0, 0) = 1, "the cursor can step onto the turtle without a swap"
    end
endtest

test quest_echo_always_makes_its_swap from fishBoard
    questForce(QUEST_ECHO)
    REQUEST_COMBO_CHECK = 0
    stepQuest()

    ` a swap is remembered, and four more swaps go by somewhere else
    tLeft = CELLS(testIndex(2, 2)).value
    tRight = CELLS(testIndex(3, 2)).value
    questSwapDone(testIndex(2, 2), testIndex(3, 2))
    questJudge(0)
    questSettled()
    for tSwap = 1 to 4
        QUEST_LIST_N = 3 `only the first swap is waiting, so that the swaps that pass the time are not echoed too
        questSwapDone(testIndex(7, 7), testIndex(8, 7))
        questJudge(0)
        questSettled()
    next
    assert CELLS(testIndex(2, 2)).value = tRight, "the ghost made the swap again, though it pops nothing"
    assert CELLS(testIndex(3, 2)).value = tLeft, "so the two fish have traded places"
    assert QUEST_V(0) = 0, "and a swap of the ghost's that pops nothing is not counted"
    end
endtest

test quest_remora_drags_a_long_tail from fishBoard
    questForce(QUEST_REMORA)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_V(1) = 8, "it takes eight swaps that pop fish"

    ` the cursor walks twelve cells, along the top two rows and back, without crossing itself
    for tWalk = 0 to 7
        questCursorStepped(tWalk, tWalk + 1)
    next
    questCursorStepped(8, 17)
    for tWalk = 0 to 2
        questCursorStepped(17 - tWalk, 16 - tWalk)
    next
    assert QUEST_LIST_N = 10, "the tail is ten cells long, and no longer"
    assert QUEST_LIST(0) = 2, "the cells that it has dropped off of are free again"
    assert QUEST_STATE = QSTATE_ACTIVE, "and a walk that does not cross it is fine"

    ` stepping back onto a cell of the tail tangles it
    questCursorStepped(14, 5)
    assert QUEST_INIT_DUE = 1, "crossing the tail starts the quest over"
    end
endtest

test quest_name_shows_while_the_cursor_looks_at_it from fishBoard
    questForce(QUEST_WAKE)
    QUEST_REARM = 0 `as it shows up in a round, waiting to be started
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_PREVIEW = 0, "a quest that is waiting does not show its name"
    assert INFO_SELECTED = INFO_INDEX_QUEST_PICK, "info mode would open on its pickup"
    assert INFOS(INFO_INDEX_QUEST_PICK).enabled = 1, "info mode explains its pickup, beside the board"
    tPickLeft = INFOS(INFO_INDEX_QUEST_PICK).topLeft.x
    tBoardRight = getCellX(CELL_COLUMN_COUNT - 1) + CELL_SIZE / 2
    tOffBoard = 0
    if tPickLeft >= tBoardRight - 2 then tOffBoard = 1
    assert tOffBoard = 1, "which is off of the right edge of the board"

    testCursor(CELL_COLUMN_COUNT - 1, QUEST_PICK_CELL / CELL_COLUMN_COUNT)
    assert questCursorBumped(1, 0, 0) = 1, "the cursor steps out onto the pickup"
    stepQuest()
    assert QUEST_PREVIEW = 1, "and the name shows, for a look"
    assert INFO_SELECTED = INFO_INDEX_QUEST, "and info mode would open on it"
    assert INFOS(INFO_INDEX_QUEST).enabled = 1, "which info mode can explain"
    assert QUEST_SHOWN_KEY = 1, "on the badge"
    assert QUEST_STATE = QSTATE_OFFERED, "without the quest having started"

    assert questCursorBumped(-1, 0, 0) = 1, "the cursor steps back onto the board"
    stepQuest()
    assert QUEST_PREVIEW = 0, "and the name is gone again"
    assert INFOS(INFO_INDEX_QUEST).enabled = 0, "and so is what info mode had to say about it"
    assert INFOS(INFO_INDEX_QUEST_PICK).enabled = 1, "though info mode still explains the pickup beside the board"
    assert QUEST_SHOWN_KEY = 0, "with the badge"

    ` starting it keeps the name there
    assert questCursorBumped(1, 0, 0) = 1, "out again"
    stepQuest()
    QUEST_ACCEPT_TIME = 0 `the tests do not wait for the swap to play out
    assert questCursorBumped(0, 1, 1) = 1, "and a swap down starts the quest"
    stepQuest()
    assert QUEST_STATE = QSTATE_ACTIVE, "the quest is on"
    assert QUEST_SHOWN_KEY = 1, "and its name stays on the badge"
    assert INFO_SELECTED = INFO_INDEX_QUEST, "and info mode would open on the quest"

    ` the quest is straight under the bar of the round, so that info mode can get to it from there
    ` the bar of the round is explained as an upside down L, and the quest is in the corner of the L
    assert INFO_L_INDEX = INFO_INDEX_SCORE_BAR, "the bar of the round is the one with a leg"
    tBarBottom = INFOS(INFO_INDEX_SCORE_BAR).topLeft.y + INFOS(INFO_INDEX_SCORE_BAR).size.y
    tQuestTop = INFOS(INFO_INDEX_QUEST).topLeft.y
    tClear = 0
    if tQuestTop >= tBarBottom then tClear = 1
    assert tClear = 1, "the quest starts where the bar of the round ends"
    tQuestRight = INFOS(INFO_INDEX_QUEST).topLeft.x + INFOS(INFO_INDEX_QUEST).size.x
    tLegLeft = INFOS(INFO_INDEX_SCORE_BAR).topLeft.x + INFOS(INFO_INDEX_SCORE_BAR).size.x - INFO_L_W
    assert tQuestRight = tLegLeft, "and it stops where the leg of the L comes down"
    INFO_SELECTED = INFO_INDEX_SCORE_BAR
    assert findInfoInDirection(0, 1) = INFO_INDEX_QUEST, "down from the bar of the round is the quest"
    INFO_SELECTED = INFO_INDEX_GRID
    assert findInfoInDirection(0, -1) = INFO_INDEX_QUEST, "and up from the board is the quest"
    INFO_SELECTED = INFO_INDEX_QUEST
    assert findInfoInDirection(0, -1) = INFO_INDEX_SCORE_BAR, "and up from the quest is the bar"
    end
endtest

test quest_wake_finishes_with_a_line_along_its_path from fishBoard
    questForce(QUEST_WAKE)
    REQUEST_COMBO_CHECK = 0
    stepQuest()

    ` every cell of one row glows but the last one, and a few cells that lead nowhere
    tRow = 4
    tLastColumn = CELL_COLUMN_COUNT - 1
    for tColumn = 0 to tLastColumn - 1
        QUEST_SPOT(testIndex(tColumn, tRow)) = 5
    next
    QUEST_SPOT(testIndex(2, 3)) = 5
    QUEST_SPOT(testIndex(2, 2)) = 5

    ` the fish in the last cell pops, which joins the two edges
    CELLS(testIndex(tLastColumn, tRow)).comboBlownUp = 1
    questJudge(1)
    CELLS(testIndex(tLastColumn, tRow)).comboBlownUp = 0
    assert QUEST_STATE = QSTATE_DONE, "a glowing path from edge to edge is the quest done"
    assert QUEST_FINISH_N = CELL_COLUMN_COUNT, "the line that runs to finish it has a spot for every cell of the path, and no more"
    tFirstX = QUEST_FINISH#(0)
    tLastX = QUEST_FINISH#(tLastColumn * 2)
    assert tFirstX = getCellX(0), "it starts at the left edge"
    assert tLastX = getCellX(tLastColumn), "and ends at the right edge"
    tRunning = 0
    if QUEST_FINISH_MS >= 0 then tRunning = 1
    assert tRunning = 1, "and it has set off"
    end
endtest

