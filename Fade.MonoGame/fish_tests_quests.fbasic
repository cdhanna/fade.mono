    assert questCursorBumped(1, 0, 0) = 1, "the cursor steps out onto the pickup"
    stepQuest()
    assert QUEST_HILITE = 1, "and the quest is pointed out"
    assert QUEST_FOCUS = 1, "with whatever explains it showing too"

    assert questCursorBumped(-1, 0, 0) = 1, "the cursor steps back onto the board"
