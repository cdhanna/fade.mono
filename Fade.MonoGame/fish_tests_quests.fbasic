test quest_continuous_swap_counts_swaps_that_pop from fishBoard
    questForce(QUEST_CONTINUOUS)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tNeed = QUEST_V(1)

    questSwapDone(0, 1)
    questJudge(1)
    questJudge(0)
    questSettled()
    assert QUEST_PROG_NOW = 1, "a swap that pops fish is counted"

    questSwapDone(0, 1)
    questJudge(0)
    questSettled()
    assert QUEST_PROG_NOW = 0, "and a swap that pops nothing starts the count over"

    for tSwap = 1 to tNeed
        questSwapDone(0, 1)
        questJudge(1)
        questJudge(0)
        questSettled()
    next
    assert QUEST_STATE = QSTATE_DONE, "enough of them in a row is the quest done"
    assert QUESTS_DONE = 1, "and counted"
    end
endtest

