test quest_lost_pair_starts_over_when_a_miss_moves_one from fishBoard
    questForce(QUEST_LOST_PAIR)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tOne = questFindMark(1)

    ` a swap somewhere else that pops nothing is none of its business. the pair is put in a row
    ` that is picked at random, both of them in the same one, so "somewhere else" is another row:
    ` a swap in the row of the pair could be a swap of one of them.
    tPairRow = tOne / CELL_COLUMN_COUNT
    tFarRow = 8
    if tPairRow = 8 then tFarRow = 0
    questSwapDone(testIndex(0, tFarRow), testIndex(1, tFarRow))
    questJudge(0)
    questSettled()
    assert QUEST_STATE = QSTATE_ACTIVE, "a miss that moved neither of the pair leaves them be"

    ` a swap that moves one of the pair, and pops nothing
    questSwapMarks(tOne, tOne + 1)
    questSwapDone(tOne, tOne + 1)
    questJudge(0)
    questSettled()
    assert QUEST_INIT_DUE = 1, "a miss that moved one of the pair starts the quest over"
    end
endtest

test quest_lost_pair_comes_back_when_one_pops from fishBoard
    questForce(QUEST_LOST_PAIR)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tOne = questFindMark(1)
    tKind = CELLS(tOne).value
    CELLS(tOne).comboBlownUp = 1
    questJudge(1)
    assert QUEST_STATE = QSTATE_ACTIVE, "one of the pair popping does not start the quest over"
    assert QUEST_MARK(tOne) = 1, "its mark stays on its cell"
    assert QUEST_REBORN(tOne) = tKind, "and it is on its way back, as the kind that it was"
    questAfterPops()
    assert CELLS(tOne).comboBlownUp = 0, "once the pops are over, its cell is not empty"
    assert CELLS(tOne).value = tKind, "the fish is back in it"
    questJudge(0)
    questSettled()
    assert QUEST_STATE = QSTATE_ACTIVE, "and the quest carries on"
    end
endtest

test quest_is_saved_just_as_it_is from fishBoard
    ` a quest that is being played, with marks, a spot, a list, and a fish of its own on the board
    questForce(QUEST_LOST_PAIR)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tOne = questFindMark(1)
    tTwo = questFindMark(2)
    tPick = QUEST_PICK_CELL
    QUEST_V(7) = 123
    QUEST_V(63) = -4
    QUEST_SPOT(50) = 6
    QUEST_LIST(0) = 17
    QUEST_LIST(1) = 18
    QUEST_LIST_N = 2
    questProgress(3, 9)

    ` it is packed, and then everything about it is forgotten
    questPack()
    questForget()
    QUEST_STATE = QSTATE_NONE
    assert questFindMark(1) = -1, "nothing of it is left once it has been forgotten"

    ` and it comes back out just as it was
    assert questUnpack() = 1, "there is a quest in what was packed"
    assert QUEST_STATE = QSTATE_ACTIVE, "it is being played, as it was"
    assert questFindMark(1) = tOne, "the first fish of the pair is marked again"
    assert questFindMark(2) = tTwo, "and the second"
    assert QUEST_PICK_CELL = tPick, "its pickup is beside the same cell"
    assert QUEST_V(7) = 123, "what it kept is kept"
    assert QUEST_V(63) = -4, "to the last number, and below nothing too"
    assert QUEST_SPOT(50) = 6, "a cell that it lit is lit"
    assert QUEST_LIST_N = 2, "its list is as long as it was"
    assert QUEST_LIST(1) = 18, "with what was in it"
    assert QUEST_PROG_NOW = 3, "and it is as far along as it was"
    assert QUEST_PROG_NEED = 9, "out of as many"

    ` a saved game from before any of this was saved has nothing there
    for tPackN = 0 to 399
        QUEST_PACK(tPackN) = 0
    next
    assert questUnpack() = 0, "an old saved game has no quest packed in it"
    end
endtest

test quest_sleepers_hold_a_group_back from fishBoard
    questForce(QUEST_SLEEPERS)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    questPickUp()
    QUEST_V(0) = 6

    testPut(0, 0, 6)
    testPut(1, 0, 6)
    testPut(2, 0, 6)
    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert totalComboCount = 0, "a group of the kind that is asleep does not pop"
    assert testPopCount() = 0, "none of its fish do"
    assert QUEST_V(2) = 1, "and it is counted as waiting"
    end
endtest

test quest_sleepers_need_three_groups_waiting from fishBoard
    questForce(QUEST_SLEEPERS)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    questPickUp()
    QUEST_V(0) = 6

    ` it wakes with two groups waiting, and that is not enough
    QUEST_V(1) = 1
    QUEST_V(2) = 2
    questSleepers(QEV_SETTLE, 1, 0)
    assert QUEST_STATE = QSTATE_ACTIVE, "two groups waiting do not finish the quest"
    assert QUEST_V(0) = 7, "the next kind goes to sleep"
    assert QUEST_PROG_NEED = 3, "the badge asks for three"

    ` the next one wakes with three
    QUEST_V(1) = 1
    QUEST_V(2) = 3
    questSleepers(QEV_SETTLE, 1, 0)
    assert QUEST_STATE = QSTATE_DONE, "three groups waiting finish it"
    end
endtest

test quest_seaweed_grows_from_a_pop_on_the_bottom_row from fishBoard
    questForce(QUEST_SEAWEED)
    REQUEST_COMBO_CHECK = 0
    stepQuest()

    tBottom = CELL_ROW_COUNT - 1
    testPut(3, tBottom, 6)
    testPut(3, tBottom - 1, 6)
    testPut(3, tBottom - 2, 6)
    REQUEST_COMBO_CHECK = 1
    runto _combos_judged
    assert totalComboCount = 1, "the three fish pop"
    assert QUEST_REBORN(testIndex(3, tBottom)) = TEX_SEAWEED, "and the one on the bottom row leaves seaweed behind"

    ` play it out, until the board is still
    tGuard = 0
    while REQUEST_COMBO_CHECK = 1 and tGuard < 40
        tGuard = tGuard + 1
        runto _loop
    endwhile
    assert CELLS(testIndex(3, tBottom)).value = TEX_SEAWEED, "there is seaweed on the bottom row"
    assert CELLS(testIndex(3, tBottom - 1)).value = TEX_SEAWEED, "and on top of that, where the next fish popped"
    assert CELLS(testIndex(3, tBottom - 2)).value = TEX_SEAWEED, "and on top of that"
    assert QUEST_PROG_NOW = 3, "the badge says how tall it is"
    end
endtest

test quest_carries_on_into_the_next_round from fishBoard
    questForce(QUEST_TURTLE)
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tTurtle = questFindKind(TEX_TURTLE)
    tThere = 0
    if tTurtle >= 0 then tThere = 1
    assert tThere = 1, "the turtle is on the board"

    ` the round ends, and the quest is not lost
    CURRENT_ROUND = QUEST_FIRST_ROUND + 1
    questRoundEnded()
    assert QUEST_ID = QUEST_TURTLE, "the quest is still the quest when the round is over"
    assert QUEST_STATE = QSTATE_ACTIVE, "and it is still being played"
    assert questHoldsRound() = 0, "so the upgrade screen has nothing to wait for"

    ` the next round starts, and it carries on
    SCORE_BAR_HOLD = 1
    advanceScoreBar()
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    assert QUEST_ID = QUEST_TURTLE, "it is still the quest in the next round"
    assert QUEST_STATE = QSTATE_ACTIVE, "and still being played"
    assert questFindKind(TEX_TURTLE) = tTurtle, "with the turtle right where it was"

    ` once it is finished, the end of the round is the end of it, and the next round brings another
    questComplete()
    questRoundEnded()
    assert QUEST_ID = 0, "a quest that was finished is done with when its round is over"
    REQUEST_COMBO_CHECK = 0
    stepQuest()
    tTurtle = questFindKind(TEX_TURTLE)
    assert tTurtle = -1, "and so is the turtle"
    SCORE_BAR_HOLD = 1
    advanceScoreBar()
    tNew = 0
    if QUEST_ID > 0 then tNew = 1
    assert tNew = 1, "the round after that has a new quest"
    assert QUEST_ARRIVING = 1, "which is on its way"
    tOther = 1
    if QUEST_ID = QUEST_TURTLE then tOther = 0
    assert tOther = 1, "and it is not the one that was just finished"
    end
endtest


` THE ENDINGS THAT ARE SHOWN on the tables of the high scores. see fish_headers.
test highscore_endings_can_be_left_out from fishBoard
    HISCORE_SCOPE = HISCORE_SCOPE_LOCAL
    showAllEndings()
    for tEndKnown = CORAL_ENDING_REEF to CORAL_ENDING_DIVER
        HISCORE_ENDING_KNOWN(tEndKnown) = 1
    next
    layoutEndingTiles()
    assert HISCORE_TILE_COUNT = 3, "with every ending known, each has a tile of its own"
    assert HISCORE_TILE_ENDING(2) = CORAL_ENDING_DIVER, "and none is for mystery endings"
    tEndReef = insertHighscore(0, 5 + CORAL_ENDING_REEF * HISCORE_BADGE_STEP, 3, 9)
    tEndDiver = insertHighscore(0, 6 + CORAL_ENDING_DIVER * HISCORE_BADGE_STEP, 2, 9)
    assert tEndDiver = 0, "the game with the diver's ending is at the top"
    assert getScoreBadge(HISCORE_NAMES(1)) = CORAL_ENDING_REEF, "and the one with the coral's is under it"

    buildShownHighscores(0)
    assert HISCORE_SHOWN_COUNT = HISCORE_ROWS, "with every ending on, every row of the table is shown"
    assert HISCORE_SHOWN(0) = 0, "in the order of the table"
    assert HISCORE_SHOWN(1) = 1, "one after the other"

    HISCORE_ENDING_SHOWN(CORAL_ENDING_REEF) = 0
    buildShownHighscores(0)
    assert HISCORE_SHOWN_COUNT = HISCORE_ROWS - 1, "with the coral off, the game with that ending is left out"
    assert HISCORE_SHOWN(0) = 0, "the diver's is still at the top"
    assert HISCORE_SHOWN(1) = 2, "and the rows under the one that is gone move up"
    assert HISCORE_SHOWN(HISCORE_ROWS - 1) = -1, "which leaves the last row with nothing on it"

    HISCORE_ENDING_SHOWN(CORAL_ENDING_DIVER) = 0
    buildShownHighscores(0)
    assert HISCORE_SHOWN_COUNT = HISCORE_ROWS - 2, "with the diver off too, both are gone"
    assert HISCORE_SHOWN(0) = 2, "and the first row is the best game that had no ending"
    assert isEndingShown(0) = 1, "a game with no ending is always shown"
    assert isEndingShown(CORAL_ENDING_ANCIENT) = 1, "and the horror is still on"

    ` the page can be drawn with rows left out, and with the outline on a tile
    refreshHighscoreTable(0, 0, -2)
    assert HISCORE_SHOWN_COUNT = HISCORE_ROWS - 2, "drawing the table leaves the same games out"

    showAllEndings()
    buildShownHighscores(0)
    assert HISCORE_SHOWN_COUNT = HISCORE_ROWS, "and they all come back when every ending is on again"
    end
endtest

test highscore_endings_that_are_not_known_are_a_mystery from fishBoard
    HISCORE_SCOPE = HISCORE_SCOPE_LOCAL
    showAllEndings()
    tMystReef = insertHighscore(0, 5 + CORAL_ENDING_REEF * HISCORE_BADGE_STEP, 3, 9)
    tMystDiver = insertHighscore(0, 6 + CORAL_ENDING_DIVER * HISCORE_BADGE_STEP, 2, 9)
    tMystOld = insertHighscore(0, 7 + CORAL_ENDING_ANCIENT * HISCORE_BADGE_STEP, 1, 9)

    ` the player has only got to the coral's ending
    HISCORE_ENDING_KNOWN(CORAL_ENDING_REEF) = 1
    HISCORE_ENDING_KNOWN(CORAL_ENDING_ANCIENT) = 0
    HISCORE_ENDING_KNOWN(CORAL_ENDING_DIVER) = 0
    HISCORE_ENDING_AT = 2
    layoutEndingTiles()
    assert HISCORE_TILE_COUNT = 2, "the two endings that are not known share one tile"
    assert HISCORE_TILE_ENDING(0) = CORAL_ENDING_REEF, "the one that is known has its own"
    assert HISCORE_TILE_ENDING(1) = 0, "and the tile of the mystery ones comes after it"
    assert HISCORE_ENDING_AT = 1, "the outline does not stay on a tile that is gone"

    ` switching the mystery ones off leaves out both of them, and nothing else
    HISCORE_ENDING_SHOWN(0) = 0
    buildShownHighscores(0)
    assert HISCORE_SHOWN_COUNT = HISCORE_ROWS - 2, "both of the games with a mystery ending are left out"
    assert HISCORE_SHOWN(0) = 2, "and the one whose ending is known is first"
    assert isEndingShown(CORAL_ENDING_REEF) = 1, "the ending that is known is still shown"
    assert isEndingShown(0) = 1, "and so is a game with no ending"

    ` the switch of an ending does nothing while that ending is a mystery
    HISCORE_ENDING_SHOWN(0) = 1
    HISCORE_ENDING_SHOWN(CORAL_ENDING_DIVER) = 0
    assert isEndingShown(CORAL_ENDING_DIVER) = 1, "a mystery ending goes by the tile of the mystery ones"
    refreshHighscoreTable(0, -1, -2)

    ` with none of them known there is only the one tile
    HISCORE_ENDING_KNOWN(CORAL_ENDING_REEF) = 0
    layoutEndingTiles()
    assert HISCORE_TILE_COUNT = 1, "with no ending known, there is one tile"
    assert HISCORE_TILE_ENDING(0) = 0, "for all of them"
    showAllEndings()
    end
endtest
