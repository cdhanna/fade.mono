"DepotBuild"
{
	"DepotID"	"__DEPOT_WINDOWS__"

	// LocalPath is relative to the "contentroot" set in app_build.vdf.
	// The depot root holds Fade.MonoGame.exe, which is what the Windows launch option
	// in Steamworks should point at.
	"FileMapping"
	{
		"LocalPath"	"windows/*"
		"DepotPath"	"."
		"recursive"	"1"
	}

	"FileExclusion"	"*.pdb"
	// Written next to the executable by whoever ran the build last. Not part of the game.
	"FileExclusion"	"*_lastRun.log"
}
