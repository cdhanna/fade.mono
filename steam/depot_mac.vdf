"DepotBuild"
{
	"DepotID"	"__DEPOT_MAC__"

	// LocalPath is relative to the "contentroot" set in app_build.vdf.
	// This stages FishFishPop.app, so the depot root contains the bundle itself --
	// which is what the macOS launch option in Steamworks should point at.
	"FileMapping"
	{
		"LocalPath"	"mac/*"
		"DepotPath"	"."
		"recursive"	"1"
	}

	"FileExclusion"	"*.pdb"
}
